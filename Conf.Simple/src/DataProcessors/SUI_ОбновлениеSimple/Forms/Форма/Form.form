  <formCommands>
    <name>ЗагрузитьОбновлениеИзФайла</name>
    <title>
      <key>ru</key>
      <value>Обновить из файла</value>
    </title>
    <id>1</id>
    <toolTip>
      <key>ru</key>
      <value>Загрузить обновление из файла</value>
    </toolTip>
    <use>
      <common>true</common>
      <for>
        <role>Role.SUI_ИнтерактивноеУдалениеДокументовСборШтрихкодов</role>
      </for>
      <for>
        <role>Role.SUI_ИнтерактивноеУдалениеМобильныхКлиентов</role>
      </for>
      <for>
        <role>Role.SUI_ИнтерактивноеУдалениеМобильныхУстройств</role>
      </for>
      <for>
        <role>Role.SUI_ИнтерактивноеУдалениеНастройкиДокументов</role>
      </for>
      <for>
        <role>Role.SUI_ИнтерактивноеУдалениеПользователейТСД</role>
      </for>
      <for>
        <role>Role.SUI_ИнтерактивноеУдалениеРегламентныхЗаданий</role>
      </for>
      <for>
        <role>Role.SUI_ИнтерактивноеУдалениеШаблоновЭтикетокZPL</role>
      </for>
      <for>
        <value>true</value>
        <role>Role.SUI_РольАдминистрирование</role>
      </for>
      <for>
        <role>Role.SUI_РольОсновныеПрава</role>
      </for>
      <for>
        <role>Role.SUI_РольПраваТСД</role>
      </for>
    </use>
    <picture xsi:type="core:PictureRef">
      <picture>StdPicture.OpenFile</picture>
    </picture>
    <action xsi:type="form:FormCommandHandlerContainer">
      <handler>
        <name>ЗагрузитьОбновлениеИзФайла</name>
      </handler>
    </action>
    <representation>TextPicture</representation>
    <currentRowUse>Auto</currentRowUse>
  </formCommands>
