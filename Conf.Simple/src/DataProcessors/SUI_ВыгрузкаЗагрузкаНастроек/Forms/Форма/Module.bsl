
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не Параметры.ЗагрузкаПредопределенных И 
		Параметры.ОтключитьРежимВыгрузки И 
		Параметры.ОтключитьРежимЗагрузки Тогда
		ВызватьИсключение НСтр("ru = 'Возникла ошибка определения режима работы'");
	КонецЕсли;
	
	ИнициализироватьОбластиНастроек(Параметры.ОбластиНастроек.ВыгрузитьЗначения());
	
	Если Параметры.ЗагрузкаПредопределенных Тогда
		
		РежимВыгрузки = Ложь;
		Элементы.РежимВыгрузки.Видимость = Ложь;
		
		Если Метаданные.Обработки.SUI_ВыгрузкаЗагрузкаНастроек.Макеты.Найти("ПредопределенныеНастройки") <> Неопределено Тогда
			ПредопределенныеНастройки = Обработки.SUI_ВыгрузкаЗагрузкаНастроек.ПолучитьМакет("ПредопределенныеНастройки");
			АдресЗагружаемыйФайл = ПоместитьВоВременноеХранилище(ПредопределенныеНастройки, УникальныйИдентификатор);
		КонецЕсли;
		
	Иначе
		РежимВыгрузки = Параметры.ОтключитьРежимЗагрузки;
		Элементы.РежимВыгрузки.Видимость = (Не Параметры.ОтключитьРежимВыгрузки И Не Параметры.ОтключитьРежимЗагрузки);
		Элементы.ЗагрузитьИзРепозитория.Видимость = Ложь;
	КонецЕсли;
	
	Если ОбластиНастроек.НайтиПоЗначению(КлючОбластиНастройкиДокументов()) = Неопределено Тогда
		Элементы.ДеревоНастройкиНастройкиДокументовЗаполнитьПоОтбору.Видимость = Ложь;
	ИначеЕсли РежимВыгрузки Тогда
		АдресСхемыНастроекДокументов = ИнициализироватьАдресСхемыНастроекДокументов(УникальныйИдентификатор);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если Окно = Неопределено Тогда
		Элементы.ДеревоНастройки.Высота = 10;
		Элементы.ДеревоНастройки.Ширина = 100;
		Элементы.Закрыть.Видимость = Ложь;
	КонецЕсли;
	
	ОбновитьВидимостьЭлементовФормы();
	
	Если Параметры.ЗагрузкаПредопределенных Тогда
		
		Если ЭтоАдресВременногоХранилища(АдресЗагружаемыйФайл) Тогда
		
			ВыбранныйФайл = Новый Структура("Хранение", АдресЗагружаемыйФайл);
			АдресЗагружаемыйФайл = "";
			
			Оповещение = Новый ОписаниеОповещения("ЗагрузитьИзФайлаПослеВыбораФайла", ЭтотОбъект);
			ВыполнитьОбработкуОповещения(Оповещение, ВыбранныйФайл);
		
		КонецЕсли;
		
	Иначе
		
		Если РежимВыгрузки Тогда
			
			Если Параметры.ЗаполнитьВсеПриОткрытииВыгрузки Тогда
			
				Контекст = Новый Структура();
				Контекст.Вставить("ЭлементыДерева", ДеревоНастройки.ПолучитьЭлементы());
				ОповещениеОЗавершении = Новый ОписаниеОповещения("ЗаполнитьВсеПодтверждение", ЭтотОбъект, Контекст);
				ВыполнитьОбработкуОповещения(ОповещениеОЗавершении, КодВозвратаДиалога.Да);
			
			КонецЕсли;
			
		Иначе
			
			Если Параметры.ВыборФайлаПриОткрытииВыгрузки Тогда
				ЗагрузитьИзФайлаВыбратьФайл();
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура РежимВыгрузкиПриИзменении(Элемент)
	
	Контекст = Новый Структура();
	Контекст.Вставить("ЭлементыДерева", ДеревоНастройки.ПолучитьЭлементы());
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("РежимВыгрузкиПриИзмененииПослеПодтверждения", ЭтотОбъект, Контекст);
	
	Если Контекст.ЭлементыДерева.Количество() = 0 Тогда
		ВыполнитьОбработкуОповещения(ОповещениеОЗавершении, КодВозвратаДиалога.Да);
	Иначе
		ПоказатьВопрос(ОповещениеОЗавершении, НСтр("ru = 'Таблица настроек будет очищена.
		|Продолжить?'"), РежимДиалогаВопрос.ДаНет);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДеревоНастройки

&НаКлиенте
Процедура ДеревоНастройкиПометкаПриИзменении(Элемент)
	
	Если Элементы.ДеревоНастройки.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЭлементДерева = ДеревоНастройки.НайтиПоИдентификатору(Элементы.ДеревоНастройки.ТекущаяСтрока);
	
	ЭлементыДерева = ДеревоНастройки.ПолучитьЭлементы();
	
	Если ЭлементыДерева.Количество() > 1 Тогда
		
		Родитель = ПолучитьРодителяЭлементаДерева(ЭлементДерева);
		
		Для Каждого ЭлементДереваРодитель Из ЭлементыДерева Цикл
			
			Если ЭлементДереваРодитель <> Родитель И 
				Не ПустаяСтрока(ЭлементДереваРодитель.КонфигурацияИмя) И 
				ЭлементДереваРодитель.Пометка <> 0 Тогда
				ЭлементДереваРодитель.Пометка = 0;
				ПроставитьПометкиВниз(ЭлементДереваРодитель);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	ЭлементДерева.Пометка = ЭлементДерева.Пометка % 2;
	
	ПроставитьПометкиВниз(ЭлементДерева);
	ПроставитьПометкиВверх(ЭлементДерева);
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоНастройкиПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, ЭтоГруппа, Параметр)
	
	Отказ = Истина;
	
	Контекст = Новый Структура("ТекущийИдентификаторСтроки", Элемент.ТекущаяСтрока);
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ДеревоНастройкиПередНачаломДобавленияПослеВыбораОбласти", ЭтотОбъект, Контекст);
	
	Если ОбластиНастроек.Количество() = 1 Тогда
		ВыполнитьОбработкуОповещения(ОповещениеОЗавершении, ОбластиНастроек[0]);
	Иначе
		ПоказатьВыборИзМеню(ОповещениеОЗавершении, ОбластиНастроек, Элемент);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПометкиОтметитьВсе(Команда)
	
	Для Каждого ЭлементДерева Из ДеревоНастройки.ПолучитьЭлементы() Цикл
		ЭлементДерева.Пометка = 1;
		ПроставитьПометкиВниз(ЭлементДерева);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПометкиСнятьВсе(Команда)
	
	Для Каждого ЭлементДерева Из ДеревоНастройки.ПолучитьЭлементы() Цикл
		ЭлементДерева.Пометка = 0;
		ПроставитьПометкиВниз(ЭлементДерева);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиДокументовЗаполнитьПоОтбору(Команда)
	
	Если ОбластиНастроек.НайтиПоЗначению(КлючОбластиНастройкиДокументов()) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Контекст = Новый Структура();
	Контекст.Вставить("ЭлементОбласть", НайтиЭлементВДеревеПоЗначениюВКолонке("Область", 
		ОбластиНастроек.НайтиПоЗначению(КлючОбластиНастройкиДокументов()).Значение, 
		ДеревоНастройки.ПолучитьЭлементы()));
	
	Оповещение = Новый ОписаниеОповещения("НастройкиДокументовЗаполнитьПоОтборуПодтверждение", ЭтотОбъект, Контекст);
	
	Если Контекст.ЭлементОбласть = Неопределено Тогда
		ВыполнитьОбработкуОповещения(Оповещение, КодВозвратаДиалога.Да);
	Иначе
		ПоказатьВопрос(Оповещение, НСтр("ru = 'Таблица содержит данные настроек документов.
		|Продолжить?'"), РежимДиалогаВопрос.ДаНет);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьВсе(Команда)
	
	Контекст = Новый Структура();
	Контекст.Вставить("ЭлементыДерева", ДеревоНастройки.ПолучитьЭлементы());
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ЗаполнитьВсеПодтверждение", ЭтотОбъект, Контекст);
	
	Если Контекст.ЭлементыДерева.Количество() = 0 Тогда
		ВыполнитьОбработкуОповещения(ОповещениеОЗавершении, КодВозвратаДиалога.Да);
	Иначе
		ПоказатьВопрос(ОповещениеОЗавершении, НСтр("ru = 'Таблица содержит данные настроек документов.
		|Продолжить?'"), РежимДиалогаВопрос.ДаНет);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьВФайл(Команда)
	
	Если Не РежимВыгрузки Тогда
		Возврат;
	КонецЕсли;
	
	ЭлементыДерева = ДеревоНастройки.ПолучитьЭлементы();
	
	Если ЭлементыДерева.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Не загружен список настроек'"));
	Иначе
		
		ЕстьПометки = Ложь;
		Для Каждого ЭлементДерева Из ДеревоНастройки.ПолучитьЭлементы() Цикл
			
			Если ЭлементДерева.Пометка > 0 Тогда
				ЕстьПометки = Истина;
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
		Если ЕстьПометки Тогда
			
			ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
			ПараметрыОжидания.ВыводитьПрогрессВыполнения = Истина;
			ПараметрыОжидания.ВыводитьСообщения = Истина;
			ПараметрыОжидания.Заголовок = НСтр("ru = 'Подготовка данных к выгрузке'");
			
			ДлительнаяОперация = ПодготовкаФайлаКВыгрузкеНаСервере();
			
			ОповещениеОЗавершении = Новый ОписаниеОповещения("ПодготовкаФайлаКВыгрузкеЗавершение", ЭтотОбъект);
			ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания);
			
		Иначе
			ПоказатьПредупреждение(, НСтр("ru = 'Не выбраны настройки'"));
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзФайла(Команда)
	
	Если РежимВыгрузки Тогда
		Возврат;
	КонецЕсли;
	
	ЗагрузитьИзФайлаВыбратьФайл();
	
КонецПроцедуры

&НаКлиенте
Процедура РазвернутьВсе(Команда)
	
	Если Элементы.ДеревоНастройки.ТекущиеДанные <> Неопределено Тогда
		Элементы.ДеревоНастройки.Развернуть(Элементы.ДеревоНастройки.ТекущаяСтрока, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СвернутьВсе(Команда)
	
	Если Элементы.ДеревоНастройки.ТекущиеДанные <> Неопределено Тогда
		Элементы.ДеревоНастройки.Свернуть(Элементы.ДеревоНастройки.ТекущаяСтрока);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьНастройки(Команда)
	
	ЭлементыДерева = ДеревоНастройки.ПолучитьЭлементы();
	
	Если ЭлементыДерева.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Не загружен список настроек'"));
	Иначе
		
		ЕстьПометки = Ложь;
		Для Каждого ЭлементДерева Из ДеревоНастройки.ПолучитьЭлементы() Цикл
			
			Если ЭлементДерева.Пометка > 0 Тогда
				ЕстьПометки = Истина;
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
		Если ЕстьПометки Тогда
			
			Оповещение = Новый ОписаниеОповещения("ЗаписатьНастройкиПродолжить", ЭтотОбъект);
			
			Если ФайлПолученИзРепозитория Тогда
				ЗагрузитьОтмеченныеНастройкиИзРепозитория(Оповещение);
			Иначе
				ВыполнитьОбработкуОповещения(Оповещение);
			КонецЕсли;
			
		Иначе
			ПоказатьПредупреждение(, НСтр("ru = 'Не выбраны настройки'"));
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзРепозитория(Команда)
	
	Если ЭтоАдресВременногоХранилища(АдресЗагружаемыйФайл) Тогда
		УдалитьИзВременногоХранилища(АдресЗагружаемыйФайл);
	КонецЕсли;
	
	АдресЗагружаемыйФайл = "";
	
	Результат = Новый Структура();
	Результат.Вставить("Хранение", ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор));
	
	#Если ВебКлиент Тогда
	Результат = ПолучитьМанифестПредопределенныхНастроекИзРепозиторияЧерезСервер(
		КаталогПредопределенныхНастроек(), Результат.Хранение);
	#Иначе
	Результат = ПолучитьМанифестПредопределенныхНастроекИзРепозитория(
		КаталогПредопределенныхНастроек(), Результат.Хранение);
	#КонецЕсли
	
	Если Не ПустаяСтрока(Результат.Ошибка) Тогда
		ПоказатьПредупреждение(, Результат.Ошибка);
	ИначеЕсли ЭтоАдресВременногоХранилища(Результат.Хранение) Тогда
		
		Контекст = Новый Структура();
		Контекст.Вставить("ИзРепозитория", Истина);
		
		Оповещение = Новый ОписаниеОповещения("ЗагрузитьИзФайлаПослеВыбораФайла", ЭтотОбъект, Контекст);
		ВыполнитьОбработкуОповещения(Оповещение, Результат);
		
	Иначе
		ПоказатьПредупреждение(, НСтр("ru = 'Не удалось получить результат обращения к репозиторию.'"));
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ИнициализацияФормы

&НаСервере
Процедура ИнициализироватьОбластиНастроек(ОбластиИзПараметров)
	
	Обработки.SUI_ВыгрузкаЗагрузкаНастроек.ИнициализироватьОбластиНастроек(ОбластиНастроек, ОбластиИзПараметров);
	
	ТекстОшибки = НСтр("ru = 'Возникла ошибка определения областей %1'");
	
	Если Параметры.ЗагрузкаПредопределенных Тогда
		ТекстОшибки = СтрШаблон(ТекстОшибки, НСтр("ru = 'предопределенных настроек.'"));
	ИначеЕсли РежимВыгрузки Тогда
		ТекстОшибки = СтрШаблон(ТекстОшибки, НСтр("ru = 'выгрузки настроек.'"));
	Иначе
		ТекстОшибки = СтрШаблон(ТекстОшибки, НСтр("ru = 'загрузки настроек.'"));
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.Проверить(ОбластиНастроек.Количество() > 0, ТекстОшибки);
	
КонецПроцедуры

&НаКлиенте
Процедура РежимВыгрузкиПриИзмененииПослеПодтверждения(Подтверждение, Контекст) Экспорт
	
	Если Подтверждение = КодВозвратаДиалога.Да Тогда
		Контекст.ЭлементыДерева.Очистить();
		ОбновитьВидимостьЭлементовФормы();
	Иначе
		РежимВыгрузки = Не РежимВыгрузки;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВидимостьЭлементовФормы()
	
	Если Параметры.ЗагрузкаПредопределенных Тогда
		
		Заголовок = НСтр("ru = 'Загрузка предопределенных настроек'");
		
		Элементы.ФормаВыгрузитьВФайл.Видимость = Ложь;
		Элементы.ФормаЗагрузитьИзФайла.Видимость = Ложь;
		Элементы.ФормаЗаписатьНастройки.Видимость = (ДеревоНастройки.ПолучитьЭлементы().Количество() > 0);
		
		Элементы.ДеревоНастройки.ИзменятьСоставСтрок = Ложь;
		Элементы.ДеревоНастройкиКоманднаяПанельГруппаРежимаВыгрузки.Видимость = Ложь;
		Элементы.ДеревоНастройкиКоманднаяПанельГруппаРежимаВыгрузки.Видимость = Ложь;
		
		Элементы.ДеревоНастройкиСопоставленнаяНастройка.Видимость = Истина;
		
	Иначе
		
		Заголовок = ?(РежимВыгрузки, НСтр("ru = 'Выгрузка настроек'"), НСтр("ru = 'Загрузка настроек'"));
		
		Элементы.ФормаВыгрузитьВФайл.Видимость = РежимВыгрузки;
		Элементы.ФормаЗагрузитьИзФайла.Видимость = Не РежимВыгрузки;
		Элементы.ФормаЗаписатьНастройки.Видимость = Не РежимВыгрузки И ДеревоНастройки.ПолучитьЭлементы().Количество() > 0;
		
		Элементы.ДеревоНастройки.ИзменятьСоставСтрок = РежимВыгрузки;
		Элементы.ДеревоНастройкиКоманднаяПанельГруппаРежимаВыгрузки.Видимость = РежимВыгрузки;
		Элементы.ДеревоНастройкиКонтекстноеМенюГруппаРежимаВыгрузки.Видимость = РежимВыгрузки;
		
		Элементы.ДеревоНастройкиСопоставленнаяНастройка.Видимость = Не РежимВыгрузки;
		
	КонецЕсли;
	
	Если Элементы.ФормаВыгрузитьВФайл.Видимость Тогда
		Элементы.ФормаВыгрузитьВФайл.КнопкаПоУмолчанию = Истина;
	ИначеЕсли Элементы.ФормаЗаписатьНастройки.Видимость Тогда
		Элементы.ФормаЗаписатьНастройки.КнопкаПоУмолчанию = Истина;
	Иначе
		Элементы.ФормаЗагрузитьИзФайла.КнопкаПоУмолчанию = Истина;
	КонецЕсли;
	
	Элементы.ДеревоНастройкиПредставление.Заголовок = НСтр("ru = 'Область / Настройка'");
	Если Параметры.ЗагрузкаПредопределенных Или Не РежимВыгрузки Тогда
		Элементы.ДеревоНастройкиПредставление.Заголовок = СтрШаблон(НСтр("ru = 'Конфигурация / %1'"),
			Элементы.ДеревоНастройкиПредставление.Заголовок);
	КонецЕсли;
	
КонецПроцедуры

