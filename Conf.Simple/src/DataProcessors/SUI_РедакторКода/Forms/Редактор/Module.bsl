&НаКлиенте
Процедура ИнициализацияРедактораBSL()
	
	Если Не РедакторBSLЗагружен Тогда
		Возврат;
	КонецЕсли;
	
	Инфо = Новый СистемнаяИнформация();
	
	View().init(Инфо.ВерсияПриложения);
	View().setOption("autoResizeEditorLayout", Истина);
	View().setOption("renderQueryDelimiters", Истина);
	View().setOption("generateModificationEvent", Истина);
	View().hideScrollX();
	View().hideScrollY();
	
	УстановитьТекстРедактораBSL(РедактируемаяСтрока, Неопределено, Ложь);
	СменитьОтображениеСтрокиСостоянияРедактораBSL(Истина);
	
	Если Не Элементы.РежимРедактирования.Доступность И РедактированиеДоступно() Тогда
		СменитьРежимРедактирования();
	Иначе
		СменитьРежимРедактирования(Элементы.РежимРедактирования.Пометка);
	КонецЕсли;
	
	ПодключитьОбработчикОжидания("ОбнулитьМетаданныеРедактораBSL", 1, Истина);
	
КонецПроцедуры

