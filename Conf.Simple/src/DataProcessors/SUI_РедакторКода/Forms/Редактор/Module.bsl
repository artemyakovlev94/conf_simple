#Область ОписаниеПеременных

&НаКлиенте
Перем БиблиотекаBSLЗагружена;

&НаКлиенте
Перем РедакторBSLЗагружен;

&НаКлиенте
Перем РезультатПриЗакрытии;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗакрытьСРезультатом = Параметры.ЗакрытьСРезультатом;
	РедактируемаяСтрока = Параметры.ИсходныйТекст;
	ПредопределенныйТекст = Параметры.ПредопределенныйТекст;
	
	Элементы.ДекорацияНадписьОписаниеРедактора.Заголовок = Параметры.Описание;
	Элементы.ГруппаРедакторОписание.Видимость = (СтрДлина(Элементы.ДекорацияНадписьОписаниеРедактора.Заголовок) > 0);
	
	Элементы.РежимРедактирования.Пометка = Не Параметры.ЗапретРедактированияПриОткрытии;
	Элементы.РежимРедактирования.Доступность = Не Параметры.НеРедактировать;
	Элементы.ФормаЗавершитьРедактирование.Видимость = ЗакрытьСРезультатом И Элементы.РежимРедактирования.Доступность;
	
	Элементы.ФормаЗагрузитьИзФайла.Видимость = Не Параметры.НеЗагружатьИзФайла;
	Элементы.ФормаСохранитьВФайл.Видимость = Не Параметры.НеВыгружатьВФайл;
	
	Если ПустаяСтрока(Параметры.Заголовок) Тогда
		Заголовок = СтрШаблон(НСтр("ru = 'Редактор кода %1'"), SUI_SimpleКлиентСервер.Представление());
	Иначе
		Заголовок = Параметры.Заголовок;
	КонецЕсли;
	
	Элементы.РедакторBSL.Видимость = Обработки.SUI_РедакторКода.ПолучитьПризнакИспользованияРедактораКодаBSL();
	
	Если Элементы.РедакторBSL.Видимость Тогда
		
		АдресБиблиотеки = ПоместитьВоВременноеХранилище(
		Обработки.SUI_РедакторКода.ПолучитьМакет(ИмяБиблиотеки()), УникальныйИдентификатор);
		
		КоллекцияОбщихМодулей = ПолучитьКоллекциюОбщихМодулей();
		АдресОбщихМодулей = СохранитьОбщиеМодулиВХранилище(КоллекцияОбщихМодулей);
		ЗаполнитьИменаОбщихМодулей(КоллекцияОбщихМодулей);
		
		ПользовательскиеОбъектыРедактораBSL = ПривестиПользовательскиеОбъектыКСтрокеJSON(Параметры.ПользовательскиеОбъекты);
		
	КонецЕсли;
	
	// Дерево описания переменных
	ЭлементыДереваОписанияПеременных = ДеревоОписаниеПеременных.ПолучитьЭлементы();
	Если ТипЗнч(Параметры.ПользовательскиеОбъекты) = Тип("Структура") Тогда
		СформироватьДеревоОписанияПользовательскихОбъектов(
			Параметры.ПользовательскиеОбъекты, ЭлементыДереваОписанияПеременных);
	КонецЕсли;
	Элементы.ГруппаРедакторОписаниеПеременных.Видимость = (ЭлементыДереваОписанияПеременных.Количество() > 0);
	
	Элементы.ФормаПредопределенныйКод.Видимость = ПредопределенныйТекст.Количество() > 0;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	БиблиотекаBSLЗагружена = Ложь;
	РедакторBSLЗагружен = Ложь;
	
	#Если ВебКлиент Тогда
		
		Элементы.РедакторBSL.Видимость = Ложь;
		Элементы.ГруппаКП_РедакторBSL.Видимость = Ложь;
		
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаРедакторОсновной;
		
	#КонецЕсли
	
	Если ЭтоСтраницаРедактораBSL() Тогда
		
		ОпределитьРазделительПути();
		ИнициализироватьБиблиотеку();
	
	Иначе
		
		Если Не Элементы.РежимРедактирования.Доступность И РедактированиеДоступно() Тогда
			СменитьРежимРедактирования();
		Иначе
			СменитьРежимРедактирования(Элементы.РежимРедактирования.Пометка);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если Не ЗакрытьСРезультатом Тогда
		Модифицированность = Ложь;
	КонецЕсли;
	
	Если Модифицированность Тогда
		
	    Оповещение = Новый ОписаниеОповещения("ЗакрытьСРезультатом", ЭтотОбъект);
	    SUI_ОбщегоНазначенияКлиент.ПоказатьПодтверждениеЗакрытияФормы(Оповещение, Отказ, ЗавершениеРаботы);
	    
	ИначеЕсли ЗначениеЗаполнено(ИндексныйФайл) Тогда
		
		Отказ = Истина;
		СтандартнаяОбработка = Ложь;
		
		Оповещение = Новый ОписаниеОповещения("ПослеУдаленияИндексногоФайлаПередЗакрытием", ЭтотОбъект);
		НачатьУдалениеФайлов(Оповещение, ИндексныйФайл);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура РедакторBSLДокументСформирован(Элемент)
	
	Если БиблиотекаBSLЗагружена Тогда
		
		#Если Не ВебКлиент Тогда
			
			РедакторBSLЗагружен = Истина;
			ИнициализацияРедактораBSL();
			
		#КонецЕсли
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РедакторBSLПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	
	ОбработатьСобытиеРедактораBSL(ДанныеСобытия.Event.eventData1C);
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоОписаниеПеременныхИмя1Нажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Элементы.ДеревоОписаниеПеременных.ТекущиеДанные <> Неопределено Тогда
		ВставитьПеременнуюВРедакторКода(Элементы.ДеревоОписаниеПеременных.ТекущаяСтрока);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоОписаниеПеременныхТипНажатие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДеревоОписаниеПеременных

&НаКлиенте
Процедура ДеревоОписаниеПеременныхВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "ДеревоОписаниеПеременныхИмя" Тогда
		ВставитьПеременнуюВРедакторКода(ВыбраннаяСтрока);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

#Область КомандыРедактораBSL

&НаКлиенте
Процедура КонструкторЗапроса(Команда)
	
	ВызватьКонструкторЗапроса(View().getQuery());
	
КонецПроцедуры

&НаКлиенте
Процедура ПодсвечиватьЗапросы(Команда)
	
	Если ЭтоСтраницаРедактораBSL() Тогда
		СменитьОтображениеПодсветкиКодаЗапросовРедактораBSL();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КартаКода(Команда)
	
	СменитьОтображениеКартыКодаРедактораBSL();
	
КонецПроцедуры

&НаКлиенте
Процедура СтрокаСостояния(Команда)
	
	СменитьОтображениеСтрокиСостоянияРедактораBSL();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтображатьПробелыИТабуляции(Команда)
	
	СменитьОтображениеПробеловИТабуляцииРедактораBSL();
	
КонецПроцедуры

&НаКлиенте
Процедура ТемаРедактора(Команда)
	
	Элементы.ТемаРедактора.Пометка = Не Элементы.ТемаРедактора.Пометка;
	
	Элементы.ТемаРедактора.Картинка = ?(Элементы.ТемаРедактора.Пометка,
		БиблиотекаКартинок.УсловноеОформлениеКомпоновкиДанныхНедоступное,
		БиблиотекаКартинок.УсловноеОформлениеКомпоновкиДанных);
	
	СменитьТемуРедактораBSL();
	
КонецПроцедуры

&НаКлиенте
Процедура НомераСтрок(Команда)
	
	СменитьОтображениеНомеровСтрокРедактораBSL();
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьКомментарий(Команда)
	
	Если РедактированиеДоступно() Тогда
		ВставитьКомментарийРедактораBSL();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьКомментарий(Команда)
	
	Если РедактированиеДоступно() Тогда
		УбратьКомментарийРедактораBSL();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ФорматироватьКод(Команда)
	
	Если РедактированиеДоступно() Тогда
		ФорматироватьКодРедактораBSL();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура РежимРедактирования(Команда)
	
	СменитьРежимРедактирования();
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьКодРедактора(Команда)
	
	Если Не РедактированиеДоступно() Тогда
		Возврат;
	КонецЕсли;
	
	Контекст = Новый Структура("ВРедактореBSL", ЭтоСтраницаРедактораBSL());
	
	Если (Контекст.ВРедактореBSL И Не ЕстьКодРедактораBSL()) Или
		(Не Контекст.ВРедактореBSL И ПустаяСтрока(РедактируемаяСтрока)) Тогда
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ОчиститьКодРедактораПодтверждение", ЭтотОбъект, Контекст);
	ПоказатьВопрос(Оповещение, НСтр("ru = 'Редактор содержит код.
	|Очистить содержимое редактора?'"), РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьРедактирование(Команда)
	
	ЗакрытьСРезультатом();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзФайла(Команда)
	
	Если Не РедактированиеДоступно() Тогда
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ЗагрузитьИзФайлаПослеПодтверждения", ЭтотОбъект);
	
	Если (ЭтоСтраницаРедактораBSL() И ЕстьКодРедактораBSL()) Или
		(Не ЭтоСтраницаРедактораBSL() И Не ПустаяСтрока(РедактируемаяСтрока)) Тогда
		ПоказатьВопрос(Оповещение, НСтр("ru = 'Редактор содержит код.
		|Загрузить код из файла?'"), РежимДиалогаВопрос.ДаНет);
	Иначе
		ВыполнитьОбработкуОповещения(Оповещение, КодВозвратаДиалога.Да);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьВФайл(Команда)
	
	Если ЭтоСтраницаРедактораBSL() Тогда
		РедактируемаяСтрока = ПолучитьТекстРедактораBSL();
	КонецЕсли;
	
	Если ПустаяСтрока(РедактируемаяСтрока) Тогда
		Возврат;
	КонецЕсли;
	
	#Если ВебКлиент Тогда
		АдресДанных = ЗаписатьТекстРедактораВДвоичныеДанныеНаСервере(РедактируемаяСтрока, УникальныйИдентификатор);
	#Иначе
		
		ПотокЗаписи = Новый ПотокВПамяти();
		
		ДокументТекст = Новый ТекстовыйДокумент();
		ДокументТекст.УстановитьТекст(РедактируемаяСтрока);
		ДокументТекст.Записать(ПотокЗаписи, КодировкаТекста.UTF8, "");
		
		АдресДанных = ПоместитьВоВременноеХранилище(ПотокЗаписи.ЗакрытьИПолучитьДвоичныеДанные(), УникальныйИдентификатор);
		
	#КонецЕсли
	
	Оповещение = Новый ОписаниеОповещения("СохранитьВФайлЗавершение", ЭтотОбъект);
	
	ПараметрыСохраненияФайла = ФайловаяСистемаКлиент.ПараметрыСохраненияФайла();
	ПараметрыСохраненияФайла.Диалог.Фильтр = ФильтрДиалогаФайлаКода();
	ПараметрыСохраненияФайла.Диалог.Заголовок = НСтр("ru = 'Сохранить код в файл'");
	
	ФайловаяСистемаКлиент.СохранитьФайл(Оповещение, АдресДанных, , ПараметрыСохраненияФайла);
	
КонецПроцедуры

&НаКлиенте
Процедура ПредопределенныйКод(Команда)
	
	Если ПредопределенныйТекст.Количество() = 0 Или Не РедактированиеДоступно() Тогда
		Возврат;
	КонецЕсли;
	
	Контекст = Новый Структура("ВРедакторBSL", ЭтоСтраницаРедактораBSL());
	
	Если Контекст.ВРедакторBSL Тогда
		ЕстьКод = ЕстьКодРедактораBSL();
	Иначе
		ЕстьКод = Не ПустаяСтрока(РедактируемаяСтрока);
	КонецЕсли;
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ВставитьПредопределенныйКодПодтверждение", ЭтотОбъект, Контекст);
	
	Если ЕстьКод Тогда
		ПоказатьВопрос(ОповещениеОЗавершении, НСтр("ru = 'Редактор содержит код.
		|Продолжить вставку предопределенного кода?'"), РежимДиалогаВопрос.ДаНет);
	Иначе
		ВыполнитьОбработкуОповещения(ОповещениеОЗавершении, КодВозвратаДиалога.Да);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПереустановитьБиблиотеку(Команда)
	
	#Если Не ВебКлиент Тогда
		
		Если ЭтоСтраницаРедактораBSL() Тогда
			
			Оповещение = Новый ОписаниеОповещения("ПослеПодтвержденияПереустановитьБиблиотеку", ЭтотОбъект);
			ПоказатьВопрос(Оповещение, НСтр("ru = 'Выполнить переустановку библиотеки редактора?'"), 
				РежимДиалогаВопрос.ДаНет);
			
		КонецЕсли;
		
	#КонецЕсли
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ИнициализацияБиблиотеки

&НаКлиентеНаСервереБезКонтекста
Функция ИмяБиблиотеки()
	Возврат "CodeEditor";
КонецФункции

&НаКлиенте
Функция ИндексныйФайлЭталон()
	Возврат SUI_ОбщегоНазначенияКлиентСервер.ОбъединитьПути(КаталогБиблиотеки, "index.html");
КонецФункции

&НаКлиенте
Функция ВременныйИндексныйФайл()
	Возврат SUI_ОбщегоНазначенияКлиентСервер.ОбъединитьПути(КаталогБиблиотеки,
		Формат(ТекущаяУниверсальнаяДатаВМиллисекундах(), "ЧГ=0") + ".html");
КонецФункции

&НаКлиенте
Процедура ИнициализироватьБиблиотеку(Переустановка = Ложь)
	
	Контекст = Новый Структура();
	
	Если Переустановка Тогда
		Контекст.Вставить("ПереустановитьБиблиотеку");
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ИнициализироватьБиблиотекуПослеИнициализацииКаталога", ЭтотОбъект, Контекст);
	SUI_ФайловаяСистемаКлиент.ИнициализироватьКаталогБиблиотекиSimple(Оповещение, ИмяБиблиотеки(), Переустановка);
	
КонецПроцедуры

&НаКлиенте
Процедура ИнициализироватьБиблиотекуПослеИнициализацииКаталога(Результат, Контекст) Экспорт
	
	Если ЗначениеЗаполнено(Результат.Ошибка) Тогда
		ПоказатьОшибку(Результат.Ошибка, Истина);
	Иначе
		
		КаталогБиблиотеки = Результат.Путь;
		
		Если Контекст.Свойство("ПереустановитьБиблиотеку") Тогда
			Контекст.Очистить();
			Контекст.Вставить("ПопыткаПереустановитьБиблиотеку");
			ИзвлечьБиблиотеку(Контекст);
		Иначе
			НачатьПроверкуСуществованияИндексногоФайлаБиблиотеки(Контекст);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьПроверкуСуществованияИндексногоФайлаБиблиотеки(Контекст)
	
	Оповещение = Новый ОписаниеОповещения("ПослеПроверкиСуществованияИндексногоФайлаБиблиотеки", ЭтотОбъект, Контекст);
	ФайлНаДиске = Новый Файл(ИндексныйФайлЭталон());
	ФайлНаДиске.НачатьПроверкуСуществования(Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеПроверкиСуществованияИндексногоФайлаБиблиотеки(Существует, Контекст) Экспорт
	
	Если Существует Тогда
		
		Если Контекст.Свойство("ПопыткаИзвлеченияФайловБиблиотеки") Тогда
			Контекст.Удалить("ПопыткаИзвлеченияФайловБиблиотеки");
		КонецЕсли;
		
		Если Контекст.Свойство("ПопыткаПереустановитьБиблиотеку") Тогда
			Контекст.Удалить("ПопыткаПереустановитьБиблиотеку");
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Библиотека редактора была переустановлена'"));
		КонецЕсли;
		
		Оповещение = Новый ОписаниеОповещения("ПослеКопированияИндексногоФайлаБиблиотеки", ЭтотОбъект, Контекст);
		НачатьКопированиеФайла(Оповещение, ИндексныйФайлЭталон(), ВременныйИндексныйФайл());
		
	ИначеЕсли Контекст.Свойство("ПопыткаИзвлеченияФайловБиблиотеки") Тогда
		ПоказатьОшибку(НСтр("ru = 'Библиотека повреждена.'"), Истина);
	Иначе
		ИзвлечьБиблиотеку(Контекст);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеКопированияИндексногоФайлаБиблиотеки(СкопированныйФайл, Контекст) Экспорт
	
	ИндексныйФайл = СкопированныйФайл;
	РедакторBSL = ИндексныйФайл;
	
	БиблиотекаBSLЗагружена = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзвлечьБиблиотеку(Контекст = Неопределено)
	
	Если Контекст = Неопределено Тогда
		Контекст = Новый Структура();
	КонецЕсли;
	
	Контекст.Вставить("ПопыткаИзвлеченияФайловБиблиотеки");
	
	Оповещение = Новый ОписаниеОповещения("ПослеУдаленияФайловБиблиотеки", ЭтотОбъект, Контекст);
	НачатьУдалениеФайлов(Оповещение, КаталогБиблиотеки, "*.*");
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеУдаленияФайловБиблиотеки(Контекст) Экспорт
	
	Если Контекст.Свойство("ПопыткаИзвлеченияФайловБиблиотеки") Тогда
		
		#Если Не ВебКлиент Тогда
			
			ДанныеБиблиотеки = ПолучитьИзВременногоХранилища(АдресБиблиотеки);
		
			Поток = ДанныеБиблиотеки.ОткрытьПотокДляЧтения();
			
			ЧтениеАрхива = Новый ЧтениеZipФайла(Поток);
			ЧтениеАрхива.ИзвлечьВсе(КаталогБиблиотеки, РежимВосстановленияПутейФайловZIP.Восстанавливать);
			ЧтениеАрхива.Закрыть();
			
			Поток.Закрыть();
			
			НачатьПроверкуСуществованияИндексногоФайлаБиблиотеки(Контекст);
		
		#КонецЕсли
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеПодтвержденияПереустановитьБиблиотеку(Подтверждение, Контекст) Экспорт
	
