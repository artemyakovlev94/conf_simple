Функция ПолучитьПредставлениеЗапроса(Запрос, Смещение, КешСсылок)
	
	МассивСтрок = Новый Массив();
	МассивСтрок.Добавить("**Запрос**:");
	
	Маркер = ДополнитьСтроку("- ", Смещение * 4, " ");
	
	Если Запрос.МенеджерВременныхТаблиц = Неопределено Тогда
		МассивСтрок.Добавить(Маркер + "МенеджерВременныхТаблиц: Не установлен");
	Иначе
		МассивСтрок.Добавить(Маркер + "МенеджерВременныхТаблиц: Установлен");
	КонецЕсли;
	
	ПредставлениеПараметров = ПолучитьПредставлениеСтруктурыСоответствия(Запрос.Параметры, Смещение + 1, КешСсылок);
	МассивСтрок.Добавить(ПредставлениеПараметров);
	
	МаркерТекста = ДополнитьСтроку("- ", (Смещение + 1) * 4, " ");
	МассивСтрок.Добавить(Маркер + "Текст: " + Символы.ПС + МаркерТекста + Запрос.Текст);
	
	Возврат СтрСоединить(МассивСтрок, Символы.ПС);
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьПредставлениеПеременной(Значение, Знач Смещение, КешСсылок)
	
	Представление = "";
	ТипЗнч = ТипЗнч(Значение);
	
	Смещение = Смещение + 1;
	
	Если ТипЗнч = Тип("Число") Или
		ТипЗнч = Тип("Строка") Или
		ТипЗнч = Тип("Булево") Или
		ТипЗнч = Тип("Дата") Тогда
		Представление = Строка(Значение);
	ИначеЕсли Значение = Неопределено Тогда
		Представление = "Неопределено";
	ИначеЕсли ТипЗнч = Тип("Null") Тогда
		Представление = "Null";
	ИначеЕсли ТипЗнч = Тип("Структура") Или
		ТипЗнч(Значение) = Тип("Соответствие") Тогда
		Представление = ПолучитьПредставлениеСтруктурыСоответствия(Значение, Смещение, КешСсылок);
	ИначеЕсли ТипЗнч = Тип("Массив") Или
		ТипЗнч(Значение) = Тип("СписокЗначений") Тогда
		Представление = ПолучитьПредставлениеСпискаЗначенийМассива(Значение, Смещение, КешСсылок);
	ИначеЕсли ТипЗнч = Тип("КлючИЗначение") Тогда
		Представление = ПолучитьПредставлениеКлючаЗначения(Значение, Смещение, КешСсылок);
	ИначеЕсли ТипЗнч = Тип("ЭлементСпискаЗначений") Тогда
		Представление = ПолучитьПредставлениеЭлементаСпискаЗначений(Значение, Смещение, КешСсылок);
	ИначеЕсли ТипЗнч = Тип("ТаблицаЗначений") Тогда
		//@skip-check bsl-nstr-string-literal-format
		Заголовок = НСтр("en = 'Value table'; ru = 'Таблица значений'");
		Представление = ПолучитьПредставлениеТаблицыЗначений(Значение, Заголовок, Смещение, КешСсылок);
	ИначеЕсли ТипЗнч = Тип("ДеревоЗначений") Тогда
		Представление = ПолучитьПредставлениеДереваЗначений(Значение, Смещение, КешСсылок);
	ИначеЕсли ТипЗнч = Тип("СтрокаТаблицыЗначений") Тогда
		Представление = ПолучитьПредставлениеСтрокиТаблицыЗначений(Значение, Смещение, КешСсылок);
	ИначеЕсли ТипЗнч = Тип("ХранилищеЗначения") Тогда
		Представление = Строка(Значение);
	ИначеЕсли ТипЗнч = Тип("Запрос") Тогда
		Представление = ПолучитьПредставлениеЗапроса(Значение, Смещение, КешСсылок);
	ИначеЕсли ЭтоПеречисление(Значение) Тогда
		Представление = Строка(Значение);
	ИначеЕсли ЭтоТабличнаяЧасть(Значение) Тогда
		Представление = ПолучитьПредставлениеТаблицыЗначений(Значение.Выгрузить(), ТипЗнч, Смещение, КешСсылок);
	ИначеЕсли ЭтоНаборЗаписейРегистра(Значение) Тогда
		Представление = ПолучитьПредставлениеТаблицыЗначений(Значение.Выгрузить(), ТипЗнч, Смещение, КешСсылок);
	ИначеЕсли ЭтоМенеджерЗаписиРегистра(Значение) Тогда
		Представление = ПолучитьПредставлениеМенеджераЗаписейРегистра(Значение, Смещение, КешСсылок);
	ИначеЕсли ЭтоСсылка(Значение) Тогда
		Представление = ПолучитьПредставлениеСсылки(Значение, КешСсылок, Ложь);
	Иначе
		Представление = Строка(Значение);
		Если ПустаяСтрока(Представление) Тогда
			Представление = Строка(ТипЗнч);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Представление;
	
КонецФункции

#КонецОбласти

#Область КонструкторЗапросов

&НаКлиенте
Процедура ВызватьКонструкторЗапроса(ПараметрыЗапроса)
	
	Если ПараметрыЗапроса = Неопределено Тогда
		
		Если РедактированиеДоступно() Тогда
			
			Оповещение = Новый ОписаниеОповещения("ВопросСоздатьНовыйЗапрос", ЭтотОбъект);
			ТекстВопроса = НСтр("ru = 'Не найден текст запроса.
			|Создать новый запрос?'");
			ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
			
		КонецЕсли;
		
	Иначе
		ТекстЗапроса = ПодготовитьТекстЗапроса(ПараметрыЗапроса.text);
		ОткрытьКонструкторЗапроса(ТекстЗапроса, ПараметрыЗапроса.range);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросСоздатьНовыйЗапрос(Ответ, Контекст) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ОткрытьКонструкторЗапроса("", Неопределено);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПодготовитьТекстЗапроса(Текст)
	
	ТекстЗапроса = СтрЗаменить(Текст, "|", "");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, """""", "$");	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, """", "");	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "$", """");
	
	Возврат ТекстЗапроса;
	
КонецФункции

&НаКлиенте
Процедура ОткрытьКонструкторЗапроса(Текст, Контекст)
	
	Конструктор = Новый КонструкторЗапроса();
	
	Если ЗначениеЗаполнено(Текст) Тогда
		
		Попытка
			Конструктор.Текст = Текст;
		Исключение
			ТекстПредупреждения = СтрШаблон(НСтр("ru = 'Ошибка в тексте запроса:
			|%1'"), ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			ПоказатьПредупреждение(, ТекстПредупреждения);
			Возврат;
		КонецПопытки;
		
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ПриЗакрытииКонструктораЗапросов", ЭтотОбъект, Контекст);
	Конструктор.Показать(Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытииКонструктораЗапросов(Текст, Контекст) Экспорт
	
	Если Текст <> Неопределено И РедактированиеДоступно() Тогда
		
		Если ЭтоСтраницаРедактораBSL() Тогда
			
			Если Не View().queryMode Тогда
				
				Текст = СтрЗаменить(Текст, Символы.ПС, Символы.ПС + "|");
				Текст = СтрЗаменить(Текст, """", """""");
				Текст = """" + Текст + """";
				
			КонецЕсли;
			
			УстановитьТекстРедактораBSL(Текст, Контекст, Истина);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область КонструкторФорматнойСтроки

&НаКлиенте
Процедура ВызватьКонструкторФорматнойСтроки(ПараметрыСтроки)
	
	Если ПараметрыСтроки = Неопределено Тогда
		
		Если РедактированиеДоступно() Тогда
			
			Оповещение = Новый ОписаниеОповещения("ВопросСоздатьНовуюФорматнуюСтроку", ЭтотОбъект);
			ТекстВопроса = НСтр("ru = 'Форматная строка не найдена.
			|Создать новую форматную строку?'");
			ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		
		КонецЕсли;
		
	Иначе
		ФорматнаяСтрока = СтрЗаменить(СтрЗаменить(ПараметрыСтроки.text, "|", ""), """", "");
		ОткрытьКонструкторФорматнойСтроки(ФорматнаяСтрока, ПараметрыСтроки.range);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросСоздатьНовуюФорматнуюСтроку(Ответ, Контекст) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ОткрытьКонструкторФорматнойСтроки("", Неопределено);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьКонструкторФорматнойСтроки(ФорматнаяСтрока, Контекст)
	
	Конструктор = Новый КонструкторФорматнойСтроки();
	
	Попытка			
		Конструктор.Текст = ФорматнаяСтрока;
	Исключение
		ТекстПредупреждения = СтрШаблон(НСтр("ru = 'Ошибка в тексте форматной строки:
		|%1'"), ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ПоказатьПредупреждение(, ТекстПредупреждения);
		Возврат;
	КонецПопытки;
	
	Оповещение = Новый ОписаниеОповещения("ПриЗакрытииКонструктораФорматнойСтроки", ЭтотОбъект, Контекст);
	Конструктор.Показать(Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытииКонструктораФорматнойСтроки(ФорматнаяСтрока, Контекст) Экспорт
	
	Если ФорматнаяСтрока <> Неопределено И РедактированиеДоступно() Тогда
		
		Если ЭтоСтраницаРедактораBSL() Тогда
			
			ФорматнаяСтрока = СтрЗаменить(ФорматнаяСтрока, "'", "");
			ФорматнаяСтрока = """" + ФорматнаяСтрока + """";
			
			УстановитьТекстРедактораBSL(ФорматнаяСтрока, Контекст, Ложь);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Прочее

&НаКлиенте
Процедура ПоказатьОшибку(ТекстОшибки, ЗакрытьРедактор = Ложь)
	
	Перем Оповещение;
	
	Если ЗакрытьРедактор Тогда
		Оповещение = Новый ОписаниеОповещения("ЗакрытьРедакторПослеОшибки", ЭтотОбъект);
		ТекстОшибки = ТекстОшибки + "
		|
		|Дальнейшая работа с редактором невозможна.";
	КонецЕсли;
	
	ПоказатьПредупреждение(Оповещение, ТекстОшибки, , НСтр("ru = 'Ошибка'"));
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьРедакторПослеОшибки(Контекст) Экспорт
	
	Модифицированность = Ложь;
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьСРезультатом(Результат = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	
	Модифицированность = Ложь;
	
	Если ЗакрытьСРезультатом Тогда
		
		Если ЭтоСтраницаРедактораBSL() Тогда
			РедактируемаяСтрока = ПолучитьТекстРедактораBSL();
		КонецЕсли;
		
		РезультатПриЗакрытии = РедактируемаяСтрока;
		
	Иначе
		РезультатПриЗакрытии = Неопределено;
	КонецЕсли;
	
	Закрыть(РезультатПриЗакрытии);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПодготовитьКоллекциюПользовательскихОбъектов(КоллекцияПользовательскихОбъектов)
	
	ИсключаемыеКлючи = Новый Массив();
	
	Для Каждого Элемент Из КоллекцияПользовательскихОбъектов Цикл
		
		Если Элемент.Значение.Свойство("exclude_bsl") Тогда
			ИсключаемыеКлючи.Добавить(Элемент.Ключ);
			Продолжить;
		КонецЕсли;
		
		Если Элемент.Значение.Свойство("preview") Тогда
			
			Если Не ПустаяСтрока(Элемент.Значение.preview) Тогда
				Элемент.Значение.Вставить("name", Элемент.Значение.preview);
			КонецЕсли;
			
			Элемент.Значение.Удалить("preview");
			
		КонецЕсли;
		
		Если Элемент.Значение.Свойство("ref") Тогда
			
			_ref = "";
			_XMLТип = Неопределено;
			
			Если ТипЗнч(Элемент.Значение.ref) = Тип("Тип") Тогда
				_XMLТип = XMLТип(Элемент.Значение.ref);
			КонецЕсли;
			
			Если _XMLТип <> Неопределено И 
				SUI_ОбщегоНазначения.ЭтоСсылка(Элемент.Значение.ref) Тогда
				
				ЧастиТипа = СтрРазделить(_XMLТип.ИмяТипа, ".");
				
				ВидТипа = НРег(Сред(ЧастиТипа[0], 1, СтрДлина(ЧастиТипа[0]) - 3));
				Если ВидТипа = "catalog" Или
					ВидТипа = "document" Или
					ВидТипа = "task" Или
					ВидТипа = "exchangeplan" Или
					ВидТипа = "enum" Тогда
					ВидТипа = ВидТипа + "s";
				ИначеЕсли ВидТипа = "chartofcharacteristictypes" Тогда
					ВидТипа = "chartsofcharacteristictypes";
				КонецЕсли;
				
				_ref = ВидТипа + "." + ЧастиТипа[1];
				
			КонецЕсли;
			
			Если ПустаяСтрока(_ref) Тогда
				Элемент.Значение.Удалить("ref");
			Иначе
				Элемент.Значение.Вставить("ref", _ref);
			КонецЕсли;
			
		КонецЕсли;
		
		Если Элемент.Значение.Свойство("properties") Тогда
			
			Если Элемент.Значение.properties.Количество() = 0 Тогда
				Элемент.Значение.Удалить("properties");
			Иначе
				ПодготовитьКоллекциюПользовательскихОбъектов(Элемент.Значение.properties);
			КонецЕсли;
			
		КонецЕсли;
		
		Если Элемент.Значение.Свойство("type") Тогда
			
			Если ТипЗнч(Элемент.Значение.type) = Тип("Строка") Тогда
				
				//@skip-check empty-except-statement
				Попытка
					Элемент.Значение.type = Тип(Элемент.Значение.type);
				Исключение
					//
				КонецПопытки;
				
			КонецЕсли;
			
			ПредставлениеТипа = SUI_ОбщегоНазначения.СтроковоеПредставлениеТипа(Элемент.Значение.type);
			
			Если Не ПустаяСтрока(ПредставлениеТипа) Тогда
				
				ПредставлениеТипа = "Тип: " + ПредставлениеТипа;
				
				Если Не Элемент.Значение.Свойство("description") Тогда
					Элемент.Значение.Вставить("description", ПредставлениеТипа);
				Иначе
					Элемент.Значение.description = Элемент.Значение.description + "
					|
					|(" + ПредставлениеТипа + ")";
				КонецЕсли;
				
			КонецЕсли;
			
			Элемент.Значение.Удалить("type");
			
		КонецЕсли;
		
	КонецЦикла;
	
	Для индекс = 0 По ИсключаемыеКлючи.ВГраница() Цикл
		КоллекцияПользовательскихОбъектов.Удалить(ИсключаемыеКлючи[индекс]);
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПривестиПользовательскиеОбъектыКСтрокеJSON(Знач КоллекцияПользовательскихОбъектов)
	
	Если ТипЗнч(КоллекцияПользовательскихОбъектов) = Тип("Структура") Тогда
		
		Результат = SUI_ОбщегоНазначения.СкопироватьРекурсивно(КоллекцияПользовательскихОбъектов, Ложь);
		
		Попытка
			
			ПодготовитьКоллекциюПользовательскихОбъектов(Результат);
			
			Запись = Новый ЗаписьJSON();
			Запись.УстановитьСтроку();
			ЗаписатьJSON(Запись, Новый Структура("customObjects", Результат));
			
			Результат = Запись.Закрыть();
			
		Исключение
			Результат = "";
			ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Не удалось получить пользовательские объекты'"));
		КонецПопытки;
		
	Иначе
		Результат = "";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ЭтоСтраницаРедактораBSL()
	Возврат Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаРедакторBSL;
КонецФункции

&НаКлиенте
Процедура ОпределитьРазделительПути()
	
	РазделительПути = ПолучитьРазделительПути();
	
КонецПроцедуры

&НаКлиенте
Функция НормализоватьПуть(Путь)
	
	Путь = СокрЛП(Путь);
	
	Если Прав(Путь, 1) <> РазделительПути Тогда
		Путь = Путь + РазделительПути;
	КонецЕсли;
	
	Возврат Путь;
	
КонецФункции

&НаКлиенте
Функция РедактированиеДоступно()
	Возврат Элементы.РежимРедактирования.Пометка;
КонецФункции

&НаКлиенте
Процедура СменитьРежимРедактирования(Значение = Неопределено)
	
	Если Значение = Неопределено Тогда
		Элементы.РежимРедактирования.Пометка = Не РедактированиеДоступно();
	Иначе
		Элементы.РежимРедактирования.Пометка = Значение;
	КонецЕсли;
	
	Если ЭтоСтраницаРедактораBSL() Тогда
		СменитьРежимРедактированияРедактораBSL();
	Иначе
		Элементы.РедактируемаяСтрока.ТолькоПросмотр = Не РедактированиеДоступно();
	КонецЕсли;
	
	Элементы.ФормаЗагрузитьИзФайла.Доступность = РедактированиеДоступно();
	Элементы.ФормаПредопределенныйКод.Доступность = РедактированиеДоступно();
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьКодРедактораПодтверждение(Подтверждение, Контекст) Экспорт
	
	Если Подтверждение = КодВозвратаДиалога.Да Тогда
		
		Если Контекст.ВРедактореBSL Тогда
			ОчиститьТекстРедактораBSL();
		КонецЕсли;
		
		РедактируемаяСтрока = "";
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ФильтрДиалогаФайлаКода()
	Возврат "Код BSL (*.bsl)|*.bsl";
КонецФункции

&НаСервереБезКонтекста
Функция ЗаписатьТекстРедактораВДвоичныеДанныеНаСервере(Текст, Идентификатор)
	
	ПотокЗаписи = Новый ПотокВПамяти();
	
	ДокументТекст = Новый ТекстовыйДокумент();
	ДокументТекст.УстановитьТекст(Текст);
	ДокументТекст.Записать(ПотокЗаписи, КодировкаТекста.UTF8, "");
	
	Возврат ПоместитьВоВременноеХранилище(ПотокЗаписи.ЗакрытьИПолучитьДвоичныеДанные(), Идентификатор);
	
КонецФункции

&НаКлиенте
Процедура СохранитьВФайлЗавершение(СохраненныеФайлы, Контекст) Экспорт
	
	Если СохраненныеФайлы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если СохраненныеФайлы.Количество() > 0 Тогда
		ФайловаяСистемаКлиент.ОткрытьПроводник(СохраненныеФайлы[0].ПолноеИмя);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзФайлаПослеПодтверждения(Подтверждение, Контекст) Экспорт
	
	Если Подтверждение <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ЗагрузитьИзФайлаПослеВыбораФайла", ЭтотОбъект);
	ПараметрыЗагрузкиФайла = ФайловаяСистемаКлиент.ПараметрыЗагрузкиФайла();
	ПараметрыЗагрузкиФайла.Диалог.Фильтр = ФильтрДиалогаФайлаКода();
	ПараметрыЗагрузкиФайла.Диалог.Заголовок = НСтр("ru = 'Загрузить код из файла'");
	
	ФайловаяСистемаКлиент.ЗагрузитьФайл(Оповещение, ПараметрыЗагрузкиФайла);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзФайлаПослеВыбораФайла(ПомещенныйФайл, Контекст) Экспорт
	
	Если ПомещенныйФайл = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗагруженныйФайл = Новый ТекстовыйДокумент();
	Оповещение = Новый ОписаниеОповещения("ПриЗавершенииЧтенияЗагруженногоФайлаКода", ЭтотОбъект, ЗагруженныйФайл);
	ЗагруженныйФайл.НачатьЧтение(Оповещение, ПомещенныйФайл.Имя, КодировкаТекста.UTF8);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗавершенииЧтенияЗагруженногоФайлаКода(ЗагруженныйФайл) Экспорт
	
	РедактируемаяСтрока = ЗагруженныйФайл.ПолучитьТекст();
	
	Если ЭтоСтраницаРедактораBSL() Тогда
		ОчиститьТекстРедактораBSL();
		УстановитьТекстРедактораBSL(РедактируемаяСтрока, Неопределено, Ложь);
		УстановитьОригинальныйТекстРедактораBSL(РедактируемаяСтрока);
	КонецЕсли;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура СформироватьДеревоОписанияПользовательскихОбъектов(КоллекцияПользовательскихОбъектов, ЭлементыДерева = Неопределено)
	
	Для Каждого ЭлементКоллекции Из КоллекцияПользовательскихОбъектов Цикл
		
		НовыйЭлементДерева = ЭлементыДерева.Добавить();
		
		НовыйЭлементДерева.Имя = ЭлементКоллекции.Ключ;
		
		Если ЭлементКоллекции.Значение.Свойство("type") Тогда
			
			Если ТипЗнч(ЭлементКоллекции.Значение.type) = Тип("Строка") Тогда
				
				//@skip-check empty-except-statement
				Попытка
					ЭлементКоллекции.Значение.type = Тип(ЭлементКоллекции.Значение.type);
				Исключение
					//
				КонецПопытки;
				
			КонецЕсли;
			
			НовыйЭлементДерева.Тип = SUI_ОбщегоНазначения.СтроковоеПредставлениеТипа(ЭлементКоллекции.Значение.type);
			
		КонецЕсли;
		
		ЭлементКоллекции.Значение.Свойство("description", НовыйЭлементДерева.Описание);
		
		Если ЭлементКоллекции.Значение.Свойство("properties") И ЭлементКоллекции.Значение.properties.Количество() > 0 Тогда
			СформироватьДеревоОписанияПользовательскихОбъектов(ЭлементКоллекции.Значение.properties, НовыйЭлементДерева.ПолучитьЭлементы());
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ВставитьПеременнуюВРедакторКода(ИдентификаторПеременной)
	
	Если ЭтоСтраницаРедактораBSL() Тогда
		
		СтрокаОписанияПеременной = ДеревоОписаниеПеременных.НайтиПоИдентификатору(ИдентификаторПеременной);
				
		Если СтрокаОписанияПеременной <> Неопределено Тогда
			
			ТекстВставки = СтрокаОписанияПеременной.Имя;
			СтрокаРодитель = СтрокаОписанияПеременной.ПолучитьРодителя();
			
			Пока СтрокаРодитель <> Неопределено Цикл
				ТекстВставки = СтрокаРодитель.Имя + "." + ТекстВставки;
				СтрокаРодитель = СтрокаРодитель.ПолучитьРодителя();
			КонецЦикла;
			
			Если Не ПустаяСтрока(ТекстВставки) Тогда
				ЗаменитьВыделенныйТекстРедактораBSL(ТекстВставки);
				ТекущийЭлемент = Элементы.РедакторBSL;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВставитьПредопределенныйКодПодтверждение(Подтверждение, Контекст) Экспорт
	
	Если Подтверждение <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ВставитьПредопределенныйКодПослеВыбора", ЭтотОбъект, Контекст);
	
	Если ПредопределенныйТекст.Количество() = 1 Тогда
		ВыполнитьОбработкуОповещения(Оповещение, ПредопределенныйТекст[0].Значение);
	Иначе
		ПараметрыВыбора = Новый Структура();
		ПараметрыВыбора.Вставить("Заголовок", НСтр("ru = 'Предопределенный код'"));
		ПараметрыВыбора.Вставить("СписокВыбора", ПредопределенныйТекст);
		ОткрытьФорму("ОбщаяФорма.SUI_ВыборИзСписка", ПараметрыВыбора, ЭтотОбъект, УникальныйИдентификатор, , ,
			Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВставитьПредопределенныйКодПослеВыбора(ВыбранныйПредопределенныйКод, Контекст) Экспорт
	
	Если ВыбранныйПредопределенныйКод = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Контекст.ВРедакторBSL Тогда
		ОчиститьТекстРедактораBSL();
		УстановитьТекстРедактораBSL(ВыбранныйПредопределенныйКод, Неопределено, Ложь);
	Иначе
		РедактируемаяСтрока = ВыбранныйПредопределенныйКод;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти
