  <attributes>
    <name>МобильныеУстройства</name>
    <title>
      <key>ru</key>
      <value>Мобильные устройства</value>
    </title>
    <id>7</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>МобильныеУстройства.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	SUI_МобильныеУстройства.Ссылка,
	SUI_МобильныеУстройства.ПометкаУдаления,
	SUI_МобильныеУстройства.Код,
	SUI_МобильныеУстройства.Наименование,
	SUI_МобильныеУстройства.IPАдрес,
	SUI_МобильныеУстройства.Порт,
	SUI_МобильныеУстройства.ЭтотУзел,
	ВЫБОР
		КОГДА SUI_МобильныеУстройства.ЭтотУзел
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК ЭтоПредопределенный,
	ЕСТЬNULL(SUI_СеансыМобильныхУстройств.ДатаСеанса, ДАТАВРЕМЯ(1, 1, 1)) КАК ПоследнийСеанс,
	ЕСТЬNULL(SUI_СеансыМобильныхУстройств.ВерсияПриложения, &quot;0.0.0.0&quot;) КАК ВерсияПриложения,
	ЕСТЬNULL(SUI_СостоянияМобильныхУстройств.Состояние,
		ЗНАЧЕНИЕ(Перечисление.SUI_СостоянияМобильныхУстройств.ПустаяСсылка)) КАК ТекущееСостояние,
	SUI_СостоянияМобильныхУстройств.ДатаОбновления КАК ДатаСостояния,
	ВЫБОР
		КОГДА НЕ SUI_МобильныеУстройства.ЭтотУзел
		И (SUI_СеансыМобильныхУстройств.ДатаСеанса ЕСТЬ NULL
		ИЛИ SUI_СеансыМобильныхУстройств.ДатаСеанса &lt; &amp;ДатаОтсутствияСеанса)
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК ИндексКартинки,
	SUI_МобильныеУстройства.Представление
ИЗ
	ПланОбмена.SUI_МобильныеУстройства КАК SUI_МобильныеУстройства
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.SUI_СеансыМобильныхУстройств КАК SUI_СеансыМобильныхУстройств
		ПО SUI_СеансыМобильныхУстройств.МобильноеУстройство = SUI_МобильныеУстройства.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.SUI_СостоянияМобильныхУстройств КАК SUI_СостоянияМобильныхУстройств
		ПО SUI_МобильныеУстройства.Ссылка = SUI_СостоянияМобильныхУстройств.МобильноеУстройство</queryText>
      <mainTable>ExchangePlan.SUI_МобильныеУстройства</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
