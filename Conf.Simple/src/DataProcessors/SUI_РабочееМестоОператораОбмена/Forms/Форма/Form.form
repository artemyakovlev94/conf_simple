    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ДокументыОбмена.ДокументОснование</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ДокументыОбмена.ДокументОснованиеПредставление</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ДокументыОбмена.Ссылка</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ДокументыОбмена.Товары</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	Ссылка КАК Ссылка,
	КОЛИЧЕСТВО(ИдентификаторСтроки) КАК Строк,
	СУММА(КоличествоПлан) КАК КоличествоПлан,
	СУММА(КоличествоФакт) КАК КоличествоФакт
ПОМЕСТИТЬ втТовары
ИЗ
	Документ.SUI_ДокументОбмена.Товары
СГРУППИРОВАТЬ ПО
	Ссылка

ИНДЕКСИРОВАТЬ ПО
	Ссылка
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Ссылка КАК Ссылка,
	КОЛИЧЕСТВО(ИдентификаторСтроки) КАК Строк,
	СУММА(КоличествоФакт) КАК КоличествоФакт
ПОМЕСТИТЬ втСерии
ИЗ
	Документ.SUI_ДокументОбмена.Серии
СГРУППИРОВАТЬ ПО
	Ссылка

ИНДЕКСИРОВАТЬ ПО
	Ссылка
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Ссылка КАК Ссылка,
	КОЛИЧЕСТВО(ИдентификаторСтроки) КАК Строк
ПОМЕСТИТЬ втШтрихкодыУпаковок
ИЗ
	Документ.SUI_ДокументОбмена.ШтрихкодыУпаковок
СГРУППИРОВАТЬ ПО
	Ссылка

ИНДЕКСИРОВАТЬ ПО
	Ссылка
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ДокументОбмена КАК Ссылка,
	КОЛИЧЕСТВО(ИдентификаторСтроки) КАК Строк,
	КОЛИЧЕСТВО(КоличествоФакт) КАК КоличествоФакт
ПОМЕСТИТЬ втГрупповойПересчет
ИЗ
	РегистрСведений.SUI_ГрупповойПересчет
СГРУППИРОВАТЬ ПО
	ДокументОбмена

ИНДЕКСИРОВАТЬ ПО
	Ссылка
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ДокументОбмена КАК Ссылка,
	КОЛИЧЕСТВО(Штрихкод) КАК КоличествоШтрихкодов,
	СУММА(Количество) КАК КоличествоФакт
ПОМЕСТИТЬ втПотокШтрихкодов
ИЗ
	РегистрСведений.SUI_ПотокШтрихкодов
СГРУППИРОВАТЬ ПО
	ДокументОбмена

ИНДЕКСИРОВАТЬ ПО
	Ссылка
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	NULL КАК Ссылка,
	NULL КАК ДокументОснованиеПредставление,
	ДокументОбмена.Ссылка КАК ДокументОбмена,
	ДокументОбмена.ПометкаУдаления КАК ПометкаУдаления,
	ДокументОбмена.Номер КАК Номер,
	ДокументОбмена.Дата КАК Дата,
	ДокументОбмена.Проведен КАК Проведен,
	ДокументОбмена.Состояние КАК Состояние,
	ДокументОбмена.НастройкаДокумента КАК НастройкаДокумента,
	ДокументОбмена.ДокументОснование КАК ДокументОснование,
	ДокументОбмена.НомерДокументаОснования КАК НомерДокументаОснования,
	ДокументОбмена.ДатаДокументаОснования КАК ДатаДокументаОснования,
	ДокументОбмена.Контрагент КАК Контрагент,
	ДокументОбмена.Склад КАК Склад,
	ДокументОбмена.Комментарий КАК Комментарий,
	ДокументОбмена.ШтрихкодДокумента КАК ШтрихкодДокумента,
	ДокументОбмена.ПризнакМаркировки КАК ПризнакМаркировки,
	ДокументОбмена.ТипДокумента КАК ТипДокумента,
	ДокументОбмена.ДатаСостояния КАК ДатаСостояния,
	ДокументОбмена.МоментВремени КАК МоментВремени,
	ДокументОбмена.Товары.*,
	ДокументОбмена.Серии.*,
	ДокументОбмена.ШтрихкодыУпаковок.*,
	ЕСТЬNULL(втТовары.Строк, 0) КАК ТоварыВсегоСтрок,
	ЕСТЬNULL(втТовары.КоличествоПлан, 0) КАК ТоварыПлан,
	ЕСТЬNULL(втТовары.КоличествоФакт, 0) КАК ТоварыФакт,
	ЕСТЬNULL(втСерии.Строк, 0) КАК СерииВсегоСтрок,
	ЕСТЬNULL(втСерии.КоличествоФакт, 0) КАК СерииФакт,
	ЕСТЬNULL(втШтрихкодыУпаковок.Строк, 0) КАК ШтрихкодыУпаковокВсегоСтрок,
	ЕСТЬNULL(втГрупповойПересчет.Строк, 0) КАК ГрупповойПересчетВсегоСтрок,
	ЕСТЬNULL(втГрупповойПересчет.КоличествоФакт, 0) КАК ГрупповойПересчетФакт,
	ЕСТЬNULL(втПотокШтрихкодов.КоличествоШтрихкодов, 0) КАК ПотокШтрихкодовВсегоСтрок,
	ЕСТЬNULL(втПотокШтрихкодов.КоличествоФакт, 0) КАК ПотокШтрихкодовФакт,
	ВЫБОР
		КОГДА ДокументОбмена.Состояние = ЗНАЧЕНИЕ(Перечисление.SUI_СостоянияДокументовОбмена.Новый)
			ТОГДА 0
		КОГДА ДокументОбмена.Состояние = ЗНАЧЕНИЕ(Перечисление.SUI_СостоянияДокументовОбмена.КВыгрузке)
			ТОГДА 1
		КОГДА ДокументОбмена.Состояние = ЗНАЧЕНИЕ(Перечисление.SUI_СостоянияДокументовОбмена.Выгружен)
			ТОГДА 2
		КОГДА ДокументОбмена.Состояние = ЗНАЧЕНИЕ(Перечисление.SUI_СостоянияДокументовОбмена.Загружен)
			ТОГДА 3
		КОГДА ДокументОбмена.Состояние = ЗНАЧЕНИЕ(Перечисление.SUI_СостоянияДокументовОбмена.ВРаботе)
			ТОГДА 4
		КОГДА ДокументОбмена.Состояние = ЗНАЧЕНИЕ(Перечисление.SUI_СостоянияДокументовОбмена.Завершен)
			ТОГДА 5
		КОГДА ДокументОбмена.Состояние = ЗНАЧЕНИЕ(Перечисление.SUI_СостоянияДокументовОбмена.Отменен)
			ТОГДА 6
	КОНЕЦ КАК ИндексКартинки,
	ВЫБОР
		КОГДА ДокументОбмена.ПометкаУдаления
			ТОГДА 3
		ИНАЧЕ 1
	КОНЕЦ ИндексСтандартнойКартинки
ИЗ
	Документ.SUI_ДокументОбмена КАК ДокументОбмена
		ЛЕВОЕ СОЕДИНЕНИЕ втТовары КАК втТовары
		ПО (ДокументОбмена.Ссылка = втТовары.Ссылка)
		ЛЕВОЕ СОЕДИНЕНИЕ втСерии КАК втСерии
		ПО (ДокументОбмена.Ссылка = втСерии.Ссылка)
		ЛЕВОЕ СОЕДИНЕНИЕ втШтрихкодыУпаковок КАК втШтрихкодыУпаковок
		ПО (ДокументОбмена.Ссылка = втШтрихкодыУпаковок.Ссылка)
		ЛЕВОЕ СОЕДИНЕНИЕ втГрупповойПересчет КАК втГрупповойПересчет
		ПО (ДокументОбмена.Ссылка = втГрупповойПересчет.Ссылка)
		ЛЕВОЕ СОЕДИНЕНИЕ втПотокШтрихкодов КАК втПотокШтрихкодов
		ПО (ДокументОбмена.Ссылка = втПотокШтрихкодов.Ссылка)</queryText>
      <mainTable>Document.SUI_ДокументОбмена</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
