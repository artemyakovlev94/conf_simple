&НаСервереБезКонтекста
Процедура СписокДокументовОбменаПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
	
	Для Каждого СтрокаСписка Из Строки Цикл
		СтрокаСписка.Значение.Данные.Ссылка = SUI_ИнтеграцияВКонфигурацию.СсылкаПоИдентификаторуSimple(
			СтрокаСписка.Ключ.id_doc, Истина);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура СписокДокументовОбменаПриАктивизацииСтроки(Элемент)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды >>>
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// СтандартныеПодсистемы.ПодключаемыеКоманды <<<
	
	ОтобразитьИнформациюОТекущейСтроке(Элемент.ТекущиеДанные);

КонецПроцедуры

&НаКлиенте
Процедура СписокДокументовОбменаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Элементы.СписокДокументовОбмена.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Элементы.СписокДокументовОбмена.ТекущиеДанные.Состояние = ПредопределенноеЗначение("Перечисление.SUI_СостоянияДокументовОбмена.Загружен") Тогда
		SUI_ДокументыОбменаКлиент.ОткрытьЗагрузкуДокументаИзТСД(
			Элементы.СписокДокументовОбмена.ТекущиеДанные.Ссылка, Новый Структура("Форма", ЭтотОбъект));	
	Иначе
		SUI_ДокументыОбменаКлиент.ОткрытьПросмотрДокументаИзТСД(
			Элементы.СписокДокументовОбмена.ТекущиеДанные.Ссылка, Новый Структура("Форма", ЭтотОбъект));		       
	КонецЕсли;

КонецПроцедуры

