//	ПараметрыВыбораДокумента.Вставить("НастройкаДокумента", Неопределено);

	ОповещениеОЗавершении = Новый ОписаниеОповещения("ВыбратьДокументДляВыгрузкиЗавершение", ЭтотОбъект);
	
