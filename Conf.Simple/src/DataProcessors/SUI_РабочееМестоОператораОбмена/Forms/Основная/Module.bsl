#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Функция ПодключаемыеКоманды_Источники()
	
	Источники = Новый Массив();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	SUI_НастройкиДокументов.ИмяОбъектаМетаданных КАК ИмяОбъектаМетаданных
	|ИЗ
	|	Справочник.SUI_НастройкиДокументов КАК SUI_НастройкиДокументов";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Источники.Добавить(Тип("ДокументСсылка." + Выборка.ИмяОбъектаМетаданных));	
	КонецЦикла;
	
	Возврат Новый ОписаниеТипов(Источники);
	
КонецФункции

&НаСервере
Процедура ОтборСпискаДокументовОбменаПоНаименованию_ЗагрузитьСписокВыбора()

	Элементы.ОтборСпискаДокументовОбменаПоНаименованию.СписокВыбора.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	""Все"" КАК Наименование,
	|	КОЛИЧЕСТВО(SUI_docs_beta.sid) КАК Количество
	|ИЗ
	|	РегистрСведений.SUI_docs КАК SUI_docs_beta
	|СГРУППИРОВАТЬ ПО
	|	ЗНАЧЕНИЕ(Справочник.SUI_НастройкиДокументов.ПустаяСсылка)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	SUI_docs_beta.doc_type,
	|	КОЛИЧЕСТВО(SUI_docs_beta.doc_type)
	|ИЗ
	|	РегистрСведений.SUI_docs КАК SUI_docs_beta
	|СГРУППИРОВАТЬ ПО
	|	SUI_docs_beta.doc_type
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	SUI_НастройкиДокументов.Наименование,
	|	0
	|ИЗ
	|	Справочник.SUI_НастройкиДокументов КАК SUI_НастройкиДокументов
	|ГДЕ
	|	НЕ SUI_НастройкиДокументов.Ссылка В
	|		(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|			SUI_docs.НастройкаДокумента
	|		ИЗ
	|			РегистрСведений.SUI_docs КАК SUI_docs)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Количество УБЫВ";
	 
	РезультатЗапроса = Запрос.Выполнить();
	 
	Выборка = РезультатЗапроса.Выбрать();
	 
	Пока Выборка.Следующий() Цикл
		Элементы.ОтборСпискаДокументовОбменаПоНаименованию.СписокВыбора.Добавить(Выборка.Наименование, 
			Выборка.Наименование + " (" + Строка(Выборка.Количество) + ")");
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборСпискаДокументовОбмена()
	
	Если ОтборСпискаДокументовОбменаВсеСостояния Тогда
		SUI_КомпоновкаДанныхКлиентСервер.УдалитьОтбор(СписокДокументовОбмена.Отбор, "Состояние");
	Иначе
		
		СостоянияКОтображению = Новый СписокЗначений();
		
		СостоянияКОтображению.Добавить(ПредопределенноеЗначение("Перечисление.SUI_СостоянияДокументовОбмена.Новый"));
		СостоянияКОтображению.Добавить(ПредопределенноеЗначение("Перечисление.SUI_СостоянияДокументовОбмена.КВыгрузке"));
		СостоянияКОтображению.Добавить(ПредопределенноеЗначение("Перечисление.SUI_СостоянияДокументовОбмена.Выгружен"));
		СостоянияКОтображению.Добавить(ПредопределенноеЗначение("Перечисление.SUI_СостоянияДокументовОбмена.Загружен"));
		СостоянияКОтображению.Добавить(ПредопределенноеЗначение("Перечисление.SUI_СостоянияДокументовОбмена.ВРаботе"));
		
		SUI_КомпоновкаДанныхКлиентСервер.ДобавитьОтбор(СписокДокументовОбмена.Отбор, "Состояние", 
			СостоянияКОтображению, ВидСравненияКомпоновкиДанных.ВСписке);
	
	КонецЕсли;
	
	Если ОтборСпискаДокументовОбменаПоНаименованию = "Все" Тогда 		 
		SUI_КомпоновкаДанныхКлиентСервер.УдалитьОтбор(СписокДокументовОбмена.Отбор, "Наименование");
	Иначе 
		SUI_КомпоновкаДанныхКлиентСервер.ДобавитьОтбор(СписокДокументовОбмена.Отбор, "Наименование", ОтборСпискаДокументовОбменаПоНаименованию);
	КонецЕсли
	
КонецПроцедуры

//@skip-check bsl-nstr-string-literal-format
&НаКлиенте
Процедура ОтобразитьИнформациюОТекущейСтроке(ДанныеСтроки)
	
	Если ДанныеСтроки <> Неопределено Тогда
		
		Элементы.ГруппаСписокДокументовОбменаИнформацияТекущейСтроки.Видимость = Истина;
		
		Если ДанныеСтроки.Свойство("Наименование") И ДанныеСтроки.Свойство("Ссылка") И
			ЗначениеЗаполнено(ДанныеСтроки.Наименование) И ЗначениеЗаполнено(ДанныеСтроки.Ссылка) Тогда
			Элементы.СписокДокументовОбменаГиперссылкаДокумента.Заголовок = СтрШаблон(НСтр("ru = '%1 (%2)'"),
				ДанныеСтроки.Наименование, ДанныеСтроки.Ссылка);
		Иначе
			Элементы.СписокДокументовОбменаГиперссылкаДокумента.Заголовок = "";
		КонецЕсли;
		
		Если ДанныеСтроки.Свойство("НастройкаДокумента") И ЗначениеЗаполнено(ДанныеСтроки.НастройкаДокумента) Тогда
			Элементы.СписокДокументовОбменаГиперссылкаНастройкаДокумента.Заголовок = СтрШаблон(
				НСтр("ru = 'Настройка документа: %1'"), ДанныеСтроки.НастройкаДокумента);
		Иначе
			Элементы.СписокДокументовОбменаГиперссылкаНастройкаДокумента.Заголовок = "";
		КонецЕсли;
		
		Если ДанныеСтроки.Свойство("МобильноеУстройство") И ЗначениеЗаполнено(ДанныеСтроки.МобильноеУстройство) Тогда	
			Элементы.СписокДокументовОбменаГиперссылкаМобильноеУстройствоДокумента.Заголовок = СтрШаблон(
				НСтр("ru = 'Мобильное устройство документа: %1'"), ДанныеСтроки.МобильноеУстройство);
		Иначе
			Элементы.СписокДокументовОбменаГиперссылкаМобильноеУстройствоДокумента.Заголовок = "";
		КонецЕсли;
		
		//@skip-check new-font
		ШрифтЗначения = Новый Шрифт(, , , Истина);
		ЦветЗначения = WebЦвета.СинийСоСтальнымОттенком;
		
		МассивФС = Новый Массив();
		
		МассивФС.Добавить(НСтр("ru = 'Номер и дата документа: '"));
		МассивФС.Добавить(Новый ФорматированнаяСтрока(ДанныеСтроки.Номер + " от " + ДанныеСтроки.Дата, ШрифтЗначения, ЦветЗначения));
		МассивФС.Добавить(Символы.ПС + Символы.ПС);
		
		МассивФС.Добавить(НСтр("ru = 'Текущее состояние: '"));
		МассивФС.Добавить(Новый ФорматированнаяСтрока(Строка(ДанныеСтроки.Состояние), ШрифтЗначения, ЦветЗначения));
		МассивФС.Добавить(Символы.ПС + Символы.ПС);
		
		МассивФС.Добавить(НСтр("ru = 'Документ адресного хранения: '"));
		МассивФС.Добавить(Новый ФорматированнаяСтрока(Строка(ДанныеСтроки.ЭтоДокументАдресногоХранения), ШрифтЗначения, ЦветЗначения));
		МассивФС.Добавить(Символы.ПС + Символы.ПС);
		
		МассивФС.Добавить(НСтр("ru = 'Товары: '"));
		МассивФС.Добавить(Новый ФорматированнаяСтрока(СтрШаблон(НСтр("ru = ' %1 строк (-и)'"), 
			ДанныеСтроки.КоличествоСтрокТовары), ШрифтЗначения, ЦветЗначения));
		МассивФС.Добавить(Символы.ПС);
		
		МассивФС.Добавить(НСтр("ru = 'Штрихкоды упаковок: '"));
		МассивФС.Добавить(Новый ФорматированнаяСтрока(СтрШаблон(НСтр("ru = ' %1 строк (-и)'"), 
			ДанныеСтроки.КоличествоСтрокШтрихкодыУпаковок), ШрифтЗначения, ЦветЗначения));
		МассивФС.Добавить(Символы.ПС);
			
		МассивФС.Добавить(НСтр("ru = 'Серии: '"));
		МассивФС.Добавить(Новый ФорматированнаяСтрока(СтрШаблон(НСтр("ru = ' %1 строк (-и)'"), 
			ДанныеСтроки.КоличествоСтрокСерии), ШрифтЗначения, ЦветЗначения));
		МассивФС.Добавить(Символы.ПС + Символы.ПС);
					
		МассивФС.Добавить(НСтр("ru = 'Сумма план / факт: '"));
		Если ДанныеСтроки.СуммаПлан <> ДанныеСтроки.СуммаФакт Или 
			(ДанныеСтроки.СуммаПлан = 0 И ДанныеСтроки.СуммаФакт = 0) Тогда
			МассивФС.Добавить(Новый ФорматированнаяСтрока(Строка(ДанныеСтроки.СуммаПлан) + " / " + Строка(ДанныеСтроки.СуммаФакт), 
				ШрифтЗначения, WebЦвета.Киноварь));
		Иначе
			МассивФС.Добавить(Новый ФорматированнаяСтрока(Строка(ДанныеСтроки.СуммаПлан) + " / " + Строка(ДанныеСтроки.СуммаФакт), 
				ШрифтЗначения, ЦветЗначения));
		КонецЕсли;
		МассивФС.Добавить(Символы.ПС + Символы.ПС);
		
		МассивФС.Добавить(НСтр("ru = 'Дата обновления: '"));
		МассивФС.Добавить(Новый ФорматированнаяСтрока(Строка(ДанныеСтроки.ДатаОбновления), ШрифтЗначения, ЦветЗначения));
	
		Элементы.СписокДокументовОбменаИнформацияТекущейСтроки.Заголовок = Новый ФорматированнаяСтрока(МассивФС);
		
	Иначе
		Элементы.ГруппаСписокДокументовОбменаИнформацияТекущейСтроки.Видимость = Ложь;
		Элементы.СписокДокументовОбменаГиперссылкаДокумента.Заголовок = "";
		Элементы.СписокДокументовОбменаГиперссылкаНастройкаДокумента.Заголовок = "";
		Элементы.СписокДокументовОбменаГиперссылкаМобильноеУстройствоДокумента.Заголовок = "";
		Элементы.СписокДокументовОбменаИнформацияТекущейСтроки.Заголовок = "";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЗаголовокЗапросыАвторизации()
	ОбновитьЗаголовокЗапросыАвторизацииНаСервере();
КонецПроцедуры

&НаСервере
Процедура ОбновитьЗаголовокЗапросыАвторизацииНаСервере()
	
	Если Не ПолучитьФункциональнуюОпцию("SUI_ИспользоватьЗапросыАвторизацииМУ") Тогда
		Возврат;
	КонецЕсли;
	
	Схема = Элементы.СписокЗапросыАвторизации.ПолучитьИсполняемуюСхемуКомпоновкиДанных();
	Настройки = Элементы.СписокЗапросыАвторизации.ПолучитьИсполняемыеНастройкиКомпоновкиДанных();
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных();
	МакетКомпоновки = КомпоновщикМакета.Выполнить(Схема, Настройки, , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	Запрос = Новый Запрос;
	Запрос.Текст = МакетКомпоновки.НаборыДанных.НаборДанныхДинамическогоСписка.Запрос;
	
	ПозВыбратьНачало = СтрНайти(Запрос.Текст, "ВЫБРАТЬ ", НаправлениеПоиска.СКонца);
	Пока НЕ ПозВыбратьНачало = 1
		и НЕ Сред(Запрос.Текст, ПозВыбратьНачало - 1, 1) = Символы.ПС Цикл
		ПозВыбратьНачало = СтрНайти(Запрос.Текст, "ВЫБРАТЬ ", НаправлениеПоиска.СКонца, ПозВыбратьНачало - 1);
	КонецЦикла;
	ПозВыбратьКонец = СтрНайти(Запрос.Текст, Символы.ПС,, ПозВыбратьНачало);
	
	СтрокаВЫБРАТЬ = Лев(Запрос.Текст, ПозВыбратьКонец);
	СтрокаИз = Сред(Запрос.Текст, СтрНайти(Запрос.Текст, Символы.ПС + "ИЗ" + Символы.ПС,, ПозВыбратьКонец));
	
	Если СтрНайти(СтрокаИз, Символы.ПС + "СГРУППИРОВАТЬ") Тогда
		СтрокаИз = Лев(СтрокаИз, СтрНайти(СтрокаИз, Символы.ПС + "СГРУППИРОВАТЬ"));
	КонецЕсли;
	
	Запрос.Текст = СтрокаВЫБРАТЬ + "Количество(*) КАК Количество" + СтрокаИз;
	Если СтрНайти(Запрос.Текст, Символы.ПС + "УПОРЯДОЧИТЬ ПО",, ПозВыбратьКонец) Тогда
		Запрос.Текст = Лев(Запрос.Текст, СтрНайти(Запрос.Текст, Символы.ПС + "УПОРЯДОЧИТЬ ПО",, ПозВыбратьКонец));
	КонецЕсли;
	
	Для Каждого парам из МакетКомпоновки.ЗначенияПараметров Цикл
		Запрос.УстановитьПараметр(парам.Имя, парам.Значение);
	КонецЦикла;
	
	Попытка
		Результат = Запрос.Выполнить();
	Исключение
		SUI_ЖурналРегистрации.ЗаписьВЖурналРегистрации(, , Метаданные.ОбщиеМодули.SUI_ОбщегоНазначенияВызовСервера,
			 , ИнформацияОбОшибке());
	КонецПопытки;
	
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	
	Если Выборка.Количество > 0 Тогда
		Элементы.ГруппаСписокЗапросыАвторизации.Заголовок = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Запросы авторизации (%1)'"), Выборка.Количество);
		Элементы.ГруппаСписокЗапросыАвторизации.ЦветТекстаЗаголовка = WebЦвета.ЦветМорскойВолны;
	Иначе
		Элементы.ГруппаСписокЗапросыАвторизации.Заголовок = НСтр("ru = 'Запросы авторизации'");
		Элементы.ГруппаСписокЗапросыАвторизации.ЦветТекстаЗаголовка = WebЦвета.ГрифельноСерый;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьДокументДляВыгрузкиЗавершение(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если Не ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Возврат;
	КонецЕсли;
	
	ОткрытьФорму("ОбщаяФорма.SUI_ВыгрузкаДокументаНаТСД", ВыбранноеЗначение, ЭтотОбъект, УникальныйИдентификатор);
	
КонецПроцедуры

#КонецОбласти
