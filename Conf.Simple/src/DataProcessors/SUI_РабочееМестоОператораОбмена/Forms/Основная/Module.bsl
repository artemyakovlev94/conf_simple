
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ОтборСпискаДокументовОбменаПоНаименованию_ЗагрузитьСписокВыбора();
	
	Если Элементы.ОтборСпискаДокументовОбменаПоНаименованию.СписокВыбора.Количество() > 0 Тогда
		ОтборСпискаДокументовОбменаПоНаименованию = Элементы.ОтборСпискаДокументовОбменаПоНаименованию.СписокВыбора[0].Значение;
	КонецЕсли;

	// СтандартныеПодсистемы.ПодключаемыеКоманды >>>
	ПараметрыРазмещения = ПодключаемыеКоманды.ПараметрыРазмещения();
	ПараметрыРазмещения.Источники = ПодключаемыеКоманды_Источники();
	ПараметрыРазмещения.КоманднаяПанель = Элементы.СписокДокументовОбмена.КоманднаяПанель;
	ПараметрыРазмещения.ПрефиксГрупп = "СписокДокументовОбменаПодключаемыеКоманды_";
	
	Если ПараметрыРазмещения.Источники.Типы().Количество() > 0 Тогда
		
		ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыРазмещения);
		
		Для Каждого ПодчиненныйЭлементКПСписка Из Элементы.СписокДокументовОбмена.КоманднаяПанель.ПодчиненныеЭлементы Цикл
			
			Если ПодчиненныйЭлементКПСписка.Вид <> ВидГруппыФормы.Подменю Тогда
				Продолжить;
			КонецЕсли;
			
			Если ПодчиненныйЭлементКПСписка.Имя <> "СписокДокументовОбменаПодключаемыеКоманды_ПодменюПечать" И 
				ПодчиненныйЭлементКПСписка.Имя <> "СписокДокументовОбменаПодключаемыеКоманды_ПодменюОтчеты" И 
				ПодчиненныйЭлементКПСписка.Имя <> "СписокДокументовОбмена_Действия" И
				ПодчиненныйЭлементКПСписка.Имя <> "СписокДокументовОбменаПодключаемыеКоманды_SUI_ПодменюДокументыОбмена" Тогда
				ПодчиненныйЭлементКПСписка.Видимость = Ложь;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	// СтандартныеПодсистемы.ПодключаемыеКоманды <<<

	ДатаОтсутствияСеанса = ТекущаяДатаСеанса() - SUI_МобильныеУстройстваСервер.СрокДействительностиСеансаВСекундах();
	SUI_КомпоновкаДанныхКлиентСервер.УстановитьПараметр(СписокМобильныхУстройств.КомпоновщикНастроек, "ДатаОтсутствияСеанса", ДатаОтсутствияСеанса);
	
	Заголовок = РежимОбмена;
	
	// Отобразить QR код для скачивания мобильного приложения
	ДанныеQRКода = SUI_ГенерацияШтрихкода.ДанныеQRКода(
		SUI_SimpleКлиентСервер.АдресAPKМобильногоПриложения(), 0, 130);
	QRСкачатьПриложение = ПоместитьВоВременноеХранилище(ДанныеQRКода, УникальныйИдентификатор);

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьОтборСпискаДокументовОбмена();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = "SUI_ПослеУдаленияДокументовОбмена" Или
		ИмяСобытия = "SUI_ПослеВыгрузкиДокументаОбмена" Или
		ИмяСобытия = "SUI_ПослеЗагрузкиДокументаОбмена" Тогда
		Элементы.СписокДокументовОбмена.Обновить();
		ОтборСпискаДокументовОбменаПоНаименованию_ЗагрузитьСписокВыбора();
		ОтобразитьИнформациюОТекущейСтроке(Элементы.СписокДокументовОбмена.ТекущиеДанные);
	ИначеЕсли ИмяСобытия = "SUI_ПринятЗапросАвторизации" Или
		ИмяСобытия = "SUI_ОтклоненЗапросАвторизации" Тогда
		Элементы.СписокЗапросыАвторизации.Обновить();
		Элементы.СписокМобильныхУстройств.Обновить();
		ОбновитьЗаголовокЗапросыАвторизации();
	ИначеЕсли ИмяСобытия = "SUI_СозданЗапросПолнойВыгрузки" Тогда
		Элементы.СписокМобильныхУстройств.Обновить();
	КонецЕсли;	

КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)

	// Удалить данные qr кода из временного хранилища
	Если ЭтоАдресВременногоХранилища(QRСкачатьПриложение) Тогда
		УдалитьИзВременногоХранилища(QRСкачатьПриложение);
	КонецЕсли;	

КонецПроцедуры

#КонецОбласти

