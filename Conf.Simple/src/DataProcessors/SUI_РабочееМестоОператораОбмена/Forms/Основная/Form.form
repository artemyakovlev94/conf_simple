ПОМЕСТИТЬ втСерии
ИЗ
	РегистрСведений.SUI_docs_tbl_series КАК SUI_docs_tbl_series
СГРУППИРОВАТЬ ПО
	SUI_docs_tbl_series.sid_doc

ИНДЕКСИРОВАТЬ ПО
	sid_doc
;

////////////////////////////////////////////////////////////////////////////////
 ВЫБРАТЬ
	NULL КАК Ссылка,
	SUI_docs.sid,
	SUI_docs.id_doc,
	SUI_docs.doc_type КАК Наименование,
	SUI_docs.doc_n КАК Номер,
	SUI_docs.doc_date КАК Дата,
	SUI_docs.Состояние,
	SUI_docs.МобильноеУстройство,
	SUI_docs.НастройкаДокумента,
	SUI_docs.ЭтоДокументАдресногоХранения,
	SUI_docs.ДатаОбновления,
	ЕСТЬNULL(втШтрихкодыУпаковок.КоличествоСтрок, 0) КАК КоличествоСтрокШтрихкодыУпаковок,
	ЕСТЬNULL(втСерии.КоличествоСтрок, 0) КАК КоличествоСтрокСерии,
	ЕСТЬNULL(втТовары.КоличествоСтрок, 0) КАК КоличествоСтрокТовары,
	ЕСТЬNULL(втТовары.qtty_plan, 0) КАК СуммаПлан,
	ЕСТЬNULL(втТовары.qtty, 0) КАК СуммаФакт,
	ВЫБОР
		КОГДА SUI_docs.Состояние = ЗНАЧЕНИЕ(Перечисление.SUI_СостоянияДокументовОбмена.Новый)
			ТОГДА 0
		КОГДА SUI_docs.Состояние = ЗНАЧЕНИЕ(Перечисление.SUI_СостоянияДокументовОбмена.КВыгрузке)
			ТОГДА 1
		КОГДА SUI_docs.Состояние = ЗНАЧЕНИЕ(Перечисление.SUI_СостоянияДокументовОбмена.Выгружен)
			ТОГДА 2
		КОГДА SUI_docs.Состояние = ЗНАЧЕНИЕ(Перечисление.SUI_СостоянияДокументовОбмена.Загружен)
			ТОГДА 3
		КОГДА SUI_docs.Состояние = ЗНАЧЕНИЕ(Перечисление.SUI_СостоянияДокументовОбмена.ВРаботе)
			ТОГДА 4
		КОГДА SUI_docs.Состояние = ЗНАЧЕНИЕ(Перечисление.SUI_СостоянияДокументовОбмена.Завершен)
			ТОГДА 5
		КОГДА SUI_docs.Состояние = ЗНАЧЕНИЕ(Перечисление.SUI_СостоянияДокументовОбмена.Отменен)
			ТОГДА 6
	КОНЕЦ КАК ИндексКартинки,
	ВЫБОР
		КОГДА ЕСТЬNULL(втТовары.qtty_plan, 0) > 0
		И ЕСТЬNULL(втТовары.qtty, 0) > 0
		И ЕСТЬNULL(втТовары.qtty_plan, 0) = ЕСТЬNULL(втТовары.qtty, 0)
			ТОГДА 0
		КОГДА ЕСТЬNULL(втТовары.qtty_plan, 0) >= 0
		И ЕСТЬNULL(втТовары.qtty, 0) >= 0
		И ЕСТЬNULL(втТовары.qtty_plan, 0) &lt;> ЕСТЬNULL(втТовары.qtty, 0)
			ТОГДА 1
		КОГДА ЕСТЬNULL(втТовары.qtty_plan, 0) &lt; 0
		ИЛИ ЕСТЬNULL(втТовары.qtty, 0) &lt; 0
			ТОГДА 2
	КОНЕЦ КАК ИндексКартинкиРасхождения
ИЗ
	РегистрСведений.SUI_docs КАК SUI_docs
		ЛЕВОЕ СОЕДИНЕНИЕ втТовары КАК втТовары
		ПО SUI_docs.sid = втТовары.sid_doc
		ЛЕВОЕ СОЕДИНЕНИЕ втШтрихкодыУпаковок КАК втШтрихкодыУпаковок
		ПО SUI_docs.sid = втШтрихкодыУпаковок.sid_doc
		ЛЕВОЕ СОЕДИНЕНИЕ втСерии КАК втСерии
		ПО SUI_docs.sid = втСерии.sid_doc</queryText>
      <mainTable>InformationRegister.SUI_docs</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
