<?xml version="1.0" encoding="UTF-8"?>
<form:Form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:form="http://g5.1c.ru/v8/dt/form">
  <commandBarLocation>None</commandBarLocation>
  <saveWindowSettings>true</saveWindowSettings>
  <autoTitle>true</autoTitle>
  <autoUrl>true</autoUrl>
  <group>Vertical</group>
  <autoFillCheck>true</autoFillCheck>
  <enabled>true</enabled>
  <showTitle>true</showTitle>
  <showCloseButton>true</showCloseButton>
  <attributes>
    <name>СписокДокументовОбмена</name>
    <title>
      <key>ru</key>
      <value>Список документов обмена</value>
    </title>
    <id>2</id>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	SUI_docs_tbl_goods.sid_doc КАК sid_doc,
	СУММА(SUI_docs_tbl_goods.qtty_plan) КАК qtty_plan,
	СУММА(SUI_docs_tbl_goods.qtty) КАК qtty,
	КОЛИЧЕСТВО(SUI_docs_tbl_goods.sid) КАК КоличествоСтрок
ПОМЕСТИТЬ втТовары
ИЗ
	РегистрСведений.SUI_docs_tbl_goods КАК SUI_docs_tbl_goods
СГРУППИРОВАТЬ ПО
	SUI_docs_tbl_goods.sid_doc

ИНДЕКСИРОВАТЬ ПО
	sid_doc
;

////////////////////////////////////////////////////////////////////////////////
 ВЫБРАТЬ
	SUI_docs_tbl_barcodes.sid_doc КАК sid_doc,
	КОЛИЧЕСТВО(SUI_docs_tbl_barcodes.sid) КАК КоличествоСтрок
ПОМЕСТИТЬ втШтрихкодыУпаковок
ИЗ
	РегистрСведений.SUI_docs_tbl_barcodes КАК SUI_docs_tbl_barcodes
СГРУППИРОВАТЬ ПО
	SUI_docs_tbl_barcodes.sid_doc

ИНДЕКСИРОВАТЬ ПО
	sid_doc
;

////////////////////////////////////////////////////////////////////////////////
 ВЫБРАТЬ
	SUI_docs_tbl_series.sid_doc КАК sid_doc,
	КОЛИЧЕСТВО(SUI_docs_tbl_series.sid) КАК КоличествоСтрок
ПОМЕСТИТЬ втСерии
ИЗ
	РегистрСведений.SUI_docs_tbl_series КАК SUI_docs_tbl_series
СГРУППИРОВАТЬ ПО
	SUI_docs_tbl_series.sid_doc

ИНДЕКСИРОВАТЬ ПО
	sid_doc
;

////////////////////////////////////////////////////////////////////////////////
 ВЫБРАТЬ
	NULL КАК Ссылка,
	SUI_docs.sid,
	SUI_docs.id_doc,
	SUI_docs.doc_type КАК Наименование,
	SUI_docs.doc_n КАК Номер,
	SUI_docs.doc_date КАК Дата,
	SUI_docs.Состояние,
	SUI_docs.МобильноеУстройство,
	SUI_docs.НастройкаДокумента,
	SUI_docs.ЭтоДокументАдресногоХранения,
	SUI_docs.ДатаОбновления,
	ЕСТЬNULL(втШтрихкодыУпаковок.КоличествоСтрок, 0) КАК КоличествоСтрокШтрихкодыУпаковок,
	ЕСТЬNULL(втСерии.КоличествоСтрок, 0) КАК КоличествоСтрокСерии,
	ЕСТЬNULL(втТовары.КоличествоСтрок, 0) КАК КоличествоСтрокТовары,
	ЕСТЬNULL(втТовары.qtty_plan, 0) КАК СуммаПлан,
	ЕСТЬNULL(втТовары.qtty, 0) КАК СуммаФакт,
	ВЫБОР
		КОГДА SUI_docs.Состояние = ЗНАЧЕНИЕ(Перечисление.SUI_СостоянияДокументовОбмена.Новый)
			ТОГДА 0
		КОГДА SUI_docs.Состояние = ЗНАЧЕНИЕ(Перечисление.SUI_СостоянияДокументовОбмена.КВыгрузке)
			ТОГДА 1
		КОГДА SUI_docs.Состояние = ЗНАЧЕНИЕ(Перечисление.SUI_СостоянияДокументовОбмена.Выгружен)
			ТОГДА 2
		КОГДА SUI_docs.Состояние = ЗНАЧЕНИЕ(Перечисление.SUI_СостоянияДокументовОбмена.Загружен)
			ТОГДА 3
		КОГДА SUI_docs.Состояние = ЗНАЧЕНИЕ(Перечисление.SUI_СостоянияДокументовОбмена.ВРаботе)
			ТОГДА 4
		КОГДА SUI_docs.Состояние = ЗНАЧЕНИЕ(Перечисление.SUI_СостоянияДокументовОбмена.Завершен)
			ТОГДА 5
		КОГДА SUI_docs.Состояние = ЗНАЧЕНИЕ(Перечисление.SUI_СостоянияДокументовОбмена.Отменен)
			ТОГДА 6
	КОНЕЦ КАК ИндексКартинки,
	ВЫБОР
		КОГДА ЕСТЬNULL(втТовары.qtty_plan, 0) > 0
		И ЕСТЬNULL(втТовары.qtty, 0) > 0
		И ЕСТЬNULL(втТовары.qtty_plan, 0) = ЕСТЬNULL(втТовары.qtty, 0)
			ТОГДА 0
		КОГДА ЕСТЬNULL(втТовары.qtty_plan, 0) >= 0
		И ЕСТЬNULL(втТовары.qtty, 0) >= 0
		И ЕСТЬNULL(втТовары.qtty_plan, 0) &lt;> ЕСТЬNULL(втТовары.qtty, 0)
			ТОГДА 1
		КОГДА ЕСТЬNULL(втТовары.qtty_plan, 0) &lt; 0
		ИЛИ ЕСТЬNULL(втТовары.qtty, 0) &lt; 0
			ТОГДА 2
	КОНЕЦ КАК ИндексКартинкиРасхождения
ИЗ
	РегистрСведений.SUI_docs КАК SUI_docs
		ЛЕВОЕ СОЕДИНЕНИЕ втТовары КАК втТовары
		ПО SUI_docs.sid = втТовары.sid_doc
		ЛЕВОЕ СОЕДИНЕНИЕ втШтрихкодыУпаковок КАК втШтрихкодыУпаковок
		ПО SUI_docs.sid = втШтрихкодыУпаковок.sid_doc
		ЛЕВОЕ СОЕДИНЕНИЕ втСерии КАК втСерии
		ПО SUI_docs.sid = втСерии.sid_doc</queryText>
      <mainTable>InformationRegister.SUI_docs</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
  <attributes>
    <name>СписокМобильныхУстройств</name>
    <title>
      <key>ru</key>
      <value>Мобильные устройства</value>
    </title>
    <id>7</id>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	SUI_МобильныеУстройства.Ссылка КАК Ссылка,
	SUI_МобильныеУстройства.ПометкаУдаления КАК ПометкаУдаления,
	SUI_МобильныеУстройства.Код КАК Код,
	SUI_МобильныеУстройства.Наименование КАК Наименование,
	SUI_МобильныеУстройства.IPАдрес КАК IPАдрес,
	SUI_МобильныеУстройства.Порт КАК Порт,
	SUI_МобильныеУстройства.ЭтотУзел,
	ЕСТЬNULL(SUI_СеансыМобильныхУстройств.ДатаСеанса, ДАТАВРЕМЯ(1, 1, 1)) КАК ПоследнийСеанс,
	ЕСТЬNULL(SUI_СеансыМобильныхУстройств.ВерсияПриложения, &quot;0.0.0.0&quot;) КАК ВерсияПриложения,
	ЕСТЬNULL(SUI_СостоянияМобильныхУстройств.Состояние,
		ЗНАЧЕНИЕ(Перечисление.SUI_СостоянияМобильныхУстройств.ПустаяСсылка)) КАК ТекущееСостояние,
	SUI_СостоянияМобильныхУстройств.ДатаОбновления КАК ДатаСостояния,
	ВЫБОР
		КОГДА SUI_СеансыМобильныхУстройств.ДатаСеанса ЕСТЬ NULL
		ИЛИ SUI_СеансыМобильныхУстройств.ДатаСеанса &lt; &amp;ДатаОтсутствияСеанса
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК ИндексКартинки
ИЗ
	ПланОбмена.SUI_МобильныеУстройства КАК SUI_МобильныеУстройства
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.SUI_СеансыМобильныхУстройств КАК SUI_СеансыМобильныхУстройств
		ПО SUI_МобильныеУстройства.Ссылка = SUI_СеансыМобильныхУстройств.МобильноеУстройство
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.SUI_СостоянияМобильныхУстройств КАК SUI_СостоянияМобильныхУстройств
		ПО SUI_МобильныеУстройства.Ссылка = SUI_СостоянияМобильныхУстройств.МобильноеУстройство</queryText>
      <mainTable>ExchangePlan.SUI_МобильныеУстройства</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
  <attributes>
    <name>СписокЗапросыАвторизации</name>
    <title>
      <key>ru</key>
      <value>Список запросы авторизации</value>
    </title>
    <id>8</id>
    <functionalOptions>FunctionalOption.SUI_ИспользоватьЗапросыАвторизацииМУ</functionalOptions>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <mainTable>InformationRegister.SUI_ЗапросыАвторизацииМобильныхУстройств</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
</form:Form>
