    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	SUI_docs_tbl_goods.sid_doc КАК sid_doc,
	СУММА(SUI_docs_tbl_goods.qtty_plan) КАК qtty_plan,
	СУММА(SUI_docs_tbl_goods.qtty) КАК qtty,
	КОЛИЧЕСТВО(SUI_docs_tbl_goods.sid) КАК КоличествоСтрок
ПОМЕСТИТЬ втТовары
ИЗ
	РегистрСведений.SUI_docs_tbl_goods КАК SUI_docs_tbl_goods
СГРУППИРОВАТЬ ПО
	SUI_docs_tbl_goods.sid_doc

ИНДЕКСИРОВАТЬ ПО
	sid_doc
;

