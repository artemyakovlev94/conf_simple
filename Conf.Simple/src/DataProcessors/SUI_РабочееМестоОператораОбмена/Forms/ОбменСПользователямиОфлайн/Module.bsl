&НаСервереБезКонтекста
Функция ПолучитьДокументыГрупповогоПересчета(МобильноеУстройство)

	Запрос = Новый Запрос;
	
	Параметр = Новый СписокЗначений;
	Параметр.Добавить(Перечисления.SUI_СостоянияДокументовОбмена.Завершен);
	Параметр.Добавить(Перечисления.SUI_СостоянияДокументовОбмена.Отменен);
	Параметр.Добавить(Перечисления.SUI_СостоянияДокументовОбмена.Новый);
	Запрос.УстановитьПараметр("Состояние", Параметр);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	SUI_docs.id_doc КАК ИдентификаторДокумента
	|ИЗ
	|	РегистрСведений.SUI_docs КАК SUI_docs
	|ГДЕ
	|	SUI_docs.НастройкаДокумента.ГрупповоеСканирование
	|	И НЕ SUI_docs.Состояние В (&Состояние)";
	Результат = Запрос.Выполнить();
	
	// Выборка
	Выборка = Результат.Выбрать();
	
	МассивВсехДокументов = Новый Массив;
	ДанныеДляВозврата = "";
	
	Пока Выборка.Следующий() Цикл
		МассивПоДокументу = SUI_ДокументыОбмена.ПолучитьДанныеПересчетаСтрок(МобильноеУстройство, Выборка.ИдентификаторДокумента);  
		Для Каждого ЭлементМассива Из МассивПоДокументу Цикл
			МассивВсехДокументов.Добавить(ЭлементМассива); 
		КонецЦикла;
	КонецЦикла;
	
	Если МассивВсехДокументов.Количество() Тогда
		ДанныеДляВозврата = SUI_ОбщегоНазначенияКлиентСервер.ДанныеВСтрокуJSON(МассивВсехДокументов, , "ПреобразованиеДанныхJSON", SUI_ОбщегоНазначения);
		ДанныеДляВозврата = "{""data"":" + ДанныеДляВозврата + Символы.ПС + "}"; 	
	КонецЕсли;
	
	Возврат ДанныеДляВозврата;
	
КонецФункции

#КонецОбласти

#Область ОбменЗагрузка

&НаКлиенте
Функция ЗагрузитьДанные(МассивПользователейКОбмену, ГрупповойПересчет)
	
	Если Не МассивПользователейКОбмену.Количество() Тогда
		Возврат Ложь;	
	КонецЕсли;	
	
	Индикатор = ПолучитьИндикаторПроцесса(МассивПользователейКОбмену.Количество(), НСтр("ru = 'Загрузка данных'"));
	ИндексОбходаДляИндикатора = 0;
	
	Для каждого МобильноеУстройство Из МассивПользователейКОбмену Цикл
		
		ОбработатьИндикатор(Индикатор, СтрШаблон(НСтр("ru = 'Загрузка данных пользователя %1'"), МобильноеУстройство), ИндексОбходаДляИндикатора);
		ИндексОбходаДляИндикатора = ИндексОбходаДляИндикатора + 1;	 
		
		// Проверка связи
		
		ПользовательДоступен = ТестСвязи(МобильноеУстройство);
		
		Если Не ПользовательДоступен Тогда 
			ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон(НСтр("ru = 'Пользователь %1 недоступен, проверьте подключение пользователя'"), МобильноеУстройство));
			Продолжить;
		КонецЕсли; 
		
		// Получение данных
		
		//@skip-check query-in-loop
		ДанныеСМУ = ПолучитьПакетДанныхНаМУ(МобильноеУстройство, ГрупповойПересчет);
		
		Если Не ГрупповойПересчет Тогда
			// Документы
			Если Не ДанныеСМУ.Документы.ЕстьСвязь Тогда 
				ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон(НСтр("ru = 'Не удалость загрузить данные по пользователю %1, проверьте подключение пользователя'"), МобильноеУстройство));			
				Продолжить;			
			КонецЕсли; 
			
			Если ДанныеСМУ.Документы.Данные = Неопределено Тогда 
				ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон(НСтр("ru = 'Нет данных для загрузки по пользователю %1'"), МобильноеУстройство));			
				Продолжить;			
			КонецЕсли;
			
			ДанныеЗагружены = Ложь;
			Если ДанныеСМУ.Документы.Данные <> "[]" Тогда 
				РезультатЗагрузкиДокументы = ЗаписатьДанныеДокументовИзМУ(ДанныеСМУ.Документы.Данные, МобильноеУстройство);
				Если РезультатЗагрузкиДокументы.quantity_uploaded <> 0 Тогда 
					ДанныеЗагружены = Истина;			
				КонецЕсли;
			КонецЕсли;
			
			// Штрихкоды 
			Если СоздаватьШтрихкодыИзТСД Тогда
				РезультатЗагрузкиШтрихкоды = ЗаписатьДанныеШтрихкодовИзМУ(ДанныеСМУ.Штрихкоды.Данные, МобильноеУстройство);
				
				Если РезультатЗагрузкиШтрихкоды.quantity_uploaded <> 0 Тогда 
					ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон(НСтр("ru = 'Штрихкоды загружены по пользователю %1'"), МобильноеУстройство));			
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
		Иначе
			
			ДанныеЗагружены = Ложь;
			Если ДанныеСМУ.ДокументыГрупповаяРабота.Данные <> "[]" И ДанныеСМУ.ДокументыГрупповаяРабота.Данные <> Неопределено Тогда
				ДанныеЗагружены = ЗаписатьДанныеДокументовИзМУГрупповая(ДанныеСМУ.ДокументыГрупповаяРабота.Данные, МобильноеУстройство);
			КонецЕсли;
			
		КонецЕсли;
			
		Если ДанныеЗагружены Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон(НСтр("ru = 'Данные загружены по пользователю %1'"), МобильноеУстройство));	
		Иначе 
			ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон(НСтр("ru = 'Нет данных для загрузки по пользователю %1'"), МобильноеУстройство));		
		КонецЕсли;	
		
	КонецЦикла;
	
КонецФункции // ЗагрузитьДанные()

