&НаКлиенте
Функция ПолучитьПакетДанныхНаМУ(МобильноеУстройство, ГрупповойПересчет = Ложь)
	
	СтруктураВозврата = Новый Структура;
	Если ГрупповойПересчет Тогда
		СтруктураВозврата.Вставить("ДокументыГрупповаяРабота", ОтправитьSQLЗапросМобильноеУстройство("SyncCommand", "_", "&listener=document_lines", МобильноеУстройство, ,Истина)); 			
	Иначе
		СтруктураВозврата.Вставить("Документы", ОтправитьSQLЗапросМобильноеУстройство("SyncCommand", "_", "&listener=get_data", МобильноеУстройство, ,Истина)); 	
		Если СоздаватьШтрихкодыИзТСД Тогда
			СтруктураВозврата.Вставить("Штрихкоды", ОтправитьSQLЗапросМобильноеУстройство("SyncCommand", "_", "&listener=barcodes", МобильноеУстройство, ,Истина)); 
		КонецЕсли;  
	КонецЕсли;

	Возврат СтруктураВозврата;
	
КонецФункции // ОтправитьПакетДанныхНаМУ()

