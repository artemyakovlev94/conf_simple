&НаКлиенте
Процедура ОтменитьВыборВсехПользователей(Команда)
	Для каждого Пользователь Из МобильныеУстройства Цикл	
		Пользователь.Выгружать = Ложь;		
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьВсехПользователей(Команда)
	Для каждого Пользователь Из МобильныеУстройства Цикл	
		Пользователь.Выгружать = Истина;		
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписокПользователей(Команда)
	ОбновлениеПользователей();    
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПолнуюВыгрузку(Команда)
	
	ОчиститьСообщения();
	
	Если Элементы.МобильныеУстройства.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Элементы.МобильныеУстройства.ТекущиеДанные.МобильноеУстройство = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	SUI_МобильныеУстройстваВызовСервера.ВыполнитьПолнуюВыгрузку(Элементы.МобильныеУстройства.ТекущиеДанные.МобильноеУстройство);
	
	ПодготовитьСообщенияОбмена();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьСообщение(Команда)
	
	ОчиститьСообщения();
	
	Если Элементы.МобильныеУстройства.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Элементы.МобильныеУстройства.ТекущиеДанные.МобильноеУстройство = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	ПараметрыВладельца = Новый Структура();
	ПараметрыВладельца.Вставить("Источник", 			ЭтотОбъект);
	ПараметрыВладельца.Вставить("Уникальность", 		УникальныйИдентификатор);
	ПараметрыВладельца.Вставить("Окно", 				Окно);
	ПараметрыВладельца.Вставить("НавигационнаяСсылка", 	НавигационнаяСсылка);
	
	SUI_СообщенияМобильныхУстройствКлиент.ОтправитьСообщение(
		Элементы.МобильныеУстройства.ТекущиеДанные.МобильноеУстройство, ПараметрыВладельца);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПодготовитьСообщенияОбмена()
	
	ПараметрыЗапуска = SUI_РегламентныеЗаданияКлиентСервер.ПараметрыОкнаЗапускаРегламентногоЗадания(
		SUI_СообщенияОбменаДаннымиКлиентСервер.КлючиРегламентныхЗаданий().ВыполнитьОбработкуСообщенийОбменаДанными);
	ПараметрыЗапуска.ОжидатьЗавершения = Истина;
	
	Оповещение = Новый ОписаниеОповещения("ПодготовитьСообщенияОбменаЗавершение", ЭтотОбъект);
	
	SUI_РегламентныеЗаданияКлиент.ЗапуститьРегламентноеЗаданиеВручную(ПараметрыЗапуска, ЭтотОбъект, Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодготовитьСообщенияОбменаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено И Результат.ЗаданиеВыполнено Тогда
		ОбновитьПользователей();
	КонецЕсли;
	
КонецПроцедуры

#Область Обмен

#Область ОбменОбщее

&НаСервереБезКонтекста
Функция СтрокаJSON(Знач Данные)
	
	Если Не SUI_ОбщегоНазначенияКлиентСервер.ТипыДоступенКПреобразованиюВJSON(ТипЗнч(Данные)) Тогда
		Возврат "";
	КонецЕсли;
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку(Новый ПараметрыЗаписиJSON(, Символы.Таб));
	ЗаписатьJSON(ЗаписьJSON, Данные, , "ПреобразованиеДанныхJSON", SUI_ОбщегоНазначения);
	
	Возврат ЗаписьJSON.Закрыть();
	
КонецФункции

&НаКлиенте
Процедура ПроверкаСвязиСПользователямиКлиент() 
	
	Индикатор = ПолучитьИндикаторПроцесса(МобильныеУстройства.Количество(), НСтр("ru = 'Загрузка пользователей'"));
	ИндексОбходаДляИндикатора = 0;	
	Для Каждого Пользователь Из МобильныеУстройства Цикл 
		 
		Если Пользователь.IPАдрес <> "" Тогда  
			Пользователь.Доступен = ТестСвязи( Пользователь.МобильноеУстройство);
			Пользователь.Выгружать = (Пользователь.Доступен = Истина И Пользователь.Сообщений > 0);
		КонецЕсли;
		
		ОбработатьИндикатор(Индикатор, СтрШаблон(НСтр("ru = 'Проверка связи с пользователем %1'"), Пользователь.МобильноеУстройство), ИндексОбходаДляИндикатора);
		ИндексОбходаДляИндикатора = ИндексОбходаДляИндикатора + 1;
		
	КонецЦикла;
	
КонецПроцедуры // ПроверкаСвязиСПользователямиОбработчикОжидания()  

&НаСервере
Процедура ОбновитьПользователей(ПерезаполнитьТаблицу = Ложь)
	
	Запрос = Новый Запрос;
	
	Если ПерезаполнитьТаблицу Тогда 
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	SUI_МобильныеУстройства.Ссылка КАК Ссылка,
		|	SUI_МобильныеУстройства.Представление КАК Представление,
		|	ЛОЖЬ КАК Доступен,
		|	ВЫБОР
		|		КОГДА SUI_МобильныеУстройства.IPАдрес ЕСТЬ NULL
		|				ИЛИ SUI_МобильныеУстройства.IPАдрес = ""0.0.0.0""
		|			ТОГДА """"
		|		ИНАЧЕ SUI_МобильныеУстройства.IPАдрес
		|	КОНЕЦ КАК IP_адрес,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ SUI_СообщенияОбменаДанными.ID) + КОЛИЧЕСТВО(РАЗЛИЧНЫЕ SUI_КешПакетовДанных.ИдентификаторПакета) КАК Сообщений
		|ИЗ
		|	ПланОбмена.SUI_МобильныеУстройства КАК SUI_МобильныеУстройства
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.SUI_СообщенияОбменаДанными КАК SUI_СообщенияОбменаДанными
		|		ПО (SUI_СообщенияОбменаДанными.Получатель = SUI_МобильныеУстройства.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.SUI_КешПакетовДанных КАК SUI_КешПакетовДанных
		|		ПО (SUI_КешПакетовДанных.МобильноеУстройство = SUI_МобильныеУстройства.Ссылка)
		|ГДЕ
		|	НЕ SUI_МобильныеУстройства.ПометкаУдаления
		|	И SUI_МобильныеУстройства.Наименование <> """"
		|
		|СГРУППИРОВАТЬ ПО
		|	ВЫБОР
		|		КОГДА SUI_МобильныеУстройства.IPАдрес ЕСТЬ NULL
		|				ИЛИ SUI_МобильныеУстройства.IPАдрес = ""0.0.0.0""
		|			ТОГДА """"
		|		ИНАЧЕ SUI_МобильныеУстройства.IPАдрес
		|	КОНЕЦ,
		|	SUI_МобильныеУстройства.Ссылка,
		|	SUI_МобильныеУстройства.Представление";
		
	Иначе
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	SUI_МобильныеУстройства.МобильноеУстройство КАК МобильноеУстройство,
		|	SUI_МобильныеУстройства.Выгружать КАК Выгружать,
		|	SUI_МобильныеУстройства.Доступен КАК Доступен,
		|	SUI_МобильныеУстройства.IPАдрес КАК IPАдрес
		|ПОМЕСТИТЬ втТЧМК
		|ИЗ
		|	&ТаблицаВходная КАК SUI_МобильныеУстройства
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	SUI_МобильныеУстройства.Ссылка КАК Ссылка,
		|	SUI_МобильныеУстройства.Представление КАК Представление,
		|	ВЫБОР
		|		КОГДА SUI_МобильныеУстройства.IPАдрес ЕСТЬ NULL
		|				ИЛИ SUI_МобильныеУстройства.IPАдрес = ""0.0.0.0""
		|			ТОГДА """"
		|		ИНАЧЕ SUI_МобильныеУстройства.IPАдрес
		|	КОНЕЦ КАК IP_адрес,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ SUI_СообщенияОбменаДанными.ID) + КОЛИЧЕСТВО(РАЗЛИЧНЫЕ SUI_КешПакетовДанных.ИдентификаторПакета) КАК Сообщений
		|ПОМЕСТИТЬ втТЧАктуальная
		|ИЗ
		|	ПланОбмена.SUI_МобильныеУстройства КАК SUI_МобильныеУстройства
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.SUI_СообщенияОбменаДанными КАК SUI_СообщенияОбменаДанными
		|		ПО (SUI_СообщенияОбменаДанными.Получатель = SUI_МобильныеУстройства.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.SUI_КешПакетовДанных КАК SUI_КешПакетовДанных
		|		ПО (SUI_КешПакетовДанных.МобильноеУстройство = SUI_МобильныеУстройства.Ссылка)
		|ГДЕ
		|	НЕ SUI_МобильныеУстройства.ПометкаУдаления
		|	И SUI_МобильныеУстройства.Наименование <> """"
		|
		|СГРУППИРОВАТЬ ПО
		|	ВЫБОР
		|		КОГДА SUI_МобильныеУстройства.IPАдрес ЕСТЬ NULL
		|				ИЛИ SUI_МобильныеУстройства.IPАдрес = ""0.0.0.0""
		|			ТОГДА """"
		|		ИНАЧЕ SUI_МобильныеУстройства.IPАдрес
		|	КОНЕЦ,
		|	SUI_МобильныеУстройства.Ссылка,
		|	SUI_МобильныеУстройства.Представление
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втТЧМК.МобильноеУстройство КАК Ссылка,
		|	втТЧМК.Выгружать КАК Выгружать,
		|	втТЧМК.Доступен КАК Доступен,
		|	втТЧМК.IPАдрес КАК IP_адрес,
		|	втТЧАктуальная.Сообщений КАК Сообщений
		|ИЗ
		|	втТЧМК КАК втТЧМК
		|		ПОЛНОЕ СОЕДИНЕНИЕ втТЧАктуальная КАК втТЧАктуальная
		|		ПО втТЧМК.МобильноеУстройство = втТЧАктуальная.Ссылка";
		
		Запрос.Параметры.Вставить("ТаблицаВходная",МобильныеУстройства.Выгрузить());
		
	КонецЕсли;
	
	МобильныеУстройства.Очистить(); 
		
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		НоваяСтрока = МобильныеУстройства.Добавить();
		НоваяСтрока.МобильноеУстройство = ВыборкаДетальныеЗаписи.Ссылка;
		НоваяСтрока.Выгружать = ВыборкаДетальныеЗаписи.Сообщений > 0;
		НоваяСтрока.Доступен = ВыборкаДетальныеЗаписи.Доступен;
		НоваяСтрока.IPАдрес = ВыборкаДетальныеЗаписи.IP_адрес; 
		НоваяСтрока.Сообщений = ВыборкаДетальныеЗаписи.Сообщений;
	КонецЦикла;
	
КонецПроцедуры // ОбновитьПользователей()

&НаКлиенте
Процедура ОбновлениеПользователей()

	ОбновитьПользователей(Истина);    
	Если ПроверятьСвязьСПользователямиПриОткрытииРабочегоМеста Тогда
		ПроверкаСвязиСПользователямиКлиент();                           
	КонецЕсли;

КонецПроцедуры // ОбновлениеПользователей()

&НаСервереБезКонтекста
Функция ПолучитьДанныеПользователя(Знач МобильноеУстройство)
	
	СтруктураДанныхПользователя = Новый Структура;
	СтруктураДанныхПользователя.Вставить("МобильноеУстройство", МобильноеУстройство);
	СтруктураДанныхПользователя.Вставить("IP", "");
	СтруктураДанныхПользователя.Вставить("ОтключеноЛогированиеПользователя", Ложь);
	СтруктураДанныхПользователя.Вставить("Код", "");
	СтруктураДанныхПользователя.Вставить("ЛогированиеАктивно", Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВЫБОР
	|		КОГДА SUI_МобильныеУстройства.IPАдрес ЕСТЬ NULL
	|				ИЛИ SUI_МобильныеУстройства.IPАдрес = ""0.0.0.0""
	|			ТОГДА """"
	|		ИНАЧЕ SUI_МобильныеУстройства.IPАдрес
	|	КОНЕЦ КАК IPАдрес,
	|	ЕСТЬNULL(SUI_МобильныеУстройства.Порт, 0) КАК Порт,
	|	SUI_МобильныеУстройства.ОтключитьЛогирование КАК ОтключеноЛогированиеПользователя,
	|	SUI_МобильныеУстройства.Код КАК Код,
	|	SUI_ЛогированиеHTTPЗапросов.Значение КАК ЛогированиеАктивно
	|ИЗ
	|	ПланОбмена.SUI_МобильныеУстройства КАК SUI_МобильныеУстройства,
	|	Константа.SUI_ЛогированиеHTTPЗапросов КАК SUI_ЛогированиеHTTPЗапросов
	|ГДЕ
	|	SUI_МобильныеУстройства.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", МобильноеУстройство);
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = Запрос.Выполнить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Если Не РезультатЗапроса.Пустой() Тогда
		
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		
		Если Выборка.Порт = 0 Тогда
			СтруктураДанныхПользователя.IP = Выборка.IPАдрес;
		ИначеЕсли Не ПустаяСтрока(Выборка.IPАдрес) Тогда
			СтруктураДанныхПользователя.IP = СтрШаблон("%1:%2", Выборка.IPАдрес, Формат(Выборка.Порт,"ЧЦ=5; ЧДЦ=0; ЧГ="));
		Иначе
			СтруктураДанныхПользователя.IP = "";
		КонецЕсли;
		
		СтруктураДанныхПользователя.ОтключеноЛогированиеПользователя = Выборка.ОтключеноЛогированиеПользователя;
		СтруктураДанныхПользователя.Код = Выборка.Код;
		СтруктураДанныхПользователя.ЛогированиеАктивно = Выборка.ЛогированиеАктивно;
	
	КонецЕсли;
	
	Возврат СтруктураДанныхПользователя;
	
КонецФункции

&НаКлиенте
Функция ТестСвязи(МобильноеУстройство)
	
	ОтветСервера= ОтправитьSQLЗапросМобильноеУстройство("SyncCommand", "_", "&listener=communication_test", МобильноеУстройство, Истина);   //+Объект.Параметры  	
	Возврат ОтветСервера.ЕстьСвязь;
	
КонецФункции

//@skip-check method-optional-parameter-before-required
&НаКлиенте
Функция ОтправитьSQLЗапросМобильноеУстройство(Команда, SQLЗапрос, Параметры, МобильноеУстройство, ТестСвязи = Ложь, ЗагрузкаДанных = Ложь, ЗавершениеПередачиДанных = Ложь)  
	
	РезультатЗапроса = Новый Структура;
	РезультатЗапроса.Вставить("ЕстьСвязь", Ложь);
	РезультатЗапроса.Вставить("ДанныеОтправлены", Ложь);
	РезультатЗапроса.Вставить("Данные", Неопределено);
	
	Если SQLЗапрос = "" Тогда 
		Возврат ""; 
	ИначеЕсли  SQLЗапрос = "_" Тогда 
		SQLЗапрос = ""; 
	КонецЕсли;   
	
	Если ТестСвязи Тогда 
		ВремяОжиданияОтвета = ?(ТаймаутПроверкиСвязи > 0, ТаймаутПроверкиСвязи, 5);
	Иначе 
		ВремяОжиданияОтвета = ?(ТаймаутВыгрузкиДанных > 0, ТаймаутВыгрузкиДанных, 20);
	КонецЕсли;   
	
	СтруктураДанныхПользователя = ПолучитьДанныеПользователя(МобильноеУстройство);
	
	Соединение = Новый HTTPСоединение(СтруктураДанныхПользователя.IP,,,,,ВремяОжиданияОтвета);
	
	Заголовки = Новый Соответствие();
	
	Заголовки.Вставить("Content-Type","application/json; charset=utf-8");
	
	Запрос = Новый HTTPЗапрос("/?mode="+Команда+Параметры, Заголовки);
	
	Если Тип("ДвоичныеДанные") = ТипЗнч(SQLЗапрос) Тогда			
		Запрос.УстановитьТелоИзДвоичныхДанных(SQLЗапрос);
	Иначе			
		Запрос.УстановитьТелоИзСтроки(SQLЗапрос, КодировкаТекста.UTF8); 			
	КонецЕсли;
	
	Попытка 		
		
		ОтветСервера = Соединение.ОтправитьДляОбработки(Запрос);		
		Ответ = ОбщегоНазначенияКлиентСервер.УдалитьНедопустимыеСимволыXML(ОтветСервера.ПолучитьТелоКакСтроку());
		
		Если Не ТестСвязи И Не ЗавершениеПередачиДанных Тогда
			
			Если СтруктураДанныхПользователя.ЛогированиеАктивно И Не СтруктураДанныхПользователя.ОтключеноЛогированиеПользователя Тогда
				
				ПараметрыДобавленияЗаписиЛогирования = SUI_ЛогированиеHTTPЗапросовКлиентСервер
					.ПараметрыДобавленияЗаписиЛогирования(Запрос, ОтветСервера);
					
				ПараметрыДобавленияЗаписиЛогирования.HTTPСоединение = Соединение;
				ПараметрыДобавленияЗаписиЛогирования.ИдентификаторУстройства = СтруктураДанныхПользователя.Код;
				
				Если ЗагрузкаДанных Тогда
					ПараметрыДобавленияЗаписиЛогирования.Метод = ПредопределенноеЗначение("Перечисление.SUI_HTTPМетоды.GET");
				Иначе
					ПараметрыДобавленияЗаписиЛогирования.Метод = ПредопределенноеЗначение("Перечисление.SUI_HTTPМетоды.POST");
				КонецЕсли;
				
				SUI_ЛогированиеHTTPЗапросовКлиентСервер.ДобавитьЗаписьЛогирования(ПараметрыДобавленияЗаписиЛогирования);
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если ТестСвязи Или ЗагрузкаДанных Тогда 
			РезультатЗапроса.ЕстьСвязь = Истина;
			РезультатЗапроса.Данные = Ответ;			
		Иначе   
			Если ОтветСервера.КодСостояния <= 200 Тогда
				РезультатЗапроса.ЕстьСвязь = Истина;
				РезультатЗапроса.ДанныеОтправлены = Истина;  
			Иначе
				РезультатЗапроса.ЕстьСвязь = Истина;
				РезультатЗапроса.ДанныеОтправлены = Ложь;  
			КонецЕсли;
		КонецЕсли;
		
	Исключение 
		
		ЗаписьВЖурналРегистрации(ИмяСобытия("Выгрузка"), ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), Истина);		
		
	КонецПопытки;	 
	
	Возврат РезультатЗапроса;
	
КонецФункции

#КонецОбласти

#Область ОбменВыгрузка

&НаКлиенте
Функция ВыгрузитьДанные(МассивПользователейКОбмену, ПолучитьДанныеНСИ = Истина, ПолучитьДанныеДокументов = Истина)
	
	Если Не МассивПользователейКОбмену.Количество() Тогда
		Возврат Неопределено;	
	КонецЕсли;

	Индикатор = ПолучитьИндикаторПроцесса(МассивПользователейКОбмену.Количество(), НСтр("ru = 'Выгрузка данных'"));
	ИндексОбходаДляИндикатора = 0;
	
	Для каждого МобильноеУстройство Из МассивПользователейКОбмену Цикл
		
		ОбработатьИндикатор(Индикатор, СтрШаблон(НСтр("ru = 'Выгрузка на пользователя%1'"), МобильноеУстройство), ИндексОбходаДляИндикатора);
		ИндексОбходаДляИндикатора = ИндексОбходаДляИндикатора + 1;
		
		// Проверка связи
		
		ПользовательДоступен = ТестСвязи(МобильноеУстройство);
		
		Если Не ПользовательДоступен Тогда 
			ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон(НСтр("ru = 'Пользователь %1 недоступен, проверьте подключение пользователя'"), МобильноеУстройство));		
			Продолжить;
		КонецЕсли;
		
		// Если в регистре состояния мобильных устройств полная выгрузка не выполнена тогда очищается кеш
		//@skip-check query-in-loop
		ПроверитьПолнуюВыгрузкуПользователя(МобильноеУстройство);
		ЕстьПакетыИзКеша = Ложь;
		ПакетыИзКешаОтправлены = Ложь;
		
		// Отправка из кеша пакетов
		Пока Истина Цикл
			Данные = ПолучитьПакетыИзКеша(МобильноеУстройство);
			Если Не Данные.ЕстьПакеты Тогда
				Прервать;
			КонецЕсли; 
			ЕстьПакетыИзКеша = Истина;
			ПакетКОтправке = Данные.ДанныеПакета;  
			
			//@skip-check query-in-loop
			ПакетОтправлен = ОтправитьПакетДанныхНаМУ(МобильноеУстройство,ПакетКОтправке);
			
			Если Не ПакетОтправлен.ДанныеОтправлены Тогда
				СохранитьПакетДанныхВКеш(МобильноеУстройство, ПакетКОтправке, Ложь);
				Прервать; 
			Иначе
				ПакетыИзКешаОтправлены = Истина;
			КонецЕсли;
			
			Если Данные.ОстатокПакетов = 0 Тогда
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
		Если ЕстьПакетыИзКеша И Не ПакетыИзКешаОтправлены Тогда		
			ПоказатьПредупреждение(,СтрШаблон(НСтр("ru = 'Не удалось отправить данные на %1'"), МобильноеУстройство));
			Возврат Неопределено;
		КонецЕсли;
		
		// Получаю новые пакеты (если нет ошибки при отправке кеша пакетов)
		КоличествоИтераций = 5; 
		ДанныеОтправлены = Ложь;
		СчетчикУспешныхОтправокДанных = 0;
		Пока КоличествоИтераций >= 0 Цикл
			
			Если КоличествоИтераций = 0 Тогда				
				Прервать;
			КонецЕсли;
			
			Результат =  ПолучитьДанныеОжидание(МобильноеУстройство, ПолучитьДанныеНСИ, ПолучитьДанныеДокументов).Данные;
			ТипРезультата = ТипЗнч(Результат);
			
			Если ТипРезультата = Тип("Структура") И Результат.format = "is_ok" Тогда 
				ДанныеОтправлены = Истина;
				ЗапуститьОбработчикОжидания();   
				КоличествоИтераций = КоличествоИтераций - 1;
			ИначеЕсли ТипРезультата = Тип("Структура") И Результат.format = "no_data" Тогда 
				Прервать;   				
			ИначеЕсли (ТипРезультата = Тип("Структура") И (Результат.format = "is_data" Или Результат.format = "is_cmd")) 
				Или ТипРезультата = Тип("ДвоичныеДанные") Или ТипРезультата = Тип("Строка") Тогда
				
				Если ТипРезультата <> Тип("ДвоичныеДанные") И ТипРезультата <> Тип("Строка") Тогда   
					Результат = СтрокаJSON(Результат.data);						
				КонецЕсли;
								
				ДанныеОтправлены = Истина;
				// 1 Попытка отправить
				//@skip-check query-in-loop
				ДанныеОтправлены = ОтправитьПакетДанныхНаМУ(МобильноеУстройство, Результат).ДанныеОтправлены;
				// 2 Если не удалось отправить тогда запись в кеш пакетов и прервать цикл с выходом ошибки 
				Если Не ДанныеОтправлены Тогда
					СохранитьПакетДанныхВКеш(МобильноеУстройство, Результат, Истина);
					ДанныеОтправлены = Ложь;
					Прервать;
				Иначе
					//@skip-check query-in-loop
					ОтправитьПакетДанныхНаМУЗавершение(МобильноеУстройство);
					СчетчикУспешныхОтправокДанных = СчетчикУспешныхОтправокДанных + 1;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла; 
			
		Если ДанныеОтправлены Или ПакетыИзКешаОтправлены Тогда
			
			//@skip-check query-in-loop
			ОтправитьПакетДанныхНаМУЗавершение(МобильноеУстройство);	
			
		КонецЕсли;
		
		Если Не ДанныеОтправлены И КоличествоИтераций И СчетчикУспешныхОтправокДанных = 0 И Не ПакетыИзКешаОтправлены Тогда 
			ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон(НСтр("ru = 'Нет данных для обмена по пользователю %1'"), МобильноеУстройство));
		ИначеЕсли Не ДанныеОтправлены И КоличествоИтераций И СчетчикУспешныхОтправокДанных > 0 И Не ПакетыИзКешаОтправлены Тогда 
			ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон(НСтр("ru = 'Во время обмена по пользователю %1 произошла ошибка. Попробуйте повторить обмен'"), МобильноеУстройство));
		ИначеЕсли Не ДанныеОтправлены И КоличествоИтераций = 0 И Не ПакетыИзКешаОтправлены Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон(НСтр("ru = 'Не удалось отправить данные на %1'"), МобильноеУстройство));
		Иначе
			ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон(НСтр("ru = 'Данные выгружены на %1'"), МобильноеУстройство));
		КонецЕсли;
		
	КонецЦикла;
	
	ОбновитьПользователей();
	
КонецФункции // ПолучитьДанные()

&НаКлиенте
Функция ВыгрузитьДанныеГрупповогоПересчета(МассивПользователейКОбмену)
	
	Если Не МассивПользователейКОбмену.Количество() Тогда
		Возврат Неопределено;	
	КонецЕсли;

	Индикатор = ПолучитьИндикаторПроцесса(МассивПользователейКОбмену.Количество(), НСтр("ru = 'Выгрузка данных'"));
	ИндексОбходаДляИндикатора = 0;
	
	Для каждого МобильноеУстройство Из МассивПользователейКОбмену Цикл
		
		ОбработатьИндикатор(Индикатор, СтрШаблон(НСтр("ru = 'Выгрузка на пользователя%1'"), МобильноеУстройство), ИндексОбходаДляИндикатора);
		ИндексОбходаДляИндикатора = ИндексОбходаДляИндикатора + 1;
		
		// Проверка связи
		
		ПользовательДоступен = ТестСвязи(МобильноеУстройство);
		
		Если Не ПользовательДоступен Тогда 
			ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон(НСтр("ru = 'Пользователь %1 недоступен, проверьте подключение пользователя'"), МобильноеУстройство));		
			Продолжить;
		КонецЕсли;
		
		ДанныеГрупповогоПересчетаОтправлены = Ложь;
		
		ДанныеГрупповогоПересчета = ПолучитьДокументыГрупповогоПересчета(МобильноеУстройство);
		
		Если ДанныеГрупповогоПересчета <> "" Тогда
			ДанныеГрупповогоПересчетаОтправлены = ОтправитьДанныегрупповогоПересчетаНаМУ(МобильноеУстройство, ДанныеГрупповогоПересчета).ДанныеОтправлены;
		КонецЕсли; 
			
		Если ДанныеГрупповогоПересчетаОтправлены Тогда
			
			//@skip-check query-in-loop
			ОтправитьПакетДанныхНаМУЗавершение(МобильноеУстройство);	
			
		КонецЕсли;
		
		Если ДанныеГрупповогоПересчета = "" Тогда 
			ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон(НСтр("ru = 'Нет данных для обмена по пользователю %1'"), МобильноеУстройство));
		ИначеЕсли Не ДанныеГрупповогоПересчетаОтправлены И  ДанныеГрупповогоПересчета <> "" Тогда 
			ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон(НСтр("ru = 'Не удалось отправить данные на %1'"), МобильноеУстройство));
		ИначеЕсли ДанныеГрупповогоПересчетаОтправлены Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон(НСтр("ru = 'Отправлены данные по документам пересчета на %1'"), МобильноеУстройство));	
		КонецЕсли;
		
	КонецЦикла;
	
	ОбновитьПользователей();
	
КонецФункции // ПолучитьДанные()

&НаСервереБезКонтекста
Функция ПолучитьДанныеОжидание(Знач МобильноеУстройство, Знач ПолучитьДанныеНСИ, Знач ПолучитьДанныеДокументов) 
	
	Возврат SUI_ОбменДаннымиСервер.ПолучитьДанные(SUI_МобильныеУстройстваСервер.МобильноеУстройствоФильтр(МобильноеУстройство), ПолучитьДанныеНСИ, ПолучитьДанныеДокументов, Истина);
	
КонецФункции

&НаСервереБезКонтекста
Функция ПроверитьПолнуюВыгрузкуПользователя(Знач МобильноеУстройство)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	SUI_СостоянияМобильныхУстройств.Состояние КАК СостояниеПолнойВыгрузки
	|ИЗ
	|	РегистрСведений.SUI_СостоянияМобильныхУстройств КАК SUI_СостоянияМобильныхУстройств
	|ГДЕ
	|	SUI_СостоянияМобильныхУстройств.МобильноеУстройство = &МобильноеУстройство
	|	И SUI_СостоянияМобильныхУстройств.Состояние В (&Состояния)";
	
	Запрос.УстановитьПараметр("МобильноеУстройство", МобильноеУстройство); 
	
	МассивСтатусов = Новый Массив;
	МассивСтатусов.Добавить(Перечисления.SUI_СостоянияМобильныхУстройств.ФормированиеДанных);
	МассивСтатусов.Добавить(Перечисления.SUI_СостоянияМобильныхУстройств.ТребуетсяПолучитьДанные);
	
	Запрос.УстановитьПараметр("Состояния", МассивСтатусов);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		РегистрыСведений.SUI_КешПакетовДанных.УдалитьПакет(МобильноеУстройство);	
		
	КонецЦикла;
	
КонецФункции // ПроверитьПолнуюВыгрузкуПользователя()

