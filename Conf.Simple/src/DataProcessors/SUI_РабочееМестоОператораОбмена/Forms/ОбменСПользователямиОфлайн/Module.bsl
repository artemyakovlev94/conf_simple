// Процедура - Записать новый IP
// Записывает измененный IP пользователя 
// Параметры:
//  Пользователь - ПланОбмена.SUI_МобильныеУстройства - ссылка на мобильного пользователя 
//  IPАдресНовый - Строка - новый IP адрес
//
&НаСервереБезКонтекста
Процедура ЗаписатьНовыйIP(Знач Пользователь, Знач IPАдресНовый)
	
	НачатьТранзакцию();
	Попытка                                  
		Объект = Пользователь.ПолучитьОбъект();
		Если Объект = Неопределено Тогда 
			ОтменитьТранзакцию();
			Возврат;
		КонецЕсли;
		
		ЗаблокироватьДанныеДляРедактирования(Пользователь);
		
		Объект.IPАдрес = IPАдресНовый;
		Объект.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
	КонецПопытки;
	
