&НаКлиенте
Процедура Подключаемый_ПриИзмененииРеквизита(Элемент, ОбновлятьИнтерфейс = Истина)
	
	ПриИзмененииРеквизитаСервер(Элемент.Имя);
	ОбновитьПовторноИспользуемыеЗначения();
	
	Если ОбновлятьИнтерфейс Тогда
		ОбновитьИнтерфейс = Истина;
		ПодключитьОбработчикОжидания("ОбновитьИнтерфейсПрограммы", 2, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьИнтерфейсПрограммы()
	
	Если ОбновитьИнтерфейс = Истина Тогда
		ОбновитьИнтерфейс = Ложь;
		SUI_ОбщегоНазначенияКлиент.ОбновитьИнтерфейсПрограммы();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииРеквизитаСервер(ИмяЭлемента)
	
	РеквизитПутьКДанным = Элементы[ИмяЭлемента].ПутьКДанным;
	СохранитьЗначениеРеквизита(РеквизитПутьКДанным);
	УстановитьВидимостьИДоступность();
	
КонецПроцедуры

&НаСервере
Процедура СохранитьЗначениеРеквизита(РеквизитПутьКДанным)
	
	Если РеквизитПутьКДанным = "ИспользоватьРедакторJSON" Тогда
		Обработки.SUI_РедакторJSON.СохранитьПризнакИспользованияРедактораJSON(ЭтотОбъект[РеквизитПутьКДанным]);
	ИначеЕсли РеквизитПутьКДанным = "ИспользоватьРедакторКодаBSL" Тогда
		Обработки.SUI_РедакторКода.СохранитьПризнакИспользованияРедактораКодаBSL(ЭтотОбъект[РеквизитПутьКДанным]);
	ИначеЕсли РеквизитПутьКДанным = "ПроверкаОбновленийПриСтарте" Тогда
		Обработки.SUI_ОбновлениеSimple.УстановитьПризнакПроверкиОбновленийПриСтарте(ЭтотОбъект[РеквизитПутьКДанным]);
	ИначеЕсли Не ПустаяСтрока(РеквизитПутьКДанным) Тогда
		
		ЧастиИмени = СтрРазделить(РеквизитПутьКДанным, ".");
		
		Если ЧастиИмени.Количество() = 2 Тогда
			КонстантаИмя = ЧастиИмени[1];
			КонстантаЗначение = НаборКонстант[КонстантаИмя];
		ИначеЕсли ЧастиИмени.Количество() = 1 И НРег(Лев(РеквизитПутьКДанным, 9)) = НРег("Константа") Тогда
			КонстантаИмя = Сред(РеквизитПутьКДанным, 10);
			КонстантаЗначение = ЭтотОбъект[РеквизитПутьКДанным];
		Иначе
			Возврат;
		КонецЕсли;
		
		Если Константы[КонстантаИмя].Получить() <> КонстантаЗначение Тогда
			Константы[КонстантаИмя].Установить(КонстантаЗначение);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьИДоступность(РеквизитПутьКДанным = "")
	
	Элементы.ГруппаНастройки.Видимость = ЗначениеЗаполнено(НаборКонстант.SUI_ИспользуемыйВариантОбмена);
	
	Элементы.ПроверкаСвязиПубликацииИБ.Доступность 	= ЗначениеЗаполнено(НаборКонстант.SUI_АдресПубликацииБазы);
	Элементы.ГруппаЛогированиеПараметры.Доступность = НаборКонстант.SUI_ЛогированиеHTTPЗапросов;
	
	// Проверка варианта обмена на Онлайн
	Если НаборКонстант.SUI_ИспользуемыйВариантОбмена = Перечисления.SUI_ВариантОбмена.Онлайн Тогда
		Элементы.ГруппаНастройкиОнлайнОбмена.Видимость 	= Истина;  
		Элементы.ГруппаМобильныеКлиентыЗапросыАвторизации.Видимость 	= Истина;
		Элементы.ГруппаНастройкаПеремещенияЗапасов.Видимость 	= Истина;
		Элементы.ПоказатьQRКодПодключенияМУ.Видимость 	= Истина; 
		Элементы.НастройкиОбменаОфлайн.Видимость 	= Ложь;
	Иначе
		Элементы.ГруппаНастройкиОнлайнОбмена.Видимость 	= Ложь; 
		Элементы.ГруппаМобильныеКлиентыЗапросыАвторизации.Видимость 	= Ложь;
		Элементы.ГруппаНастройкаПеремещенияЗапасов.Видимость 	= Ложь;
		Элементы.ПоказатьQRКодПодключенияМУ.Видимость 	= Ложь;
		Элементы.НастройкиОбменаОфлайн.Видимость 	= Истина;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АдресПубликацииБазыНачалоВыбораПродолжение()
	
	Если ОбщегоНазначенияКлиент.КлиентПодключенЧерезВебСервер() Тогда
		АдресПубликацииБазыНачалоВыбораПродолжениеНаСервере("SUI_АдресПубликацииБазы", СтрокаСоединенияИнформационнойБазы());
		Подключаемый_ПриИзмененииРеквизита(Элементы["SUI_АдресПубликацииБазы"], Ложь);
	Иначе
		ПоказатьПредупреждение(, НСтр("ru = 'Не удалось автоматически заполнить поле, т.к. клиентское приложение не подключено через веб-сервер.'"));
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура АдресПубликацииБазыНачалоВыбораПродолжениеНаСервере(ИмяРеквизита, СтрокаСоединения)
	
	ПараметрыСоединения = СтроковыеФункцииКлиентСервер.ПараметрыИзСтроки(СтрокаСоединения);
	Если ПараметрыСоединения.Свойство("WS") Тогда
		НаборКонстант[ИмяРеквизита] = ПараметрыСоединения.WS;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьАлгоритмПолученияШтрихкодаДокументаЗавершение(Алгоритм, Контекст) Экспорт
	
	Если Алгоритм = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НаборКонстант.SUI_АлгоритмПолученияШтрихкодаДокумента = Алгоритм;
	
	СохранитьЗначениеРеквизита("НаборКонстант.SUI_АлгоритмПолученияШтрихкодаДокумента");
	
КонецПроцедуры

#КонецОбласти
