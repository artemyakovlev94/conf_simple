
#Область ОписаниеПеременных

&НаКлиенте
Перем ТекущаяСтрокаМетаданных;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Данные = СформироватьСтруктуруМетаданных();
	СтруктураПредставленийМетаданных = Данные.СтруктураПредставлений;
	СтруктураИменМетаданных          = Данные.СтруктураИмен;
		
	ЗначениеВРеквизитФормы(Данные.Дерево, "ДеревоМетаданныхЭталон");
	
	ЗагрузитьЭталонВДеревоМетаданных();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ЗначениеЗаполнено(МобильноеУстройство) Тогда
		ПолучитьКоличествоИзменений();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура МобильноеУстройствоПриИзменении(Элемент)

	ЗагрузитьЭталонВДеревоМетаданных();

	Если ЗначениеЗаполнено(МобильноеУстройство) Тогда
		ПолучитьКоличествоИзменений();
		Элементы.ГруппаРегистрацияИзменений.Доступность = Истина;
	Иначе
		Элементы.ГруппаРегистрацияИзменений.Доступность = Ложь;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДеревоМетаданных

&НаКлиенте
Процедура ДеревоМетаданныхПриАктивизацииСтроки(Элемент)
	
	Если Элементы.ДеревоМетаданных.ТекущаяСтрока <> ТекущаяСтрокаМетаданных Тогда
		ТекущаяСтрокаМетаданных  = Элементы.ДеревоМетаданных.ТекущаяСтрока;
		ПодключитьОбработчикОжидания("НастроитьРедактированиеИзменений", 0.0000001, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоМетаданныхПометкаПриИзменении(Элемент)
	ИзменениеПометки(Элементы.ДеревоМетаданных.ТекущаяСтрока);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОбновитьВсеДанные(Команда)
	ПолучитьКоличествоИзменений();
КонецПроцедуры

&НаКлиенте
Процедура ЗарегистрироватьИзмененияПоОтбору(Команда)
	
	ТекущаяСтраница = Элементы.СтраницыДетализацииИзменений.ТекущаяСтраница;
	Если Элементы.ДеревоМетаданных.ТекущиеДанные = Неопределено Или
		(ТекущаяСтраница <> Элементы.СтраницаДетализацияИзмененийКонстант И 
		ТекущаяСтраница <> Элементы.СтраницаДетализацияИзмененийНаборовЗаписей И 
		ТекущаяСтраница <> Элементы.СтраницаДетализацияИзмененийСсылок) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(МобильноеУстройство) Тогда
		SUI_ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не выбрано мобильное устройство'"), , "МобильноеУстройство");
		Возврат;
	КонецЕсли;

	ПараметрыОткрытия = Новый Структура();
	ПараметрыОткрытия.Вставить("ПолноеИмяМетаданных", 	Элементы.ДеревоМетаданных.ТекущиеДанные.ПолноеИмяМетаданных);
	ПараметрыОткрытия.Вставить("ИдентификаторСтроки", 	Элементы.ДеревоМетаданных.ТекущиеДанные.ИдентификаторСтроки);
	ПараметрыОткрытия.Вставить("ТекущаяСтрока", 		Элементы.ДеревоМетаданных.ТекущаяСтрока);
	ПараметрыОткрытия.Вставить("Действие", 				"ЗарегистрироватьИзмененияПоОтбору");
	
	ОткрытьФормуВыбора(ПараметрыОткрытия);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗарегистрироватьИзмененияОдного(Команда)
	
	ТекущаяСтраница = Элементы.СтраницыДетализацииИзменений.ТекущаяСтраница;
	Если Элементы.ДеревоМетаданных.ТекущиеДанные = Неопределено Или
		(ТекущаяСтраница <> Элементы.СтраницаДетализацияИзмененийКонстант И 
		ТекущаяСтраница <> Элементы.СтраницаДетализацияИзмененийНаборовЗаписей И 
		ТекущаяСтраница <> Элементы.СтраницаДетализацияИзмененийСсылок) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(МобильноеУстройство) Тогда
		SUI_ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не выбрано мобильное устройство'"), , "МобильноеУстройство");
		Возврат;
	КонецЕсли;

	ПараметрыОткрытия = Новый Структура();
	ПараметрыОткрытия.Вставить("ПолноеИмяМетаданных", 	Элементы.ДеревоМетаданных.ТекущиеДанные.ПолноеИмяМетаданных);
	ПараметрыОткрытия.Вставить("ИдентификаторСтроки", 	Элементы.ДеревоМетаданных.ТекущиеДанные.ИдентификаторСтроки);
	ПараметрыОткрытия.Вставить("ТекущаяСтрока", 		Элементы.ДеревоМетаданных.ТекущаяСтрока);
	ПараметрыОткрытия.Вставить("Действие", 				"ЗарегистрироватьИзмененияОдного");
	
	ОткрытьФормуВыбора(ПараметрыОткрытия);
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьРегистрациюИзмененийПоОтбору(Команда)
	
	ТекущаяСтраница = Элементы.СтраницыДетализацииИзменений.ТекущаяСтраница;
	Если Элементы.ДеревоМетаданных.ТекущиеДанные = Неопределено Или
		(ТекущаяСтраница <> Элементы.СтраницаДетализацияИзмененийКонстант И 
		ТекущаяСтраница <> Элементы.СтраницаДетализацияИзмененийНаборовЗаписей И 
		ТекущаяСтраница <> Элементы.СтраницаДетализацияИзмененийСсылок) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(МобильноеУстройство) Тогда
		SUI_ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не выбрано мобильное устройство'"), , "МобильноеУстройство");
		Возврат;
	КонецЕсли;

	ПараметрыОткрытия = Новый Структура();
	ПараметрыОткрытия.Вставить("ПолноеИмяМетаданных", 	Элементы.ДеревоМетаданных.ТекущиеДанные.ПолноеИмяМетаданных);
	ПараметрыОткрытия.Вставить("ИдентификаторСтроки", 	Элементы.ДеревоМетаданных.ТекущиеДанные.ИдентификаторСтроки);
	ПараметрыОткрытия.Вставить("ТекущаяСтрока", 		Элементы.ДеревоМетаданных.ТекущаяСтрока);
	ПараметрыОткрытия.Вставить("Действие", 				"УдалитьРегистрациюИзмененийПоОтбору");
	
	ОткрытьФормуВыбора(ПараметрыОткрытия);
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьРегистрациюИзмененийОдного(Команда)
	
	ТекущаяСтраница = Элементы.СтраницыДетализацииИзменений.ТекущаяСтраница;
	Если Элементы.ДеревоМетаданных.ТекущиеДанные = Неопределено Или
		(ТекущаяСтраница <> Элементы.СтраницаДетализацияИзмененийКонстант И 
		ТекущаяСтраница <> Элементы.СтраницаДетализацияИзмененийНаборовЗаписей И 
		ТекущаяСтраница <> Элементы.СтраницаДетализацияИзмененийСсылок) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(МобильноеУстройство) Тогда
		SUI_ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не выбрано мобильное устройство'"), , "МобильноеУстройство");
		Возврат;
	КонецЕсли;
	
	ВыбранныеЗначения = Неопределено;
	
	Если ТекущаяСтраница = Элементы.СтраницаДетализацияИзмененийНаборовЗаписей Тогда
		
		
		Если Элементы.ДетализацияИзмененийНаборыЗаписей.ТекущиеДанные <> Неопределено И Не ПустаяСтрока(ИзмеренияНЗ) Тогда
			
			ВыбранныеЗначения = Новый Массив();
			
			ВыделенныеСтроки = Элементы.ДетализацияИзмененийНаборыЗаписей.ВыделенныеСтроки;
			Для Каждого ВыделеннаяСтрока Из ВыделенныеСтроки Цикл
			
				ТекущаяСтрока = Элементы.ДетализацияИзмененийНаборыЗаписей.ДанныеСтроки(ВыделеннаяСтрока);
				Если ТекущаяСтрока <> Неопределено Тогда
					ВыбранноеЗначение = Новый Структура(ИзмеренияНЗ);
					ЗаполнитьЗначенияСвойств(ВыбранноеЗначение, ТекущаяСтрока);
					ВыбранныеЗначения.Добавить(Новый ФиксированнаяСтруктура(ВыбранноеЗначение));
				КонецЕсли;
				
			КонецЦикла;

		КонецЕсли;
		
	ИначеЕсли ТекущаяСтраница = Элементы.СтраницаДетализацияИзмененийСсылок Тогда
		ТекущиеДанные = Элементы.ДетализацияИзмененийСсылки.ТекущиеДанные;
		ВыбранныеЗначения = ТекущиеДанные.Ссылка;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ВыбранныеЗначения) Тогда
		Возврат;
	КонецЕсли;
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("УдалитьРегистрациюИзмененийОдногоПодтверждение", ЭтотОбъект, ВыбранныеЗначения);
	ПоказатьВопрос(ОповещениеОЗавершении, НСтр("ru = 'Удалить регистрацию изменений по выделеным строкам?'"), РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ЗарегистрироватьИзмененияОтмеченыхОбъектовКонфигурации(Команда)
	
	Если Не ЗначениеЗаполнено(МобильноеУстройство) Тогда
		SUI_ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не выбрано мобильное устройство'"), , "МобильноеУстройство");
		Возврат;
	КонецЕсли;
	
	ВыбранныеЗначения = ПолучитьОтмеченныеОбъектыМетаданных();
	
	Если ВыбранныеЗначения.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ЗарегистрироватьИзмененияОтмеченыхОбъектовКонфигурацииПодтверждение", 
		ЭтотОбъект, ВыбранныеЗначения);
	ПоказатьВопрос(ОповещениеОЗавершении, НСтр("ru = 'Зарегистрировать изменения по отмеченным объектам конфигурации?
	|
	|Регистрация изменений по объектам конфигурации может занят продолжительное время.'"), РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьРегистрациюИзмененийОтмеченыхОбъектовКонфигурации(Команда)
	
	Если Не ЗначениеЗаполнено(МобильноеУстройство) Тогда
		SUI_ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не выбрано мобильное устройство'"), , "МобильноеУстройство");
		Возврат;
	КонецЕсли;
	
	ВыбранныеЗначения = ПолучитьОтмеченныеОбъектыМетаданных();
	
	Если ВыбранныеЗначения.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("УдалитьРегистрациюИзмененийОтмеченыхОбъектовКонфигурацииПодтверждение", 
		ЭтотОбъект, ВыбранныеЗначения);
	ПоказатьВопрос(ОповещениеОЗавершении, НСтр("ru = 'Удалить регистрацию изменений по отмеченным объектам конфигурации?
	|
	|Удаление регистрации изменений по объектам конфигурации может занят продолжительное время.'"), РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗагрузитьЭталонВДеревоМетаданных()
	
	Эталон = РеквизитФормыВЗначение("ДеревоМетаданныхЭталон", Тип("ДеревоЗначений"));
	ЗначениеВРеквизитФормы(Эталон, "ДеревоМетаданных");

КонецПроцедуры

&НаКлиенте
Процедура ПолучитьКоличествоИзменений()
	
	ДлительнаяОперация = ПолучитьКоличествоИзмененийНаСервере();
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ПолучитьКоличествоИзмененийЗавершение", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьКоличествоИзмененийНаСервере()
	
	ПараметрыПроцедуры = Новый Структура();
	ПараметрыПроцедуры.Вставить("СписокТаблиц", СтруктураИменМетаданных);
	ПараметрыПроцедуры.Вставить("СписокМобильныхУстройств", МобильноеУстройство);
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	
	Возврат ДлительныеОперации.ВыполнитьВФоне("Обработки.SUI_РегистрацияИзменений.ПолучитьКоличествоИзменений", 
		ПараметрыПроцедуры, ПараметрыВыполнения);

КонецФункции

&НаКлиенте
Процедура ПолучитьКоличествоИзмененийЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Сообщения <> Неопределено Тогда
		
		Для индекс = 0 По Результат.Сообщения.ВГраница() Цикл
			Результат.Сообщения[индекс].Сообщить();
		КонецЦикла;
		
	КонецЕсли;

	Если Результат.Статус = "Ошибка" Тогда
		ПоказатьПредупреждение(, Результат.КраткоеПредставлениеОшибки);
		SUI_ОбщегоНазначенияКлиент.СообщитьПользователю(Результат.ПодробноеПредставлениеОшибки);
		Возврат;
	КонецЕсли;

	Если Результат.Статус = "Выполнено" Тогда
		ЗаполнитьКоличествоРегистрацийВДеревеНаСервере(Результат.АдресРезультата);
		ОбновитьСодержимоеСтраницы();
		РазвернутьДеревоМетаданных();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКоличествоРегистрацийВДеревеНаСервере(АдресДанных)

	Данные = ПолучитьИзВременногоХранилища(АдресДанных);

	// Проставляем в дерево
	Фильтр = Новый Структура("ПолноеИмяМетаданных, МобильноеУстройство", Неопределено, МобильноеУстройство);
	Нули   = Новый Структура("КоличествоИзменений", 0);

	Для Каждого Корень Из ДеревоМетаданных.ПолучитьЭлементы() Цикл
		
		СуммаКорень = Новый Структура("КоличествоИзменений", 0);

		Для Каждого Группа Из Корень.ПолучитьЭлементы() Цикл
			
			СуммаГруппа = Новый Структура("КоличествоИзменений", 0);

			СписокМобильныхУстройств = Группа.ПолучитьЭлементы();
			
			Если СписокМобильныхУстройств.Количество() = 0 И СтруктураИменМетаданных.Свойство(Группа.ПолноеИмяМетаданных) Тогда
				// Коллекция узлов без узлов, просуммируем руками, авторегистрацию возьмем из структуры
				Для Каждого МетаИмя Из СтруктураИменМетаданных[Группа.ПолноеИмяМетаданных] Цикл
					Фильтр.ПолноеИмяМетаданных = МетаИмя;
					Найдено = Данные.НайтиСтроки(Фильтр);
					Если Найдено.Количество() > 0 Тогда
						Строка = Найдено[0];
						СуммаГруппа.КоличествоИзменений = СуммаГруппа.КоличествоИзменений + Строка.КоличествоИзменений;
					КонецЕсли;
				КонецЦикла;

			Иначе
				// Считаем по каждому узлу
				Для Каждого УзелМобильноеУстройство Из СписокМобильныхУстройств Цикл
					
					Фильтр.ПолноеИмяМетаданных = УзелМобильноеУстройство.ПолноеИмяМетаданных;
					Найдено = Данные.НайтиСтроки(Фильтр);
					Если Найдено.Количество() > 0 Тогда
						Строка = Найдено[0];
						ЗаполнитьЗначенияСвойств(УзелМобильноеУстройство, Строка, "КоличествоИзменений");
						СуммаГруппа.КоличествоИзменений = СуммаГруппа.КоличествоИзменений + Строка.КоличествоИзменений;
					Иначе
						ЗаполнитьЗначенияСвойств(УзелМобильноеУстройство, Нули);
					КонецЕсли;

				КонецЦикла;

			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(Группа, СуммаГруппа);
			СуммаКорень.КоличествоИзменений = СуммаКорень.КоличествоИзменений + Группа.КоличествоИзменений;

		КонецЦикла;

		ЗаполнитьЗначенияСвойств(Корень, СуммаКорень);

	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура РазвернутьДеревоМетаданных()
	
	Для Каждого Строка Из ДеревоМетаданных.ПолучитьЭлементы() Цикл
		Элементы.ДеревоМетаданных.Развернуть(Строка.ПолучитьИдентификатор());
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьРедактированиеИзменений()
	НастроитьРедактированиеИзмененийСервер(ТекущаяСтрокаМетаданных);
	НастроитьВидимостьКомандОбщегоМеню();
КонецПроцедуры

&НаСервере
Процедура НастроитьРедактированиеИзмененийСервер(ТекущаяСтрока)

	Данные = ДеревоМетаданных.НайтиПоИдентификатору(ТекущаяСтрока);
	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ИзмеренияНЗ = "";
	ИмяТаблицы = Данные.ПолноеИмяМетаданных;
	Представление = Данные.Представление;
	ТекущийОбъект = РеквизитФормыВЗначение("Объект");
	ТекущиеМетаданные = МетаданныеПоПолномуИмени(ИмяТаблицы);

	Если ТекущиеМетаданные = 0 Тогда
		НастроитьПустуюСтраницу(Представление, ИмяТаблицы);
		ТекущаяСтраница = Элементы.СтраницаДетализацияИзмененийПустая;

	ИначеЕсли ТекущиеМетаданные = Метаданные.Константы Тогда
		// Все константы системы
		НастроитьСписокКонстант();
		ТекущаяСтраница = Элементы.СтраницаДетализацияИзмененийКонстант;

	ИначеЕсли ТипЗнч(ТекущиеМетаданные) = Тип("КоллекцияОбъектовМетаданных") Тогда
		// Все справочники, документы, и т.п.
		НастроитьПустуюСтраницу(Представление, ИмяТаблицы);
		ТекущаяСтраница = Элементы.СтраницаДетализацияИзмененийПустая;

	ИначеЕсли Метаданные.Константы.Содержит(ТекущиеМетаданные) Тогда
		// Одиночная константа
		НастроитьСписокКонстант(ИмяТаблицы, Представление);
		ТекущаяСтраница = Элементы.СтраницаДетализацияИзмененийКонстант;

	ИначеЕсли Метаданные.Справочники.Содержит(ТекущиеМетаданные) Или Метаданные.Документы.Содержит(ТекущиеМетаданные)
		Или Метаданные.ПланыВидовХарактеристик.Содержит(ТекущиеМетаданные) Или Метаданные.ПланыСчетов.Содержит(ТекущиеМетаданные)
		Или Метаданные.ПланыВидовРасчета.Содержит(ТекущиеМетаданные) Или Метаданные.БизнесПроцессы.Содержит(ТекущиеМетаданные)
		Или Метаданные.Задачи.Содержит(ТекущиеМетаданные) Тогда
		// Ссылочный тип
		НастроитьСписокСсылок(ИмяТаблицы, Представление);
		ТекущаяСтраница = Элементы.СтраницаДетализацияИзмененийСсылок;

	Иначе
		// Проверим на набор записей
		Измерения = СформироватьИзмеренияНабораЗаписей(ИмяТаблицы);
		Если Измерения <> Неопределено Тогда
			НастроитьНаборЗаписей(ИмяТаблицы, Измерения, Представление);
			ТекущаяСтраница = Элементы.СтраницаДетализацияИзмененийНаборовЗаписей;
		Иначе
			НастроитьПустуюСтраницу(Представление, ИмяТаблицы);
			ТекущаяСтраница = Элементы.СтраницаДетализацияИзмененийПустая;
		КонецЕсли;

	КонецЕсли;

	Элементы.СтраницыДетализацииИзменений.ТекущаяСтраница = ТекущаяСтраница;

КонецПроцедуры

&НаКлиенте
Процедура НастроитьВидимостьКомандОбщегоМеню()
	
	ТекущаяСтраница = Элементы.СтраницыДетализацииИзменений.ТекущаяСтраница;

	Если ТекущаяСтраница = Элементы.СтраницаДетализацияИзмененийСсылок Тогда
		Элементы.ЗарегистрироватьИзмененияОдного.Видимость = Истина;
	Иначе
		Элементы.ЗарегистрироватьИзмененияОдного.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЭкранироватьДвойныеКовычки(Строка)
	Возврат СтрЗаменить(Строка, """", """""");
КонецФункции

&НаСервере
Процедура НастроитьПустуюСтраницу(Наименование, ИмяТаблицы = Неопределено)

	Если ЗначениеЗаполнено(МобильноеУстройство) Тогда
		
		КоличествоИзменений = 0;
		Если ИмяТаблицы <> Неопределено Тогда
			Дерево = РеквизитФормыВЗначение("ДеревоМетаданных");
			Строка = Дерево.Строки.Найти(ИмяТаблицы, "ПолноеИмяМетаданных", Истина);
			Если Строка <> Неопределено Тогда
				КоличествоИзменений = Строка.КоличествоИзменений;
			КонецЕсли;
		КонецЕсли;
	
		Элементы.НадписьОписанияДетализации.Заголовок = СтрШаблон(
			НСтр("ru='%1
			|
			|Мобильное устройство: %2
			|Зарегистрировано изменений: %3
			|
			|Для регистрации или отмены регистрации изменений
			|выберите объект конфигурации и воспользуйтесь
			|командами ""Зарегистрировать"" или ""Отменить регистрацию""'"), 
		Наименование, МобильноеУстройство, Формат(КоличествоИзменений, "ЧДЦ=0; ЧН="));
		
	Иначе
		Элементы.НадписьОписанияДетализации.Заголовок = СтрШаблон(
			НСтр("ru='%1
			|
			|Выберите мобильное устройство для просмотра и редактирования регистрации изменений.'"), 
		Наименование);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьСписокКонстант(ИмяТаблицы = Неопределено, Наименование = "")

	Если ИмяТаблицы = Неопределено Тогда
		// Все константы
		Имена = СтруктураИменМетаданных.Константы;
		Представления = СтруктураПредставленийМетаданных.Константы;
	Иначе
		Имена = Новый Массив();
		Имена.Добавить(ИмяТаблицы);
		Представления = Новый Массив();
		Представления.Добавить(Наименование);
		Индекс = СтруктураИменМетаданных.Константы.Найти(ИмяТаблицы);
	КонецЕсли;
	
	Текст = "";
	Для Индекс = 0 По Имена.ВГраница() Цикл
		Имя = Имена[Индекс];
		Текст = Текст + ?(Текст = "", "ВЫБРАТЬ" + Символы.ПС, "ОБЪЕДИНИТЬ ВСЕ " + Символы.ПС + Символы.ПС + "ВЫБРАТЬ") + "
		|	2 КАК ИндексКартинки,
		|	""" + ЭкранироватьДвойныеКовычки(Представления[Индекс]) + """ КАК Наименование,
		|	""" + Имя + """ КАК ПолноеИмяМетаданных
		|ИЗ
		|	" + Имя + ".Изменения КАК ТаблицаИзменений
		|ГДЕ
		|	ТаблицаИзменений.Узел = &МобильноеУстройство
		|";
	КонецЦикла;

	ДетализацияИзмененийКонстанты.ТекстЗапроса = "
	|ВЫБРАТЬ
	|	ИндексКартинки, Наименование, ПолноеИмяМетаданных
	|
	|{ВЫБРАТЬ
	|	ИндексКартинки, Наименование, ПолноеИмяМетаданных
	|}
	|
	|ИЗ (" + Текст + ") Данные
	|
	|{ГДЕ
	|	Наименование
	|}
	|";

	ЭлементыСписка = ДетализацияИзмененийКонстанты.Порядок.Элементы;
	Если ЭлементыСписка.Количество() = 0 Тогда
		Элемент = ЭлементыСписка.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
		Элемент.Поле = Новый ПолеКомпоновкиДанных("Наименование");
		Элемент.Использование = Истина;
	КонецЕсли;

	ДетализацияИзмененийКонстанты.Параметры.УстановитьЗначениеПараметра("МобильноеУстройство", МобильноеУстройство);
	ДетализацияИзмененийКонстанты.ДинамическоеСчитываниеДанных = Истина;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьСписокСсылок(ИмяТаблицы, Наименование)

	ДетализацияИзмененийСсылки.ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ТаблицаИзменений.Ссылка КАК Ссылка
	|ИЗ
	|	" + ИмяТаблицы + ".Изменения КАК ТаблицаИзменений
	|ГДЕ
	|	ТаблицаИзменений.Узел = &МобильноеУстройство";	

	ДетализацияИзмененийСсылки.Параметры.УстановитьЗначениеПараметра("МобильноеУстройство", МобильноеУстройство);
	ДетализацияИзмененийСсылки.ДинамическоеСчитываниеДанных = Истина;
	//ДетализацияИзмененийСсылки.ОсновнаяТаблица = ИмяТаблицы;
	
	// Представление объекта
	ТекущиеМетаданные = МетаданныеПоПолномуИмени(ИмяТаблицы);
	ЗаголовокПредставленияСсылки = ТекущиеМетаданные.ПредставлениеОбъекта;
	Если ПустаяСтрока(ЗаголовокПредставленияСсылки) Тогда
		ЗаголовокПредставленияСсылки = Наименование;
	КонецЕсли;
	Элементы.ДетализацияИзмененийСсылокПредставлениеСсылки.Заголовок = ЗаголовокПредставленияСсылки;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьНаборЗаписей(ИмяТаблицы, Измерения, Наименование)

	ИзмеренияНабораЗаписей = Новый Массив();
	Выбрать = Новый Массив();
	Для Каждого Строка Из Измерения Цикл
		Выбрать.Добавить(СтрШаблон("ТаблицаИзменений.%1 КАК %1", Строка.Имя));
		ИзмеренияНабораЗаписей.Добавить(Строка.Имя);
	КонецЦикла;
	
	ИзмеренияНЗ = СтрСоединить(ИзмеренияНабораЗаписей, ",");

	ДетализацияИзмененийНаборыЗаписей.ТекстЗапроса = "
		|ВЫБРАТЬ
		|	ИСТИНА КАК Зарегистрировано,
		|	" + СтрСоединить(Выбрать, "," + Символы.ПС) + "
		|ИЗ
		|	" + ИмяТаблицы + ".Изменения КАК ТаблицаИзменений
		|ГДЕ
		|	ТаблицаИзменений.Узел = &МобильноеУстройство";
	
	ДетализацияИзмененийНаборыЗаписей.Параметры.УстановитьЗначениеПараметра("МобильноеУстройство", МобильноеУстройство);
	
	// Добавляем в группу измерений
	ДобавитьКолонкиВТаблицуФормы(
		Элементы.ДетализацияИзмененийНаборыЗаписей, 
		"Порядок, Отбор, Группировка, СтандартнаяКартинка, Параметры, УсловноеОформление",
		Измерения, Элементы.ДетализацияИзмененийНаборыЗаписейГруппаИзмерений);
	
	ДетализацияИзмененийНаборыЗаписей.ДинамическоеСчитываниеДанных = Истина;
	ДетализацияИзмененийНаборыЗаписейИмяТаблицы = ИмяТаблицы;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСодержимоеСтраницы(Страница = Неопределено)
	
	ТекущаяСтраница = ?(Страница = Неопределено, Элементы.СтраницыДетализацииИзменений.ТекущаяСтраница, Страница);

	Если ТекущаяСтраница = Элементы.СтраницаДетализацияИзмененийСсылок Тогда
		Элементы.ДетализацияИзмененийСсылки.Обновить();

	ИначеЕсли ТекущаяСтраница = Элементы.СтраницаДетализацияИзмененийКонстант Тогда
		Элементы.ДетализацияИзмененийКонстанты.Обновить();

	ИначеЕсли ТекущаяСтраница = Элементы.СтраницаДетализацияИзмененийНаборовЗаписей Тогда
		Элементы.ДетализацияИзмененийНаборыЗаписей.Обновить();

	ИначеЕсли ТекущаяСтраница = Элементы.СтраницаДетализацияИзмененийПустая Тогда
		
		Строка = Элементы.ДеревоМетаданных.ТекущаяСтрока;
		Если Строка <> Неопределено Тогда
			
			Данные = ДеревоМетаданных.НайтиПоИдентификатору(Строка);
			
			Если Данные <> Неопределено Тогда
				НастроитьПустуюСтраницу(Данные.Представление, Данные.ПолноеИмяМетаданных);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ИзменениеПометки(Строка)
	ЭлементДанных = ДеревоМетаданных.НайтиПоИдентификатору(Строка);
	ЭлементДанных.Пометка = ЭлементДанных.Пометка % 2;
	ПроставитьПометкиВниз(ЭлементДанных);
	ПроставитьПометкиВверх(ЭлементДанных);
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуВыбора(Знач Контекст)

	НомерРазделителя = СтрНайти(Контекст.ПолноеИмяМетаданных, ".");
	Если ПустаяСтрока(Контекст.ПолноеИмяМетаданных) Или 
		Контекст.ИдентификаторСтроки = 0 Или 
		НомерРазделителя = 0 Тогда
		Возврат;
	КонецЕсли;

	Контекст.Вставить("ВидОбъекта", Лев(Контекст.ПолноеИмяМетаданных, НомерРазделителя-1));

	ПараметрыФормыВыбора = Новый Структура();
	Если Контекст.ВидОбъекта = "Справочник" И Контекст.Действие = "ЗарегистрироватьИзмененияОдного" Тогда
		ИмяФормыВыбора = Контекст.ПолноеИмяМетаданных + ".ФормаВыбора";
	Иначе

		ПараметрыФормыВыбора.Вставить("ПолноеИмяМетаданных", Контекст.ПолноеИмяМетаданных);
		ПараметрыФормыВыбора.Вставить("МобильноеУстройство", МобильноеУстройство);
		
		Если Контекст.Действие = "УдалитьРегистрациюИзмененийПоОтбору" Тогда
			ПараметрыФормыВыбора.Вставить("ТолькоИзменения");
		КонецЕсли;
		
		ИмяФормыВыбора = "Обработка.SUI_РегистрацияИзменений.Форма.ФормаВыбора";
		
	КонецЕсли;
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ОткрытьФормуВыбораЗавершение", ЭтотОбъект, Контекст);
	ОткрытьФорму(ИмяФормыВыбора, ПараметрыФормыВыбора, ЭтотОбъект, УникальныйИдентификатор, , , 
		ОповещениеОЗавершении, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуВыбораЗавершение(Знач ВыбранныеЗначения, Контекст) Экспорт

	Если Не ЗначениеЗаполнено(ВыбранныеЗначения) Тогда
		Возврат;
	КонецЕсли;

	ПараметрыВыполнения = ПараметрыВыполненияДействияНаУзлах(МобильноеУстройство, СтрНачинаетсяС(Контекст.Действие, "ЗарегистрироватьИзменения"));
	ПараметрыВыполнения.МетаданныеВыбранныхЗначений = Контекст.ПолноеИмяМетаданных;
	ПараметрыВыполнения.ВыбранныеЗначения = ВыбранныеЗначения;
	
	ДлительнаяОперация = ВыполнитьДействиеНаУзлахНаСервере(ПараметрыВыполнения);
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ВыполнитьДействиеНаУзлахЗавершение", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания);
	
КонецПроцедуры

&НаСервере
Функция ВыполнитьДействиеНаУзлахНаСервере(ПараметрыПроцедуры)
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	Возврат ДлительныеОперации.ВыполнитьВФоне("Обработки.SUI_РегистрацияИзменений.ВыполнитьДействиеНаУзлах", 
		ПараметрыПроцедуры, ПараметрыВыполнения);

КонецФункции

&НаКлиенте
Процедура ВыполнитьДействиеНаУзлахЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОчиститьСообщения();
	
	Если ЗначениеЗаполнено(Результат.Сообщения) Тогда
		
		Для индекс = 0 По Результат.Сообщения.ВГраница() Цикл
			Результат.Сообщения[индекс].Сообщить();
		КонецЦикла;
		
	КонецЕсли;

	Если Результат.Статус = "Ошибка" Тогда
		ПоказатьПредупреждение(, Результат.КраткоеПредставлениеОшибки);
		SUI_ОбщегоНазначенияКлиент.СообщитьПользователю(Результат.ПодробноеПредставлениеОшибки);
		Возврат;
	КонецЕсли;

	Если Результат.Статус = "Выполнено" Тогда
		
		Если ЗначениеЗаполнено(Результат.АдресРезультата) И ЭтоАдресВременногоХранилища(Результат.АдресРезультата) Тогда
			ОписаниеТипаБулево = Новый ОписаниеТипов("Булево");
			РезультатВыполнения = ОписаниеТипаБулево.ПривестиЗначение(ПолучитьИзВременногоХранилища(Результат.АдресРезультата));
		Иначе
			РезультатВыполнения = Ложь;
		КонецЕсли;
		
		Если РезультатВыполнения Тогда
			
			ПолучитьКоличествоИзменений();
			
			СнятьОтметкиОбъектовМетаданных = SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДополнительныеПараметры, 
				"СнятьОтметкиОбъектовМетаданных", Ложь, Тип("Булево"));
			
			Если СнятьОтметкиОбъектовМетаданных Тогда
				СнятьОтметкиСОтмеченныхОбъектовМетаданных();
			КонецЕсли;
				
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПараметрыВыполненияДействияНаУзлах(МобильноеУстройство, РегистрацияИзменений)
	
	ПараметрыВыполнения = Новый Структура();
	
	ПараметрыВыполнения.Вставить("МобильноеУстройство", МобильноеУстройство);
	
	Если РегистрацияИзменений Тогда
		ПараметрыВыполнения.Вставить("ЗарегистрироватьИзменения");
	Иначе
		ПараметрыВыполнения.Вставить("УдалитьРегистрациюИзменений");
	КонецЕсли;
	
	ПараметрыВыполнения.Вставить("МетаданныеВыбранныхЗначений");
	ПараметрыВыполнения.Вставить("ВыбранныеЗначения");
	ПараметрыВыполнения.Вставить("ВыбранныеМетаданные");
	
	Возврат ПараметрыВыполнения;
	
КонецФункции

