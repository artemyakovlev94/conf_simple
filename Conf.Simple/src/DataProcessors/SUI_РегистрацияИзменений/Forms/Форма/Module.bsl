&НаСервере
Функция ПолучитьОтмеченныеОбъектыМетаданных()
	
	ОтмеченныеОбъекты = Новый Массив();
	
	Для Каждого Корень Из ДеревоМетаданных.ПолучитьЭлементы() Цикл
		
		Если Корень.Пометка = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого Группа Из Корень.ПолучитьЭлементы() Цикл
			
			Если Группа.Пометка = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Для Каждого ОбъектГруппы Из Группа.ПолучитьЭлементы() Цикл
				
				Если ОбъектГруппы.Пометка = 1 Тогда
					ОтмеченныеОбъекты.Добавить(ОбъектГруппы.ПолноеИмяМетаданных);
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ОтмеченныеОбъекты;
	
КонецФункции

&НаСервере
Процедура СнятьОтметкиСОтмеченныхОбъектовМетаданных()
	
	Для Каждого Корень Из ДеревоМетаданных.ПолучитьЭлементы() Цикл
		
		Если Корень.Пометка > 0 Тогда
			Корень.Пометка = 0;
		Иначе
			Продолжить;
		КонецЕсли;
		
		Для Каждого Группа Из Корень.ПолучитьЭлементы() Цикл
			
			Если Группа.Пометка > 0 Тогда
				Группа.Пометка = 0;
			Иначе
				Продолжить;
			КонецЕсли;
			
			Для Каждого ОбъектГруппы Из Группа.ПолучитьЭлементы() Цикл
				
				Если ОбъектГруппы.Пометка > 0 Тогда
					ОбъектГруппы.Пометка = 0;
				Иначе
					Продолжить;
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

