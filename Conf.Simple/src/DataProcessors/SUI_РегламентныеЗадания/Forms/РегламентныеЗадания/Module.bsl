	ИначеЕсли Не ТекДанные.Установлено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Регламентное задание не установлено!'"));
	Иначе
		
		Оповещение = Новый ОписаниеОповещения("ЗапуститьРегламентноеЗаданиеПодтверждение", ЭтотОбъект, ТекДанные);
		
		ЗаголовокВопроса = НСтр("ru = 'Запуск регламентного задания'");
		
		ТекстВопроса = НСтр("ru = 'Вы действительно хотите запустить регламентное задание ""%1""?'");
		ТекстВопроса = СтрШаблон(ТекстВопроса, ТекДанные.Наименование);
		
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , , ЗаголовокВопроса);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьРегламентноеЗаданиеПодтверждение(Ответ, ТекДанные) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыЗапуска = SUI_РегламентныеЗаданияКлиентСервер.ПараметрыОкнаЗапускаРегламентногоЗадания(
		ТекДанные.Ключ, ТекДанные.УникальныйИдентификатор);
	ПараметрыЗапуска.ОжидатьЗавершения = Ложь;
	ПараметрыЗапуска.ТолькоИспользуемые = Ложь;
	ПараметрыЗапуска.ЗакрытьПриОшибке = Ложь;
	ПараметрыЗапуска.ЗакрытьПриУспешномЗавершении = Ложь;
	
	Оповещение = Новый ОписаниеОповещения("ЗапуститьРегламентноеЗаданиеЗавершение", ЭтотОбъект, ТекДанные);
	
	SUI_РегламентныеЗаданияКлиент.ЗапуститьРегламентноеЗаданиеВручную(ПараметрыЗапуска, ЭтотОбъект, Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьРегламентноеЗаданиеЗавершение(РезультатЗапуска, ТекущиеДанныеПриЗапуске) Экспорт
	
	ПодключитьОбработчикОжидания("ВыполнитьОбновлениеСпискаРегламентныхЗаданий", 1, Истина);
	
КонецПроцедуры

#КонецОбласти

#Область ОстановитьРегламентноеЗадание

&НаКлиенте
Процедура ОстановитьРегламентноеЗаданиеНаКлиенте()
	
	ТекДанные = Элементы.ТаблицаРегламентныеЗадания.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите регламентное задание!'"));
	ИначеЕсли Не ТекДанные.Установлено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Регламентное задание не установлено!'"));
	Иначе
		
		Оповещение = Новый ОписаниеОповещения("ОстановитьРегламентноеЗаданиеПодтверждение", ЭтотОбъект, ТекДанные);
		
		ЗаголовокВопроса = НСтр("ru = 'Остановка регламентного задания'");
		
		ТекстВопроса = НСтр("ru = 'Вы действительно хотите остановить выполение регламентного задания ""%1""?'");
		ТекстВопроса = СтрШаблон(ТекстВопроса, ТекДанные.Наименование);
		
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , , ЗаголовокВопроса);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОстановитьРегламентноеЗаданиеПодтверждение(Ответ, ТекДанные) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПараметрыТекущейСтрокиПередВызовом(ТекДанные);
	
	ТекстОписанияДлительнойОперации = НСтр("ru = 'Остановка выполнения регламентного задания ""%1""'");
	ТекстОписанияДлительнойОперации = СтрШаблон(ТекстОписанияДлительнойОперации, ТекДанные.Наименование);
	ОтобразитьДлительнуюОперацию(ТекстОписанияДлительнойОперации);
	
	ПодключитьОбработчикОжидания("ОстановитьРегламентноеЗаданиеПродолжить", 0.1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ОстановитьРегламентноеЗаданиеПродолжить() Экспорт
	
	ДанныеСтрокиПриВызове = ПолучитьПараметрыТекущейСтрокиПослеВызова("ОстановитьРегламентноеЗаданиеПродолжить");
	
	Результат = ОстановитьРегламентноеЗаданиеНаСервере(ДанныеСтрокиПриВызове.Ключ, 
		ДанныеСтрокиПриВызове.УникальныйИдентификатор);
	
	Если Результат.Выполнено Тогда
		ПодключитьОбработчикОжидания("ОстановитьРегламентноеЗаданиеЗавершение", 2, Истина);
	ИначеЕсли Не ПустаяСтрока(Результат.Ошибка) Тогда
		ПоказатьПредупреждение(, Результат.Ошибка);
		СкрытьДлительнуюОперацию();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОстановитьРегламентноеЗаданиеЗавершение() Экспорт
	
	Оповещение = Новый ОписаниеОповещения("ОстановитьРегламентноеЗаданиеЗавершениеПослеОбновленияСписка", ЭтотОбъект);
	
	Контекст = Новый Структура();
	Контекст.Вставить("ОповещениеОЗавершении", Оповещение);
	
	ОбновитьСписокРегламентныхЗаданийНаКлиенте(Контекст);
	
КонецПроцедуры

&НаКлиенте
Процедура ОстановитьРегламентноеЗаданиеЗавершениеПослеОбновленияСписка(Результат, Контекст) Экспорт
	
	СкрытьДлительнуюОперацию();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОстановитьРегламентноеЗаданиеНаСервере(Ключ, УникальныйИдентификатор)
	
	Результат = Новый Структура();
	Результат.Вставить("Выполнено", Ложь);
	Результат.Вставить("Ошибка", "");
	
	Попытка
		
		ПараметрыОстановки = Новый Структура();
		ПараметрыОстановки.Вставить("Ключ", Ключ);
		ПараметрыОстановки.Вставить("УникальныйИдентификатор", УникальныйИдентификатор);
		
		SUI_РегламентныеЗадания.ОтменитьВыполнениеРегламентногоЗадания(ПараметрыОстановки);
		
		Результат.Выполнено = Истина;
		
	Исключение
		Результат.Ошибка = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ПросмотрОшибкиРегламентногозадания

&НаКлиенте
Процедура ОткрытьПросмотрОшибкиНаКлиенте()
	
	ТекДанные = Элементы.ТаблицаРегламентныеЗадания.ТекущиеДанные;
	
	ТекДанные = Элементы.ТаблицаРегламентныеЗадания.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите регламентное задание!'"));
	ИначеЕсли Не ТекДанные.Установлено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Регламентное задание не установлено!'"));
	ИначеЕсли Не ЗначениеЗаполнено(ТекДанные.КраткоеПредставлениеОшибки) И 
		Не ЗначениеЗаполнено(ТекДанные.ПодробноеПредставлениеОшибки) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Отсутствуют данные об ошибке для просмотра!'"));
	Иначе
		
		ПараметрыПросмотраОшибки = Новый Структура();
		ПараметрыПросмотраОшибки.Вставить("КраткоеПредставлениеОшибки", ТекДанные.КраткоеПредставлениеОшибки);
		ПараметрыПросмотраОшибки.Вставить("ПодробноеПредставлениеОшибки", ТекДанные.ПодробноеПредставлениеОшибки);
		ПараметрыПросмотраОшибки.Вставить("ПредставлениеРегламентногоЗадания", ТекДанные.Наименование);
		
		ОткрытьФорму("Обработка.SUI_РегламентныеЗадания.Форма.ПросмотрОшибки", 
			ПараметрыПросмотраОшибки, ЭтотОбъект, УникальныйИдентификатор);
		
	КонецЕсли;
	
КонецПроцедуры

