КонецПроцедуры

&НаКлиенте
Процедура ОткрытьЖурналРегистрации(Команда)
	
	ТекущиеДанные = Элементы.ТаблицаРегламентныеЗадания.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите регламентное задание.'"));
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекущиеДанные.ПоследнийЗапускНачало) И Не ЗначениеЗаполнено(ТекущиеДанные.ПоследнийЗапускКонец) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Нет событий для просмотра, так как регламентное задание не выполнялось.'"));
		Возврат;
	КонецЕсли;
	
	ОтборСобытий = Новый Структура;
	ОтборСобытий.Вставить("ДатаНачала", ТекущиеДанные.ПоследнийЗапускНачало);
	
	Если ЗначениеЗаполнено(ТекущиеДанные.ПоследнийЗапускКонец) Тогда
		ОтборСобытий.Вставить("ДатаОкончания", ТекущиеДанные.ПоследнийЗапускКонец);
	КонецЕсли;
	
	ОтборСобытий.Вставить("Данные", ТекущиеДанные.Ключ);
	
	ЖурналРегистрацииКлиент.ОткрытьЖурналРегистрации(ОтборСобытий, ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОтобразитьДлительнуюОперацию(Описание)
	
	Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаДлительнойОперации;
	Элементы.ОписаниеДлительнойОперации.Заголовок = Описание;
	
КонецПроцедуры

&НаКлиенте
Процедура СкрытьДлительнуюОперацию()
	
	Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаТаблицаРегламентныхЗаданий;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПараметрыТекущейСтрокиПередВызовом(ТекущиеДанные) Экспорт
	
	Если ТекущиеДанные = Неопределено Тогда
		ПараметрыТекущейСтрокиТаблицыПередВызовом = Неопределено;
	Иначе
		
		ПараметрыТекущейСтрокиТаблицыПередВызовом = Новый Структура();
		ПараметрыТекущейСтрокиТаблицыПередВызовом.Вставить("Ключ", ТекущиеДанные.Ключ);
		ПараметрыТекущейСтрокиТаблицыПередВызовом.Вставить("УникальныйИдентификатор", ТекущиеДанные.УникальныйИдентификатор);
		ПараметрыТекущейСтрокиТаблицыПередВызовом.Вставить("Наименование", ТекущиеДанные.Наименование);
		
		ПараметрыТекущейСтрокиТаблицыПередВызовом = Новый ФиксированнаяСтруктура(ПараметрыТекущейСтрокиТаблицыПередВызовом);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьПараметрыТекущейСтрокиПослеВызова(КонтекстВызова = "", ВызыватьИсключение = Истина, Сбрасывать = Истина)
	
	Результат = Неопределено;
	
	ТипПараметровТекущейСтроки = ТипЗнч(ПараметрыТекущейСтрокиТаблицыПередВызовом);
	
	Если ТипПараметровТекущейСтроки = Тип("ФиксированнаяСтруктура") Тогда
		Результат = ОбщегоНазначенияКлиент.СкопироватьРекурсивно(ПараметрыТекущейСтрокиТаблицыПередВызовом);
	Иначе
		ОбщегоНазначенияКлиентСервер.Проверить(Не ВызыватьИсключение,
			НСтр("ru = 'Не установлены параметры текущей строки'"), КонтекстВызова);
	КонецЕсли;
	
	Если Сбрасывать Тогда
		УстановитьПараметрыТекущейСтрокиПередВызовом(Неопределено);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#Область ОбновитьСписокРегламентныхЗаданий

&НаКлиенте
Процедура ВыполнитьОбновлениеСпискаРегламентныхЗаданий() Экспорт
	
	ОбновитьСписокРегламентныхЗаданийНаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписокРегламентныхЗаданийНаКлиенте(Контекст = Неопределено)
	
	УстановитьПараметрыТекущейСтрокиПередВызовом(Элементы.ТаблицаРегламентныеЗадания.ТекущиеДанные);
	
	ДлительнаяОперация = ОбновитьСписокРегламентныхЗаданийНаСервере();
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.Заголовок = НСтр("ru = 'Получение списка регламентных заданий'");
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ОбновитьСписокРегламентныхЗаданийЗавершениеНаКлиенте", 
		ЭтотОбъект, Контекст);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания);
	
КонецПроцедуры

&НаСервере
Функция ОбновитьСписокРегламентныхЗаданийНаСервере()
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	Возврат ДлительныеОперации.ВыполнитьВФоне("SUI_РегламентныеЗадания.ПолучитьРегламентныеЗадания", 
		Неопределено, ПараметрыВыполнения);
	
КонецФункции

&НаКлиенте
Процедура ОбновитьСписокРегламентныхЗаданийЗавершениеНаКлиенте(Результат, Контекст) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Сообщения <> Неопределено Тогда
		
		Для индекс = 0 По Результат.Сообщения.ВГраница() Цикл
			Результат.Сообщения[индекс].Сообщить();
		КонецЦикла;
		
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		
		ПоказатьПредупреждение(, Результат.КраткоеПредставлениеОшибки);
		
	ИначеЕсли Результат.Статус = "Выполнено" Тогда
		
		ОбновитьСписокРегламентныхЗаданийЗавершениеНаСервере(Результат.АдресРезультата);
		
		Для Каждого ЭлементТаблицыРегламентныеЗадания Из ТаблицаРегламентныеЗадания Цикл
			
			ОбновитьДополнительныеДанныеВСтрокеТаблицы(ЭлементТаблицыРегламентныеЗадания);
			
		КонецЦикла;
		
		ДанныеСтрокиПриВызове = ПолучитьПараметрыТекущейСтрокиПослеВызова("ОбновитьСписокРегламентныхЗаданийЗавершениеНаКлиенте", Ложь);
		
		Если ДанныеСтрокиПриВызове <> Неопределено Тогда
			
			ТекущийОтбор = Новый Структура("Ключ, УникальныйИдентификатор");
			ЗаполнитьЗначенияСвойств(ТекущийОтбор, ДанныеСтрокиПриВызове);
			
			НайденныеСтроки = ТаблицаРегламентныеЗадания.НайтиСтроки(ТекущийОтбор);
			
			Если НайденныеСтроки.Количество() = 0 Тогда
				ТекущийОтбор.Удалить("УникальныйИдентификатор");
				НайденныеСтроки = ТаблицаРегламентныеЗадания.НайтиСтроки(ТекущийОтбор);
			КонецЕсли;
			
			Если НайденныеСтроки.Количество() > 0 Тогда
				Элементы.ТаблицаРегламентныеЗадания.ТекущаяСтрока = НайденныеСтроки[0].ПолучитьИдентификатор();
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТипЗнч(Контекст) = Тип("Структура") Тогда
		
		Если Контекст.Свойство("ОповещениеОЗавершении") Тогда
			ВыполнитьОбработкуОповещения(Контекст.ОповещениеОЗавершении, (Результат.Статус = "Выполнено"));
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСписокРегламентныхЗаданийЗавершениеНаСервере(АдресТаблицы)
	
	РегламентныеЗаданияТаблица = ПолучитьИзВременногоХранилища(АдресТаблицы);
	
	РегламентныеЗаданияТаблица.Колонки.Добавить("ПредставлениеОшибки", ОбщегоНазначения.ОписаниеТипаСтрока(0));
	РегламентныеЗаданияТаблица.Колонки.Добавить("ПредставлениеСообщений", ОбщегоНазначения.ОписаниеТипаСтрока(0));
	РегламентныеЗаданияТаблица.Колонки.Добавить("КартинкаРасписание", 
		ОбщегоНазначения.ОписаниеТипаЧисло(1, , ДопустимыйЗнак.Неотрицательный));
	РегламентныеЗаданияТаблица.Колонки.Добавить("КартинкаОшибка", 
		ОбщегоНазначения.ОписаниеТипаЧисло(1, , ДопустимыйЗнак.Неотрицательный));
	РегламентныеЗаданияТаблица.Колонки.Добавить("КартинкаСообщения", 
		ОбщегоНазначения.ОписаниеТипаЧисло(1, , ДопустимыйЗнак.Неотрицательный));
	
	ЗначениеВРеквизитФормы(РегламентныеЗаданияТаблица, "ТаблицаРегламентныеЗадания");
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДополнительныеДанныеВСтрокеТаблицы(ТекущиеДанные)
	
	Если Не ПустаяСтрока(ТекущиеДанные.КраткоеПредставлениеОшибки) Тогда
		ТекущиеДанные.ПредставлениеОшибки = ТекущиеДанные.КраткоеПредставлениеОшибки;
	ИначеЕсли Не ПустаяСтрока(ТекущиеДанные.ПодробноеПредставлениеОшибки) Тогда
		ТекущиеДанные.ПредставлениеОшибки = ТекущиеДанные.ПодробноеПредставлениеОшибки;
	КонецЕсли;
	
	Если СтрДлина(ТекущиеДанные.ПредставлениеОшибки) > 23 Тогда
		ТекущиеДанные.ПредставлениеОшибки = Лев(ТекущиеДанные.ПредставлениеОшибки, 20) + "...";
	КонецЕсли;
	
	Если ПустаяСтрока(ТекущиеДанные.ПредставлениеОшибки) Тогда
		ТекущиеДанные.КартинкаОшибка = 1;
	КонецЕсли;
	
	Если ТекущиеДанные.СообщенияПользователю.Количество() > 0 Тогда
		ПредставлениеСообщений = СтрШаблон(НСтр("ru = 'Сообщений: %1'"), ТекущиеДанные.СообщенияПользователю.Количество());
	Иначе
		ПредставлениеСообщений = "";
		ТекущиеДанные.КартинкаСообщения = 1;
	КонецЕсли;
	
	ТекущиеДанные.ПредставлениеСообщений = ПредставлениеСообщений;
	
	Если Не ТекущиеДанные.Установлено Тогда
		ТекущиеДанные.ТекущееСостояниеПредставление = "<не установлено>";
	ИначеЕсли Не ТекущиеДанные.Использование Тогда
		ТекущиеДанные.ТекущееСостояниеПредставление = "<выключено>";
	ИначеЕсли ПустаяСтрока(ТекущиеДанные.ТекущееСостояниеПредставление) Тогда
		ТекущиеДанные.ТекущееСостояниеПредставление = "<не определено>";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекущиеДанные.Расписание) Тогда
		
		Если ТекущиеДанные.Установлено Тогда
			ТекущиеДанные.Расписание = НСтр("ru = '<не настроено>'");
		КонецЕсли;
		
		ТекущиеДанные.КартинкаРасписание = 1;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область УстановитьРегламентноеЗадание

&НаКлиенте
Процедура УстановитьРегламентноеЗаданиеНаКлиенте()
	
	ТекДанные = Элементы.ТаблицаРегламентныеЗадания.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите регламентное задание!'"));
	ИначеЕсли ТекДанные.Установлено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Регламентное задание уже установлено!'"));
	Иначе
		
		Оповещение = Новый ОписаниеОповещения("УстановитьРегламентноеЗаданиеПодтверждение", ЭтотОбъект, ТекДанные);
		
		ЗаголовокВопроса = НСтр("ru = 'Установка регламентного задания'");
		
		ТекстВопроса = НСтр("ru = 'Вы действительно хотите установить регламентное задание ""%1""?'");
		ТекстВопроса = СтрШаблон(ТекстВопроса, ТекДанные.Наименование);
		
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , , ЗаголовокВопроса);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьРегламентноеЗаданиеПодтверждение(Ответ, ТекДанные) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Результат = УстановитьРегламентноеЗаданиеНаСервере(ТекДанные.Ключ);
	
	Если Результат.Выполнено Тогда
		
		ПараметрыСозданногоЗадания = Новый Структура();
		ПараметрыСозданногоЗадания.Вставить("Ключ", ТекДанные.Ключ);
