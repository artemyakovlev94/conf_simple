
#Область ОписаниеПеременных

&НаКлиенте
Перем ПараметрыТекущейСтрокиТаблицыПередВызовом;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	SUI_РегламентныеЗадания.ВыполнитьПроверкуПрав(Отказ, Ложь);
	
	ПризнакОтображенияНеУстановленныхЗаданий = SUI_РегламентныеЗадания.ПолучитьПризнакОтображенияНеУстановленныхЗаданий();
	
	Если ПризнакОтображенияНеУстановленныхЗаданий = Неопределено Тогда
		Элементы.ТаблицаРегламентныеЗаданияОтображатьНеУстановленные.Пометка = Истина;
	Иначе
		Элементы.ТаблицаРегламентныеЗаданияОтображатьНеУстановленные.Пометка = ПризнакОтображенияНеУстановленныхЗаданий;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОтображатьНеУстановленныеНаКлиенте();
	
	ПодключитьОбработчикОжидания("ВыполнитьОбновлениеСпискаРегламентныхЗаданий", 0.1, Истина);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТаблицаРегламентныеЗадания

&НаКлиенте
Процедура ТаблицаРегламентныеЗаданияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекДанные = Элемент.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	ИначеЕсли Не ТекДанные.Установлено Тогда
		УстановитьРегламентноеЗаданиеНаКлиенте();
	Иначе
		
		Если Поле.Имя = "ТаблицаРегламентныеЗаданияРасписание" И
			ЗначениеЗаполнено(ТекДанные.Расписание) Тогда
			НастроитьРасписаниеНаКлиенте();
		ИначеЕсли Поле.Имя = "ТаблицаРегламентныеЗаданияПредставлениеОшибки" И
			Не ПустаяСтрока(ТекДанные.ПредставлениеОшибки) Тогда
			ОткрытьПросмотрОшибкиНаКлиенте();
		ИначеЕсли Поле.Имя = "ТаблицаРегламентныеЗаданияПредставлениеСообщений" И 
			Не ПустаяСтрока(ТекДанные.ПредставлениеСообщений) Тогда
			ОткрытьПросмотрСообщенийНаКлиенте();
		ИначеЕсли Не ТекДанные.Использование Тогда
			ВключитьРегламентноеЗаданиеНаКлиенте();
		Иначе
			ЗапуститьРегламентноеЗаданиеНаКлиенте();
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

