
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныйПрограммныйИнтерфейс

Процедура СформироватьФайлОбращения(Параметры, АдресРезультата) Экспорт
	
	Отчет = Новый Соответствие();
	Отчет.Вставить("time", ТекущаяДатаСеанса());
	Отчет.Вставить("message", Параметры.Сообщение);
	
	КаталогОтчета = ФайловаяСистема.СоздатьВременныйКаталог();
	
	Попытка
		
		УстановитьПривилегированныйРежим(Истина);
		
		ДополнитьИнформациейОКлиенте(Отчет);
		ДополнитьИнформациейОКонфигурации(Отчет);
		ДополнитьИнформациейОДанныхРасширения(Отчет);
		
		УстановитьПривилегированныйРежим(Ложь);	
		
		ДополнитьИнформациейОМобильномПриложении(Отчет, Параметры);
		ДополнитьИнформацийОСобытияхЖурналаРегистрации(Отчет, Параметры);
		ДополнитьИнформацийОВложениях(Отчет, Параметры, КаталогОтчета);
		ДополнитьИнформацийОЛогированииHTTPЗапросов(Отчет, Параметры, КаталогОтчета);
		
		ПутьКФайлуОтчета = SUI_ОбщегоНазначенияКлиентСервер.ОбъединитьПути(КаталогОтчета, "report.json");
		
		ЗаписьJSON = Новый ЗаписьJSON();
		ЗаписьJSON.ОткрытьФайл(ПутьКФайлуОтчета, , , Новый ПараметрыЗаписиJSON(, Символы.Таб));
		ЗаписатьJSON(ЗаписьJSON, Отчет, , "ПреобразованиеJSON", Обработки.SUI_ОбращениеВТехническуюПоддержку);
		ЗаписьJSON.Закрыть();
		
		ФайлАрхив = Новый ЗаписьZipФайла();
		ФайлАрхив.Добавить(SUI_ОбщегоНазначенияКлиентСервер.ОбъединитьПути(КаталогОтчета, "*.*"), 
			РежимСохраненияПутейZIP.СохранятьОтносительныеПути, 
			РежимОбработкиПодкаталоговZIP.ОбрабатыватьРекурсивно);
		ФайлАрхив = ФайлАрхив.ПолучитьДвоичныеДанные(, , МетодСжатияZIP.Сжатие, УровеньСжатияZIP.Максимальный);
		
		ПоместитьВоВременноеХранилище(ФайлАрхив, АдресРезультата);
		
		ФайловаяСистема.УдалитьВременныйКаталог(КаталогОтчета);
		КаталогОтчета = Неопределено;
		
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Если ЗначениеЗаполнено(КаталогОтчета) Тогда
			ФайловаяСистема.УдалитьВременныйКаталог(КаталогОтчета);
		КонецЕсли;
		SUI_ЖурналРегистрации.ЗаписьВЖурналРегистрации("", , , , Ошибка);
		ТекстОшибки = НСтр("ru = 'Не удалось сформировать обращение в техническую поддержку!'");
		ВызватьИсключение(ТекстОшибки, , , , Ошибка);
	КонецПопытки;
	
КонецПроцедуры

Функция ПреобразованиеJSON(Свойство, Значение, ДополнительныеПараметры, Отказ) Экспорт
	
	ТипЗначения = ТипЗнч(Значение);
	
	Если ТипЗначения = Тип("Null") Тогда
		Значение = Неопределено;
	ИначеЕсли ТипЗначения <> Тип("Строка") И ТипЗначения <> Тип("Число") И 
		ТипЗначения <> Тип("Дата") И ТипЗначения <> Тип("Булево") Тогда
		Значение = Строка(Значение);
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьКаталогВоВременномКаталоге(ВременныйКаталог, Имя)
	
	Путь = Новый Структура();
	Путь.Вставить("Относительный", Имя);
	Путь.Вставить("Абсолютный", SUI_ОбщегоНазначенияКлиентСервер.ОбъединитьПути(ВременныйКаталог, Путь.Относительный));
	
	СоздатьКаталог(Путь.Абсолютный);
	
	Файл = Новый Файл(Путь.Абсолютный);
	SUI_ОбщегоНазначенияКлиентСервер.Проверить(Файл.Существует() И Файл.ЭтоКаталог(), 
		СтрШаблон(НСтр("ru = 'Не удалось инициализировать временный каталог (%1)'"), Путь.Относительный));
	
	Возврат Путь;
	
КонецФункции

Процедура ДополнитьИнформациейОМобильномПриложении(Отчет, Параметры)
	
	ИнформацияОМобильномПриложении = Новый Соответствие();
	ИнформацияОМобильномПриложении.Вставить("version", Параметры.МобильноеПриложение.Версия);
	ИнформацияОМобильномПриложении.Вставить("configuration", Параметры.МобильноеПриложение.Конфигурация);
	ИнформацияОМобильномПриложении.Вставить("configurationVersion", Параметры.МобильноеПриложение.ВерсияКонфигурации);
	
	Отчет.Вставить("mobileInfo", ИнформацияОМобильномПриложении);
	
КонецПроцедуры

Процедура ДополнитьИнформациейОКлиенте(Отчет)
	
	СистемнаяИнформация = Новый СистемнаяИнформация();
	
	ИнформацияОКлиенте = Новый Соответствие();
	ИнформацияОКлиенте.Вставить("platformType", Строка(СистемнаяИнформация.ТипПлатформы));
	ИнформацияОКлиенте.Вставить("appVersion", СистемнаяИнформация.ВерсияПриложения);
	ИнформацияОКлиенте.Вставить("processor", СистемнаяИнформация.Процессор);
	ИнформацияОКлиенте.Вставить("RAM", СистемнаяИнформация.ОперативнаяПамять);
	ИнформацияОКлиенте.Вставить("osVersion", СистемнаяИнформация.ВерсияОС);
	
	Отчет.Вставить("clientInfo", ИнформацияОКлиенте);
	
КонецПроцедуры

Процедура ДополнитьИнформациейОКонфигурации(Отчет)
	
	ИнформацияОКонфигурации = Новый Соответствие();
	ИнформацияОКонфигурации.Вставить("name", Метаданные.Имя);
	ИнформацияОКонфигурации.Вставить("view", Метаданные.Синоним);
	ИнформацияОКонфигурации.Вставить("version", Метаданные.Версия);
	ИнформацияОКонфигурации.Вставить("edition", SUI_ОбщегоНазначения.РедакцияКонфигурации());
	ИнформацияОКонфигурации.Вставить("compatibilityMode", СтандартныеПодсистемыСервер.ВерсияРежимаСовместимости());
	ИнформацияОКонфигурации.Вставить("provider", Метаданные.Поставщик);
	ИнформацияОКонфигурации.Вставить("copyright", Метаданные.АвторскиеПрава);
	ИнформацияОКонфигурации.Вставить("addressConfiguration", Метаданные.АдресИнформацииОКонфигурации);
	ИнформацияОКонфигурации.Вставить("addressSupplier", Метаданные.АдресИнформацииОПоставщике);
	ИнформацияОКонфигурации.Вставить("summaryInformation", Метаданные.КраткаяИнформация);
	ИнформацияОКонфигурации.Вставить("detailedInformation", Метаданные.ПодробнаяИнформация);
	
	ДополнитьИнформациейОРасширениях(ИнформацияОКонфигурации);
	ДополнитьИнформациейОПодсистемах(ИнформацияОКонфигурации);
	
	Отчет.Вставить("configInfo", ИнформацияОКонфигурации);
	
КонецПроцедуры

Процедура ДополнитьИнформациейОРасширениях(Отчет)
	
	ИнформацияОРасширениях = Новый Массив();
	
	ОписанияРасширений = РасширенияКонфигурации.Получить();
	ИнформацияОПроблемахРасширений = РасширенияКонфигурации.ПолучитьИнформациюОПроблемахПримененияВСеансе();
	
	Для Каждого ОписаниеРасширенияКонфигурации Из ОписанияРасширений Цикл
		
		ХешСумма = SUI_ОбщегоНазначения.КонтрольнаяСуммаСтрокой(ОписаниеРасширенияКонфигурации.ХешСумма);
		ИнформацияОРасширении = Новый Соответствие();
		ИнформацияОРасширении.Вставить("id", ОписаниеРасширенияКонфигурации.УникальныйИдентификатор);
		ИнформацияОРасширении.Вставить("name", ОписаниеРасширенияКонфигурации.Имя);
		ИнформацияОРасширении.Вставить("view", ОписаниеРасширенияКонфигурации.Синоним);
		ИнформацияОРасширении.Вставить("version", ОписаниеРасширенияКонфигурации.Версия);
		ИнформацияОРасширении.Вставить("enabled", ОписаниеРасширенияКонфигурации.Активно);
		ИнформацияОРасширении.Вставить("safeMode", ОписаниеРасширенияКонфигурации.БезопасныйРежим);
		ИнформацияОРасширении.Вставить("purpose", Строка(ОписаниеРасширенияКонфигурации.Назначение));
		ИнформацияОРасширении.Вставить("useBasicRolesForAllUsers", ОписаниеРасширенияКонфигурации.ИспользоватьОсновныеРолиДляВсехПользователей);
		ИнформацияОРасширении.Вставить("usedInDistributed", ОписаниеРасширенияКонфигурации.ИспользуетсяВРаспределеннойИнформационнойБазе);
		ИнформацияОРасширении.Вставить("hashSum", ХешСумма);
		
		Если ОписаниеРасширенияКонфигурации.ИзменяетСтруктуруДанных() Тогда
			ИнформацияОРасширении.Вставить("modifiesStructureMetadata", Истина);
		Иначе
			ИнформацияОРасширении.Вставить("modifiesStructureMetadata", Ложь);
		КонецЕсли;
		
		ЗащитаОтОпасныхДействий = ОписаниеРасширенияКонфигурации.ЗащитаОтОпасныхДействий.ПредупреждатьОбОпасныхДействиях;
		ИнформацияОРасширении.Вставить("protectionDangerousActions", ЗащитаОтОпасныхДействий);
		
		ОшибкиПрименения = Новый Массив();
		
		Для индекс = 0 По ИнформацияОПроблемахРасширений.ВГраница() Цикл
			
			Если ИнформацияОПроблемахРасширений[индекс].Расширение.УникальныйИдентификатор = ОписаниеРасширенияКонфигурации.УникальныйИдентификатор Тогда
				
				ОшибкаПрименения = Новый Соответствие();
				ОшибкаПрименения.Вставить("category", Строка(ИнформацияОПроблемахРасширений[индекс].Важность));
				ОшибкаПрименения.Вставить("error", ИнформацияОПроблемахРасширений[индекс].Описание);
				
				ОшибкиПрименения.Добавить(ОшибкаПрименения);
				
			КонецЕсли;
			
		КонецЦикла;
		
		ИнформацияОРасширении.Вставить("errors", ОшибкиПрименения);
		
		ИнформацияОРасширениях.Добавить(ИнформацияОРасширении);
		
	КонецЦикла;
	
	Отчет.Вставить("extentions", ИнформацияОРасширениях);
	
КонецПроцедуры

Процедура ДополнитьИнформациейОПодсистемах(Отчет)
	
	ИнформацияОПодсистемах = Новый Массив();
	
	ОписанияПодсистем = ОбщегоНазначения.ОписанияПодсистем();
	
	Для индекс = 0 По ОписанияПодсистем.ВГраница() Цикл
		
		ИнформацияОПодсистеме = Новый Соответствие();
		ИнформацияОПодсистеме.Вставить("name", ОписанияПодсистем[индекс].Имя);
		ИнформацияОПодсистеме.Вставить("version", ОписанияПодсистем[индекс].Версия);
		
		ИнформацияОПодсистемах.Добавить(ИнформацияОПодсистеме);
		
	КонецЦикла;
	
	Отчет.Вставить("subsystems", ИнформацияОПодсистемах);
	
КонецПроцедуры

