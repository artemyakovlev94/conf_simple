		|	SUI_ИспользоватьТаблицу_ХарактеристикиНоменклатуры.Значение КАК ХарактеристикиНоменклатуры,
		|	SUI_ИспользоватьТаблицу_ШаблоныЭтикеток.Значение КАК ШаблоныЭтикеток,
		|	SUI_ИспользоватьТаблицу_ШтрихкодыНоменклатуры.Значение КАК ШтрихкодыНоменклатуры,
		|	SUI_ИспользоватьТаблицу_ШтрихкодыУпаковок.Значение КАК ШтрихкодыУпаковок,
		|	SUI_ИспользоватьТаблицу_Ячейки.Значение КАК Ячейки
		|ИЗ
		|	Константа.SUI_ИспользоватьТаблицу_Контрагенты КАК SUI_ИспользоватьТаблицу_Контрагенты,
		|	Константа.SUI_ИспользоватьТаблицу_Номенклатура КАК SUI_ИспользоватьТаблицу_Номенклатура,
		|	Константа.SUI_ИспользоватьТаблицу_ПользователиТСД КАК SUI_ИспользоватьТаблицу_ПользователиТСД,
		|	Константа.SUI_ИспользоватьТаблицу_СерииНоменклатуры КАК SUI_ИспользоватьТаблицу_СерииНоменклатуры,
		|	Константа.SUI_ИспользоватьТаблицу_Склады КАК SUI_ИспользоватьТаблицу_Склады,
		|	Константа.SUI_ИспользоватьТаблицу_УпаковкиНоменклатуры КАК SUI_ИспользоватьТаблицу_УпаковкиНоменклатуры,
		|	Константа.SUI_ИспользоватьТаблицу_ХарактеристикиНоменклатуры КАК SUI_ИспользоватьТаблицу_ХарактеристикиНоменклатуры,
		|	Константа.SUI_ИспользоватьТаблицу_ШаблоныЭтикеток КАК SUI_ИспользоватьТаблицу_ШаблоныЭтикеток,
		|	Константа.SUI_ИспользоватьТаблицу_ШтрихкодыНоменклатуры КАК SUI_ИспользоватьТаблицу_ШтрихкодыНоменклатуры,
		|	Константа.SUI_ИспользоватьТаблицу_ШтрихкодыУпаковок КАК SUI_ИспользоватьТаблицу_ШтрихкодыУпаковок,
		|	Константа.SUI_ИспользоватьТаблицу_Ячейки КАК SUI_ИспользоватьТаблицу_Ячейки";
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	ИнформацияОДанныхРасширения = Новый Массив();
	
	Выборка = РезультатыЗапроса[0].Выбрать();
	Выборка.Следующий();
	
	Для Каждого Колонка Из РезультатыЗапроса[0].Колонки Цикл
		
		ИнформацияОДанных = Новый Соответствие();
		ИнформацияОДанных.Вставить("key", Колонка.Имя);
		ИнформацияОДанных.Вставить("value", Выборка[Колонка.Имя]);
		
		ИнформацияОДанныхРасширения.Добавить(ИнформацияОДанных);
		
	КонецЦикла;
	
	Отчет.Вставить("extensionData", ИнформацияОДанныхРасширения);
	
	ИнформацияОбИспользуемыхТаблицах = Новый Массив();
	
	Выборка = РезультатыЗапроса[1].Выбрать();
	Выборка.Следующий();
	
	Для Каждого Колонка Из РезультатыЗапроса[1].Колонки Цикл
		
		ИнформацияОбИспользуемойТаблице = Новый Соответствие();
		ИнформацияОбИспользуемойТаблице.Вставить("name", Колонка.Имя);
		ИнформацияОбИспользуемойТаблице.Вставить("enabled", Выборка[Колонка.Имя]);
		
		ИнформацияОбИспользуемыхТаблицах.Добавить(ИнформацияОбИспользуемойТаблице);
		
	КонецЦикла;
	
	Отчет.Вставить("usedTables", ИнформацияОбИспользуемыхТаблицах);
	
КонецПроцедуры

Процедура ДополнитьИнформацийОВложениях(Отчет, Параметры, КаталогОтчета)
	
	ИнформацияОВложениях = Новый Структура();
	ИнформацияОВложениях.Вставить("dir", "");
	ИнформацияОВложениях.Вставить("rows", Новый Массив());
	
	Вложения = Параметры.Вложения;
	
	Если Вложения.Количество() > 0 Тогда
		
		ИнформацияОВложениях.dir = "attachments";
		ПутьКаталога = СоздатьКаталогВоВременномКаталоге(КаталогОтчета, ИнформацияОВложениях.dir);
		
		Для Каждого Вложение Из Вложения Цикл
			
			ИнформацияОВложении = Новый Соответствие();
			ИнформацияОВложении.Вставить("name", Вложение.Имя);
			ИнформацияОВложении.Вставить("description", Вложение.Описание);
			
			Если ЗначениеЗаполнено(Вложение.Представление) Тогда
				ИнформацияОВложении.Вставить("view", Вложение.Представление);
			Иначе
				ИнформацияОВложении.Вставить("view", Вложение.Имя);
			КонецЕсли;
			
			Если ПустаяСтрока(Вложение.Расширение) Или СтрЗаканчиваетсяНа(Вложение.Имя, Вложение.Расширение) Тогда
				ИмяФайла = Вложение.Имя;
			ИначеЕсли СтрНачинаетсяС(Вложение.Расширение, ".") Тогда
				ИмяФайла = Вложение.Имя + Вложение.Расширение;
			Иначе
				ИмяФайла = Вложение.Имя + "." + Вложение.Расширение;
			КонецЕсли;
			
			ПутьКФайлу = SUI_ОбщегоНазначенияКлиентСервер.ОбъединитьПути(ПутьКаталога.Абсолютный, ИмяФайла);
			ПутьКФайлу = SUI_ФайловаяСистемаСлужебныйКлиентСервер.УникальноеИмяФайла(ПутьКФайлу);
			
			Вложение.Данные.Записать(ПутьКФайлу);
			
			ФайлВложения = Новый Файл(ПутьКФайлу);
			ИнформацияОВложении.Вставить("file", ФайлВложения.Имя);
			
			ИнформацияОВложениях.rows.Добавить(ИнформацияОВложении);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Отчет.Вставить("attachments", ИнформацияОВложениях);
	
КонецПроцедуры

Процедура ДополнитьИнформацийОСобытияхЖурналаРегистрации(Отчет, Параметры)
	
	ИнформацияОСобытиях = Новый Массив();
	
	События = Параметры.СобытияЖурналаРегистрации;
	
	Для Каждого Событие Из События Цикл
		
		ИнформацияОСобытии = Новый Соответствие();
		ИнформацияОСобытии.Вставить("date", Событие.Дата);
		ИнформацияОСобытии.Вставить("dateServer", Событие.ДатаНаСервере);
		ИнформацияОСобытии.Вставить("level", Событие.Уровень);
		ИнформацияОСобытии.Вставить("name", Событие.Событие);
		ИнформацияОСобытии.Вставить("view", Событие.ПредставлениеСобытия);
		ИнформацияОСобытии.Вставить("computer", Событие.Компьютер);
		ИнформацияОСобытии.Вставить("server", Событие.РабочийСервер);
		ИнформацияОСобытии.Вставить("port", Событие.ОсновнойIPПорт);
		ИнформацияОСобытии.Вставить("portAdditional", Событие.ВспомогательныйIPПорт);
		ИнформацияОСобытии.Вставить("user", Событие.ИмяПользователя);
		ИнформацияОСобытии.Вставить("app", Событие.ПредставлениеПриложения);
		ИнформацияОСобытии.Вставить("session", Событие.Сеанс);
		ИнформацияОСобытии.Вставить("connection", Событие.Соединение);
		ИнформацияОСобытии.Вставить("metadata", Событие.ПредставлениеМетаданных);
		ИнформацияОСобытии.Вставить("transaction", Событие.Транзакция);
		ИнформацияОСобытии.Вставить("transactionStatus", Событие.СтатусТранзакции);
		ИнформацияОСобытии.Вставить("data", Событие.ПредставлениеДанных);
		ИнформацияОСобытии.Вставить("comment", Событие.Комментарий);
		
		ИнформацияОСобытиях.Добавить(ИнформацияОСобытии);
		
	КонецЦикла;
	
	Отчет.Вставить("logs", ИнформацияОСобытиях);
	
КонецПроцедуры

Процедура ДополнитьИнформацийОЛогированииHTTPЗапросов(Отчет, Параметры, КаталогОтчета)
	
	ИнформацияОЗаписях = Новый Структура();
	ИнформацияОЗаписях.Вставить("dir", "");
	ИнформацияОЗаписях.Вставить("rows", Новый Массив());
	
	ЗаписиЛогирования = Параметры.ЗаписиЛогированияHTTPЗапросов;
	
	Если ЗаписиЛогирования.Количество() > 0 Тогда
		
		ИнформацияОЗаписях.dir = "httpLogs";
		ПутьКаталога = СоздатьКаталогВоВременномКаталоге(КаталогОтчета, ИнформацияОЗаписях.dir);
		
		Для Каждого ЗаписьЛогирования Из ЗаписиЛогирования Цикл
			
			ИнформацияОЗаписи = Новый Соответствие();
			ИнформацияОЗаписи.Вставить("SID", ЗаписьЛогирования.SID);
			ИнформацияОЗаписи.Вставить("date", ЗаписьЛогирования.Период);
			ИнформацияОЗаписи.Вставить("method", ЗаписьЛогирования.Метод);
			ИнформацияОЗаписи.Вставить("statusCode", ЗаписьЛогирования.КодСостояния);
			ИнформацияОЗаписи.Вставить("deviceID", ЗаписьЛогирования.ИдентификаторУстройства);
			ИнформацияОЗаписи.Вставить("session", ЗаписьЛогирования.НомерСеанса);
			ИнформацияОЗаписи.Вставить("timestamp", ЗаписьЛогирования.МеткаВремени);
			ИнформацияОЗаписи.Вставить("url", ЗаписьЛогирования.URL);
			ИнформацияОЗаписи.Вставить("urlRelative", ЗаписьЛогирования.ОтносительныйURL);
			ИнформацияОЗаписи.Вставить("user", ЗаписьЛогирования.ИмяПользователя);
			
			ИмяФайлаЗапроса = "";
			ИмяФайлаОтвета = "";
			
			Если Не ПустаяСтрока(ЗаписьЛогирования.ДанныеЗапроса) Тогда
				
				ИмяФайлаЗапроса = "request" + ЗаписьЛогирования.SID + ".json";
				
				ПутьКФайлуЗапроса = SUI_ОбщегоНазначенияКлиентСервер.ОбъединитьПути(ПутьКаталога.Абсолютный, ИмяФайлаЗапроса);
				ПутьКФайлуЗапроса = SUI_ФайловаяСистемаСлужебныйКлиентСервер.УникальноеИмяФайла(ПутьКФайлуЗапроса);
				
				ФайлЗапроса = Новый Файл(ПутьКФайлуЗапроса);
				ИмяФайлаЗапроса = ФайлЗапроса.Имя;
				
				ЗаписьJSON = Новый ЗаписьJSON();
				ЗаписьJSON.ОткрытьФайл(ФайлЗапроса.ПолноеИмя);
				ЗаписьJSON.ЗаписатьБезОбработки(ЗаписьЛогирования.ДанныеЗапроса);
				ЗаписьJSON.Закрыть();
				
			КонецЕсли;
			
			Если Не ПустаяСтрока(ЗаписьЛогирования.ДанныеОтвета) Тогда
				
				ИмяФайлаОтвета = "response" + ЗаписьЛогирования.SID + ".json";
				
				ПутьКФайлуОтвета = SUI_ОбщегоНазначенияКлиентСервер.ОбъединитьПути(ПутьКаталога.Абсолютный, ИмяФайлаОтвета);
				ПутьКФайлуОтвета = SUI_ФайловаяСистемаСлужебныйКлиентСервер.УникальноеИмяФайла(ПутьКФайлуОтвета);
				
				ФайлОтвета = Новый Файл(ПутьКФайлуОтвета);
				ИмяФайлаОтвета = ФайлОтвета.Имя;
				
				ЗаписьJSON = Новый ЗаписьJSON();
				ЗаписьJSON.ОткрытьФайл(ФайлОтвета.ПолноеИмя);
				ЗаписьJSON.ЗаписатьБезОбработки(ЗаписьЛогирования.ДанныеОтвета);
				ЗаписьJSON.Закрыть();
				
			КонецЕсли;
			
			ИнформацияОЗаписи.Вставить("requestFile", ИмяФайлаЗапроса);
			ИнформацияОЗаписи.Вставить("responseFile", ИмяФайлаОтвета);
			
			ИнформацияОЗаписях.rows.Добавить(ИнформацияОЗаписи);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Отчет.Вставить("httpLogs", ИнформацияОЗаписях);
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
