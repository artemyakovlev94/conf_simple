Процедура ЗаполнитьДеревоНастроек_ИзФайлаВыгрузки(ДеревоНастроек, ДанныеФайла, Область)
	
	ВременныйКаталог = ФайловаяСистема.СоздатьВременныйКаталог();
	РазделительПути = ПолучитьРазделительПути();
	
	Попытка
		
		ФайлАрхив = Новый ЧтениеZipФайла(ДанныеФайла.ОткрытьПотокДляЧтения());
		ФайлАрхив.ИзвлечьВсе(ВременныйКаталог, РежимВосстановленияПутейФайловZIP.Восстанавливать);
		ФайлАрхив.Закрыть();
		
		КонфигурационныйФайл = ПрочитатьКонфигурационныйФайлНастроек(ВременныйКаталог);
		
		ОбщегоНазначенияКлиентСервер.Проверить(ЗначениеЗаполнено(КонфигурационныйФайл.Область),
			НСтр("ru = 'Конфигурационный файл настроек поврежден.'"));
		
		ОбщегоНазначенияКлиентСервер.Проверить(Область = КонфигурационныйФайл.Область,
			СтрШаблон(НСтр("ru = 'Файл настроек ""%1"" не принадлежит области настроек ""%2"".'"), 
			КонфигурационныйФайл.Область, Область));
		
		Для Каждого ФайлПриложения Из НайтиФайлы(ВременныйКаталог, "*.json", Истина) Цикл
			
			Если Не ФайлПриложения.ЭтоФайл() Тогда
				Продолжить;
			КонецЕсли;
			
			ПутьКФайлуОбъекту = SUI_ОбщегоНазначенияКлиентСервер.ОбъединитьПути(
				ФайлПриложения.Путь, ФайлПриложения.ИмяБезРасширения);
			
			ФайлОбъект = Новый Файл(ПутьКФайлуОбъекту + ".xml");
			
			Если Не ФайлОбъект.Существует() Тогда
				ФайлОбъект = Новый Файл(ПутьКФайлуОбъекту);
				Если Не ФайлОбъект.Существует() Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			Приложение = ПрочитатьФайлПриложениеКНастройке(ФайлПриложения.ПолноеИмя);
			
			ПутьКФайлуВКаталоге = СтрЗаменить(ПутьКФайлуОбъекту, ВременныйКаталог, "");
			
			ДобавитьДанныеНастройкиВДерево(ДеревоНастроек.Строки, 
				ПутьКФайлуВКаталоге, 
				РазделительПути, 
				СтрЗаменить(ФайлОбъект.ПолноеИмя, ВременныйКаталог, ""),
				Приложение,
				ФайлОбъект.ЭтоКаталог());
		    
		КонецЦикла;
		
		ФайловаяСистема.УдалитьВременныйКаталог(ВременныйКаталог);
		
	Исключение
		SUI_ЖурналРегистрации.ЗаписьВЖурналРегистрации(ИмяСобытия(НСтр("ru = 'Загрузка из файла'")), , 
			Метаданные.Обработки.SUI_ИмпортЭкспортНастроек, , ИнформацияОбОшибке());
		ФайловаяСистема.УдалитьВременныйКаталог(ВременныйКаталог);
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

