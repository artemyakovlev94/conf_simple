&НаКлиенте
Процедура НастройкиПометкаПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.Настройки.ТекущаяСтрока;
		
	Если ТекущаяСтрока <> Неопределено Тогда
		
		ЭлементДерева = Настройки.НайтиПоИдентификатору(ТекущаяСтрока);
		
		ЭлементДерева.Пометка = ЭлементДерева.Пометка % 2;
		
		ПроставитьПометкиВниз(ЭлементДерева);
		ПроставитьПометкиВверх(ЭлементДерева);
		
	КонецЕсли;
		
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПометкиОтметитьВсе(Команда)
	
	Для Каждого ЭлементДерева Из Настройки.ПолучитьЭлементы() Цикл
		ЭлементДерева.Пометка = 1;
		ПроставитьПометкиВниз(ЭлементДерева);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПометкиСнятьВсе(Команда)
	
	Для Каждого ЭлементДерева Из Настройки.ПолучитьЭлементы() Цикл
		ЭлементДерева.Пометка = 0;
		ПроставитьПометкиВниз(ЭлементДерева);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура РазвернутьВсе(Команда)
	
	Если Элементы.Настройки.ТекущиеДанные <> Неопределено Тогда
		Элементы.Настройки.Развернуть(Элементы.Настройки.ТекущаяСтрока, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СвернутьВсе(Команда)
	
	Если Элементы.Настройки.ТекущиеДанные <> Неопределено Тогда
		Элементы.Настройки.Свернуть(Элементы.Настройки.ТекущаяСтрока);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьВФайл(Команда)
	
	ЕстьПометки = Ложь;
	Для Каждого ЭлементДерева Из Настройки.ПолучитьЭлементы() Цикл
		
		Если ЭлементДерева.Пометка > 0 Тогда
			ЕстьПометки = Истина;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЕстьПометки Тогда
		
		ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
		ПараметрыОжидания.Заголовок = НСтр("ru = 'Формирование данных выгружаемых настроек'");
		ПараметрыОжидания.ВыводитьСообщения = Истина;
		
		ОповещениеОЗавершении = Новый ОписаниеОповещения("ВыгрузитьВФайлЗавершениеФормирования", ЭтотОбъект);
		
		ДлительнаяОперация = ВыгрузитьВФайлНаСервере();
		
		ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания);
		
	Иначе
		ПоказатьПредупреждение(, НСтр("ru = 'Не выбраны настройки для выгрузки'"));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзФайла(Команда)
	
	Оповещение = Новый ОписаниеОповещения("ЗагрузитьИзФайлаЗавершениеВыбораФайла", ЭтотОбъект);
	
	ПараметрыЗагрузки = ФайловаяСистемаКлиент.ПараметрыЗагрузкиФайла();
	ПараметрыЗагрузки.ИдентификаторФормы = УникальныйИдентификатор;
	ПараметрыЗагрузки.Диалог.Заголовок = НСтр("ru = 'Выберите файл настроек'");
	ПараметрыЗагрузки.Диалог.МножественныйВыбор = Ложь;
	ПараметрыЗагрузки.Диалог.ПроверятьСуществованиеФайла = Истина;
	ПараметрыЗагрузки.Диалог.Фильтр = "Архив ZIP (*.zip)|*.zip";
	
	ФайловаяСистемаКлиент.ЗагрузитьФайл(Оповещение, ПараметрыЗагрузки);
	
КонецПроцедуры

