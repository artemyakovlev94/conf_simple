&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбластьНастроек = Параметры.ОбластьНастроек;
	
	ОбластиНастроек = Обработки.SUI_ИмпортЭкспортНастроек.ОбластиНастроек();
	
	ИндексКартинкиФайла = Обработки.SUI_ИмпортЭкспортНастроек.ИндексКартинкиФайла();
	
	// Тест >>>
	ОбластьНастроек = ОбластиНастроек[1];
//	Параметры.РежимВыгрузки = Истина;
	// Тест <<<
	
	Если Параметры.РежимВыгрузки Тогда
		Заголовок = СтрШаблон(НСтр("ru = 'Экспорт: %1'"), ОбластьНастроек);
	Иначе
		Заголовок = СтрШаблон(НСтр("ru = 'Импорт: %1'"), ОбластьНастроек);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Элементы.НастройкиВыгрузитьВФайл.Видимость = Параметры.РежимВыгрузки;
	Элементы.НастройкиЗагрузитьИзФайла.Видимость = Не Параметры.РежимВыгрузки;
	Элементы.НастройкиЗагрузитьПредопределенные.Видимость = Не Параметры.РежимВыгрузки;
	
	Элементы.Настройкиdescription.РедактированиеТекста = Параметры.РежимВыгрузки;
	
	ПодключитьОбработчикОжидания("НачатьЗаполнениеДереваНастроекДляВыгрузки", 0.1, Истина);
	
КонецПроцедуры

