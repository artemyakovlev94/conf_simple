			<Value xsi:type="Structure">
				<Property name="Наименование">
					<Value xsi:type="xs:string">Реализация товаров и услуг</Value>
				</Property>
				<Property name="ПометкаУдаления">
					<Value xsi:type="xs:boolean">false</Value>
				</Property>
				<Property name="Используется">
					<Value xsi:type="xs:boolean">true</Value>
				</Property>
				<Property name="ИспользуетсяМаркировка">
					<Value xsi:type="xs:boolean">true</Value>
				</Property>
				<Property name="ПроводитьДокумент">
					<Value xsi:type="xs:boolean">false</Value>
				</Property>
				<Property name="ИмяОбъектаМетаданных">
					<Value xsi:type="xs:string">РеализацияТоваровУслуг</Value>
				</Property>
				<Property name="КонтролироватьДокумент">
					<Value xsi:type="xs:boolean">false</Value>
				</Property>
				<Property name="СостояниеДокументаПоУмолчанию">
					<Value xmlns:d6p1="http://v8.1c.ru/8.1/data/enterprise/current-config" xsi:type="d6p1:EnumRef.SUI_СостоянияДокументовОбмена">Новый</Value>
				</Property>
				<Property name="Предопределенный">
					<Value xsi:type="xs:boolean">false</Value>
				</Property>
				<Property name="НастройкиСхемыКомпоновкиДанных">
					<Value xsi:nil="true"/>
				</Property>
				<Property name="ДополнительныеНастройки">
					<Value xsi:type="Structure">
						<Property name="АлгоритмыОбработкиСтрокТабличныхЧастей">
							<Value xsi:type="Map">
								<pair>
									<Key xmlns:d10p1="http://v8.1c.ru/8.1/data/enterprise/current-config" xsi:type="d10p1:EnumRef.SUI_ТипыТаблицДокументовОбмена">Серии</Key>
									<Value xsi:type="xs:string">Если ДокументОбъект.Склад.ЭтоГруппа ТОгда
	Отбор = Новый Структура(); Отбор.Вставить("Номенклатура", ТекущаяСтрока.Номенклатура); 
	Отбор.Вставить("Характеристика", ТекущаяСтрока.Характеристика); 
	НайденноеЗначение = ДокументОбъект.Товары.НайтиСтроки(Отбор);   
	Если НайденноеЗначение.Количество() Тогда 
		ТекущаяСтрока.Склад = НайденноеЗначение[0].Склад; 
	КонецЕсли;  
КонецЕсли;</Value>
								</pair>
								<pair>
									<Key xmlns:d10p1="http://v8.1c.ru/8.1/data/enterprise/current-config" xsi:type="d10p1:EnumRef.SUI_ТипыТаблицДокументовОбмена">Товары</Key>
									<Value xsi:type="xs:string">СтруктураДействий = Новый Структура;
СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц");
ОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, Неопределено);

мсвСтроки = Новый Массив();
мсвСтроки.Добавить(ТекущаяСтрока);
ПараметрыУказанияСерий = НоменклатураСервер.ПараметрыУказанияСерий(ДокументОбъект, ОбщегоНазначения.ОбщийМодуль("Документы.РеализацияТоваровУслуг"));
НоменклатураСервер.ЗаполнитьСтатусыУказанияСерий(ДокументОбъект, ПараметрыУказанияСерий, мсвСтроки);

</Value>
								</pair>
							</Value>
						</Property>
						<Property name="АлгоритмыОбработкиСозданияДокументаНаОсновании">
							<Value xsi:type="Map"/>
