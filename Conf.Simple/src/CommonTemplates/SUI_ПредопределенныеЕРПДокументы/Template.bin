								<pair>
									<Key xmlns:d10p1="http://v8.1c.ru/8.1/data/enterprise/current-config" xsi:type="d10p1:EnumRef.SUI_ТипыТаблицДокументовОбмена">ШтрихкодыУпаковок</Key>
									<Value xsi:type="xs:string"/>
