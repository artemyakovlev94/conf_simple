							<dcsset:title>SUi_ratio</dcsset:title>
							<dcsset:cases>
								<dcsset:item>
									<dcsset:filter>
										<dcsset:item xsi:type="dcsset:FilterItemComparison">
											<dcsset:left xsi:type="dcscor:Field">Упаковка</dcsset:left>
											<dcsset:comparisonType>Filled</dcsset:comparisonType>
										</dcsset:item>
									</dcsset:filter>
									<dcsset:value xsi:type="dcscor:Field">Упаковка.Коэффициент</dcsset:value>
								</dcsset:item>
								<dcsset:item>
									<dcsset:filter/>
