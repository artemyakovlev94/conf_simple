								<pair>
									<Key xmlns:d10p1="http://v8.1c.ru/8.1/data/enterprise/current-config" xsi:type="d10p1:EnumRef.SUI_ТипыТаблицДокументовОбмена">Серии</Key>
									<Value xsi:type="Structure">
										<Property name="ТипИдентификацииСтроки">
											<Value xmlns:d12p1="http://v8.1c.ru/8.1/data/enterprise/current-config" xsi:type="d12p1:EnumRef.SUI_ТипыИдентификацииСтрокТЧ">ПоСовокупностиРеквизитов</Value>
										</Property>
										<Property name="РеквизитИдентификацииСтроки">
											<Value xsi:type="xs:string"/>
										</Property>
										<Property name="РеквизитыИдентификацииСтроки">
											<Value xsi:type="Array">
												<Value xsi:type="xs:string">Номенклатура</Value>
												<Value xsi:type="xs:string">Серия</Value>
												<Value xsi:type="xs:string">Характеристика</Value>
											</Value>
										</Property>
