									<Value xsi:type="xs:string">ОсобенностьУчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Параметры.ДанныеСтроки.Номенклатура, "ВидНоменклатуры.ОсобенностьУчета");
