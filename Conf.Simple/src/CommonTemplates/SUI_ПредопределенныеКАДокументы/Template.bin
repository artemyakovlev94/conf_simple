мсвСтроки = Новый Массив();
мсвСтроки.Добавить(ТекущаяСтрока);
ПараметрыУказанияСерий = НоменклатураСервер.ПараметрыУказанияСерий(ДокументОбъект, Документы.ПроизводствоБезЗаказа);
НоменклатураСервер.ЗаполнитьСтатусыУказанияСерий(ДокументОбъект, ПараметрыУказанияСерий.ВыходныеИзделия, мсвСтроки)</Value>
