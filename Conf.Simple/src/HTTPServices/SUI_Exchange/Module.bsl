Функция ТестСвязиПолучитьОтвет(Запрос) 
	
	ОтключитьЛогирование = Ложь;
	
	Попытка
		
		ИдентификаторУстройства = SUI_HTTPСервисКлиентСервер.ПолучитьИдентификаторУстройства(Запрос.Заголовки);
		
		Если Не ПустаяСтрока(ИдентификаторУстройства) Тогда
			
			УстановитьПривилегированныйРежим(Истина);
			МобильноеУстройство = ПланыОбмена.SUI_МобильныеУстройства.НайтиПоКоду(ИдентификаторУстройства);
			Если Не МобильноеУстройство.Пустая() Тогда
				ОтключитьЛогирование = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(МобильноеУстройство, "ОтключитьЛогирование");
			КонецЕсли;
			УстановитьПривилегированныйРежим(Ложь);
			
		КонецЕсли;
		
	Исключение
		ОтключитьЛогирование = Ложь;
	КонецПопытки;
	
	Результат = SUI_HTTPСервис.РезультатУспех(Новый Структура("result", Истина));
	
	Ответ = SUI_HTTPСервис.СформироватьHTTPОтвет(Результат, Запрос.Заголовки);
	
	// Логирование HTTP запросов
	ВыполнитьЛогирование(Запрос, Ответ, ОтключитьЛогирование);
	
	Возврат Ответ;
	
КонецФункции

