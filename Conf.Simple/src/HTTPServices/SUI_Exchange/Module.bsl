Функция ПеремещениМеждуЯчейкамиPOST(Запрос)
	
	Перем ДанныеЗапроса;
	УстановитьПривилегированныйРежим(Истина);
	
	Попытка
		
		ПараметрыОбработкиВходящегоЗапроса = SUI_HTTPСервисКлиентСервер.ПараметрыОбработкиВходящегоЗапроса();
		ПараметрыОбработкиВходящегоЗапроса.ПрочитатьПараметрыИзТела = Истина;
		ДанныеЗапроса = SUI_HTTPСервис.ОбработатьВходящийЗапрос(Запрос, ПараметрыОбработкиВходящегоЗапроса);
		
		Если ДанныеЗапроса.РезультатОтвет <> Неопределено Тогда
			Результат = ДанныеЗапроса.РезультатОтвет;
		Иначе
			
			Ячейка = ДанныеЗапроса.Параметры.Получить("id_cell");
			ЯчейкаВерныйТип = (ТипЗнч(Ячейка) = Тип("СправочникСсылка.СкладскиеЯчейки"));
			
			Склад = ДанныеЗапроса.Параметры.Получить("id_warehouse");
			СкладВерныйТип = (ТипЗнч(Склад) = Тип("СправочникСсылка.Склады"));
			
			ПользовательУТ = Справочники.Пользователи.ПустаяСсылка();
			ПользовательТСД = ДанныеЗапроса.Параметры.Получить("user_name");
			
			Если ТипЗнч(ПользовательТСД) = Тип("Строка") И ЗначениеЗаполнено(ПользовательТСД) Тогда 
				
				УчетнаяЗапись = ПользователиИнформационнойБазы.НайтиПоИмени(ПользовательТСД);
				
				Если НЕ УчетнаяЗапись = Неопределено Тогда 
					ПользовательУТ = Справочники.Пользователи.НайтиПоРеквизиту("ИдентификаторПользователяИБ", УчетнаяЗапись.УникальныйИдентификатор);
				КонецЕсли;
				
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Ячейка) Тогда
				
				Если ЯчейкаВерныйТип Тогда 
					
					Если ЗначениеЗаполнено(Склад) И СкладВерныйТип Тогда
						
						БлокироватьЯчейку = (ДанныеЗапроса.Параметры.Получить("block") = "1"); 
						
						Результат = SUI_ОбменДаннымиСервер.ПеремещениеМеждуЯчейкамиЗаблокироватьЯчейку(ДанныеЗапроса.ИдентификаторУстройства, 
							Склад, Ячейка, БлокироватьЯчейку, ПользовательУТ);
						
					Иначе
						Результат = SUI_HTTPСервис.РезультатОшибка("Склад не найден по идентификатору");	
					КонецЕсли;
					
				Иначе
					Результат = SUI_HTTPСервис.РезультатОшибка("Ячейка не найдена по идентификатору");	
				КонецЕсли;
				
			Иначе

				ДокументОтбораРазмещения = ДанныеЗапроса.Параметры.Получить("id_doc"); 
				ДокументОтбораРазмещенияВерныйТип = (ТипЗнч(ДокументОтбораРазмещения) = Тип("ДокументСсылка.ОтборРазмещениеТоваров"));
				
				ТаблицаТоваров = ДанныеЗапроса.Параметры.Получить("RS_adr_docs_table");
				
				Если ТаблицаТоваров = Неопределено Тогда 

					ДополнительноеДействие = ДанныеЗапроса.Параметры.Получить("action"); 
					
					Если ДополнительноеДействие = Неопределено Тогда
						Результат = SUI_HTTPСервис.РезультатОшибка("Неизвестный вид операции");
					ИначеЕсли ДополнительноеДействие = "unblock_cells" Тогда

						Если ЗначениеЗаполнено(ДокументОтбораРазмещения) И ДокументОтбораРазмещенияВерныйТип Тогда 
							Результат = SUI_ОбменДаннымиСервер.ПеремещениеМеждуЯчейкамиРазблокироватьЯчейки(ДокументОтбораРазмещения);
						Иначе
							Результат = SUI_HTTPСервис.РезультатОшибка("Документ не найден по идентификатору");
						КонецЕсли;
						
					ИначеЕсли ДополнительноеДействие = "get_doc_type" Тогда
						
						ЗначениеКонстанты = Константы.SUI_НастройкаДокументаПеремещенияМеждуЯчейками.Получить();
						 
						Если ЗначениеЗаполнено(ЗначениеКонстанты) Тогда
							Результат = SUI_HTTPСервис.РезультатУспех(Новый Структура("doc_type", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗначениеКонстанты, "Наименование")));
						Иначе
							Результат = SUI_HTTPСервис.РезультатОшибка("Не задана настройка документа для перемещения товару между ячейками");
						КонецЕсли;				
						
					Иначе
						Результат = SUI_HTTPСервис.РезультатОшибка("Неизвестный вид операции");
					КонецЕсли;
					
				Иначе
					
					Если ЗначениеЗаполнено(ДокументОтбораРазмещения) Тогда
						Результат = SUI_HTTPСервис.РезультатОшибка("Неизвестный вид операции");			
					Иначе
						
						Если ЗначениеЗаполнено(Склад) И СкладВерныйТип Тогда
							
							Результат = SUI_ОбменДаннымиСервер.ПеремещениеМеждуЯчейкамиСоздатьДокумент(ДанныеЗапроса.МобильноеУстройство, 
								ДанныеЗапроса.ИдентификаторУстройства, Склад, ТаблицаТоваров, ПользовательУТ);
							
						Иначе
							Результат = SUI_HTTPСервис.РезультатОшибка("Склад не найден по идентификатору");
						КонецЕсли;
						
					КонецЕсли;	
					
				КонецЕсли;					
				
			КонецЕсли;

		КонецЕсли;
		
	Исключение
		Результат = ОбработатьИсключительнуюОшибку(НСтр("ru = 'Перемещение между ячейками'"), ДанныеЗапроса, ИнформацияОбОшибке());
	КонецПопытки;
	
	// Установка заголовков проверки обновления приложения
	SUI_HTTPСервис.УстановитьЗаголовкиОтветаПроверкиОбновления(Результат, ДанныеЗапроса);
	
	Ответ = SUI_HTTPСервис.СформироватьHTTPОтвет(Результат, Запрос.Заголовки);
	
	// Логирование HTTP запросов
	ВыполнитьЛогирование(Запрос, Ответ, ДанныеЗапроса.ОтключитьЛогирование);
	
	Возврат Ответ;
	
КонецФункции

