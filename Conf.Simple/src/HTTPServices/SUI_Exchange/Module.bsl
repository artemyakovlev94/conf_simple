Функция СоставКодовМаркировокПолучить(Запрос)
	
	ДанныеЗапроса = SUI_HTTPСервис.ОбработатьЗапрос(Запрос);
	
	Если ДанныеЗапроса.РезультатОтвет = Неопределено Тогда
		
		Попытка
			
			КодыМаркировкиКЗапросу = SUI_ОбщегоНазначенияКлиентСервер.ДанныеИзСтрокиJSON(ДанныеЗапроса.Тело, Ложь);
			
			ИдентификаторДокумента = ДанныеЗапроса.Параметры.Получить("id_doc");
			ИдентификаторНастройки = ДанныеЗапроса.Параметры.Получить("id_settings");
			
			SUI_ОбщегоНазначенияКлиентСервер.Проверить(
				SUI_ИнтеграцияВКонфигурациюКлиентСервер.ЭтоИдентификаторSimple(ИдентификаторДокумента),
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Идентификатор документа ""%1"" не является идентификатором Simple.'"), 
					ИдентификаторДокумента));
					
			SUI_ОбщегоНазначенияКлиентСервер.Проверить(
				SUI_ИнтеграцияВКонфигурациюКлиентСервер.ЭтоИдентификаторSimple(ИдентификаторДокумента),
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Идентификатор настроек документа ""%1"" не является идентификатором Simple.'"), 
					ИдентификаторНастройки));
			
			Результат = SUI_ОбменДаннымиСервер.ПолучитьСоставКодовМаркировок(
				ДанныеЗапроса.МобильноеУстройство.Ссылка, КодыМаркировкиКЗапросу, 
				ИдентификаторДокумента, ИдентификаторНастройки);
			
		Исключение
			Результат = ОбработатьИсключительнуюОшибку("", ДанныеЗапроса, ИнформацияОбОшибке());
		КонецПопытки;
		
	Иначе
		Результат = ДанныеЗапроса.РезультатОтвет;
	КонецЕсли;
	
	Ответ = SUI_HTTPСервис.СформироватьHTTPОтвет(Результат, Запрос.Заголовки);
	
	// Логировать HTTP запрос
	Если ДанныеЗапроса.ЕстьБазовыеПраваБСП Тогда
		ВыполнитьЛогирование(Запрос, Ответ, ДанныеЗапроса.МобильноеУстройство.ОтключитьЛогирование);
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

