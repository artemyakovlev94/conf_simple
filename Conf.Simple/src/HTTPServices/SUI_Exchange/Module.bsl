Функция СоздатьВходящиеСообщениеОбменаДанными(МобильноеУстройство, Обработчик, Параметры, Ключи = Неопределено)
	
	ИдентификаторСообщения = SUI_СообщенияОбменаДанными.СоздатьВходящиеСообщениеОбменаДанными(
		МобильноеУстройство, Обработчик, Параметры, Ключи);
	
	Результат = Новый Структура();
	Результат.Вставить("approved", 	ЗначениеЗаполнено(ИдентификаторСообщения));
	Результат.Вставить("messageID", ИдентификаторСообщения);
	
	Возврат SUI_HTTPСервис.РезультатУспех(Результат);
		
КонецФункции

Процедура ВыполнитьЛогирование(Запрос, Ответ, ОтключитьЛогирование = Ложь)
	
	SUI_HTTPСервис.ВыполнитьЛогирование(Запрос, Ответ, ОтключитьЛогирование = Ложь);
	
