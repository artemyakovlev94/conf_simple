Функция ОбработатьИсключительнуюОшибку(КонтекстОшибки, ДанныеЗапроса, Ошибка)
	
	SUI_ЖурналРегистрации.ЗаписьВЖурналРегистрации(
		SUI_HTTPСервисКлиентСервер.ИмяСобытия(КонтекстОшибки),
		УровеньЖурналаРегистрации.Ошибка,
		Метаданные.HTTPСервисы.SUI_Exchange,
		SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеЗапроса, "МобильноеУстройство"),
		Ошибка);
	
	Возврат SUI_HTTPСервис.РезультатОшибка(Ошибка, 500);
		
КонецФункции

Функция СоздатьВходящиеСообщениеОперации(МобильноеУстройство, ИмяМетода, ПараметрыМетода, ДополнительныеПараметры = Неопределено)
	
	ИдентификаторСообщения = SUI_СообщенияОбменаДанными.СоздатьСообщениеОперации(
		МобильноеУстройство, 
		ПланыОбмена.SUI_МобильныеУстройства.ЭтотУзел(), 
		ИмяМетода, 
		ПараметрыМетода,
		ДополнительныеПараметры);
	
	Результат = Новый Структура();
	Результат.Вставить("approved", 	Истина);
	Результат.Вставить("messageID", ИдентификаторСообщения);
	
	Возврат SUI_HTTPСервис.РезультатУспех(Результат);
		
КонецФункции

Процедура ВыполнитьЛогирование(Запрос, Ответ, ОтключитьЛогирование = Ложь)
	
	Если ОтключитьЛогирование Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыДобавленияЗаписиЛогирования = SUI_ЛогированиеHTTPЗапросовКлиентСервер.ПараметрыДобавленияЗаписиЛогирования(
		Запрос, Ответ);
	
	SUI_ЛогированиеHTTPЗапросовКлиентСервер.ДобавитьЗаписьЛогирования(ПараметрыДобавленияЗаписиЛогирования);
	
КонецПроцедуры

#КонецОбласти
