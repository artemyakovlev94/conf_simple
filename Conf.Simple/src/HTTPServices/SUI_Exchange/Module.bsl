Функция СообщенияСоздать(Запрос)
	
	ДанныеЗапроса = SUI_HTTPСервис.ОбработатьЗапрос(Запрос);
	
	Если ДанныеЗапроса.РезультатОтвет = Неопределено Тогда
		
		Попытка
			
			ДанныеСообщения = SUI_ОбщегоНазначенияКлиентСервер.ДанныеИзСтрокиJSON(ДанныеЗапроса.Тело, Ложь);
    		
    		ТекстСообщения = SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеСообщения, "text", "", Тип("Строка"));
    		
    		ОбщегоНазначенияКлиентСервер.Проверить(ЗначениеЗаполнено(ТекстСообщения), 
    			НСтр("ru = 'Передано пустое сообщение.'"));
			
			SUI_СообщенияМобильныхУстройств.ОтправитьСообщениеГлавномуУзлу(
				ДанныеЗапроса.МобильноеУстройство.Ссылка, ТекстСообщения);
 
 			Результат = SUI_HTTPСервис.РезультатУспех(Новый Структура("result", Истина), 201);
			
		Исключение
			Результат = ОбработатьИсключительнуюОшибку(НСтр("ru = 'Сообщения'"), ДанныеЗапроса, ИнформацияОбОшибке());
		КонецПопытки;
		
	Иначе
		Результат = ДанныеЗапроса.РезультатОтвет;
	КонецЕсли;
	
	Ответ = SUI_HTTPСервис.СформироватьHTTPОтвет(Результат, Запрос.Заголовки);
	
	// Логировать HTTP запрос
	Если ДанныеЗапроса.ЕстьБазовыеПраваБСП Тогда
		ВыполнитьЛогирование(Запрос, Ответ, ДанныеЗапроса.МобильноеУстройство.ОтключитьЛогирование);
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

