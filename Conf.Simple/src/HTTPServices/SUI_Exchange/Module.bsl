Функция СообщенияОбменаРезультатПолучить(Запрос)
	
	ПараметрыОбработкиЗапроса = SUI_HTTPСервис.ПараметрыОбработкиЗапроса();
	ПараметрыОбработкиЗапроса.ПрочитатьПараметрыИзТела = Истина;
	ПараметрыОбработкиЗапроса.ВосстанавливатьСсылкиИдентификаторов = Ложь;
	ДанныеЗапроса = SUI_HTTPСервис.ОбработатьЗапрос(Запрос, ПараметрыОбработкиЗапроса);
	
	Если ДанныеЗапроса.РезультатОтвет = Неопределено Тогда
		
		Попытка
			
			ИдентификаторСообщения = ОбщегоНазначения.ОписаниеТипаСтрока(0)
				.ПривестиЗначение(ДанныеЗапроса.Параметры.Получить("messageID"));
			
			ОбщегоНазначенияКлиентСервер.Проверить(Не ПустаяСтрока(ИдентификаторСообщения),
				НСтр("ru = 'Не передан ID сообщения обмена данными'"));
			
			РезультатОбработкиСообщения = РегистрыСведений.SUI_РезультатыОбработкиВходящихСообщенийОбменаДанными
				.ПолучитьРезультат(ИдентификаторСообщения);
			
			Если РезультатОбработкиСообщения = Неопределено Тогда
				
				ТекстОшибки = СтрШаблон(
					НСтр("ru = 'Результат обработки сообщения обмена данными по ID ""%1"" не найден'"), 
					ИдентификаторСообщения);
				
				Результат = SUI_HTTPСервис.РезультатОшибка(ТекстОшибки, 404);
				
			Иначе
				Результат = SUI_HTTPСервис.РезультатУспех(РезультатОбработкиСообщения);
			КонецЕсли;
			
		Исключение
			Результат = ОбработатьИсключительнуюОшибку(НСтр("ru = 'Сообщения обмена'"), 
				ДанныеЗапроса, ИнформацияОбОшибке());
		КонецПопытки;
		
	Иначе
		Результат = ДанныеЗапроса.РезультатОтвет;
	КонецЕсли;
	
	Ответ = SUI_HTTPСервис.СформироватьHTTPОтвет(Результат, Запрос.Заголовки);
	
	// Логировать HTTP запрос
	Если ДанныеЗапроса.ЕстьБазовыеПраваБСП Тогда
		ВыполнитьЛогирование(Запрос, Ответ, ДанныеЗапроса.МобильноеУстройство.ОтключитьЛогирование);
	КонецЕсли;
	
	Возврат Ответ;
	
