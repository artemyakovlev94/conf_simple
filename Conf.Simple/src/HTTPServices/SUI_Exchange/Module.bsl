#Область ОбработчикиСобытий

Функция ДанныеПолучить(Запрос)
	
	Перем ДанныеЗапроса;
	
	Попытка
		
		ПараметрыОбработкиВходящегоЗапроса = SUI_HTTPСервисКлиентСервер.ПараметрыОбработкиВходящегоЗапроса();
		ПараметрыОбработкиВходящегоЗапроса.ПрочитатьПараметрыИзТела = Истина;
		ДанныеЗапроса = SUI_HTTPСервис.ОбработатьВходящийЗапрос(Запрос, ПараметрыОбработкиВходящегоЗапроса);
		
		Если ДанныеЗапроса.РезультатОтвет <> Неопределено Тогда
			Результат = ДанныеЗапроса.РезультатОтвет;
		Иначе
			
			ТипПолучаемыхДанных = НРег(ОбщегоНазначения.ОписаниеТипаСтрока(9).ПривестиЗначение(
				ДанныеЗапроса.Параметры.Получить("type")));
			
			Результат = SUI_ОбменДаннымиСервер.ПолучитьДанные(ДанныеЗапроса.МобильноеУстройство, 
				ТипПолучаемыхДанных <> "documents", ТипПолучаемыхДанных <> "nsi");
			
		КонецЕсли;
		
	Исключение
		Результат = ОбработатьИсключительнуюОшибку(НСтр("ru = 'Получение данных'"), ДанныеЗапроса, ИнформацияОбОшибке());
	КонецПопытки;
	
	// Установка заголовков проверки обновления приложения
	SUI_HTTPСервис.УстановитьЗаголовкиОтветаПроверкиОбновления(Результат, ДанныеЗапроса);
	
	Ответ = SUI_HTTPСервис.СформироватьHTTPОтвет(Результат, Запрос.Заголовки);
	
	// Логирование HTTP запросов
	ВыполнитьЛогирование(Запрос, Ответ, ДанныеЗапроса.ОтключитьЛогирование);
	
	Возврат Ответ;
	
КонецФункции

Функция ДокументыСоздать(Запрос)
	
	Перем ДанныеЗапроса;
	
	Попытка
		
		ПараметрыОбработкиВходящегоЗапроса = SUI_HTTPСервисКлиентСервер.ПараметрыОбработкиВходящегоЗапроса();
		ПараметрыОбработкиВходящегоЗапроса.ПрочитатьПараметрыИзТела = Истина;
		ДанныеЗапроса = SUI_HTTPСервис.ОбработатьВходящийЗапрос(Запрос, ПараметрыОбработкиВходящегоЗапроса);
		
		Если ДанныеЗапроса.РезультатОтвет <> Неопределено Тогда
			Результат = ДанныеЗапроса.РезультатОтвет;
		Иначе
			
			НастройкаДокумента = ДанныеЗапроса.Параметры.Получить("id_doc_type");
			
			ОбщегоНазначенияКлиентСервер.Проверить(НастройкаДокумента <> Неопределено,
				НСтр("ru = 'Не передан идентификатор настройки документа обмена'"));
			
			ОписаниеТипаНастройкаДокумента = Новый ОписаниеТипов("СправочникСсылка.SUI_НастройкиДокументов");
			НастройкаДокумента = ОписаниеТипаНастройкаДокумента.ПривестиЗначение(НастройкаДокумента);
			
			ОбщегоНазначенияКлиентСервер.Проверить(ОбщегоНазначения.СсылкаСуществует(НастройкаДокумента),
				НСтр("ru = 'По переданному идентификатору настройка документа не существует'"));
			
			Результат = SUI_ОбменДаннымиСервер.СоздатьДокумент(ДанныеЗапроса.МобильноеУстройство, НастройкаДокумента);
			
		КонецЕсли;
		
	Исключение
		Результат = ОбработатьИсключительнуюОшибку(НСтр("ru = 'Создать документы'"), ДанныеЗапроса, ИнформацияОбОшибке());
	КонецПопытки;
	
	// Установка заголовков проверки обновления приложения
	SUI_HTTPСервис.УстановитьЗаголовкиОтветаПроверкиОбновления(Результат, ДанныеЗапроса);
	
	Ответ = SUI_HTTPСервис.СформироватьHTTPОтвет(Результат, Запрос.Заголовки);
	
	// Логирование HTTP запросов
	ВыполнитьЛогирование(Запрос, Ответ, ДанныеЗапроса.ОтключитьЛогирование);
	
	Возврат Ответ;
	
КонецФункции

Функция ОбновитьДокументы(Запрос)

	Перем ДанныеЗапроса;
	
	Попытка
		
		ДанныеЗапроса = SUI_HTTPСервис.ОбработатьВходящийЗапрос(Запрос);
		
		Если ДанныеЗапроса.РезультатОтвет <> Неопределено Тогда
			Результат = ДанныеЗапроса.РезультатОтвет;
		Иначе
			
			ПараметрыМетода = SUI_ОбщегоНазначенияКлиентСерверПереопределяемый.МассивЗначений(
				ДанныеЗапроса.МобильноеУстройство, SUI_СообщенияОбменаДанными.СжатьСтроку(ДанныеЗапроса.Тело));
			
			ДополнительныеПараметры = SUI_СообщенияОбменаДанными.ДополнительныеПараметрыСообщенияОперации();
			ДополнительныеПараметры.ВТранзакции = Истина;
			
			Результат = СоздатьВходящиеСообщениеОперации(ДанныеЗапроса.МобильноеУстройство,
				"SUI_ОбменДаннымиСервер.ЗагрузитьДанныеДокументов", ПараметрыМетода, ДополнительныеПараметры);
			
		КонецЕсли;
		
	Исключение
		Результат = ОбработатьИсключительнуюОшибку(НСтр("ru = 'Обновить документы'"), ДанныеЗапроса, ИнформацияОбОшибке());
	КонецПопытки;
	
	// Установка заголовков проверки обновления приложения
	SUI_HTTPСервис.УстановитьЗаголовкиОтветаПроверкиОбновления(Результат, ДанныеЗапроса);
	
	Ответ = SUI_HTTPСервис.СформироватьHTTPОтвет(Результат, Запрос.Заголовки);
	
	// Логирование HTTP запросов
	ВыполнитьЛогирование(Запрос, Ответ, ДанныеЗапроса.ОтключитьЛогирование);
	
	Возврат Ответ;
	
КонецФункции

