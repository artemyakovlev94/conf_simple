
#Область ОбработчикиСобытийФормы 

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(Параметры.Ключ) Тогда
		
		ХранилищеКартинки = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Параметры.Ключ, "Картинка");
		
		Если ТипЗнч(ХранилищеКартинки) = Тип("ХранилищеЗначения") Тогда
			ДвоичныеДанныеКартинки = ХранилищеКартинки.Получить();
		КонецЕсли;
		
	ИначеЕсли ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
		ДвоичныеДанныеКартинки = Параметры.ЗначениеКопирования.Картинка.Получить();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОбновитьАдресКартинки();	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если ТребуетсяОбновитьКартинку Тогда
		ТекущийОбъект.Картинка = Новый ХранилищеЗначения(Неопределено);
	Иначе
		ТекущийОбъект.Картинка = Новый ХранилищеЗначения(ДвоичныеДанныеКартинки, Новый СжатиеДанных(9));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	Оповестить("SUI_ЗаписьШаблонаЭтикеткиZPL", , ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если ЭтоАдресВременногоХранилища(КартинкаПредпросмотр) Тогда
		УдалитьИзВременногоХранилища(КартинкаПредпросмотр);
		КартинкаПредпросмотр = "";
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ШиринаММПриИзменении(Элемент)
	УстановитьПризнакТребованияОбновленияКартинкиПредпросмотра();
КонецПроцедуры

&НаКлиенте
Процедура ВысотаММПриИзменении(Элемент)
	УстановитьПризнакТребованияОбновленияКартинкиПредпросмотра();
КонецПроцедуры

&НаКлиенте
Процедура КодZPLПриИзменении(Элемент)
	УстановитьПризнакТребованияОбновленияКартинкиПредпросмотра();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы  

&НаКлиенте
Процедура ПримерШаблонаEN(Команда)
	ЗаполнитьПримерКодаZPL_EN();
КонецПроцедуры

&НаКлиенте
Процедура ПримерШаблонаRU(Команда)
	ЗаполнитьПримерКодаZPL_RU();
КонецПроцедуры

&НаКлиенте
Процедура ZPLПредпросмотр(Команда)
	ОбновитьКартинкуПредпросмотра();
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьЗапросПолученияДанных(Команда)
	
	ПараметрыОткрытияКонструктора = SUI_КонструкторЗапросаКлиентСервер.ПараметрыОткрытияКонструктора();
	ПараметрыОткрытияКонструктора.Данные.ТекстЗапроса = Объект.ТекстЗапроса;
	ПараметрыОткрытияКонструктора.Данные.ВыполнятьВПакетномРежиме = Объект.ВыполнятьЗапросВПакетномРежиме;
	ПараметрыОткрытияКонструктора.Данные.ПакетыРезультата = Новый Массив();
	
	Для Каждого СтрокаТаблицы Из Объект.ПакетыРезультатаЗапроса Цикл
		ПараметрыОткрытияКонструктора.Данные.ПакетыРезультата.Добавить(СтрокаТаблицы.ИндексРезультата);
	КонецЦикла;
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ОткрытьЗапросПолученияДанныхЗавершение", ЭтотОбъект);
	
	SUI_КонструкторЗапросаКлиент.ОткрытьКонструктор(ПараметрыОткрытияКонструктора, ОповещениеОЗавершении, ЭтотОбъект, Окно);
		
КонецПроцедуры

#КонецОбласти

