&НаКлиенте
Функция ПроверитьЗаполнениеРеквизитов()
	
	Отказ = Ложь;
	
	Если Не ЗначениеЗаполнено(Объект.ШиринаММ) Тогда
		SUI_ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не заполнена ширина шаблона этикетки'"), , "ШиринаММ", "Объект", Отказ);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ВысотаММ) Тогда
		SUI_ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не заполнена высота шаблона этикетки'"), , "ВысотаММ", "Объект", Отказ);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.КодZPL) Тогда
		SUI_ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не заполнен код ZPL шаблона этикетки'"), , "КодZPL", "Объект", Отказ);
	ИначеЕсли Лев(Объект.КодZPL, 3) <> "^XA" Тогда
		SUI_ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Код ZPL содержит ошибки. Код ZPL должен начинаться на ""^XA""'"), , 
			"КодZPL", "Объект", Отказ);
	ИначеЕсли Прав(Объект.КодZPL, 3) <> "^XZ" Тогда
		SUI_ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Код ZPL содержит ошибки. Код ZPL должен оканчиваться на ""^XZ""'"), , 
			"КодZPL", "Объект", Отказ);
	КонецЕсли; 
	
	Возврат Не Отказ;
	
КонецФункции // ПроверитьЗаполнениеРеквизитов()

&НаКлиенте
Процедура ОбновитьКартинкуПредпросмотра()
	
	Если ЭтоАдресВременногоХранилища(КартинкаПредпросмотр) Тогда
		УдалитьИзВременногоХранилища(КартинкаПредпросмотр);
	КонецЕсли;
	
	КартинкаПредпросмотр = "";
	Элементы.КартинкаПредпросмотр.Подсказка = "";
	
	Если ПроверитьЗаполнениеРеквизитов() Тогда
		
		ПараметрыZPL = Новый Структура();
		
		ПараметрыZPL.Вставить("ШиринаВДюймах", Формат(Окр(Объект.ШиринаММ / 25.4, 3, РежимОкругления.Окр15как20), "ЧЦ=4; ЧДЦ=3; ЧРД=."));	
		ПараметрыZPL.Вставить("ВысотаВДюймах", Формат(Окр(Объект.ВысотаММ / 25.4, 3, РежимОкругления.Окр15как20), "ЧЦ=4; ЧДЦ=3; ЧРД=."));
		ПараметрыZPL.Вставить("Код", СокрЛП(Объект.КодZPL));
		
		Результат = ПолучитьДанныеКартинкиШаблонаИзСервиса(ПараметрыZPL);
		
		ДвоичныеДанныеКартинки = Результат.Картинка;
		Элементы.КартинкаПредпросмотр.ТекстНевыбраннойКартинки = Результат.Ошибка;
		
		ТребуетсяОбновитьКартинку = Ложь;
		Элементы.ИнформацияОбОбновленииКартинки.Заголовок = "";
		
		ОбновитьАдресКартинки();
	
	КонецЕсли;
	
	ОбновитьАдресКартинки();

КонецПроцедуры // ОбновитьКартинкуПредпросмотра()

&НаКлиенте
Функция ПолучитьДанныеКартинкиШаблонаИзСервиса(ПараметрыZPL)
	
	Данные = Новый Структура("Картинка, Ошибка", Неопределено, "");
	
	ДвоичныеДанныеКартинки = Неопределено;
	
	СтруктураURI = SUI_ОбщегоНазначенияКлиентСервер.СтруктураURI(
		"https://api.labelary.com/v1/printers/8dpmm/labels/" + ПараметрыZPL.ШиринаВДюймах + "x" + ПараметрыZPL.ВысотаВДюймах + "/0/");
	
	HTTPСоединение = Новый HTTPСоединение(СтруктураURI.Хост, СтруктураURI.Порт, , , , 10, Новый ЗащищенноеСоединениеOpenSSL);

	HTTPЗапрос = Новый HTTPЗапрос(СтруктураURI.ПутьНаСервере);                                           
	
	HTTPЗапрос.Заголовки.Вставить("Accept", 		"image/png");
	HTTPЗапрос.Заголовки.Вставить("Content-Type", 	"application/x-www-form-urlencoded");
	
	HTTPЗапрос.УстановитьТелоИзСтроки(ПараметрыZPL.Код, КодировкаТекста.UTF8);
	
	Попытка
		Результат = HTTPСоединение.ОтправитьДляОбработки(HTTPЗапрос);
	Исключение
		ВызватьИсключение;
	КонецПопытки;
	
	Если Результат.КодСостояния = 200 Тогда
		Данные.Картинка = Результат.ПолучитьТелоКакДвоичныеДанные();
	Иначе
		Данные.Ошибка = Результат.ПолучитьТелоКакСтроку();
		SUI_ОбщегоНазначенияКлиент.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Ошибка получения данных изображения из сервиса. Код состояния: %1. 
                 |Текст ошибки: %2'"), Результат.КодСостояния, Данные.Ошибка));
	КонецЕсли;
	
	Возврат Данные;	

КонецФункции // ПолучитьДанныеКартинкиШаблонаНаСервере()

&НаКлиенте
Процедура ОбновитьАдресКартинки()
	
	Если ЭтоАдресВременногоХранилища(КартинкаПредпросмотр) Тогда
		УдалитьИзВременногоХранилища(КартинкаПредпросмотр);
	КонецЕсли;
	
	Если ТипЗнч(ДвоичныеДанныеКартинки) = Тип("ДвоичныеДанные") Тогда
		КартинкаПредпросмотр = ПоместитьВоВременноеХранилище(ДвоичныеДанныеКартинки, УникальныйИдентификатор);
	Иначе 
		КартинкаПредпросмотр = "";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(КартинкаПредпросмотр) И Не ЗначениеЗаполнено(Элементы.КартинкаПредпросмотр.ТекстНевыбраннойКартинки) Тогда
		Элементы.КартинкаПредпросмотр.ТекстНевыбраннойКартинки = НСтр("ru = 'Отсутствует изображение шаблона'");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПризнакТребованияОбновленияКартинкиПредпросмотра()
	ТребуетсяОбновитьКартинку = Истина;
	Элементы.ИнформацияОбОбновленииКартинки.Заголовок = НСтр("ru = 'Параметры шаблона были изменены. Обновите картинку предпросмотра.'");	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьЗапросПолученияДанныхЗавершение(ПараметрыКонструктора, ДополнительныеПараметры) Экспорт
	
	Если ПараметрыКонструктора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Объект.ТекстЗапроса = ПараметрыКонструктора.ТекстЗапроса;
	Объект.ВыполнятьЗапросВПакетномРежиме = ПараметрыКонструктора.ВыполнятьВПакетномРежиме;
	
	Объект.ПакетыРезультатаЗапроса.Очистить();
	Для индекс = 0 По ПараметрыКонструктора.ПакетыРезультата.ВГраница() Цикл
		НоваяСтрока = Объект.ПакетыРезультатаЗапроса.Добавить();
		НоваяСтрока.ИндексРезультата = ПараметрыКонструктора.ПакетыРезультата[индекс];
	КонецЦикла;
	
	Модифицированность = Истина;
	
КонецПроцедуры

#КонецОбласти
