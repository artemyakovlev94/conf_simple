&НаКлиенте
Процедура ПослеЗакрытияФормыАлгоритма(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.ТипАлгоритма = "ОбработкаСтрокиТабличнойЧасти" Тогда
		ДополнительныеНастройки.АлгоритмыОбработкиСтрокТабличныхЧастей.Вставить(Результат.ТипТаблицы, Результат.Алгоритм);
	ИначеЕсли Результат.ТипАлгоритма = "ОбработкаСозданияДокументаНаОсновании" Тогда
		ДополнительныеНастройки.АлгоритмыОбработкиСозданияДокументаНаОсновании.Вставить(Результат.ИмяМетаданныхСоздаваемогоДокумента, Результат.Алгоритм);
	ИначеЕсли Результат.ТипАлгоритма = "ПередЗаписью" Тогда
		ДополнительныеНастройки.ОбработчикиСобытий.Вставить("ПередЗаписью", Результат.Алгоритм);
	ИначеЕсли Результат.ТипАлгоритма = "ПослеЗаписи" Тогда
		ДополнительныеНастройки.ОбработчикиСобытий.Вставить("ПослеЗаписи", Результат.Алгоритм);
	Иначе
		Возврат;
	КонецЕсли;
	
	Модифицированность = Истина;

КонецПроцедуры

#Область НастройкиТабличныхЧастей

&НаКлиенте
Процедура ОткрытьНастройкиТабличнойЧасти(КлючСвязи)
	
	ПараметрыОткрытия = Новый Структура("КлючСвязи, ТипТаблицы, ИмяТабличнойЧасти", КлючСвязи);
	
	СтрокиНастройкиТЧ = Объект.НастройкиТабличныхЧастей.НайтиСтроки(Новый Структура("КлючСвязи", КлючСвязи));
		
	Если СтрокиНастройкиТЧ.Количество() = 1 Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыОткрытия, СтрокиНастройкиТЧ[0]);
	КонецЕсли;
	
	ПараметрыОткрытия.Вставить("ИмяДокумента", Объект.ИмяОбъектаМетаданных);
	ПараметрыОткрытия.Вставить("ДоступныеТипыТаблиц", ПолучитьДоступныеТипыТаблиц(ПараметрыОткрытия.ТипТаблицы));
	
	Если ПараметрыОткрытия.ДоступныеТипыТаблиц.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыОткрытия.Вставить("СопоставленияРеквизитов", 
		ПолучитьСопоставленияРеквизитовТабличнойЧасти(ПараметрыОткрытия.КлючСвязи));
	
	// Дополнительные реквизиты
	ПараметрыОткрытия.Вставить("АлгоритмПолученияДополнительныхРеквизитов", АлгоритмПолученияДополнительныхРеквизитов(ПараметрыОткрытия.ТипТаблицы));
	
	// Использование признака маркировки
	ПараметрыОткрытия.Вставить("ИспользованиеМаркировки", Объект.ИспользуетсяМаркировка);
	ПараметрыОткрытия.Вставить("АлгоритмПолученияПризнакаМаркировки", АлгоритмПолученияПризнакаМаркировки(ПараметрыОткрытия.ТипТаблицы));
	ПараметрыОткрытия.Вставить("АлгоритмПолученияСтатусаУказанияСерии", АлгоритмПолученияСтатусаУказанияСерии(ПараметрыОткрытия.ТипТаблицы));

	ОповещениеОЗавершении = Новый ОписаниеОповещения("ОткрытьНастройкиТабличнойЧастиЗавершение", ЭтотОбъект);
	
	ОткрытьФорму("Справочник.SUI_НастройкиДокументов.Форма.НастройкаТабличнойЧасти", ПараметрыОткрытия, ЭтотОбъект, 
		УникальныйИдентификатор, , , ОповещениеОЗавершении, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСопоставленияРеквизитовТабличнойЧасти(КлючСвязи)
	
	МассивСтрок = Объект.СопоставлениеРеквизитовТабличныхЧастей.НайтиСтроки(Новый Структура("КлючСвязи", КлючСвязи));
	
	Если МассивСтрок.Количество() = 0 Тогда
		Возврат Неопределено;
	Иначе
		Возврат ПоместитьВоВременноеХранилище(Объект.СопоставлениеРеквизитовТабличныхЧастей.Выгрузить(МассивСтрок));
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ПолучитьДоступныеТипыТаблиц(ТекущийТипТаблицы)
	
	ДоступныеТипыТаблиц = Новый Массив();
	
	ИсключаемыеТипыТаблиц = Объект.НастройкиТабличныхЧастей.Выгрузить().ВыгрузитьКолонку("ТипТаблицы");
	
	Если ИсключаемыеТипыТаблиц.Найти(Перечисления.SUI_ТипыТаблицДокументовОбмена.Товары) <> Неопределено Тогда
		ИсключаемыеТипыТаблиц.Добавить(Перечисления.SUI_ТипыТаблицДокументовОбмена.Отбор);
		ИсключаемыеТипыТаблиц.Добавить(Перечисления.SUI_ТипыТаблицДокументовОбмена.Размещение);
	ИначеЕсли ИсключаемыеТипыТаблиц.Найти(Перечисления.SUI_ТипыТаблицДокументовОбмена.Отбор) <> Неопределено Или
		ИсключаемыеТипыТаблиц.Найти(Перечисления.SUI_ТипыТаблицДокументовОбмена.Размещение) <> Неопределено Тогда
		ИсключаемыеТипыТаблиц.Добавить(Перечисления.SUI_ТипыТаблицДокументовОбмена.Товары);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИсключаемыеТипыТаблиц", ИсключаемыеТипыТаблиц);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	SUI_ТипыТаблицДокументовОбмена.Ссылка КАК Ссылка
		|ИЗ
		|	Перечисление.SUI_ТипыТаблицДокументовОбмена КАК SUI_ТипыТаблицДокументовОбмена
		|ГДЕ
		|	SUI_ТипыТаблицДокументовОбмена.Ссылка <> ЗНАЧЕНИЕ(Перечисление.SUI_ТипыТаблицДокументовОбмена.ПотокШтрихкодов)
		|	И НЕ SUI_ТипыТаблицДокументовОбмена.Ссылка В (&ИсключаемыеТипыТаблиц)";

	ДоступныеТипыТаблиц = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Если ТекущийТипТаблицы <> Неопределено Тогда
		ДоступныеТипыТаблиц.Добавить(ТекущийТипТаблицы);
	КонецЕсли;
	
	Возврат ОбщегоНазначенияКлиентСервер.СвернутьМассив(ДоступныеТипыТаблиц);
	
КонецФункции

&НаКлиенте
Процедура ОткрытьНастройкиТабличнойЧастиЗавершение(Результат, ДополнительныеПараметры) Экспорт 

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОткрытьНастройкиТабличнойЧастиЗавершениеНаСервере(Результат);
	
	// Признак использования маркировки
	АлгоритмПолученияПризнакаМаркировки(Результат.ТипТаблицы, Результат.АлгоритмПолученияПризнакаМаркировки);
	
	// Признак использования маркировки
	АлгоритмПолученияСтатусаУказанияСерии(Результат.ТипТаблицы, Результат.АлгоритмПолученияСтатусаУказанияСерии);
	
	// Дополнительные реквизиты
	АлгоритмПолученияДополнительныхРеквизитов(Результат.ТипТаблицы, Результат.АлгоритмПолученияДополнительныхРеквизитов);
	
	ОбновитьНадписьГиперссылкиАлгоритмОбработкиСтрок();
	
КонецПроцедуры

&НаСервере
Процедура ОткрытьНастройкиТабличнойЧастиЗавершениеНаСервере(Результат)
	
	НайденныеСтроки = Объект.НастройкиТабличныхЧастей.НайтиСтроки(Новый Структура("КлючСвязи", Результат.КлючСвязи));
	
	Если НайденныеСтроки.Количество() > 0 Тогда
		
		СтрокаНастройкиТЧ = НайденныеСтроки[0];
		
		Если НайденныеСтроки.Количество() > 1 Тогда
			
			Для Индекс = 1 По НайденныеСтроки.ВГраница() Цикл
				Объект.НастройкиТабличныхЧастей.Удалить(НайденныеСтроки[Индекс]);
			КонецЦикла;
			 
		КонецЕсли;
		
	Иначе
		СтрокаНастройкиТЧ = Объект.НастройкиТабличныхЧастей.Добавить();
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(СтрокаНастройкиТЧ, Результат);
	
	НайденныеСтроки = Объект.СопоставлениеРеквизитовТабличныхЧастей.НайтиСтроки(
		Новый Структура("КлючСвязи", Результат.КлючСвязи));
	
	Для Индекс = 1 По НайденныеСтроки.ВГраница() Цикл
		Объект.СопоставлениеРеквизитовТабличныхЧастей.Удалить(НайденныеСтроки[Индекс]);
	КонецЦикла;
	
	СопоставленияРеквизитов = ПолучитьИзВременногоХранилища(Результат.СопоставленияРеквизитов);
	
	Для Каждого СтрокаСопоставленияРеквизитов Из СопоставленияРеквизитов Цикл
		НоваяСтрока = Объект.СопоставлениеРеквизитовТабличныхЧастей.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаСопоставленияРеквизитов);
		НоваяСтрока.КлючСвязи = Результат.КлючСвязи;
	КонецЦикла;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьНадписьГиперссылкиАлгоритмОбработкиСтрок()
	
	Для Каждого СтрокаНастройкиТЧ Из Объект.НастройкиТабличныхЧастей Цикл
		СтрокаНастройкиТЧ.АлгоритмОбработкиСтрокПредставление = НСтр("ru = 'редактировать'");
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьНадписьГиперссылкиДополнительныйОбработчикДокументов()
	
	Для Каждого СтрокаНастройкиТЧ Из СозданиеДокументов Цикл
		СтрокаНастройкиТЧ.ОбработчикПредставление = НСтр("ru = 'редактировать'");
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура НастройкиТабличныхЧастейПослеУдаленияНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СопоставлениеРеквизитовТЧ", Объект.СопоставлениеРеквизитовТабличныхЧастей.Выгрузить());
	Запрос.УстановитьПараметр("КлючиСвязи", Объект.НастройкиТабличныхЧастей.Выгрузить().ВыгрузитьКолонку("КлючСвязи"));
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СопоставлениеРеквизитовТЧ.КлючСвязи КАК КлючСвязи,
		|	СопоставлениеРеквизитовТЧ.Поле КАК Поле,
		|	СопоставлениеРеквизитовТЧ.ИмяРеквизита КАК ИмяРеквизита,
		|	СопоставлениеРеквизитовТЧ.ИспользуетсяПостоянноеЗначение КАК ИспользуетсяПостоянноеЗначение,
		|	СопоставлениеРеквизитовТЧ.ПостоянноеЗначение КАК ПостоянноеЗначение
		|ПОМЕСТИТЬ втСопоставлениеРеквизитовТЧ
		|ИЗ
		|	&СопоставлениеРеквизитовТЧ КАК СопоставлениеРеквизитовТЧ
		|ГДЕ
		|	СопоставлениеРеквизитовТЧ.КлючСвязи В(&КлючиСвязи)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втСопоставлениеРеквизитовТЧ.КлючСвязи КАК КлючСвязи,
		|	втСопоставлениеРеквизитовТЧ.Поле КАК Поле,
		|	втСопоставлениеРеквизитовТЧ.ИмяРеквизита КАК ИмяРеквизита,
		|	втСопоставлениеРеквизитовТЧ.ИспользуетсяПостоянноеЗначение КАК ИспользуетсяПостоянноеЗначение,
		|	втСопоставлениеРеквизитовТЧ.ПостоянноеЗначение КАК ПостоянноеЗначение
		|ИЗ
		|	втСопоставлениеРеквизитовТЧ КАК втСопоставлениеРеквизитовТЧ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ втСопоставлениеРеквизитовТЧ";
	
    Объект.СопоставлениеРеквизитовТабличныхЧастей.Загрузить(Запрос.Выполнить().Выгрузить());
	
	Модифицированность = Истина;
	
