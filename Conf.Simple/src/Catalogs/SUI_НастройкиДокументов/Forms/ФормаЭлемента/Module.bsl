&НаСервере
Процедура ИнициализироватьДокументыДляВводаНаОсновании()
	
	МассивДокументовДляВводаНаОсновании = Новый Массив;
	ИскомыйДокумент = Метаданные.Документы.Найти(Объект.ИмяОбъектаМетаданных);
	
	Для Каждого ДокументыМетаданные Из Метаданные.Документы Цикл
		Для Каждого ДокументВводитсяНаОсновании Из ДокументыМетаданные.ВводитсяНаОсновании Цикл
			Если ДокументВводитсяНаОсновании = ИскомыйДокумент Тогда
				Элементы.СозданиеДокументовДокумент.СписокВыбора.Добавить(ДокументыМетаданные.Имя, ДокументыМетаданные.Синоним);
				Продолжить;
			КонецЕсли;			
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция СозданиеДокументовДокументОбработкаВыбораНаСервере(ВыбранноеЗначение)
	
	СтруктураВозврата = Новый Структура;
	МетаданныеДокумента = Метаданные.Документы.Найти(ВыбранноеЗначение);

	Если МетаданныеДокумента = Неопределено Тогда
		СтруктураВозврата.Вставить("Имя", "");
		СтруктураВозврата.Вставить("Синоним", "");
	Иначе
		СтруктураВозврата.Вставить("Имя", МетаданныеДокумента.Имя);
		СтруктураВозврата.Вставить("Синоним", МетаданныеДокумента.Синоним);
	КонецЕсли;
	
    Возврат СтруктураВозврата;

КонецФункции

