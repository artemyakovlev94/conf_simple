
#Область ОписаниеПеременных

&НаКлиенте
Перем РазрешенныеСимволы;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЭтоНовый = Параметры.Ключ.Пустая();
	
	Если ЭтоНовый Тогда
		Параметры.Свойство("ИмяОбъектаМетаданных", Объект.ИмяОбъектаМетаданных);
		Объект.Используется = Истина;
	КонецЕсли;
	
	ИнициализироватьФормуОбъекта();
	
	Элементы.ОткрытьАлгоритмПолученияПризнакаМаркировки.Видимость = Объект.ИспользуетсяМаркировка;
		
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	РазрешенныеСимволы = SUI_СтроковыеФункцииКлиентСервер.АлфавитБуквыЛатинские() 
		+ SUI_СтроковыеФункцииКлиентСервер.АлфавитБуквыРусские() 
		+ SUI_СтроковыеФункцииКлиентСервер.АлфавитЦифры() 
		+ "_";
	 
	ОбновитьОтображениеЭлементовФормыОбъекта();
	ОбновитьНадписьГиперссылкиАлгоритмОбработкиСтрок();
	ОбновитьНадписьГиперссылкиДополнительныйОбработчикДокументов();
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Для Каждого СтрокаНастройкиТабличныхЧастей Из Объект.НастройкиТабличныхЧастей Цикл 
		
		НайденныеСтроки = Объект.СопоставлениеРеквизитовТабличныхЧастей.НайтиСтроки(
			Новый Структура("КлючСвязи", СтрокаНастройкиТабличныхЧастей.КлючСвязи));
			
		Если НайденныеСтроки.Количество() = 0 Тогда
			ОбщегоНазначения.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Для таблицы %1 не настроено сопоставление реквизитов.'"), СтрокаНастройкиТабличныхЧастей.ТипТаблицы), , 
				"НастройкиТабличныхЧастей", , Отказ);
		КонецЕсли;
		
	КонецЦикла;
	
	// 20.09.2024 - artem - B119267 -
	Если Объект.ComputerVision Тогда
		
		ТекстОшибки = НСтр("ru = 'Документы адресного хранения не поддерживаются в процессе ""CV""'");
		
		ОтборСтрок = Новый Структура();
		ОтборСтрок.Вставить("ТипТаблицы", Перечисления.SUI_ТипыТаблицДокументовОбмена.Отбор);
		Если Объект.НастройкиТабличныхЧастей.НайтиСтроки(ОтборСтрок).Количество() > 0 Тогда
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, , "Объект.ComputerVision", , Отказ);
		КонецЕсли;
		
		Если Не Отказ Тогда
			ОтборСтрок.ТипТаблицы = Перечисления.SUI_ТипыТаблицДокументовОбмена.Размещение;
			Если Объект.НастройкиТабличныхЧастей.НайтиСтроки(ОтборСтрок).Количество() > 0 Тогда
				ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, , "Объект.ComputerVision", , Отказ);
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Объект.СоответствияРеквизитов.Очистить();
		
	Если ЗначениеЗаполнено(ИмяРеквизитаКонтрагент) Тогда
		
		НоваяСтрокаСоответствияРеквизитов = Объект.СоответствияРеквизитов.Добавить();
		
		НоваяСтрокаСоответствияРеквизитов.Ключ = "id_countragents";
		НоваяСтрокаСоответствияРеквизитов.Значение = ИмяРеквизитаКонтрагент;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИмяРеквизитаСклад) Тогда
		
		НоваяСтрокаСоответствияРеквизитов = Объект.СоответствияРеквизитов.Добавить();
		
		НоваяСтрокаСоответствияРеквизитов.Ключ = "id_warehouse";
		НоваяСтрокаСоответствияРеквизитов.Значение = ИмяРеквизитаСклад;
		
	КонецЕсли;
	
	Если ЭтоНовый Тогда
		
		Если Не ПараметрыЗаписи.Свойство("SUI_ЗаполнитьМобильныеУстройстваПриЗаписи") Тогда
			
			Отказ = Истина;
			ОповещениеОЗавершении = Новый ОписаниеОповещения("ВопросПередЗаписьюЗаполнитьМобильныхКлиентовЗавершение", 
				ЭтотОбъект, ПараметрыЗаписи);
			ПоказатьВопрос(ОповещениеОЗавершении, НСтр("ru = 'Заполнить мобильные устройства?'"), РежимДиалогаВопрос.ДаНет);
			
		КонецЕсли;
		
	Иначе
		
		Если Не ПараметрыЗаписи.Свойство("SUI_ВопросПроверкиВыгруженныхДанныхЗадан") Тогда
		
			Если КлючевыеПараметрыНастройкиИзменены() Тогда
				
				Если ЕстьВыгруженныеДокументыПоНастройке(Объект.Ссылка) Тогда
					
					Отказ = Истина;
			
					ОповещениеОЗавершении = Новый ОписаниеОповещения("ВопросПередЗаписьюЗавершение", ЭтотОбъект, ПараметрыЗаписи);
					
					ТекстВопроса = НСтр("ru = 'Были изменены ключевые параметры настройки. Перед сохранением будут удалены выгруженные данные связанные с текущей настройкой!
					|
					|Вы действительно хотите продолжить?'");
					
					ПоказатьВопрос(ОповещениеОЗавершении, ТекстВопроса, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Нет, , КодВозвратаДиалога.Нет);
				
				КонецЕсли;
				
			КонецЕсли;

		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если КомпоновщикНастроек.Настройки.Отбор.Элементы.Количество() > 0 Тогда
		ТекущийОбъект.НастройкиСхемыКомпоновкиДанных = Новый ХранилищеЗначения(КомпоновщикНастроек.ПолучитьНастройки());
	Иначе
		ТекущийОбъект.НастройкиСхемыКомпоновкиДанных = Неопределено;
	КонецЕсли;

	ТекущийОбъект.ДополнительныеНастройки = Новый ХранилищеЗначения(ДополнительныеНастройки);
	
	ТекущийОбъект.НастройкиЗаполненияРеквизитовПередЗаписью.Очистить();
	
	Если УстановкаРеквизитов.Количество() Тогда
		
		Для Каждого РеквизитЗначение Из УстановкаРеквизитов Цикл
			Если РеквизитЗначение.РеквизитДокумента <> "" Тогда
				НоваяСтрокаНастройкиЗаполненияРеквизитовПередЗаписью = ТекущийОбъект.НастройкиЗаполненияРеквизитовПередЗаписью.Добавить();
				
				НоваяСтрокаНастройкиЗаполненияРеквизитовПередЗаписью.Ключ = РеквизитЗначение.РеквизитДокумента;
				НоваяСтрокаНастройкиЗаполненияРеквизитовПередЗаписью.Значение = Новый ХранилищеЗначения(РеквизитЗначение.Значение);		
				НоваяСтрокаНастройкиЗаполненияРеквизитовПередЗаписью.ПриРасхождении = РеквизитЗначение.ПриРасхождении;	
			КонецЕсли;
		КонецЦикла;	
		
	КонецЕсли;
	
	ТекущийОбъект.НастройкиСозданияДокументовНаОснованииПослеЗаписи.Очистить();
	
	Если СозданиеДокументов.Количество() Тогда
		
		Для Каждого РеквизитЗначение Из СозданиеДокументов Цикл 
			Если РеквизитЗначение.Документ <> "" И  РеквизитЗначение.ИмяМетаданныхДокумента <> ""   Тогда 
				НоваяСтрокаНастройкиСозданияДокументовНаОснованииПослеЗаписи = ТекущийОбъект.НастройкиСозданияДокументовНаОснованииПослеЗаписи.Добавить();		
				НоваяСтрокаНастройкиСозданияДокументовНаОснованииПослеЗаписи.Ключ = РеквизитЗначение.Документ;								
				НоваяСтрокаНастройкиСозданияДокументовНаОснованииПослеЗаписи.Значение = РеквизитЗначение.ИмяМетаданныхДокумента;
				НоваяСтрокаНастройкиСозданияДокументовНаОснованииПослеЗаписи.ПриРасхождении = РеквизитЗначение.ПриРасхождении;
				НоваяСтрокаНастройкиСозданияДокументовНаОснованииПослеЗаписи.Проводить = РеквизитЗначение.Проводить;
			КонецЕсли;	
		КонецЦикла;	
		
	КонецЕсли;
	
	ТекущийОбъект.ДополнительныеСвойства.Вставить("SUI_ЗаполнитьМобильныеУстройстваПриЗаписи",
		SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыЗаписи, "SUI_ЗаполнитьМобильныеУстройстваПриЗаписи", Ложь, Тип("Булево")));
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если Окно.Содержимое.Количество() > 1 Тогда
		
		Окно.Содержимое[Окно.Содержимое.ВГраница()].Закрыть();
		СтандартнаяОбработка = Ложь;
		Отказ = Истина;
		
	ИначеЕсли Модифицированность Тогда
		
		ОповещениеОЗавершении = Новый ОписаниеОповещения("ПодтверждениеЗакрытияЗавершение", ЭтотОбъект);
		ОбщегоНазначенияКлиент.ПоказатьПодтверждениеЗакрытияФормы(ОповещениеОЗавершении, Отказ, ЗавершениеРаботы);
		
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СинонимОбъектаМетаданныхОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)

	СинонимОбъектаМетаданныхОбработкаВыбораНаСервере(ВыбранноеЗначение);

	Элемент.ОбновитьТекстРедактирования();
	
КонецПроцедуры

&НаКлиенте
Процедура СинонимОбъектаМетаданныхПриИзменении(Элемент)

	Объект.СоответствияРеквизитов.Очистить();
	Объект.НастройкиТабличныхЧастей.Очистить();
	Объект.СопоставлениеРеквизитовТабличныхЧастей.Очистить();

	ИнициализироватьДополнительныеНастройки(Истина);
	
	ИмяРеквизитаКонтрагент = "";
	ИмяРеквизитаСклад = "";
	
	Модифицированность = Истина;
	
	ОбновитьОтображениеЭлементовФормыОбъекта();
	
КонецПроцедуры

