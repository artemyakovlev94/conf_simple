	КонецЕсли;
	
	//@skip-check reading-attribute-from-database
	СоответствияРеквизитовТабличныхЧастейИдентичны = ОбщегоНазначения.КоллекцииИдентичны(
		Объект.Ссылка.СоответствияРеквизитовТабличныхЧастей.Выгрузить(), 
		Объект.СоответствияРеквизитовТабличныхЧастей.Выгрузить(), 
		"ИмяТабличнойЧасти, ТипТаблицы, Ключ, Значение");
	
	Если Не СоответствияРеквизитовТабличныхЧастейИдентичны Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;

КонецФункции

