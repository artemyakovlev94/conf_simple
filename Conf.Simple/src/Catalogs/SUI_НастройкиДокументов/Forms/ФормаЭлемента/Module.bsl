&НаСервереБезКонтекста
Функция ТипДокументаСтрокой(ИмяОбъекта)
	
	Перем ТипСтрокой;
	
	Если ЗначениеЗаполнено(ИмяОбъекта) Тогда
		УстановитьПривилегированныйРежим(Истина);
		ТипСтрокой = ТипЗнч(ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени("Документ." + ИмяОбъекта).ПустаяСсылка());
	КонецЕсли;
	
	Возврат ТипСтрокой;
	
КонецФункции

&НаКлиенте
Функция АлгоритмПолученияПризнакаМаркировки(Ключ, НовоеЗначение = Неопределено)
	
	АлгоритмыИзНастройки = SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДополнительныеНастройки, 
		SUI_ДокументыОбменаКлиентСервер.ДополнительныеНастройки_КлючАлгоритмыПризнакаМаркировки(), 
		Новый Соответствие(), Тип("Соответствие"));
			
	Если НовоеЗначение <> Неопределено Тогда
		АлгоритмыИзНастройки.Вставить(Ключ, НовоеЗначение);
		ДополнительныеНастройки.Вставить(
			SUI_ДокументыОбменаКлиентСервер.ДополнительныеНастройки_КлючАлгоритмыПризнакаМаркировки(), АлгоритмыИзНастройки);
		Модифицированность = Истина;
	КонецЕсли;
	
	Возврат АлгоритмыИзНастройки.Получить(Ключ);
	
КонецФункции

