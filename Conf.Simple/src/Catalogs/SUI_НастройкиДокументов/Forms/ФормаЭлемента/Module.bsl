			НСтр("ru = 'Не выбрано имя документа'"), , 
			"Объект.СинонимОбъектаМетаданных");
		Возврат;
	КонецЕсли;
	
	ПараметрыОткрытияРедактора = SUI_РедакторКодаКлиент.ПараметрыОткрытия(
		АлгоритмПолученияПризнакаМаркировки("ИзДокумента"));
	
	ПараметрыОткрытияРедактора.ЗапретРедактированияПриОткрытии = Не Модифицированность;
	ПараметрыОткрытияРедактора.Заголовок = НСтр("ru = 'Получение признака маркировки из документа'");
	ПараметрыОткрытияРедактора.Описание = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
		НСтр("ru = 'Получение признака маркировки из документа <span style=""color: ГиперссылкаЦвет"">%1</span>.
		|<span style=""font:ВажнаяНадписьШрифт"">
		|Результат выполнения алгоритма необходимо присвоить в <span style=""color: ГиперссылкаЦвет"">Параметры.Результат</span></span>.'"), 
		Объект.СинонимОбъектаМетаданных);
	
	ДобавитьОписаниеПеременныхАлгоритмаПолученияПризнакаМаркировки(ПараметрыОткрытияРедактора.ПользовательскиеОбъекты,
		Объект.ИмяОбъектаМетаданных, Объект.СинонимОбъектаМетаданных);
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ОткрытьАлгоритмПолученияПризнакаМаркировкиЗавершение", ЭтотОбъект);
	ОткрытьРедакторКода(ОповещениеОЗавершении, ПараметрыОткрытияРедактора);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьАлгоритмПолученияДополнительныхРеквизитов(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.ИмяОбъектаМетаданных) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Не выбрано имя документа'"), , 
			"Объект.СинонимОбъектаМетаданных");
		Возврат;
	КонецЕсли;
	
	ПараметрыОткрытияРедактора = SUI_РедакторКодаКлиент.ПараметрыОткрытия(
		АлгоритмПолученияДополнительныхРеквизитов("ИзДокумента"));
	
	ПараметрыОткрытияРедактора.ЗапретРедактированияПриОткрытии = Не Модифицированность;
	ПараметрыОткрытияРедактора.Заголовок = НСтр("ru = 'Получение дополнительных реквизитов из документа'");
	ПараметрыОткрытияРедактора.Описание = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
		НСтр("ru = 'Получение дополнительных реквизитов из документа <span style=""color: ГиперссылкаЦвет"">%1.</span>
		|<span style=""font:ВажнаяНадписьШрифт"">
		|Результат выполнения алгоритма необходимо присвоить в <span style=""color: ГиперссылкаЦвет"">Параметры.Результат</span></span>.'"), 
		Объект.СинонимОбъектаМетаданных);
	
	ДобавитьОписаниеПеременныхАлгоритмаПолученияДополнительныхРеквизитов(
		ПараметрыОткрытияРедактора.ПользовательскиеОбъекты, Объект.ИмяОбъектаМетаданных, Объект.СинонимОбъектаМетаданных);
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ОткрытьАлгоритмПолученияДополнительныхРеквизитовЗавершение", 
		ЭтотОбъект);
	ОткрытьРедакторКода(ОповещениеОЗавершении, ПараметрыОткрытияРедактора);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьАлгоритмСозданияНовогоДокумента(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.ИмяОбъектаМетаданных) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Не выбрано имя документа'"), , 
			"Объект.СинонимОбъектаМетаданных");
		Возврат;
	КонецЕсли;
	
	ПараметрыОткрытияРедактора = SUI_РедакторКодаКлиент.ПараметрыОткрытия(
		Объект.АлгоритмСозданияНовогоДокумента);
	
	ПараметрыОткрытияРедактора.ЗапретРедактированияПриОткрытии = Не Модифицированность;
	ПараметрыОткрытияРедактора.Заголовок = НСтр("ru = 'Алгоритм создания нового документа из ТСД'");
	ПараметрыОткрытияРедактора.Описание = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
		НСтр("ru = 'Алгоритм заполнения нового документа %1 созданного на ТСД.'"), 
		Объект.СинонимОбъектаМетаданных);
	
	ДобавитьОписаниеПеременныхАлгоритмаСозданияНовогоДокумента(ПараметрыОткрытияРедактора.ПользовательскиеОбъекты,
		Объект.ИмяОбъектаМетаданных, Объект.СинонимОбъектаМетаданных);
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ОткрытьАлгоритмСозданияНовогоДокументаЗавершение", ЭтотОбъект);
	ОткрытьРедакторКода(ОповещениеОЗавершении, ПараметрыОткрытияРедактора);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПереопределениеСтандартныхКоманад

&НаСервере
Процедура ЗаменитьСтандартныеКнопкиКоманднойПанели()
	
	Если Элементы.Найти("ФормаЗаписатьИЗакрыть") <> Неопределено Тогда
		
		Элементы.ФормаЗаписатьИЗакрыть.Видимость = Ложь;
		
		SUI_ЗаписатьИЗакрытьКоманда = Команды.Добавить("SUI_ЗаписатьИЗакрыть");
		SUI_ЗаписатьИЗакрытьКоманда.Действие = "SUI_ЗаписатьИЗакрыть";
		
		SUI_ЗаписатьИЗакрытьЭлемент = Элементы.Добавить("SUI_ЗаписатьИЗакрыть" , Тип("КнопкаФормы"), Элементы.ФормаКоманднаяПанель);
		SUI_ЗаписатьИЗакрытьЭлемент.Заголовок = "Записать и закрыть";
		SUI_ЗаписатьИЗакрытьЭлемент.ИмяКоманды = SUI_ЗаписатьИЗакрытьКоманда.Имя;
		SUI_ЗаписатьИЗакрытьЭлемент.КнопкаПоУмолчанию = Истина;
		
		Элементы.Переместить(SUI_ЗаписатьИЗакрытьЭлемент, SUI_ЗаписатьИЗакрытьЭлемент.Родитель, Элементы.ФормаЗаписатьИЗакрыть);

	КонецЕсли;
	
	Если Элементы.Найти("ФормаЗаписать") <> Неопределено Тогда
		
		Элементы.ФормаЗаписать.Видимость = Ложь;
		
		SUI_ЗаписатьКоманда = Команды.Добавить("SUI_Записать");
		SUI_ЗаписатьКоманда.Действие = "SUI_Записать";
		
		SUI_ЗаписатьЭлемент = Элементы.Добавить("SUI_Записать" , Тип("КнопкаФормы"), Элементы.ФормаКоманднаяПанель);
		SUI_ЗаписатьЭлемент.Заголовок = "Записать";
		SUI_ЗаписатьЭлемент.ИмяКоманды = SUI_ЗаписатьКоманда.Имя;
		
		Элементы.Переместить(SUI_ЗаписатьЭлемент, SUI_ЗаписатьЭлемент.Родитель, Элементы.ФормаЗаписать);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодтверждениеЗакрытияЗавершение(Результат = Неопределено, ДополнительныеПараметры) Экспорт
	
	ПараметрыЗаписи = Новый Структура();
	ПараметрыЗаписи.Вставить("SUI_Закрыть");
	
	Если Записать(ПараметрыЗаписи) Тогда
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросПередЗаписьюЗавершение(Результат, ПараметрыЗаписи) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		
		ПараметрыЗаписи.Вставить("SUI_ВопросПроверкиВыгруженныхДанныхЗадан");
		
		Если Записать(ПараметрыЗаписи) Тогда
			
			Если ПараметрыЗаписи.Свойство("SUI_Закрыть") Тогда
				Закрыть();
			КонецЕсли;
			
		КонецЕсли;

	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура ИнициализироватьФормуОбъекта()

	ЗаменитьСтандартныеКнопкиКоманднойПанели();
	
	НастройкиСхемыКомпоновкиДанных = Неопределено;
	
	Для Каждого МетаданныеДокумента Из Метаданные.Документы Цикл
	
		Элементы.СинонимОбъектаМетаданных.СписокВыбора.Добавить(МетаданныеДокумента.Имя, МетаданныеДокумента.Синоним);

	КонецЦикла;
	
	Если ЭтоНовый И ЗначениеЗаполнено(Объект.ИмяОбъектаМетаданных) Тогда
		
		Объект.СинонимОбъектаМетаданных = Объект.ИмяОбъектаМетаданных;
		
		Если Не ЗначениеЗаполнено(Объект.Наименование) Тогда
			Объект.Наименование = Объект.СинонимОбъектаМетаданных;
		КонецЕсли;
		
	КонецЕсли;
	
	ИнициализироватьСпискиВыбора();
	
	Если ЭтоНовый Тогда
		Объект.СостояниеДокументаПоУмолчанию = Перечисления.SUI_СостоянияДокументовОбмена.Новый;
	Иначе
		
		Для Каждого СоответствиеРеквизита Из Объект.СоответствияРеквизитов Цикл
			
			Если СоответствиеРеквизита.Ключ = "id_countragents" Тогда
				ИмяРеквизитаКонтрагент = СоответствиеРеквизита.Значение;
			КонецЕсли;
			
			Если СоответствиеРеквизита.Ключ = "id_warehouse" Тогда
				ИмяРеквизитаСклад = СоответствиеРеквизита.Значение;
			КонецЕсли;
			
		КонецЦикла;

		ТекущийОбъект = РеквизитФормыВЗначение("Объект", Тип("СправочникОбъект.SUI_НастройкиДокументов"));
		
		НастройкиСхемыКомпоновкиДанных = ТекущийОбъект.НастройкиСхемыКомпоновкиДанных.Получить();
		
		ДополнительныеНастройки = ТекущийОбъект.ДополнительныеНастройки.Получить();
		
		Для Каждого РеквизитЗначение Из ТекущийОбъект.НастройкиЗаполненияРеквизитовПередЗаписью Цикл
		
			СтрокаЗаполненияРеквизитов = УстановкаРеквизитов.Добавить();
			СтрокаЗаполненияРеквизитов.РеквизитДокумента = РеквизитЗначение.Ключ;
			СтрокаЗаполненияРеквизитов.Значение = РеквизитЗначение.Значение.Получить();
			СтрокаЗаполненияРеквизитов.ПриРасхождении = РеквизитЗначение.ПриРасхождении;
		
		КонецЦикла;
		
		Для Каждого РеквизитЗначение Из ТекущийОбъект.НастройкиСозданияДокументовНаОснованииПослеЗаписи Цикл
		
			СтрокаЗаполненияРеквизитов = СозданиеДокументов.Добавить();
			СтрокаЗаполненияРеквизитов.Документ = РеквизитЗначение.Ключ;
		    СтрокаЗаполненияРеквизитов.ИмяМетаданныхДокумента = РеквизитЗначение.Значение;								
		    СтрокаЗаполненияРеквизитов.ПриРасхождении = РеквизитЗначение.ПриРасхождении;								
		    СтрокаЗаполненияРеквизитов.Проводить = РеквизитЗначение.Проводить;								
		      
		КонецЦикла;
		
	КонецЕсли;

	ИнициализироватьДополнительныеНастройки();
	
	ИнициализироватьКомпоновщикНастроек(НастройкиСхемыКомпоновкиДанных);
	
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьДополнительныеНастройки(Сбросить = Ложь)
	
	Если Сбросить Тогда
		ДополнительныеНастройки = Неопределено;
	КонецЕсли;
	
	Если ТипЗнч(ДополнительныеНастройки) <> Тип("Структура") Тогда
		ДополнительныеНастройки = Новый Структура();
	КонецЕсли;
	
	Если Не ДополнительныеНастройки.Свойство("АлгоритмыОбработкиСтрокТабличныхЧастей") Или
		ТипЗнч(ДополнительныеНастройки.АлгоритмыОбработкиСтрокТабличныхЧастей) <> Тип("Соответствие") Тогда
		ДополнительныеНастройки.Вставить("АлгоритмыОбработкиСтрокТабличныхЧастей", Новый Соответствие());
	КонецЕсли;
	 
	Если Не ДополнительныеНастройки.Свойство("АлгоритмыОбработкиСозданияДокументаНаОсновании") Или
		ТипЗнч(ДополнительныеНастройки.АлгоритмыОбработкиСозданияДокументаНаОсновании) <> Тип("Соответствие") Тогда
		ДополнительныеНастройки.Вставить("АлгоритмыОбработкиСозданияДокументаНаОсновании", Новый Соответствие());
	КонецЕсли;
	
	Если Не ДополнительныеНастройки.Свойство("ОбработчикиСобытий") Или
		ТипЗнч(ДополнительныеНастройки.ОбработчикиСобытий) <> Тип("Структура") Тогда
		ДополнительныеНастройки.Вставить("ОбработчикиСобытий", Новый Структура());
	КонецЕсли;
	
	Если Не ДополнительныеНастройки.ОбработчикиСобытий.Свойство("ПередЗаписью") Или
		ТипЗнч(ДополнительныеНастройки.ОбработчикиСобытий.ПередЗаписью) <> Тип("Строка") Тогда
		ДополнительныеНастройки.ОбработчикиСобытий.Вставить("ПередЗаписью", "");
	КонецЕсли;
	
	Если Не ДополнительныеНастройки.ОбработчикиСобытий.Свойство("ПослеЗаписи") Или
		ТипЗнч(ДополнительныеНастройки.ОбработчикиСобытий.ПослеЗаписи) <> Тип("Строка") Тогда
		ДополнительныеНастройки.ОбработчикиСобытий.Вставить("ПослеЗаписи", "");
	КонецЕсли;
	
	Если Не ДополнительныеНастройки.Свойство("ПараметрыИдентификацииСтрокТЧ") Или
		ТипЗнч(ДополнительныеНастройки.ПараметрыИдентификацииСтрокТЧ) <> Тип("Соответствие") Тогда
		ДополнительныеНастройки.Вставить("ПараметрыИдентификацииСтрокТЧ", Новый Соответствие());
	КонецЕсли;
	
	Если Не ДополнительныеНастройки.Свойство("ПолучениеДополнительныхРеквизитов") Или
		ТипЗнч(ДополнительныеНастройки.ПолучениеДополнительныхРеквизитов) <> Тип("Структура") Тогда
		ДополнительныеНастройки.Вставить("ПолучениеДополнительныхРеквизитов", Новый Структура());
	КонецЕсли;
	
	Если Не ДополнительныеНастройки.ПолучениеДополнительныхРеквизитов.Свойство("ИзДокумента") Или
		ТипЗнч(ДополнительныеНастройки.ПолучениеДополнительныхРеквизитов.ИзДокумента) <> Тип("ФиксированнаяСтруктура") Тогда
		ДополнительныеНастройки.ПолучениеДополнительныхРеквизитов.Вставить("ИзДокумента", 
			Новый ФиксированнаяСтруктура(SUI_КонструкторЗапросаКлиентСервер.ДанныеКонструктора()));
	КонецЕсли;
	
	Если Не ДополнительныеНастройки.ПолучениеДополнительныхРеквизитов.Свойство("ИзТабличныхЧастей") Или
		ТипЗнч(ДополнительныеНастройки.ПолучениеДополнительныхРеквизитов.ИзТабличныхЧастей) <> Тип("Соответствие") Тогда
		ДополнительныеНастройки.ПолучениеДополнительныхРеквизитов.Вставить("ИзТабличныхЧастей", Новый Соответствие());
	КонецЕсли;
	
	Если Не ДополнительныеНастройки.Свойство("ПропускатьПриЗаписи") Или
		ТипЗнч(ДополнительныеНастройки.ПропускатьПриЗаписи) <> Тип("Соответствие") Тогда
		ДополнительныеНастройки.Вставить("ПропускатьПриЗаписи", Новый Соответствие());
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьСпискиВыбора()
	
	РеквизитыДокумента = Новый Массив;
	
	Если ЗначениеЗаполнено(Объект.ИмяОбъектаМетаданных) Тогда
		
		Для Каждого МетаданныеРеквизитаДокумента Из Метаданные.Документы[Объект.ИмяОбъектаМетаданных].Реквизиты Цикл
			РеквизитыДокумента.Добавить(МетаданныеРеквизитаДокумента.Имя);
		КонецЦикла;
		
	КонецЕсли;
	
	Элементы.ИмяРеквизитаКонтрагент.СписокВыбора.ЗагрузитьЗначения(РеквизитыДокумента);
	
	Элементы.ИмяРеквизитаСклад.СписокВыбора.ЗагрузитьЗначения(РеквизитыДокумента);
	
	//Сандалов_11.03.2024 11:50:25_++
	Элементы.УстановкаРеквизитовРеквизитДокумента.СписокВыбора.ЗагрузитьЗначения(РеквизитыДокумента);
	//Сандалов_11.03.2024 11:50:30_--
	//Сандалов_11.03.2024 11:50:25_++
	Элементы.НастройкаВыводаДополнительныхПолейРеквизитДокумета.СписокВыбора.ЗагрузитьЗначения(РеквизитыДокумента);
	//Сандалов_11.03.2024 11:50:30_--
	ИнициализироватьДокументыДляВводаНаОсновании();
	
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьКомпоновщикНастроек(Знач НастройкиСхемыКомпоновкиДанных = Неопределено)
	
	Если Не ЗначениеЗаполнено(Объект.ИмяОбъектаМетаданных) Тогда
		Возврат;
	КонецЕсли;
	
	СхемаКомпоновкиДанных = Справочники.SUI_НастройкиДокументов.СформироватьСхемуКомпоновкиДанных(Объект.ИмяОбъектаМетаданных);
	
	Если СхемаКомпоновкиДанных = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(НастройкиСхемыКомпоновкиДанных) = Тип("Строка") И ЭтоАдресВременногоХранилища(НастройкиСхемыКомпоновкиДанных) Тогда
		НастройкиСхемыКомпоновкиДанных = ПолучитьИзВременногоХранилища(НастройкиСхемыКомпоновкиДанных);
	КонецЕсли;
	
	Если ТипЗнч(НастройкиСхемыКомпоновкиДанных) = Тип("НастройкиКомпоновкиДанных") Тогда
		SUI_КомпоновкаДанныхСервер.ИнициализироватьКомпоновщикНастроек(КомпоновщикНастроек, СхемаКомпоновкиДанных, НастройкиСхемыКомпоновкиДанных);
	Иначе
		SUI_КомпоновкаДанныхСервер.ИнициализироватьКомпоновщикНастроек(КомпоновщикНастроек, СхемаКомпоновкиДанных);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОтображениеЭлементовФормыОбъекта()
	
	Если КомпоновщикНастроек.Настройки.Отбор.Элементы.Количество() = 0 Тогда
		Элементы.ОткрытьНастройкиОтбора.Заголовок = НСтр("ru = '<настройки отбора не установлены>'");
	Иначе
		Элементы.ОткрытьНастройкиОтбора.Заголовок = НСтр("ru = 'настройки отбора'");
	КонецЕсли;
	
	// Документ.SUI_СборШтрихкодов Начало
	ЭтоДокументСборШК = (Объект.ИмяОбъектаМетаданных = "SUI_СборШтрихкодов");
	Элементы.СтраницаНастройкиТабличныхЧастей.Видимость = Не ЭтоДокументСборШК;
	Элементы.ГруппаИспользуетсяМаркировка.Видимость = Не ЭтоДокументСборШК;
	Элементы.КонтролироватьДокумент.Видимость = Не ЭтоДокументСборШК;
	Элементы.ГрупповоеСканирование.Видимость = Не ЭтоДокументСборШК;
	Элементы.ГруппаСопоставлениеРеквизитов.Видимость = Не ЭтоДокументСборШК;
	Элементы.СтраницаСозданиеДокументовНаОсновании.Видимость = Не ЭтоДокументСборШК;
	// Документ.SUI_СборШтрихкодов Конец
	
	// 20.09.2024 - artem - B119267 -
	Элементы.Агрегация.Видимость = Объект.ComputerVision;
	
	Элементы.ЗавершатьДокумент1СПослеПолученияИзТСД.Видимость = Объект.ЗагружатьВДокумент1СПослеПолученияИзТСД;
	
	// 30.09.2024 - artem - В120927
	Элементы.ОткрытьАлгоритмСозданияНовогоДокумента.Видимость = Объект.СоздаватьДокументыНаТСД;
	
КонецПроцедуры

&НаСервере
Процедура СинонимОбъектаМетаданныхОбработкаВыбораНаСервере(ВыбранноеЗначение)

	МетаданныеДокумента = Метаданные.Документы.Найти(ВыбранноеЗначение);

	Если МетаданныеДокумента = Неопределено Тогда
		Объект.ИмяОбъектаМетаданных = "";
		Объект.СинонимОбъектаМетаданных = "";
	Иначе
		Объект.ИмяОбъектаМетаданных = МетаданныеДокумента.Имя;
		Объект.СинонимОбъектаМетаданных = МетаданныеДокумента.Синоним;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Объект.Наименование) Тогда
		Объект.Наименование = Объект.СинонимОбъектаМетаданных;
	КонецЕсли;
	
	ИнициализироватьСпискиВыбора();
	
	ИнициализироватьКомпоновщикНастроек();

КонецПроцедуры

&НаСервере
Процедура СостояниеДокументаПоУмолчаниюНачалоВыбораНаСервере(ДанныеВыбора)
	
	ДанныеВыбора = Новый СписокЗначений();
	
	ДанныеВыбора.Добавить(Перечисления.SUI_СостоянияДокументовОбмена.Новый);
	ДанныеВыбора.Добавить(Перечисления.SUI_СостоянияДокументовОбмена.КВыгрузке);
	
КонецПроцедуры

