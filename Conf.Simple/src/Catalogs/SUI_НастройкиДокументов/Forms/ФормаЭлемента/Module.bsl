КонецПроцедуры

&НаКлиенте
Процедура ОткрытьНастройкиИдентификацииСтрокТЧ(Команда)

	Если Элементы.НастройкиТабличныхЧастей.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ИмяОбъектаМетаданных) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не выбрано имя документа 1С'"), , 
			"Объект.СинонимОбъектаМетаданных");
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Элементы.НастройкиТабличныхЧастей.ТекущиеДанные.ИмяТабличнойЧасти) Или
		Не СтроковыеФункцииКлиентСервер.ЭтоУникальныйИдентификатор(Элементы.НастройкиТабличныхЧастей.ТекущиеДанные.КлючСвязи) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не выбрана табличная часть'"), , 
			"Объект.НастройкиТабличныхЧастей");
		Возврат;
	КонецЕсли;
	
	ПараметрыИдентификацииСтрокТЧ = SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДополнительныеНастройки, 
		"ПараметрыИдентификацииСтрокТЧ", Новый Соответствие(), Тип("Соответствие"));
	
	ПараметрыЗавершенияОткрытия = Новый Структура("КлючСвязи, ТипТаблицы", 
		Элементы.НастройкиТабличныхЧастей.ТекущиеДанные.КлючСвязи,
		Элементы.НастройкиТабличныхЧастей.ТекущиеДанные.ТипТаблицы);
	
	ПараметрыОткрытияИдентификацииСтрок = Новый Структура();
	ПараметрыОткрытияИдентификацииСтрок.Вставить("ИмяОбъектаМетаданных", Объект.ИмяОбъектаМетаданных);
	ПараметрыОткрытияИдентификацииСтрок.Вставить("ИмяТабличнойЧасти", 
		Элементы.НастройкиТабличныхЧастей.ТекущиеДанные.ИмяТабличнойЧасти);
	ПараметрыОткрытияИдентификацииСтрок.Вставить("ПараметрыИдентификацииСтрокТЧ", 
		ПараметрыИдентификацииСтрокТЧ.Получить(ПараметрыЗавершенияОткрытия.ТипТаблицы));

	ОповещениеОЗавершении = Новый ОписаниеОповещения("ОткрытьНастройкиИдентификацииСтрокТЧЗавершение", ЭтотОбъект,
		ПараметрыЗавершенияОткрытия);

	ОткрытьФорму("Справочник.SUI_НастройкиДокументов.Форма.ФормаНастройкиИдентификацииСтрокТЧ", 
		ПараметрыОткрытияИдентификацииСтрок, ЭтотОбъект, УникальныйИдентификатор, , , ОповещениеОЗавершении,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьАлгоритмПолученияПризнакаМаркировки(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.ИмяОбъектаМетаданных) Тогда
