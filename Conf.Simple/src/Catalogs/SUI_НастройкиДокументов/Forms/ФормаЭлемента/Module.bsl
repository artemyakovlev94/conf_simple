#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыНастройкиТабличныхЧастей

&НаКлиенте
Процедура НастройкиТабличныхЧастейПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Если Не ЗначениеЗаполнено(Объект.ИмяОбъектаМетаданных) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не выбрано имя документа 1С'"), , 
			"Объект.СинонимОбъектаМетаданных", , Отказ);
	Иначе
		Отказ = Истина;
		ОткрытьНастройкиТабличнойЧасти(Строка(Новый УникальныйИдентификатор));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиТабличныхЧастейВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Элемент.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекДанные = Элемент.ТекущиеДанные;
	
	Если Поле.Имя = "АлгоритмОбработкиСтрокПредставление" Тогда
		
		Если Не ЗначениеЗаполнено(Объект.ИмяОбъектаМетаданных) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(
				НСтр("ru = 'Не выбрано имя документа'"), , 
				"Объект.СинонимОбъектаМетаданных");
			Возврат;
		КонецЕсли;
		
		ПараметрыОткрытияРедактора = SUI_РедакторКодаКлиент.ПараметрыОткрытия(
			ДополнительныеНастройки.АлгоритмыОбработкиСтрокТабличныхЧастей.Получить(ТекДанные.ТипТаблицы));
		
		ПараметрыОткрытияРедактора.ЗапретРедактированияПриОткрытии = Не Модифицированность;
		ПараметрыОткрытияРедактора.Заголовок = СтрШаблон(НСтр("ru = 'Обработка строки табличной части ""%1""'"),
			ТекДанные.ИмяТабличнойЧасти);
		ПараметрыОткрытияРедактора.Описание = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
			НСтр("ru = 'Алгоритм выполняемый после обновления данных в строке табличной части <span style=""color: ГиперссылкаЦвет"">%1</span> документа <span style=""color: ГиперссылкаЦвет"">%2</span>
			|или заполните предопределенным по кнопке <span style=""color: ГиперссылкаЦвет"">Предопределенный</span>'"), 
			ТекДанные.ИмяТабличнойЧасти, Объект.СинонимОбъектаМетаданных);
			
		ПараметрыПредопределенногоАлгоритма = Новый Структура();
		ПараметрыПредопределенногоАлгоритма.Вставить("ИмяОбъектаМетаданных", Объект.ИмяОбъектаМетаданных);
		
		Если ТекДанные.ТипТаблицы = ПредопределенноеЗначение("Перечисление.SUI_ТипыТаблицДокументовОбмена.Товары") Тогда
			ПараметрыПредопределенногоАлгоритма.Вставить("ЭтоТовары");
		ИначеЕсли ТекДанные.ТипТаблицы = ПредопределенноеЗначение("Перечисление.SUI_ТипыТаблицДокументовОбмена.Отбор") Тогда
			ПараметрыПредопределенногоАлгоритма.Вставить("ЭтоОтбор");
		ИначеЕсли ТекДанные.ТипТаблицы = ПредопределенноеЗначение("Перечисление.SUI_ТипыТаблицДокументовОбмена.Размещение") Тогда
			ПараметрыПредопределенногоАлгоритма.Вставить("ЭтоРазмещение");
		ИначеЕсли ТекДанные.ТипТаблицы = ПредопределенноеЗначение("Перечисление.SUI_ТипыТаблицДокументовОбмена.ШтрихкодыУпаковок") Тогда
			ПараметрыПредопределенногоАлгоритма.Вставить("ЭтоШтрихкодыУпаковок");
		КонецЕсли;
		
		ПараметрыОткрытияРедактора.ПредопределенныйТекст = SUI_НастройкиДокументовКлиентСервер
			.ПолучитьПроизвольныйАлгоритмОбработкиСтрокДокумента(ПараметрыПредопределенногоАлгоритма);
		
		ДобавитьОписаниеПеременныхАлгоритмаОбработкиСтрок(
			ПараметрыОткрытияРедактора.ПользовательскиеОбъекты, 
			Объект.ИмяОбъектаМетаданных, 
			Объект.СинонимОбъектаМетаданных,
			ТекДанные.ИмяТабличнойЧасти);
		
		Контекст = Новый Структура();
		Контекст.Вставить("ТипТаблицы", ТекДанные.ТипТаблицы);
		
		ОповещениеОЗавершении = Новый ОписаниеОповещения("ОткрытьАлгоритмОбработкиСтрокЗавершение", ЭтотОбъект, Контекст);
		ОткрытьРедакторКода(ОповещениеОЗавершении, ПараметрыОткрытияРедактора);
		
	ИначеЕсли Поле.Имя = "НастройкиТабличныхЧастейТипТаблицы" Или
		Поле.Имя = "НастройкиТабличныхЧастейИмяТабличнойЧасти" Тогда
		ОткрытьНастройкиТабличнойЧасти(ТекДанные.КлючСвязи);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура НастройкиТабличныхЧастейПередУдалением(Элемент, Отказ)
	
	Если Элемент.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НайденныйАлгоритм = ДополнительныеНастройки.АлгоритмыОбработкиСтрокТабличныхЧастей.Получить(
		Элемент.ТекущиеДанные.ТипТаблицы);
	
	Если НайденныйАлгоритм <> Неопределено Тогда
		ДополнительныеНастройки.АлгоритмыОбработкиСтрокТабличныхЧастей.Удалить(НайденныйАлгоритм);
		Модифицированность = Истина;
	КонецЕсли; 
	
	
	ПараметрИдентификацииСтрокТЧ = ДополнительныеНастройки.ПараметрыИдентификацииСтрокТЧ.Получить(
		Элемент.ТекущиеДанные.ТипТаблицы);
	
	Если ПараметрИдентификацииСтрокТЧ <> Неопределено Тогда
		ДополнительныеНастройки.ПараметрыИдентификацииСтрокТЧ.Удалить(ПараметрИдентификацииСтрокТЧ);
		Модифицированность = Истина;
	КонецЕсли;
	
	ПолучениеДопРеквизитовТЧ = ДополнительныеНастройки.ПолучениеДополнительныхРеквизитов.ИзТабличныхЧастей.Получить(
		Элемент.ТекущиеДанные.ТипТаблицы);
	Если ПолучениеДопРеквизитовТЧ <> Неопределено Тогда
		ДополнительныеНастройки.ПолучениеДополнительныхРеквизитов.ИзТабличныхЧастей.Удалить(ПолучениеДопРеквизитовТЧ);
		Модифицированность = Истина;
	КонецЕсли;
	
	НайденныйПризнакЗаписи = ДополнительныеНастройки.ПропускатьПриЗаписи.Получить(Элемент.ТекущиеДанные.ИмяТабличнойЧасти);
	
	Если НайденныйПризнакЗаписи <> Неопределено Тогда
		ДополнительныеНастройки.ПропускатьПриЗаписи.Удалить(НайденныйПризнакЗаписи);
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиТабличныхЧастейПослеУдаления(Элемент)
	НастройкиТабличныхЧастейПослеУдаленияНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура НастройкиТабличныхЧастейПропускатьПриЗаписиПриИзменении(Элемент)
	
	Если Элементы.НастройкиТабличныхЧастей.ТекущиеДанные <> Неопределено Тогда
		ДополнительныеНастройки.ПропускатьПриЗаписи.Вставить(Элементы.НастройкиТабличныхЧастей.ТекущиеДанные.ТипТаблицы, Элементы.НастройкиТабличныхЧастей.ТекущиеДанные.ПропускатьПриЗаписи);			
	КонецЕсли;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановкаРеквизитовРеквизитДокументаОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, СтандартнаяОбработка)
	УстановитьТипЗначенияПоРеквизиту(ВыбранноеЗначение); 
КонецПроцедуры          

&НаКлиенте
Процедура СозданиеДокументовДокументОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, СтандартнаяОбработка)
	
	Если Элементы.СозданиеДокументов.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураВыбранногоДокумента = СозданиеДокументовДокументОбработкаВыбораНаСервере(ВыбранноеЗначение);
	
	Модифицированность = Истина;
	
	Элементы.СозданиеДокументов.ТекущиеДанные.ИмяМетаданныхДокумента = СтруктураВыбранногоДокумента.Имя;	
	Элементы.СозданиеДокументов.ТекущиеДанные.Документ = СтруктураВыбранногоДокумента.Синоним;
	ДополнительныеНастройки.АлгоритмыОбработкиСозданияДокументаНаОсновании.Вставить(СтруктураВыбранногоДокумента.Имя, "");
    Элемент.ОбновитьТекстРедактирования();
	ОбновитьНадписьГиперссылкиДополнительныйОбработчикДокументов();
	
КонецПроцедуры

&НаКлиенте
Процедура СозданиеДокументовПередУдалением(Элемент, Отказ)
	
	Если Элемент.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НайденныйОбработчик = ДополнительныеНастройки.АлгоритмыОбработкиСозданияДокументаНаОсновании.Получить(
		Элемент.ТекущиеДанные.ИмяМетаданныхДокумента);
	
	Если НайденныйОбработчик <> Неопределено Тогда
		ДополнительныеНастройки.АлгоритмыОбработкиСозданияДокументаНаОсновании.Удалить(Элемент.ТекущиеДанные.Документ);
		Модифицированность = Истина;
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура СозданиеДокументовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Элемент.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекДанные = Элемент.ТекущиеДанные;
	
	Если Поле.Имя = "СозданиеДокументовОбработчик" Тогда
		
		Если Не ЗначениеЗаполнено(Объект.ИмяОбъектаМетаданных) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(
				НСтр("ru = 'Не выбрано имя документа'"), , 
				"Объект.СинонимОбъектаМетаданных");
			Возврат;
		КонецЕсли;
		
		ПараметрыОткрытияРедактора = SUI_РедакторКодаКлиент.ПараметрыОткрытия(
			ДополнительныеНастройки.АлгоритмыОбработкиСозданияДокументаНаОсновании.Получить(ТекДанные.Документ));
		
		ПараметрыОткрытияРедактора.ЗапретРедактированияПриОткрытии = Не Модифицированность;
		ПараметрыОткрытияРедактора.Заголовок = СтрШаблон(НСтр("ru = 'Создание на основании ""%1""'"),
			ТекДанные.Документ);
		ПараметрыОткрытияРедактора.Описание = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
			НСтр("ru = 'Алгоритм заполнения документа <span style=""color: ГиперссылкаЦвет"">%1</span> созданного на основании документа <span style=""color: ГиперссылкаЦвет"">%2</span>.'"), 
				ТекДанные.Документ, Объект.СинонимОбъектаМетаданных);
		
		ДобавитьОписаниеПеременныхАлгоритмаСозданияНаОсновании(
			ПараметрыОткрытияРедактора.ПользовательскиеОбъекты, 
			ТекДанные.Документ, 
			ТекДанные.Документ);
		
		Контекст = Новый Структура();
		Контекст.Вставить("ИмяМетаданныхСоздаваемогоДокумента", ТекДанные.Документ);
		
		ОповещениеОЗавершении = Новый ОписаниеОповещения("ОткрытьАлгоритмСозданиеНаОснованииЗавершение", 
			ЭтотОбъект, Контекст);
		ОткрытьРедакторКода(ОповещениеОЗавершении, ПараметрыОткрытияРедактора);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкаВыводаДополнительныхПолейИмяНаУстройствеОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка) 
	
	Элементы.НастройкаВыводаДополнительныхПолей.ТекущиеДанные.ИмяНаУстройстве = SUI_СтроковыеФункцииКлиентСервер.ПривестиСтрокуКРазрешеннымСимволам(Текст, РазрешенныеСимволы);

КонецПроцедуры

