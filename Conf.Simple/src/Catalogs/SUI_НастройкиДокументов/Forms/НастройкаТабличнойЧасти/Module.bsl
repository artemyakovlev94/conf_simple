&НаСервере
Процедура ЗагрузитьЗначенияТаблицыСопоставленияРеквизитовТЧ(ТаблицаКЗагрузке)
	
	Для Каждого СтрокаТаблицыКЗагрузке Из ТаблицаКЗагрузке Цикл
		
		НайденныеСтроки = СопоставлениеРеквизитовТЧ.НайтиСтроки(
			Новый Структура("ТипТаблицы, Поле", ТипТаблицы, СтрокаТаблицыКЗагрузке.Поле));
		
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			
			НайденнаяСтрока.ИмяРеквизита = СтрокаТаблицыКЗагрузке.ИмяРеквизита;
			
			Если Не ЗначениеЗаполнено(НайденнаяСтрока.ИмяРеквизита) Тогда
				НайденнаяСтрока.ИспользуетсяПостоянноеЗначение = СтрокаТаблицыКЗагрузке.ИспользуетсяПостоянноеЗначение;
				НайденнаяСтрока.ПостоянноеЗначение = СтрокаТаблицыКЗагрузке.ПостоянноеЗначение;
			КонецЕсли; 
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьСписокВыбораЗначений()
	
	СписокВыбораРеквизитов.Очистить();
	Элементы.СопоставлениеРеквизитовТЧИмяРеквизита.СписокВыбора.Очистить();
	
	МетаданныеДокумента = Метаданные.Документы.Найти(ИмяДокумента);
	
	Если МетаданныеДокумента = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	МетаданныеТЧ = МетаданныеДокумента.ТабличныеЧасти.Найти(ИмяТабличнойЧасти);
	
	Если МетаданныеТЧ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого МетаданныеРеквизитаТЧ Из МетаданныеТЧ.Реквизиты Цикл
		СписокВыбораРеквизитов.Добавить(МетаданныеРеквизитаТЧ.Имя, МетаданныеРеквизитаТЧ.Синоним);
		Элементы.СопоставлениеРеквизитовТЧИмяРеквизита.СписокВыбора.Добавить(
			МетаданныеРеквизитаТЧ.Имя, МетаданныеРеквизитаТЧ.Синоним);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДоступностьИВидимостьЭлементов()
	
	Элементы.ИмяТабличнойЧасти.Доступность = ЗначениеЗаполнено(ТипТаблицы);
	Элементы.СопоставлениеРеквизитовТЧ.Доступность = (ЗначениеЗаполнено(ТипТаблицы) И ЗначениеЗаполнено(ИмяТабличнойЧасти));
	
	Элементы.ГруппаДополнительныеРеквизиты.Доступность = Ложь;
	Элементы.ГруппаПризнакИспользованияМаркировки.Доступность = Ложь;
	
	Если ЗначениеЗаполнено(ИмяТабличнойЧасти) И
		(ТипТаблицы = ПредопределенноеЗначение("Перечисление.SUI_ТипыТаблицДокументовОбмена.Товары") Или 
		ТипТаблицы = ПредопределенноеЗначение("Перечисление.SUI_ТипыТаблицДокументовОбмена.Отбор") Или 
		ТипТаблицы = ПредопределенноеЗначение("Перечисление.SUI_ТипыТаблицДокументовОбмена.Размещение") Или 
		ТипТаблицы = ПредопределенноеЗначение("Перечисление.SUI_ТипыТаблицДокументовОбмена.Серии") Или 
		ТипТаблицы = ПредопределенноеЗначение("Перечисление.SUI_ТипыТаблицДокументовОбмена.ШтрихкодыУпаковок")) Тогда
		
		Элементы.ГруппаДополнительныеРеквизиты.Доступность = Истина;
		
		Если ТипТаблицы = ПредопределенноеЗначение("Перечисление.SUI_ТипыТаблицДокументовОбмена.Товары") Или 
			ТипТаблицы = ПредопределенноеЗначение("Перечисление.SUI_ТипыТаблицДокументовОбмена.Отбор") Или 
			ТипТаблицы = ПредопределенноеЗначение("Перечисление.SUI_ТипыТаблицДокументовОбмена.Размещение") Тогда
			Элементы.ГруппаПризнакИспользованияМаркировки.Доступность = Истина;
		КонецЕсли;

	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьЗначенияСопоставленныхРеквизитов()
	
	НайденныеСтроки = СопоставлениеРеквизитовТЧ.НайтиСтроки(Новый Структура("ТипТаблицы", ТипТаблицы));
	
	Для Индекс = 0 По НайденныеСтроки.ВГраница() Цикл
		
		Если Не ПустаяСтрока(НайденныеСтроки[Индекс].ИмяРеквизита) И
			СписокВыбораРеквизитов.НайтиПоЗначению(НайденныеСтроки[Индекс].ИмяРеквизита) = Неопределено Тогда
			НайденныеСтроки[Индекс].ИмяРеквизита = "";
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьЗаполнениеРеквизитов()
	
	ОчиститьСообщения();
	
	Ошибки = Новый Массив();
	
	Если Не ЗначениеЗаполнено(ТипТаблицы) Тогда
		Ошибки.Добавить(НСтр("ru = 'Не выбран тип таблицы.'"));
		Поле = "ТипТаблицы";
	ИначеЕсли Не ЗначениеЗаполнено(ИмяТабличнойЧасти) Тогда
		Ошибки.Добавить(НСтр("ru = 'Не выбрано имя табличной части.'"));
		Поле = "ИмяТабличнойЧасти";
	Иначе
		
		НайденныеСтроки = СопоставлениеРеквизитовТЧ.НайтиСтроки(Новый Структура("ТипТаблицы, ОбязательноеЗаполнение", ТипТаблицы, Истина));
		
		Для Индекс = 0 По НайденныеСтроки.ВГраница() Цикл
			
			Если Не ЗначениеЗаполнено(НайденныеСтроки[Индекс].ИмяРеквизита) Тогда
				
				Если НайденныеСтроки[Индекс].ИспользуетсяПостоянноеЗначение Тогда
					
					Если НайденныеСтроки[Индекс].ПостоянноеЗначение = Неопределено Тогда
						Ошибки.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
							НСтр("ru = 'Для поля %1 не выбран тип постоянного значения.'"), НайденныеСтроки[Индекс].ПредставлениеПоля));
					КонецЕсли;
					
				Иначе
					Ошибки.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru = 'Для поля %1 не сопоставлен реквизит табличной части.'"), НайденныеСтроки[Индекс].ПредставлениеПоля));
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Поле = "СопоставлениеРеквизитовТЧ";
		
	КонецЕсли;
	
	Для Индекс = 0 По Ошибки.ВГраница() Цикл
		ОбщегоНазначенияКлиент.СообщитьПользователю(Ошибки[Индекс], , Поле);
	КонецЦикла;
		
	Возврат Ошибки.Количество() = 0;
	
КонецФункции

&НаКлиенте
Процедура СохранитьИЗакрыть()
	
	Если ПроверитьЗаполнениеРеквизитов() Тогда
		ПараметрыЗакрытия = ПодготовитьПараметрыЗакрытия();
		Модифицированность = Ложь;
		Закрыть(ПараметрыЗакрытия);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПодготовитьПараметрыЗакрытия()
	
	ПараметрыЗакрытия = Новый Структура();
	
	ПараметрыЗакрытия.Вставить("КлючСвязи", КлючСвязи);
	ПараметрыЗакрытия.Вставить("ИмяДокумента", ИмяДокумента);
	ПараметрыЗакрытия.Вставить("ТипТаблицы", ТипТаблицы);
	ПараметрыЗакрытия.Вставить("ИмяТабличнойЧасти", ИмяТабличнойЧасти);
	ПараметрыЗакрытия.Вставить("АлгоритмПолученияДополнительныхРеквизитов", АлгоритмПолученияДополнительныхРеквизитов);
	ПараметрыЗакрытия.Вставить("АлгоритмПолученияПризнакаМаркировки", АлгоритмПолученияПризнакаМаркировки);
	ПараметрыЗакрытия.Вставить("АлгоритмПолученияСтатусаУказанияСерии", АлгоритмПолученияСтатусаУказанияСерии);
	
	НайденныеСтроки = СопоставлениеРеквизитовТЧ.НайтиСтроки(Новый Структура("ТипТаблицы", ТипТаблицы));
	СопоставленияРеквизитов = СопоставлениеРеквизитовТЧ.Выгрузить(
		НайденныеСтроки, "Поле,ИмяРеквизита,ИспользуетсяПостоянноеЗначение,ПостоянноеЗначение");
	
	ПараметрыЗакрытия.Вставить("СопоставленияРеквизитов", ПоместитьВоВременноеХранилище(СопоставленияРеквизитов));
	
	Возврат ПараметрыЗакрытия;
	
КонецФункции

&НаКлиенте
Процедура ВопросСохраненияПередЗакрытиемЗавершение(Ответ, ДополнительныеПараметры) Экспорт 
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		Модифицированность = Ложь;
		Закрыть();
	Иначе 
		СохранитьИЗакрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьЗаголовокФормы()

	СинонимТипТаблицы = ?(ЗначениеЗаполнено(ТипТаблицы), Строка(ТипТаблицы), "Настройка табличной части");
	СинонимДокумента = "";
	СинонимТЧ = "";
	
	МетаданныеДокумента = Метаданные.Документы.Найти(ИмяДокумента);
	
	Если МетаданныеДокумента <> Неопределено Тогда
		СинонимДокумента = МетаданныеДокумента.Синоним;
		МетаданныеТЧ = МетаданныеДокумента.ТабличныеЧасти.Найти(ИмяТабличнойЧасти);
		Если МетаданныеТЧ <> Неопределено Тогда
			СинонимТЧ = МетаданныеТЧ.Синоним;
		КонецЕсли;
	КонецЕсли;
	
	Если Не ПустаяСтрока(СинонимДокумента) И Не ПустаяСтрока(СинонимТЧ) Тогда
		Заголовок = СинонимТипТаблицы + ": " + СинонимТЧ + " (" + СинонимДокумента + ")";
	ИначеЕсли Не ПустаяСтрока(СинонимДокумента) И ПустаяСтрока(СинонимТЧ) Тогда
		Заголовок = СинонимТипТаблицы + " (" + СинонимДокумента + ")";
	ИначеЕсли ПустаяСтрока(СинонимДокумента) И Не ПустаяСтрока(СинонимТЧ) Тогда
		Заголовок = СинонимТипТаблицы + ": " + СинонимТЧ;
	Иначе
		Заголовок = СинонимТипТаблицы;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ГиперссылкаРедактироватьАлгоритмПризнакПолученияМаркировкиНажатиеЗавершение(Алгоритм, ДополнительныеПараметры) Экспорт
	
	Если Алгоритм = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	АлгоритмПолученияПризнакаМаркировки = Алгоритм;
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьОписаниеПеременныхАлгоритма(ПользовательскиеОбъекты, ИмяДокумента, ИмяТабличнойЧасти)
	
	// Описание переменных: Параметры
	ПользовательскийОбъектПараметры = SUI_РедакторКодаКлиентСервер.ДобавитьПользовательскийОбъект(
		ПользовательскиеОбъекты, 
		"Параметры", 
		НСтр("ru = 'Входные параметры'"),
		Тип("Структура"),
		Тип("Структура"));
	
	// Описание переменных: Параметры.ДанныеСтроки
	ПользовательскийОбъект = SUI_РедакторКодаКлиентСервер.ДобавитьСвойствоПользовательскогоОбъекта(
		ПользовательскийОбъектПараметры, 
		"ДанныеСтроки",
		"ДанныеСтроки", 
		СтрШаблон(НСтр("ru = 'Данные строки табличной части %1'"), ИмяТабличнойЧасти),
		Тип("Структура"));
	
	ОписаниеРеквизитов = SUI_НастройкиДокументовПовтИсп.ОписаниеРеквизитовДокумента(ИмяДокумента);
	ОписаниеРеквизитов = ОписаниеРеквизитов.Строки.Найти("ТабличныеЧасти", "Имя", Ложь);
	
	Если ОписаниеРеквизитов <> Неопределено Тогда
		ОписаниеРеквизитов = ОписаниеРеквизитов.Строки.Найти(ИмяТабличнойЧасти, "Имя", Ложь);
	КонецЕсли;
	
	Если ОписаниеРеквизитов <> Неопределено Тогда
		
		Для Каждого ОписаниеРеквизитаТЧ Из ОписаниеРеквизитов.Строки Цикл
			
			SUI_РедакторКодаКлиентСервер.ДобавитьСвойствоПользовательскогоОбъекта(
				ПользовательскийОбъект, 
				ОписаниеРеквизитаТЧ.Имя,
				ОписаниеРеквизитаТЧ.Синоним,
				ОписаниеРеквизитаТЧ.Представление,
				SUI_ОбщегоНазначенияПереопределяемый.СтроковоеПредставлениеТипа(ОписаниеРеквизитаТЧ.Тип),
				,
				Истина);
			
		КонецЦикла;
		
	КонецЕсли;
	
	// Описание переменных: Параметры.Результат
	SUI_РедакторКодаКлиентСервер.ДобавитьСвойствоПользовательскогоОбъекта(
		ПользовательскийОбъектПараметры, 
		"Результат",
		"Результат",
		НСтр("ru = 'Результат выполнения алгоритма'"),
		"Булево",
		Тип("Булево"));
	
КонецПроцедуры

