	НоваяСтрока.ТипТаблицы = Перечисления.SUI_ТипыТаблицДокументовОбмена.Товары;
	НоваяСтрока.Поле = "Серия";
	НоваяСтрока.ПредставлениеПоля = "Серия";
	
	//TODO: Сандалов закомментировал на время тестирования
	//НоваяСтрока = СопоставлениеРеквизитовТЧ.Добавить();
	//НоваяСтрока.ТипТаблицы = Перечисления.SUI_ТипыТаблицДокументовОбмена.Товары;
	//НоваяСтрока.Поле = "СтатусУказанияСерий";
	//НоваяСтрока.ПредставлениеПоля = "Статус указания серий";
	
	НоваяСтрока = СопоставлениеРеквизитовТЧ.Добавить();
	НоваяСтрока.ТипТаблицы = Перечисления.SUI_ТипыТаблицДокументовОбмена.Товары;
	НоваяСтрока.Поле = "Упаковка";
	НоваяСтрока.ПредставлениеПоля = "Упаковка";
	
