	НоваяСтрока.ТипТаблицы = Перечисления.SUI_ТипыТаблицДокументовОбмена.Товары;
	НоваяСтрока.Поле = "ВидЦены";
	НоваяСтрока.ПредставлениеПоля = "Вид цены";
	
	НоваяСтрока = СопоставлениеРеквизитовТЧ.Добавить();
	НоваяСтрока.ТипТаблицы = Перечисления.SUI_ТипыТаблицДокументовОбмена.Товары;
	НоваяСтрока.Поле = "Цена";
	НоваяСтрока.ПредставлениеПоля = "Цена";
	
	НоваяСтрока = СопоставлениеРеквизитовТЧ.Добавить();
	НоваяСтрока.ТипТаблицы = Перечисления.SUI_ТипыТаблицДокументовОбмена.Товары;
