
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("КлючСвязи", КлючСвязи);
	Параметры.Свойство("ИмяДокумента", ИмяДокумента);
	Параметры.Свойство("ТипТаблицы", ТипТаблицы);
	Параметры.Свойство("ИмяТабличнойЧасти", ИмяТабличнойЧасти);
	
	Если Не СтроковыеФункцииКлиентСервер.ЭтоУникальныйИдентификатор(КлючСвязи) Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Не передан ключ связи.'"), , , , Отказ);
		Возврат;
	КонецЕсли;
	
	МетаданныеДокумента = Метаданные.Документы.Найти(ИмяДокумента);	
	Если МетаданныеДокумента = Неопределено Или Не Метаданные.Документы.Содержит(МетаданныеДокумента) Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Не удалось получить метаданные документа.'"), , , , Отказ);
		Возврат;
	КонецЕсли;
	
	ДоступныеТипыТаблиц.ЗагрузитьЗначения(SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(
		Параметры, "ДоступныеТипыТаблиц", Новый Массив(), Тип("Массив")));
		
	Если ДоступныеТипыТаблиц.Количество() = 0 Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Отсутствуют доступные типы таблиц.'"), , , , Отказ);
		Возврат;
	КонецЕсли;
	
	ИнициализироватьЗначенияКлючейТаблицыСопоставлениеРеквизитовТЧ();
	
	СоответствияРеквизитовТЧ = SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "СопоставленияРеквизитов", "", Тип("Строка")); 
	Если ЭтоАдресВременногоХранилища(СоответствияРеквизитовТЧ) Тогда
		
		ТаблицаКЗагрузке = ПолучитьИзВременногоХранилища(СоответствияРеквизитовТЧ);
		Если ТипЗнч(ТаблицаКЗагрузке) = Тип("ТаблицаЗначений") Тогда
			ЗагрузитьЗначенияТаблицыСопоставленияРеквизитовТЧ(ТаблицаКЗагрузке);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ДоступныеТипыТаблиц.НайтиПоЗначению(ТипТаблицы) = Неопределено Тогда
		ТипТаблицы = Перечисления.SUI_ТипыТаблицДокументовОбмена.ПустаяСсылка();
	КонецЕсли;
	
	Элементы.СопоставлениеРеквизитовТЧ.ОтборСтрок = Новый ФиксированнаяСтруктура(Новый Структура("ТипТаблицы", ТипТаблицы));
	
	Для Каждого МетаданныеТЧ Из МетаданныеДокумента.ТабличныеЧасти Цикл
		Элементы.ИмяТабличнойЧасти.СписокВыбора.Добавить(МетаданныеТЧ.Имя, МетаданныеТЧ.Синоним);
	КонецЦикла;
	
	ЗагрузитьСписокВыбораЗначений();
	
	// Дополнительные реквизиты
	АлгоритмПолученияДополнительныхРеквизитов = SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, 
		"АлгоритмПолученияДополнительныхРеквизитов");
		
	// Признак использования маркировки
	Элементы.ГруппаПризнакИспользованияМаркировки.Видимость = SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(
		Параметры, "ИспользованиеМаркировки", Ложь, Тип("Булево"));	
	АлгоритмПолученияПризнакаМаркировки = SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "АлгоритмПолученияПризнакаМаркировки");
	АлгоритмПолученияСтатусаУказанияСерии = SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "АлгоритмПолученияСтатусаУказанияСерии");
		
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ПроверитьЗначенияСопоставленныхРеквизитов();
	ОбновитьДоступностьИВидимостьЭлементов();
	ОбновитьЗаголовокФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если Отказ Или ЗавершениеРаботы Тогда
		Возврат;
	КонецЕсли;
	
	Если Модифицированность Тогда
		
		Отказ = Истина;
		
		ОповещениеОЗавершении = Новый ОписаниеОповещения("ВопросСохраненияПередЗакрытиемЗавершение", ЭтотОбъект);
		ПоказатьВопрос(ОповещениеОЗавершении, НСтр("ru = 'Сохранить настройки?'"), РежимДиалогаВопрос.ДаНет);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ТипТаблицыПриИзменении(Элемент)
	
	Элементы.СопоставлениеРеквизитовТЧ.ОтборСтрок = Новый ФиксированнаяСтруктура(Новый Структура("ТипТаблицы", ТипТаблицы));
	ОбновитьДоступностьИВидимостьЭлементов();
	ОбновитьЗаголовокФормы();
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ТипТаблицыНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ДанныеВыбора = ДоступныеТипыТаблиц;
КонецПроцедуры

&НаКлиенте
Процедура ИмяТабличнойЧастиПриИзменении(Элемент)
	
	ЗагрузитьСписокВыбораЗначений();
	ПроверитьЗначенияСопоставленныхРеквизитов();
	ОбновитьДоступностьИВидимостьЭлементов();
	ОбновитьЗаголовокФормы();
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ГиперссылкаРедактироватьАлгоритмПризнакПолученияМаркировкиНажатие(Элемент)
	
	Если Не ЗначениеЗаполнено(ИмяДокумента) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не выбрано имя документа'"));
		Возврат;
	ИначеЕсли Не ЗначениеЗаполнено(ИмяТабличнойЧасти) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не выбрана табличная часть документа'"));
		Возврат;
	КонецЕсли;
	
	ПараметрыОткрытияРедактора = SUI_РедакторКодаКлиент.ПараметрыОткрытия(АлгоритмПолученияПризнакаМаркировки);
	
	ПараметрыОткрытияРедактора.ЗапретРедактированияПриОткрытии = Не Модифицированность;
	ПараметрыОткрытияРедактора.Заголовок = НСтр("ru = 'Получение признака маркировки из строки табличной части'");
	ПараметрыОткрытияРедактора.Описание = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
		НСтр("ru = 'Получение признака маркировки из строки табличной части ""%1"" документа ""%2"".
		|<span style=""font:ВажнаяНадписьШрифт"">
		|Результат выполнения алгоритма необходимо присвоить в <span style=""color: ГиперссылкаЦвет"">Параметры.Результат</span></span>'"), 
		ИмяТабличнойЧасти, ИмяДокумента);
	
	ДобавитьОписаниеПеременныхАлгоритма(
		ПараметрыОткрытияРедактора.ПользовательскиеОбъекты, ИмяДокумента, ИмяТабличнойЧасти);
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения(
		"ГиперссылкаРедактироватьАлгоритмПризнакПолученияМаркировкиНажатиеЗавершение", ЭтотОбъект);
	ОткрытьРедакторКода(ОповещениеОЗавершении, ПараметрыОткрытияРедактора);
	
КонецПроцедуры

&НаКлиенте
Процедура ГиперссылкаРедактироватьАлгоритмПолученияСтатусаУказанияСерииНажатие(Элемент)
	
	Если Не ЗначениеЗаполнено(ИмяДокумента) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не выбрано имя документа'"));
		Возврат;
	ИначеЕсли Не ЗначениеЗаполнено(ИмяТабличнойЧасти) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не выбрана табличная часть документа'"));
		Возврат;
	КонецЕсли;
	
	ПараметрыОткрытияРедактора = SUI_РедакторКодаКлиент.ПараметрыОткрытия(АлгоритмПолученияСтатусаУказанияСерии);
	
	ПараметрыОткрытияРедактора.ЗапретРедактированияПриОткрытии = Не Модифицированность;
	ПараметрыОткрытияРедактора.Заголовок = НСтр("ru = 'Получение статуса указания серии из строки табличной части'");
	ПараметрыОткрытияРедактора.Описание = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
		НСтр("ru = 'Получение статуса указания серии из строки табличной части ""%1"" документа ""%2"".
		|<span style=""font:ВажнаяНадписьШрифт"">
		|Результат выполнения алгоритма необходимо присвоить в <span style=""color: ГиперссылкаЦвет"">Параметры.Результат</span></span>'"), 
		ИмяТабличнойЧасти, ИмяДокумента);
	
	ДобавитьОписаниеПеременныхАлгоритма(
		ПараметрыОткрытияРедактора.ПользовательскиеОбъекты, ИмяДокумента, ИмяТабличнойЧасти);
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения(
		"ГиперссылкаРедактироватьАлгоритмПолученияСтатусаУказанияСерииНажатиеЗавершение", ЭтотОбъект);
	ОткрытьРедакторКода(ОповещениеОЗавершении, ПараметрыОткрытияРедактора);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСопоставлениеРеквизитовТЧ

&НаКлиенте
Процедура СопоставлениеРеквизитовТЧИспользуетсяПостоянноеЗначениеПриИзменении(Элемент)
	
	Если Элементы.СопоставлениеРеквизитовТЧ.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Элементы.СопоставлениеРеквизитовТЧ.ТекущиеДанные.ИспользуетсяПостоянноеЗначение Тогда
		Элементы.СопоставлениеРеквизитовТЧ.ТекущиеДанные.ИмяРеквизита = "";
	Иначе
		Элементы.СопоставлениеРеквизитовТЧ.ТекущиеДанные.ПостоянноеЗначение = Неопределено;
	КонецЕсли;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура СопоставлениеРеквизитовТЧИмяРеквизитаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	Если Элементы.СопоставлениеРеквизитовТЧ.ТекущиеДанные <> Неопределено Тогда
		СтандартнаяОбработка = Не Элементы.СопоставлениеРеквизитовТЧ.ТекущиеДанные.ИспользуетсяПостоянноеЗначение;
	Иначе
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СопоставлениеРеквизитовТЧПостоянноеЗначениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если Элементы.СопоставлениеРеквизитовТЧ.ТекущиеДанные <> Неопределено Тогда
		СтандартнаяОбработка = Элементы.СопоставлениеРеквизитовТЧ.ТекущиеДанные.ИспользуетсяПостоянноеЗначение;
	Иначе
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СопоставлениеРеквизитовТЧИмяРеквизитаПриИзменении(Элемент)
	Модифицированность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура СопоставлениеРеквизитовТЧПостоянноеЗначениеПриИзменении(Элемент)
	Модифицированность = Истина;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сохранить(Команда)
	СохранитьИЗакрыть();
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьАлгоритмПолученияДополнительныхРеквизитов(Команда)
	
	Если Не ЗначениеЗаполнено(ИмяДокумента) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не выбрано имя документа'"));
		Возврат;
	ИначеЕсли Не ЗначениеЗаполнено(ИмяТабличнойЧасти) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не выбрана табличная часть документа'"));
		Возврат;
	КонецЕсли;
	
	ПараметрыОткрытияРедактора = SUI_РедакторКодаКлиент.ПараметрыОткрытия(АлгоритмПолученияДополнительныхРеквизитов);
	
	ПараметрыОткрытияРедактора.ЗапретРедактированияПриОткрытии = Не Модифицированность;
	ПараметрыОткрытияРедактора.Заголовок = НСтр("ru = 'Получение дополнительных реквизитов из строки табличной части'");
	ПараметрыОткрытияРедактора.Описание = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
		НСтр("ru = 'Получение дополнительных реквизитов из строки табличной части ""%1"" документа ""%2"".
		|<span style=""font:ВажнаяНадписьШрифт"">
		|Результат выполнения алгоритма необходимо присвоить в <span style=""color: ГиперссылкаЦвет"">Параметры.Результат</span></span>'"), 
		ИмяТабличнойЧасти, ИмяДокумента);
	
	ДобавитьОписаниеПеременныхАлгоритма(ПараметрыОткрытияРедактора.ПользовательскиеОбъекты, 
		ИмяДокумента, ИмяТабличнойЧасти);
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ОткрытьАлгоритмПолученияДополнительныхРеквизитовЗавершение", 
		ЭтотОбъект);
	ОткрытьРедакторКода(ОповещениеОЗавершении, ПараметрыОткрытияРедактора);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ИнициализироватьЗначенияКлючейТаблицыСопоставлениеРеквизитовТЧ()
	
	// Тип таблицы Товары Начало
	НоваяСтрока = СопоставлениеРеквизитовТЧ.Добавить();
