
#Область ОписаниеПеременных

&НаКлиенте
Перем ЗаполнятьНаименованиеАвтоматически;

&НаКлиенте
Перем ПредыдущийДокумент1С;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ЗагрузитьСписокВыбораДокументов1С();
	
	Если Не Объект.Ссылка.Пустая() Тогда
		СсылкаПолученияДанныхХранилища = Объект.Ссылка;
		Документ1С = Объект.ИмяМетаданныхДокумента;
	ИначеЕсли ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
		СсылкаПолученияДанныхХранилища = Параметры.ЗначениеКопирования;
		Документ1С = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СсылкаПолученияДанныхХранилища, "ИмяМетаданныхДокумента");
	Иначе
		СсылкаПолученияДанныхХранилища = Неопределено;
	КонецЕсли;
	
	Если СсылкаПолученияДанныхХранилища <> Неопределено Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	&ПустойУникальныйИдентификатор КАК КлючСвязи,
			|	SUI_НастройкиДокументовОбмена.ХранилищеНастроекОтбораДокументов,
			|	SUI_НастройкиДокументовОбмена.ХранилищеНастроекРеквизитовДокумента
			|ИЗ
			|	Справочник.SUI_НастройкиДокументовОбмена КАК SUI_НастройкиДокументовОбмена
			|ГДЕ
			|	SUI_НастройкиДокументовОбмена.Ссылка = &Ссылка
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	SUI_НастройкиДокументовОбменаНастройкиТаблиц.КлючСвязи,
			|	SUI_НастройкиДокументовОбменаНастройкиТаблиц.ХранилищеНастроекРеквизитовТаблицы
			|ИЗ
			|	Справочник.SUI_НастройкиДокументовОбмена.НастройкиТаблиц КАК SUI_НастройкиДокументовОбменаНастройкиТаблиц
			|ГДЕ
			|	SUI_НастройкиДокументовОбменаНастройкиТаблиц.Ссылка = &Ссылка";
		
		Запрос.УстановитьПараметр("Ссылка", СсылкаПолученияДанныхХранилища);
		Запрос.УстановитьПараметр("ПустойУникальныйИдентификатор", SUI_ОбщегоНазначенияКлиентСерверПереопределяемый.ПустойУникальныйИдентификатор());
		
		РезультатыЗапроса = Запрос.ВыполнитьПакет();
		
		ОписаниеТипаНастройкиКД = Новый ОписаниеТипов("НастройкиКомпоновкиДанных");
		
		Если Не РезультатыЗапроса[0].Пустой() Тогда
			
			Выборка = РезультатыЗапроса[0].Выбрать();
			Выборка.Следующий();
			
			НастройкиОтбораДокументов = Выборка.ХранилищеНастроекОтбораДокументов.Получить();
			Если НастройкиОтбораДокументов <> Неопределено Тогда
				АдресНастроекОтбораДокументов = ПоместитьВоВременноеХранилище(
					ОписаниеТипаНастройкиКД.ПривестиЗначение(НастройкиОтбораДокументов), 
					УникальныйИдентификатор);
			КонецЕсли;
			
			НастройкаКД = Выборка.ХранилищеНастроекРеквизитовДокумента.Получить();
			
			Если НастройкаКД <> Неопределено Тогда
				
				СтрокаНастройки = НастройкиКомпоновкиНастроекРеквизитов.Добавить();
				СтрокаНастройки.КлючСвязи = Выборка.КлючСвязи;
				СтрокаНастройки.АдресНастройки = ПоместитьВоВременноеХранилище(
					ОписаниеТипаНастройкиКД.ПривестиЗначение(НастройкаКД), 
					УникальныйИдентификатор);
				
			КонецЕсли;
					
		КонецЕсли;
		
		Если Не РезультатыЗапроса[1].Пустой() Тогда
			
			Выборка = РезультатыЗапроса[1].Выбрать();
			
			Пока Выборка.Следующий() Цикл
				
				НастройкаКД = Выборка.ХранилищеНастроекРеквизитовТаблицы.Получить();
				
				Если НастройкаКД <> Неопределено Тогда
					
					СтрокаНастройки = НастройкиКомпоновкиНастроекРеквизитов.Добавить();
					СтрокаНастройки.КлючСвязи = Выборка.КлючСвязи;
					СтрокаНастройки.АдресНастройки = ПоместитьВоВременноеХранилище(
						ОписаниеТипаНастройкиКД.ПривестиЗначение(НастройкаКД), 
						УникальныйИдентификатор);
						
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ПереопределитьСтандартныеКоманды();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если Не ПустаяСтрока(Документ1С) И Элементы.Документ1С.СписокВыбора.НайтиПоЗначению(Документ1С) = Неопределено Тогда
		Документ1С = "";
	КонецЕсли;
	
	ПредыдущийДокумент1С = Документ1С;
	
	ЗаполнятьНаименованиеАвтоматически = ПустаяСтрока(Объект.Наименование);
	
	ПодключитьОбработчикОжидания("ИнициализироватьОсновнуюСхемуКомпоновкиДанных", 0.1, Истина);
	
	НастройкиОтбораДокументовПриИзменении();
	
	ИнициализироватьСписокВыбораДокументовОснования();
	
	ИзменитьОтображениеЭлементовФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.Ссылка.Пустая() И Не ПараметрыЗаписи.Свойство("ПривязатьМобильныеУстройства") Тогда
		
		Отказ = Истина;
		ОповещениеОЗавершении = Новый ОписаниеОповещения("ПривязкаМобильныхУстройствПодтверждение", ЭтотОбъект, ПараметрыЗаписи);
		ПоказатьВопрос(ОповещениеОЗавершении, НСтр("ru = 'Привязать мобильные устройства к текущей настройке?'"), РежимДиалогаВопрос.ДаНет);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ТекущийОбъект.ДополнительныеСвойства.Вставить("АдресНастроекОтбораДокументов", АдресНастроекОтбораДокументов);
	
	ТекущийОбъект.ДополнительныеСвойства.Вставить("НастройкиКомпоновкиНастроекРеквизитов", Новый Соответствие());
	
	Для Каждого СтрокаНастройки Из НастройкиКомпоновкиНастроекРеквизитов Цикл
		
		Если СтрокаНастройки.КлючСвязи <> SUI_ОбщегоНазначенияКлиентСерверПереопределяемый.ПустойУникальныйИдентификатор() И
			Объект.НастройкиТаблиц.НайтиСтроки(Новый Структура("КлючСвязи", СтрокаНастройки.КлючСвязи)).Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЭтоАдресВременногоХранилища(СтрокаНастройки.АдресНастройки) Тогда
			НастройкиКД = ПолучитьИзВременногоХранилища(СтрокаНастройки.АдресНастройки);
		Иначе
			НастройкиКД = Неопределено;
		КонецЕсли;
		
		ТекущийОбъект.ДополнительныеСвойства.НастройкиКомпоновкиНастроекРеквизитов.Вставить(СтрокаНастройки.КлючСвязи, НастройкиКД);
	
	КонецЦикла;
	
	Если ПараметрыЗаписи.Свойство("ПривязатьМобильныеУстройства") Тогда
		ТекущийОбъект.ДополнительныеСвойства.Вставить("ПривязатьМобильныеУстройства", ПараметрыЗаписи.ПривязатьМобильныеУстройства);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	Оповестить("ЗаписьОбъекта_SUI_НастройкиДокументовОбмена");
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура Документ1СПриИзменении(Элемент)
	
	Документ1СПриИзмененииНаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Процедура НаименованиеПриИзменении(Элемент)
	
	ЗаполнятьНаименованиеАвтоматически = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздаватьДокументОбменаПриЗаписиДокумента1СПриИзменении(Элемент)
	
	ИзменитьОтображениеЭлементовФормы();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыНастройкиТаблицВыгрузка

&НаКлиенте
Процедура НастройкиТаблицПередНачаломИзменения(Элемент, Отказ)
	
	Если Отказ Или Элемент.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Отказ = Истина;
	
	ОткрытиеНастройкиРеквизитов(Элемент.ТекущиеДанные.КлючСвязи, НСтр("ru = 'Настройка реквизитов таблицы'"));
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиТаблицПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, ЭтоГруппа, Параметр)
	
	Отказ = Истина;
	
	ОткрытиеНастройкиРеквизитов(, НСтр("ru = 'Настройка реквизитов таблицы'"));
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиТаблицВыгрузкаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле = Элементы.НастройкиТаблицВыгрузкаГиперссылкаНастройкаИдентификацииСтрок Тогда
		
		СтандартнаяОбработка = Ложь;
		
		ПараметрыОткрытия = Новый Структура();
		ПараметрыОткрытия.Вставить("УникальныйИдентификатор", УникальныйИдентификатор);
		ПараметрыОткрытия.Вставить("ИмяМетаданныхДокумента", Объект.ИмяМетаданныхДокумента);
		ПараметрыОткрытия.Вставить("ТипТаблицы", Элемент.ТекущиеДанные.ТипТаблицы);
		ПараметрыОткрытия.Вставить("ИмяТабличнойЧасти", Элемент.ТекущиеДанные.ИмяТабличнойЧасти);
		ПараметрыОткрытия.Вставить("КлючСвязи", Элемент.ТекущиеДанные.КлючСвязи);
		ПараметрыОткрытия.Вставить("РеквизитыИдентификации", Новый СписокЗначений());
		ПараметрыОткрытия.Вставить("Заголовок", НСтр("ru = 'Настройка идентификации строк табличной части'"));
		
		СтрокиИдентификацииСтрок = Объект.НастройкиИдентификацииСтрок.НайтиСтроки(
			Новый Структура("КлючСвязи", Элемент.ТекущиеДанные.КлючСвязи));
			
		Для Каждого СтрокаИдентификацииСтрок Из СтрокиИдентификацииСтрок Цикл
			ПараметрыОткрытия.РеквизитыИдентификации.Добавить(СтрокаИдентификацииСтрок.Реквизит);
		КонецЦикла;
		
		ОповещениеОЗавершении = Новый ОписаниеОповещения("НастройкаИдентификацииСтрокЗавершение", ЭтотОбъект);
		
		ОткрытьФорму("Справочник.SUI_НастройкиДокументовОбмена.Форма.ФормаНастройкиИдентификацииСтрок", ПараметрыОткрытия,
			ЭтотОбъект, УникальныйИдентификатор, Окно, , ОповещениеОЗавершении);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиТаблицВыгрузкаПослеУдаления(Элемент)
	
	// Перегрузить настройки идентификации строк
	НастройкаИдентификацииСтрокЗавершениеНаСервере(Неопределено, Неопределено);
	
	// Перегрузить настройки заполнения реквизитов постобработки
	НастройкиЗаполненияРеквизитовПостобработкиЗавершениеНаСервере("", Неопределено);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыНастройкиТаблицЗагрузка

&НаКлиенте
Процедура НастройкиТаблицЗагрузкаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Элемент.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЭлементыГиперссылки = Элемент.ПодчиненныеЭлементы.НастройкиТаблицЗагрузкаГруппаГиперссылки.ПодчиненныеЭлементы;
	
	Если Поле = ЭлементыГиперссылки.НастройкиТаблицЗагрузкаГиперссылкаАлгоритмаОбработкиСтрокЗагрузкиДанных Тогда
		
		ПараметрыОткрытияРедактора = SUI_РедакторКодаКлиент.ПараметрыОткрытия(
			Элемент.ТекущиеДанные.АлгоритмОбработкиСтрокЗагрузкиДанных, 
			SUI_НастройкиДокументовКлиентСервер.ПолучитьПредопределенныйАлгоритм(Объект.ИмяМетаданныхДокумента, "ОбработкаСтрок." + Элемент.ТекущиеДанные.ИмяТабличнойЧасти));
		
		ПараметрыОткрытияРедактора.ЗапретРедактированияПриОткрытии = Истина;
		ПараметрыОткрытияРедактора.Заголовок = НСтр("ru = 'Алгоритм обработки строк табличной части'");
		ПараметрыОткрытияРедактора.Описание = СтрШаблон(
			НСтр("ru = 'Алгоритм обработки строк табличной части %1 документа %2'"), 
			Элемент.ТекущиеДанные.ИмяТабличнойЧасти, Объект.СинонимМетаданныхДокумента);
		
		ДобавитьОписаниеПеременныхАлгоритмаОбработкиСтрокНаСервере(ПараметрыОткрытияРедактора.ПользовательскиеОбъекты,
			Объект.ИмяМетаданныхДокумента, Объект.СинонимМетаданныхДокумента, Элемент.ТекущиеДанные.ИмяТабличнойЧасти, Элемент.ТекущиеДанные.ТипТаблицы);
		
		Контекст = Новый Структура();
		Контекст.Вставить("ИдентификаторВладельца", Элемент.ТекущаяСтрока);
		
		ОповещениеОЗавершении = Новый ОписаниеОповещения("АлгоритмОбработкиСтрокЗагрузкиДанныхЗавершениеРедактирования", ЭтотОбъект, Контекст);
		
		SUI_РедакторКодаКлиент.ОткрытьРедактор(ПараметрыОткрытияРедактора, ОповещениеОЗавершении, ЭтотОбъект, Окно);
		
	ИначеЕсли Поле = ЭлементыГиперссылки.НастройкиТаблицГиперссылкаЗаполнениеРеквизитовПостобработки Тогда
		
		ОткрытиеНастройкиЗаполненияРеквизитовПостобработки(Элемент.ТекущиеДанные.КлючСвязи, 
			НСтр("ru = 'Настройка заполнение реквизитов табличной части документа'"));
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПостобработкаСозданиеДокументовНаОсновании

&НаКлиенте
Процедура ПостобработкаСозданиеДокументовНаОснованииВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле = Элементы.ПостобработкаСозданиеДокументовНаОснованииГиперссылкаАлгоритмаОбработчика Тогда
		
		ПараметрыОткрытияРедактора = SUI_РедакторКодаКлиент.ПараметрыОткрытия(Элемент.ТекущиеДанные.АлгоритмОбработчик, 
			SUI_НастройкиДокументовКлиентСервер.ПолучитьПредопределенныйАлгоритм(Объект.ИмяМетаданныхДокумента, "СоздатьНаОсновании"));
		ПараметрыОткрытияРедактора.ЗапретРедактированияПриОткрытии = Истина;
		ПараметрыОткрытияРедактора.Заголовок = НСтр("ru = 'Алгоритм заполнения документа основания'");
		ПараметрыОткрытияРедактора.Описание = НСтр("ru = 'Алгоритм заполнения документа основания'");
		
		Контекст = Новый Структура();
		Контекст.Вставить("ИдентификаторВладельца", Элемент.ТекущиеДанные.ПолучитьИдентификатор());
		
		ОповещениеОЗавершении = Новый ОписаниеОповещения("АлгоритмЗаполненияДокументаОснованияЗавершениеРедактирования", ЭтотОбъект, Контекст);
		
		SUI_РедакторКодаКлиент.ОткрытьРедактор(ПараметрыОткрытияРедактора, ОповещениеОЗавершении, ЭтотОбъект, Окно);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОткрытьНастройкиОтбораДокументов(Команда)
	
	Если ПустаяСтрока(АдресОсновнойСхемыКомпоновкиДанных) Или Не ЭтоАдресВременногоХранилища(АдресОсновнойСхемыКомпоновкиДанных) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не инициализирована основная схема компоновки данных'"));
		Возврат;
	КонецЕсли;
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ОткрытьНастройкиОтбораДокументовЗавершение", ЭтотОбъект);
	
	ПараметрыОткрытияНастройкиОтбора = SUI_КомпоновкаДанныхКлиент.ПараметрыОткрытияНастройкиСхемыКомпоновкиДанных(
		ОповещениеОЗавершении, ЭтотОбъект);
	ПараметрыОткрытияНастройкиОтбора.Уникальность = УникальныйИдентификатор;
	ПараметрыОткрытияНастройкиОтбора.Окно = Окно;
	
	ПараметрыНастройкиОтбора = SUI_КомпоновкаДанныхКлиент.ПараметрыНастройкиСхемыКомпоновкиДанных(
		АдресОсновнойСхемыКомпоновкиДанных, АдресНастроекОтбораДокументов, УникальныйИдентификатор);
	ПараметрыНастройкиОтбора.Заголовок 									= НСтр("ru = 'Настройки отбора документов'");
	ПараметрыНастройкиОтбора.НеРедактироватьСхемуКомпоновкиДанных 		= Истина;
	ПараметрыНастройкиОтбора.НеЗагружатьСхемуКомпоновкиДанныхИзФайла 	= Истина;
	ПараметрыНастройкиОтбора.НеПомещатьНастройкиВСхемуКомпоновкиДанных 	= Истина;
	ПараметрыНастройкиОтбора.НеНастраиватьВыбор 						= Истина;
	ПараметрыНастройкиОтбора.НеНастраиватьПараметры 					= Истина;
	ПараметрыНастройкиОтбора.НеНастраиватьПорядок 						= Истина;
	ПараметрыНастройкиОтбора.НеНастраиватьПользовательскиеПоля 			= Истина;
	
	SUI_КомпоновкаДанныхКлиент.ОткрытьНастройкиКомпоновкиДанных(ПараметрыОткрытияНастройкиОтбора, ПараметрыНастройкиОтбора);
	
КонецПроцедуры

&НаКлиенте
