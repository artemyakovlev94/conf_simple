		SUI_НастройкиДокументовКлиентСервер.ПолучитьПредопределенныйАлгоритм(Объект.ИмяМетаданныхДокумента, "ПослеЗаписи"));
	ПараметрыОткрытияРедактора.ЗапретРедактированияПриОткрытии = Истина;
