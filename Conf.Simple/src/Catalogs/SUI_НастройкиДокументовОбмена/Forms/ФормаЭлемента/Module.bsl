&НаСервере
Процедура ПереопределитьСтандартныеКоманды()
	
	Элементы.ФормаЗаписатьИЗакрыть.ИмяКоманды = "ЗаписатьИЗакрытьПереопределяемый";
	Элементы.ФормаЗаписать.ИмяКоманды = "ЗаписатьПереопределяемый";
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьСписокВыбораДокументов1С()
	
	Для Каждого ЭлементСписка Из SUI_НастройкиДокументовПовтИсп.СписокДокументовКонфигурации() Цикл
		Элементы.Документ1С.СписокВыбора.Добавить(ЭлементСписка.Значение, ЭлементСписка.Представление);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура Документ1СПриИзмененииНаКлиенте()
	
	ВыбранноеЗначениеИзСписка = Элементы.Документ1С.СписокВыбора.НайтиПоЗначению(Документ1С);
	
	Если ВыбранноеЗначениеИзСписка = Неопределено Тогда
		Объект.ИмяМетаданныхДокумента = "";
		Объект.СинонимМетаданныхДокумента = "";
	Иначе
		
		Объект.ИмяМетаданныхДокумента = ВыбранноеЗначениеИзСписка.Значение;
		Объект.СинонимМетаданныхДокумента = ВыбранноеЗначениеИзСписка.Представление;
		
		Если ЗаполнятьНаименованиеАвтоматически Тогда
			Объект.Наименование = Объект.СинонимМетаданныхДокумента;
		КонецЕсли;
		
	КонецЕсли;
	
	Если Документ1С <> ПредыдущийДокумент1С Тогда
		
		ПодключитьОбработчикОжидания("ИнициализироватьОсновнуюСхемуКомпоновкиДанных", 0.1, Истина);
		
		АдресНастроекОтбораДокументов = "";
		НастройкиОтбораДокументовПриИзменении();
		
		Объект.НастройкиТаблиц.Очистить();
		Объект.ПостобработкаЗаполнениеРеквизитов.Очистить();
		Объект.ПостобработкаСозданиеДокументовНаОсновании.Очистить();
		Объект.НастройкиИдентификацииСтрок.Очистить();
		
		НастройкиКомпоновкиНастроекРеквизитов.Очистить();
		
		ИнициализироватьСписокВыбораДокументовОснования();
		
	КонецЕсли;
	
	ИзменитьОтображениеЭлементовФормы();
	
	ПредыдущийДокумент1С = Документ1С;
	
КонецПроцедуры

&НаКлиенте
Процедура ИнициализироватьОсновнуюСхемуКомпоновкиДанных() Экспорт
	
	ИнициализироватьОсновнуюСхемуКомпоновкиДанныхНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьОсновнуюСхемуКомпоновкиДанныхНаСервере()
	
	АдресОсновнойСхемыКомпоновкиДанных = Справочники.SUI_НастройкиДокументовОбмена.ПолучитьСхемуКомпоновкиДанных(
		Объект.ИмяМетаданныхДокумента, , , Истина, УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьНастройкиОтбораДокументовЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		АдресНастроекОтбораДокументов = Результат;
		НастройкиОтбораДокументовПриИзменении();
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиОтбораДокументовПриИзменении() Экспорт
	
	ПредставлениеОтбора = "";
	
	Если Не ПустаяСтрока(АдресНастроекОтбораДокументов) И ЭтоАдресВременногоХранилища(АдресНастроекОтбораДокументов) Тогда
		ПредставлениеОтбора = ПолучитьПредставлениеОтбораДокументовНаСервере(АдресНастроекОтбораДокументов);
	КонецЕсли;
	
	Элементы.ОткрытьНастройкиОтбораДокументов.РасширеннаяПодсказка.Заголовок = ПредставлениеОтбора;
	
	Если ПустаяСтрока(ПредставлениеОтбора) Тогда
		Элементы.ОткрытьНастройкиОтбораДокументов.Заголовок = НСтр("ru = 'отбор не установлен'");
	ИначеЕсли СтрДлина(ПредставлениеОтбора) > 100 Тогда
		Элементы.ОткрытьНастройкиОтбораДокументов.Заголовок = Лев(ПредставлениеОтбора, 97) + "...";
	Иначе
		Элементы.ОткрытьНастройкиОтбораДокументов.Заголовок = Лев(ПредставлениеОтбора, 100);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПредставлениеОтбораДокументовНаСервере(АдресНастроекОтбора)
	
	ТекстПредставления = "";
	
	Если Не ПустаяСтрока(АдресНастроекОтбора) И ЭтоАдресВременногоХранилища(АдресНастроекОтбора) Тогда
		ОписаниеТипаНастройкиКД = Новый ОписаниеТипов("НастройкиКомпоновкиДанных");
		НастройкиКД = ОписаниеТипаНастройкиКД.ПривестиЗначение(ПолучитьИзВременногоХранилища(АдресНастроекОтбора));
		ТекстПредставления = Строка(НастройкиКД.Отбор);
	КонецЕсли;
	
	Возврат ТекстПредставления;
	
КонецФункции

&НаКлиенте
Процедура ИзменитьОтображениеЭлементовФормы()
	
	Если ПустаяСтрока(Объект.ИмяМетаданныхДокумента) Тогда
		Элементы.ГруппаОткрытьНастройкиОтбораДокументов.Доступность = Ложь;
		Элементы.ГруппаСтраницы.Доступность = Ложь;
	Иначе
		Элементы.ГруппаОткрытьНастройкиОтбораДокументов.Доступность = Истина;
		Элементы.ГруппаСтраницы.Доступность = Истина;
	КонецЕсли;
	
	Элементы.СостояниеПоУмолчанию.Видимость = Объект.СоздаватьДокументОбменаПриЗаписиДокумента1С;
	
КонецПроцедуры

&НаКлиенте
Процедура ПривязкаМобильныхУстройствПодтверждение(Ответ, ПараметрыЗаписи) Экспорт
	
	ПараметрыЗаписи.Вставить("ПривязатьМобильныеУстройства", (Ответ = КодВозвратаДиалога.Да));
	ВыполнитьПереопределениеКомандыЗаписатьИЗакрыть(ПараметрыЗаписи);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПереопределениеКомандыЗаписатьИЗакрыть(ПараметрыЗаписи)
	    
	Если Записать(ПараметрыЗаписи) И ПараметрыЗаписи.Свойство("ЗакрытьПриЗаписи") Тогда
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

#Область НастройкиРеквизитов

&НаКлиенте
Процедура ОткрытиеНастройкиРеквизитов(КлючСвязи = Неопределено, Заголовок = "", ПараметрыОткрытия = Неопределено)
	
	Если ПараметрыОткрытия = Неопределено Тогда
		
		ПараметрыОткрытия = ПараметрыОткрытияНастройкиРеквизитов(КлючСвязи);
		ПараметрыОткрытия.Заголовок = Заголовок;
		
	КонецЕсли;
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("НастройкаРеквизитовЗавершение", ЭтотОбъект);
	
	ОткрытьФорму("Справочник.SUI_НастройкиДокументовОбмена.Форма.ФормаНастройкиРеквизитов", ПараметрыОткрытия, 
		ЭтотОбъект, УникальныйИдентификатор, Окно, , ОповещениеОЗавершении);
	
КонецПроцедуры

&НаКлиенте
Функция ПараметрыОткрытияНастройкиРеквизитов(КлючСвязи = Неопределено)
	
	ПараметрыОткрытия = Новый Структура();
	ПараметрыОткрытия.Вставить("КлючСвязи", ?(КлючСвязи = Неопределено, Новый УникальныйИдентификатор(), КлючСвязи));
	ПараметрыОткрытия.Вставить("ИмяМетаданныхДокумента", Объект.ИмяМетаданныхДокумента);
	ПараметрыОткрытия.Вставить("УникальныйИдентификатор", УникальныйИдентификатор);
	ПараметрыОткрытия.Вставить("Заголовок", "");
	ПараметрыОткрытия.Вставить("НастроенныеТипыТаблиц", Новый СписокЗначений());
	ПараметрыОткрытия.Вставить("АдресНастройкиРеквизитов", "");
	ПараметрыОткрытия.Вставить("ТипТаблицы");
	ПараметрыОткрытия.Вставить("ИмяТабличнойЧасти", "");
	
	Если ЗначениеЗаполнено(ПараметрыОткрытия.КлючСвязи) Тогда
		
		НастройкаТаблицы = Объект.НастройкиТаблиц.НайтиСтроки(Новый Структура("КлючСвязи", ПараметрыОткрытия.КлючСвязи));
		Если НастройкаТаблицы.Количество() > 0 Тогда
			ПараметрыОткрытия.ТипТаблицы = НастройкаТаблицы[0].ТипТаблицы;
			ПараметрыОткрытия.ИмяТабличнойЧасти = НастройкаТаблицы[0].ИмяТабличнойЧасти;
		КонецЕсли;
		
	КонецЕсли;
	
	НастройкиКД = НастройкиКомпоновкиНастроекРеквизитов.НайтиСтроки(Новый Структура("КлючСвязи", ПараметрыОткрытия.КлючСвязи));
	Если НастройкиКД.Количество() > 0 Тогда
		ПараметрыОткрытия.АдресНастройкиРеквизитов = НастройкиКД[0].АдресНастройки;
	КонецЕсли;
	
	НастроенныеТипыТаблиц = Новый Массив();
	Для Каждого СтрокаНастройкиТаблиц Из Объект.НастройкиТаблиц Цикл
		НастроенныеТипыТаблиц.Добавить(СтрокаНастройкиТаблиц.ТипТаблицы);
	КонецЦикла;
	
	ПараметрыОткрытия.НастроенныеТипыТаблиц.ЗагрузитьЗначения(ОбщегоНазначенияКлиентСервер.СвернутьМассив(НастроенныеТипыТаблиц));
	
	Возврат ПараметрыОткрытия;
	
КонецФункции

&НаКлиенте
Процедура НастройкаРеквизитовЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КлючСвязи = Результат.КлючСвязи;
	
	// Это таблица
	Если ЗначениеЗаполнено(КлючСвязи) Тогда
		
		НастройкаТаблицыПоКлючуСвязи = Объект.НастройкиТаблиц.НайтиСтроки(Новый Структура("КлючСвязи", КлючСвязи));
		
		Если ЗначениеЗаполнено(НастройкаТаблицыПоКлючуСвязи) Тогда
			
			ТекущийИндекс = НастройкаТаблицыПоКлючуСвязи.ВГраница();
			Пока ТекущийИндекс > 0 Цикл
				Объект.НастройкиТаблиц.Удалить(НастройкаТаблицыПоКлючуСвязи[ТекущийИндекс]);
				ТекущийИндекс = ТекущийИндекс-1;
			КонецЦикла;
			
			НастройкаТаблицыПоКлючуСвязи = НастройкаТаблицыПоКлючуСвязи[ТекущийИндекс];
			
		Иначе
			НастройкаТаблицыПоКлючуСвязи = Объект.НастройкиТаблиц.Добавить();
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Результат.ТипТаблицы) И Не ПустаяСтрока(Результат.ИмяТабличнойЧасти) Тогда
			
			НастройкаТаблицыПоКлючуСвязи.КлючСвязи = КлючСвязи;
			НастройкаТаблицыПоКлючуСвязи.ТипТаблицы = Результат.ТипТаблицы;
			НастройкаТаблицыПоКлючуСвязи.ИмяТабличнойЧасти = Результат.ИмяТабличнойЧасти;
			
		Иначе
			Объект.НастройкиТаблиц.Удалить(НастройкаТаблицыПоКлючуСвязи);
			КлючСвязи = Неопределено;
		КонецЕсли;
		
	КонецЕсли;
	
	Если КлючСвязи <> Неопределено Тогда
		
		НастройкиКД = НастройкиКомпоновкиНастроекРеквизитов.НайтиСтроки(Новый Структура("КлючСвязи", КлючСвязи));
		
		Если НастройкиКД.Количество() > 0 Тогда
			НастройкиКД = НастройкиКД[0];
		Иначе
			НастройкиКД = НастройкиКомпоновкиНастроекРеквизитов.Добавить();
			НастройкиКД.КлючСвязи = КлючСвязи;
		КонецЕсли;
		
		НастройкиКД.АдресНастройки = Результат.АдресНастройкиРеквизитов;
		
	КонецЕсли;
	
	Модифицированность = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область НастройкиИдентификацииСтрок

&НаКлиенте
Процедура НастройкаИдентификацииСтрокЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НастройкаИдентификацииСтрокЗавершениеНаСервере(Результат.РеквизитыИдентификации, Результат.КлючСвязи);
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура НастройкаИдентификацииСтрокЗавершениеНаСервере(РеквизитыИдентификацииМассив, КлючСвязи)
	
	Запрос = Новый Запрос();
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаблицаПриемник.КлючСвязи,
		|	ТаблицаПриемник.Реквизит
		|ПОМЕСТИТЬ втТаблицаПриемник
		|ИЗ
		|	&ТаблицаПриемник КАК ТаблицаПриемник
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втТаблицаПриемник.КлючСвязи,
		|	втТаблицаПриемник.Реквизит
		|ИЗ
		|	втТаблицаПриемник КАК втТаблицаПриемник
		|ГДЕ
		|	&УсловиеПоКлючуСвязиТаблицыИсточник
		|	И втТаблицаПриемник.КлючСвязи В (&КлючиСвязиНастроекТаблиц)";
	
	Запрос.УстановитьПараметр("КлючСвязиТаблицыИсточник", КлючСвязи);
	Запрос.УстановитьПараметр("УсловиеПоКлючуСвязиТаблицыИсточник", Истина);
	Запрос.УстановитьПараметр("ТаблицаПриемник", Объект.НастройкиИдентификацииСтрок.Выгрузить());
	Запрос.УстановитьПараметр("КлючиСвязиНастроекТаблиц", Объект.НастройкиТаблиц.Выгрузить().ВыгрузитьКолонку("КлючСвязи"));
	
	Если ЗначениеЗаполнено(КлючСвязи) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоКлючуСвязиТаблицыИсточник", "втТаблицаПриемник.КлючСвязи <> &КлючСвязиТаблицыИсточник");
	КонецЕсли;
	
	Объект.НастройкиИдентификацииСтрок.Загрузить(Запрос.Выполнить().Выгрузить());
	
	Если ЗначениеЗаполнено(РеквизитыИдентификацииМассив) Тогда
		
		Для индекс = 0 По РеквизитыИдентификацииМассив.ВГраница() Цикл
			
			СтрокаНастройкиИдентификацииСтрок = Объект.НастройкиИдентификацииСтрок.Добавить();
			СтрокаНастройкиИдентификацииСтрок.КлючСвязи = КлючСвязи;
			СтрокаНастройкиИдентификацииСтрок.Реквизит = РеквизитыИдентификацииМассив[индекс];
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область КонсольПроизвольногоАлгоритма

&НаСервереБезКонтекста
Процедура ДобавитьОписаниеПеременныхАлгоритмаПередПослеЗаписиНаСервере(ПользовательскиеОбъекты, ИмяДокумента, СинонимДокумента)
	
	ОписаниеРеквизитовДокументаОбмена = SUI_НастройкиДокументовПовтИсп.ОписаниеРеквизитовДокумента("SUI_ДокументОбмена");
	
	// Описание переменных: ДокументОбъект
	_ПользовательскийОбъект = SUI_РедакторКодаКлиентСервер.ДобавитьПользовательскийОбъект(ПользовательскиеОбъекты, 
		"ДокументОбъект", 
		СтрШаблон(НСтр("ru = 'Объект документа %1'"), СинонимДокумента),
		"ДокументОбъект." + ИмяДокумента,
		Тип("ДокументСсылка." + ИмяДокумента));
	
	Для Каждого ОписаниеРеквизита Из ОписаниеРеквизитовДокументаОбмена.Строки.Найти("Реквизиты", "Имя", Ложь).Строки Цикл
		
		SUI_РедакторКодаКлиентСервер.ДобавитьСвойствоПользовательскогоОбъекта(_ПользовательскийОбъект, 
			ОписаниеРеквизита.Имя,
			ОписаниеРеквизита.Синоним,
			ОписаниеРеквизита.Представление,
			SUI_ОбщегоНазначенияПереопределяемый.СтроковоеПредставлениеТипа(ОписаниеРеквизита.Тип),
			,
			Истина);
		
	КонецЦикла;
	
	Для Каждого ОписаниеРеквизита Из ОписаниеРеквизитовДокументаОбмена.Строки.Найти("ТабличныеЧасти", "Имя", Ложь).Строки Цикл
		
		_СвойствоПользовательскогоОбъекта = SUI_РедакторКодаКлиентСервер.ДобавитьСвойствоПользовательскогоОбъекта(_ПользовательскийОбъект, 
			ОписаниеРеквизита.Имя,
			ОписаниеРеквизита.Синоним,
			ОписаниеРеквизита.Представление,
			SUI_ОбщегоНазначенияПереопределяемый.СтроковоеПредставлениеТипа(ОписаниеРеквизита.Тип),
			,
			Истина);
		
		Для Каждого ОписаниеРеквизитаТЧ Из ОписаниеРеквизита.Строки Цикл
			
			SUI_РедакторКодаКлиентСервер.ДобавитьСвойствоПользовательскогоОбъекта(_СвойствоПользовательскогоОбъекта, 
				ОписаниеРеквизитаТЧ.Имя,
				ОписаниеРеквизитаТЧ.Синоним,
				ОписаниеРеквизитаТЧ.Представление,
				SUI_ОбщегоНазначенияПереопределяемый.СтроковоеПредставлениеТипа(ОписаниеРеквизитаТЧ.Тип),
				,
				Истина);
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьОписаниеПеременныхАлгоритмаОбработкиСтрокНаСервере(ПользовательскиеОбъекты, ИмяДокумента, СинонимДокумента, ИмяТабличнойЧасти, Таблица)
	
	ОписаниеРеквизитовДокументаОбмена = SUI_НастройкиДокументовПовтИсп.ОписаниеРеквизитовДокумента("SUI_ДокументОбмена");
	ОписаниеРеквизитовДокумента = SUI_НастройкиДокументовПовтИсп.ОписаниеРеквизитовДокумента(ИмяДокумента);
	
	// Описание переменных: ДокументОбмена
	_ПользовательскийОбъект = SUI_РедакторКодаКлиентСервер.ДобавитьПользовательскийОбъект(ПользовательскиеОбъекты, 
		"ДокументОбмена", 
		НСтр("ru = 'Ссылка документа обмена'"),
		Тип("ДокументСсылка.SUI_ДокументОбмена"),
		Тип("ДокументСсылка.SUI_ДокументОбмена"));
	
	Для Каждого ОписаниеРеквизита Из ОписаниеРеквизитовДокументаОбмена.Строки.Найти("Реквизиты", "Имя", Ложь).Строки Цикл
		
		SUI_РедакторКодаКлиентСервер.ДобавитьСвойствоПользовательскогоОбъекта(_ПользовательскийОбъект, 
			ОписаниеРеквизита.Имя,
			ОписаниеРеквизита.Синоним,
			ОписаниеРеквизита.Представление,
			SUI_ОбщегоНазначенияПереопределяемый.СтроковоеПредставлениеТипа(ОписаниеРеквизита.Тип),
			,
			Истина);
		
	КонецЦикла;
	
	Для Каждого ОписаниеРеквизита Из ОписаниеРеквизитовДокументаОбмена.Строки.Найти("ТабличныеЧасти", "Имя", Ложь).Строки Цикл
		
		_СвойствоПользовательскогоОбъекта = SUI_РедакторКодаКлиентСервер.ДобавитьСвойствоПользовательскогоОбъекта(_ПользовательскийОбъект, 
			ОписаниеРеквизита.Имя,
			ОписаниеРеквизита.Синоним,
			ОписаниеРеквизита.Представление,
			SUI_ОбщегоНазначенияПереопределяемый.СтроковоеПредставлениеТипа(ОписаниеРеквизита.Тип),
			,
			Истина);
		
		Для Каждого ОписаниеРеквизитаТЧ Из ОписаниеРеквизита.Строки Цикл
			
			SUI_РедакторКодаКлиентСервер.ДобавитьСвойствоПользовательскогоОбъекта(_СвойствоПользовательскогоОбъекта, 
				ОписаниеРеквизитаТЧ.Имя,
				ОписаниеРеквизитаТЧ.Синоним,
				ОписаниеРеквизитаТЧ.Представление,
				SUI_ОбщегоНазначенияПереопределяемый.СтроковоеПредставлениеТипа(ОписаниеРеквизитаТЧ.Тип),
				,
				Истина);
			
		КонецЦикла;
		
	КонецЦикла;
	
	// Описание переменных: ДанныеЗаполнения
	_ПользовательскийОбъект = SUI_РедакторКодаКлиентСервер.ДобавитьПользовательскийОбъект(ПользовательскиеОбъекты, 
		"ДанныеЗаполнения", 
		СтрШаблон(НСтр("ru = 'Данные из документа обмена для заполнения строки табличной части документа %1'"), СинонимДокумента),
		Тип("Структура"));
	
	Если Таблица = Перечисления.SUI_ТипыТаблицДокументовОбмена.Товары Тогда
		ОписаниеРеквизитовДанныеЗаполнения = ОписаниеРеквизитовДокументаОбмена.Строки.Найти("ТабличныеЧасти", "Имя", Ложь)
			.Строки.Найти("Товары", "Имя", Ложь);
	ИначеЕсли Таблица = Перечисления.SUI_ТипыТаблицДокументовОбмена.Отбор Тогда
		ОписаниеРеквизитовДанныеЗаполнения = ОписаниеРеквизитовДокументаОбмена.Строки.Найти("ТабличныеЧасти", "Имя", Ложь)
			.Строки.Найти("Отбор", "Имя", Ложь);
	ИначеЕсли Таблица = Перечисления.SUI_ТипыТаблицДокументовОбмена.Размещение Тогда
		ОписаниеРеквизитовДанныеЗаполнения = ОписаниеРеквизитовДокументаОбмена.Строки.Найти("ТабличныеЧасти", "Имя", Ложь)
			.Строки.Найти("Размещение", "Имя", Ложь);
	ИначеЕсли Таблица = Перечисления.SUI_ТипыТаблицДокументовОбмена.Серии Тогда
		ОписаниеРеквизитовДанныеЗаполнения = ОписаниеРеквизитовДокументаОбмена.Строки.Найти("ТабличныеЧасти", "Имя", Ложь)
			.Строки.Найти("Серии", "Имя", Ложь);
	ИначеЕсли Таблица = Перечисления.SUI_ТипыТаблицДокументовОбмена.ШтрихкодыУпаковок Тогда
		ОписаниеРеквизитовДанныеЗаполнения = ОписаниеРеквизитовДокументаОбмена.Строки.Найти("ТабличныеЧасти", "Имя", Ложь)
			.Строки.Найти("ШтрихкодыУпаковок", "Имя", Ложь);
	Иначе
		ОписаниеРеквизитовДанныеЗаполнения = Неопределено;
	КонецЕсли;
	
	Если ОписаниеРеквизитовДанныеЗаполнения <> Неопределено Тогда
		
		Для Каждого СтрокаОписаниеРеквизитовДанныеЗаполнения Из ОписаниеРеквизитовДанныеЗаполнения.Строки Цикл
			
			Если СтрокаОписаниеРеквизитовДанныеЗаполнения.Имя <> "НомерСтроки" И
				СтрокаОписаниеРеквизитовДанныеЗаполнения.Имя <> "ИдентификаторСтроки" И
				СтрокаОписаниеРеквизитовДанныеЗаполнения.Имя <> "КлючСвязи" И
				СтрокаОписаниеРеквизитовДанныеЗаполнения.Имя <> "КоличествоПлан" И
				СтрокаОписаниеРеквизитовДанныеЗаполнения.Имя <> "КоличествоФакт" Тогда
				ПредставлениеТипа = "Произвольный";
				ОписаниеРеквизита = СтрокаОписаниеРеквизитовДанныеЗаполнения.Представление + НСтр("ru = ' (восстановленные данные)'");
			Иначе
				ПредставлениеТипа = СтрокаОписаниеРеквизитовДанныеЗаполнения.Тип;
				ОписаниеРеквизита = СтрокаОписаниеРеквизитовДанныеЗаполнения.Представление;
			КонецЕсли;
			
			Если СтрокаОписаниеРеквизитовДанныеЗаполнения.Имя = "НомерСтроки" Тогда
				ОписаниеРеквизита = НСтр("ru = 'Номер строки в табличной части документа обмена'");
			ИначеЕсли СтрокаОписаниеРеквизитовДанныеЗаполнения.Имя = "ИдентификаторСтроки" Тогда
				ОписаниеРеквизита = ОписаниеРеквизита + НСтр("ru = ' (служебный идентификатор строки документа обмена)'");
			ИначеЕсли СтрокаОписаниеРеквизитовДанныеЗаполнения.Имя = "КлючСвязи" Тогда
				ОписаниеРеквизита = ОписаниеРеквизита + НСтр("ru = ' (служебный идентификатор для связи с данными табличной части документа 1С)'");
			КонецЕсли;
			
			SUI_РедакторКодаКлиентСервер.ДобавитьСвойствоПользовательскогоОбъекта(_ПользовательскийОбъект, 
				СтрокаОписаниеРеквизитовДанныеЗаполнения.Имя,
				СтрокаОписаниеРеквизитовДанныеЗаполнения.Синоним,
				ОписаниеРеквизита,
				SUI_ОбщегоНазначенияПереопределяемый.СтроковоеПредставлениеТипа(ПредставлениеТипа));
			
		КонецЦикла;
		
		SUI_РедакторКодаКлиентСервер.ДобавитьСвойствоПользовательскогоОбъекта(_ПользовательскийОбъект, 
			"НомерСтрокиПриемник",
			СтрокаОписаниеРеквизитовДанныеЗаполнения.Синоним,
			СтрШаблон(НСтр("ru = 'Номер строки в табличной части документа %1'"), СинонимДокумента),
			Тип("Число"));
		
	КонецЕсли;
	
	// Описание реквизита: ДокументОбъект
	_ПользовательскийОбъект = SUI_РедакторКодаКлиентСервер.ДобавитьПользовательскийОбъект(ПользовательскиеОбъекты, 
		"ДокументОбъект", 
		СтрШаблон(НСтр("ru = 'Объект документа %1'"), СинонимДокумента),
		"ДокументОбъект." + ИмяДокумента,
		Тип("ДокументСсылка." + ИмяДокумента));
	
	Для Каждого ОписаниеРеквизита Из ОписаниеРеквизитовДокумента.Строки.Найти("Реквизиты", "Имя", Ложь).Строки Цикл
		
		SUI_РедакторКодаКлиентСервер.ДобавитьСвойствоПользовательскогоОбъекта(_ПользовательскийОбъект, 
			ОписаниеРеквизита.Имя,
			ОписаниеРеквизита.Синоним,
			ОписаниеРеквизита.Представление,
			SUI_ОбщегоНазначенияПереопределяемый.СтроковоеПредставлениеТипа(ОписаниеРеквизита.Тип),
			,
			Истина);
		
	КонецЦикла;
	
	ОписаниеРеквизитовТекущаяСтрока = Неопределено;
	
	Для Каждого ОписаниеРеквизита Из ОписаниеРеквизитовДокумента.Строки.Найти("ТабличныеЧасти", "Имя", Ложь).Строки Цикл
		
		_СвойствоПользовательскогоОбъекта = SUI_РедакторКодаКлиентСервер.ДобавитьСвойствоПользовательскогоОбъекта(_ПользовательскийОбъект, 
			ОписаниеРеквизита.Имя,
			ОписаниеРеквизита.Синоним,
			ОписаниеРеквизита.Представление,
			"ТабличнаяЧасть",
			,
			Истина);
		
		Для Каждого ОписаниеРеквизитаТЧ Из ОписаниеРеквизита.Строки Цикл
			
			SUI_РедакторКодаКлиентСервер.ДобавитьСвойствоПользовательскогоОбъекта(_СвойствоПользовательскогоОбъекта, 
				ОписаниеРеквизитаТЧ.Имя,
				ОписаниеРеквизитаТЧ.Синоним,
				ОписаниеРеквизитаТЧ.Представление,
				SUI_ОбщегоНазначенияПереопределяемый.СтроковоеПредставлениеТипа(ОписаниеРеквизитаТЧ.Тип),
				,
				Истина);
			
		КонецЦикла;
		
		Если ОписаниеРеквизита.Имя = ИмяТабличнойЧасти Тогда
			ОписаниеРеквизитовТекущаяСтрока = ОписаниеРеквизита.Строки;
		КонецЕсли;
		
	КонецЦикла;
	
	// Описание переменных: ТекущаяСтрока
	_ПользовательскийОбъект = SUI_РедакторКодаКлиентСервер.ДобавитьПользовательскийОбъект(ПользовательскиеОбъекты, 
		"ТекущаяСтрока", 
		СтрШаблон(НСтр("ru = 'Строка табличной части %1 документа %2'"), ИмяТабличнойЧасти, СинонимДокумента),
		"СтрокаТабличнойЧасти");
	
	Если ОписаниеРеквизитовТекущаяСтрока <> Неопределено Тогда
		
		Для Каждого ОписаниеРеквизитаТекущейСтроки Из ОписаниеРеквизитовТекущаяСтрока Цикл
			
			SUI_РедакторКодаКлиентСервер.ДобавитьСвойствоПользовательскогоОбъекта(_ПользовательскийОбъект, 
				ОписаниеРеквизитаТекущейСтроки.Имя,
				ОписаниеРеквизитаТекущейСтроки.Синоним,
				ОписаниеРеквизитаТекущейСтроки.Представление,
				SUI_ОбщегоНазначенияПереопределяемый.СтроковоеПредставлениеТипа(ОписаниеРеквизитаТекущейСтроки.Тип),
				SUI_ОбщегоНазначения.ПолучитьПервыйСсылочныеТипВОписанииТипов(ОписаниеРеквизитаТекущейСтроки.Тип));
			
		КонецЦикла;
		
	КонецЕсли;
	
	// Описание переменных: НоваяСтрока
	SUI_РедакторКодаКлиентСервер.ДобавитьПользовательскийОбъект(ПользовательскиеОбъекты, 
		"НоваяСтрока", 
		СтрШаблон(НСтр("ru = 'Признак новой строки параметра ""ТекущаяСтрока"" в табличной части %1 документа %2'"), ИмяТабличнойЧасти, СинонимДокумента),
		Тип("Булево"));
		
КонецПроцедуры

&НаКлиенте
Процедура АлгоритмОбработкиСтрокЗагрузкиДанныхЗавершениеРедактирования(Алгоритм, Контекст) Экспорт
	
	Если Алгоритм = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеНастройкиТаблицы = Объект.НастройкиТаблиц.НайтиПоИдентификатору(Контекст.ИдентификаторВладельца);
	
	Если ДанныеНастройкиТаблицы <> Неопределено Тогда
		ДанныеНастройкиТаблицы.АлгоритмОбработкиСтрокЗагрузкиДанных = Алгоритм;
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура АлгоритмПередИПослеЗаписиЗавершениеРедактирования(Алгоритм, Контекст) Экспорт
	
	Если Алгоритм = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Объект[Контекст.ИмяРеквизитаАлгоритма] = Алгоритм;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура АлгоритмЗаполненияДокументаОснованияЗавершениеРедактирования(Алгоритм, Контекст) Экспорт
	
	Если Алгоритм = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеНастройкиТаблицы = Объект.ПостобработкаСозданиеДокументовНаОсновании.НайтиПоИдентификатору(Контекст.ИдентификаторВладельца);
	ДанныеНастройкиТаблицы.АлгоритмОбработчик = Алгоритм;
	
	Модифицированность = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область Постобработка

#Область ЗаполнениеРеквизитовДокумента

&НаКлиенте
Функция ПараметрыОткрытияНастройкиЗаполненияРеквизитовПостобработки(КлючСвязи = Неопределено)
	
	ПараметрыОткрытия = Новый Структура();
	ПараметрыОткрытия.Вставить("КлючСвязи", КлючСвязи);
	ПараметрыОткрытия.Вставить("УникальныйИдентификатор", УникальныйИдентификатор);
	ПараметрыОткрытия.Вставить("Заголовок", "");
	ПараметрыОткрытия.Вставить("ИмяМетаданныхДокумента", Объект.ИмяМетаданныхДокумента);
	ПараметрыОткрытия.Вставить("ТипТаблицы");
	ПараметрыОткрытия.Вставить("ИмяТабличнойЧасти", "");
	ПараметрыОткрытия.Вставить("АдресНастройкиЗаполненияРеквизитов", "");
	
	Если ПараметрыОткрытия.КлючСвязи = Неопределено Тогда
		ПараметрыОткрытия.КлючСвязи = Новый УникальныйИдентификатор();
	ИначеЕсли ЗначениеЗаполнено(ПараметрыОткрытия.КлючСвязи) Тогда
		
		НастройкаТаблицыПоКлючуСвязи = Объект.НастройкиТаблиц.НайтиСтроки(Новый Структура("КлючСвязи", ПараметрыОткрытия.КлючСвязи));
		Если ЗначениеЗаполнено(НастройкаТаблицыПоКлючуСвязи) Тогда
			ПараметрыОткрытия.ТипТаблицы = НастройкаТаблицыПоКлючуСвязи[0].ТипТаблицы;
			ПараметрыОткрытия.ИмяТабличнойЧасти = НастройкаТаблицыПоКлючуСвязи[0].ИмяТабличнойЧасти;
		КонецЕсли;
		
	КонецЕсли;
	
	ДополнитьПараметрыОткрытияНастройкиЗаполненияРеквизитовПостобработкиНаСервере(ПараметрыОткрытия);
	
	Возврат ПараметрыОткрытия;
	
КонецФункции

&НаСервере
Процедура ДополнитьПараметрыОткрытияНастройкиЗаполненияРеквизитовПостобработкиНаСервере(ПараметрыОткрытия)
	
	НастройкиЗаполненияРеквизитовПоКлючуСвязи = Объект.ПостобработкаЗаполнениеРеквизитов.Выгрузить(
		Новый Структура("КлючСвязи", ПараметрыОткрытия.КлючСвязи));
	
	Если ЗначениеЗаполнено(НастройкиЗаполненияРеквизитовПоКлючуСвязи) Тогда
		
		Запрос = Новый Запрос();
		Запрос.УстановитьПараметр("НастройкиЗаполненияРеквизитовПоКлючуСвязи", НастройкиЗаполненияРеквизитовПоКлючуСвязи);
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	НастройкиЗаполненияРеквизитовПоКлючуСвязи.НомерСтроки,
			|	НастройкиЗаполненияРеквизитовПоКлючуСвязи.Реквизит,
			|	НастройкиЗаполненияРеквизитовПоКлючуСвязи.Значение,
			|	НастройкиЗаполненияРеквизитовПоКлючуСвязи.ПриРасхождении
			|ПОМЕСТИТЬ втНастройкиЗаполненияРеквизитовПоКлючуСвязи
			|ИЗ
			|	&НастройкиЗаполненияРеквизитовПоКлючуСвязи КАК НастройкиЗаполненияРеквизитовПоКлючуСвязи
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	втНастройкиЗаполненияРеквизитовПоКлючуСвязи.Реквизит,
			|	втНастройкиЗаполненияРеквизитовПоКлючуСвязи.Значение,
			|	втНастройкиЗаполненияРеквизитовПоКлючуСвязи.ПриРасхождении
			|ИЗ
			|	(ВЫБРАТЬ
			|		втНастройкиЗаполненияРеквизитовПоКлючуСвязи.Реквизит,
			|		МИНИМУМ(втНастройкиЗаполненияРеквизитовПоКлючуСвязи.НомерСтроки) КАК НомерСтроки
			|	ИЗ
			|		втНастройкиЗаполненияРеквизитовПоКлючуСвязи КАК втНастройкиЗаполненияРеквизитовПоКлючуСвязи
			|	СГРУППИРОВАТЬ ПО
			|		втНастройкиЗаполненияРеквизитовПоКлючуСвязи.Реквизит) КАК ВложенныйЗапрос
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втНастройкиЗаполненияРеквизитовПоКлючуСвязи КАК втНастройкиЗаполненияРеквизитовПоКлючуСвязи
			|		ПО ВложенныйЗапрос.Реквизит = втНастройкиЗаполненияРеквизитовПоКлючуСвязи.Реквизит
			|		И ВложенныйЗапрос.НомерСтроки = втНастройкиЗаполненияРеквизитовПоКлючуСвязи.НомерСтроки";
		
		ПараметрыОткрытия.АдресНастройкиЗаполненияРеквизитов = ПоместитьВоВременноеХранилище(
			Запрос.Выполнить().Выгрузить(), УникальныйИдентификатор);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытиеНастройкиЗаполненияРеквизитовПостобработки(КлючСвязи = Неопределено, Заголовок = "", ПараметрыОткрытия = Неопределено)
	
	Если ПараметрыОткрытия = Неопределено Тогда
		
		ПараметрыОткрытия = ПараметрыОткрытияНастройкиЗаполненияРеквизитовПостобработки(КлючСвязи);
		ПараметрыОткрытия.Заголовок = Заголовок;
		
	КонецЕсли;
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("НастройкиЗаполненияРеквизитовПостобработкиЗавершение", ЭтотОбъект);
	
	ОткрытьФорму("Справочник.SUI_НастройкиДокументовОбмена.Форма.ФормаНастройкиЗаполненияРеквизитовПостобработки", ПараметрыОткрытия, 
		ЭтотОбъект, УникальныйИдентификатор, Окно, , ОповещениеОЗавершении);
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиЗаполненияРеквизитовПостобработкиЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НастройкиЗаполненияРеквизитовПостобработкиЗавершениеНаСервере(Результат.АдресНастройкиЗаполненияРеквизитов, Результат.КлючСвязи);
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура НастройкиЗаполненияРеквизитовПостобработкиЗавершениеНаСервере(АдресНастройкиЗаполненияРеквизитов, КлючСвязи)
	
	Если Не ПустаяСтрока(АдресНастройкиЗаполненияРеквизитов) И ЭтоАдресВременногоХранилища(АдресНастройкиЗаполненияРеквизитов) Тогда
		ТаблицаИсточник = ПолучитьИзВременногоХранилища(АдресНастройкиЗаполненияРеквизитов);
	Иначе
		ТаблицаИсточник = Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос();
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаблицаИсточник.Реквизит,
		|	ТаблицаИсточник.Значение,
		|	ТаблицаИсточник.ПриРасхождении
		|ПОМЕСТИТЬ втТаблицаИсточник
		|ИЗ
		|	&ТаблицаИсточник КАК ТаблицаИсточник
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТаблицаПриемник.КлючСвязи,
		|	ТаблицаПриемник.Реквизит,
		|	ТаблицаПриемник.Значение,
		|	ТаблицаПриемник.ПриРасхождении
		|ПОМЕСТИТЬ втТаблицаПриемник
		|ИЗ
		|	&ТаблицаПриемник КАК ТаблицаПриемник
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	&КлючСвязиТаблицыИсточник КАК КлючСвязи,
		|	втТаблицаИсточник.Реквизит,
		|	втТаблицаИсточник.Значение,
		|	втТаблицаИсточник.ПриРасхождении
		|ИЗ
		|	втТаблицаИсточник КАК втТаблицаИсточник
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	втТаблицаПриемник.КлючСвязи,
		|	втТаблицаПриемник.Реквизит,
		|	втТаблицаПриемник.Значение,
		|	втТаблицаПриемник.ПриРасхождении
		|ИЗ
		|	втТаблицаПриемник КАК втТаблицаПриемник
		|ГДЕ
		|	&УсловиеПоКлючуСвязиТаблицыИсточник
		|	И втТаблицаПриемник.КлючСвязи В (&КлючиСвязиНастроекТаблиц)";
	
	Запрос.УстановитьПараметр("КлючСвязиТаблицыИсточник", КлючСвязи);
	Запрос.УстановитьПараметр("УсловиеПоКлючуСвязиТаблицыИсточник", Истина);
	Запрос.УстановитьПараметр("ТаблицаПриемник", Объект.ПостобработкаЗаполнениеРеквизитов.Выгрузить());
	Запрос.УстановитьПараметр("КлючиСвязиНастроекТаблиц", Объект.НастройкиТаблиц.Выгрузить().ВыгрузитьКолонку("КлючСвязи"));
	
	Если КлючСвязи <> Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоКлючуСвязиТаблицыИсточник", "втТаблицаПриемник.КлючСвязи <> &КлючСвязиТаблицыИсточник");
	КонецЕсли;
	
	Если ТаблицаИсточник = Неопределено Тогда
		Запрос.УстановитьПараметр("ТаблицаИсточник", Запрос.Параметры.ТаблицаПриемник.Скопировать());
		Запрос.Параметры.ТаблицаИсточник.Очистить();
	Иначе
		Запрос.УстановитьПараметр("ТаблицаИсточник", ТаблицаИсточник);
	КонецЕсли;
	
	Объект.ПостобработкаЗаполнениеРеквизитов.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

#КонецОбласти

#Область СозданиеДокументовНаОсновании

&НаКлиенте
Процедура ИнициализироватьСписокВыбораДокументовОснования()
	
	Элементы.ПостобработкаСозданиеДокументовНаОснованииИмяДокумента.СписокВыбора.Очистить();
	
	Если Не ПустаяСтрока(Объект.ИмяМетаданныхДокумента) Тогда
		ИнициализироватьСписокВыбораДокументовОснованияНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьСписокВыбораДокументовОснованияНаСервере()
	
	Для Каждого ОписаниеДокументаОснования Из SUI_НастройкиДокументовПовтИсп.СписокДокументовВводимыхНаОсновании(Объект.ИмяМетаданныхДокумента) Цикл
		Элементы.ПостобработкаСозданиеДокументовНаОснованииИмяДокумента.СписокВыбора.Добавить(
			ОписаниеДокументаОснования.Значение, ОписаниеДокументаОснования.Представление);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

