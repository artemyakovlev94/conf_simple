
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

//@skip-check export-procedure-missing-comment
#Область ПрограммныйИнтерфейс

Функция НастройкиПоДокументу(ДокументСсылка, ТолькоИспользуемые = Истина, ПараметрыЗапроса = Неопределено) Экспорт
	
	Настройки = Новый Массив();
	
	Если SUI_ОбщегоНазначенияПереопределяемый.ЭтоСсылкаДокумента(ДокументСсылка) Тогда
		
		МетаданныеДокумента = Метаданные.НайтиПоТипу(ТипЗнч(ДокументСсылка));
		
		Если МетаданныеДокумента <> Неопределено Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст =
				"ВЫБРАТЬ
				|	Ссылка,
				|	ХранилищеСхемыКомпоновкиДанных КАК Схема,
				|	ХранилищеНастроекОтбораДокументов КАК НастройкиОтбора
				|ИЗ
				|	Справочник.SUI_НастройкиДокументовОбмена
				|ГДЕ
				|	ИмяМетаданныхДокумента = &ИмяМетаданныхДокумента
				|	И ВЫБОР
				|		КОГДА &ТолькоИспользуемые
				|			ТОГДА Используется
				|			И НЕ ПометкаУдаления
				|		ИНАЧЕ ИСТИНА
				|	КОНЕЦ
				|	&ДополнительныеПараметры";
			
			Запрос.УстановитьПараметр("ИмяМетаданныхДокумента", МетаданныеДокумента.Имя);
			Запрос.УстановитьПараметр("ТолькоИспользуемые", ТолькоИспользуемые);
			
			ДополнительныеПараметры = Новый Массив();
			
			ОписаниеТипаСтруктура = Новый ОписаниеТипов("Структура");
			Для Каждого ПараметрЗапроса Из ОписаниеТипаСтруктура.ПривестиЗначение(ПараметрыЗапроса) Цикл
				ДополнительныеПараметры.Добавить(ПараметрЗапроса.Ключ + " = &" + ПараметрЗапроса.Ключ);
				Запрос.УстановитьПараметр(ПараметрЗапроса.Ключ, ПараметрЗапроса.Значение);
			КонецЦикла;
			
			ДополнительныеПараметры = СтрСоединить(ДополнительныеПараметры, Символы.ПС + Символы.Таб + "И ");
			
			Если Не ПустаяСтрока(ДополнительныеПараметры) Тогда
				ДополнительныеПараметры = "И " + ДополнительныеПараметры;
			КонецЕсли;
			
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДополнительныеПараметры", ДополнительныеПараметры);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			Если Не РезультатЗапроса.Пустой() Тогда
				
				Выборка = РезультатЗапроса.Выбрать();
				
				Пока Выборка.Следующий() Цикл
					
					Если СсылкаДокументаСоответствуетНастройкеОтбора(ДокументСсылка, Выборка.Схема, Выборка.НастройкиОтбора) Тогда
						Настройки.Добавить(Выборка.Ссылка);
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Настройки;
	
КонецФункции

Функция СформироватьДанныеНастройки(НастройкаСсылка) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НастройкаСсылка", НастройкаСсылка);
	Запрос.УстановитьПараметр("ПустойУникальныйИдентификатор", SUI_ОбщегоНазначенияКлиентСерверПереопределяемый.ПустойУникальныйИдентификатор());
	Запрос.Текст =
		"ВЫБРАТЬ
		|	НастройкиДокументовОбмена.Ссылка,
		|	НастройкиДокументовОбмена.Наименование,
		|	НастройкиДокументовОбмена.ПометкаУдаления,
		|	НастройкиДокументовОбмена.Используется,
		|	НастройкиДокументовОбмена.ИмяМетаданныхДокумента,
		|	НастройкиДокументовОбмена.СинонимМетаданныхДокумента,
		|	НастройкиДокументовОбмена.СоздаватьДокументОбменаПриЗаписиДокумента1С,
		|	НастройкиДокументовОбмена.СостояниеПоУмолчанию,
		|	НастройкиДокументовОбмена.КонтролироватьДокумент,
		|	НастройкиДокументовОбмена.ГрупповоеСканирование,
		|	НастройкиДокументовОбмена.ЗагружатьВДокумент1СПослеОбмена,
		|	НастройкиДокументовОбмена.ПроводитьДокумент,
		|	НастройкиДокументовОбмена.Комментарий,
		|	НастройкиДокументовОбмена.ХранилищеСхемыКомпоновкиДанных КАК СхемаКомпоновкиДанных,
		|	НастройкиДокументовОбмена.ХранилищеНастроекОтбораДокументов КАК НастройкиКомпоновкиОтборДокументов,
		|	НастройкиДокументовОбмена.ХранилищеНастроекРеквизитовДокумента КАК НастройкиКомпоновкиРеквизитыДокумента,
		|	НастройкиДокументовОбмена.АлгоритмПередЗаписью,
		|	НастройкиДокументовОбмена.АлгоритмПослеЗаписи
		|ИЗ
		|	Справочник.SUI_НастройкиДокументовОбмена КАК НастройкиДокументовОбмена
		|ГДЕ
		|	НастройкиДокументовОбмена.Ссылка = &НастройкаСсылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	НастройкиСозданиеДокументовНаОсновании.ИмяДокумента,
		|	НастройкиСозданиеДокументовНаОсновании.ПриРасхождении,
		|	НастройкиСозданиеДокументовНаОсновании.ПроведениеПриЗаписи,
		|	НастройкиСозданиеДокументовНаОсновании.АлгоритмОбработчик
		|ИЗ
		|	Справочник.SUI_НастройкиДокументовОбмена.ПостобработкаСозданиеДокументовНаОсновании КАК
		|		НастройкиСозданиеДокументовНаОсновании
		|ГДЕ
		|	НастройкиСозданиеДокументовНаОсновании.Ссылка = &НастройкаСсылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	НастройкиСозданиеДокументовНаОсновании.НомерСтроки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	НастройкиТаблиц.КлючСвязи,
		|	НастройкиТаблиц.ТипТаблицы,
		|	НастройкиТаблиц.ИмяТабличнойЧасти,
		|	НастройкиТаблиц.ПропускатьНеЗаполненные,
		|	НастройкиТаблиц.ХранилищеНастроекРеквизитовТаблицы КАК НастройкиКомпоновкиРеквизитыТаблицы,
		|	НастройкиТаблиц.АлгоритмОбработкиСтрокЗагрузкиДанных
		|ИЗ
		|	Справочник.SUI_НастройкиДокументовОбмена.НастройкиТаблиц КАК НастройкиТаблиц
		|ГДЕ
		|	НастройкиТаблиц.Ссылка = &НастройкаСсылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	НастройкиТаблиц.НомерСтроки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	НастройкиИдентификацииСтрок.КлючСвязи,
		|	НастройкиИдентификацииСтрок.Реквизит
		|ИЗ
		|	Справочник.SUI_НастройкиДокументовОбмена.НастройкиИдентификацииСтрок КАК НастройкиИдентификацииСтрок
		|ГДЕ
		|	НастройкиИдентификацииСтрок.Ссылка = &НастройкаСсылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	НастройкиЗаполненияРеквизитовДокумента.КлючСвязи,
		|	НастройкиЗаполненияРеквизитовДокумента.Реквизит,
		|	НастройкиЗаполненияРеквизитовДокумента.Значение,
		|	НастройкиЗаполненияРеквизитовДокумента.ПриРасхождении
		|ИЗ
		|	Справочник.SUI_НастройкиДокументовОбмена.ПостобработкаЗаполнениеРеквизитов КАК НастройкиЗаполненияРеквизитовДокумента
		|ГДЕ
		|	НастройкиЗаполненияРеквизитовДокумента.Ссылка = &НастройкаСсылка";
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	Если РезультатыЗапроса[0].Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ВыборкаОсновныеДанные = РезультатыЗапроса[0].Выбрать();
	ВыборкаПостобработкаСозданиеДокументов = РезультатыЗапроса[1].Выбрать();
	ВыборкаНастройкиТаблиц = РезультатыЗапроса[2].Выбрать();
	ВыборкаНастройкиИдентификацииСтрок = РезультатыЗапроса[3].Выбрать();
	ВыборкаПостобработкаЗаполненияРеквизитов = РезультатыЗапроса[4].Выбрать();
	
	ВыборкаОсновныеДанные.Следующий();
	
	// Основные данные
	ДанныеНастройки = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ВыборкаОсновныеДанные);
	ДанныеНастройки.СхемаКомпоновкиДанных = ПолучитьИзХранилищаЗначений(ДанныеНастройки.СхемаКомпоновкиДанных, Тип("СхемаКомпоновкиДанных"));
	ДанныеНастройки.НастройкиКомпоновкиОтборДокументов = ПолучитьИзХранилищаЗначений(
		ДанныеНастройки.НастройкиКомпоновкиОтборДокументов, Тип("НастройкиКомпоновкиДанных"));
	
	// ТипДокумента
	ДанныеНастройки.Вставить("ТипДокумента", ОпределитьТипДокументаПоНастроеннымТаблицам(ВыборкаНастройкиТаблиц));
	ВыборкаНастройкиТаблиц.Сбросить();
	
	// РеквизитыДокумента
	ДанныеНастройки.Вставить("РеквизитыДокумента", Новый Структура());
	
	// РеквизитыДокумента.НастройкиКомпоновки
	ДанныеНастройки.РеквизитыДокумента.Вставить("НастройкиКомпоновки", ПолучитьИзХранилищаЗначений(
		ДанныеНастройки.НастройкиКомпоновкиРеквизитыДокумента, Тип("НастройкиКомпоновкиДанных")));
	ДанныеНастройки.Удалить("НастройкиКомпоновкиРеквизитыДокумента");
	
	ПараметрыПоиска = Новый Структура();
	ПараметрыПоиска.Вставить("КлючСвязи", SUI_ОбщегоНазначенияКлиентСерверПереопределяемый.ПустойУникальныйИдентификатор());
	
	// Постобработка
	ДанныеНастройки.Вставить("Постобработка", Новый Структура());
	
	// Постобработка.ЗаполнениеРеквизитов
	ДанныеНастройки.Постобработка.Вставить("ЗаполнениеРеквизитов", Новый Структура());
	Пока ВыборкаПостобработкаЗаполненияРеквизитов.НайтиСледующий(ПараметрыПоиска) Цикл
		ДанныеНастройки.Постобработка.ЗаполнениеРеквизитов.Вставить(
			ВыборкаПостобработкаЗаполненияРеквизитов.Реквизит, 
			ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ВыборкаПостобработкаЗаполненияРеквизитов));
	КонецЦикла;
	
	// Постобработка.НастройкиСозданияДокументовНаОсновании
	ДанныеНастройки.Постобработка.Вставить("СозданиеДокументовНаОсновании", Новый Массив());
	Пока ВыборкаПостобработкаСозданиеДокументов.Следующий() Цикл
		ДанныеНастройки.Постобработка.СозданиеДокументовНаОсновании.Добавить(
			ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ВыборкаПостобработкаСозданиеДокументов));
	КонецЦикла;
	
	// НастройкиТаблиц
	ДанныеНастройки.Вставить("НастройкиТаблиц", Новый Соответствие());
	// ДанныеНастройки.ПорядокНастройкиТаблиц.*
	ДанныеНастройки.Вставить("ПорядокНастройкиТаблиц", Новый Массив());
	
	ДоступныеТипаТаблиц = ДоступныеТипыТаблицПоТипуДокумента(ДанныеНастройки.ТипДокумента);
	
	Пока ВыборкаНастройкиТаблиц.Следующий() Цикл
		
		Если ДоступныеТипаТаблиц.Найти(ВыборкаНастройкиТаблиц.ТипТаблицы) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ПараметрыПоиска.КлючСвязи = ВыборкаНастройкиТаблиц.КлючСвязи;
		
		// НастройкаТаблицы
		НастройкаТаблицы = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ВыборкаНастройкиТаблиц);
		
		// НастройкаТаблицы.НастройкиКомпоновки
		НастройкаТаблицы.Вставить("НастройкиКомпоновки", ПолучитьИзХранилищаЗначений(
			НастройкаТаблицы.НастройкиКомпоновкиРеквизитыТаблицы, Тип("НастройкиКомпоновкиДанных")));
		НастройкаТаблицы.Удалить("НастройкиКомпоновкиРеквизитыТаблицы");
		
		// НастройкаТаблицы.Постобработка
		НастройкаТаблицы.Вставить("Постобработка", Новый Структура());
		
		// НастройкаТаблицы.Постобработка.ЗаполнениеРеквизитов
		НастройкаТаблицы.Постобработка.Вставить("ЗаполнениеРеквизитов", Новый Структура());
		ВыборкаПостобработкаЗаполненияРеквизитов.Сбросить();
		Пока ВыборкаПостобработкаЗаполненияРеквизитов.НайтиСледующий(ПараметрыПоиска) Цикл
			НастройкаТаблицы.Постобработка.ЗаполнениеРеквизитов.Вставить(
				ВыборкаПостобработкаЗаполненияРеквизитов.Реквизит, 
				ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ВыборкаПостобработкаЗаполненияРеквизитов));
		КонецЦикла;
		
		// НастройкаТаблицы.РеквизитыИдентификации
		НастройкаТаблицы.Вставить("РеквизитыИдентификации", Новый Массив());
		ВыборкаНастройкиИдентификацииСтрок.Сбросить();
		Пока ВыборкаНастройкиИдентификацииСтрок.НайтиСледующий(ПараметрыПоиска) Цикл
			НастройкаТаблицы.РеквизитыИдентификации.Добавить(ВыборкаНастройкиИдентификацииСтрок.Реквизит);
		КонецЦикла;
		
		// НастройкаТаблицы.СоответствиеРеквизитов
		НастройкаТаблицы.Вставить("СоответствиеРеквизитов", СоответствиеРеквизитовИзНастройкиКомпоновки(
			НастройкаТаблицы.НастройкиКомпоновки, 
			SUI_НастройкиДокументовКлиентСервер.ПолучитьИменаОсновныхРеквизитовТаблиц(Ложь, ВыборкаНастройкиТаблиц.ТипТаблицы),
			НастройкаТаблицы.ИмяТабличнойЧасти));
		
		// ДанныеНастройки.НастройкиТаблиц.* НастройкаТаблицы
		ДанныеНастройки.НастройкиТаблиц.Вставить(ВыборкаНастройкиТаблиц.ТипТаблицы, НастройкаТаблицы);
		// ДанныеНастройки.ПорядокНастройкиТаблиц.*
		ДанныеНастройки.ПорядокНастройкиТаблиц.Добавить(ВыборкаНастройкиТаблиц.ТипТаблицы);
		
	КонецЦикла;
	
	Возврат ДанныеНастройки;
	
КонецФункции

Функция ТипДокументаПоНастройке(НастройкаДокумента) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НастройкаДокумента, "НастройкиТаблиц.ТипТаблицы");
	Возврат ОпределитьТипДокументаПоНастроеннымТаблицам(РезультатЗапроса.Выбрать());
	
КонецФункции

Функция НастроенныеТипыТаблиц(НастройкаДокумента) Экспорт
	
	Возврат Новый ФиксированныйМассив(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НастройкаДокумента, "НастройкиТаблиц.ТипТаблицы")
		.Выгрузить().ВыгрузитьКолонку("ТипТаблицы"));
	
КонецФункции

Функция ДоступныеТипыТаблицПоТипуДокумента(ТипДокумента) Экспорт
	
	ДоступныеТипыТаблиц = Новый Массив();
	
	Если ТипДокумента = Перечисления.SUI_ТипыДокументовОбмена.СборШтрихкодов Тогда
		ДоступныеТипыТаблиц.Добавить(Перечисления.SUI_ТипыТаблицДокументовОбмена.ПотокШтрихкодов);
	ИначеЕсли ТипДокумента <> Неопределено Тогда
		
		ДоступныеТипыТаблиц.Добавить(Перечисления.SUI_ТипыТаблицДокументовОбмена.Серии);
		ДоступныеТипыТаблиц.Добавить(Перечисления.SUI_ТипыТаблицДокументовОбмена.ШтрихкодыУпаковок);
		
		Если ТипДокумента = Перечисления.SUI_ТипыДокументовОбмена.Документ Тогда
			ДоступныеТипыТаблиц.Добавить(Перечисления.SUI_ТипыТаблицДокументовОбмена.Товары);
		ИначеЕсли ТипДокумента = Перечисления.SUI_ТипыДокументовОбмена.АдресноеХранениеОтбор Тогда
			ДоступныеТипыТаблиц.Добавить(Перечисления.SUI_ТипыТаблицДокументовОбмена.Отбор);
		ИначеЕсли ТипДокумента = Перечисления.SUI_ТипыДокументовОбмена.АдресноеХранениеРазмещение Тогда
			ДоступныеТипыТаблиц.Добавить(Перечисления.SUI_ТипыТаблицДокументовОбмена.Размещение);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ДоступныеТипыТаблиц;
	
КонецФункции

Функция ПолучитьДоступныеНастроенныеТипыТаблиц(НастройкаДокумента, ТипДокумента) Экспорт
	
	НастроенныеТипыТаблиц = Новый Массив();
	
	Если ЗначениеЗаполнено(НастройкаДокумента) И ОбщегоНазначения.СсылкаСуществует(НастройкаДокумента) Тогда
		
		ДоступныеТипыТаблиц = ДоступныеТипыТаблицПоТипуДокумента(ТипДокумента);
		
		Для Каждого НастроенныйТипТаблицы Из НастроенныеТипыТаблиц(НастройкаДокумента) Цикл
			Если ДоступныеТипыТаблиц.Найти(НастроенныйТипТаблицы) <> Неопределено Тогда
				НастроенныеТипыТаблиц.Добавить(НастроенныйТипТаблицы);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Новый ФиксированныйМассив(НастроенныеТипыТаблиц);
	
КонецФункции

Функция ПолучитьНастроенныеТипы() Экспорт
	
	НастроенныеТипы = Новый Массив();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ИмяМетаданныхДокумента
		|ИЗ
		|	Справочник.SUI_НастройкиДокументовОбмена";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			НастроенныеТипы.Добавить(Тип("ДокументСсылка." + Выборка.ИмяМетаданныхДокумента));	
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат НастроенныеТипы;
	
КонецФункции

