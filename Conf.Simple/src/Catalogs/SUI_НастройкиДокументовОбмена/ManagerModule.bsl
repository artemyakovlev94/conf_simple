Функция ПолучитьМетаданныеДокумента(Источник) Экспорт
	
	МетаданныеДокумента = Неопределено;
	
	ТипЗначенияИсточника = ТипЗнч(Источник);
	Если ТипЗначенияИсточника = Тип("ОбъектМетаданных") Тогда
		
		Если Метаданные.Документы.Содержит(Источник) Тогда
			МетаданныеДокумента = Источник;
		КонецЕсли;
		
	Иначе
		
		Если ТипЗначенияИсточника = ТипЗнч(ПустаяСсылка()) Тогда
			ИмяМетаданныхДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник, "ИмяМетаданныхДокумента");
		ИначеЕсли ТипЗначенияИсточника = Тип("Строка") Тогда
			ИмяМетаданныхДокумента = Источник;
		Иначе
			ИмяМетаданныхДокумента = Источник.ИмяМетаданныхДокумента;
		КонецЕсли;
		
		Если Не ПустаяСтрока(ИмяМетаданныхДокумента) Тогда
			МетаданныеДокумента = ОбщегоНазначения.ОбъектМетаданныхПоПолномуИмени("Документ." + ИмяМетаданныхДокумента);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат МетаданныеДокумента;
	
КонецФункции

Функция ПолучитьСхемуКомпоновкиДанных(Источник, ИмяТабличнойЧасти = "", ПараметрыСхемы = Неопределено, БезТаблиц = Ложь, АдресРезультата = "") Экспорт
	
	СхемаКомпоновкиДанных = Неопределено;
	
	МетаданныеДокумента = ПолучитьМетаданныеДокумента(Источник);
	
	Если МетаданныеДокумента <> Неопределено Тогда
		
		ПоляВыбора = Новый Массив();
		Если БезТаблиц Тогда
			
			Для Каждого ОписаниеРеквизита Из SUI_НастройкиДокументовПовтИсп.ОписаниеРеквизитовДокумента(МетаданныеДокумента.Имя)
				.Строки.Найти("Реквизиты", "Имя", Ложь).Строки Цикл
				ПоляВыбора.Добавить(ОписаниеРеквизита.Имя);
			КонецЦикла;
			
		Иначе
			ПоляВыбора.Добавить("*");
		КонецЕсли;
		
		СхемаКомпоновкиДанных = SUI_КомпоновкаДанныхСервер.ПустаяСхема();
		НаборДанных = SUI_КомпоновкаДанныхСервер.ДобавитьПустойНаборДанных(СхемаКомпоновкиДанных);
		НаборДанных.Запрос = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	" + СтрСоединить(ПоляВыбора, "," + Символы.ПС + Символы.Таб) + "
			|ИЗ
			|	" + МетаданныеДокумента.ПолноеИмя();
			
		Если Не ПустаяСтрока(ИмяТабличнойЧасти) Тогда
			
			Если МетаданныеДокумента.ТабличныеЧасти.Найти(ИмяТабличнойЧасти) = Неопределено Тогда
				СхемаКомпоновкиДанных = Неопределено;
			Иначе
				НаборДанных.Запрос = НаборДанных.Запрос + "." + ИмяТабличнойЧасти;
			КонецЕсли;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПараметрыСхемы) Тогда
			
			Условия = Новый Массив();
			Для Каждого ПараметрСхемы Из ПараметрыСхемы Цикл
				
				Условия.Добавить(ПараметрСхемы.Ключ + " = &" + ПараметрСхемы.Ключ);
				
				Если ПараметрСхемы.Значение <> Неопределено Тогда
					SUI_КомпоновкаДанныхСервер.ДобавитьПараметр(СхемаКомпоновкиДанных, ПараметрСхемы.Ключ, , 
						ПараметрСхемы.Значение, , Истина);
				КонецЕсли;
				
			КонецЦикла;
			
			НаборДанных.Запрос = НаборДанных.Запрос + "
			|ГДЕ
			|	" + СтрСоединить(Условия, "," + Символы.ПС + Символы.Таб);
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(АдресРезультата) Тогда
			
			ТипЗначенияАдресРезультата = ТипЗнч(АдресРезультата);
			
			Если (ТипЗначенияАдресРезультата = Тип("Строка") И ЭтоАдресВременногоХранилища(АдресРезультата)) Или
				ТипЗначенияАдресРезультата = Тип("УникальныйИдентификатор") Тогда
				СхемаКомпоновкиДанных = ПоместитьВоВременноеХранилище(СхемаКомпоновкиДанных, АдресРезультата);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СхемаКомпоновкиДанных;
	
КонецФункции

Функция ПолучитьИзХранилищаЗначений(Хранилище, ОжидаемыйТип = Неопределено) Экспорт
	
	ТипЗначенияXML = XMLТипЗнч(Хранилище);
	Если ТипЗначенияXML <> Неопределено И ТипЗначенияXML.ИмяТипа = "ValueStorage" Тогда
		ПолученноеЗначение = Хранилище.Получить();
	Иначе
		ПолученноеЗначение = Хранилище;
	КонецЕсли;
	
	Если ОжидаемыйТип <> Неопределено Тогда
		ОписаниеОжидаемогоТипа = Новый ОписаниеТипов(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ОжидаемыйТип));
		ПолученноеЗначение = ОписаниеОжидаемогоТипа.ПривестиЗначение(ПолученноеЗначение);
	КонецЕсли;
	
	Возврат ПолученноеЗначение;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СсылкаДокументаСоответствуетНастройкеОтбора(ДокументСсылка, Знач Схема, Знач НастройкиОтбора)
	
	Схема = ПолучитьИзХранилищаЗначений(Схема, Тип("СхемаКомпоновкиДанных"));
	SUI_КомпоновкаДанныхСервер.ДобавитьПараметр(Схема, "Ссылка", , ДокументСсылка, , Истина);
	
	НастройкиОтбора = ПолучитьИзХранилищаЗначений(НастройкиОтбора, Тип("НастройкиКомпоновкиДанных"));
	SUI_КомпоновкаДанныхКлиентСервер.ДобавитьВыбранноеПоле(НастройкиОтбора, "Ссылка");
	
	ПараметрыВыгрузкиРезультата = SUI_КомпоновкаДанныхСервер.ПараметрыРезультатСхемыКомпоновкиДанных();
	ПараметрыВыгрузкиРезультата.СхемаКомпоновкиДанных = Схема;
	ПараметрыВыгрузкиРезультата.НастройкиКомпоновкиДанных = НастройкиОтбора;
	ПараметрыВыгрузкиРезультата.ВыполнятьВПривилегированномРежиме = Истина;
	
	Возврат (SUI_КомпоновкаДанныхСервер.ВыгрузитьРезультатСхемыКомпоновкиДанных(ПараметрыВыгрузкиРезультата).Количество() > 0);
	
КонецФункции

Функция СоответствиеРеквизитовИзНастройкиКомпоновки(НастройкаКомпоновки, ОсновныеРеквизиты, ИмяТабличнойЧасти = "")
	
	СоответствиеРеквизитов = Новый Соответствие();
	
	ПользовательскиеПоля = Новый Соответствие();
	
	Для Каждого ЭлементПП Из НастройкаКомпоновки.ПользовательскиеПоля.Элементы Цикл
		
		Если ЭлементПП.Использование И 
			ПустаяСтрока(ЭлементПП.Заголовок) И 
			ЭлементПП.Варианты.Элементы.Количество() = 1 И
			ЭлементПП.Варианты.Элементы[0].Использование И
			ЭлементПП.Варианты.Элементы[0].Отбор.Элементы.Количество() = 0 И
			ТипЗнч(ЭлементПП.Варианты.Элементы[0].Значение) = ТипЗнч(Новый ПолеКомпоновкиДанных("")) Тогда
			
			Значение = Строка(ЭлементПП.Варианты.Элементы[0].Значение);
			
			Если ПустаяСтрока(ИмяТабличнойЧасти) Тогда
				//
			ИначеЕсли СтрНачинаетсяС(Значение, ИмяТабличнойЧасти + ".") Тогда
					
				Значение = СтрРазделить(Значение, ".", Ложь);
				Если Значение.Количество() = 2 Тогда
					ПользовательскиеПоля.Вставить(Строка(ЭлементПП.ПутьКДанным), Значение[1]);
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого ЭлементВыбора Из НастройкаКомпоновки.Выбор.Элементы Цикл
		
		Если Не ЭлементВыбора.Использование Или ПустаяСтрока(ЭлементВыбора.Заголовок) Или
			ОсновныеРеквизиты.НайтиПоЗначению(ЭлементВыбора.Заголовок) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ПолеСтрокой = Строка(ЭлементВыбора.Поле);
		
		Если СтрНачинаетсяС(ПолеСтрокой, "ПользовательскиеПоля.Поле") Тогда
			
			Значение = ПользовательскиеПоля.Получить(ПолеСтрокой);
			Если Значение <> Неопределено Тогда
				СоответствиеРеквизитов.Вставить(ЭлементВыбора.Заголовок, Значение);
			КонецЕсли;
			
		ИначеЕсли Не ПустаяСтрока(ИмяТабличнойЧасти) И СтрНачинаетсяС(ПолеСтрокой, ИмяТабличнойЧасти + ".") Тогда
			
			Значение = СтрРазделить(ПолеСтрокой, ".", Ложь);
			Если Значение.Количество() = 2 Тогда
				СоответствиеРеквизитов.Вставить(ЭлементВыбора.Заголовок, Значение[1]);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Новый ФиксированноеСоответствие(СоответствиеРеквизитов);
	
КонецФункции

Функция ОпределитьТипДокументаПоНастроеннымТаблицам(ВыборкаТаблиц)
	
	ТипДокумента = Неопределено;
	
	Пока ВыборкаТаблиц.Следующий() Цикл
		
		ТипДокумента = ТипДокументаПоТипуТаблицы(ВыборкаТаблиц.ТипТаблицы);
		
		Если ТипДокумента <> Неопределено И ТипДокумента <> Перечисления.SUI_ТипыДокументовОбмена.ПустаяСсылка() Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТипДокумента;
	
КонецФункции

Функция ТипДокументаПоТипуТаблицы(ТипТаблицы)
	
	Если ТипТаблицы = Перечисления.SUI_ТипыТаблицДокументовОбмена.Товары Тогда
		Возврат Перечисления.SUI_ТипыДокументовОбмена.Документ;
	ИначеЕсли ТипТаблицы = Перечисления.SUI_ТипыТаблицДокументовОбмена.Отбор Тогда
		Возврат Перечисления.SUI_ТипыДокументовОбмена.АдресноеХранениеОтбор;
	ИначеЕсли ТипТаблицы = Перечисления.SUI_ТипыТаблицДокументовОбмена.Размещение Тогда
		Возврат Перечисления.SUI_ТипыДокументовОбмена.АдресноеХранениеРазмещение;
	ИначеЕсли ТипТаблицы = Перечисления.SUI_ТипыТаблицДокументовОбмена.ПотокШтрихкодов Тогда
		Возврат Перечисления.SUI_ТипыДокументовОбмена.СборШтрихкодов;
	Иначе
		Возврат Перечисления.SUI_ТипыДокументовОбмена.ПустаяСсылка();
	КонецЕсли;
	
КонецФункции

