<package xmlns="http://v8.1c.ru/8.1/xdto" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" targetNamespace="http://www.migration-settings.simple" elementFormQualified="true" attributeFormQualified="false">
	<import namespace="http://v8.1c.ru/8.1/data/core"/>
	<import namespace="http://www.w3.org/2001/XMLSchema"/>
	<valueType name="ConfigurationVersion" base="xs:string" variety="Atomic">
		<pattern>[0-9]{1,3}.[0-9]{1,3}.[0-9]{1,3}.[0-9]{1,4}</pattern>
	</valueType>
	<valueType name="ExtensionVersion" base="xs:string" variety="Atomic">
		<pattern>2[4-9].(1[0-2]|[1-9]).(1[0-9]|2[0-9]|3[0-1]|[1-9]).[0-9]{1,4}</pattern>
	</valueType>
	<valueType name="HEX" base="xs:string">
		<pattern>[a-f0-9]{32}</pattern>
	</valueType>
	<objectType name="ManifestFile">
		<property name="Date" type="xs:dateTime"/>
		<property xmlns:d3p1="http://www.migration-settings.simple" name="Configuration" type="d3p1:Configuration" upperBound="-1"/>
	</objectType>
	<objectType name="Configuration">
		<property xmlns:d3p1="http://www.migration-settings.simple" name="HEX" type="d3p1:HEX" form="Attribute"/>
		<property name="Name" type="xs:string" form="Attribute"/>
		<property name="Synonym" type="xs:string" form="Attribute"/>
		<property xmlns:d3p1="http://www.migration-settings.simple" name="Version" type="d3p1:ConfigurationVersion" lowerBound="0" nillable="true" form="Attribute"/>
		<property xmlns:d3p1="http://www.migration-settings.simple" name="ExtensionVersion" type="d3p1:ExtensionVersion" lowerBound="0" nillable="true" form="Attribute"/>
		<property xmlns:d3p1="http://www.migration-settings.simple" name="Settings" type="d3p1:Settings"/>
	</objectType>
	<objectType name="Settings">
		<property xmlns:d3p1="http://www.migration-settings.simple" name="Documents" type="d3p1:Setting" lowerBound="0" nillable="true"/>
		<property xmlns:d3p1="http://www.migration-settings.simple" name="IntegrationTables" type="d3p1:Setting" lowerBound="0" nillable="true"/>
		<property xmlns:d3p1="http://www.migration-settings.simple" name="IntegrationAdditional" type="d3p1:Setting" lowerBound="0" nillable="true"/>
		<property xmlns:d3p1="http://www.migration-settings.simple" name="IntegrationQuery" type="d3p1:Setting" lowerBound="0" nillable="true"/>
	</objectType>
	<objectType name="Setting">
		<property xmlns:d3p1="http://www.migration-settings.simple" name="Files" type="d3p1:File" lowerBound="0" upperBound="-1" nillable="true"/>
	</objectType>
	<objectType name="File">
		<property xmlns:d3p1="http://v8.1c.ru/8.1/data/core" name="ID" type="d3p1:UUID" form="Attribute"/>
		<property name="Key" type="xs:string" form="Attribute"/>
		<property name="Name" type="xs:string" form="Attribute"/>
		<property name="Description" type="xs:string" lowerBound="0" nillable="true"/>
	</objectType>
</package>