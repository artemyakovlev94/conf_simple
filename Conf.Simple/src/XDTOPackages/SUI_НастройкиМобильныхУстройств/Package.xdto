<package xmlns="http://v8.1c.ru/8.1/xdto" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" targetNamespace="http://www.mobile-settings.simple" elementFormQualified="true" attributeFormQualified="false">
	<objectType name="settings">
		<property xmlns:d3p1="http://www.mobile-settings.simple" name="global_settings" type="d3p1:global_settings"/>
		<property xmlns:d3p1="http://www.mobile-settings.simple" name="style_settings" type="d3p1:style_settings"/>
		<property xmlns:d3p1="http://www.mobile-settings.simple" name="sound_settings" type="d3p1:sound_settings"/>
		<property xmlns:d3p1="http://www.mobile-settings.simple" name="http_settings" type="d3p1:http_settings"/>
		<property xmlns:d3p1="http://www.mobile-settings.simple" name="documents_settings" type="d3p1:documents_settings"/>
		<property xmlns:d3p1="http://www.mobile-settings.simple" name="logs_settings" type="d3p1:logs_settings"/>
		<property xmlns:d3p1="http://www.mobile-settings.simple" name="print_settings" type="d3p1:print_settings"/>
		<property xmlns:d3p1="http://www.mobile-settings.simple" name="scanner_settings" type="d3p1:scanner_settings"/>
		<property xmlns:d3p1="http://www.mobile-settings.simple" name="scanner_params" type="d3p1:scanner_params"/>
		<property xmlns:d3p1="http://www.mobile-settings.simple" name="series_settings" type="d3p1:series_settings"/>
	</objectType>
	<objectType name="global_settings">
		<property name="allow_fact_input" type="xs:boolean" default="true" localName="РазрешитьВводФакта"/>
		<property name="offline_mode" type="xs:boolean" default="false" localName="ОфлайнРежим"/>
		<property name="group_offline_mode" type="xs:boolean" default="false" localName="ОфлайнРежимГрупповойРаботы"/>
		<property name="stop_timer_global" type="xs:boolean" default="false" localName="ОтключитьОбмен"/>
		<property name="enable_gtin_mark_check" type="xs:boolean" default="true" localName="КонтрольGTIN"/>
	</objectType>
	<objectType name="style_settings">
		<property name="title_text_size" type="xs:int" default="15" localName="РазмерШрифтаЗаголовкаТаблицы"/>
		<property name="main_info_text_size" type="xs:int" default="18" localName="РазмерШрифтаОсновнойИнформации"/>
		<property name="additional_info_text_size" type="xs:int" default="16" localName="РазмерШрифтаДополнительнойИнформации"/>
		<property name="card_text_size" type="xs:int" default="15" localName="РазмерШтрифтаОтсутствияВНастройке"/>
	</objectType>
	<objectType name="sound_settings">
		<property name="success_signal" type="xs:int" default="7" localName="СигналУдачногоСобытия"/>
		<property name="warning_signal" type="xs:int" default="8" localName="СигналПредупреждения"/>
		<property name="error_signal" type="xs:int" default="5" localName="СигналОшибки"/>
		<property name="info_signal" type="xs:int" default="9" localName="СигналУведомления"/>
	</objectType>
	<objectType name="http_settings">
		<property name="url" type="xs:string" localName="АдресСервера"/>
		<property name="user" type="xs:string" localName="Пользователь"/>
		<property name="user_name" type="xs:string" localName="ПользовательНаименование"/>
	</objectType>
	<objectType name="documents_settings">
		<property name="delete_old_docs" type="xs:boolean" default="true" localName="УдалятьУстаревшиеДокументы"/>
		<property name="doc_delete_settings_days" type="xs:int" default="1" localName="СрокХраненияДокументовВДнях"/>
		<property name="delete_doc_statuses" type="xs:string" localName="УдалятьДокументыСоСтатусамиСтрокой"/>
	</objectType>
	<objectType name="logs_settings">
		<property name="error_logs_on_page_count" type="xs:int" default="20" localName="КоличествоЛоговНаСтранице"/>
		<property name="delete_error_logs" type="xs:boolean" localName="УдалятьУстаревшиеЛоги"/>
		<property name="delete_error_logs_days" type="xs:int" default="1" localName="СрокХраненияЛоговВДнях"/>
		<property name="log_level" type="xs:string" default="DEBUG" localName="УровеньЛогирования"/>
		<property name="enable_traceback" type="xs:boolean" localName="ВыводитьСтекВызовов"/>
	</objectType>
	<objectType name="print_settings">
		<property name="offline_print" type="xs:boolean" localName="ОфлайнПечать"/>
		<property name="print_template_type" type="xs:string" default="ZPL" localName="ШаблонЭтикетки"/>
		<property name="print_connect_type" type="xs:string" default="BT" localName="ПротоколПечати"/>
		<property name="current_BT_printer_MAC" type="xs:string" localName="MACАдресBTПринтера"/>
		<property name="current_WiFi_printer_IP" type="xs:string" localName="IPАдресWiFiПринтера"/>
	</objectType>
	<objectType name="scanner_settings">
		<property name="use_hardware_scanner" type="xs:boolean" localName="АппаратныйСканерИспользовать"/>
	</objectType>
	<objectType name="scanner_params">
		<property name="IntentScanner" type="xs:boolean" localName="АппаратныйСканерИспользованиеКомандИнтентов"/>
		<property name="IntentScannerMessage" type="xs:string" localName="АппаратныйСканерIntentScannerMessage"/>
		<property name="IntentScannerVariable" type="xs:string" localName="АппаратныйСканерIntentScannerVariable"/>
		<property name="IntentScannerLength" type="xs:string" localName="АппаратныйСканерIntentScannerLength"/>
	</objectType>
	<objectType name="series_settings">
		<property name="control_of_unique_series" type="xs:boolean" localName="КонтрольУникальностиСерий"/>
		<property name="del_series_without_confirmation" type="xs:boolean" localName="УдалятьСерииБезПредупреждения"/>
		<property name="del_approve_dialog" type="xs:boolean" localName="ПодтверждениеПриУдаленииДубля"/>
		<property name="enable_mass_scan" type="xs:boolean" localName="МассовоеСканированиеВСериях"/>
		<property name="delimiters_list" type="xs:string" default=" ,.;\n\r" localName="СимволыРазелители"/>
		<property name="enable_break_as_delimiters" type="xs:boolean" default="true" localName="ИспользоватьПереносСтрокиКакРазделитель"/>
		<property name="char_count_range_min" type="xs:int" default="1" localName="МинимальнаяДлинаСимволовШтрихкода"/>
		<property name="char_count_range_max" type="xs:int" default="5" localName="МаксимальнаяДлинаСимволовШтрихкода"/>
	</objectType>
</package>