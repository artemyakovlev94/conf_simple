#Область ЗагрузкаДокументаОбменаВДокументОснование

Функция ТаблицаДокументаОбменаСНомеромСтрокДокументаОснования(ДокументОбмена, Таблица, НастройкаТаблицы, ОснованаяСхемаКомпоновки)
	
	Если Таблица = Перечисления.SUI_ТипыТаблицДокументовОбмена.Товары Или
		Таблица = Перечисления.SUI_ТипыТаблицДокументовОбмена.Отбор Или
		Таблица = Перечисления.SUI_ТипыТаблицДокументовОбмена.Размещение Или
		Таблица = Перечисления.SUI_ТипыТаблицДокументовОбмена.ПотокШтрихкодов Тогда
		Запрос = ЗапросКТаблицеДокументаОбмена_Товары(ДокументОбмена, Таблица);
	ИначеЕсли Таблица = Перечисления.SUI_ТипыТаблицДокументовОбмена.Серии Тогда
		Запрос = ЗапросКТаблицеДокументаОбмена_Серии(ДокументОбмена);
	ИначеЕсли Таблица = Перечисления.SUI_ТипыТаблицДокументовОбмена.ШтрихкодыУпаковок Тогда
		Запрос = ЗапросКТаблицеДокументаОбмена_ШтрихкодыУпаковок(ДокументОбмена);
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	ПараметрыРезультатКомпоновки = SUI_КомпоновкаДанныхСервер.ПараметрыРезультатСхемыКомпоновкиДанных();
	ПараметрыРезультатКомпоновки.СхемаКомпоновкиДанных = SUI_КомпоновкаДанныхСервер.СкопироватьСхемуКомпоновкиДанных(ОснованаяСхемаКомпоновки);
	ПараметрыРезультатКомпоновки.ВозможностьИспользованияВнешнихФункций = Истина;
	ПараметрыРезультатКомпоновки.ВыполнятьВПривилегированномРежиме = Истина;
	
	// Номер строки
	SUI_КомпоновкаДанныхКлиентСервер.ДобавитьВыбранноеПоле(
		ПараметрыРезультатКомпоновки.СхемаКомпоновкиДанных.НастройкиПоУмолчанию, 
		НастройкаТаблицы.ИмяТабличнойЧасти + ".НомерСтроки", "НомерСтроки");
	
	// Ключ связи
	РеквизитыИдентификацииСтрок = НастройкаТаблицы.ИмяТабличнойЧасти + "." 
		+ СтрСоединить(НастройкаТаблицы.РеквизитыИдентификации, "," + НастройкаТаблицы.ИмяТабличнойЧасти + ".");
	ВП_ИдентификацияСтрок = SUI_КомпоновкаДанныхСервер.ДобавитьВычисляемоеПоле(ПараметрыРезультатКомпоновки.СхемаКомпоновкиДанных, 
		"SUI_КлючСвязи", 
		"Документы.SUI_ДокументОбмена.ВычислитьКлючСвязи(" + РеквизитыИдентификацииСтрок + ")", 
		"КлючСвязи");
	ВП_ИдентификацияСтрок.ТипЗначения = ОбщегоНазначения.ОписаниеТипаСтрока(64);
	SUI_КомпоновкаДанныхКлиентСервер.ДобавитьВыбранноеПоле(ПараметрыРезультатКомпоновки.СхемаКомпоновкиДанных.НастройкиПоУмолчанию, 
		ВП_ИдентификацияСтрок.ПутьКДанным, ВП_ИдентификацияСтрок.Заголовок);
	
	Запрос.УстановитьПараметр("Приемник", ВыгрузитьРезультатСхемыКомпоновкиДанных(ПараметрыРезультатКомпоновки));
	
	Возврат Запрос.Выполнить();
	
КонецФункции

Функция ЗапросКТаблицеДокументаОбмена_Товары(ДокументОбмена, ТипТаблицы)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Источник", ДокументОбмена);
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Приемник.НомерСтроки,
		|	ВЫРАЗИТЬ(Приемник.КлючСвязи КАК СТРОКА(64)) КАК КлючСвязи
		|ПОМЕСТИТЬ втПриемник
		|ИЗ
		|	&Приемник КАК Приемник
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	КлючСвязи
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Источник.НомерСтроки,
		|	ЕСТЬNULL(втПриемник.НомерСтроки, 0) КАК НомерСтрокиПриемник,
		|	Источник.ИдентификаторСтроки,
		|	Источник.КлючСвязи,
		|	Источник.Номенклатура,
		|	Источник.Характеристика,
		|	Источник.Упаковка,
		|	Источник.КоличествоФакт,
		|	&ДополнительныеПоля
		|ИЗ
		|	Документ.SUI_ДокументОбмена.Товары КАК Источник
		|		ЛЕВОЕ СОЕДИНЕНИЕ втПриемник КАК втПриемник
		|		ПО Источник.КлючСвязи = втПриемник.КлючСвязи
		|ГДЕ
		|	Источник.Ссылка = &Источник
		|	И Источник.СтатусОбработки = ЗНАЧЕНИЕ(Перечисление.SUI_СтатусыОбработкиСтрок.ОбработкаНеТребуется)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ втПриемник";
	
	ДополнительныеПоля = Новый Массив();
	
	Если ТипТаблицы = Перечисления.SUI_ТипыТаблицДокументовОбмена.Товары Тогда
		ДополнительныеПоля.Добавить("Источник.ВидЦены");
		ДополнительныеПоля.Добавить("Источник.Цена");
		ДополнительныеПоля.Добавить("Источник.СтатусУказанияСерии");
		ДополнительныеПоля.Добавить("Источник.ПризнакМаркировки");
		ДополнительныеПоля.Добавить("Источник.КоличествоПлан");
	ИначеЕсли ТипТаблицы = Перечисления.SUI_ТипыТаблицДокументовОбмена.Отбор Или
		ТипТаблицы = Перечисления.SUI_ТипыТаблицДокументовОбмена.Размещение Тогда
		ДополнительныеПоля.Добавить("Источник.Ячейка");
		ДополнительныеПоля.Добавить("Источник.СтатусУказанияСерии");
		ДополнительныеПоля.Добавить("Источник.ПризнакМаркировки");
		ДополнительныеПоля.Добавить("Источник.КоличествоПлан");
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДополнительныеПоля", СтрСоединить(ДополнительныеПоля, "," + Символы.ПС));
	
	Возврат Запрос;
	
КонецФункции

