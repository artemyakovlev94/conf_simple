Функция СопоставитьДанныеСтрокиКЗагрузке(ДанныеИзВыборки, СоответствияРеквизитовПриемника, Знач ИсключаемыеРеквизиты = "")
	
	СопоставленныеДанные = Новый Структура();
	
	ИсключаемыеРеквизиты = СтрРазделить(ИсключаемыеРеквизиты, ",", Ложь);
	
	Для Каждого СоответствиеРеквизитаПриемника Из СоответствияРеквизитовПриемника Цикл
		
		Если ИсключаемыеРеквизиты.Найти(СоответствиеРеквизитаПриемника.Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если ДанныеИзВыборки.Свойство(СоответствиеРеквизитаПриемника.Ключ) Тогда
			СопоставленныеДанные.Вставить(СоответствиеРеквизитаПриемника.Значение, ДанныеИзВыборки[СоответствиеРеквизитаПриемника.Ключ]);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СопоставленныеДанные;
	
КонецФункции

Функция ВычислитьКлючСвязиПриОбработкеСтроки(СтрокаТабличнойЧасти, РеквизитыИдентификации)
	
	УстановитьБезопасныйРежим(Истина);
	
	SUI_ОбщегоНазначения.ПередВыполнениемПроизвольногоАлгоритма();
	
	ПараметрыКВычислению = Новый Массив();
	Для Индекс = 0 По РеквизитыИдентификации.ВГраница() Цикл 
		ПараметрыКВычислению.Добавить("СтрокаТабличнойЧасти[РеквизитыИдентификации[" + XMLСтрока(Индекс) + "]]");
	КонецЦикла;
	
	Возврат Вычислить(СтрШаблон("Документы.SUI_ДокументОбмена.ВычислитьКлючСвязи(%1)", СтрСоединить(ПараметрыКВычислению, ",")));
	
КонецФункции

