КонецПроцедуры

Функция ЗаписатьДокументОснование(ДокументОснованиеОбъект, НастройкаДокумента, Знач ДополнительныеПараметры = Неопределено) Экспорт
	
	Результат = Новый Структура();
	Результат.Вставить("ДокументЗаписан", Ложь);
	Результат.Вставить("ДокументПроведен", Ложь);
	
	Отказ = Ложь;
	
	ПараметрыЗаписи = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(НастройкаДокумента, "ПроводитьДокумент,
	|АлгоритмПередЗаписью,АлгоритмПослеЗаписи");
	
	ОписаниеТипаСтруктура = Новый ОписаниеТипов("Структура");
	ДополнительныеПараметры = ОписаниеТипаСтруктура.ПривестиЗначение(ДополнительныеПараметры);
	
	Если ДополнительныеПараметры.Свойство("ПроводитьДокумент") Тогда
		ПараметрыЗаписи.ПроводитьДокумент = ДополнительныеПараметры.ПроводитьДокумент;
	КонецЕсли;
	
	Если ДополнительныеПараметры.Свойство("АлгоритмПередЗаписью") Тогда
		ПараметрыЗаписи.АлгоритмПередЗаписью = ДополнительныеПараметры.АлгоритмПередЗаписью;
	КонецЕсли;
	
	Если ДополнительныеПараметры.Свойство("АлгоритмПослеЗаписи") Тогда
		ПараметрыЗаписи.АлгоритмПослеЗаписи = ДополнительныеПараметры.АлгоритмПослеЗаписи;
	КонецЕсли;
	
	// Алгоритм перед записью
	Если Не ДополнительныеПараметры.Свойство("НеВыполнятьАлгоритмПередЗаписью") Тогда
		
		ПараметрыАлгоритма = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДокументОснованиеОбъект);
		
		ПараметрыАлгоритма = Обработки.SUI_РедакторКода.ВыполнитьКодЧерезМетодКонфигурации(
			"Документы.SUI_ДокументОбмена.ВыполнитьАлгоритмПередЗаписью", 
			ПараметрыЗаписи.АлгоритмПередЗаписью, 
			ПараметрыАлгоритма, 
			Истина);
		
		ДокументОснованиеОбъект = ПараметрыАлгоритма[ПараметрыАлгоритма.ВГраница()];
		
	КонецЕсли;
	
	Если Не ДополнительныеПараметры.Свойство("ОтключитьПроверкуЗаполнения") И Не ДокументОснованиеОбъект.ПроверитьЗаполнение() Тогда
		Отказ = Истина;
	КонецЕсли;
	
	Если Не Отказ Тогда
		
		// Режим записи
		РежимЗаписи = РежимЗаписиДокумента.Запись;
		Если ПараметрыЗаписи.ПроводитьДокумент И ДокументОснованиеОбъект.ПометкаУдаления Тогда
			ОбщегоНазначения.СообщитьПользователю(
				НСтр("ru = 'Документ основание помечен на удаление, проведение документа невозможно.'"));
		ИначеЕсли ПараметрыЗаписи.ПроводитьДокумент Тогда
			РежимЗаписи = РежимЗаписиДокумента.Проведение;
		КонецЕсли;
		
		// Установка дополнительных свойств
		Если ДополнительныеПараметры.Свойство("ДополнительныеСвойства") Тогда
			
			Для Каждого ДополнительноеСвойство Из ДополнительныеПараметры.ДополнительныеСвойства Цикл
				ДокументОснованиеОбъект.ДополнительныеСвойства.Вставить(ДополнительноеСвойство.Ключ, ДополнительноеСвойство.Значение);
			КонецЦикла;
			
		КонецЕсли;
		
		Если ДополнительныеПараметры.Свойство("ОтключитьРегистрацию") Тогда
			ДокументОснованиеОбъект.ДополнительныеСвойства.Вставить("ОтключитьМеханизмРегистрацииОбъектов");
		КонецЕсли;
		
		Если ДополнительныеПараметры.Свойство("ОтключитьСобытияSimple") Тогда
			ДокументОснованиеОбъект.ДополнительныеСвойства.Вставить("ОтключитьСобытияSimple");
		КонецЕсли;
		
		Если Не ДополнительныеПараметры.Свойство("ОтключитьРежимЗагрузки") Тогда
			ДокументОснованиеОбъект.ОбменДанными.Загрузка = Истина;
		КонецЕсли;
		
		// Запись документа
		ДокументОснованиеОбъект.Записать(РежимЗаписи);
		
		Результат.ДокументЗаписан = Истина;
		Результат.ДокументПроведен = (РежимЗаписи = РежимЗаписиДокумента.Проведение);
		
		// Алгоритм После записи
		Если Не ДополнительныеПараметры.Свойство("НеВыполнятьАлгоритмПослеЗаписи") Тогда
			
			ПараметрыАлгоритма = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДокументОснованиеОбъект);
			
			ПараметрыАлгоритма = Обработки.SUI_РедакторКода.ВыполнитьКодЧерезМетодКонфигурации(
				"Документы.SUI_ДокументОбмена.ВыполнитьАлгоритмПослеЗаписи", 
				ПараметрыЗаписи.АлгоритмПередЗаписью, 
				ПараметрыАлгоритма, 
				Истина);
			
			ДокументОснованиеОбъект = ПараметрыАлгоритма[ПараметрыАлгоритма.ВГраница()];
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСтрокиКОбработке(ТабличнаяЧасть, Знач СтатусыКОбработке = Неопределено) Экспорт
	
	ОтборСтрок = Новый Структура();
	ОтборСтрок.Вставить("СтатусОбработки", Перечисления.SUI_СтатусыОбработкиСтрок.ТребуетсяОбработка);
	
	СтрокиКОбработке = ТабличнаяЧасть.НайтиСтроки(ОтборСтрок);
	
	Если СтатусыКОбработке <> Неопределено Тогда
		
		СтатусыКОбработке = ОбщегоНазначенияКлиентСервер.РазностьМассивов(СтатусыКОбработке,
			ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ОтборСтрок.СтатусОбработки));
		
		Для индекс = 0 По СтатусыКОбработке.ВГраница() Цикл
			ОтборСтрок.СтатусОбработки = СтатусыКОбработке[индекс];
			СтрокиКОбработкеПоСтатусу = ТабличнаяЧасть.НайтиСтроки(ОтборСтрок);
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(СтрокиКОбработке, СтрокиКОбработкеПоСтатусу, Истина);
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат СтрокиКОбработке;
	
КонецФункции

Процедура ОбработатьСтрокиШтрихкодовУпаковок(СтрокиКОбработке, СтрокиОбработаны = Ложь) Экспорт
	
	Если СтрокиКОбработке.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	НастройкаШтрихкодыУпаковок = SUI_НастройкиМетаданныхСервер.ПолучитьДополнительныеНастройки(
		Перечисления.SUI_ТаблицыИнтеграции.ШтрихкодыУпаковок);
	
	ТипАлгоритмаНормализации = SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(НастройкаШтрихкодыУпаковок, 
		"АлгоритмНормализацииЗначенияШтрихкода.Тип", Перечисления.SUI_ТипыАлгоритмов.ПустаяСсылка(), Тип("ПеречислениеСсылка.SUI_ТипыАлгоритмов"));
	АлгоритмНормализации = SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(НастройкаШтрихкодыУпаковок, 
		"АлгоритмНормализацииЗначенияШтрихкода.Алгоритм", "", Тип("Строка"));
	АлгоритмСоздания = SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(НастройкаШтрихкодыУпаковок, 
		"АлгоритмСозданияШтрихкодаУпаковки.Алгоритм", "", Тип("Строка"));
	
	Ошибки = Новый Массив();
	
	//TODO: 22.08.2024 - artem - Добавить проверку на включение ФО
	
	Если ТипАлгоритмаНормализации.Пустая() Тогда
		Ошибки.Добавить(НСтр("ru = 'Не удалось определить тип алгоритма нормализации значения штрихкода.'"));
	КонецЕсли;
	
	Если ПустаяСтрока(АлгоритмНормализации) И ТипАлгоритмаНормализации = Перечисления.SUI_ТипыАлгоритмов.Произвольный Тогда
		Ошибки.Добавить(НСтр("ru = 'Не заполнен алгоритм нормализации значения штрихкода упаковки.'"));
	КонецЕсли;
	
	Если ПустаяСтрока(АлгоритмСоздания) Тогда
		Ошибки.Добавить(НСтр("ru = 'Не заполнен алгоритм создания штрихкода упаковки.'"));
	КонецЕсли;
	
	Если Ошибки.Количество() > 0 Тогда
		ОбщегоНазначения.СообщитьПользователю(СтрШаблон(НСтр("ru = 'Обработка штрихкодов упаковок документа обмена не выполнена.
		|%1'"), СтрСоединить(Ошибки, Символы.ПС)));
		Возврат;
	КонецЕсли;
	
	КлючиДанных = "Номенклатура,Характеристика,Упаковка,ШтрихкодУпаковки,ЗначениеШтрихкода";
	
	Для индекс = 0 По СтрокиКОбработке.ВГраница() Цикл
		
		Если СтрокиКОбработке[индекс].СтатусОбработки = Перечисления.SUI_СтатусыОбработкиСтрок.ОбработкаНеТребуется Тогда
			Продолжить;
		КонецЕсли;
		
		Данные = Новый Структура(КлючиДанных);
		ЗаполнитьЗначенияСвойств(Данные, СтрокиКОбработке[индекс]);
		
		Данные.ЗначениеШтрихкода = SUI_ШтрихкодыУпаковок.НормализоватьЗначениеШтрихкода(ТипАлгоритмаНормализации,
			АлгоритмНормализации, Данные.ЗначениеШтрихкода);
		
		Если ЗначениеЗаполнено(Данные.ЗначениеШтрихкода) Тогда
			
			SUI_ИнтеграцияВКонфигурацию.ВосстановитьСсылкиИдентификаторовSimple(Данные, "ЗначениеШтрихкода");
			
			ПараметрыАлгоритма = Новый Массив();
			ПараметрыАлгоритма.Добавить(Данные.ШтрихкодУпаковки);
			ПараметрыАлгоритма.Добавить(Данные.Номенклатура);
			ПараметрыАлгоритма.Добавить(Данные.Характеристика);
			ПараметрыАлгоритма.Добавить(Данные.Упаковка);
			ПараметрыАлгоритма.Добавить(Данные.ЗначениеШтрихкода);
			
			ПараметрыАлгоритма = Обработки.SUI_РедакторКода.ВыполнитьКодЧерезМетодКонфигурации(
				"SUI_ШтрихкодыУпаковок.СоздатьШтрихкодУпаковкиПоАлгоритму", АлгоритмСоздания, ПараметрыАлгоритма);
			
			Данные.ШтрихкодУпаковки = SUI_ИнтеграцияВКонфигурацию.ИдентификаторSimpleПоСсылке(ПараметрыАлгоритма[0]);
			
			Если ЗначениеЗаполнено(Данные.ШтрихкодУпаковки) Тогда
				СтрокиКОбработке[индекс].ШтрихкодУпаковки = Данные.ШтрихкодУпаковки;
				СтрокиКОбработке[индекс].ЗначениеШтрихкода = Данные.ЗначениеШтрихкода;
				СтрокиКОбработке[индекс].СтатусОбработки = Перечисления.SUI_СтатусыОбработкиСтрок.ОбработкаНеТребуется;
			Иначе
				СтрокиКОбработке[индекс].СтатусОбработки = Перечисления.SUI_СтатусыОбработкиСтрок.ОбработкаНеВыполнена;
				ОбщегоНазначения.СообщитьПользователю(
					СтрШаблон(НСтр("ru = 'Для строки %1 не определен штрихкод упаковки по алгоритму'"), СтрокиКОбработке[индекс].НомерСтроки),,
					"Объект.ШтрихкодыУпаковок");
			КонецЕсли;
			
		Иначе
			СтрокиКОбработке[индекс].СтатусОбработки = Перечисления.SUI_СтатусыОбработкиСтрок.ОбработкаНеВыполнена;
			ОбщегоНазначения.СообщитьПользователю(
				СтрШаблон(НСтр("ru = 'В строке %1 не удалось нормализовать значение штрихкода'"), СтрокиКОбработке[индекс].НомерСтроки),,
				"Объект.ШтрихкодыУпаковок");
		КонецЕсли;
		
		СтрокиОбработаны = Истина;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработатьСтрокиСерий(СтрокиКОбработке, СтрокиОбработаны = Ложь) Экспорт
	
	Если СтрокиКОбработке.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	АлгоритмСоздания = SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(
		SUI_НастройкиМетаданныхСервер.ПолучитьДополнительныеНастройки(Перечисления.SUI_ТаблицыИнтеграции.СерииНоменклатуры), 
		"АлгоритмСозданияСерииНоменклатуры.Алгоритм", "", Тип("Строка"));
	
	Ошибки = Новый Массив();
	
	Если ПустаяСтрока(АлгоритмСоздания) Тогда
		Ошибки.Добавить(НСтр("ru = 'Не заполнен алгоритм создания серии номенклатуры.'"));
	КонецЕсли;
	
	//TODO: 22.08.2024 - artem - Добавить проверку на включение ФО
	
	Если Ошибки.Количество() > 0 Тогда
		ОбщегоНазначения.СообщитьПользователю(СтрШаблон(НСтр("ru = 'Обработка серий документа обмена не выполнена.
		|%1'"), СтрСоединить(Ошибки, Символы.ПС)));
		Возврат;
	КонецЕсли;
	
	КлючиДанных = "Серия,Номенклатура,Характеристика,Наименование,Номер,ДатаПроизводства,ГоденДо,КоличествоФакт";
	
	Для индекс = 0 По СтрокиКОбработке.ВГраница() Цикл
		
		Если СтрокиКОбработке[индекс].СтатусОбработки = Перечисления.SUI_СтатусыОбработкиСтрок.ОбработкаНеТребуется Тогда
			Продолжить;
		КонецЕсли;
		
		Данные = Новый Структура(КлючиДанных);
		ЗаполнитьЗначенияСвойств(Данные, СтрокиКОбработке[индекс]);
		
		SUI_ИнтеграцияВКонфигурацию.ВосстановитьСсылкиИдентификаторовSimple(Данные, "Наименование,Номер,ДатаПроизводства,ГоденДо,КоличествоФакт");
		
		ПараметрыАлгоритма = Новый Массив();
		ПараметрыАлгоритма.Добавить(Данные.Серия);
		ПараметрыАлгоритма.Добавить(Данные.Номенклатура);
		ПараметрыАлгоритма.Добавить(Данные.Характеристика);
		ПараметрыАлгоритма.Добавить(Данные.Наименование);
		ПараметрыАлгоритма.Добавить(Данные.Номер);
		ПараметрыАлгоритма.Добавить(Данные.ДатаПроизводства);
		ПараметрыАлгоритма.Добавить(Данные.ГоденДо);
		ПараметрыАлгоритма.Добавить(Данные.КоличествоФакт);
		
		ПараметрыАлгоритма = Обработки.SUI_РедакторКода.ВыполнитьКодЧерезМетодКонфигурации(
			"SUI_СерииНоменклатуры.СоздатьСерииНоменклатурыПоАлгоритму", АлгоритмСоздания, ПараметрыАлгоритма);
		
		Данные.Серия = SUI_ИнтеграцияВКонфигурацию.ИдентификаторSimpleПоСсылке(ПараметрыАлгоритма[0]);
		
		Если ЗначениеЗаполнено(Данные.Серия) Тогда
			СтрокиКОбработке[индекс].Серия = Данные.Серия;
			СтрокиКОбработке[индекс].СтатусОбработки = Перечисления.SUI_СтатусыОбработкиСтрок.ОбработкаНеТребуется;
		Иначе
			СтрокиКОбработке[индекс].СтатусОбработки = Перечисления.SUI_СтатусыОбработкиСтрок.ОбработкаНеВыполнена;
			ОбщегоНазначения.СообщитьПользователю(
				СтрШаблон(НСтр("ru = 'Для строки %1 не определена серия по алгоритму'"), СтрокиКОбработке[индекс].НомерСтроки),,
				"Объект.Серии");
		КонецЕсли;
		
		СтрокиОбработаны = Истина;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьИнформациюВДеревоПроверки(Дерево, ИнформацияРодитель, Информация, ИндексКартинки)
	
	СтрокаРодитель = Дерево.Строки.Найти(ИнформацияРодитель, "Информация", Ложь);
	
	Если СтрокаРодитель = Неопределено Тогда
		
		СтрокаРодитель = Дерево.Строки.Добавить();
		СтрокаРодитель.Информация = ИнформацияРодитель;
		
	КонецЕсли;
	
	Если ПустаяСтрока(Информация) Тогда
		СтрокаРодитель.ИндексКартинки = ИндексКартинки;
	Иначе
		СтрокаРодитель.ИндексКартинки = 9;
		ПодчиненнаяСтрока = СтрокаРодитель.Строки.Добавить();
		ПодчиненнаяСтрока.Информация = Информация;
		ПодчиненнаяСтрока.ИндексКартинки = ИндексКартинки;
	КонецЕсли;
	
КонецПроцедуры

