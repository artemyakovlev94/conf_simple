<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>ИсточникДанных1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>НаборДанных1</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>timestamp</dataPath>
			<field>timestamp</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>date</dataPath>
			<field>date</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>session_number</dataPath>
			<field>session_number</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>sid</dataPath>
			<field>sid</field>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>method</dataPath>
			<field>method</field>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>id_device</dataPath>
			<field>id_device</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>app_version</dataPath>
			<field>app_version</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>base_URL</dataPath>
			<field>base_URL</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>relative_URL</dataPath>
			<field>relative_URL</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>status_code</dataPath>
			<field>status_code</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>request</dataPath>
			<field>request</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>response</dataPath>
			<field>response</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>id_user</dataPath>
			<field>id_user</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>user</dataPath>
			<field>user</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	SUI_ЛогированиеHTTPЗапросов.МеткаВремени КАК timestamp,
	SUI_ЛогированиеHTTPЗапросов.Период КАК date,
	SUI_ЛогированиеHTTPЗапросов.НомерСеанса КАК session_number,
	SUI_ЛогированиеHTTPЗапросов.SID КАК sid,
	SUI_ЛогированиеHTTPЗапросов.Метод КАК method,
	SUI_ЛогированиеHTTPЗапросов.ИдентификаторУстройства КАК id_device,
	SUI_ЛогированиеHTTPЗапросов.ВерсияПриложения КАК app_version,
	SUI_ЛогированиеHTTPЗапросов.БазовыйURL КАК base_URL,
	SUI_ЛогированиеHTTPЗапросов.ОтносительныйURL КАК relative_URL,
	SUI_ЛогированиеHTTPЗапросов.КодСостояния КАК status_code,
	SUI_ЛогированиеHTTPЗапросов.ДанныеЗапроса КАК request,
	SUI_ЛогированиеHTTPЗапросов.ДанныеОтвета КАК response,
	SUI_ЛогированиеHTTPЗапросов.ИдентификаторПользователя КАК id_user,
	SUI_ЛогированиеHTTPЗапросов.ИмяПользователя КАК user
ИЗ
	РегистрСведений.SUI_ЛогированиеHTTPЗапросов КАК SUI_ЛогированиеHTTPЗапросов</query>
	</dataSet>
	<settingsVariant>
		<dcsset:name>Выгрузка</dcsset:name>
		<dcsset:presentation xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Выгрузка</v8:content>
			</v8:item>
		</dcsset:presentation>
		<dcsset:settings xmlns:style="http://v8.1c.ru/8.1/data/ui/style" xmlns:sys="http://v8.1c.ru/8.1/data/ui/fonts/system" xmlns:web="http://v8.1c.ru/8.1/data/ui/colors/web" xmlns:win="http://v8.1c.ru/8.1/data/ui/colors/windows">
			<dcsset:selection>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>timestamp</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>date</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>sid</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>method</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>status_code</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>base_URL</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>relative_URL</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>id_device</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>app_version</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>session_number</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>id_user</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>user</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>request</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>response</dcsset:field>
				</dcsset:item>
			</dcsset:selection>
			<dcsset:order>
				<dcsset:item xsi:type="dcsset:OrderItemField">
					<dcsset:field>timestamp</dcsset:field>
					<dcsset:orderType>Asc</dcsset:orderType>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:OrderItemField">
					<dcsset:field>date</dcsset:field>
					<dcsset:orderType>Asc</dcsset:orderType>
				</dcsset:item>
			</dcsset:order>
			<dcsset:item xsi:type="dcsset:StructureItemGroup">
				<dcsset:order>
					<dcsset:item xsi:type="dcsset:OrderItemAuto"/>
				</dcsset:order>
				<dcsset:selection>
					<dcsset:item xsi:type="dcsset:SelectedItemAuto"/>
				</dcsset:selection>
				<dcsset:conditionalAppearance>
					<dcsset:item>
						<dcsset:selection/>
						<dcsset:filter>
							<dcsset:item xsi:type="dcsset:FilterItemComparison">
								<dcsset:left xsi:type="dcscor:Field">status_code</dcsset:left>
								<dcsset:comparisonType>GreaterOrEqual</dcsset:comparisonType>
								<dcsset:right xsi:type="xs:decimal">400</dcsset:right>
							</dcsset:item>
						</dcsset:filter>
						<dcsset:appearance>
							<dcscor:item xsi:type="dcsset:SettingsParameterValue">
								<dcscor:parameter>ЦветТекста</dcscor:parameter>
								<dcscor:value xsi:type="v8ui:Color">style:SpecialTextColor</dcscor:value>
							</dcscor:item>
						</dcsset:appearance>
					</dcsset:item>
					<dcsset:item>
						<dcsset:selection/>
						<dcsset:filter>
							<dcsset:item xsi:type="dcsset:FilterItemGroup">
								<dcsset:groupType>AndGroup</dcsset:groupType>
								<dcsset:item xsi:type="dcsset:FilterItemComparison">
									<dcsset:left xsi:type="dcscor:Field">status_code</dcsset:left>
									<dcsset:comparisonType>GreaterOrEqual</dcsset:comparisonType>
									<dcsset:right xsi:type="xs:decimal">300</dcsset:right>
								</dcsset:item>
								<dcsset:item xsi:type="dcsset:FilterItemComparison">
									<dcsset:left xsi:type="dcscor:Field">status_code</dcsset:left>
									<dcsset:comparisonType>LessOrEqual</dcsset:comparisonType>
									<dcsset:right xsi:type="xs:decimal">399</dcsset:right>
								</dcsset:item>
							</dcsset:item>
						</dcsset:filter>
						<dcsset:appearance>
							<dcscor:item xsi:type="dcsset:SettingsParameterValue">
								<dcscor:parameter>ЦветТекста</dcscor:parameter>
								<dcscor:value xsi:type="v8ui:Color">style:FieldSelectionBackColor</dcscor:value>
							</dcscor:item>
						</dcsset:appearance>
					</dcsset:item>
				</dcsset:conditionalAppearance>
			</dcsset:item>
		</dcsset:settings>
	</settingsVariant>
</DataCompositionSchema>