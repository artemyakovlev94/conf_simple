    <name>Список</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	SUI_ЛогированиеHTTPЗапросов.Период,
	SUI_ЛогированиеHTTPЗапросов.SID,
	SUI_ЛогированиеHTTPЗапросов.Метод,
	SUI_ЛогированиеHTTPЗапросов.БазовыйURL,
	SUI_ЛогированиеHTTPЗапросов.ОтносительныйURL,
	SUI_ЛогированиеHTTPЗапросов.БазовыйURL + SUI_ЛогированиеHTTPЗапросов.ОтносительныйURL КАК URL,
	SUI_ЛогированиеHTTPЗапросов.КодСостояния,
	SUI_ЛогированиеHTTPЗапросов.ДанныеЗапроса,
	SUI_ЛогированиеHTTPЗапросов.ДанныеОтвета,
	SUI_ЛогированиеHTTPЗапросов.ОтветКоманда,
	SUI_ЛогированиеHTTPЗапросов.ОтветЖдать,
	SUI_ЛогированиеHTTPЗапросов.ОтветЕстьДанные,
	SUI_ЛогированиеHTTPЗапросов.ОтветНетДанных,
	ВЫБОР
		КОГДА SUI_ЛогированиеHTTPЗапросов.ОтветЖдать
			ТОГДА 0
		КОГДА SUI_ЛогированиеHTTPЗапросов.ОтветКоманда
			ТОГДА 2
		КОГДА SUI_ЛогированиеHTTPЗапросов.ОтветЕстьДанные
			ТОГДА 3
		ИНАЧЕ 99
	КОНЕЦ КАК ИндексКартинки,
	SUI_ЛогированиеHTTPЗапросов.ИдентификаторУстройства,
	SUI_ЛогированиеHTTPЗапросов.ВерсияПриложения,
	SUI_ЛогированиеHTTPЗапросов.НомерСеанса,
	SUI_ЛогированиеHTTPЗапросов.МеткаВремени,
	SUI_ЛогированиеHTTPЗапросов.ИдентификаторПользователя,
	ЕСТЬNULL(SUI_МобильныеУстройства.Ссылка, ЗНАЧЕНИЕ(ПланОбмена.SUI_МобильныеУстройства.ПустаяСсылка)) КАК
		МобильноеУстройство,
	SUI_ЛогированиеHTTPЗапросов.ИмяПользователя
ИЗ
	РегистрСведений.SUI_ЛогированиеHTTPЗапросов КАК SUI_ЛогированиеHTTPЗапросов
		ЛЕВОЕ СОЕДИНЕНИЕ ПланОбмена.SUI_МобильныеУстройства КАК SUI_МобильныеУстройства
		ПО SUI_ЛогированиеHTTPЗапросов.ИдентификаторУстройства = SUI_МобильныеУстройства.Код</queryText>
      <mainTable>InformationRegister.SUI_ЛогированиеHTTPЗапросов</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
