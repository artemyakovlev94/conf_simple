    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	SUI_СообщенияМобильныхУстройств.ID,
	SUI_СообщенияМобильныхУстройств.Отправитель,
	SUI_СообщенияМобильныхУстройств.Получатель,
	SUI_СообщенияМобильныхУстройств.Сообщение,
	SUI_СообщенияМобильныхУстройств.МеткаВремени,
	SUI_СообщенияМобильныхУстройств.ДатаЗаписи,
	SUI_СообщенияМобильныхУстройствИзменения.ID ЕСТЬ NULL КАК Отправлено
ИЗ
	РегистрСведений.SUI_СообщенияМобильныхУстройств КАК SUI_СообщенияМобильныхУстройств
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.SUI_СообщенияМобильныхУстройств.Изменения КАК
			SUI_СообщенияМобильныхУстройствИзменения
		ПО SUI_СообщенияМобильныхУстройств.ID = SUI_СообщенияМобильныхУстройствИзменения.ID
		И SUI_СообщенияМобильныхУстройств.Отправитель = SUI_СообщенияМобильныхУстройствИзменения.Отправитель
		И SUI_СообщенияМобильныхУстройств.Получатель = SUI_СообщенияМобильныхУстройствИзменения.Получатель</queryText>
      <mainTable>InformationRegister.SUI_СообщенияМобильныхУстройств</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
