<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>ИсточникДанных1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>НаборДанных1</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>Штрихкод</dataPath>
			<field>Штрихкод</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Штрихкод</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Количество</dataPath>
			<field>Количество</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Количество</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>id_good</dataPath>
			<field>id_good</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Id good</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>id_property</dataPath>
			<field>id_property</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Id property</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>id_unit</dataPath>
			<field>id_unit</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Id unit</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>barcode</dataPath>
			<field>barcode</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>НомерЗаписи</dataPath>
			<field>НомерЗаписи</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Номер записи</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>sid</dataPath>
			<field>sid</field>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Сопоставлено</dataPath>
			<field>Сопоставлено</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Сопоставлено</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ПотокШтрихкодов.sid КАК sid,
	ПотокШтрихкодов.barcode КАК barcode,
	1 КАК Количество
ПОМЕСТИТЬ втПотокШтрихкодов
ИЗ
	РегистрСведений.SUI_docs_tbl_barcode_flow КАК ПотокШтрихкодов
ГДЕ
	НЕ ПотокШтрихкодов.ЭтоШтрихкодSSCC
	И НЕ ПотокШтрихкодов.ЭтоШтрихкодКМ
{ГДЕ
	(ПотокШтрихкодов.sid_doc = &amp;sid_doc)}
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗЛИЧНЫЕ
	АВТОНОМЕРЗАПИСИ() КАК НомерЗаписи,
	ШтрихкодыНоменклатуры.barcode КАК barcode,
	ШтрихкодыНоменклатуры.id_good КАК id_good,
	ШтрихкодыНоменклатуры.id_property КАК id_property,
	ШтрихкодыНоменклатуры.id_unit КАК id_unit
ПОМЕСТИТЬ втШтрихкодыВБазе
ИЗ
	втПотокШтрихкодов КАК втПотокШтрихкодов
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.SUI_tbl_barcodes КАК ШтрихкодыНоменклатуры
		ПО втПотокШтрихкодов.barcode = ШтрихкодыНоменклатуры.barcode
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	втПотокШтрихкодов.sid КАК sid,
	втПотокШтрихкодов.barcode КАК Штрихкод,
	втПотокШтрихкодов.Количество КАК Количество,
	ЕСТЬNULL(втШтрихкодыВБазе.id_good, "") КАК id_good,
	ЕСТЬNULL(втШтрихкодыВБазе.id_property, "") КАК id_property,
	ЕСТЬNULL(втШтрихкодыВБазе.id_unit, "") КАК id_unit,
	НЕ втШтрихкодыВБазе.barcode ЕСТЬ NULL КАК Сопоставлено
ИЗ
	втПотокШтрихкодов КАК втПотокШтрихкодов
		ЛЕВОЕ СОЕДИНЕНИЕ втШтрихкодыВБазе КАК втШтрихкодыВБазе
			ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
				втШтрихкодыВБазе.barcode КАК barcode,
				МАКСИМУМ(втШтрихкодыВБазе.НомерЗаписи) КАК НомерЗаписи
			ИЗ
				втШтрихкодыВБазе КАК втШтрихкодыВБазе
			
			СГРУППИРОВАТЬ ПО
				втШтрихкодыВБазе.barcode) КАК ШтрихкодыВБазеМаксНомерЗаписи
			ПО втШтрихкодыВБазе.НомерЗаписи = ШтрихкодыВБазеМаксНомерЗаписи.НомерЗаписи
		ПО втПотокШтрихкодов.barcode = втШтрихкодыВБазе.barcode
;

////////////////////////////////////////////////////////////////////////////////
УНИЧТОЖИТЬ втПотокШтрихкодов
;

////////////////////////////////////////////////////////////////////////////////
УНИЧТОЖИТЬ втШтрихкодыВБазе</query>
	</dataSet>
	<calculatedField>
		<dataPath>Номенклатура</dataPath>
		<expression>SUI_ИнтеграцияВКонфигурацию.СсылкаПоИдентификаторуSimple(id_good)</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Номенклатура</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<calculatedField>
		<dataPath>Характеристика</dataPath>
		<expression>SUI_ИнтеграцияВКонфигурацию.СсылкаПоИдентификаторуSimple(id_property)</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Характеристика</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<calculatedField>
		<dataPath>Упаковка</dataPath>
		<expression>SUI_ИнтеграцияВКонфигурацию.СсылкаПоИдентификаторуSimple(id_unit)</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Упаковка</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<parameter>
		<name>sid_doc</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>SID документа обмена</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:string</v8:Type>
			<v8:StringQualifiers>
				<v8:Length>36</v8:Length>
				<v8:AllowedLength>Variable</v8:AllowedLength>
			</v8:StringQualifiers>
		</valueType>
		<value xsi:type="xs:string"/>
		<useRestriction>false</useRestriction>
	</parameter>
	<settingsVariant>
		<dcsset:name>Основной</dcsset:name>
		<dcsset:presentation xsi:type="xs:string">Основной</dcsset:presentation>
		<dcsset:settings xmlns:style="http://v8.1c.ru/8.1/data/ui/style" xmlns:sys="http://v8.1c.ru/8.1/data/ui/fonts/system" xmlns:web="http://v8.1c.ru/8.1/data/ui/colors/web" xmlns:win="http://v8.1c.ru/8.1/data/ui/colors/windows">
			<dcsset:userFields>
				<dcsset:item xsi:type="dcsset:UserFieldCase">
					<dcsset:dataPath>ПользовательскиеПоля.Поле1</dcsset:dataPath>
					<dcsset:lwsTitle>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>НеобходимоОбработать</v8:content>
						</v8:item>
					</dcsset:lwsTitle>
					<dcsset:cases>
						<dcsset:item>
							<dcsset:filter>
								<dcsset:item xsi:type="dcsset:FilterItemGroup">
									<dcsset:groupType>OrGroup</dcsset:groupType>
									<dcsset:item xsi:type="dcsset:FilterItemGroup">
										<dcsset:groupType>AndGroup</dcsset:groupType>
										<dcsset:item xsi:type="dcsset:FilterItemComparison">
											<dcsset:left xsi:type="dcscor:Field">Номенклатура</dcsset:left>
											<dcsset:comparisonType>NotFilled</dcsset:comparisonType>
										</dcsset:item>
										<dcsset:item xsi:type="dcsset:FilterItemComparison">
											<dcsset:left xsi:type="dcscor:Field">id_good</dcsset:left>
											<dcsset:comparisonType>Filled</dcsset:comparisonType>
										</dcsset:item>
									</dcsset:item>
									<dcsset:item xsi:type="dcsset:FilterItemGroup">
										<dcsset:groupType>AndGroup</dcsset:groupType>
										<dcsset:item xsi:type="dcsset:FilterItemComparison">
											<dcsset:left xsi:type="dcscor:Field">Характеристика</dcsset:left>
											<dcsset:comparisonType>NotFilled</dcsset:comparisonType>
										</dcsset:item>
										<dcsset:item xsi:type="dcsset:FilterItemComparison">
											<dcsset:left xsi:type="dcscor:Field">id_property</dcsset:left>
											<dcsset:comparisonType>Filled</dcsset:comparisonType>
										</dcsset:item>
									</dcsset:item>
									<dcsset:item xsi:type="dcsset:FilterItemGroup">
										<dcsset:groupType>AndGroup</dcsset:groupType>
										<dcsset:item xsi:type="dcsset:FilterItemComparison">
											<dcsset:left xsi:type="dcscor:Field">Упаковка</dcsset:left>
											<dcsset:comparisonType>NotFilled</dcsset:comparisonType>
										</dcsset:item>
										<dcsset:item xsi:type="dcsset:FilterItemComparison">
											<dcsset:left xsi:type="dcscor:Field">id_unit</dcsset:left>
											<dcsset:comparisonType>Filled</dcsset:comparisonType>
										</dcsset:item>
									</dcsset:item>
									<dcsset:item xsi:type="dcsset:FilterItemComparison">
										<dcsset:left xsi:type="dcscor:Field">Сопоставлено</dcsset:left>
										<dcsset:comparisonType>Equal</dcsset:comparisonType>
										<dcsset:right xsi:type="xs:boolean">false</dcsset:right>
									</dcsset:item>
								</dcsset:item>
							</dcsset:filter>
							<dcsset:value xsi:type="xs:boolean">true</dcsset:value>
						</dcsset:item>
						<dcsset:item>
							<dcsset:filter/>
							<dcsset:value xsi:type="xs:boolean">false</dcsset:value>
						</dcsset:item>
					</dcsset:cases>
				</dcsset:item>
			</dcsset:userFields>
			<dcsset:selection>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>sid</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>Штрихкод</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>Количество</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>Номенклатура</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>Характеристика</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>Упаковка</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>Сопоставлено</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>ПользовательскиеПоля.Поле1</dcsset:field>
				</dcsset:item>
			</dcsset:selection>
			<dcsset:item xsi:type="dcsset:StructureItemGroup">
				<dcsset:order>
					<dcsset:item xsi:type="dcsset:OrderItemAuto"/>
				</dcsset:order>
				<dcsset:selection>
					<dcsset:item xsi:type="dcsset:SelectedItemAuto"/>
				</dcsset:selection>
			</dcsset:item>
		</dcsset:settings>
	</settingsVariant>
</DataCompositionSchema>