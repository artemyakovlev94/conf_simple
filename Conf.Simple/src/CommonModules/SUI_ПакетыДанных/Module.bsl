		|	втТаблица.id_doc,
		|	СерииДокумента.id_good,
		|	СерииДокумента.id_properties,
		|	СерииДокумента.id_series,
		|	СерииДокумента.id_warehouse,
		|	СерииДокумента.qtty,
		|	ВЫБОР
		|		КОГДА СерииНоменклатуры.name ЕСТЬ NULL
		|		ИЛИ СерииДокумента.СтатусОбработки = ЗНАЧЕНИЕ(Перечисление.SUI_СтатусыОбработкиСтрок.Новая)
		|			ТОГДА СерииДокумента.name
		|		ИНАЧЕ СерииНоменклатуры.name
		|	КОНЕЦ КАК name,
		|	ВЫБОР
		|		КОГДА СерииНоменклатуры.number ЕСТЬ NULL
		|		ИЛИ СерииДокумента.СтатусОбработки = ЗНАЧЕНИЕ(Перечисление.SUI_СтатусыОбработкиСтрок.Новая)
		|			ТОГДА СерииДокумента.number
		|		ИНАЧЕ СерииНоменклатуры.number
		|	КОНЕЦ КАК number,
		|	ВЫБОР
		|		КОГДА СерииНоменклатуры.best_before ЕСТЬ NULL
		|		ИЛИ СерииДокумента.СтатусОбработки = ЗНАЧЕНИЕ(Перечисление.SUI_СтатусыОбработкиСтрок.Новая)
		|			ТОГДА СерииДокумента.best_before
		|		ИНАЧЕ СерииНоменклатуры.best_before
		|	КОНЕЦ КАК best_before,
		|	ВЫБОР
		|		КОГДА СерииНоменклатуры.production_date ЕСТЬ NULL
		|		ИЛИ СерииДокумента.СтатусОбработки = ЗНАЧЕНИЕ(Перечисление.SUI_СтатусыОбработкиСтрок.Новая)
		|			ТОГДА СерииДокумента.production_date
		|		ИНАЧЕ СерииНоменклатуры.production_date
		|	КОНЕЦ КАК production_date,
		|	СерииДокумента.additional_details
		|ИЗ
		|	втТаблица КАК втТаблица
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.SUI_docs_tbl_series КАК СерииДокумента
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.SUI_tbl_series КАК СерииНоменклатуры
		|			ПО СерииДокумента.id_series = СерииНоменклатуры.id
		|		ПО втТаблица.sid = СерииДокумента.sid_doc
		|		И втТаблица.Состояние В (&СостоянияДляВыгрузки)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ втТаблица";
	#КонецОбласти
	
	СостоянияДляВыгрузки = SUI_ОбщегоНазначенияКлиентСерверПереопределяемый.МассивЗначений(
		Перечисления.SUI_СостоянияДокументовОбмена.КВыгрузке,
		Перечисления.SUI_СостоянияДокументовОбмена.Выгружен,
		Перечисления.SUI_СостоянияДокументовОбмена.Загружен,
		Перечисления.SUI_СостоянияДокументовОбмена.ВРаботе);
	
	ДанныеЗапроса.Запрос.УстановитьПараметр("МобильноеУстройство", МобильноеУстройство);
	ДанныеЗапроса.Запрос.УстановитьПараметр("СостоянияДляВыгрузки", СостоянияДляВыгрузки);
	ДанныеЗапроса.Запрос.УстановитьПараметр("sid", Неопределено);
	ДанныеЗапроса.Запрос.УстановитьПараметр("id_doc", Неопределено);
	ДанныеЗапроса.Запрос.УстановитьПараметр("НастройкаДокумента", Неопределено);
	
	ДополнительныеРеквизиты_Использовать = ПолучитьФункциональнуюОпцию("SUI_ИспользоватьДополнительныеРеквизитыТаблиц");
	
	ЗаполнитьЗначенияСвойств(ДанныеЗапроса.Запрос.Параметры, 
		SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДополнительныеПараметры, "Параметры", Новый Структура(), Тип("Структура")));
	
	// Данные для удаления регистрации
	ДобавитьПакетДанныхВСтруктуруЗапросаДанных(ДанныеЗапроса, 1, SUI_ПакетыДанныхКлиентСервер.КлючТаблицы_ОтменаРегистрации(),
		Неопределено, "sid,id_doc,НастройкаДокумента");
	
	// Данные завершенных документов
	ДобавитьПакетДанныхВСтруктуруЗапросаДанных(ДанныеЗапроса, 2, 
		SUI_НастройкиМетаданныхСервер.ПолучитьИмяТаблицыМобильногоУстройства(SUI_ПакетыДанныхКлиентСервер.КлючТаблицы_ДокументыЗавершенные()),
		"id_doc", "sid,id_doc,НастройкаДокумента", SUI_ПакетыДанныхКлиентСервер.КлючТаблицы_ДокументыЗавершенные());

	// artem - 29.08.24 - B119267 -
