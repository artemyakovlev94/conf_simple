		|	И втТаблица.Состояние В (&СостоянияДляВыгрузки)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Товары.sid,
		|	Товары.sid_doc,
		|	втТаблица.id_doc,
		|	Товары.id_good,
		|	Товары.id_properties,
		|	Товары.id_unit,
		|	Товары.id_cell,
