		|	Товары.price,
		|	Товары.use_series,
		|	Товары.use_mark,
		|	Товары.qtty_plan,
		|	Товары.qtty,
		|	Товары.additional_details
		|ИЗ
		|	втТаблица КАК втТаблица
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.SUI_docs_tbl_goods КАК Товары
		|		ПО втТаблица.sid = Товары.sid_doc
		|		И НЕ втТаблица.ЭтоДокументАдресногоХранения
		|		И Товары.ТипТаблицы = ЗНАЧЕНИЕ(Перечисление.SUI_ТипыТаблицДокументовОбмена.Товары)
		|		И втТаблица.Состояние В (&СостоянияДляВыгрузки)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втТаблица.sid,
		|	втТаблица.id_doc,
		|	втТаблица.НастройкаДокумента,
		|	втТаблица.doc_type,
		|	втТаблица.doc_n,
		|	втТаблица.doc_date,
		|	втТаблица.id_warehouse,
