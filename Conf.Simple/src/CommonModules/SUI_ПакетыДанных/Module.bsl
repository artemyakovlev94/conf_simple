Функция ПолучитьЗапросДанных_Номенклатура(МобильноеУстройство, ДополнительныеПараметры)
	
	ДанныеЗапроса = СтруктураЗапросаДанных("id,name,art,code,description,type_good,unit,use_mark,deleted", "id");
	
	ТипСоединения = ?(ДополнительныеПараметры.Свойство("ТолькоИзменения"), "ЛЕВОЕ", "ПОЛНОЕ");
	
	ДанныеЗапроса.Запрос.Текст =
		"ВЫБРАТЬ
		|	ЕСТЬNULL(Изменения.id, Таблица.id) КАК id,
		|	ЕСТЬNULL(Таблица.name, НЕОПРЕДЕЛЕНО) КАК name,
		|	ЕСТЬNULL(Таблица.art, НЕОПРЕДЕЛЕНО) КАК art,
		|	ЕСТЬNULL(Таблица.code, НЕОПРЕДЕЛЕНО) КАК code,
		|	ЕСТЬNULL(Таблица.description, НЕОПРЕДЕЛЕНО) КАК description,
		|	ЕСТЬNULL(Таблица.type_good, НЕОПРЕДЕЛЕНО) КАК type_good,
		|	ЕСТЬNULL(Таблица.unit, НЕОПРЕДЕЛЕНО) КАК unit,
		|	ВЫБОР
		|		КОГДА Таблица.use_mark ЕСТЬ NULL
		|			ТОГДА НЕОПРЕДЕЛЕНО
		|		КОГДА Таблица.use_mark
		|			ТОГДА 1
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК use_mark,
		|	Таблица.id ЕСТЬ NULL КАК deleted,
		|	НЕ Изменения.id ЕСТЬ NULL КАК SUI_ЕстьИзменения
		|ИЗ
		|	(ВЫБРАТЬ
		|			id
		|		ИЗ
		|			РегистрСведений.SUI_tbl_goods.Изменения
		|		ГДЕ
		|			Узел = &МобильноеУстройство) КАК Изменения
		|		" + ТипСоединения + " СОЕДИНЕНИЕ РегистрСведений.SUI_tbl_goods КАК Таблица
		|		ПО  Изменения.id = Таблица.id";
	
	ДанныеЗапроса.Запрос.УстановитьПараметр("МобильноеУстройство", МобильноеУстройство);
	
	Возврат Новый ФиксированнаяСтруктура(ДанныеЗапроса);

