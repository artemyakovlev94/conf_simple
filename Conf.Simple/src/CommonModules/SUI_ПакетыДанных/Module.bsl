		|	втТаблица.doc_date,
		|	втТаблица.id_countragents,
		|	втТаблица.id_warehouse,
		|	втТаблица.use_mark,
		|	втТаблица.control,
		|	втТаблица.is_group_scan,
		|	втТаблица.barcode,
		|	втТаблица.additional_details,
		|	втТаблица.is_barc_flow,
		|	// artem - 29.08.24 - B119267 -
