	ДанныеЗапроса.Запрос.УстановитьПараметр("МобильноеУстройство", МобильноеУстройство);
	
	Возврат Новый ФиксированнаяСтруктура(ДанныеЗапроса);

КонецФункции

Функция ПолучитьЗапросДанных_ПользователиТСД(МобильноеУстройство, ДополнительныеПараметры)
	
	ДанныеЗапроса = СтруктураЗапросаДанных("id,full_name,deleted", "Ссылка");
	
	ТипСоединения = ?(ДополнительныеПараметры.Свойство("ТолькоИзменения"), "ЛЕВОЕ", "ПОЛНОЕ");
	
	ДанныеЗапроса.Запрос.Текст =
		"ВЫБРАТЬ
		|	ЕСТЬNULL(Изменения.Ссылка, Таблица.Ссылка) КАК Ссылка,
		|	ЕСТЬNULL(Изменения.Ссылка, Таблица.Ссылка) КАК id,
		|	ЕСТЬNULL(Таблица.Наименование, НЕОПРЕДЕЛЕНО) КАК full_name,
		|	ЕСТЬNULL(Таблица.Логин, НЕОПРЕДЕЛЕНО) КАК Логин,
		|	ЕСТЬNULL(Таблица.Пароль, НЕОПРЕДЕЛЕНО) КАК Пароль,
		|	Таблица.Ссылка ЕСТЬ NULL КАК deleted,
		|	НЕ Изменения.Ссылка ЕСТЬ NULL КАК SUI_ЕстьИзменения
		|ИЗ
		|	(ВЫБРАТЬ
		|			Ссылка
		|		ИЗ
		|			Справочник.SUI_ПользователиТСД.Изменения
		|		ГДЕ
		|			Узел = &МобильноеУстройство) КАК Изменения
		|		" + ТипСоединения + " СОЕДИНЕНИЕ Справочник.SUI_ПользователиТСД КАК Таблица
		|		ПО  Изменения.Ссылка = Таблица.Ссылка";
	
	ДанныеЗапроса.Запрос.УстановитьПараметр("МобильноеУстройство", МобильноеУстройство);
	
	Возврат Новый ФиксированнаяСтруктура(ДанныеЗапроса);

КонецФункции

Функция ПолучитьЗапросДанных_Документы(МобильноеУстройство, ДополнительныеПараметры)
	
	ДанныеЗапроса = СтруктураЗапросаДанных();
	
	ВыборПервых = SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДополнительныеПараметры, "ВыборПервых", 0, Тип("Число"));
	Если ВыборПервых > 0 Тогда
		ВыборПервых = "ПЕРВЫЕ " + Формат(ВыборПервых, "ЧДЦ=0; ЧГ=0;");
	Иначе
		ВыборПервых = "";
	КонецЕсли;
		
	#Область ТекстЗапроса
	ДанныеЗапроса.Запрос.Текст =
		"ВЫБРАТЬ " + ВыборПервых + "
		|	Таблица.sid КАК sid,
		|	Таблица.id_doc КАК id_doc,
		|	Таблица.НастройкаДокумента КАК НастройкаДокумента,
		|	Таблица.doc_type,
		|	Таблица.doc_n,
		|	Таблица.doc_date,
		|	Таблица.id_countragents,
		|	Таблица.id_warehouse,
		|	Таблица.use_mark,
		|	ВЫБОР
		|		КОГДА Таблица.КонтролироватьДокумент
		|			ТОГДА ""1""
		|		ИНАЧЕ ""0""
		|	КОНЕЦ КАК control,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(Таблица.НастройкаДокумента.ГрупповоеСканирование, ЛОЖЬ)
		|			ТОГДА ""1""
		|		ИНАЧЕ ""0""
		|	КОНЕЦ КАК is_group_scan,
		|	// 20.09.2024 - artem - B119267 -
		|	ВЫБОР
		|		КОГДА Таблица.Агрегация
		|			ТОГДА ""1""
		|		ИНАЧЕ ""0""
		|	КОНЕЦ КАК is_aggr_doc,
		|	Таблица.ЭтоДокументАдресногоХранения,
		|	Таблица.additional_details,
		|	Таблица.barcode,
		|	Таблица.Состояние,
		|	Таблица.is_barc_flow,
		|	// 20.09.2024 - artem - B120423 -
		|	Таблица.process_type,
		|	// 20.09.2024 - artem - B120423 -
		|	Таблица.cells_process_type,
		|	НЕ Изменения.sid ЕСТЬ NULL КАК SUI_ЕстьИзменения
		|ПОМЕСТИТЬ втТаблица
		|ИЗ
		|	РегистрСведений.SUI_docs КАК Таблица
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.SUI_docs.Изменения КАК Изменения
		|		ПО Таблица.sid = Изменения.sid
		|		И Таблица.id_doc = Изменения.id_doc
		|		И Таблица.НастройкаДокумента = Изменения.НастройкаДокумента
		|		И Изменения.Узел = &МобильноеУстройство
		|ГДЕ
		|	ВЫБОР
		|		КОГДА &sid = НЕОПРЕДЕЛЕНО
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ Таблица.sid = &sid
		|	КОНЕЦ
		|	И ВЫБОР
		|		КОГДА &id_doc = НЕОПРЕДЕЛЕНО
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ Таблица.id_doc = &id_doc
		|	КОНЕЦ
		|	И ВЫБОР
		|		КОГДА &НастройкаДокумента = НЕОПРЕДЕЛЕНО
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ Таблица.НастройкаДокумента = &НастройкаДокумента
		|	КОНЕЦ
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	sid,
		|	id_doc,
		|	НастройкаДокумента
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втТаблица.sid,
