Функция ПолучитьЗапросДанных_Сообщения(МобильноеУстройство, ДополнительныеПараметры)
	
	ДанныеЗапроса = СтруктураЗапросаДанных("Сообщение", "ID,Отправитель,Получатель");
	
	ДанныеЗапроса.Запрос.Текст =
		"ВЫБРАТЬ
		|	Таблица.ID,
		|	Таблица.Отправитель,
		|	Таблица.Получатель,
		|	Таблица.Сообщение,
		|	НЕ Изменения.ID ЕСТЬ NULL КАК SUI_ЕстьИзменения
		|ИЗ
		|	РегистрСведений.SUI_СообщенияМобильныхУстройств КАК Таблица
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.SUI_СообщенияМобильныхУстройств.Изменения КАК Изменения
		|		ПО Таблица.ID = Изменения.ID
		|		И Таблица.Отправитель = Изменения.Отправитель
		|		И Таблица.Получатель = Изменения.Получатель
		|		И Изменения.Узел = &МобильноеУстройство";
	
	ДанныеЗапроса.Запрос.УстановитьПараметр("МобильноеУстройство", МобильноеУстройство);
	
	Возврат Новый ФиксированнаяСтруктура(ДанныеЗапроса);

КонецФункции

