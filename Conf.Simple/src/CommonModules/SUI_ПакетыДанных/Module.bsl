Функция СтруктураЗапросаДанных(ПоляДанных = "", КлючиОтбора = "")
	
	ДанныеЗапроса = Новый Структура();
	
	ДанныеЗапроса.Вставить("Запрос", 		Новый Запрос());
	ДанныеЗапроса.Вставить("ПоляДанных", 	ПоляДанных);
	ДанныеЗапроса.Вставить("КлючиОтбора", 	КлючиОтбора);
	ДанныеЗапроса.Вставить("Пакеты");
	
	Возврат ДанныеЗапроса;
	
КонецФункции

Функция СтруктураПакетаЗапросаДанных(ИмяПакета, ПоляДанных, КлючиОтбора, Таблица)
	
	ДанныеПакета = Новый Структура();
	
	ДанныеПакета.Вставить("ИмяПакета", 		ИмяПакета);
	ДанныеПакета.Вставить("ПоляДанных", 	ПоляДанных);
	ДанныеПакета.Вставить("КлючиОтбора", 	КлючиОтбора);
	ДанныеПакета.Вставить("Таблица", 		Таблица);
	
	Возврат ДанныеПакета;
	
КонецФункции

Процедура ДобавитьПакетДанныхВСтруктуруЗапросаДанных(СтруктураЗапросаДанных, ИндексПакета, ИмяПакета, ПоляДанных, КлючиОтбора = Неопределено, Таблица = Неопределено)
	
	ДанныеПакета = СтруктураПакетаЗапросаДанных(ИмяПакета, ПоляДанных, КлючиОтбора, Таблица);
	
	Если СтруктураЗапросаДанных.Пакеты = Неопределено Тогда
		СтруктураЗапросаДанных.Пакеты = Новый Соответствие();
	КонецЕсли;
	
	СтруктураЗапросаДанных.Пакеты.Вставить(ИндексПакета, Новый ФиксированнаяСтруктура(ДанныеПакета));
	
КонецПроцедуры

Функция ПолучитьЗапросДанных_Контрагенты(МобильноеУстройство, ДополнительныеПараметры)
	
	ДанныеЗапроса = СтруктураЗапросаДанных("id,full_name,inn,kpp,name,deleted", "id");
	
	ТипСоединения = ?(ДополнительныеПараметры.Свойство("ТолькоИзменения"), "ЛЕВОЕ", "ПОЛНОЕ");
	ДанныеЗапроса.Запрос.Текст =
		"ВЫБРАТЬ
		|	ЕСТЬNULL(Изменения.id, Таблица.id) КАК id,
		|	ЕСТЬNULL(Таблица.full_name, НЕОПРЕДЕЛЕНО) КАК full_name,
		|	ЕСТЬNULL(Таблица.inn, НЕОПРЕДЕЛЕНО) КАК inn,
		|	ЕСТЬNULL(Таблица.kpp, НЕОПРЕДЕЛЕНО) КАК kpp,
		|	ЕСТЬNULL(Таблица.name, НЕОПРЕДЕЛЕНО) КАК name,
		|	Таблица.id ЕСТЬ NULL КАК deleted,
		|	НЕ Изменения.id ЕСТЬ NULL КАК SUI_ЕстьИзменения
		|ИЗ
		|	(ВЫБРАТЬ
		|			id
		|		ИЗ
		|			РегистрСведений.SUI_tbl_countragents.Изменения
		|		ГДЕ
		|			Узел = &МобильноеУстройство) КАК Изменения
		|		" + ТипСоединения + " СОЕДИНЕНИЕ РегистрСведений.SUI_tbl_countragents КАК Таблица
		|		ПО  Изменения.id = Таблица.id";
	
	ДанныеЗапроса.Запрос.УстановитьПараметр("МобильноеУстройство", МобильноеУстройство);
	
	Возврат Новый ФиксированнаяСтруктура(ДанныеЗапроса);

КонецФункции

