#Область ДокументОбмена

Функция ПолучитьЗапросДанных_ДокументыОбмена(МобильноеУстройство, ДополнительныеПараметры)
	
	ДанныеЗапроса = СтруктураЗапросаДанных();
	
	ДанныеЗапроса.Запрос.УстановитьПараметр("СостоянияДляВыгрузки", SUI_ОбщегоНазначенияКлиентСерверПереопределяемый.МассивЗначений(
		Перечисления.SUI_СостоянияДокументовОбмена.КВыгрузке,
		Перечисления.SUI_СостоянияДокументовОбмена.Выгружен,
		Перечисления.SUI_СостоянияДокументовОбмена.Загружен,
		Перечисления.SUI_СостоянияДокументовОбмена.ВРаботе));
		
	ДанныеЗапроса.Запрос.УстановитьПараметр("СостоянияЗавершенного", SUI_ОбщегоНазначенияКлиентСерверПереопределяемый.МассивЗначений(
		Перечисления.SUI_СостоянияДокументовОбмена.Завершен,
		Перечисления.SUI_СостоянияДокументовОбмена.Отменен));
		
	ДанныеЗапроса.Запрос.УстановитьПараметр("МобильноеУстройство", МобильноеУстройство);
	ДанныеЗапроса.Запрос.Текст =
		"ВЫБРАТЬ
		|	ДокументОбмена.Ссылка КАК ДокументОбмена,
		|	ЕСТЬNULL(Настройка.Ссылка, ЗНАЧЕНИЕ(Справочник.SUI_НастройкиДокументовОбмена.ПустаяСсылка)) КАК НастройкаДокумента,
		|	ДокументОбмена.Ссылка.Состояние КАК Состояние
		|ПОМЕСТИТЬ втДанные
		|ИЗ
		|	Документ.SUI_ДокументОбмена.Изменения КАК Изменения
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.SUI_ДокументОбмена КАК ДокументОбмена
		|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.SUI_НастройкиДокументовОбмена КАК Настройка
		|			ПО (ДокументОбмена.НастройкаДокумента = Настройка.Ссылка)
		|		ПО Изменения.Ссылка = ДокументОбмена.Ссылка
		|		И Изменения.Узел = &МобильноеУстройство
		|		И (ДокументОбмена.Состояние В (&СостоянияДляВыгрузки)
		|		ИЛИ ДокументОбмена.Состояние В (&СостоянияЗавершенного))
		|ДЛЯ ИЗМЕНЕНИЯ
		|	Документ.SUI_ДокументОбмена.Изменения
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втДанные.ДокументОбмена.Ссылка КАК id,
		|	втДанные.НастройкаДокумента.Наименование КАК type,
		|	ВЫБОР
		|		КОГДА втДанные.ДокументОбмена.ТипДокумента = ЗНАЧЕНИЕ(Перечисление.SUI_ТипыДокументовОбмена.Документ)
		|			ТОГДА ""document""
		|		КОГДА втДанные.ДокументОбмена.ТипДокумента В (ЗНАЧЕНИЕ(Перечисление.SUI_ТипыДокументовОбмена.АдресноеХранениеОтбор),
		|			ЗНАЧЕНИЕ(Перечисление.SUI_ТипыДокументовОбмена.АдресноеХранениеРазмещение))
		|			ТОГДА ""cells""
		|		КОГДА втДанные.ДокументОбмена.ТипДокумента = ЗНАЧЕНИЕ(Перечисление.SUI_ТипыДокументовОбмена.СборШтрихкодов)
		|			ТОГДА ""flow""
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК process_type,
		|	ВЫБОР
		|		КОГДА втДанные.ДокументОбмена.ТипДокумента = ЗНАЧЕНИЕ(Перечисление.SUI_ТипыДокументовОбмена.АдресноеХранениеОтбор)
		|			ТОГДА ""selection""
		|		КОГДА
		|			втДанные.ДокументОбмена.ТипДокумента = ЗНАЧЕНИЕ(Перечисление.SUI_ТипыДокументовОбмена.АдресноеХранениеРазмещение)
		|			ТОГДА ""placement""
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК cells_process_type,
		|	втДанные.ДокументОбмена.НомерДокументаОснования КАК number,
		|	втДанные.ДокументОбмена.ДатаДокументаОснования КАК date,
		|	втДанные.ДокументОбмена.Контрагент КАК countragent_id,
		|	ВЫРАЗИТЬ("""" КАК СТРОКА(150)) КАК countragent,
		|	втДанные.ДокументОбмена.Склад КАК warehouse_id,
		|	ВЫРАЗИТЬ("""" КАК СТРОКА(150)) КАК warehouse,
		|	втДанные.НастройкаДокумента.КонтролироватьДокумент КАК on_control,
		|	ВЫБОР
		|		КОГДА втДанные.Состояние В (&СостоянияЗавершенного)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК is_completed,
		|	"""" КАК allow_fact_input,
		|	втДанные.ДокументОбмена.ПризнакМаркировки КАК use_mark,
		|	втДанные.ДокументОбмена.ШтрихкодДокумента КАК barcode,
		|	втДанные.НастройкаДокумента.ГрупповоеСканирование КАК is_group_scan,
		|	втДанные.ДокументОбмена.Комментарий КАК comment,
		|	втДанные.ДокументОбмена.Товары.(
		|		ИдентификаторСтроки КАК id,
		|		Номенклатура КАК product_id,
		|		Характеристика КАК property_id,
		|		Упаковка КАК unit_id,
		|		Ячейка КАК cell_id,
		|		ВидЦены КАК price_type_id,
		|		"""" КАК price_type,
		|		Цена КАК price_value,
		|		СтатусУказанияСерии КАК use_series,
		|		ПризнакМаркировки КАК use_mark,
		|		"""" КАК search_string,
		|		КоличествоПлан КАК qty_plan,
		|		КоличествоФакт КАК qty) КАК tbl_products,
		|	втДанные.ДокументОбмена.Серии.(
		|		ИдентификаторСтроки КАК id,
		|		Номенклатура КАК product_id,
		|		Характеристика КАК property_id,
		|		Наименование КАК name,
		|		Номер КАК number,
		|		ДатаПроизводства КАК production_date,
		|		ГоденДо КАК best_before,
		|		КоличествоФакт КАК qty) КАК tbl_series,
		|	втДанные.ДокументОбмена.ШтрихкодыУпаковок.(
		|		ИдентификаторСтроки КАК id,
		|		Номенклатура КАК product_id,
		|		Характеристика КАК property_id,
		|		Упаковка КАК unit_id,
		|		ЗначениеШтрихкода КАК mark_code) КАК tbl_marks
		|ИЗ
		|	втДанные КАК втДанные
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДополнительныеРеквизиты.ДокументОбмена КАК ДокументОбмена,
		|	ДополнительныеРеквизиты.Таблица КАК Таблица,
		|	ДополнительныеРеквизиты.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	ДополнительныеРеквизиты.КлючРеквизита КАК КлючРеквизита,
		|	ДополнительныеРеквизиты.ЗначениеРеквизита КАК ЗначениеРеквизита
		|ИЗ
		|	втДанные КАК втДанные
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.SUI_ДополнительныеРеквизитыДокументовОбмена КАК ДополнительныеРеквизиты
		|		ПО (втДанные.ДокументОбмена.Ссылка = ДополнительныеРеквизиты.Регистратор)
		|ГДЕ
		|	втДанные.Состояние В (&СостоянияДляВыгрузки)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПотокШтрихкодов.ДокументОбмена КАК ДокументОбмена,
		|	ПотокШтрихкодов.ИдентификаторЗаписи КАК id,
		|	ПотокШтрихкодов.Штрихкод КАК barcode,
		|	СУММА(ПотокШтрихкодов.Количество) КАК qty
		|ИЗ
		|	втДанные КАК втДанные
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.SUI_ПотокШтрихкодов КАК ПотокШтрихкодов
		|		ПО (втДанные.ДокументОбмена = ПотокШтрихкодов.ДокументОбмена)
		|ГДЕ
		|	втДанные.Состояние В (&СостоянияДляВыгрузки)
		|СГРУППИРОВАТЬ ПО
		|	ПотокШтрихкодов.ДокументОбмена,
		|	ПотокШтрихкодов.ИдентификаторЗаписи,
		|	ПотокШтрихкодов.Штрихкод";
	
	ДанныеЗапроса.Пакеты = Новый Соответствие();
	
	ДанныеПакета = СтруктураПакетаЗапросаДанных(
		SUI_НастройкиМетаданныхСервер.ПолучитьИмяТаблицыМобильногоУстройства(Перечисления.SUI_ТаблицыИнтеграции.Документы), 
		Неопределено, "id", Перечисления.SUI_ТаблицыИнтеграции.Документы);
	
	ДанныеЗапроса.Пакеты.Вставить(1, Новый ФиксированнаяСтруктура(ДанныеПакета));
	
	Возврат Новый ФиксированнаяСтруктура(ДанныеЗапроса);
	
КонецФункции

Функция СобратьСообщениеДокументаОбмена(МобильноеУстройство, РезультатыЗапроса)
	
	ДанныеДокументов = Новый ТаблицаЗначений();
	
	Для Каждого КолонкаРезультата Из РезультатыЗапроса[1].Колонки Цикл
		
		Если КолонкаРезультата.Имя = "id" Тогда
			ТипЗначенияКолонки = Новый ОписаниеТипов("УникальныйИдентификатор");
		ИначеЕсли КолонкаРезультата.Имя = "tbl_products" Или
			КолонкаРезультата.Имя = "tbl_series" Или
			КолонкаРезультата.Имя = "tbl_marks" Тогда
			ТипЗначенияКолонки = Новый ОписаниеТипов("Массив");
		Иначе
			ТипЗначенияКолонки = КолонкаРезультата.ТипЗначения;
		КонецЕсли;
		
		ДанныеДокументов.Колонки.Добавить(КолонкаРезультата.Имя, ТипЗначенияКолонки);
		
	КонецЦикла;
	
	ДанныеДокументов.Колонки.Добавить("tbl_barcode_flow", Новый ОписаниеТипов("Массив"));
	ДанныеДокументов.Колонки.Добавить("additional_details", Новый ОписаниеТипов("Соответствие"));
	
	ВыборкаДокументыОбмена = РезультатыЗапроса[1].Выбрать();
	ВыборкаДополнительныеРеквизиты = РезультатыЗапроса[2].Выбрать();
	ВыборкаПотокШтрихкодов = РезультатыЗапроса[3].Выбрать();
	
	Пока ВыборкаДокументыОбмена.Следующий() Цикл
		
		ДокументОбмена = ВыборкаДокументыОбмена.id;
		
		ДанныеДокументовСтрока = ДанныеДокументов.Добавить();
		ДанныеДокументовСтрока.id = ВыборкаДокументыОбмена.id.УникальныйИдентификатор();
		ЗаполнитьЗначенияСвойств(ДанныеДокументовСтрока, ВыборкаДокументыОбмена, , "id,tbl_products,tbl_series,tbl_marks");
		
		// Заполнить представление Контрагент
		Если SUI_ИнтеграцияВКонфигурациюКлиентСервер.ЭтоИдентификаторSimple(ДанныеДокументовСтрока.countragent_id) Тогда
			ДанныеДокументовСтрока.countragent = SUI_ИнтеграцияВКонфигурацию.СсылкаПоИдентификаторуSimple(
				ДанныеДокументовСтрока.countragent_id);
		Иначе
			ДанныеДокументовСтрока.countragent = ДанныеДокументовСтрока.countragent_id;
		КонецЕсли;
		
		// Заполнить представление Склад
		Если SUI_ИнтеграцияВКонфигурациюКлиентСервер.ЭтоИдентификаторSimple(ДанныеДокументовСтрока.warehouse_id) Тогда
			ДанныеДокументовСтрока.warehouse = SUI_ИнтеграцияВКонфигурацию.СсылкаПоИдентификаторуSimple(
				ДанныеДокументовСтрока.warehouse_id);
		Иначе
			ДанныеДокументовСтрока.warehouse = ДанныеДокументовСтрока.warehouse_id;
		КонецЕсли;
		
		// Дополнительные реквизиты
		ДобавитьДополнительныеРеквизитыДокументаОбменаИзВыборки(ВыборкаДополнительныеРеквизиты, ДанныеДокументовСтрока);
		
		// Заполнить tbl_products
		ЗаполнитьДанныеТЧДокументаОбменаИзВыборки(ВыборкаДокументыОбмена.tbl_products, ДанныеДокументовСтрока.tbl_products,
			Перечисления.SUI_ТипыТаблицДокументовОбмена.Товары, ВыборкаДополнительныеРеквизиты);
		
		// Заполнить tbl_series
		ЗаполнитьДанныеТЧДокументаОбменаИзВыборки(ВыборкаДокументыОбмена.tbl_series, ДанныеДокументовСтрока.tbl_series,
			Перечисления.SUI_ТипыТаблицДокументовОбмена.Серии, ВыборкаДополнительныеРеквизиты);
		
		// Заполнить tbl_marks
		ЗаполнитьДанныеТЧДокументаОбменаИзВыборки(ВыборкаДокументыОбмена.tbl_marks, ДанныеДокументовСтрока.tbl_marks,
			Перечисления.SUI_ТипыТаблицДокументовОбмена.ШтрихкодыУпаковок, ВыборкаДополнительныеРеквизиты);
		
		// Заполнить tbl_barcode_flow
		Если Не ВыборкаПотокШтрихкодов.Владелец().Пустой() Тогда
			
			ИменаКолонок = SUI_ОбщегоНазначения.КолонкиРезультатаЗапросаВСтроку(ВыборкаПотокШтрихкодов.Владелец(), , "ДокументОбмена");
			Отбор = Новый Структура("ДокументОбмена", ДокументОбмена);
			ВыборкаПотокШтрихкодов.Сбросить();
			Пока ВыборкаПотокШтрихкодов.НайтиСледующий(Отбор) Цикл
				ДанныеСтроки = Новый Структура(ИменаКолонок);
				ЗаполнитьЗначенияСвойств(ДанныеСтроки, ВыборкаПотокШтрихкодов);
				ДанныеДокументовСтрока.tbl_barcode_flow.Добавить(ДанныеСтроки);
			КонецЦикла;
			
		КонецЕсли;
		
		// Удалить регистрацию
		ПланыОбмена.УдалитьРегистрациюИзменений(МобильноеУстройство, ДокументОбмена);
		
	КонецЦикла;
	
	Возврат ДанныеДокументов;
	
КонецФункции

Процедура ЗаполнитьДанныеТЧДокументаОбменаИзВыборки(РезультатЗапроса, Приемник, Таблица, ВыборкаДополнительныеРеквизиты)
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ИменаКолонок = SUI_ОбщегоНазначения.КолонкиРезультатаЗапросаВСтроку(РезультатЗапроса);
	ИменаКолонок = ИменаКолонок + ",additional_details";
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ДанныеВыборки = Новый Структура(ИменаКолонок);
		ЗаполнитьЗначенияСвойств(ДанныеВыборки, Выборка);
		
		// Заполнить представление Вид цены
		Если ДанныеВыборки.Свойство("price_type_id") И ДанныеВыборки.Свойство("price_type") Тогда
			
			Если SUI_ИнтеграцияВКонфигурациюКлиентСервер.ЭтоИдентификаторSimple(ДанныеВыборки.price_type_id) Тогда
				ДанныеВыборки.price_type = SUI_ИнтеграцияВКонфигурацию.СсылкаПоИдентификаторуSimple(
					ДанныеВыборки.price_type_id);
			Иначе
				ДанныеВыборки.price_type = ДанныеВыборки.price_type_id;
			КонецЕсли;
			
		КонецЕсли;
		
		// Дополнительные реквизиты
		Если ВыборкаДополнительныеРеквизиты <> Неопределено И Таблица <> Неопределено Тогда
			ДобавитьДополнительныеРеквизитыДокументаОбменаИзВыборки(ВыборкаДополнительныеРеквизиты, ДанныеВыборки, Таблица, ДанныеВыборки.id);
		КонецЕсли;
		
		Приемник.Добавить(ДанныеВыборки);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьДополнительныеРеквизитыДокументаОбменаИзВыборки(ВыборкаДополнительныеРеквизиты, Приемник, 
	Знач Таблица = Неопределено, Знач ИдентификаторСтроки = Неопределено)
	
	Если Таблица = Неопределено Тогда
		Таблица = Перечисления.SUI_ТипыТаблицДокументовОбмена.ПустаяСсылка();
	КонецЕсли;
	
	Если ИдентификаторСтроки = Неопределено Тогда
		ИдентификаторСтроки = ОбщегоНазначенияКлиентСервер.ПустойУникальныйИдентификатор();
	КонецЕсли;
	
	Приемник.additional_details = Новый Соответствие();
	
	Отбор = Новый Структура();
	Отбор.Вставить("Таблица", Таблица);
	Отбор.Вставить("ИдентификаторСтроки", ИдентификаторСтроки);
	
	ВыборкаДополнительныеРеквизиты.Сбросить();
	Пока ВыборкаДополнительныеРеквизиты.НайтиСледующий(Отбор) Цикл
		Приемник.additional_details.Вставить(ВыборкаДополнительныеРеквизиты.КлючРеквизита,
			ОбщегоНазначения.ЗначениеИзСтрокиXML(ВыборкаДополнительныеРеквизиты.ЗначениеРеквизита));
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецОбласти
