#Область ОбработчикиПодписокНаСобытия

Процедура SUI_МобильноеУстройствоПередЗаписью(Источник, Отказ) Экспорт
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если Источник.ЭтоНовый() Тогда
		Источник.ДополнительныеСвойства.Вставить("ЭтоНовый");
	КонецЕсли;
	
	Если Источник.ЭтотУзел Тогда
		
		Источник.IPАдрес 			= "";
		Источник.Порт 				= 0;
		
	Иначе
		
		Источник.Код 		= ОбработатьСтрокуIDУстройства(Источник.Код);
		Источник.IPАдрес 	= ОбработатьСтрокуIPАдреса(Источник.IPАдрес);
		Источник.Порт 		= ?(Источник.Порт = 0, ПортМобильногоУстройстваПоУмолчанию(), Источник.Порт);
		
		УстановитьПривилегированныйРежим(Истина);
		Если Источник.ДополнительныеСвойства.Свойство("ЭтоНовый") Или
			Источник.Настройка <> ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник.Ссылка, "Настройка") Тогда
			Источник.ДополнительныеСвойства.Вставить("ЗарегистрироватьНастройкуКВыгрузке");
		КонецЕсли;
		УстановитьПривилегированныйРежим(Ложь);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура SUI_МобильноеУстройствоПриЗаписи(Источник, Отказ) Экспорт
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ Источник.ЭтотУзел Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	SUI_МобильныеУстройства.Ссылка
			|ИЗ
			|	ПланОбмена.SUI_МобильныеУстройства КАК SUI_МобильныеУстройства
			|ГДЕ
			|	SUI_МобильныеУстройства.Ссылка <> &Ссылка
			|	И SUI_МобильныеУстройства.Код = &Код";
		
		Запрос.УстановитьПараметр("Код", Источник.Код);
		Запрос.УстановитьПараметр("Ссылка", Источник.Ссылка);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если Не РезультатЗапроса.Пустой() Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'ID ""%1"" уже принадлежит мобильным устройствам:
			|%2'"), Источник.Код, СтрСоединить(РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Ссылка"), Символы.ПС));
		КонецЕсли;
		
		Если Источник.ДополнительныеСвойства.Свойство("ЭтоНовый") Тогда
			
			// Заполнить всеми настройками документов
			НаборЗаписей = РегистрыСведений.SUI_НастройкиДокументовМобильныхУстройств.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.МобильноеУстройство.Установить(Источник.Ссылка);
			НаборЗаписей.Заполнить(Новый Структура());
			Если НаборЗаписей.Количество() > 0 Тогда
				НаборЗаписей.Записать(Истина);
			КонецЕсли;
			
			ВыполнитьПолнуюВыгрузку(Источник.Ссылка);
			
		КонецЕсли;
		
		Если Источник.ДополнительныеСвойства.Свойство("ЗарегистрироватьНастройкуКВыгрузке") Тогда
			Справочники.SUI_НастройкиМобильныхУстройств
				.ЗарегистрироватьИзмененияНастройкиМобильногоУстройства(Источник.Ссылка);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура SUI_МобильноеУстройствоПередУдалением(Источник, Отказ) Экспорт
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	ПланыОбмена.УдалитьРегистрациюИзменений(Источник.Ссылка);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиОбновления

Процедура ПриДобавленииОбработчиковОбновления(Обработчики) Экспорт
	
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия 				= "1.0.2.1";
	Обработчик.Процедура 			= "SUI_МобильныеУстройстваСервер.УдалитьСлужебноеУстройство_1_0_2_1";
	Обработчик.РежимВыполнения 		= "Оперативно";
	Обработчик.Комментарий 			= НСтр("ru = 'Удаление служебного устройства'");
	
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия 				= "1.0.3.9";
	Обработчик.Процедура 			= "SUI_МобильныеУстройстваСервер.ЗаменитьСсылкиМобильныхКлиентов_1_0_3_9";
	Обработчик.РежимВыполнения 		= "Оперативно";
	Обработчик.Комментарий 			= НСтр("ru = 'Замена ссылок мобильных клиентов на ссылки мобильных устройств'");
	
КонецПроцедуры

Процедура УдалитьСлужебноеУстройство_1_0_2_1() Экспорт
	
	Если Метаданные.ПланыОбмена.SUI_МобильныеУстройства.Реквизиты.Найти("Удалить_Служебный") = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	SUI_МобильныеУстройства.Ссылка
		|ИЗ
		|	ПланОбмена.SUI_МобильныеУстройства КАК SUI_МобильныеУстройства
		|ГДЕ
		|	SUI_МобильныеУстройства.Удалить_Служебный";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		МУОбъект = Выборка.Ссылка.ПолучитьОбъект();
		МУОбъект.Удалить();
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаменитьСсылкиМобильныхКлиентов_1_0_3_9() Экспорт
	
	Если Метаданные.Справочники.Найти("Удалить_SUI_МобильныеКлиенты") = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПарыЗамен = Новый Соответствие();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Удалить_SUI_МобильныеКлиенты.Ссылка КАК МобильныйКлиент,
		|	SUI_МобильныеУстройства.Ссылка КАК МобильноеУстройство
		|ИЗ
		|	Справочник.Удалить_SUI_МобильныеКлиенты КАК Удалить_SUI_МобильныеКлиенты
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланОбмена.SUI_МобильныеУстройства КАК SUI_МобильныеУстройства
		|		ПО SUI_МобильныеУстройства.Удалить_МобильныйКлиент = Удалить_SUI_МобильныеКлиенты.Ссылка
		|		И НЕ SUI_МобильныеУстройства.ЭтотУзел";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			ПарыЗамен.Вставить(Выборка.МобильныйКлиент, Выборка.МобильноеУстройство);
		КонецЦикла;
		
		ПараметрыЗаменыСсылок = ОбщегоНазначения.ПараметрыЗаменыСсылок();
		ПараметрыЗаменыСсылок.ЗаменаПарыВТранзакции = Истина;
		ПараметрыЗаменыСсылок.ПривилегированнаяЗапись = Истина;
		ПараметрыЗаменыСсылок.СпособУдаления = "Удаление";
		ПараметрыЗаменыСсылок.ВключатьБизнесЛогику = Ложь;
		
		Результат = ОбщегоНазначения.ЗаменитьСсылки(ПарыЗамен, ПараметрыЗаменыСсылок);
		
		Если Результат.Количество() > 0 Тогда
			
			УстановитьПривилегированныйРежим(Истина);
			
			Запрос = Новый Запрос;
			Запрос.Текст =
				"ВЫБРАТЬ РАЗЛИЧНЫЕ
				|	SUI_docs_tbl_goods_delta.Период,
				|	SUI_docs_tbl_goods_delta.sid,
				|	SUI_docs_tbl_goods_delta.sid_doc,
				|	SUI_docs_tbl_goods_delta.МобильноеУстройство
				|ИЗ
				|	РегистрСведений.SUI_docs_tbl_goods_delta КАК SUI_docs_tbl_goods_delta
				|ГДЕ
				|	SUI_docs_tbl_goods_delta.МобильноеУстройство В (&МобильныеУстройства)
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗЛИЧНЫЕ
				|	SUI_НастройкиДокументовМобильныхКлиентов.МобильноеУстройство,
				|	SUI_НастройкиДокументовМобильныхКлиентов.НастройкаДокумента
				|ИЗ
				|	РегистрСведений.SUI_НастройкиДокументовМобильныхУстройств КАК SUI_НастройкиДокументовМобильныхКлиентов
				|ГДЕ
				|	SUI_НастройкиДокументовМобильныхКлиентов.МобильноеУстройство В (&МобильныеУстройства)
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////	
				|ВЫБРАТЬ РАЗЛИЧНЫЕ
				|	Удалить_SUI_МобильныеКлиенты.Ссылка
				|ИЗ
				|	Справочник.Удалить_SUI_МобильныеКлиенты КАК Удалить_SUI_МобильныеКлиенты
				|ГДЕ
				|	Удалить_SUI_МобильныеКлиенты.Ссылка В (&МобильныеУстройства)";
			
			Запрос.УстановитьПараметр("МобильныеУстройства", 
				ОбщегоНазначенияКлиентСервер.СвернутьМассив(Результат.ВыгрузитьКолонку("Ссылка")));
			
			РезультатыЗапроса = Запрос.ВыполнитьПакет();
			
			Для ИндексЗапроса = 0 По РезультатыЗапроса.ВГраница() Цикл
				
				Если РезультатыЗапроса[ИндексЗапроса].Пустой() Тогда
					Продолжить;
				КонецЕсли;
				
				ЭтоСправочникМобильныхКлиентов = (ИндексЗапроса = РезультатыЗапроса.ВГраница());
				
				Если ЭтоСправочникМобильныхКлиентов Тогда
					МетаданныеОбъекта = Метаданные.Справочники.Удалить_SUI_МобильныеКлиенты;
				ИначеЕсли ИндексЗапроса = 0 Тогда
					МетаданныеОбъекта = Метаданные.РегистрыСведений.SUI_docs_tbl_goods_delta;
				ИначеЕсли ИндексЗапроса = 1 Тогда
					МетаданныеОбъекта = Метаданные.РегистрыСведений.SUI_НастройкиДокументовМобильныхУстройств;
				Иначе
					Продолжить;
				КонецЕсли;
				
				МенеджерОбъекта =  ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(МетаданныеОбъекта.ПолноеИмя());
				ИзмеренияОбъекта = SUI_ОбщегоНазначения.КолонкиРезультатаЗапросаВСтруктуру(РезультатыЗапроса[ИндексЗапроса]);
				
				НачатьТранзакцию();
				
				Попытка
					
					Блокировка = Новый БлокировкаДанных;
					ЭлементБлокировки = Блокировка.Добавить(МетаданныеОбъекта.ПолноеИмя());
					ЭлементБлокировки.Режим = РежимБлокировкиДанных.Разделяемый;
					ЭлементБлокировки.ИсточникДанных = РезультатыЗапроса[ИндексЗапроса];
					Для Каждого ИзмеренияОбъектаКлючЗначение Из ИзмеренияОбъекта Цикл
						ЭлементБлокировки.ИспользоватьИзИсточникаДанных(ИзмеренияОбъектаКлючЗначение.Ключ, ИзмеренияОбъектаКлючЗначение.Ключ);
					КонецЦикла;
					Блокировка.Заблокировать();
					
					Выборка = РезультатыЗапроса[ИндексЗапроса].Выбрать();
					
					Пока Выборка.Следующий() Цикл
						
						Если ЭтоСправочникМобильныхКлиентов Тогда
							
							Для Каждого ИзмеренияОбъектаКлючЗначение Из ИзмеренияОбъекта Цикл
								СправочникОбъект = Выборка[ИзмеренияОбъектаКлючЗначение.Ключ].ПолучитьОбъект();
								СправочникОбъект.Удалить();
							КонецЦикла;
							
						Иначе
							
							НаборЗаписей = МенеджерОбъекта.СоздатьНаборЗаписей();
					
							Для Каждого ИзмеренияОбъектаКлючЗначение Из ИзмеренияОбъекта Цикл
								НаборЗаписей.Отбор[ИзмеренияОбъектаКлючЗначение.Ключ]
									.Установить(Выборка[ИзмеренияОбъектаКлючЗначение.Значение]);
							КонецЦикла;
							
							НаборЗаписей.ОбменДанными.Загрузка = Истина;
							НаборЗаписей.Записать();
							
						КонецЕсли;
						
					КонецЦикла;
					
					ЗафиксироватьТранзакцию();
					
				Исключение
					ОтменитьТранзакцию();
					ВызватьИсключение;
				КонецПопытки;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОбработатьСтрокуIDУстройства(IDУстройства)
	Возврат SUI_СтроковыеФункцииКлиентСервер.ПривестиСтрокуКРазрешеннымСимволам(СокрЛП(НРег(IDУстройства)), 
		SUI_СтроковыеФункцииКлиентСервер.АлфавитЦифры() + SUI_СтроковыеФункцииКлиентСервер.АлфавитБуквыЛатинские());
КонецФункции

Функция ОбработатьСтрокуIPАдреса(Знач IPАдрес)
	
	IPАдрес = SUI_СтроковыеФункцииКлиентСервер.ПривестиСтрокуКРазрешеннымСимволам(СокрЛП(IPАдрес), 
		SUI_СтроковыеФункцииКлиентСервер.АлфавитЦифры() + ".");
		
	РазрядыIPАдрес = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(IPАдрес, ".", Истина);
	
	ОсталосьДобавитьРазрядов = (4 - РазрядыIPАдрес.Количество());
	
	Если ОсталосьДобавитьРазрядов > 0 Тогда
		Для индекс = 1 По ОсталосьДобавитьРазрядов Цикл
			РазрядыIPАдрес.Добавить("0");
		КонецЦикла;
	КонецЕсли;
	
	ОбработанныеРазряды = Новый Массив();
	Для индекс = 0 По 3 Цикл
		ОбработанныеРазряды.Добавить(СокрЛП(Лев(РазрядыIPАдрес[индекс], 3)));
	КонецЦикла;
	
	Возврат СтрСоединить(ОбработанныеРазряды, ".");
	
КонецФункции

Функция ПортМобильногоУстройстваПоУмолчанию()
	Возврат 8095;
КонецФункции

#КонецОбласти
