//   Строка	- Текущая версия расширения
Функция Версия() Экспорт
	Возврат SUI_Simple.Версия();
КонецФункции

Процедура УстановитьАдресПубликацииИнформационнойБазы(Адрес) Экспорт
	Константы.SUI_АдресПубликацииБазы.Установить(Адрес);
КонецПроцедуры

Функция ПолучитьАдресПубликацииИнформационнойБазы() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Возврат Константы.SUI_АдресПубликацииБазы.Получить();
	
КонецФункции

Функция ПолныеПраваДоступны(УчитыватьПолныеПраваКонфигурации = Истина, УчитыватьПривилегированныйРежим = Истина) Экспорт
	Возврат SUI_Simple.ЭтоПолныеПрава(УчитыватьПривилегированныйРежим);
КонецФункции

Функция РолиРасширенияДоступны() Экспорт 
	Возврат SUI_Simple.РолиРасширенияДоступны();
КонецФункции

Функция ЗапускатьМастерНастроекПриНачалеРаботыСистемы(Значение = Неопределено) Экспорт
	
	Если Значение <> Неопределено Тогда
		УстановитьПривилегированныйРежим(Истина);
		Константы.SUI_НеЗапускатьМастерНастроекПриНачалеРаботы.Установить(
			Не SUI_ОбщегоНазначенияКлиентСервер.ОписаниеТипаБулево().ПривестиЗначение(Значение));
		Возврат Значение;
	Иначе
		Возврат Не ПолучитьФункциональнуюОпцию("SUI_НеЗапускатьМастерНастроекПриНачалеРаботы");
	КонецЕсли;
	
КонецФункции

#КонецОбласти

