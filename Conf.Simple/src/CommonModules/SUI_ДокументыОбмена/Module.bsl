		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ втТаблицаПересчетТоваров";	
		
		//@skip-check query-in-loop
		РезультатЗапроса = Запрос.ВыполнитьПакет();

		РезультатТовары = РезультатЗапроса[5];
		РезультатСерии = РезультатЗапроса[7];
		РезультатШК = РезультатЗапроса[9];
		РезультатПотокШК = РезультатЗапроса[11];
		РезультатПересчетТоваров = РезультатЗапроса[13];
		
		Если Не РезультатТовары.Пустой() Тогда
			
			Выборка = РезультатТовары.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока Выборка.Следующий() Цикл
				
				ТаблицаДанных = ТаблицаТоварыДокументаОбмена();

				ДетальныеЗаписи = Выборка.Выбрать();
				
				Пока ДетальныеЗаписи.Следующий() Цикл
					
					СтрокаТаблицы = ТаблицаДанных.Добавить();
					
					ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ДетальныеЗаписи);
					
					Если Не ЗначениеЗаполнено(СтрокаТаблицы.sid) Тогда
						СтрокаТаблицы.sid = Строка(Новый УникальныйИдентификатор());
					КонецЕсли;
					
				КонецЦикла;
				
				ДанныеДокумента.Таблицы.Вставить(Выборка.ТипТаблицы, ТаблицаДанных);
				
			КонецЦикла;
			
		КонецЕсли;
		
		Если Не РезультатСерии.Пустой() Тогда
			
			ТаблицаДанных = ТаблицаСерииДокументаОбмена();
			
			Выборка = РезультатСерии.Выбрать();
			
			Пока Выборка.Следующий() Цикл
				
				СтрокаТаблицы = ТаблицаДанных.Добавить();
				
				ЗаполнитьЗначенияСвойств(СтрокаТаблицы, Выборка);
				
				Если Не ЗначениеЗаполнено(СтрокаТаблицы.sid) Тогда
					СтрокаТаблицы.sid = Строка(Новый УникальныйИдентификатор());
				КонецЕсли;
				
			КонецЦикла;
			
			ДанныеДокумента.Таблицы.Вставить(Перечисления.SUI_ТипыТаблицДокументовОбмена.Серии, ТаблицаДанных);
			
		КонецЕсли;
		
		Если Не РезультатШК.Пустой() Тогда
			
			ТаблицаДанных = ТаблицаШтрихкодыДокументаОбмена();
			
			Выборка = РезультатШК.Выбрать();
			
			Пока Выборка.Следующий() Цикл
				
				СтрокаТаблицы = ТаблицаДанных.Добавить();
				
				ЗаполнитьЗначенияСвойств(СтрокаТаблицы, Выборка);
				
				Если Не ЗначениеЗаполнено(СтрокаТаблицы.sid) Тогда
					СтрокаТаблицы.sid = Строка(Новый УникальныйИдентификатор());
				КонецЕсли;
				
			КонецЦикла;
			
			ДанныеДокумента.Таблицы.Вставить(Перечисления.SUI_ТипыТаблицДокументовОбмена.ШтрихкодыУпаковок, ТаблицаДанных);
			
		КонецЕсли;
		
		Если Не РезультатПотокШК.Пустой() Тогда
			
			ТаблицаДанных = ТаблицаПотокШтрихкодовОбмена();
			
			Выборка = РезультатПотокШК.Выбрать();
			
			Пока Выборка.Следующий() Цикл
				
				СтрокаТаблицы = ТаблицаДанных.Добавить();
				
				ЗаполнитьЗначенияСвойств(СтрокаТаблицы, Выборка);
				
				Если Не ЗначениеЗаполнено(СтрокаТаблицы.sid) Тогда
					СтрокаТаблицы.sid = Строка(Новый УникальныйИдентификатор());
				КонецЕсли;
				
			КонецЦикла;
			
			ДанныеДокумента.Таблицы.Вставить(Перечисления.SUI_ТипыТаблицДокументовОбмена.ПотокШтрихкодов, ТаблицаДанных);
			
		КонецЕсли;
		
		Если Не РезультатПересчетТоваров.Пустой() Тогда
			
			ТаблицаДанных = ТаблицаПересчетТоваровДокументаОбмена();
			
			Выборка = РезультатПересчетТоваров.Выбрать();
			
			Пока Выборка.Следующий() Цикл
				
				СтрокаТаблицы = ТаблицаДанных.Добавить();
				
				ЗаполнитьЗначенияСвойств(СтрокаТаблицы, Выборка);
				
				Если Не ЗначениеЗаполнено(СтрокаТаблицы.sid) Тогда
					СтрокаТаблицы.sid = Строка(Новый УникальныйИдентификатор());
				КонецЕсли;
				
			КонецЦикла;
			
			ДанныеДокумента.Таблицы.Вставить("ТаблицаПересчетТоваров", ТаблицаДанных);
			
		КонецЕсли;
		
		Если ДанныеДокумента.Таблицы.Количество() > 0 Или (ДанныеДокумента.Таблицы.Количество() = 0 И БезТаблиц) Тогда
			ДанныеДокументов.Добавить(ДанныеДокумента);
		КонецЕсли;

	КонецЦикла;
	
	Возврат ДанныеДокументов;
	
КонецФункции

Функция ТребуетсяОбновлениеЗаписиДокументаОбмена(ЗаписьНабора, СформированныеДанные)
	
	Результат = Ложь;
	
	ПроверяемыеДанные = Новый Массив();
	ПроверяемыеДанные.Добавить("Состояние");
	ПроверяемыеДанные.Добавить("МобильноеУстройство");
	ПроверяемыеДанные.Добавить("doc_n");
	ПроверяемыеДанные.Добавить("doc_date");
	ПроверяемыеДанные.Добавить("id_countragents");
	ПроверяемыеДанные.Добавить("id_warehouse");
	ПроверяемыеДанные.Добавить("ЭтоДокументАдресногоХранения");
	ПроверяемыеДанные.Добавить("КонтролироватьДокумент");
	ПроверяемыеДанные.Добавить("barcode");
	ПроверяемыеДанные.Добавить("use_mark");
	ПроверяемыеДанные.Добавить("additional_details");
	ПроверяемыеДанные.Добавить("is_barc_flow");
	
	// 20.09.2024 - artem - B119267 >>>
	ПроверяемыеДанные.Добавить("Агрегация");
	// 20.09.2024 - artem - B119267 <<<
	
	// 20.09.2024 - artem - B120423 >>>
	ПроверяемыеДанные.Добавить("process_type");
	ПроверяемыеДанные.Добавить("cells_process_type");
	// 20.09.2024 - artem - B120423 <<<
	
	Для индекс = 0 По ПроверяемыеДанные.ВГраница() Цикл
		
		Если СформированныеДанные.Свойство(ПроверяемыеДанные[индекс]) И
			ЗаписьНабора[ПроверяемыеДанные[индекс]] <> СформированныеДанные[ПроверяемыеДанные[индекс]] Тогда
			Результат = Истина;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
		
КонецФункции

#КонецОбласти

#Область ЗагрузкаДокументаОбменаВДокумент

Процедура ЗагрузитьТаблицыДокументаОбменаВДокументОбъект_ШтрихкодыУпаковок(ДокументОбъект, ТаблицаДокументаОбмена, НастройкаТабличнойЧасти, АлгоритмОбработкиСтрок)
	
	Если Не ЗначениеЗаполнено(ТаблицаДокументаОбмена) Или Не ЗначениеЗаполнено(НастройкаТабличнойЧасти) Или
		НастройкаТабличнойЧасти.ТипТаблицы <> Перечисления.SUI_ТипыТаблицДокументовОбмена.ШтрихкодыУпаковок Или
		Не ЗначениеЗаполнено(НастройкаТабличнойЧасти.ИмяТабличнойЧасти) Тогда
		Возврат;
	КонецЕсли;
	
	НастройкаРеквизитаШтрихкодУпаковки = НастройкаТабличнойЧасти.Элементы.Получить("id_marking_code");
	
	Если Не ЗначениеЗаполнено(НастройкаРеквизитаШтрихкодУпаковки) Или НастройкаРеквизитаШтрихкодУпаковки.Имя = Неопределено Или
		ТаблицаДокументаОбмена.Колонки.Найти("id_marking_code") = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из ТаблицаДокументаОбмена Цикл

		ПараметрыОтбора = СформироватьПараметрыОтбора(НастройкаТабличнойЧасти.Элементы, СтрокаТаблицы, "id_marking_code");
		
		Если Не ЗначениеЗаполнено(ПараметрыОтбора) Тогда
			Продолжить;
		КонецЕсли;
		
		// Найти строки штрихкода упаковки в табличной части
		СтрокиВДокументе = ДокументОбъект[НастройкаТабличнойЧасти.ИмяТабличнойЧасти].НайтиСтроки(ПараметрыОтбора);
		
		// Если штрихкод упаковки уже есть в табличной части
		Если СтрокиВДокументе.Количество() > 0 Тогда
			Для Каждого СтрокаВДокументе Из СтрокиВДокументе Цикл
				СтрокаТаблицы.НомерСтроки = СтрокаВДокументе.НомерСтроки;
			КонецЦикла;
			Продолжить;
		КонецЕсли;
		
		// Если штрихкод упаковки отсутствует в табличной части, то добавить
		ТекущаяСтрока = ДокументОбъект[НастройкаТабличнойЧасти.ИмяТабличнойЧасти].Добавить(); 
		ТекущаяСтрока[НастройкаРеквизитаШтрихкодУпаковки.Имя] = НастройкаРеквизитаШтрихкодУпаковки.Тип.ПривестиЗначение(
			СтрокаТаблицы.id_marking_code);
		
		СтрокаТаблицы.НомерСтроки = ТекущаяСтрока.НомерСтроки;
		
		// Выполнить произвольный алгоритм после программной обработки строки
		ВыполнитьПроизвольныйАлгоритм_ОбработкаСтрокиТабличнойЧасти(АлгоритмОбработкиСтрок, ДокументОбъект, ТекущаяСтрока);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗагрузитьТаблицыДокументаОбменаВДокументОбъект_Серии(ДокументОбъект, ТаблицаДокументаОбмена, НастройкаТабличнойЧасти, АлгоритмОбработкиСтрок)
	
	Если Не ЗначениеЗаполнено(ТаблицаДокументаОбмена) Или Не ЗначениеЗаполнено(НастройкаТабличнойЧасти) Или
		НастройкаТабличнойЧасти.ТипТаблицы <> Перечисления.SUI_ТипыТаблицДокументовОбмена.Серии Или
		Не ЗначениеЗаполнено(НастройкаТабличнойЧасти.ИмяТабличнойЧасти) Тогда
		Возврат;
	КонецЕсли;
	
	НастройкаРеквизитаКоличество = НастройкаТабличнойЧасти.Элементы.Получить("qtty");

	Для Каждого СтрокаТаблицы Из ТаблицаДокументаОбмена Цикл
		
		СтрокаОбработана = Ложь;
		
		ПараметрыОтбора = СформироватьПараметрыОтбора(НастройкаТабличнойЧасти.Элементы, СтрокаТаблицы, 
			"id_good,id_properties,id_series,id_warehouse");
		
		Если Не ЗначениеЗаполнено(ПараметрыОтбора) Тогда
			Продолжить;
		КонецЕсли;
		
		// Найти строки по отбору
		СтрокиВДокументе = ДокументОбъект[НастройкаТабличнойЧасти.ИмяТабличнойЧасти].НайтиСтроки(ПараметрыОтбора);
		
		Если СтрокиВДокументе.Количество() > 0 Тогда
			// Выбрать найденную строку
			ТекущаяСтрока = СтрокиВДокументе[0];
		Иначе
			// Добавить новую строку
			ТекущаяСтрока = ДокументОбъект[НастройкаТабличнойЧасти.ИмяТабличнойЧасти].Добавить();
			ЗаполнитьЗначенияСвойств(ТекущаяСтрока, ПараметрыОтбора);
			СтрокаОбработана = Истина;
		КонецЕсли;
		
		СтрокаТаблицы.НомерСтроки = ТекущаяСтрока.НомерСтроки;
		
		// Обновить количество
		Если ЗначениеЗаполнено(НастройкаРеквизитаКоличество) И НастройкаРеквизитаКоличество.Имя <> Неопределено Тогда
			ТекущаяСтрока[НастройкаРеквизитаКоличество.Имя] = НастройкаРеквизитаКоличество.Тип.ПривестиЗначение(
				СтрокаТаблицы["qtty"]);
			СтрокаОбработана = Истина;
		КонецЕсли;

		// Выполнить произвольный алгоритм после программной обработки строки
		Если СтрокаОбработана Тогда
			ВыполнитьПроизвольныйАлгоритм_ОбработкаСтрокиТабличнойЧасти(АлгоритмОбработкиСтрок, ДокументОбъект, ТекущаяСтрока);
		КонецЕсли;

	КонецЦикла;
	
КонецПроцедуры

Процедура ЗагрузитьТаблицыДокументаОбменаВДокументОбъект_Товары(ДокументОбъект, ТаблицаДокументаОбмена, 
	НастройкаТабличнойЧасти, НастройкаТабличнойЧастиСерии,  АлгоритмОбработкиСтрок, ТаблицаСерийБезНастройки)
	
	Если Не ЗначениеЗаполнено(ТаблицаДокументаОбмена) Или Не ЗначениеЗаполнено(НастройкаТабличнойЧасти) Или
		(НастройкаТабличнойЧасти.ТипТаблицы <> Перечисления.SUI_ТипыТаблицДокументовОбмена.Товары И
		НастройкаТабличнойЧасти.ТипТаблицы <> Перечисления.SUI_ТипыТаблицДокументовОбмена.Отбор И
		НастройкаТабличнойЧасти.ТипТаблицы <> Перечисления.SUI_ТипыТаблицДокументовОбмена.Размещение) Или
		Не ЗначениеЗаполнено(НастройкаТабличнойЧасти.ИмяТабличнойЧасти) Тогда
		Возврат;
	КонецЕсли;
	
	НастройкаРеквизитаКоличество 	= НастройкаТабличнойЧасти.Элементы.Получить("qtty");
	НастройкаРеквизитаСерия 		= НастройкаТабличнойЧасти.Элементы.Получить("id_series");

	Для Каждого СтрокаТаблицы Из ТаблицаДокументаОбмена Цикл
		
		Если ЗначениеЗаполнено(СтрокаТаблицы.НомерСтроки) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаОбработана = Ложь;
		мсвНовыеСтроки = Новый Массив();
		
		ПараметрыОтбора = СформироватьПараметрыОтбора(НастройкаТабличнойЧасти.Элементы, СтрокаТаблицы, 
			"id_good,id_properties,id_series,id_cell,id_unit");
		
		Если Не ЗначениеЗаполнено(ПараметрыОтбора) Тогда
			Продолжить;
		КонецЕсли;
		
		// Найти строки по отбору
		СтрокиВДокументе = ДокументОбъект[НастройкаТабличнойЧасти.ИмяТабличнойЧасти].НайтиСтроки(ПараметрыОтбора);
		
		Если СтрокиВДокументе.Количество() > 0 Тогда
			// Выбрать найденную строку
			ТекущаяСтрока = СтрокиВДокументе[0];
		Иначе
			// Добавить новую строку
			ТекущаяСтрока = ДокументОбъект[НастройкаТабличнойЧасти.ИмяТабличнойЧасти].Добавить();
			ДанныеКЗаполнению = СформироватьПараметрыОтбора(НастройкаТабличнойЧасти.Элементы, СтрокаТаблицы, 
				"id_good,id_properties,id_series,id_cell,id_unit,id_price,price");
			ЗаполнитьЗначенияСвойств(ТекущаяСтрока, ДанныеКЗаполнению);
			СтрокаОбработана = Истина;
		КонецЕсли;
		
		СтрокаТаблицы.НомерСтроки = ТекущаяСтрока.НомерСтроки;
		
		// Обновить количество
		Если ЗначениеЗаполнено(НастройкаРеквизитаКоличество) И НастройкаРеквизитаКоличество.Имя <> Неопределено Тогда
			ТекущаяСтрока[НастройкаРеквизитаКоличество.Имя] = НастройкаРеквизитаКоличество.Тип.ПривестиЗначение(
				СтрокаТаблицы["qtty"]);
			СтрокаОбработана = Истина;
		КонецЕсли;
		
		// Обновить серию в строке
		Если ЗначениеЗаполнено(НастройкаРеквизитаСерия) И НастройкаРеквизитаСерия.Имя <> Неопределено И
			Не ЗначениеЗаполнено(ТекущаяСтрока[НастройкаРеквизитаСерия.Имя]) Тогда
			// Получить серию
			Если ЗначениеЗаполнено(НастройкаТабличнойЧастиСерии) Тогда
				//@skip-check query-in-loop
				ЗаполнитьСериюВСтрокеТабличнойЧастиТоварыДокумента(ДокументОбъект, ТекущаяСтрока, 
					НастройкаТабличнойЧасти, НастройкаТабличнойЧастиСерии);
				СтрокаОбработана = Истина;
			ИначеЕсли ЗначениеЗаполнено(ТаблицаСерийБезНастройки) Тогда

				ПараметрыЗаполненияСерии = ПараметрыЗаполненияСерииВДокументе();
				ПараметрыЗаполненияСерии.НастройкаТЧТовары = НастройкаТабличнойЧасти;
				ПараметрыЗаполненияСерии.ТЧТоварыДокумента = ДокументОбъект[НастройкаТабличнойЧасти.ИмяТабличнойЧасти];
				ПараметрыЗаполненияСерии.ТаблицаТоварыДокументаОбмена = ТаблицаДокументаОбмена;
				ПараметрыЗаполненияСерии.ТаблицаСерийДокументаОбмена = ТаблицаСерийБезНастройки;
				ПараметрыЗаполненияСерии.ТекущаяСтрокаДокумента = ТекущаяСтрока;
				ПараметрыЗаполненияСерии.ТекущаяСтрокаДокументаОбмена = СтрокаТаблицы;

				сткРезультат = ЗаполнитьСериюВСтрокеТабличнойЧастиТоварыДокументаПоСерииБезНастройки(ПараметрыЗаполненияСерии);
				
				Если сткРезультат.СтрокаОбработана Тогда
					СтрокаОбработана = Истина;
					мсвНовыеСтроки = сткРезультат.НовыеСтроки;
				КонецЕсли;

			КонецЕсли;
			
		КонецЕсли;

		// Выполнить произвольный алгоритм после программной обработки строки
		Если СтрокаОбработана Тогда
			ВыполнитьПроизвольныйАлгоритм_ОбработкаСтрокиТабличнойЧасти(АлгоритмОбработкиСтрок, ДокументОбъект, ТекущаяСтрока);
		КонецЕсли;
		
		Для Каждого НоваяСтрока Из мсвНовыеСтроки Цикл
			ВыполнитьПроизвольныйАлгоритм_ОбработкаСтрокиТабличнойЧасти(АлгоритмОбработкиСтрок, ДокументОбъект, НоваяСтрока);
		КонецЦикла;
		
		мсвНовыеСтроки.Очистить();
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьСериюВСтрокеТабличнойЧастиТоварыДокумента(ДокументОбъект, СтрокаТовары, НастройкаТЧТовары, НастройкаТЧСерии)
	
	Если Не ЗначениеЗаполнено(НастройкаТЧТовары) Или Не ЗначениеЗаполнено(НастройкаТЧСерии) Или
		НастройкаТЧСерии.ТипТаблицы <> Перечисления.SUI_ТипыТаблицДокументовОбмена.Серии Или
		Не ЗначениеЗаполнено(НастройкаТЧСерии.ИмяТабличнойЧасти) Или
		(НастройкаТЧТовары.ТипТаблицы <> Перечисления.SUI_ТипыТаблицДокументовОбмена.Товары И
		НастройкаТЧТовары.ТипТаблицы <> Перечисления.SUI_ТипыТаблицДокументовОбмена.Отбор И
		НастройкаТЧТовары.ТипТаблицы <> Перечисления.SUI_ТипыТаблицДокументовОбмена.Размещение) Или
		Не ЗначениеЗаполнено(НастройкаТЧТовары.ИмяТабличнойЧасти) Тогда
		Возврат;
	КонецЕсли;
	
	Если ДокументОбъект[НастройкаТЧСерии.ИмяТабличнойЧасти].Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Товары_РеквизитСерия 			= НастройкаТЧТовары.Элементы.Получить("id_series");
	Товары_РеквизитНоменклатура		= НастройкаТЧТовары.Элементы.Получить("id_good");
	Товары_РеквизитХарактеристика	= НастройкаТЧТовары.Элементы.Получить("id_properties");
	
	
	Если Не ЗначениеЗаполнено(Товары_РеквизитСерия) Или Товары_РеквизитСерия.Имя = Неопределено Или 
		Не ЗначениеЗаполнено(Товары_РеквизитНоменклатура) Или Товары_РеквизитНоменклатура.Имя = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Серии_РеквизитСерия 			= НастройкаТЧТовары.Элементы.Получить("id_series");
	Серии_РеквизитНоменклатура		= НастройкаТЧТовары.Элементы.Получить("id_good");
	Серии_РеквизитХарактеристика	= НастройкаТЧТовары.Элементы.Получить("id_properties");
	
	Если Не ЗначениеЗаполнено(Серии_РеквизитСерия) Или Серии_РеквизитСерия.Имя = Неопределено Или 
		Не ЗначениеЗаполнено(Серии_РеквизитНоменклатура) Или Серии_РеквизитНоменклатура.Имя = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос();
	
	//@skip-check bsl-variable-name-invalid
	мсвВыбрать 			= ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве("Таблица." + Серии_РеквизитНоменклатура.Имя + " КАК " + Серии_РеквизитНоменклатура.Имя);
	//@skip-check bsl-variable-name-invalid
	мсвУсловия 			= ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве("Таблица." + Серии_РеквизитНоменклатура.Имя + " = &" + Серии_РеквизитНоменклатура.Имя);
	//@skip-check bsl-variable-name-invalid
	мсвСгруппировать 	= ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве("втТаблица." + Серии_РеквизитНоменклатура.Имя);
	Запрос.УстановитьПараметр(Серии_РеквизитНоменклатура.Имя, СтрокаТовары[Товары_РеквизитНоменклатура.Имя]);
	
	Если ЗначениеЗаполнено(Товары_РеквизитХарактеристика) И 
		Товары_РеквизитХарактеристика.Имя <> Неопределено И 
		ЗначениеЗаполнено(Серии_РеквизитХарактеристика) И
		Серии_РеквизитХарактеристика.Имя <> Неопределено Тогда
		мсвВыбрать.Добавить("Таблица." + Серии_РеквизитХарактеристика.Имя + " КАК " + Серии_РеквизитХарактеристика.Имя);
		мсвУсловия.Добавить("Таблица." + Серии_РеквизитХарактеристика.Имя + " = &" + Серии_РеквизитХарактеристика.Имя);
		мсвСгруппировать.Добавить("втТаблица." + Серии_РеквизитХарактеристика.Имя);
		Запрос.УстановитьПараметр(Серии_РеквизитХарактеристика.Имя, СтрокаТовары[Товары_РеквизитХарактеристика.Имя]);
	КонецЕсли;
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц();
	Запрос.УстановитьПараметр("Таблица", ДокументОбъект[НастройкаТЧСерии.ИмяТабличнойЧасти].Выгрузить());
	Запрос.Текст = "ВЫБРАТЬ
	|	Таблица." + Серии_РеквизитСерия.Имя + " КАК Серия,
	|	" + СтрСоединить(мсвВыбрать, ","  + Символы.ПС) + "
	|ПОМЕСТИТЬ втТаблица
	|ИЗ
	|	&Таблица КАК Таблица
	|ГДЕ
	|	" + СтрСоединить(мсвУсловия, Символы.ПС + Символы.Таб + "И ") + "
	|;
	|//////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	МАКСИМУМ(втТаблица.Серия) КАК Серия
	|ИЗ
	|	втТаблица КАК втТаблица
	|СГРУППИРОВАТЬ ПО
	|	" + СтрСоединить(мсвСгруппировать, "," + Символы.ПС);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	
	СтрокаТовары[Товары_РеквизитСерия.Имя] = Выборка.Серия;
	
КонецПроцедуры

Функция ПараметрыЗаполненияСерииВДокументе()
	
	ПараметрыЗаполненияСерии = Новый Структура();
	
	ПараметрыЗаполненияСерии.Вставить("НастройкаТЧТовары");
	ПараметрыЗаполненияСерии.Вставить("НастройкаТЧСерии");
	ПараметрыЗаполненияСерии.Вставить("ТЧТоварыДокумента");
	ПараметрыЗаполненияСерии.Вставить("ТаблицаТоварыДокументаОбмена");
	ПараметрыЗаполненияСерии.Вставить("ТаблицаСерийДокументаОбмена");
	ПараметрыЗаполненияСерии.Вставить("ТекущаяСтрокаДокумента");
	ПараметрыЗаполненияСерии.Вставить("ТекущаяСтрокаДокументаОбмена");

	Возврат ПараметрыЗаполненияСерии;
	
КонецФункции

// Заполнить серию в строке табличной части товары документа по серии без настройки.
// 
// Параметры:
//  ПараметрыЗаполнения - Структура - Параметры заполнения см. ПараметрыЗаполненияСерииВДокументе
// 
// Возвращаемое значение:
//  Массив - Массив новых строк документа
//@skip-check doc-comment-collection-item-type
Функция ЗаполнитьСериюВСтрокеТабличнойЧастиТоварыДокументаПоСерииБезНастройки(ПараметрыЗаполнения)
	
	//@skip-check bsl-variable-name-invalid
	сткРезультат = Новый Структура("СтрокаОбработана, НовыеСтроки", Ложь, Новый Массив());
	
	Если Не ЗначениеЗаполнено(ПараметрыЗаполнения.НастройкаТЧТовары) Или
		Не ЗначениеЗаполнено(ПараметрыЗаполнения.ТЧТоварыДокумента) Или
		Не ЗначениеЗаполнено(ПараметрыЗаполнения.ТаблицаТоварыДокументаОбмена) Или
		Не ЗначениеЗаполнено(ПараметрыЗаполнения.ТаблицаСерийДокументаОбмена) Или
		Не ЗначениеЗаполнено(ПараметрыЗаполнения.ТекущаяСтрокаДокумента) Или
		Не ЗначениеЗаполнено(ПараметрыЗаполнения.ТекущаяСтрокаДокументаОбмена) Тогда
		Возврат сткРезультат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыЗаполнения.НастройкаТЧСерии) Тогда
		// сткРезультат = ЗаполнитьСериюВСтрокеТабличнойЧастиТоварыДокумента
		Возврат сткРезультат;
	КонецЕсли;
	
	НастройкаРеквизитаКоличество 	= ПараметрыЗаполнения.НастройкаТЧТовары.Элементы.Получить("qtty");
	НастройкаРеквизитаНоменклатура 	= ПараметрыЗаполнения.НастройкаТЧТовары.Элементы.Получить("id_good");
	НастройкаРеквизитаСерия 		= ПараметрыЗаполнения.НастройкаТЧТовары.Элементы.Получить("id_series");
	НастройкаРеквизитаХарактеристика = ПараметрыЗаполнения.НастройкаТЧТовары.Элементы.Получить("id_properties");
	НастройкаРеквизитаСклад 		= ПараметрыЗаполнения.НастройкаТЧТовары.Элементы.Получить("id_warehouse");
	
	Если Не ЗначениеЗаполнено(НастройкаРеквизитаНоменклатура) Или 
		Не ЗначениеЗаполнено(НастройкаРеквизитаСерия) Или
		Не ЗначениеЗаполнено(НастройкаРеквизитаКоличество) Или
		ЗначениеЗаполнено(ПараметрыЗаполнения.ТекущаяСтрокаДокумента[НастройкаРеквизитаСерия.Имя]) Тогда
		Возврат сткРезультат;
	КонецЕсли;
	
	ПараметрыОтбора = Новый Структура("id_good", ПараметрыЗаполнения.ТекущаяСтрокаДокумента[НастройкаРеквизитаНоменклатура.Имя]);
	
	Если ЗначениеЗаполнено(НастройкаРеквизитаХарактеристика) Тогда
		ПараметрыОтбора.Вставить("id_properties", 
			?(ЗначениеЗаполнено(ПараметрыЗаполнения.ТекущаяСтрокаДокумента[НастройкаРеквизитаХарактеристика.Имя]), ПараметрыЗаполнения.ТекущаяСтрокаДокумента[НастройкаРеквизитаХарактеристика.Имя], ""));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НастройкаРеквизитаСклад) Тогда
		ПараметрыОтбора.Вставить("id_warehouse", 
			?(ЗначениеЗаполнено(ПараметрыЗаполнения.ТекущаяСтрокаДокумента[НастройкаРеквизитаСклад.Имя]), ЗначениеЗаполнено(ПараметрыЗаполнения.ТекущаяСтрокаДокумента[НастройкаРеквизитаСклад.Имя]), ""));
	КонецЕсли;
	
	ПараметрыОтбора.Вставить("НомерСтроки", 0);
	
	СтрокиСерий = ПараметрыЗаполнения.ТаблицаСерийДокументаОбмена.НайтиСтроки(ПараметрыОтбора);
	
	КоличествоОстаток = ПараметрыЗаполнения.ТекущаяСтрокаДокументаОбмена.qtty;
	КоличествоПланОстаток = ПараметрыЗаполнения.ТекущаяСтрокаДокументаОбмена.qtty_plan;

	Для Индекс = 0 По СтрокиСерий.ВГраница() Цикл
		
		Если КоличествоОстаток = 0 Тогда
			Прервать;
		КонецЕсли;
		
		Количество = ?(ЗначениеЗаполнено(СтрокиСерий[Индекс].qtty), СтрокиСерий[Индекс].qtty, 1);
		КоличествоПлан = ?(СтрокиСерий.Количество() > 1, Количество, ПараметрыЗаполнения.ТекущаяСтрокаДокументаОбмена.qtty_plan);
		
		Если КоличествоОстаток >= Количество Тогда
			КоличествоОстаток = КоличествоОстаток - Количество;
		Иначе
			
			Количество = КоличествоОстаток;
			КоличествоОстаток = 0;
			
			КопияСтрокиСерии = ПараметрыЗаполнения.ТаблицаСерийДокументаОбмена.Добавить();
			ЗаполнитьЗначенияСвойств(КопияСтрокиСерии, СтрокиСерий[Индекс], , "sid,qtty");
			КопияСтрокиСерии.sid = Строка(Новый УникальныйИдентификатор());
			КопияСтрокиСерии.qtty = СтрокиСерий[Индекс].qtty - Количество;

			СтрокиСерий[Индекс].qtty = Количество;
			
		КонецЕсли;

		КоличествоПланОстаток = КоличествоПланОстаток - КоличествоПлан;

		Если Индекс = 0 Тогда
			СтрокаДокумента = ПараметрыЗаполнения.ТекущаяСтрокаДокумента;
			СтрокаДокументаОбмена = ПараметрыЗаполнения.ТекущаяСтрокаДокументаОбмена;
		Иначе
			
			СтрокаДокумента = ПараметрыЗаполнения.ТЧТоварыДокумента.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаДокумента, ПараметрыЗаполнения.ТекущаяСтрокаДокумента, , 
				"НомерСтроки," + НастройкаРеквизитаСерия.Имя + "," + НастройкаРеквизитаКоличество.Имя);
				
			СтрокаДокументаОбмена = ПараметрыЗаполнения.ТаблицаТоварыДокументаОбмена.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаДокументаОбмена, ПараметрыЗаполнения.ТекущаяСтрокаДокументаОбмена, , 
				"НомерСтроки, id_series, sid, qtty, qtty_plan");
				
			СтрокаДокументаОбмена.НомерСтроки = СтрокаДокумента.НомерСтроки;
			СтрокаДокументаОбмена.sid = Строка(Новый УникальныйИдентификатор());
			
			сткРезультат.НовыеСтроки.Добавить(СтрокаДокумента);
			
		КонецЕсли;
		
		СтрокаДокумента[НастройкаРеквизитаСерия.Имя] = СтрокиСерий[Индекс].id_series;
		СтрокаДокументаОбмена.id_series = СтрокиСерий[Индекс].id_series;
		
		СтрокаДокумента[НастройкаРеквизитаКоличество.Имя] = Количество;
		СтрокаДокументаОбмена.qtty = Количество;
		СтрокаДокументаОбмена.qtty_plan = КоличествоПлан;

		СтрокиСерий[Индекс].НомерСтроки = СтрокаДокумента.НомерСтроки;
		
		сткРезультат.СтрокаОбработана = Истина;
		
	КонецЦикла;
	
	Если КоличествоОстаток > 0 И сткРезультат.СтрокаОбработана Тогда
		
		СтрокаДокумента = ПараметрыЗаполнения.ТЧТоварыДокумента.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаДокумента, ПараметрыЗаполнения.ТекущаяСтрокаДокумента, , 
			"НомерСтроки," + НастройкаРеквизитаСерия.Имя + "," + НастройкаРеквизитаКоличество.Имя);
			
		СтрокаДокументаОбмена = ПараметрыЗаполнения.ТаблицаТоварыДокументаОбмена.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаДокументаОбмена, ПараметрыЗаполнения.ТекущаяСтрокаДокументаОбмена, , 
			"НомерСтроки, id_series, sid, qtty, qtty_plan");
			
		СтрокаДокументаОбмена.НомерСтроки = СтрокаДокумента.НомерСтроки;
		СтрокаДокументаОбмена.sid = Строка(Новый УникальныйИдентификатор());
		СтрокаДокументаОбмена.qtty_plan = КоличествоПланОстаток;
		
		сткРезультат.НовыеСтроки.Добавить(СтрокаДокумента);
		
		сткРезультат.СтрокаОбработана = Истина;
	
	Иначе
		
		Если КоличествоПланОстаток > 0 И сткРезультат.СтрокаОбработана Тогда
			
			СтрокаДокументаОбмена = ПараметрыЗаполнения.ТаблицаТоварыДокументаОбмена.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаДокументаОбмена, ПараметрыЗаполнения.ТекущаяСтрокаДокументаОбмена, , 
				"НомерСтроки, id_series, sid, qtty, qtty_plan");
			
			СтрокаДокументаОбмена.sid = Строка(Новый УникальныйИдентификатор());
			СтрокаДокументаОбмена.qtty_plan = КоличествоПланОстаток;
		
		КонецЕсли;
		
	КонецЕсли;

	Возврат сткРезультат;

КонецФункции

#КонецОбласти

Функция ПроверитьСтрокуТаблицыДокументаПередЗаписью(ДанныеСтроки, ТипТаблицы)
	
	Если Не СтроковыеФункцииКлиентСервер.ЭтоУникальныйИдентификатор(ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеСтроки, "sid", "")) Или
		Не СтроковыеФункцииКлиентСервер.ЭтоУникальныйИдентификатор(ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеСтроки, "sid_doc", "")) Тогда 
		Возврат Ложь;
	КонецЕсли;
	
	Если ТипТаблицы = Перечисления.SUI_ТипыТаблицДокументовОбмена.Товары Или 
		ТипТаблицы = Перечисления.SUI_ТипыТаблицДокументовОбмена.Отбор Или 
		ТипТаблицы = Перечисления.SUI_ТипыТаблицДокументовОбмена.Размещение Или
		ТипТаблицы = Перечисления.SUI_ТипыТаблицДокументовОбмена.Серии Тогда
		
		Если Не SUI_ИнтеграцияВКонфигурациюКлиентСервер.ЭтоИдентификаторSimple(ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеСтроки, "id_good", "")) Тогда
			Возврат Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТипТаблицы = Перечисления.SUI_ТипыТаблицДокументовОбмена.ШтрихкодыУпаковок Тогда
		
		Если Не ЗначениеЗаполнено(ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеСтроки, "id_marking_code", "")) Тогда 
			Возврат Ложь;			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Процедура ДобавитьПризнакИспользованияМаркировкиВПриемник(Приемник, Алгоритм, ПараметрыАлгоритма)
	
	Приемник.Вставить("use_mark", Обработки.SUI_РедакторКода.ВыполнитьКод(
		Алгоритм, ПараметрыАлгоритма, Истина));
							
КонецПроцедуры

Функция ПолучитьВыборкуТабличнойЧастиДокумента(ДокументСсылка, ИмяТабличнойЧасти)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Результат = Неопределено;
	
	РезультатЗапросаТЧ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, ИмяТабличнойЧасти);
	
	Если РезультатЗапросаТЧ <> Неопределено Тогда
		
		Результат = Новый Структура();
		Результат.Вставить("Колонки", SUI_ОбщегоНазначения.ПолучитьИменаКолонокРезультатаЗапроса(РезультатЗапросаТЧ));
		Результат.Вставить("Выборка", РезультатЗапросаТЧ.Выбрать());
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьАлгоритмИзКоллекции(КоллекцияАлгоритмов, Ключ)
	Возврат SUI_ОбщегоНазначенияКлиентСервер.ЗначениеСоответствия(КоллекцияАлгоритмов, Ключ, "", Тип("Строка"));
КонецФункции
	
Процедура ДобавитьСтатусУказанияСерийВПриемник(Приемник, Алгоритм, ПараметрыАлгоритма)
	
	Приемник.Вставить("use_series", Обработки.SUI_РедакторКода.ВыполнитьКод(
		Алгоритм, ПараметрыАлгоритма, Истина));
							
КонецПроцедуры

