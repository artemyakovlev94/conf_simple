		|	КОНЕЦ КАК additional_details,
		|	ВЫБОР
		|		КОГДА SUI_docs_tbl_series.sid ЕСТЬ NULL
		|		ИЛИ втТаблица.id_good <> SUI_docs_tbl_series.id_good
		|		ИЛИ втТаблица.id_properties <> SUI_docs_tbl_series.id_properties
		|		ИЛИ втТаблица.id_series <> SUI_docs_tbl_series.id_series
		|		ИЛИ втТаблица.id_warehouse <> SUI_docs_tbl_series.id_warehouse
		|		ИЛИ втТаблица.qtty <> SUI_docs_tbl_series.qtty
		|		ИЛИ втТаблица.СтатусОбработки <> SUI_docs_tbl_series.СтатусОбработки
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ Записывать
		|ПОМЕСТИТЬ втФильтр
		|ИЗ
		|	втТаблица КАК втТаблица
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.SUI_docs_tbl_series КАК SUI_docs_tbl_series
		|		ПО втТаблица.sid = SUI_docs_tbl_series.sid
		|		И втТаблица.sid_doc = SUI_docs_tbl_series.sid_doc
		|ГДЕ
		|	втТаблица.sid ПОДОБНО &ШаблонУникальногоИдентификатора
		|	И втТаблица.sid_doc ПОДОБНО &ШаблонУникальногоИдентификатора
		|	И втТаблица.id_good ПОДОБНО &ШаблонИдентификатораSimple
		|	И ВЫБОР
		|		КОГДА втТаблица.id_properties <> """"
		|			ТОГДА втТаблица.id_properties ПОДОБНО &ШаблонИдентификатораSimple
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ
		|	И ВЫБОР
		|		КОГДА втТаблица.id_series <> """"
		|			ТОГДА втТаблица.id_series ПОДОБНО &ШаблонИдентификатораSimple
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ
		|	И ВЫБОР
		|		КОГДА втТаблица.id_warehouse <> """"
		|			ТОГДА втТаблица.id_warehouse ПОДОБНО &ШаблонИдентификатораSimple
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ втТаблица
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втФильтр.sid,
		|	втФильтр.sid_doc,
		|	втФильтр.id_good,
		|	втФильтр.id_properties,
		|	втФильтр.id_series,
		|	втФильтр.id_warehouse,
		|	втФильтр.qtty,
		|	втФильтр.СтатусОбработки,
		|	втФильтр.name,
		|	втФильтр.number,
		|	втФильтр.production_date,
		|	втФильтр.best_before,
		|	втФильтр.additional_details
		|ИЗ
		|	втФильтр КАК втФильтр
		|ГДЕ
		|	втФильтр.Записывать
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ втФильтр";
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если Не РезультатЗапроса.Пустой() Тогда
			
			Выборка = РезультатЗапроса.Выбрать();
			
			Пока Выборка.Следующий() Цикл
				
				НаборЗаписей = РегистрыСведений.SUI_docs_tbl_series.СоздатьНаборЗаписей();
				НаборЗаписей.Отбор.sid.Установить(Выборка.sid);
				НаборЗаписей.Отбор.sid_doc.Установить(Выборка.sid_doc);
			
				Если Выборка.СтатусОбработки = Перечисления.SUI_СтатусыОбработкиСтрок.ОбработкаНеТребуется Тогда
					ЗаполнитьЗначенияСвойств(НаборЗаписей.Добавить(), Выборка, , "name,number,production_date,best_before");
				Иначе
					ЗаполнитьЗначенияСвойств(НаборЗаписей.Добавить(), Выборка);
				КонецЕсли;

				НаборЗаписей.ДополнительныеСвойства.Вставить("ОтключитьМеханизмРегистрацииОбъектов");
				НаборЗаписей.Записать(Истина);
			
			КонецЦикла;
			
			ЗаписьВыполнена = Истина;

		КонецЕсли;

		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		SUI_ЖурналРегистрации.ЗаписьВЖурналРегистрации(ИмяСобытия(НСтр("ru = 'Серии'")), , 
			Метаданные.ОбщиеМодули.SUI_ДокументыОбмена, , ИнформацияОбОшибке());
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Возникла исключительная ошибка при записи данных серий документа обмена
			|%1'"), ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

Процедура ЗаписатьДанныеДокументаОбмена_ПотокШтрихкодов(Таблица, ЗаписьВыполнена = Ложь)
	
	Если Таблица.Количество() = 0 Тогда
		Возврат;	
	КонецЕсли;

	ПериодЗаписи = ТекущаяДатаСеанса();

	НачатьТранзакцию();
	
	Попытка
		
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.SUI_docs_tbl_barcode_flow");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Разделяемый;
		ЭлементБлокировки.ИсточникДанных = Таблица;
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("sid", "sid");
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("sid_doc", "sid_doc");
		Блокировка.Заблокировать();
				
		Если Константы.SUI_ЗамещатьВПотокеШтрихкодов.Получить() Тогда

			Для Каждого СтрокаТаблицы Из Таблица Цикл
				
				НаборЗаписей = РегистрыСведений.SUI_docs_tbl_barcode_flow.СоздатьНаборЗаписей();
				НаборЗаписей.Отбор.sid.Установить(СтрокаТаблицы.sid);
				НаборЗаписей.Отбор.sid_doc.Установить(СтрокаТаблицы.sid_doc);
				Запись = НаборЗаписей.Добавить();
				ЗаполнитьЗначенияСвойств(Запись, СтрокаТаблицы);
				Запись.Период = ПериодЗаписи;
				НаборЗаписей.Записать(Истина);
				
			КонецЦикла;
			
		Иначе
			
			Для Каждого СтрокаТаблицы Из Таблица Цикл
				
				МенеджерЗаписи = РегистрыСведений.SUI_docs_tbl_barcode_flow.СоздатьМенеджерЗаписи();
				ЗаполнитьЗначенияСвойств(МенеджерЗаписи, СтрокаТаблицы);
				МенеджерЗаписи.Период = ПериодЗаписи;
				МенеджерЗаписи.Записать();
				
			КонецЦикла;
		
		КонецЕсли;
		
		ЗаписьВыполнена = Истина;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		SUI_ЖурналРегистрации.ЗаписьВЖурналРегистрации(ИмяСобытия(НСтр("ru = 'Поток штрихкодов'")), , 
			Метаданные.ОбщиеМодули.SUI_ДокументыОбмена, , ИнформацияОбОшибке());
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Возникла исключительная ошибка при записи данных потока штрихкодов документа обмена
			|%1'"), ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

Процедура ЗаписатьДанныеДокументаОбмена_ПересчетТоваров(Таблица, ЗаписьВыполнена = Ложь, Перезаписать = Ложь)
	
	Если Таблица.Количество() = 0 Тогда
		Возврат;	
	КонецЕсли;
	
	Если Не SUI_НастройкиМетаданныхСервер.ТаблицаИспользуется(Перечисления.SUI_ТаблицыИнтеграции.Номенклатура) Тогда
		Возврат;
	КонецЕсли;

	ПериодЗаписи = ТекущаяДатаСеанса();
	
	Попытка
		
		// Очистить таблицу пересчета
		Если Перезаписать Тогда
		
			НачатьТранзакцию();
			
			Попытка
	
				ТаблицаКопия = Таблица.Скопировать(, "sid_doc,МобильноеУстройство");
				ТаблицаКопия.Свернуть("sid_doc,МобильноеУстройство");
				
				Блокировка = Новый БлокировкаДанных;
				ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.SUI_docs_tbl_goods_delta");
				ЭлементБлокировки.Режим = РежимБлокировкиДанных.Разделяемый;
				ЭлементБлокировки.ИсточникДанных = ТаблицаКопия;
				ЭлементБлокировки.ИспользоватьИзИсточникаДанных("sid_doc", "sid_doc");
				ЭлементБлокировки.ИспользоватьИзИсточникаДанных("МобильноеУстройство", "МобильноеУстройство");
				Блокировка.Заблокировать();
				
				Для Каждого СтрокаТаблицыКопии Из ТаблицаКопия Цикл
					
					НаборЗаписей = РегистрыСведений.SUI_docs_tbl_goods_delta.СоздатьНаборЗаписей();
					НаборЗаписей.Отбор.sid_doc.Установить(СтрокаТаблицыКопии.sid_doc);
					НаборЗаписей.Отбор.МобильноеУстройство.Установить(СтрокаТаблицыКопии.МобильноеУстройство); 
					НаборЗаписей.Записать(Истина);
				
				КонецЦикла;
	
				ЗафиксироватьТранзакцию();
				
			Исключение
				ОтменитьТранзакцию();
				ВызватьИсключение;
			КонецПопытки;
		
		КонецЕсли;
		
		// Выполнить запись в таблицу пересчета
		НачатьТранзакцию();
		
		Попытка
	
			Для Каждого СтрокаТаблицы Из Таблица Цикл
				
				МенеджерЗаписи = РегистрыСведений.SUI_docs_tbl_goods_delta.СоздатьМенеджерЗаписи();
				ЗаполнитьЗначенияСвойств(МенеджерЗаписи, СтрокаТаблицы);
				МенеджерЗаписи.Период = ПериодЗаписи;
				МенеджерЗаписи.Записать();
				
			КонецЦикла;
			
			ЗаписьВыполнена = Истина;
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
		
	Исключение
		SUI_ЖурналРегистрации.ЗаписьВЖурналРегистрации(ИмяСобытия(НСтр("ru = 'Пересчет товаров'")), , 
			Метаданные.ОбщиеМодули.SUI_ДокументыОбмена, , ИнформацияОбОшибке());
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура УдалитьСвязанныеДанныеДокументаОбмена(НаборыЗаписей)

	НачатьТранзакцию();
	
	Попытка
		
		НЗ_Товары = РегистрыСведений.SUI_docs_tbl_goods.СоздатьНаборЗаписей();
		НЗ_ПересчетТоваров = РегистрыСведений.SUI_docs_tbl_goods_delta.СоздатьНаборЗаписей();
		НЗ_Серии = РегистрыСведений.SUI_docs_tbl_series.СоздатьНаборЗаписей();
		НЗ_ШтрихкодыУпаковок = РегистрыСведений.SUI_docs_tbl_barcodes.СоздатьНаборЗаписей();
		НЗ_ПотокШтрихкодов = РегистрыСведений.SUI_docs_tbl_barcode_flow.СоздатьНаборЗаписей();
		
		Если ЗначениеЗаполнено(НаборыЗаписей) Тогда
	
			Для Каждого НаборЗаписей Из НаборыЗаписей Цикл
				
				НЗ_Товары.Отбор.sid_doc.Установить(НаборЗаписей.Отбор.sid.Значение);
				НЗ_Товары.Записать(Истина);
				
				НЗ_ПересчетТоваров.Отбор.sid_doc.Установить(НаборЗаписей.Отбор.sid.Значение);
				НЗ_ПересчетТоваров.Записать(Истина);
				
				НЗ_Серии.Отбор.sid_doc.Установить(НаборЗаписей.Отбор.sid.Значение);
				НЗ_Серии.Записать(Истина);
				
				НЗ_ШтрихкодыУпаковок.Отбор.sid_doc.Установить(НаборЗаписей.Отбор.sid.Значение);
				НЗ_ШтрихкодыУпаковок.Записать(Истина);
				
				НЗ_ПотокШтрихкодов.Отбор.sid_doc.Установить(НаборЗаписей.Отбор.sid.Значение);
				НЗ_ПотокШтрихкодов.Записать(Истина);
		
			КонецЦикла;
			
		Иначе
			
			НЗ_Товары.Записать(Истина);
			НЗ_ПересчетТоваров.Записать(Истина);
			НЗ_Серии.Записать(Истина);
			НЗ_ШтрихкодыУпаковок.Записать(Истина);
			НЗ_ПотокШтрихкодов.Записать(Истина);
		
		КонецЕсли;

		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		SUI_ЖурналРегистрации.ЗаписьВЖурналРегистрации(ИмяСобытия(), , 
			Метаданные.ОбщиеМодули.SUI_ДокументыОбмена, , ИнформацияОбОшибке());
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Возникла исключительная ошибка при удалении данных документов обмена
			|%1'"), ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

Функция ПредставлениеКолонкиТаблицы(Знач ИмяКолонки)
	
	ИмяКолонки = НРег(ИмяКолонки);
	
	Если ИмяКолонки = "id_good" Тогда
		Возврат "Номенклатура";
	ИначеЕсли ИмяКолонки = "id_properties" Или ИмяКолонки = "id_property" Тогда
		Возврат "Характеристика";    
	ИначеЕсли ИмяКолонки = "id_series" Тогда
		Возврат "Серия";
	ИначеЕсли ИмяКолонки = "id_unit" Тогда
		Возврат "Упаковка";
	ИначеЕсли ИмяКолонки = "id_cell" Тогда
		Возврат "Ячейка";
	ИначеЕсли ИмяКолонки = "id_price" Тогда
		Возврат "Вид цены";
	ИначеЕсли ИмяКолонки = "price" Тогда
		Возврат "Цена";
	ИначеЕсли ИмяКолонки = "qtty" Тогда
		Возврат "Количество (факт)";
	ИначеЕсли ИмяКолонки = "qtty_plan" Тогда
		Возврат "Количество (план)";
	ИначеЕсли ИмяКолонки = "датаобновления" Тогда
		Возврат "Дата обновления"; 
	ИначеЕсли ИмяКолонки = "id_marking_code" Тогда
		Возврат "Штрихкод упаковки";
	ИначеЕсли ИмяКолонки = "mark_code" Тогда
		Возврат "Значение штрихкода упаковки";
	ИначеЕсли ИмяКолонки = "barcode" Тогда
		Возврат "Штрихкод";
	ИначеЕсли ИмяКолонки = "id_warehouse" Тогда
		Возврат "Склад";
	Иначе
		Возврат ИмяКолонки;
	КонецЕсли;
	
КонецФункции

Функция СформироватьПараметрыОтбора(НастройкиРеквизитовТЧ, СтрокаДанных, СписокКлючей = "", ИсключитьКлючи = "")
	
	ПараметрыОтбора = Новый Структура();
	
	Ключи = СтрРазделить(СписокКлючей, ",");
	ИсключаяКлючи = СтрРазделить(ИсключитьКлючи, ",");
	
	Для Каждого НастройкаРеквизитаТЧ Из НастройкиРеквизитовТЧ Цикл
		
		Если Не ЗначениеЗаполнено(НастройкаРеквизитаТЧ.Значение) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Ключи) И Ключи.Найти(НастройкаРеквизитаТЧ.Ключ) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ИсключаяКлючи) И ИсключаяКлючи.Найти(НастройкаРеквизитаТЧ.Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если НастройкаРеквизитаТЧ.Значение.Имя = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаДанных.Владелец().Колонки.Найти(НастройкаРеквизитаТЧ.Ключ) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ПараметрыОтбора.Вставить(НастройкаРеквизитаТЧ.Значение.Имя, НастройкаРеквизитаТЧ.Значение.Тип.ПривестиЗначение(
			СтрокаДанных[НастройкаРеквизитаТЧ.Ключ]));
		
	КонецЦикла;
	
	Возврат ПараметрыОтбора;
	
КонецФункции

Функция ДанныеДокументаКЗагрузкеВДокументОбмена(Знач Документ, Таблицы, БезТаблиц = Ложь)
	
	ДанныеДокументов = Новый Массив();
	
	Документ = ИдентификаторДокументаПоПараметру(Документ, "ДанныеДокументаКЗагрузкеВДокументОбмена");

	Запрос = Новый Запрос;
	
	Если Документ.Свойство("ID") Тогда
		Запрос.УстановитьПараметр("id_doc", Документ.ID);
		Запрос.УстановитьПараметр("sid", Неопределено);
	ИначеЕсли Документ.Свойство("SID") Тогда 
		Запрос.УстановитьПараметр("sid", Документ.SID);
		Запрос.УстановитьПараметр("id_doc", Неопределено);
	Иначе
		Возврат ДанныеДокументов;
	КонецЕсли;

	Запрос.Текст =
		"ВЫБРАТЬ
		|	SUI_docs.sid,
		|	SUI_docs.id_doc,
		|	SUI_docs.НастройкаДокумента,
		|	SUI_docs.doc_date,
		|	SUI_docs.doc_n,
		|	SUI_docs.doc_type,
		|	SUI_docs.id_countragents,
		|	SUI_docs.id_warehouse,
		|	SUI_docs.КонтролироватьДокумент,
		|	SUI_docs.ЭтоДокументАдресногоХранения,
		|	SUI_docs.Состояние,
		|	SUI_docs.МобильноеУстройство
		|ИЗ
		|	РегистрСведений.SUI_docs КАК SUI_docs
		|ГДЕ
		|	ВЫБОР
		|		КОГДА &sid <> НЕОПРЕДЕЛЕНО
		|			ТОГДА SUI_docs.sid = &sid
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ
