Процедура ЗаписатьСопоставлениеПотокаШтрихкодов(ПараметрыЗаписи, Адрес) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаСопоставления", ПараметрыЗаписи.ТаблицаСопоставления);
	Запрос.УстановитьПараметр("sid_doc", ПараметрыЗаписи.sid_doc);
	Запрос.УстановитьПараметр("ПолученныеЗаписи", ПараметрыЗаписи.ПолученныеЗаписи);
	Запрос.Текст =
		"ВЫБРАТЬ
		|	&sid_doc КАК sid_doc,
		|	*
		|ПОМЕСТИТЬ втТаблицаСопоставления
		|ИЗ
		|	&ТаблицаСопоставления КАК ТаблицаСопоставления
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	sid_doc,
		|	Штрихкод
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	*
		|ИЗ
		|	втТаблицаСопоставления КАК втТаблицаСопоставления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	SUI_docs_tbl_barcode_flow.Период,
		|	SUI_docs_tbl_barcode_flow.sid,
		|	SUI_docs_tbl_barcode_flow.sid_doc
		|ИЗ
		|	РегистрСведений.SUI_docs_tbl_barcode_flow КАК SUI_docs_tbl_barcode_flow
		|		#ТекстСоединенияТаблиц
		|ГДЕ
		|	SUI_docs_tbl_barcode_flow.sid_doc = &sid_doc
		|	И SUI_docs_tbl_barcode_flow.sid В (&ПолученныеЗаписи)";
	
	Если ПараметрыЗаписи.УдалятьНеСопоставленные Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "#ТекстСоединенияТаблиц", "");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "#ТекстСоединенияТаблиц", "
		|ВНУТРЕННЕЕ СОЕДИНЕНИЕ втТаблицаСопоставления КАК втТаблицаСопоставления
		|		ПО SUI_docs_tbl_barcode_flow.barcode = втТаблицаСопоставления.Штрихкод");
	КонецЕсли;
	
	НачатьТранзакцию();
	
	Попытка
		
		РезультатыЗапроса = Запрос.ВыполнитьПакет();
		
		Если Не РезультатыЗапроса[2].Пустой() Тогда
			
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.SUI_docs_tbl_barcode_flow");
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Разделяемый;
			ЭлементБлокировки.ИсточникДанных = РезультатыЗапроса[2];
			ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Период", "Период");
			ЭлементБлокировки.ИспользоватьИзИсточникаДанных("sid", "sid");
			ЭлементБлокировки.ИспользоватьИзИсточникаДанных("sid_doc", "sid_doc");
			Блокировка.Заблокировать();
			
			Выборка = РезультатыЗапроса[2].Выбрать();
			
			Пока Выборка.Следующий() Цикл
				
				НаборЗаписей = РегистрыСведений.SUI_docs_tbl_barcode_flow.СоздатьНаборЗаписей();
				НаборЗаписей.Отбор.Период.Установить(Выборка.Период);
				НаборЗаписей.Отбор.sid.Установить(Выборка.sid);
				НаборЗаписей.Отбор.sid_doc.Установить(Выборка.sid_doc);
				
				НаборЗаписей.ДополнительныеСвойства.Вставить("SUI_ОтключитьПодписку");
				НаборЗаписей.ДополнительныеСвойства.Вставить("ОтключитьМеханизмРегистрацииОбъектов");
				
				НаборЗаписей.Записать(Истина);
				
			КонецЦикла;
			
		КонецЕсли;
		
		Если Не РезультатыЗапроса[1].Пустой() Тогда
			
			ХарактеристикиИспользуются = SUI_НастройкиМетаданныхСервер.ТаблицаИспользуется(Перечисления.SUI_ТаблицыИнтеграции.ХарактеристикиНоменклатуры);
			УпаковкиИспользуются = SUI_НастройкиМетаданныхСервер.ТаблицаИспользуется(Перечисления.SUI_ТаблицыИнтеграции.УпаковкиНоменклатуры);
			
			ТаблицаДляЗаписи = ТаблицаТоварыДокументаОбмена();
			
			Выборка = РезультатыЗапроса[1].Выбрать();
			
			Пока Выборка.Следующий() Цикл
				
				Если ХарактеристикиИспользуются Тогда
					Характеристика = Выборка.Характеристика;
				Иначе
					Характеристика = Неопределено;
				КонецЕсли;
				
				Если УпаковкиИспользуются Тогда
					Упаковка = Выборка.Упаковка;	
				Иначе
					Упаковка = Неопределено;
				КонецЕсли;
					
				Если Выборка.Записывать Тогда
					
					РезультатСозданияШК = SUI_ШтрихкодыНоменклатуры.СоздатьШтрихкодНоменклатуры(
						ПараметрыЗаписи.АлгоритмСозданияШтрихкодаНоменклатуры, 
						Выборка.Штрихкод, 
						Выборка.Номенклатура, 
						Характеристика, 
						Упаковка);
					
					Если Не РезультатСозданияШК Тогда
						Продолжить;
					КонецЕсли;
				
				КонецЕсли;
				
				ДанныеЗаписиТоварыДокументаОбмена = Новый Структура();
				ДанныеЗаписиТоварыДокументаОбмена.Вставить("sid", 			Строка(Новый УникальныйИдентификатор()));
				ДанныеЗаписиТоварыДокументаОбмена.Вставить("sid_doc", 		ПараметрыЗаписи.sid_doc);	
				ДанныеЗаписиТоварыДокументаОбмена.Вставить("id_good", 		Выборка.Номенклатура);
				ДанныеЗаписиТоварыДокументаОбмена.Вставить("id_properties", Характеристика);
				ДанныеЗаписиТоварыДокументаОбмена.Вставить("id_unit", 		Упаковка);
				ДанныеЗаписиТоварыДокументаОбмена.Вставить("qtty", 			Выборка.Количество);
				ДанныеЗаписиТоварыДокументаОбмена.Вставить("ТипТаблицы", 	Перечисления.SUI_ТипыТаблицДокументовОбмена.Товары);
				
				SUI_ИнтеграцияВКонфигурацию.ПривестиСсылкиКИдентификаторамSimple(
					ДанныеЗаписиТоварыДокументаОбмена, "sid, sid_doc, qtty, ТипТаблицы");
					
				Если Не SUI_ИнтеграцияВКонфигурациюКлиентСервер.ЭтоИдентификаторSimple(ДанныеЗаписиТоварыДокументаОбмена.id_good) Тогда
					Продолжить;
				КонецЕсли;
				
				ЗаполнитьЗначенияСвойств(ТаблицаДляЗаписи.Добавить(), ДанныеЗаписиТоварыДокументаОбмена);
				
			КонецЦикла;
			
			ЗаписатьДанныеДокументаОбмена_Товары(ТаблицаДляЗаписи);
				
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
	Если ЭтоАдресВременногоХранилища(Адрес) Тогда
		ПоместитьВоВременноеХранилище(Истина, Адрес);
	КонецЕсли;
	
КонецПроцедуры

// Загрузить таблицы документа обмена в документ объект.
// 
// Параметры:
//  ДокументОбъект - ДокументОбъект - Документ объект в который необходимо загрузить
//  НастройкаДокумента - СправочникСсылка.SUI_НастройкиДокументов - Настройка документа обмена
//  ТаблицыДокументаОбмена - Соответствие из ТаблицаЗначений - Таблицы документа обмена
//  ТаблицаСерийБезНастройки - ТаблицаЗначений - Таблица серий из документа обмена без настройки ТЧ серии
Процедура ЗагрузитьТаблицыДокументаОбменаВДокументОбъект(ДокументОбъект, НастройкаДокумента, ТаблицыДокументаОбмена, ТаблицаСерийБезНастройки) Экспорт
	
	ОбщегоНазначенияКлиентСервер.Проверить(Не ДокументОбъект.Заблокирован(), СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Документ %1 заблокирован. Загрузка данных прервана.'"), ДокументОбъект.Ссылка));
	
	НастройкиДокумента = SUI_НастройкиДокументовСервер.СформироватьНастройкиДокумента(НастройкаДокумента);
	
	АлгоритмыТЧ = SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(НастройкиДокумента, 
		"ДополнительныеНастройки.АлгоритмыОбработкиСтрокТабличныхЧастей", Новый Соответствие(), Тип("Соответствие"));
	АлгоритмПередЗаписью = SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(НастройкиДокумента, 
		"ДополнительныеНастройки.ОбработчикиСобытий.ПередЗаписью", "", Тип("Строка"));

	Если ДокументОбъект.Метаданные() = Метаданные.Документы.SUI_СборШтрихкодов Тогда
		
		ТаблицаСборШК = ТаблицыДокументаОбмена.Получить(Перечисления.SUI_ТипыТаблицДокументовОбмена.ПотокШтрихкодов);
		
		Если ТаблицаСборШК <> Неопределено Тогда
			
			Запрос = Новый Запрос();
			Запрос.Текст = 
				"ВЫБРАТЬ
				|	Источник.Штрихкод,
				|	Источник.Количество
				|ПОМЕСТИТЬ втИсточник
				|ИЗ
				|	&ТаблицаИсточник КАК Источник
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	Приемник.Штрихкод,
				|	Приемник.Количество
				|ПОМЕСТИТЬ втПриемник
				|ИЗ
				|	&ТаблицаПриемник КАК Приемник
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	ЕСТЬNULL(втИсточник.Штрихкод, втПриемник.Штрихкод) КАК Штрихкод,
				|	ЕСТЬNULL(втИсточник.Количество, 0) + ЕСТЬNULL(втПриемник.Количество, 0) КАК Количество
				|ИЗ
				|	втИсточник КАК втИсточник
				|		ПОЛНОЕ СОЕДИНЕНИЕ втПриемник КАК втПриемник
				|		ПО втИсточник.Штрихкод = втПриемник.Штрихкод
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|УНИЧТОЖИТЬ втИсточник
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|УНИЧТОЖИТЬ втПриемник";
			
			Запрос.УстановитьПараметр("ТаблицаИсточник", ТаблицаСборШК);
			Запрос.УстановитьПараметр("ТаблицаПриемник", ДокументОбъект.Штрихкоды.Выгрузить());
			
			РезультатЗапроса = Запрос.Выполнить();
			
			ТаблицаСборШК = РезультатЗапроса.Выгрузить();
			
			ДокументОбъект.Штрихкоды.Загрузить(ТаблицаСборШК);
			
			ТаблицыДокументаОбмена.Вставить(Перечисления.SUI_ТипыТаблицДокументовОбмена.ПотокШтрихкодов, ТаблицаСборШК);
			
		КонецЕсли;
		
	Иначе
		
		// Загрузка таблицы Штрихкоды упаковок
		ЗагрузитьТаблицыДокументаОбменаВДокументОбъект_ШтрихкодыУпаковок(ДокументОбъект,
			ТаблицыДокументаОбмена.Получить(Перечисления.SUI_ТипыТаблицДокументовОбмена.ШтрихкодыУпаковок),
			НастройкиДокумента.ТабличныеЧасти.Получить(Перечисления.SUI_ТипыТаблицДокументовОбмена.ШтрихкодыУпаковок),
			АлгоритмыТЧ.Получить(Перечисления.SUI_ТипыТаблицДокументовОбмена.ШтрихкодыУпаковок));
		
		// Загрузка таблицы Серии
		ЗагрузитьТаблицыДокументаОбменаВДокументОбъект_Серии(ДокументОбъект,
			ТаблицыДокументаОбмена.Получить(Перечисления.SUI_ТипыТаблицДокументовОбмена.Серии),
			НастройкиДокумента.ТабличныеЧасти.Получить(Перечисления.SUI_ТипыТаблицДокументовОбмена.Серии),
			АлгоритмыТЧ.Получить(Перечисления.SUI_ТипыТаблицДокументовОбмена.Серии));
	
		// Загрузка таблицы Товары
		ЗагрузитьТаблицыДокументаОбменаВДокументОбъект_Товары(ДокументОбъект,
			ТаблицыДокументаОбмена.Получить(Перечисления.SUI_ТипыТаблицДокументовОбмена.Товары),
			НастройкиДокумента.ТабличныеЧасти.Получить(Перечисления.SUI_ТипыТаблицДокументовОбмена.Товары),
			НастройкиДокумента.ТабличныеЧасти.Получить(Перечисления.SUI_ТипыТаблицДокументовОбмена.Серии),
			АлгоритмыТЧ.Получить(Перечисления.SUI_ТипыТаблицДокументовОбмена.Товары),
			ТаблицаСерийБезНастройки);
		
		// Загрузка таблицы Отбор
		ЗагрузитьТаблицыДокументаОбменаВДокументОбъект_Товары(ДокументОбъект,
			ТаблицыДокументаОбмена.Получить(Перечисления.SUI_ТипыТаблицДокументовОбмена.Отбор),
			НастройкиДокумента.ТабличныеЧасти.Получить(Перечисления.SUI_ТипыТаблицДокументовОбмена.Отбор),
			НастройкиДокумента.ТабличныеЧасти.Получить(Перечисления.SUI_ТипыТаблицДокументовОбмена.Серии),
			АлгоритмыТЧ.Получить(Перечисления.SUI_ТипыТаблицДокументовОбмена.Отбор),
			ТаблицаСерийБезНастройки);
			
		// Загрузка таблицы Размещение
		ЗагрузитьТаблицыДокументаОбменаВДокументОбъект_Товары(ДокументОбъект,
			ТаблицыДокументаОбмена.Получить(Перечисления.SUI_ТипыТаблицДокументовОбмена.Размещение),
			НастройкиДокумента.ТабличныеЧасти.Получить(Перечисления.SUI_ТипыТаблицДокументовОбмена.Размещение),
			НастройкиДокумента.ТабличныеЧасти.Получить(Перечисления.SUI_ТипыТаблицДокументовОбмена.Серии),
			АлгоритмыТЧ.Получить(Перечисления.SUI_ТипыТаблицДокументовОбмена.Размещение),
			ТаблицаСерийБезНастройки);
			
	КонецЕсли;
	
	// Обновить данные в таблицах документа обмена после выполнения алгоритмов
	Для Каждого ТаблицаДокументаОбмена Из ТаблицыДокументаОбмена Цикл
		
		НастройкаТЧ = НастройкиДокумента.ТабличныеЧасти.Получить(ТаблицаДокументаОбмена.Ключ);
		
		Если Не ЗначениеЗаполнено(НастройкаТЧ) Тогда
			 Продолжить;
		КонецЕсли;
		
		Для Каждого СтрокаДокумента Из ДокументОбъект[НастройкаТЧ.ИмяТабличнойЧасти] Цикл
			
			СтрокиТаблицыДокументаОбмена = ТаблицаДокументаОбмена.Значение.НайтиСтроки(
				Новый Структура("НомерСтроки", СтрокаДокумента.НомерСтроки));
			
			Для Каждого СтрокаТаблицыДокументаОбмена Из СтрокиТаблицыДокументаОбмена Цикл
				
				Для Каждого РеквизитТЧ Из НастройкаТЧ.Элементы Цикл
					
					Если РеквизитТЧ.Ключ = "qtty_plan" Или Не ЗначениеЗаполнено(РеквизитТЧ.Значение) Тогда
						Продолжить;
					КонецЕсли;
					
					Если РеквизитТЧ.Значение.Имя = Неопределено И РеквизитТЧ.Значение.ПостоянноеЗначение <> Неопределено Тогда
						СтрокаТаблицыДокументаОбмена[РеквизитТЧ.Ключ] = РеквизитТЧ.Значение.ПостоянноеЗначение;
					ИначеЕсли РеквизитТЧ.Значение.Имя <> Неопределено Тогда 
						СтрокаТаблицыДокументаОбмена[РеквизитТЧ.Ключ] = СтрокаДокумента[РеквизитТЧ.Значение.Имя];
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;

КонецПроцедуры

Процедура ПолучитьШтрихкодыМаркировкиДокументаОбмена(Параметры, АдресРезультата) Экспорт
	
	ШтрихкодыМаркировки = Новый Массив();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ДокументыОбмена.sid КАК sid,
		|	ДокументыОбмена.id_doc КАК id_doc,
		|	ДокументыОбмена.НастройкаДокумента КАК НастройкаДокумента
		|ПОМЕСТИТЬ втДокументыОбмена
		|ИЗ
		|	РегистрСведений.SUI_docs КАК ДокументыОбмена
		|ГДЕ
		|	ДокументыОбмена.id_doc = &ИдентификаторДокумента
		|	И ВЫБОР
		|		КОГДА &НастройкаДокумента = НЕОПРЕДЕЛЕНО
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ДокументыОбмена.НастройкаДокумента = &НастройкаДокумента
		|	КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДанныеШтрихкодов.Количество КАК Количество,
		|	ДанныеШтрихкодов.ФорматBase64 КАК ФорматBase64,
		|	ДанныеШтрихкодов.Штрихкод КАК Штрихкод,
		|	ДанныеШтрихкодов.ШтрихкодМаркиАлкогольнойПродукции КАК ШтрихкодМаркиАлкогольнойПродукции,
		|	ДанныеШтрихкодов.ШтрихкодУпаковки КАК ШтрихкодУпаковки
		|ИЗ
		|	(ВЫБРАТЬ
		|		1 КАК Количество,
		|		ВЫБОР
		|			КОГДА ШтрихкодыДокументаОбмена.ШтрихкодBase64 <> """"
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ КАК ФорматBase64,
		|		ВЫБОР
		|			КОГДА ШтрихкодыДокументаОбмена.ШтрихкодBase64 <> """"
		|				ТОГДА ШтрихкодыДокументаОбмена.ШтрихкодBase64
		|			КОГДА ШтрихкодыДокументаОбмена.barcode_from_scanner <> """"
		|				ТОГДА ШтрихкодыДокументаОбмена.barcode_from_scanner
		|			ИНАЧЕ ШтрихкодыДокументаОбмена.mark_code
		|		КОНЕЦ КАК Штрихкод,
		|		"""" КАК ШтрихкодМаркиАлкогольнойПродукции,
		|		ВЫБОР
		|			КОГДА ШтрихкодыДокументаОбмена.ШтрихкодBase64 <> """"
		|				ТОГДА ШтрихкодыДокументаОбмена.SSCCBase64
		|			ИНАЧЕ ШтрихкодыДокументаОбмена.SSCC
		|		КОНЕЦ КАК ШтрихкодУпаковки
		|	ИЗ
		|		втДокументыОбмена КАК втДокументыОбмена
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.SUI_docs_tbl_barcodes КАК ШтрихкодыДокументаОбмена
		|			ПО втДокументыОбмена.sid = ШтрихкодыДокументаОбмена.sid_doc
		|			И ВЫБОР
		|				КОГДА ШтрихкодыДокументаОбмена.mark_code <> """"
		|				ИЛИ ШтрихкодыДокументаОбмена.barcode_from_scanner <> """"
		|				ИЛИ ШтрихкодыДокументаОбмена.ШтрихкодBase64 <> """"
		|					ТОГДА ИСТИНА
		|				ИНАЧЕ ЛОЖЬ
		|			КОНЕЦ
		|
		|	ОБЪЕДИНИТЬ ВСЕ
		|
		|	ВЫБРАТЬ
		|		1,
		|		ИСТИНА,
		|		ПотокШтрихкодов.ШтрихкодBase64,
		|		"""",
		|		""""
		|	ИЗ
		|		втДокументыОбмена КАК втДокументыОбмена
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.SUI_docs_tbl_barcode_flow КАК ПотокШтрихкодов
		|			ПО втДокументыОбмена.sid = ПотокШтрихкодов.sid_doc
		|			И (ПотокШтрихкодов.ЭтоШтрихкодКМ
		|			ИЛИ ПотокШтрихкодов.ЭтоШтрихкодSSCC)
		|	СГРУППИРОВАТЬ ПО
		|		ПотокШтрихкодов.ШтрихкодBase64) КАК ДанныеШтрихкодов
		|ГДЕ
		|	ДанныеШтрихкодов.Штрихкод <> """"
		|	ИЛИ ДанныеШтрихкодов.ШтрихкодУпаковки <> """"";
	
	Запрос.УстановитьПараметр("ИдентификаторДокумента", SUI_ИнтеграцияВКонфигурацию.ИдентификаторSimpleПоСсылке(
		Параметры.ДокументСсылка));
	Запрос.УстановитьПараметр("НастройкаДокумента", Параметры.НастройкаДокумента);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			ШтрихкодыМаркировки.Добавить(ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(Выборка));
		КонецЦикла;
		
	КонецЕсли;
	
	ПоместитьВоВременноеХранилище(ШтрихкодыМаркировки, АдресРезультата);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Процедура ПриДобавленииРегламентныхЗаданийПодсистемы(РегламентныеЗаданияПодсистемы) Экспорт
	
	РегламентноеЗаданиеПодсистемы = РегламентныеЗаданияПодсистемы.Добавить();
	РегламентноеЗаданиеПодсистемы.Ключ = SUI_ДокументыОбменаКлиентСервер.КлючиРегламентныхЗаданий().ВыполнитьОчисткуОбработанныхДокументов;
	РегламентноеЗаданиеПодсистемы.Наименование = НСтр("ru = 'Simple: Очистка обработанных документов'");
	РегламентноеЗаданиеПодсистемы.ИмяМетода = "SUI_ДокументыОбмена.ВыполнитьОчисткуОбработанныхДокументов";
	РегламентноеЗаданиеПодсистемы.КоличествоПовторовПриАварийномЗавершении = 1;
	РегламентноеЗаданиеПодсистемы.ИнтервалПовтораПриАварийномЗавершении = 60;
	РегламентноеЗаданиеПодсистемы.Расписание.ПериодПовтораДней = 1;
	
КонецПроцедуры

//@skip-check query-in-loop
Процедура ВыполнитьОчисткуОбработанныхДокументов() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	ДниХранения = Константы.SUI_ХранениеОбработанныхДокументовОбмена.Получить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Если ДниХранения = 0 Тогда
		Возврат;
	КонецЕсли;

	SUI_ЖурналРегистрации.ЗаписьВЖурналРегистрации(ИмяСобытия(НСтр("ru = 'Удаление'")), УровеньЖурналаРегистрации.Примечание, 
		Метаданные.ОбщиеМодули.SUI_ДокументыОбмена, , НСтр("ru = 'Начало удаления завершенных документов обмена'"));
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 100
		|	SUI_docs.id_doc КАК id_doc
		|ИЗ
		|	РегистрСведений.SUI_docs КАК SUI_docs
		|ГДЕ
		|	SUI_docs.ДатаОбновления < &ДатаНачалаЗаписей";
	
	Запрос.УстановитьПараметр("ДатаНачалаЗаписей", ТекущаяДатаСеанса() - 86400 * ДниХранения);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Пока Не РезультатЗапроса.Пустой() Цикл
		УдалитьДокументыОбмена(РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("id_doc"));
		РезультатЗапроса = Запрос.Выполнить();
	КонецЦикла;
	
	SUI_ЖурналРегистрации.ЗаписьВЖурналРегистрации(ИмяСобытия(НСтр("ru = 'Удаление'")), УровеньЖурналаРегистрации.Примечание, 
		Метаданные.ОбщиеМодули.SUI_ДокументыОбмена, , НСтр("ru = 'Завершение удаления завершенных документов обмена'"));
	
КонецПроцедуры 

#Область Задания

Процедура ЗапуститьЗаданияПослеЗаписиДокументаОбмена(ВыполняемыеЗадания, АдресРезультата = Неопределено) Экспорт
	
	Если ВыполняемыеЗадания.Найти("СоздатьСерииНоменклатуры") <> Неопределено Тогда
		
		Попытка
			ЗаданиеСоздатьСерииНоменклатурыДокументаОбмена(Новый Структура());
		Исключение
			SUI_ЖурналРегистрации.ЗаписьВЖурналРегистрации(ИмяСобытияЗадание(), ,
				Метаданные.ОбщиеМодули.SUI_ДокументыОбмена, , ИнформацияОбОшибке());	
		КонецПопытки;
		
	КонецЕсли;
	
	Если ВыполняемыеЗадания.Найти("СоздатьШтрихкодыУпаковок") <> Неопределено Тогда
		
		Попытка
			ЗаданиеСоздатьШтрихкодыУпаковокДокументаОбмена(Новый Структура());
		Исключение
			SUI_ЖурналРегистрации.ЗаписьВЖурналРегистрации(ИмяСобытияЗадание(), ,
				Метаданные.ОбщиеМодули.SUI_ДокументыОбмена, , ИнформацияОбОшибке());	
		КонецПопытки;
		
	КонецЕсли;
	
	Если ВыполняемыеЗадания.Найти("ЗагрузитьИтогиПересчетаВДокументОбмена") <> Неопределено Тогда
		
		Попытка
			ЗаданиеЗагрузитьИтогиПересчетаВДокументОбмена(Новый Структура());
		Исключение
			SUI_ЖурналРегистрации.ЗаписьВЖурналРегистрации(ИмяСобытияЗадание(), ,
				Метаданные.ОбщиеМодули.SUI_ДокументыОбмена, , ИнформацияОбОшибке());	
		КонецПопытки;
		
	КонецЕсли;

КонецПроцедуры

Процедура ЗаданиеСоздатьСерииНоменклатурыДокументаОбмена(Параметры, АдресРезультата = Неопределено) Экспорт
	
	ОбработкаВыполнена = Ложь;
	
	// Оценка производительности
	ОценкаПроизводительности_НачалоЗамера = SUI_ОценкаПроизводительности.НачатьЗамерВремени();
	ОценкаПроизводительности_ВесЗамера = 0;
	ОценкаПроизводительности_КлючеваяОперация = "ЗаданиеСоздатьСерииНоменклатурыДокументаОбмена";
	
	Если Не SUI_НастройкиМетаданныхСервер.ТаблицаИспользуется(Перечисления.SUI_ТаблицыИнтеграции.Номенклатура) Или
		Не SUI_НастройкиМетаданныхСервер.ТаблицаИспользуется(Перечисления.SUI_ТаблицыИнтеграции.СерииНоменклатуры) Тогда
		Возврат;
	КонецЕсли;
	
	АлгоритмСоздания = SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(
		SUI_НастройкиМетаданныхСервер.ПолучитьДополнительныеНастройки(Перечисления.SUI_ТаблицыИнтеграции.СерииНоменклатуры), 
		"АлгоритмСозданияСерииНоменклатуры.Алгоритм", "", Тип("Строка"));
	
	Если ПустаяСтрока(АлгоритмСоздания) Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Отсутствует алгоритм создания серий номенклатуры.
		|Создание серий номенклатуры было пропущено.'"));
		Возврат;
	КонецЕсли;
	
	ТипыРеквизитов = SUI_ОбщегоНазначенияКлиентСервер.МассивЗначений(
		Перечисления.SUI_ТаблицыИнтеграции.Номенклатура,
		Перечисления.SUI_ТаблицыИнтеграции.СерииНоменклатуры);
	
	ПараметрыПолученияНастроек = РегистрыСведений.SUI_НастройкиТаблицИнтеграции.ПараметрыПолученияНастроек(ТипыРеквизитов);	
	ПараметрыПолученияНастроек.ОсновнойОбъект = Истина;
	
	НастройкиТаблиц = РегистрыСведений.SUI_НастройкиТаблицИнтеграции.ПолучитьНастройки(ПараметрыПолученияНастроек);
	
	Ошибки = Новый Массив();
	
	Для индекс = 0 По ТипыРеквизитов.ВГраница() Цикл
		
		ТаблицаИнтеграции = ТипыРеквизитов[индекс];
		ТипыРеквизитов[индекс] = Неопределено;
		
		СтрокаНастройки = НастройкиТаблиц.Найти(ТаблицаИнтеграции, "ТаблицаИнтеграции");
		
		Если СтрокаНастройки = Неопределено Тогда
			Ошибки.Добавить(СтрШаблон(НСтр("ru = 'Отсутствует настройка для таблицы %1.'"), ТаблицаИнтеграции));
			Продолжить;
		КонецЕсли;
		
		Компоновщик = Новый КомпоновщикНастроекКомпоновкиДанных();
		SUI_КомпоновкаДанныхСервер.ИнициализироватьКомпоновщикНастроек(Компоновщик,
			СтрокаНастройки.СхемаКомпоновкиДанных,
			СтрокаНастройки.НастройкиКомпоновкиДанных);
		
		СтрокаНастройки.НастройкиКомпоновкиДанных = Компоновщик.ПолучитьНастройки();
		
		ПолеНайдено = Ложь;
		Для Каждого ЭлементВыбора Из СтрокаНастройки.НастройкиКомпоновкиДанных.Выбор.Элементы Цикл
			
			Если ЭлементВыбора.Использование И ЭлементВыбора.Заголовок = "id" Тогда
				
				ДоступноеПоле = СтрокаНастройки.НастройкиКомпоновкиДанных.Выбор.ДоступныеПоляВыбора
					.НайтиПоле(ЭлементВыбора.Поле);
				
				Если ДоступноеПоле <> Неопределено Тогда
					ТипыРеквизитов[индекс] = ДоступноеПоле.ТипЗначения;
					ПолеНайдено = Истина;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если Не ПолеНайдено Тогда
			Ошибки.Добавить(СтрШаблон(НСтр("ru = 'Не настроен реквизит id для таблицы %1.'"), ТаблицаИнтеграции));
		КонецЕсли;
		
	КонецЦикла;
	
	Если Ошибки.Количество() > 0 Тогда
		Для индекс = 0 По Ошибки.ВГраница() Цикл
			ОбщегоНазначения.СообщитьПользователю(СтрШаблон(НСтр("ru = '%1
			|Создание серий номенклатуры пропущено.'"), Ошибки[индекс]));
		КонецЦикла;
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц();
	Запрос.УстановитьПараметр("sid_doc", ?(Параметры.Свойство("sid_doc"), Параметры.sid_doc, Неопределено));
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1000
		|	РегистрСерий.sid КАК sid,
		|	РегистрСерий.sid_doc КАК sid_doc,
		|	РегистрСерий.id_good,
		|	РегистрСерий.name КАК Наименование,
		|	РегистрСерий.number КАК Номер,
		|	РегистрСерий.production_date КАК ДатаПроизводства,
		|	РегистрСерий.best_before КАК ГоденДо
		|ПОМЕСТИТЬ втТаблица
		|ИЗ
		|	РегистрСведений.SUI_docs_tbl_series КАК РегистрСерий
		|ГДЕ
		|	РегистрСерий.СтатусОбработки = ЗНАЧЕНИЕ(Перечисление.SUI_СтатусыОбработкиСтрок.Новая)
		|	И ВЫБОР
		|		КОГДА &sid_doc <> НЕОПРЕДЕЛЕНО
		|			ТОГДА РегистрСерий.sid_doc = &sid_doc
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	sid,
		|	sid_doc";
	
	РезультатыЗапроса = Запрос.ВыполнитьПакетСПромежуточнымиДанными();
	
	Если РезультатыЗапроса[0].Пустой() Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Отсутствуют данные для создания серий номенклатуры.'"));
		Возврат;
	КонецЕсли;
	
	Пока Не РезультатыЗапроса[0].Пустой() Цикл
		
		НачатьТранзакцию();
		
		Попытка
			
			БлокировкаДанных = Новый БлокировкаДанных();
			ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.SUI_docs_tbl_series");
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			ЭлементБлокировки.ИсточникДанных = РезультатыЗапроса[0];
			ЭлементБлокировки.ИспользоватьИзИсточникаДанных("sid", "sid");
			ЭлементБлокировки.ИспользоватьИзИсточникаДанных("sid_doc", "sid_doc");
			БлокировкаДанных.Заблокировать();
			
			ТаблицаСерий = РезультатыЗапроса[0].Выгрузить();
			ТаблицаСерий.Колонки.Добавить("Номенклатура", ТипыРеквизитов[0]);
			ТаблицаСерий.Колонки.Добавить("Серия", ТипыРеквизитов[1]);
			ТаблицаСерий.Колонки.Добавить("Пропустить", Новый ОписаниеТипов("Булево"));
			
			// Оценка производительности
			ОценкаПроизводительности_ВесЗамера = ОценкаПроизводительности_ВесЗамера + ТаблицаСерий.Количество();
			
			Для Каждого СтрокаТаблицыСерий Из ТаблицаСерий Цикл
				
				СтрокаТаблицыСерий.Номенклатура = ТипыРеквизитов[0].ПривестиЗначение(
					SUI_ИнтеграцияВКонфигурацию.СсылкаПоИдентификаторуSimple(СтрокаТаблицыСерий.id_good, Истина));
				
				Если Не ЗначениеЗаполнено(СтрокаТаблицыСерий.Номенклатура) Тогда
					СтрокаТаблицыСерий.Пропустить = Истина;
				КонецЕсли;
				
			КонецЦикла;
			
			ТаблицаСерий = ТаблицаСерий.Скопировать(Новый Структура("Пропустить", Ложь));
			
			ТаблицаСерий.Колонки.Удалить("id_good");
			ТаблицаСерий.Колонки.Удалить("Пропустить");
			
			ОжидаемыеКолонки = Новый Соответствие();
			Для Каждого ИмяКолонки Из СтрРазделить("sid,sid_doc,Серия", ",") Цикл
				ОжидаемыеКолонки.Вставить(ИмяКолонки, ТаблицаСерий.Колонки[ИмяКолонки].ТипЗначения);
			КонецЦикла;
			
			Попытка
				
				ТаблицаСерий = SUI_СерииНоменклатуры.СоздатьСерииНоменклатуры(АлгоритмСоздания, ТаблицаСерий);
				
				ТипРезультата = ТипЗнч(ТаблицаСерий);
				ОжидаемыйТипРезультата = Тип("ТаблицаЗначений");
				ОбщегоНазначенияКлиентСервер.Проверить(ТипРезультата = ОжидаемыйТипРезультата,
					СтрШаблон(НСтр("ru = 'Результат вернул тип %1. Ожидаемый тип %2'"), 
					ТипРезультата, ОжидаемыйТипРезультата));
				
				Для Каждого ОжидаемаяКолонка Из ОжидаемыеКолонки Цикл
				
					Колонка = ТаблицаСерий.Колонки.Найти(ОжидаемаяКолонка.Ключ);
					
					ОбщегоНазначенияКлиентСервер.Проверить(Колонка <> Неопределено,
						СтрШаблон(НСтр("ru = 'В таблице результата отсутствует обязательная колонка %1'"), 
						ОжидаемаяКолонка.Ключ));
					
					ОбщегоНазначенияКлиентСервер.Проверить(ОжидаемаяКолонка.Значение = Колонка.ТипЗначения,
						СтрШаблон(НСтр("ru = 'Колонка %1 таблицы результата содержит тип %2. Ожидаемый тип %3'"), 
						Колонка.Имя, Колонка.ТипЗначения, ОжидаемаяКолонка.Значение));
					
				КонецЦикла;
				
				ТаблицаСерий.Свернуть("sid,sid_doc,Серия");
				
			Исключение
				ВызватьИсключение СтрШаблон(
					НСтр("ru = 'Возникла ошибка при выполнении алгоритма создания серий номенклатуры:
					|%1'"), ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
			
			ЗапросРезультат = Новый Запрос();
			ЗапросРезультат.МенеджерВременныхТаблиц = Запрос.МенеджерВременныхТаблиц;
			ЗапросРезультат.УстановитьПараметр("ТаблицаСерий", ТаблицаСерий);
			ЗапросРезультат.УстановитьПараметр("ДатаОбновления", ТекущаяДатаСеанса());
			ЗапросРезультат.Текст = 
				"ВЫБРАТЬ
				|	ТаблицаСерий.sid КАК sid,
				|	ТаблицаСерий.sid_doc КАК sid_doc,
				|	ТаблицаСерий.Серия
				|ПОМЕСТИТЬ втТаблицаСерий
				|ИЗ
				|	&ТаблицаСерий КАК ТаблицаСерий
				|
				|ИНДЕКСИРОВАТЬ ПО
				|	sid,
				|	sid_doc
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	РегистрСерий.sid,
				|	РегистрСерий.sid_doc,
				|	РегистрСерий.id_good,
				|	РегистрСерий.id_properties,
				|	РегистрСерий.id_warehouse,
				|	РегистрСерий.qtty,
				|	РегистрСерий.additional_details,
				|	РегистрСерий.best_before,
				|	РегистрСерий.name,
				|	РегистрСерий.number,
				|	РегистрСерий.production_date,
				|	ЗНАЧЕНИЕ(Перечисление.SUI_СтатусыОбработкиСтрок.ОбработкаНеТребуется) КАК СтатусОбработки,
				|	&ДатаОбновления КАК ДатаОбновления,
				|	ЕСТЬNULL(втТаблицаСерий.Серия, НЕОПРЕДЕЛЕНО) КАК Серия
				|ИЗ
				|	втТаблица КАК втТаблица
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.SUI_docs_tbl_series КАК РегистрСерий
				|			ЛЕВОЕ СОЕДИНЕНИЕ втТаблицаСерий КАК втТаблицаСерий
				|			ПО РегистрСерий.sid = втТаблицаСерий.sid
				|			И РегистрСерий.sid_doc = втТаблицаСерий.sid_doc
				|		ПО втТаблица.sid = РегистрСерий.sid
				|		И втТаблица.sid_doc = РегистрСерий.sid_doc";
			
			//@skip-check query-in-loop
			РезультатЗапроса = ЗапросРезультат.Выполнить();
			
			Если Не РезультатЗапроса.Пустой() Тогда
				
				Выборка = РезультатЗапроса.Выбрать();
				
				Пока Выборка.Следующий() Цикл
					
					НаборЗаписей = РегистрыСведений.SUI_docs_tbl_series.СоздатьНаборЗаписей();
					НаборЗаписей.Отбор.sid.Установить(Выборка.sid);
					НаборЗаписей.Отбор.sid_doc.Установить(Выборка.sid_doc);
					
					Запись = НаборЗаписей.Добавить();
					ЗаполнитьЗначенияСвойств(Запись, Выборка);
					
					Запись.id_series = SUI_ИнтеграцияВКонфигурацию.ИдентификаторSimpleПоСсылке(Выборка.Серия, Истина);
					
					Если ПустаяСтрока(Запись.id_series) Тогда
						Запись.СтатусОбработки = Перечисления.SUI_СтатусыОбработкиСтрок.Пропущена;
					Иначе
						ОбработкаВыполнена = Истина;
					КонецЕсли;
					
					НаборЗаписей.ДополнительныеСвойства.Вставить("ОтключитьМеханизмРегистрацииОбъектов");
					НаборЗаписей.ОбменДанными.Загрузка = Истина;
					НаборЗаписей.Записать(Истина);
					
				КонецЦикла;
				
			КонецЕсли;
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			
			ОтменитьТранзакцию();
			
			Ошибка = ИнформацияОбОшибке();
			
			SUI_ЖурналРегистрации.ЗаписьВЖурналРегистрации(
				ИмяСобытияЗадание(НСтр("ru = 'Создание серий номенклатуры'")), , 
				Метаданные.ОбщиеМодули.SUI_ДокументыОбмена, , Ошибка);
			
			// Оценка производительности
			SUI_ОценкаПроизводительности.ЗакончитьЗамерВремени(
				ОценкаПроизводительности_КлючеваяОперация, 
				ОценкаПроизводительности_НачалоЗамера, 
				ОценкаПроизводительности_ВесЗамера, 
				ОбработкаОшибок.КраткоеПредставлениеОшибки(Ошибка), 
				Истина);
				
			ВызватьИсключение ОбработкаОшибок.КраткоеПредставлениеОшибки(Ошибка);
			
		КонецПопытки;
		
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц();
		//@skip-check query-in-loop
		РезультатыЗапроса = Запрос.ВыполнитьПакетСПромежуточнымиДанными();
		
	КонецЦикла;
	
	// Оценка производительности
	Если ОценкаПроизводительности_ВесЗамера > 0 Тогда
		SUI_ОценкаПроизводительности.ЗакончитьЗамерВремени(ОценкаПроизводительности_КлючеваяОперация, 
			ОценкаПроизводительности_НачалоЗамера, ОценкаПроизводительности_ВесЗамера);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(АдресРезультата) И ЭтоАдресВременногоХранилища(АдресРезультата) Тогда
		ПоместитьВоВременноеХранилище(ОбработкаВыполнена, АдресРезультата);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаданиеСоздатьШтрихкодыУпаковокДокументаОбмена(Параметры, АдресРезультата = Неопределено) Экспорт
	
	Результат = Ложь;
	
	Если Не SUI_НастройкиМетаданныхСервер.ТаблицаИспользуется(Перечисления.SUI_ТаблицыИнтеграции.Номенклатура) Или
		Не SUI_НастройкиМетаданныхСервер.ТаблицаИспользуется(Перечисления.SUI_ТаблицыИнтеграции.ШтрихкодыУпаковок) Тогда
		Возврат;
	КонецЕсли;
	
	НастройкаШтрихкодыУпаковок = SUI_НастройкиМетаданныхСервер.ПолучитьДополнительныеНастройки(
		Перечисления.SUI_ТаблицыИнтеграции.ШтрихкодыУпаковок);
	
	АлгоритмСоздания = SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(НастройкаШтрихкодыУпаковок, 
		"АлгоритмСозданияШтрихкодаУпаковки.Алгоритм", "", Тип("Строка"));
	
	Если Не ЗначениеЗаполнено(АлгоритмСоздания) Тогда
		ОбщегоНазначения.СообщитьПользователю("ru = 'Отсутствует настройка создания штрихкодов упаковок.
		|Создание штрихкодов упаковок было пропущено.'");
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("sid_doc", ?(Параметры.Свойство("sid_doc"), Параметры.sid_doc, Неопределено));
	Запрос.УстановитьПараметр("ШаблонИдентификатораSimple", 
		SUI_ИнтеграцияВКонфигурациюКлиентСервер.ШаблонИдентификатораSimple());
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1000
		|	ШтрихкодыДокументовОбмена.sid КАК sid,
		|	ШтрихкодыДокументовОбмена.sid_doc КАК sid_doc,
		|	ШтрихкодыДокументовОбмена.id_good КАК id_good,
		|	ШтрихкодыДокументовОбмена.id_property КАК id_property,
		|	ШтрихкодыДокументовОбмена.id_series КАК id_series,
		|	ШтрихкодыДокументовОбмена.id_unit КАК id_unit,
		|	ШтрихкодыДокументовОбмена.id_cell КАК id_cell,
		|	ШтрихкодыДокументовОбмена.mark_code КАК mark_code,
		|	ШтрихкодыДокументовОбмена.id_marking_code КАК id_marking_code,
		|	ШтрихкодыДокументовОбмена.id_SSCC КАК id_SSCC,
		|	ШтрихкодыДокументовОбмена.SSCC КАК SSCC,
		|	ШтрихкодыДокументовОбмена.SSCCBase64,
		|	ШтрихкодыДокументовОбмена.ШтрихкодBase64,
		|	ШтрихкодыДокументовОбмена.series_number КАК series_number
		|ПОМЕСТИТЬ втШтрихкодыДокументовОбмена
		|ИЗ
		|	РегистрСведений.SUI_docs_tbl_barcodes КАК ШтрихкодыДокументовОбмена
		|ГДЕ
		|	ШтрихкодыДокументовОбмена.СтатусОбработки = ЗНАЧЕНИЕ(Перечисление.SUI_СтатусыОбработкиСтрок.Новая)
		|	И ВЫБОР
		|		КОГДА &sid_doc <> НЕОПРЕДЕЛЕНО
		|			ТОГДА ШтрихкодыДокументовОбмена.sid_doc = &sid_doc
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втШтрихкодыДокументовОбмена.sid КАК sid,
		|	втШтрихкодыДокументовОбмена.sid_doc КАК sid_doc,
		|	втШтрихкодыДокументовОбмена.id_good КАК id_good,
		|	втШтрихкодыДокументовОбмена.id_property КАК id_property,
		|	втШтрихкодыДокументовОбмена.series_number КАК series_number
		|ПОМЕСТИТЬ втШтрихкодыДокументовОбменаБезСерии
		|ИЗ
		|	втШтрихкодыДокументовОбмена КАК втШтрихкодыДокументовОбмена
		|ГДЕ
		|	НЕ втШтрихкодыДокументовОбмена.id_series ПОДОБНО &ШаблонИдентификатораSimple
		|	И втШтрихкодыДокументовОбмена.series_number <> """"
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ШтрихкодыДокументовОбменаБезСерии.sid КАК sid,
		|	СерииДокументовОбмена.id_series КАК id_series
		|ПОМЕСТИТЬ втНовыеСерииШтрихкодовДокументовОбмена
		|ИЗ
		|	РегистрСведений.SUI_docs_tbl_series КАК СерииДокументовОбмена
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втШтрихкодыДокументовОбменаБезСерии КАК ШтрихкодыДокументовОбменаБезСерии
		|		ПО СерииДокументовОбмена.sid_doc = ШтрихкодыДокументовОбменаБезСерии.sid_doc
		|		И СерииДокументовОбмена.id_good = ШтрихкодыДокументовОбменаБезСерии.id_good
		|		И СерииДокументовОбмена.id_properties = ШтрихкодыДокументовОбменаБезСерии.id_property
		|		И СерииДокументовОбмена.number = ШтрихкодыДокументовОбменаБезСерии.series_number
		|ГДЕ
		|	СерииДокументовОбмена.СтатусОбработки <> ЗНАЧЕНИЕ(Перечисление.SUI_СтатусыОбработкиСтрок.Новая)
		|	И СерииДокументовОбмена.id_series ПОДОБНО &ШаблонИдентификатораSimple
		|	И СерииДокументовОбмена.number <> """"
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втШтрихкодыДокументовОбмена.sid,
		|	втШтрихкодыДокументовОбмена.sid_doc,
		|	втШтрихкодыДокументовОбмена.id_good,
		|	втШтрихкодыДокументовОбмена.id_property,
		|	ЕСТЬNULL(втНовыеСерииШтрихкодовДокументовОбмена.id_series, втШтрихкодыДокументовОбмена.id_series) КАК id_series,
		|	втШтрихкодыДокументовОбмена.id_unit,
		|	втШтрихкодыДокументовОбмена.id_cell,
		|	втШтрихкодыДокументовОбмена.mark_code,
		|	втШтрихкодыДокументовОбмена.id_marking_code,
		|	втШтрихкодыДокументовОбмена.id_SSCC,
		|	втШтрихкодыДокументовОбмена.SSCC,
		|	втШтрихкодыДокументовОбмена.SSCCBase64,
		|	втШтрихкодыДокументовОбмена.ШтрихкодBase64,
		|	втШтрихкодыДокументовОбмена.series_number
		|ИЗ
		|	втШтрихкодыДокументовОбмена КАК втШтрихкодыДокументовОбмена
		|		ЛЕВОЕ СОЕДИНЕНИЕ втНовыеСерииШтрихкодовДокументовОбмена КАК втНовыеСерииШтрихкодовДокументовОбмена
		|		ПО втШтрихкодыДокументовОбмена.sid = втНовыеСерииШтрихкодовДокументовОбмена.sid";
		
	РезультатЗапроса = Запрос.Выполнить();
	
	Пока Не РезультатЗапроса.Пустой() Цикл
		
		НачатьТранзакцию();
		
		Попытка
			
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.SUI_docs_tbl_barcodes");
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			ЭлементБлокировки.ИсточникДанных = РезультатЗапроса;
			ЭлементБлокировки.ИспользоватьИзИсточникаДанных("sid", "sid");
			ЭлементБлокировки.ИспользоватьИзИсточникаДанных("sid_doc", "sid_doc");
			Блокировка.Заблокировать();
			
			Выборка = РезультатЗапроса.Выбрать();
			
			Пока Выборка.Следующий() Цикл
				
				//@skip-check structure-consructor-too-many-keys
				Данные = Новый Структура("mark_code,SSCC,id_marking_code,id_SSCC");
				ЗаполнитьЗначенияСвойств(Данные, Выборка);
				
				Если ЗначениеЗаполнено(Данные.mark_code) И
					SUI_ИнтеграцияВКонфигурациюКлиентСервер.ЭтоИдентификаторSimple(Выборка.id_good) Тогда
					
					Данные.id_marking_code = SUI_ИнтеграцияВКонфигурацию.СсылкаПоИдентификаторуSimple(
						Выборка.id_marking_code, Истина);
					Данные.id_SSCC = SUI_ИнтеграцияВКонфигурацию.СсылкаПоИдентификаторуSimple(
						Выборка.id_SSCC, Истина);
					
					ПараметрыМетода = Новый Массив();
					ПараметрыМетода.Добавить(Данные.mark_code);
					ПараметрыМетода.Добавить(Данные.SSCC);
					ПараметрыМетода.Добавить(SUI_ИнтеграцияВКонфигурацию.СсылкаПоИдентификаторуSimple(Выборка.id_good, Истина));
					ПараметрыМетода.Добавить(SUI_ИнтеграцияВКонфигурацию.СсылкаПоИдентификаторуSimple(Выборка.id_property, Истина));
					ПараметрыМетода.Добавить(SUI_ИнтеграцияВКонфигурацию.СсылкаПоИдентификаторуSimple(Выборка.id_series, Истина));
					ПараметрыМетода.Добавить(SUI_ИнтеграцияВКонфигурацию.СсылкаПоИдентификаторуSimple(Выборка.id_unit, Истина));
					ПараметрыМетода.Добавить(SUI_ИнтеграцияВКонфигурацию.СсылкаПоИдентификаторуSimple(Выборка.id_cell, Истина));
					ПараметрыМетода.Добавить(Данные.id_marking_code);
					ПараметрыМетода.Добавить(Данные.id_SSCC);
					
					ПараметрыМетода = Обработки.SUI_РедакторКода.ВыполнитьКодЧерезМетодКонфигурации(
						"SUI_ШтрихкодыУпаковок.СоздатьШтрихкодУпаковки", АлгоритмСоздания, ПараметрыМетода, Истина);
					
					Данные.id_marking_code = ПараметрыМетода[ПараметрыМетода.ВГраница() - 1];
					Данные.id_marking_code = SUI_ИнтеграцияВКонфигурацию.ИдентификаторSimpleПоСсылке(
						Данные.id_marking_code, Истина);
					
					Данные.id_SSCC = ПараметрыМетода[ПараметрыМетода.ВГраница()];
					Данные.id_SSCC = SUI_ИнтеграцияВКонфигурацию.ИдентификаторSimpleПоСсылке(Данные.id_SSCC, Истина);
					
					Если Не ЗначениеЗаполнено(Данные.id_marking_code) Тогда
						Данные.Вставить("СтатусОбработки", Перечисления.SUI_СтатусыОбработкиСтрок.Пропущена);
					Иначе
						Данные.Вставить("СтатусОбработки", Перечисления.SUI_СтатусыОбработкиСтрок.ОбработкаНеТребуется);
						Результат = Истина;
					КонецЕсли;
					
				Иначе
					Данные.Вставить("СтатусОбработки", Перечисления.SUI_СтатусыОбработкиСтрок.Пропущена);
				КонецЕсли;
				
				НаборЗаписей = РегистрыСведений.SUI_docs_tbl_barcodes.СоздатьНаборЗаписей();
				НаборЗаписей.Отбор.sid.Установить(Выборка.sid);
				НаборЗаписей.Отбор.sid_doc.Установить(Выборка.sid_doc);
				
				НаборЗаписей.Прочитать();
				
				Если НаборЗаписей.Количество() = 1 Тогда
					
					ЗаполнитьЗначенияСвойств(НаборЗаписей[0], Данные);
					НаборЗаписей[0].ДатаОбновления = ТекущаяДатаСеанса();
					
					НаборЗаписей.ДополнительныеСвойства.Вставить("ОтключитьМеханизмРегистрацииОбъектов");
					НаборЗаписей.ОбменДанными.Загрузка = Истина;
					НаборЗаписей.Записать(Истина);
					
				КонецЕсли;
				
			КонецЦикла;
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			ОтменитьТранзакцию();
			SUI_ЖурналРегистрации.ЗаписьВЖурналРегистрации(ИмяСобытияЗадание(НСтр("ru = 'Создание штрихкодов упаковок'")), , 
				Метаданные.ОбщиеМодули.SUI_ДокументыОбмена, , ИнформацияОбОшибке());
			ВызватьИсключение ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		
		//@skip-check query-in-loop
		РезультатЗапроса = Запрос.Выполнить();
		
	КонецЦикла;

	Если ЗначениеЗаполнено(АдресРезультата) И ЭтоАдресВременногоХранилища(АдресРезультата) Тогда
		ПоместитьВоВременноеХранилище(Результат, АдресРезультата);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаданиеЗагрузитьИтогиПересчетаВДокументОбмена(Параметры, АдресРезультата = Неопределено) Экспорт
	
	Результат = Ложь;
	
	Если Не SUI_НастройкиМетаданныхСервер.ТаблицаИспользуется(Перечисления.SUI_ТаблицыИнтеграции.Номенклатура) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ШаблонИдентификатораSimple", SUI_ИнтеграцияВКонфигурациюКлиентСервер.ШаблонИдентификатораSimple());
	
	Если Параметры.Свойство("sid_doc") Тогда
		Запрос.УстановитьПараметр("sid_doc", Параметры.sid_doc);
	Иначе
		Запрос.УстановитьПараметр("sid_doc", Неопределено);
	КонецЕсли;
	
	Запрос.Текст =
		"ВЫБРАТЬ
		|	SUI_docs_tbl_goods_delta.sid_doc,
		|	SUI_docs_tbl_goods_delta.id_good,
		|	SUI_docs_tbl_goods_delta.id_properties,
		|	SUI_docs_tbl_goods_delta.id_series,
		|	SUI_docs_tbl_goods_delta.id_cell,
		|	SUI_docs_tbl_goods_delta.id_unit,
		|	SUI_docs_tbl_goods_delta.id_price,
		|	SUI_docs_tbl_goods_delta.price,
		|	СУММА(SUI_docs_tbl_goods_delta.d_qtty) КАК d_qtty,
		|	SUI_docs_tbl_goods_delta.use_series,
		|	SUI_docs_tbl_goods_delta.ТипТаблицы
		|ПОМЕСТИТЬ втИтогиПересчета
		|ИЗ
		|	РегистрСведений.SUI_docs_tbl_goods_delta КАК SUI_docs_tbl_goods_delta
		|ГДЕ
		|	ВЫБОР
		|		КОГДА &sid_doc <> НЕОПРЕДЕЛЕНО
		|			ТОГДА SUI_docs_tbl_goods_delta.sid_doc = &sid_doc
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ
		|СГРУППИРОВАТЬ ПО
		|	SUI_docs_tbl_goods_delta.sid_doc,
		|	SUI_docs_tbl_goods_delta.id_good,
		|	SUI_docs_tbl_goods_delta.id_properties,
		|	SUI_docs_tbl_goods_delta.id_series,
		|	SUI_docs_tbl_goods_delta.id_cell,
		|	SUI_docs_tbl_goods_delta.id_unit,
		|	SUI_docs_tbl_goods_delta.id_price,
		|	SUI_docs_tbl_goods_delta.price,
		|	SUI_docs_tbl_goods_delta.use_series,
		|	SUI_docs_tbl_goods_delta.ТипТаблицы
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕСТЬNULL(SUI_docs_tbl_goods.sid, """") КАК sid,
		|	ЕСТЬNULL(SUI_docs_tbl_goods.sid_doc, втИтогиПересчета.sid_doc) КАК sid_doc,
		|	ЕСТЬNULL(SUI_docs_tbl_goods.id_good, втИтогиПересчета.id_good) КАК id_good,
		|	ЕСТЬNULL(SUI_docs_tbl_goods.id_properties, втИтогиПересчета.id_properties) КАК id_properties,
		|	ЕСТЬNULL(SUI_docs_tbl_goods.id_series, втИтогиПересчета.id_series) КАК id_series,
		|	ЕСТЬNULL(SUI_docs_tbl_goods.id_cell, втИтогиПересчета.id_cell) КАК id_cell,
		|	ЕСТЬNULL(SUI_docs_tbl_goods.id_unit, втИтогиПересчета.id_unit) КАК id_unit,
		|	ЕСТЬNULL(SUI_docs_tbl_goods.id_price, втИтогиПересчета.id_price) КАК id_price,
		|	ЕСТЬNULL(SUI_docs_tbl_goods.price, втИтогиПересчета.price) КАК price,
		|	втИтогиПересчета.d_qtty КАК qtty,
		|	ЕСТЬNULL(SUI_docs_tbl_goods.qtty_plan, 0) КАК qtty_plan,
		|	ЕСТЬNULL(SUI_docs_tbl_goods.use_series, втИтогиПересчета.use_series) КАК use_series,
		|	ЕСТЬNULL(SUI_docs_tbl_goods.ТипТаблицы, втИтогиПересчета.ТипТаблицы) КАК ТипТаблицы
		|ИЗ
		|	втИтогиПересчета КАК втИтогиПересчета
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.SUI_docs_tbl_goods КАК SUI_docs_tbl_goods
		|		ПО втИтогиПересчета.sid_doc = SUI_docs_tbl_goods.sid_doc
		|		И втИтогиПересчета.id_good = SUI_docs_tbl_goods.id_good
		|		И втИтогиПересчета.id_properties = SUI_docs_tbl_goods.id_properties
		|		И втИтогиПересчета.id_series = SUI_docs_tbl_goods.id_series
		|		И втИтогиПересчета.id_cell = SUI_docs_tbl_goods.id_cell
		|		И втИтогиПересчета.id_unit = SUI_docs_tbl_goods.id_unit
		|		И втИтогиПересчета.id_price = SUI_docs_tbl_goods.id_price
		|		И втИтогиПересчета.price = SUI_docs_tbl_goods.price
		|		И втИтогиПересчета.use_series = SUI_docs_tbl_goods.use_series
		|		И втИтогиПересчета.ТипТаблицы = SUI_docs_tbl_goods.ТипТаблицы";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	НачатьТранзакцию();
	
	Попытка
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			//@skip-check bsl-variable-name-invalid
			sid = Выборка.sid;
			
			Если Не ЗначениеЗаполнено(sid) Тогда
				sid = Строка(Новый УникальныйИдентификатор());
			КонецЕсли;
			
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.SUI_docs_tbl_goods");
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Разделяемый;
			ЭлементБлокировки.УстановитьЗначение("sid", sid);
			ЭлементБлокировки.УстановитьЗначение("sid_doc", Выборка.sid_doc);
			Блокировка.Заблокировать();
		
			НаборЗаписей = РегистрыСведений.SUI_docs_tbl_goods.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.sid.Установить(sid);
			НаборЗаписей.Отбор.sid_doc.Установить(Выборка.sid_doc);
			НаборЗаписей.Прочитать();
			
			Если НаборЗаписей.Количество() = 0 Тогда
				Запись = НаборЗаписей.Добавить();
			Иначе
				Для Индекс = 1 По НаборЗаписей.Количество() - 1 Цикл
					НаборЗаписей.Удалить(НаборЗаписей[Индекс]);
				КонецЦикла;
			КонецЕсли;
			
			Запись = НаборЗаписей[0];
			ЗаполнитьЗначенияСвойств(Запись, Выборка);
			Запись.sid = sid;
			
			НаборЗаписей.ДополнительныеСвойства.Вставить("ОтключитьМеханизмРегистрацииОбъектов");
			НаборЗаписей.Записать(Истина);
			
		КонецЦикла;
		
		Результат = Истина;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		SUI_ЖурналРегистрации.ЗаписьВЖурналРегистрации(ИмяСобытияЗадание(НСтр("ru = 'Загрузка итогов пересчета'")), , 
			Метаданные.ОбщиеМодули.SUI_ДокументыОбмена, , ИнформацияОбОшибке());
		ВызватьИсключение ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Если ЗначениеЗаполнено(АдресРезультата) И ЭтоАдресВременногоХранилища(АдресРезультата) Тогда
		ПоместитьВоВременноеХранилище(Результат, АдресРезультата);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаданиеОбновитьТаблицыДокументаОбменаПослеЗаписиВДокумент(Параметры, АдресРезультата = Неопределено) Экспорт

	Результат = Ложь;
	
	ДокументСсылка = SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "ДокументСсылка");

	Таблицы = SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "ТаблицыДокументаОбмена", 
		Новый Соответствие(), Тип("Соответствие"));
		
	НачатьТранзакцию();
	
	Попытка
		
		Для Каждого Таблица Из Таблицы Цикл
		
			Если ТипЗнч(Таблица.Значение) <> Тип("ТаблицаЗначений") Или 
				Таблица.Значение.Количество() = 0 Или
				Таблица.Значение.Колонки.Найти("sid") = Неопределено Или
				Таблица.Значение.Колонки.Найти("sid_doc") = Неопределено Тогда
				Продолжить;
			КонецЕсли;
	
			Если Таблица.Ключ = Перечисления.SUI_ТипыТаблицДокументовОбмена.Товары Или
				Таблица.Ключ = Перечисления.SUI_ТипыТаблицДокументовОбмена.Отбор Или
				Таблица.Ключ = Перечисления.SUI_ТипыТаблицДокументовОбмена.Размещение Тогда
				МенеджерОбъекта = РегистрыСведений.SUI_docs_tbl_goods;
			ИначеЕсли Таблица.Ключ = Перечисления.SUI_ТипыТаблицДокументовОбмена.ШтрихкодыУпаковок Тогда
				МенеджерОбъекта = РегистрыСведений.SUI_docs_tbl_barcodes;
			ИначеЕсли Таблица.Ключ = Перечисления.SUI_ТипыТаблицДокументовОбмена.Серии Тогда
				МенеджерОбъекта = РегистрыСведений.SUI_docs_tbl_series;
			Иначе
				Продолжить;
			КонецЕсли;
			
			КолонкиТаблицы = Новый Массив();
			Для Каждого Колонка Из Таблица.Значение.Колонки Цикл
				КолонкиТаблицы.Добавить(Колонка.Имя);
			КонецЦикла;
			КолонкиТаблицы = СтрСоединить(КолонкиТаблицы, ",");
			
			Для Каждого СтрокаТаблицы Из Таблица.Значение Цикл
					
				ДанныеСтроки = Новый Структура(КолонкиТаблицы);
				ЗаполнитьЗначенияСвойств(ДанныеСтроки, СтрокаТаблицы);
				SUI_ИнтеграцияВКонфигурацию.ПривестиСсылкиКИдентификаторамSimple(ДанныеСтроки);
				
				Если Таблица.Ключ = Перечисления.SUI_ТипыТаблицДокументовОбмена.Товары Или
					Таблица.Ключ = Перечисления.SUI_ТипыТаблицДокументовОбмена.Отбор Или
					Таблица.Ключ = Перечисления.SUI_ТипыТаблицДокументовОбмена.Размещение Тогда
					ДанныеСтроки.Вставить("ТипТаблицы", Таблица.Ключ);
				КонецЕсли;
				
				НаборЗаписей = МенеджерОбъекта.СоздатьНаборЗаписей();
				НаборЗаписей.Отбор.sid.Установить(ДанныеСтроки.sid);
				НаборЗаписей.Отбор.sid_doc.Установить(ДанныеСтроки.sid_doc);

				Если ПроверитьСтрокуТаблицыДокументаПередЗаписью(ДанныеСтроки, Таблица.Ключ) Тогда
					
					НаборЗаписей.Прочитать();
					
					Если НаборЗаписей.Количество() = 0 Тогда
						ЗаполнитьЗначенияСвойств(НаборЗаписей.Добавить(), ДанныеСтроки);
					Иначе
						
						ИсключаемыеПоля = "sid,sid_doc";
						Если ДанныеСтроки.Свойство("barcode_from_scanner") Тогда
							ИсключаемыеПоля = ИсключаемыеПоля + "barcode_from_scanner";
						КонецЕсли;
						
						ЗаполнитьЗначенияСвойств(НаборЗаписей[0], ДанныеСтроки, , ИсключаемыеПоля);
						
					КонецЕсли;
					
				КонецЕсли;

				НаборЗаписей.ДополнительныеСвойства.Вставить("ОтключитьМеханизмРегистрацииОбъектов");
				
				Если НаборЗаписей.ПроверитьЗаполнение() Тогда
					НаборЗаписей.Записать(Истина);
				КонецЕсли;
				
			КонецЦикла;
		
			Результат = Истина;
			
		КонецЦикла;

		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		SUI_ЖурналРегистрации.ЗаписьВЖурналРегистрации(
			ИмяСобытияЗадание(НСтр("ru = 'Обновление таблиц после записи документа'")), , 
			Метаданные.ОбщиеМодули.SUI_ДокументыОбмена, ДокументСсылка, ИнформацияОбОшибке());
		ВызватьИсключение ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	Если ЗначениеЗаполнено(АдресРезультата) И ЭтоАдресВременногоХранилища(АдресРезультата) Тогда
		ПоместитьВоВременноеХранилище(Результат, АдресРезультата);
	КонецЕсли;

КонецПроцедуры

Процедура ЗаданиеЗагрузитьДокументОбменаВДокумент1СПослеЗагрузки(ДанныеДокументаОбмена) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	SUI_docs.sid,
		|	SUI_docs.id_doc КАК ДокументСсылка,
		|	SUI_docs.НастройкаДокумента
		|ИЗ
		|	РегистрСведений.SUI_docs КАК SUI_docs
		|ГДЕ
		|	ВЫБОР
		|		КОГДА &sid <> НЕОПРЕДЕЛЕНО
		|		ИЛИ &id_doc <> НЕОПРЕДЕЛЕНО
		|		ИЛИ &НастройкаДокумента <> НЕОПРЕДЕЛЕНО
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ
		|	И ВЫБОР
		|		КОГДА &sid <> НЕОПРЕДЕЛЕНО
		|			ТОГДА SUI_docs.sid = &sid
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ
		|	И ВЫБОР
		|		КОГДА &id_doc <> НЕОПРЕДЕЛЕНО
		|			ТОГДА SUI_docs.id_doc = &id_doc
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ
		|	И ВЫБОР
		|		КОГДА &НастройкаДокумента <> НЕОПРЕДЕЛЕНО
		|			ТОГДА SUI_docs.НастройкаДокумента = &НастройкаДокумента
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ";
	
	Если ДанныеДокументаОбмена.Свойство("sid") Тогда
		Запрос.УстановитьПараметр("sid", ДанныеДокументаОбмена.sid);
	Иначе
		Запрос.УстановитьПараметр("sid", Неопределено);
	КонецЕсли;
	
	Если ДанныеДокументаОбмена.Свойство("id_doc") Тогда
		Запрос.УстановитьПараметр("id_doc", ДанныеДокументаОбмена.id_doc);
	Иначе
		Запрос.УстановитьПараметр("id_doc", Неопределено);
	КонецЕсли;
	
	Если ДанныеДокументаОбмена.Свойство("НастройкаДокумента") Тогда
		Запрос.УстановитьПараметр("НастройкаДокумента", ДанныеДокументаОбмена.НастройкаДокумента);
	Иначе
		Запрос.УстановитьПараметр("НастройкаДокумента", Неопределено);
	КонецЕсли;

	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	ДокументОбмена = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(Выборка);
	SUI_ИнтеграцияВКонфигурацию.ВосстановитьСсылкиИдентификаторовSimple(ДокументОбмена);
	
	Если Не ЗначениеЗаполнено(ДокументОбмена.ДокументСсылка) Тогда
		Возврат;
	КонецЕсли;

	НачатьТранзакцию();
	
	Попытка
		
		// Взять документ. Состояние документа ВРаботе
		СменитьСостояниеДокументаОбмена(Перечисления.SUI_СостоянияДокументовОбмена.ВРаботе, 
			ДокументОбмена.ДокументСсылка,
			ДокументОбмена.НастройкаДокумента, 
			Истина);
			
		// Подготовить данные документа обмена к загрузке в документ 1С
 		ДанныеДокумента = ДанныеДокументаОбменаКЗагрузкеВДокумент(ДокументОбмена);
		
		Если ДанныеДокумента <> Неопределено Тогда
			
			ОбъектДокумента = ДанныеДокумента.ДокументСсылка.ПолучитьОбъект();
			
			// Загрузить данные в объект документа
			ЗагрузитьТаблицыДокументаОбменаВДокументОбъект(ОбъектДокумента, ДанныеДокумента.НастройкаДокумента, 
				ДанныеДокумента.Таблицы, SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеДокумента, "ТаблицаСерийБезНастройки"));
			
			// Выполнить запись объекта документа
			ЗаписатьДокументОбъект(ОбъектДокумента, ДанныеДокумента.НастройкаДокумента, ДанныеДокумента.Таблицы, Неопределено);
				
		КонецЕсли;
		
		ЗавершатьДокументОбмена = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОбмена.НастройкаДокумента, "ЗавершатьДокумент1СПослеПолученияИзТСД");
		
		Если ЗавершатьДокументОбмена Тогда 
			// Завершить документ. Состояние документа Завершен
			СменитьСостояниеДокументаОбмена(Перечисления.SUI_СостоянияДокументовОбмена.Завершен, 
				ДокументОбмена.ДокументСсылка,
				ДокументОбмена.НастройкаДокумента, 
				Истина); 
		Иначе 
			// Завершить документ. Состояние документа Загружен
			СменитьСостояниеДокументаОбмена(Перечисления.SUI_СостоянияДокументовОбмена.Загружен, 
				ДокументОбмена.ДокументСсылка,
				ДокументОбмена.НастройкаДокумента, 
				Истина);	
		КонецЕсли;
			
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		SUI_ЖурналРегистрации.ЗаписьВЖурналРегистрации(
			ИмяСобытияЗадание(НСтр("ru = 'Запись в документ 1С'")), , 
			Метаданные.ОбщиеМодули.SUI_ДокументыОбмена, ДокументОбмена.ДокументСсылка, ИнформацияОбОшибке());
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура СоздатьДокументыНаОсновании(ДокументОснование, НастройкиСозданияДокументовНаОсновании, ТаблицыДокументаОбмена, 
	НастройкаТаблицаСозданияДокументов)
	
	Если Не ЗначениеЗаполнено(НастройкиСозданияДокументовНаОсновании) Тогда
		Возврат;	
	КонецЕсли;
	
	ЕстьРасхождения = Ложь;
	
	Для Каждого ТаблицаДокументаОбмена Из ТаблицыДокументаОбмена Цикл
		
		Если ТаблицаДокументаОбмена.Значение.Колонки.Найти("qtty_plan") = Неопределено Или
				ТаблицаДокументаОбмена.Значение.ВыгрузитьКолонку("qtty") = Неопределено Тогда
			Продолжить;	
		КонецЕсли;
		
		ЕстьРасхождения = Не ОбщегоНазначения.КоллекцииИдентичны(
		ТаблицаДокументаОбмена.Значение.ВыгрузитьКолонку("qtty_plan"), 
		ТаблицаДокументаОбмена.Значение.ВыгрузитьКолонку("qtty"), , , Истина);
		
		Если ЕстьРасхождения Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	
	Для Каждого СтрокаСозданияДокументов Из НастройкаТаблицаСозданияДокументов Цикл
		
		Попытка 
			Если (Не СтрокаСозданияДокументов.ПриРасхождении И Не ЕстьРасхождения) Или
				(СтрокаСозданияДокументов.ПриРасхождении И ЕстьРасхождения) Тогда
				
				ДокументОбъект = Документы[СтрокаСозданияДокументов.Значение].СоздатьДокумент(); 
				ДокументОбъект.Заполнить(ДокументОснование);
				
				ДокументОбъект.Дата = ТекущаяДатаСеанса();	
								
				АлгоритмОбработки = НастройкиСозданияДокументовНаОсновании.Получить(СтрокаСозданияДокументов.Значение);
				
				Если Не (АлгоритмОбработки = Неопределено Или АлгоритмОбработки = "") Тогда
					ВыполнитьПроизвольныйАлгоритм_СозданиеДокументаНаОсновании(АлгоритмОбработки, ДокументОбъект, ДокументОснование);	
				КонецЕсли;   
				
				ДокументОбъект.Записать(?(СтрокаСозданияДокументов.Проводить, РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись)); 
				
			КонецЕсли;
		Исключение 
			ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'При выполнении алгоритма ""Создание документа на основании"" возникла исключительная ошибка:
				|%1.
				|Проверьте произвольный алгоритм в настройках документа обмена.'"), 
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));	
		КонецПопытки;
		
	КонецЦикла;

КонецПроцедуры

Функция ИмяСобытия(ВложенноеСобытие = "")
	Возврат SUI_ДокументыОбменаКлиентСервер.ИмяСобытия(ВложенноеСобытие);	
КонецФункции

Функция ИмяСобытияЗадание(ВложенноеСобытие = "")
	Возврат SUI_ДокументыОбменаКлиентСервер.ИмяСобытияЗадание(ВложенноеСобытие);	
КонецФункции

Функция КонтекстВызоваСтрокой(КонтекстВызова = "")
	
	Если ЗначениеЗаполнено(КонтекстВызова) Тогда
		Возврат КонтекстВызова + " (" + Метаданные.ОбщиеМодули.SUI_ДокументыОбмена.ПолноеИмя() + ")";
	Иначе
		Возврат Метаданные.ОбщиеМодули.SUI_ДокументыОбмена.ПолноеИмя();
	КонецЕсли;
	
КонецФункции

// Идентификатор документа по параметру.
// 
// Параметры:
//  Документ - ДокументСсылка, Строка, УникальныйИдентификатор - Документ ссылка, 
//  	идентификатор Simple документа или SID документа обмена.
//  КонтекстВызова - Строка - например, имя процедуры или функции, в которой выполняется проверка
//  
// Возвращаемое значение:
//  Структура - Идентификатор документа по параметру:
// * SID - Строка - Идентификатор SID, если параметр уникальный идентификатор
//	* ID - Строка - Идентификатор Simple, если параметр идентификатор Simple или ДокументСсылка
//@skip-check constructor-function-return-section
Функция ИдентификаторДокументаПоПараметру(Документ, КонтекстВызова = "")

	Если ТипЗнч(Документ) = Тип("Строка") Тогда

		Если СтроковыеФункцииКлиентСервер.ЭтоУникальныйИдентификатор(Документ) Тогда
			Возврат Новый Структура("SID", Документ);
		Иначе
			
			ОбщегоНазначенияКлиентСервер.Проверить(
			SUI_ИнтеграцияВКонфигурациюКлиентСервер.ЭтоИдентификаторSimple(Документ),
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Идентификатор документа обмена (%1) не является идентификатором Simple'"), Документ),
			КонтекстВызоваСтрокой(КонтекстВызова));
			
			Возврат Новый Структура("ID", Документ);
			
		КонецЕсли;

	ИначеЕсли ТипЗнч(Документ) = Тип("УникальныйИдентификатор") Тогда
		Возврат Новый Структура("SID", Строка(Документ));
	Иначе
		
		ОбщегоНазначенияКлиентСервер.Проверить(
			SUI_ОбщегоНазначения.ЭтоСсылкаДокумента(Документ),
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Значение (%1) не является ссылкой документа'"), Документ),
			КонтекстВызоваСтрокой(КонтекстВызова));
			
		ОбщегоНазначенияКлиентСервер.Проверить(
			ОбщегоНазначения.СсылкаСуществует(Документ),
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Ссылка документа (%1) не существует'"), Документ),
			КонтекстВызоваСтрокой(КонтекстВызова));

		Возврат Новый Структура("ID", 
			SUI_ИнтеграцияВКонфигурацию.ИдентификаторSimpleПоСсылке(Документ, Истина));
		
	КонецЕсли;
	
КонецФункции

// Настройка документа по параметру.
// 
// Параметры:
//  НастройкаДокумента - СправочникСсылка.SUI_НастройкиДокументов - Настройка документа
//  НеПустая - Булево - Не пустая ссылка настройки
//  КонтекстВызова - Строка - например, имя процедуры или функции, в которой выполняется проверка
// 
// Возвращаемое значение:
//  СправочникСсылка.SUI_НастройкиДокументов - Настройка документа
Функция НастройкаДокументаПоПараметру(НастройкаДокумента, НеПустая = Истина, КонтекстВызова = "")
	
	ОбщегоНазначенияКлиентСервер.Проверить(
		ТипЗнч(НастройкаДокумента) = Тип("СправочникСсылка.SUI_НастройкиДокументов"),
		НСтр("ru = 'Значение не является настройкой документа обмена'"),
		КонтекстВызоваСтрокой(КонтекстВызова));
	
	Если НеПустая Тогда
		
		ОбщегоНазначенияКлиентСервер.Проверить(
		Не НастройкаДокумента.Пустая(),
		НСтр("ru = 'Пустая ссылка настройки документа'"),
		КонтекстВызоваСтрокой(КонтекстВызова));
		
	КонецЕсли;
	
	Возврат НастройкаДокумента;
	
КонецФункции

Функция ПолучитьSIDДокументовОбмена(Документ, НастройкаДокумента = Неопределено) Экспорт
	
	SIDДокументовОбмена = Новый Массив();
	Идентификаторы 		= Новый Массив();
	НастройкиДокументов = Новый Массив();

	Если ТипЗнч(Документ) = Тип("Массив") Тогда
		Идентификаторы = Документ;
	ИначеЕсли ТипЗнч(Документ) = Тип("СписокЗначений") Тогда
		Идентификаторы = Документ.ВыгрузитьЗначения();
	Иначе
		Идентификаторы.Добавить(Документ);
	КонецЕсли;
	
	Идентификаторы = ОбщегоНазначенияКлиентСервер.СвернутьМассив(Идентификаторы);
	
	Если ТипЗнч(НастройкаДокумента) = Тип("Массив") Тогда
		НастройкиДокументов = НастройкаДокумента;
	ИначеЕсли ТипЗнч(НастройкаДокумента) = Тип("СписокЗначений") Тогда
		НастройкиДокументов = НастройкаДокумента.ВыгрузитьЗначения();
	ИначеЕсли ЗначениеЗаполнено(НастройкаДокумента) Тогда
		НастройкиДокументов.Добавить(НастройкаДокумента);
	КонецЕсли;

	НастройкиДокументов = ОбщегоНазначенияКлиентСервер.СвернутьМассив(НастройкиДокументов);
	
	ОбщегоНазначенияКлиентСервер.Проверить(
		(ЗначениеЗаполнено(Идентификаторы) Или ЗначениеЗаполнено(НастройкиДокументов)),
		НСтр("ru = 'Не переданны параметры для получения SID документов обмена.'"),
		КонтекстВызоваСтрокой("ПолучитьSIDДокументовОбмена"));
	
	//@skip-check bsl-variable-name-invalid
	ID = Новый Массив();
	SID = Новый Массив();
	Настройки = Новый Массив();
	
	Для Каждого Идентификатор Из Идентификаторы Цикл
		
		ИдентификаторДокумента = ИдентификаторДокументаПоПараметру(Идентификатор, "ПолучитьSIDДокументовОбмена");
	
		Если ИдентификаторДокумента.Свойство("ID") Тогда
			ID.Добавить(ИдентификаторДокумента.ID);
		ИначеЕсли ИдентификаторДокумента.Свойство("SID") Тогда
			SID.Добавить(ИдентификаторДокумента.SID);
		КонецЕсли;
	
	КонецЦикла;
	
	Для Каждого НастройкаДокумента Из НастройкиДокументов Цикл
		Настройки.Добавить(НастройкаДокументаПоПараметру(НастройкаДокумента, , "ПолучитьSIDДокументовОбмена"));
	КонецЦикла;
	
	Запрос = Новый Запрос;
	
	//@skip-check bsl-variable-name-invalid
	мсвУсловия = Новый Массив();
	Если ЗначениеЗаполнено(ID) Тогда
		Запрос.УстановитьПараметр("ID", ID);
		мсвУсловия.Добавить("SUI_docs.id_doc В (&ID)");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(SID) Тогда
		Запрос.УстановитьПараметр("SID", SID);
		мсвУсловия.Добавить("SUI_docs.sid В (&SID)");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Настройки) Тогда
		Запрос.УстановитьПараметр("Настройки", Настройки);
		мсвУсловия.Добавить("SUI_docs.НастройкаДокумента В (&Настройки)");
	КонецЕсли;

	Если Запрос.Параметры.Количество() > 0 Тогда

		Запрос.Текст =
			"ВЫБРАТЬ
			|	SUI_docs.sid
			|ИЗ
			|	РегистрСведений.SUI_docs КАК SUI_docs
			|ГДЕ
			|	" + СтрСоединить(мсвУсловия, Символы.ПС + Символы.Таб + "И ");
		
		УстановитьПривилегированныйРежим(Истина);
		SIDДокументовОбмена = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("sid");
		УстановитьПривилегированныйРежим(Ложь);
		
	КонецЕсли;
	
	Возврат SIDДокументовОбмена;
	
КонецФункции

Процедура ЗарегистрироватьИзмененияДокументаОбмена(НаборЗаписей)
	
	Если НаборЗаписей.ДополнительныеСвойства.Свойство("НеРегистрироватьИзменения") Или
		Не НаборЗаписей.ДополнительныеСвойства.Свойство("РегистрироватьИзменения") Тогда
		Возврат;
	КонецЕсли;
	
	Если НаборЗаписей.Количество() <> 1 Тогда
		Возврат;
	КонецЕсли;
	
	Если НаборЗаписей[0].Состояние = Перечисления.SUI_СостоянияДокументовОбмена.Отменен Тогда 
		УдалитьРегистрациюИзмененийДокументаОбмена(НаборЗаписей);
		Возврат;
	КонецЕсли;
	
	Если НаборЗаписей[0].Состояние = Перечисления.SUI_СостоянияДокументовОбмена.Завершен Тогда 
		НаборЗаписей.ДополнительныеСвойства.Вставить("МобильныеУстройства", SUI_МобильныеУстройстваСервер.ВсеМобильныеУстройства());
		Если НаборЗаписей.ДополнительныеСвойства.Свойство("МобильноеУстройство") Тогда
			НаборЗаписей.ДополнительныеСвойства.Удалить("МобильноеУстройство");
		КонецЕсли;
	КонецЕсли;
	
	Если НаборЗаписей[0].Состояние <> Перечисления.SUI_СостоянияДокументовОбмена.КВыгрузке И
		НаборЗаписей[0].Состояние <> Перечисления.SUI_СостоянияДокументовОбмена.Загружен И
		НаборЗаписей[0].Состояние <> Перечисления.SUI_СостоянияДокументовОбмена.ВРаботе И
		НаборЗаписей[0].Состояние <> Перечисления.SUI_СостоянияДокументовОбмена.Завершен Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НастройкаДокумента", НаборЗаписей[0].НастройкаДокумента);
	Запрос.УстановитьПараметр("МобильныеУстройства", SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(
		НаборЗаписей.ДополнительныеСвойства, "МобильныеУстройства", Новый Массив(), Тип("Массив")));
	Запрос.УстановитьПараметр("МобильноеУстройство", SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(
		НаборЗаписей.ДополнительныеСвойства, "МобильноеУстройство"));
	Запрос.УстановитьПараметр("ИсключитьМобильноеУстройство", SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(
		НаборЗаписей.ДополнительныеСвойства, "ИсключитьМобильноеУстройство"));
	Запрос.Текст =
		"ВЫБРАТЬ
		|	SUI_МобильныеУстройства.Ссылка
		|ИЗ
		|	РегистрСведений.SUI_НастройкиДокументовМобильныхУстройств КАК SUI_НастройкиДокументовМобильныхКлиентов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланОбмена.SUI_МобильныеУстройства КАК SUI_МобильныеУстройства
		|		ПО SUI_МобильныеУстройства.Ссылка = SUI_НастройкиДокументовМобильныхКлиентов.МобильноеУстройство
		|ГДЕ
		|	SUI_НастройкиДокументовМобильныхКлиентов.НастройкаДокумента = &НастройкаДокумента
		|	И НЕ SUI_МобильныеУстройства.ПометкаУдаления
		|	И НЕ SUI_НастройкиДокументовМобильныхКлиентов.НастройкаДокумента.ПометкаУдаления
		|	И SUI_НастройкиДокументовМобильныхКлиентов.НастройкаДокумента.Используется
		|	И НЕ SUI_МобильныеУстройства.ЭтотУзел
		|	И #УсловиеПоМобильномуУстройству
		|	И ВЫБОР
		|		КОГДА &ИсключитьМобильноеУстройство <> НЕОПРЕДЕЛЕНО
		|			И &ИсключитьМобильноеУстройство <> ЗНАЧЕНИЕ(ПланОбмена.SUI_МобильныеУстройства.ПустаяСсылка)
		|			ТОГДА SUI_МобильныеУстройства.Ссылка <> &ИсключитьМобильноеУстройство
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ";
	
	Если ЗначениеЗаполнено(Запрос.Параметры.МобильноеУстройство) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "#УсловиеПоМобильномуУстройству", "SUI_МобильныеУстройства.Ссылка = &МобильноеУстройство");
	ИначеЕсли ЗначениеЗаполнено(Запрос.Параметры.МобильныеУстройства) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "#УсловиеПоМобильномуУстройству", "SUI_МобильныеУстройства.Ссылка В (&МобильныеУстройства)");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "#УсловиеПоМобильномуУстройству", "ИСТИНА");
	КонецЕсли;
	
	МобильныеУстройства = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Если МобильныеУстройства.Количество() > 0 Тогда
		
		Попытка
			ПланыОбмена.ЗарегистрироватьИзменения(МобильныеУстройства, НаборЗаписей);
		Исключение
			SUI_ЖурналРегистрации.ЗаписьВЖурналРегистрации(ИмяСобытия(), , 
				Метаданные.ОбщиеМодули.SUI_ДокументыОбмена, , ИнформацияОбОшибке());
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Возникла исключительная ошибка при регистрации изменений на мобильных устройствах документа обмена
				|%1'"), ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура УдалитьРегистрациюИзмененийДокументаОбмена(Знач НаборыЗаписей, МобильныеУстройства = Неопределено)
	
	Если МобильныеУстройства = Неопределено тогда
		ВсеМобильныеУстройства = SUI_МобильныеУстройстваСервер.ВсеМобильныеУстройства(Истина, Ложь);
	Иначе
		ВсеМобильныеУстройства = МобильныеУстройства;
	КонецЕсли;
	
	Если ТипЗнч(НаборыЗаписей) = Тип("РегистрСведенийНаборЗаписей.SUI_docs") Тогда
		НаборыЗаписей = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(НаборыЗаписей);
	КонецЕсли;
	
	Если ВсеМобильныеУстройства.Количество() > 0 Тогда

		Попытка
			
			Если ТипЗнч(НаборыЗаписей) <> Тип("Массив") Тогда
				
				Для Каждого МобильноеУстройство Из ВсеМобильныеУстройства Цикл
					ПланыОбмена.УдалитьРегистрациюИзменений(МобильноеУстройство, Метаданные.РегистрыСведений.SUI_docs);
				КонецЦикла;
				
			Иначе
				
				Для Каждого НаборЗаписей Из НаборыЗаписей Цикл
					ПланыОбмена.УдалитьРегистрациюИзменений(ВсеМобильныеУстройства, НаборЗаписей);
				КонецЦикла;
				
			КонецЕсли;

		Исключение
			SUI_ЖурналРегистрации.ЗаписьВЖурналРегистрации(ИмяСобытия(), , 
				Метаданные.ОбщиеМодули.SUI_ДокументыОбмена, , ИнформацияОбОшибке());
			ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Возникла исключительная ошибка при удалении регистрации изменений на мобильных устройствах документа обмена
				|%1'"), ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		
	КонецЕсли;
		
КонецПроцедуры

#Область ДанныеДокументаОбмена

Функция СформироватьДанныеДокументаОбменаИзДокумента(ДокументСсылка, НастройкаДокумента, НовоеСостояние = Неопределено)
	
	ДанныеДокумента = Новый Структура();
	ДанныеДокумента.Вставить("ДокументОбменаСуществует", Ложь);
	
	Идентификатор = ИдентификаторДокументаПоПараметру(ДокументСсылка, "СформироватьДанныеДокументаОбменаИзСсылкиДокумента");
	
	Если Не Идентификатор.Свойство("ID") Или Не ЗначениеЗаполнено(Идентификатор.ID) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	НастройкиДокумента = SUI_НастройкиДокументовСервер.СформироватьНастройкиДокумента(НастройкаДокумента);
	
	Если Не ЗначениеЗаполнено(НастройкиДокумента) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СерииИспользуются = SUI_НастройкиМетаданныхСервер.ТаблицаИспользуется(Перечисления.SUI_ТаблицыИнтеграции.СерииНоменклатуры);
	
	// Получение признака маркировки Начало
	Если НастройкиДокумента.ИспользуетсяМаркировка Тогда
		АлгоритмыПризнакМаркировки = SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(НастройкиДокумента, 
			"ДополнительныеНастройки." + SUI_ДокументыОбменаКлиентСервер.ДополнительныеНастройки_КлючАлгоритмыПризнакаМаркировки(),
			Новый Соответствие(), Тип("Соответствие"));
	Иначе
		АлгоритмыПризнакМаркировки = Новый Соответствие();
	КонецЕсли;
	// Получение признака маркировки Конец
	
	// Получение статуса указания серий Начало
	АлгоритмыСтатусУказанияСерий = SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(НастройкиДокумента, 
			"ДополнительныеНастройки." + SUI_ДокументыОбменаКлиентСервер.ДополнительныеНастройки_КлючАлгоритмыПолученияСтатусаУказанияСерии(),
			Новый Соответствие(), Тип("Соответствие"));
	// Получение статуса указания серий Конец
	
	// Дополнительные реквизиты Начало
	Если ПолучитьФункциональнуюОпцию("SUI_ИспользоватьДополнительныеРеквизитыТаблиц") Тогда
		АлгоритмыДополнительныхРеквизитов = SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(НастройкиДокумента, 
			"ДополнительныеНастройки." + SUI_ДокументыОбменаКлиентСервер.ДополнительныеНастройки_КлючАлгоритмыДополнительныхРеквизитов(),
			Новый Соответствие(), Тип("Соответствие"));
		ТаблицаВыводаДополнительныхПолей = SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(НастройкиДокумента, 
			"ТаблицаВыводаДополнительныхПолей", Новый ТаблицаЗначений, Тип("ТаблицаЗначений"));
	Иначе
		АлгоритмыДополнительныхРеквизитов = Новый Соответствие();
		ТаблицаВыводаДополнительныхПолей = Новый ТаблицаЗначений;
	КонецЕсли;
	// Дополнительные реквизиты Конец
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	SUI_docs.sid,
		|	SUI_docs.Состояние
		|ИЗ
		|	РегистрСведений.SUI_docs КАК SUI_docs
		|ГДЕ
		|	SUI_docs.id_doc = &id_doc
		|	И SUI_docs.НастройкаДокумента = &НастройкаДокумента";
	
	Запрос.УстановитьПараметр("id_doc", Идентификатор.ID);
	Запрос.УстановитьПараметр("НастройкаДокумента", НастройкаДокумента);
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = Запрос.Выполнить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Если РезультатЗапроса.Пустой() Тогда
		ДанныеДокумента.Вставить("sid", Строка(Новый УникальныйИдентификатор()));
		ДанныеДокумента.Вставить("Состояние");
	Иначе
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		ДанныеДокумента.Вставить("sid", Выборка.sid);
		ДанныеДокумента.Вставить("Состояние", Выборка.Состояние);
		ДанныеДокумента.ДокументОбменаСуществует = Истина;
	КонецЕсли;

	ДанныеДокумента.Вставить("id_doc", Идентификатор.ID);
	ДанныеДокумента.Вставить("НастройкаДокумента", НастройкаДокумента);
	ДанныеДокумента.Вставить("doc_type", НастройкиДокумента.ИмяДокументаМП);
	ДанныеДокумента.Вставить("КонтролироватьДокумент", НастройкиДокумента.КонтролироватьДокумент);
	ДанныеДокумента.Вставить("ЭтоДокументАдресногоХранения", НастройкиДокумента.ЭтоДокументАдресногоХранения);
	// artem - 29.08.24 - B119267 -
	ДанныеДокумента.Вставить("Агрегация", НастройкиДокумента.Агрегация);
	
	// Получение признака маркировки Начало
	ДобавитьПризнакИспользованияМаркировкиВПриемник(ДанныеДокумента, 
		ПолучитьАлгоритмИзКоллекции(АлгоритмыПризнакМаркировки, "ИзДокумента"), 
		Новый Структура("ДокументСсылка", ДокументСсылка));
	// Получение признака маркировки Конец 
	
	// Дополнительные реквизиты Начало
	SUI_ДополнительныеРеквизитыТаблиц.ДобавитьДополнительныеРеквизитыВПриемник(ДанныеДокумента, 
		ПолучитьАлгоритмИзКоллекции(АлгоритмыДополнительныхРеквизитов, "ИзДокумента"), 
		Новый Структура("ДокументСсылка", ДокументСсылка),,ТаблицаВыводаДополнительныхПолей);
	// Дополнительные реквизиты Конец
	
	// Штрихкод документа Начало
	ДанныеДокумента.Вставить("barcode", "");
	ВыполнитьПроизвольныйАлгоритм_ПолучитьШтрихкодДокумента(
		ПолучитьФункциональнуюОпцию("SUI_АлгоритмПолученияШтрихкодаДокумента"),
		ДокументСсылка, ДанныеДокумента.barcode);
	// Штрихкод документа Конец
	
	// Признак сбора ШК Начало
	Если ДокументСсылка.Метаданные() = Метаданные.Документы.SUI_СборШтрихкодов Тогда
		ДанныеДокумента.Вставить("is_barc_flow", Истина);
	Иначе
		ДанныеДокумента.Вставить("is_barc_flow", НастройкиДокумента.СборШтрихкодов);
	КонецЕсли;
	// Признак сбора ШК Конец
	
	// Реквизиты документа >>>
	//@skip-check bsl-variable-name-invalid
	мсвВыбрать = Новый Массив();
	//@skip-check bsl-variable-name-invalid
	сткПараметры = Новый Структура();
	Для Каждого НастройкаРеквизита Из НастройкиДокумента.Реквизиты Цикл
		
		Если ЗначениеЗаполнено(НастройкаРеквизита.Значение) Тогда
			
			Если НастройкаРеквизита.Значение.ПостоянноеЗначение <> Неопределено Тогда
				мсвВыбрать.Добавить("&" + НастройкаРеквизита.Ключ + " КАК " + НастройкаРеквизита.Ключ);
				сткПараметры.Вставить(НастройкаРеквизита.Ключ, НастройкаРеквизита.Значение.ПостоянноеЗначение); 
			ИначеЕсли НастройкаРеквизита.Значение.Имя <> Неопределено Тогда
				мсвВыбрать.Добавить(НастройкаРеквизита.Значение.Имя + " КАК " + НастройкаРеквизита.Ключ);
			Иначе
				мсвВыбрать.Добавить("НЕОПРЕДЕЛЕНО КАК " + НастройкаРеквизита.Ключ);
			КонецЕсли;

		Иначе
			мсвВыбрать.Добавить("НЕОПРЕДЕЛЕНО КАК " + НастройкаРеквизита.Ключ);
		КонецЕсли;
		
	КонецЦикла;
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ДокументСсылка", ДокументСсылка);
	Запрос.УстановитьПараметр("СостояниеДокументаОбмена", ДанныеДокумента.Состояние);
	
	Для Каждого сткПараметр Из сткПараметры Цикл
		Запрос.УстановитьПараметр(сткПараметр.Ключ, сткПараметр.Значение);
	КонецЦикла;
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА ПометкаУдаления 
		|			И &СостояниеДокументаОбмена <> ЗНАЧЕНИЕ(Перечисление.SUI_СостоянияДокументовОбмена.Завершен)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.SUI_СостоянияДокументовОбмена.Отменен)
		|		ИНАЧЕ &СостояниеДокументаОбмена
		|	КОНЕЦ КАК Состояние,
		|	" + СтрСоединить(мсвВыбрать, "," + Символы.ПС + Символы.Таб) + "
		|ИЗ
		|	" + ДокументСсылка.Метаданные().ПолноеИмя() + "
		|ГДЕ
		|	Ссылка = &ДокументСсылка";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
		ДанныеДокумента.Вставить(Колонка.Имя);
	КонецЦикла;
	
	Если Не ДанныеДокумента.Свойство("id_countragents") Тогда
		ДанныеДокумента.Вставить("id_countragents");
	КонецЕсли;
	
	Если Не ДанныеДокумента.Свойство("id_warehouse") Тогда
		ДанныеДокумента.Вставить("id_warehouse");
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	ЗаполнитьЗначенияСвойств(ДанныеДокумента, Выборка);

	SUI_ИнтеграцияВКонфигурацию.ПривестиСсылкиКИдентификаторамSimple(ДанныеДокумента, "НастройкаДокумента, Состояние");
	
	Если ДанныеДокумента.Состояние <> Перечисления.SUI_СостоянияДокументовОбмена.Отменен Тогда
		
		Если ТипЗнч(НовоеСостояние) = Тип("ПеречислениеСсылка.SUI_СостоянияДокументовОбмена") И
			ЗначениеЗаполнено(НовоеСостояние) Тогда
			ДанныеДокумента.Вставить("Состояние", НовоеСостояние);
		ИначеЕсли Не ЗначениеЗаполнено(ДанныеДокумента.Состояние) Тогда
			ДанныеДокумента.Состояние = НастройкиДокумента.СостояниеДокументаПоУмолчанию;
		КонецЕсли;
		
	КонецЕсли;
	
	// Табличные части документа >>>
	ДанныеДокумента.Вставить("Таблицы", Новый Соответствие());
	
	// Таблица Штрихкоды упаковок
	НастройкаТЧ = НастройкиДокумента.ТабличныеЧасти.Получить(Перечисления.SUI_ТипыТаблицДокументовОбмена.ШтрихкодыУпаковок);
	Если ЗначениеЗаполнено(НастройкаТЧ) Тогда
		
		НастройкаРеквизита = НастройкаТЧ.Элементы.Получить("id_marking_code");
		
		Если ЗначениеЗаполнено(НастройкаРеквизита) И 
			(НастройкаРеквизита.ПостоянноеЗначение <> Неопределено Или
			НастройкаРеквизита.Имя <> Неопределено) Тогда	
			
			Запрос = Новый Запрос();
			Если НастройкаРеквизита.ПостоянноеЗначение <> Неопределено Тогда
				Запрос.УстановитьПараметр("&id_marking_code", НастройкаРеквизита.ПостоянноеЗначение);
			КонецЕсли;
			Запрос.УстановитьПараметр("ДокументСсылка", ДокументСсылка);
			Запрос.Текст = "
			|ВЫБРАТЬ
			|	НомерСтроки КАК НомерСтроки,
			|	" + ?(НастройкаРеквизита.ПостоянноеЗначение <> Неопределено, "&id_marking_code", НастройкаРеквизита.Имя) + " КАК id
			|ИЗ
			|	" + ДокументСсылка.Метаданные().ПолноеИмя() + "." + НастройкаТЧ.ИмяТабличнойЧасти + "
			|ГДЕ
			|	Ссылка = &ДокументСсылка";
			
			РезультатЗапроса = Запрос.Выполнить();
			
			Если Не РезультатЗапроса.Пустой() Тогда
				
				ИдентификаторыШтрихкодовУпаковок = Новый ТаблицаЗначений();
				ИдентификаторыШтрихкодовУпаковок.Колонки.Добавить("НомерСтроки", SUI_ОбщегоНазначения.ОписаниеТипаЧисло(6));
				ИдентификаторыШтрихкодовУпаковок.Колонки.Добавить("id", SUI_ОбщегоНазначения.ОписаниеТипаСтрока(69));
				
				Выборка = РезультатЗапроса.Выбрать();
				Пока Выборка.Следующий() Цикл
					СтрокаИдентификаторыШтрихкодовУпаковок = ИдентификаторыШтрихкодовУпаковок.Добавить();
					СтрокаИдентификаторыШтрихкодовУпаковок.НомерСтроки = Выборка.НомерСтроки;
					СтрокаИдентификаторыШтрихкодовУпаковок.id = SUI_ИнтеграцияВКонфигурацию.ИдентификаторSimpleПоСсылке(Выборка.id, Истина)
				КонецЦикла;

				Запрос = Новый Запрос;
				Запрос.УстановитьПараметр("sid_doc", ДанныеДокумента.sid);
				Запрос.УстановитьПараметр("ИдентификаторыШтрихкодовУпаковок", ИдентификаторыШтрихкодовУпаковок);
				Запрос.Текст =
					"ВЫБРАТЬ
					|	ИдентификаторыШтрихкодовУпаковок.НомерСтроки,
					|	ИдентификаторыШтрихкодовУпаковок.id
					|ПОМЕСТИТЬ втИдентификаторыШтрихкодовУпаковок
					|ИЗ
					|	&ИдентификаторыШтрихкодовУпаковок КАК ИдентификаторыШтрихкодовУпаковок
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ
					|	&sid_doc КАК sid_doc,
					|	втИдентификаторыШтрихкодовУпаковок.НомерСтроки,
					|	SUI_tbl_marking_codes.id КАК id_marking_code,
					|	SUI_tbl_marking_codes.id_good КАК id_good,
					|	SUI_tbl_marking_codes.id_property КАК id_property,
					|	SUI_tbl_marking_codes.id_series КАК id_series,
					|	SUI_tbl_marking_codes.id_unit КАК id_unit,
					|	SUI_tbl_marking_codes.mark_code КАК mark_code,
					|	ЗНАЧЕНИЕ(Перечисление.SUI_СтатусыОбработкиСтрок.ОбработкаНеТребуется) КАК СтатусОбработки
					|ПОМЕСТИТЬ втШтрихкодыУпаковокДокумента
					|ИЗ
					|	втИдентификаторыШтрихкодовУпаковок КАК втИдентификаторыШтрихкодовУпаковок
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.SUI_tbl_marking_codes КАК SUI_tbl_marking_codes
					|		ПО втИдентификаторыШтрихкодовУпаковок.id = SUI_tbl_marking_codes.id
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|УНИЧТОЖИТЬ втИдентификаторыШтрихкодовУпаковок
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ
					|	ЕСТЬNULL(barcodesПоИдентификатору.sid, ЕСТЬNULL(barcodesПоЗначениюШтрихкода.sid, """")) КАК sid,
					|	втШтрихкодыУпаковокДокумента.sid_doc,
					|	втШтрихкодыУпаковокДокумента.НомерСтроки,
					|	втШтрихкодыУпаковокДокумента.id_marking_code,
					|	втШтрихкодыУпаковокДокумента.id_good,
					|	втШтрихкодыУпаковокДокумента.id_property,
					|	втШтрихкодыУпаковокДокумента.id_series,
					|	втШтрихкодыУпаковокДокумента.id_unit,
					|	втШтрихкодыУпаковокДокумента.mark_code,
					|	втШтрихкодыУпаковокДокумента.СтатусОбработки
					|ИЗ
					|	втШтрихкодыУпаковокДокумента КАК втШтрихкодыУпаковокДокумента
					|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.SUI_docs_tbl_barcodes КАК barcodesПоИдентификатору
					|		ПО втШтрихкодыУпаковокДокумента.sid_doc = barcodesПоИдентификатору.sid_doc
					|		И втШтрихкодыУпаковокДокумента.СтатусОбработки = barcodesПоИдентификатору.СтатусОбработки
					|		И втШтрихкодыУпаковокДокумента.id_marking_code = barcodesПоИдентификатору.id_marking_code
					|		И втШтрихкодыУпаковокДокумента.id_good = barcodesПоИдентификатору.id_good
					|		И втШтрихкодыУпаковокДокумента.id_property = barcodesПоИдентификатору.id_property
					|		И втШтрихкодыУпаковокДокумента.id_series = barcodesПоИдентификатору.id_series
					|		И втШтрихкодыУпаковокДокумента.id_unit = barcodesПоИдентификатору.id_unit
					|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.SUI_docs_tbl_barcodes КАК barcodesПоЗначениюШтрихкода
					|		ПО втШтрихкодыУпаковокДокумента.sid_doc = barcodesПоЗначениюШтрихкода.sid_doc
					|		И втШтрихкодыУпаковокДокумента.СтатусОбработки <> barcodesПоЗначениюШтрихкода.СтатусОбработки
					|		И втШтрихкодыУпаковокДокумента.mark_code = barcodesПоЗначениюШтрихкода.mark_code
					|		И втШтрихкодыУпаковокДокумента.id_good = barcodesПоЗначениюШтрихкода.id_good
					|		И втШтрихкодыУпаковокДокумента.id_property = barcodesПоЗначениюШтрихкода.id_property
					|		И втШтрихкодыУпаковокДокумента.id_series = barcodesПоЗначениюШтрихкода.id_series
					|		И втШтрихкодыУпаковокДокумента.id_unit = barcodesПоЗначениюШтрихкода.id_unit";
					
				РезультатЗапроса = Запрос.Выполнить();
				
				ТаблицаДанных = ТаблицаШтрихкодыДокументаОбмена();
				
				Если Не РезультатЗапроса.Пустой() Тогда
					
					// Дополнительные реквизиты Начало
					ДополнительныеРеквизиты_Алгоритм = ПолучитьАлгоритмИзКоллекции(АлгоритмыДополнительныхРеквизитов, 
						Перечисления.SUI_ТипыТаблицДокументовОбмена.ШтрихкодыУпаковок);
					// Дополнительные реквизиты Конец
					
					// Выборка строк из ТЧ Начало
					Если ЗначениеЗаполнено(ДополнительныеРеквизиты_Алгоритм) Тогда
						РезультатВыборкиТЧ = ПолучитьВыборкуТабличнойЧастиДокумента(ДокументСсылка, НастройкаТЧ.ИмяТабличнойЧасти);
					Иначе
						РезультатВыборкиТЧ = Неопределено;
					КонецЕсли;
					// Выборка строк из ТЧ Конец
				
					ИменаКолонокЗапроса = SUI_ОбщегоНазначения.ПолучитьИменаКолонокРезультатаЗапроса(РезультатЗапроса);
					
					Выборка = РезультатЗапроса.Выбрать();
					
					Пока Выборка.Следующий() Цикл
						
						ДанныеЗапроса = Новый Структура(ИменаКолонокЗапроса);
						ЗаполнитьЗначенияСвойств(ДанныеЗапроса, Выборка);
						
						Если Не ЗначениеЗаполнено(ДанныеЗапроса.sid) Тогда
							ДанныеЗапроса.sid = Строка(Новый УникальныйИдентификатор());
						КонецЕсли;
						
						SUI_ИнтеграцияВКонфигурацию.ПривестиСсылкиКИдентификаторамSimple(ДанныеЗапроса, "СтатусОбработки");
						
						// Параметры алгоритма строки ТЧ Начало
						ПараметрыАлгоритма = Неопределено;
						Если РезультатВыборкиТЧ <> Неопределено Тогда
							РезультатВыборкиТЧ.Выборка.Сбросить();
							Если РезультатВыборкиТЧ.Выборка.НайтиСледующий(Новый Структура("НомерСтроки", Выборка.НомерСтроки)) Тогда
								ПараметрыАлгоритма = Новый Структура("ДанныеСтроки", Новый Структура(РезультатВыборкиТЧ.Колонки));
								ЗаполнитьЗначенияСвойств(ПараметрыАлгоритма.ДанныеСтроки, РезультатВыборкиТЧ.Выборка);
							КонецЕсли;
						КонецЕсли;
						// Параметры алгоритма строки ТЧ Конец
						
						// Дополнительные реквизиты Начало
						SUI_ДополнительныеРеквизитыТаблиц.ДобавитьДополнительныеРеквизитыВПриемник(ДанныеЗапроса, 
							ДополнительныеРеквизиты_Алгоритм, ПараметрыАлгоритма);
						// Дополнительные реквизиты Конец
						
						ЗаполнитьЗначенияСвойств(ТаблицаДанных.Добавить(), ДанныеЗапроса);
						
					КонецЦикла;
				
				КонецЕсли;
				
				ДанныеДокумента.Таблицы.Вставить(Перечисления.SUI_ТипыТаблицДокументовОбмена.ШтрихкодыУпаковок, ТаблицаДанных);
				
			КонецЕсли;				
			
		КонецЕсли;

	КонецЕсли;
	
	// Таблица Серии
	НастройкаТЧ = НастройкиДокумента.ТабличныеЧасти.Получить(Перечисления.SUI_ТипыТаблицДокументовОбмена.Серии);
	Если ЗначениеЗаполнено(НастройкаТЧ) И СерииИспользуются Тогда
		
		мсвВыбрать = Новый Массив();
		сткПараметры = Новый Структура();
		Для Каждого РеквизитТЧ Из НастройкаТЧ.Элементы Цикл
			
			ТекстВыбораДобавлен = Ложь;
			
			Если ЗначениеЗаполнено(РеквизитТЧ.Значение) Тогда
				
				Если РеквизитТЧ.Значение.ПостоянноеЗначение <> Неопределено Тогда
					мсвВыбрать.Добавить("&" + РеквизитТЧ.Ключ + " КАК " + РеквизитТЧ.Ключ);
					сткПараметры.Вставить(РеквизитТЧ.Ключ, РеквизитТЧ.Значение.ПостоянноеЗначение);
					ТекстВыбораДобавлен = Истина;
				ИначеЕсли РеквизитТЧ.Значение.Имя <> Неопределено Тогда
					мсвВыбрать.Добавить(РеквизитТЧ.Значение.Имя + " КАК " + РеквизитТЧ.Ключ);
					ТекстВыбораДобавлен = Истина;
				КонецЕсли;
				
			КонецЕсли;
			
			Если Не ТекстВыбораДобавлен Тогда
				Если РеквизитТЧ.Ключ = "id_good" Или РеквизитТЧ.Ключ = "id_series" Тогда
					мсвВыбрать = Новый Массив();
					Прервать;
				КонецЕсли;
				мсвВыбрать.Добавить("НЕОПРЕДЕЛЕНО КАК " + РеквизитТЧ.Ключ);
			КонецЕсли;
			
		КонецЦикла;
		
		Если ЗначениеЗаполнено(мсвВыбрать) Тогда
			
			мсвВыбрать.Добавить("НомерСтроки КАК НомерСтроки");
			
			Запрос = Новый Запрос();
			Запрос.УстановитьПараметр("ДокументСсылка", ДокументСсылка);
			Для Каждого сткПараметр Из сткПараметры Цикл
				Запрос.УстановитьПараметр(сткПараметр.Ключ, сткПараметр.Значение);
			КонецЦикла;
			Запрос.Текст = "
			|ВЫБРАТЬ
			|	" + СтрСоединить(мсвВыбрать, "," + Символы.ПС + Символы.Таб) + "
			|ИЗ
			|	" + ДокументСсылка.Метаданные().ПолноеИмя() + "." + НастройкаТЧ.ИмяТабличнойЧасти + "
			|ГДЕ
			|	Ссылка = &ДокументСсылка";
			
			РезультатЗапроса = Запрос.Выполнить();

			Если Не РезультатЗапроса.Пустой() Тогда
				
				// Дополнительные реквизиты Начало
				ДополнительныеРеквизиты_Алгоритм = ПолучитьАлгоритмИзКоллекции(АлгоритмыДополнительныхРеквизитов, 
					Перечисления.SUI_ТипыТаблицДокументовОбмена.Серии);
				// Дополнительные реквизиты Конец
				
				// Выборка строк из ТЧ Начало
				Если ЗначениеЗаполнено(ДополнительныеРеквизиты_Алгоритм) Тогда
					РезультатВыборкиТЧ = ПолучитьВыборкуТабличнойЧастиДокумента(ДокументСсылка, НастройкаТЧ.ИмяТабличнойЧасти);
				Иначе
					РезультатВыборкиТЧ = Неопределено;
				КонецЕсли;
				// Выборка строк из ТЧ Конец
				
				ТаблицаДанныхИзДокумента = ТаблицаСерииДокументаОбмена();
				
				ИменаКолонокЗапроса = SUI_ОбщегоНазначения.ПолучитьИменаКолонокРезультатаЗапроса(РезультатЗапроса);
				
				Выборка = РезультатЗапроса.Выбрать();
				
				Пока Выборка.Следующий() Цикл
					
					ДанныеЗапроса = Новый Структура(ИменаКолонокЗапроса);
					ЗаполнитьЗначенияСвойств(ДанныеЗапроса, Выборка);
					SUI_ИнтеграцияВКонфигурацию.ПривестиСсылкиКИдентификаторамSimple(ДанныеЗапроса);
					
					// Параметры алгоритма строки ТЧ Начало
					ПараметрыАлгоритма = Неопределено;
					Если РезультатВыборкиТЧ <> Неопределено Тогда
						РезультатВыборкиТЧ.Выборка.Сбросить();
						Если РезультатВыборкиТЧ.Выборка.НайтиСледующий(Новый Структура("НомерСтроки", Выборка.НомерСтроки)) Тогда
							ПараметрыАлгоритма = Новый Структура("ДанныеСтроки", Новый Структура(РезультатВыборкиТЧ.Колонки));
							ЗаполнитьЗначенияСвойств(ПараметрыАлгоритма.ДанныеСтроки, РезультатВыборкиТЧ.Выборка);
						КонецЕсли;
					КонецЕсли;
					// Параметры алгоритма строки ТЧ Конец
					
					// Дополнительные реквизиты Начало
					SUI_ДополнительныеРеквизитыТаблиц.ДобавитьДополнительныеРеквизитыВПриемник(ДанныеЗапроса, 
						ДополнительныеРеквизиты_Алгоритм, ПараметрыАлгоритма);
					// Дополнительные реквизиты Конец
					
					ЗаполнитьЗначенияСвойств(ТаблицаДанныхИзДокумента.Добавить(), ДанныеЗапроса);
					
				КонецЦикла;
			
				Запрос = Новый Запрос;
				Запрос.УстановитьПараметр("sid_doc", ДанныеДокумента.sid);
				Запрос.УстановитьПараметр("ТаблицаДанныхИзДокумента", ТаблицаДанныхИзДокумента);
				Запрос.Текст =
					"ВЫБРАТЬ
					|	ТаблицаДанныхИзДокумента.id_good,
					|	ТаблицаДанныхИзДокумента.id_properties,
					|	ТаблицаДанныхИзДокумента.id_series,
					|	ТаблицаДанныхИзДокумента.id_warehouse,
					|	ТаблицаДанныхИзДокумента.qtty,
					|	ТаблицаДанныхИзДокумента.additional_details
					|ПОМЕСТИТЬ втТаблицаДанныхИзДокумента
					|ИЗ
					|	&ТаблицаДанныхИзДокумента КАК ТаблицаДанныхИзДокумента
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ
					|	ЕСТЬNULL(SUI_docs_tbl_series.sid, """") КАК sid,
					|	&sid_doc,
					|	втТаблицаДанныхИзДокумента.id_good,
					|	втТаблицаДанныхИзДокумента.id_properties,
					|	втТаблицаДанныхИзДокумента.id_series,
					|	втТаблицаДанныхИзДокумента.id_warehouse,
					|	втТаблицаДанныхИзДокумента.qtty,
					|	втТаблицаДанныхИзДокумента.additional_details,
					|	ЗНАЧЕНИЕ(Перечисление.SUI_СтатусыОбработкиСтрок.ОбработкаНеТребуется) КАК СтатусОбработки
					|ИЗ
					|	втТаблицаДанныхИзДокумента КАК втТаблицаДанныхИзДокумента
					|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.SUI_docs_tbl_series КАК SUI_docs_tbl_series
					|		ПО SUI_docs_tbl_series.sid_doc = &sid_doc
					|		И SUI_docs_tbl_series.id_good = втТаблицаДанныхИзДокумента.id_good
					|		И SUI_docs_tbl_series.id_properties = втТаблицаДанныхИзДокумента.id_properties
					|		И SUI_docs_tbl_series.id_series = втТаблицаДанныхИзДокумента.id_series
					|		И SUI_docs_tbl_series.id_warehouse = втТаблицаДанныхИзДокумента.id_warehouse
					|ГДЕ
					|	втТаблицаДанныхИзДокумента.id_good <> """"
					|	И втТаблицаДанныхИзДокумента.id_series <> """"
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|УНИЧТОЖИТЬ втТаблицаДанныхИзДокумента";
					
				РезультатЗапроса = Запрос.Выполнить();
				
				ТаблицаДанных = ТаблицаСерииДокументаОбмена();
				
				Если Не РезультатЗапроса.Пустой() Тогда
					
					ИменаКолонокЗапроса = SUI_ОбщегоНазначения.ПолучитьИменаКолонокРезультатаЗапроса(РезультатЗапроса);
					
					Выборка = РезультатЗапроса.Выбрать();
					
					Пока Выборка.Следующий() Цикл
						
						ДанныеЗапроса = Новый Структура(ИменаКолонокЗапроса);
						ЗаполнитьЗначенияСвойств(ДанныеЗапроса, Выборка);
						
						Если Не ЗначениеЗаполнено(ДанныеЗапроса.sid) Тогда
							ДанныеЗапроса.sid = Строка(Новый УникальныйИдентификатор());
						КонецЕсли;
	
						ЗаполнитьЗначенияСвойств(ТаблицаДанных.Добавить(), ДанныеЗапроса);
						
					КонецЦикла;
				
				КонецЕсли;
			
				ДанныеДокумента.Таблицы.Вставить(Перечисления.SUI_ТипыТаблицДокументовОбмена.Серии, ТаблицаДанных);
			
			КонецЕсли;
			
		КонецЕсли;

	КонецЕсли;
	
	// Таблицы Товары, Отбор, Размещение
	Для Каждого НастройкаТЧ Из НастройкиДокумента.ТабличныеЧасти Цикл
		
		Если Не ЗначениеЗаполнено(НастройкаТЧ.Значение) Или
			(НастройкаТЧ.Ключ <> Перечисления.SUI_ТипыТаблицДокументовОбмена.Товары И
			НастройкаТЧ.Ключ <> Перечисления.SUI_ТипыТаблицДокументовОбмена.Отбор И
			НастройкаТЧ.Ключ <> Перечисления.SUI_ТипыТаблицДокументовОбмена.Размещение) Тогда
			Продолжить;
		КонецЕсли;
		
		ТекстВыбрать_use_series = "ВЫБОР
		|	КОГДА ТИПЗНАЧЕНИЯ(&СтатусУказанияСерий_use_series) = ТИП(ЧИСЛО)
		|		ТОГДА ВЫБОР
		|				КОГДА &СтатусУказанияСерий_use_series > 0
		|					ТОГДА 1
		|				ИНАЧЕ 0
		|			КОНЕЦ
		|	КОГДА ТИПЗНАЧЕНИЯ(&СтатусУказанияСерий_use_series) = ТИП(БУЛЕВО)
		|		ТОГДА ВЫБОР
		|				КОГДА &СтатусУказанияСерий_use_series = ИСТИНА
		|					ТОГДА 1
		|				ИНАЧЕ 0
		|			КОНЕЦ
		|	ИНАЧЕ 0
		|КОНЕЦ КАК use_series";
		
		мсвВыбрать = Новый Массив();
		сткПараметры = Новый Структура();
		Для Каждого РеквизитТЧ Из НастройкаТЧ.Значение.Элементы Цикл
			
			ТекстВыбораДобавлен = Ложь;
			
			Если ЗначениеЗаполнено(РеквизитТЧ.Значение) Тогда
				
				Если РеквизитТЧ.Значение.ПостоянноеЗначение <> Неопределено Тогда
					
					Если РеквизитТЧ.Ключ = "use_series" Тогда
						мсвВыбрать.Добавить(ТекстВыбрать_use_series);
						сткПараметры.Вставить("СтатусУказанияСерий_use_series", РеквизитТЧ.Значение.ПостоянноеЗначение);
					Иначе
						мсвВыбрать.Добавить("&" + РеквизитТЧ.Ключ + " КАК " + РеквизитТЧ.Ключ);
						сткПараметры.Вставить(РеквизитТЧ.Ключ, РеквизитТЧ.Значение.ПостоянноеЗначение);
					КонецЕсли;
					
					ТекстВыбораДобавлен = Истина;
					
				ИначеЕсли РеквизитТЧ.Значение.Имя <> Неопределено Тогда
					
					Если РеквизитТЧ.Ключ = "use_series" Тогда
						мсвВыбрать.Добавить(
							СтрЗаменить(ТекстВыбрать_use_series, "&СтатусУказанияСерий_use_series", РеквизитТЧ.Значение.Имя));
					Иначе
						мсвВыбрать.Добавить(РеквизитТЧ.Значение.Имя + " КАК " + РеквизитТЧ.Ключ);
					КонецЕсли;
					
					ТекстВыбораДобавлен = Истина;

				КонецЕсли;
	
			КонецЕсли;
			
			Если Не ТекстВыбораДобавлен Тогда
				
				Если РеквизитТЧ.Ключ = "id_good" Или 
					РеквизитТЧ.Ключ = "qtty_plan" Или
					(РеквизитТЧ.Ключ = "id_cell" И 
					(НастройкаТЧ.Ключ = Перечисления.SUI_ТипыТаблицДокументовОбмена.Отбор И
					НастройкаТЧ.Ключ = Перечисления.SUI_ТипыТаблицДокументовОбмена.Размещение)) Тогда
					мсвВыбрать = Новый Массив();
					Прервать;
				КонецЕсли;
				
				мсвВыбрать.Добавить("НЕОПРЕДЕЛЕНО КАК " + РеквизитТЧ.Ключ);
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если ЗначениеЗаполнено(мсвВыбрать) Тогда
			
			мсвВыбрать.Добавить("НомерСтроки КАК НомерСтроки");
			
			Запрос = Новый Запрос();
			Запрос.УстановитьПараметр("ТипТаблицы", НастройкаТЧ.Ключ);
			Запрос.УстановитьПараметр("ДокументСсылка", ДокументСсылка);
			Для Каждого сткПараметр Из сткПараметры Цикл
				Запрос.УстановитьПараметр(сткПараметр.Ключ, сткПараметр.Значение);
			КонецЦикла;
			Запрос.Текст = "
			|ВЫБРАТЬ
			|	&ТипТаблицы КАК ТипТаблицы,
			|	" + СтрСоединить(мсвВыбрать, "," + Символы.ПС + Символы.Таб) + "
			|ИЗ
			|	" + ДокументСсылка.Метаданные().ПолноеИмя() + "." + НастройкаТЧ.Значение.ИмяТабличнойЧасти + "
			|ГДЕ
			|	Ссылка = &ДокументСсылка";
			
			//@skip-check query-in-loop
			РезультатЗапроса = Запрос.Выполнить();
			
			Если Не РезультатЗапроса.Пустой() Тогда
				
				// Признак использования маркировки Начало
				АлгоритмПризнакаМаркировкиВСтроке = ПолучитьАлгоритмИзКоллекции(АлгоритмыПризнакМаркировки, НастройкаТЧ.Ключ);
				// Признак использования маркировки Конец
				
				// Признак использования маркировки Начало
				АлгоритмСтатусУказанияСерийВСтроке = ПолучитьАлгоритмИзКоллекции(АлгоритмыСтатусУказанияСерий, НастройкаТЧ.Ключ);
				// Признак использования маркировки Конец

				// Дополнительные реквизиты Начало
				ДополнительныеРеквизиты_Алгоритм = ПолучитьАлгоритмИзКоллекции(АлгоритмыДополнительныхРеквизитов, НастройкаТЧ.Ключ);
				// Дополнительные реквизиты Конец
				
				// Выборка строк из ТЧ Начало
				Если ЗначениеЗаполнено(АлгоритмПризнакаМаркировкиВСтроке) Или ЗначениеЗаполнено(ДополнительныеРеквизиты_Алгоритм)
					Или ЗначениеЗаполнено(АлгоритмСтатусУказанияСерийВСтроке) Тогда
					РезультатВыборкиТЧ = ПолучитьВыборкуТабличнойЧастиДокумента(ДокументСсылка, НастройкаТЧ.Значение.ИмяТабличнойЧасти);
				Иначе
					РезультатВыборкиТЧ = Неопределено;
				КонецЕсли;
				// Выборка строк из ТЧ Конец
				
				ТаблицаДанныхИзДокумента = ТаблицаТоварыДокументаОбмена();
				
				ИменаКолонокЗапроса = SUI_ОбщегоНазначения.ПолучитьИменаКолонокРезультатаЗапроса(РезультатЗапроса);
				
				Выборка = РезультатЗапроса.Выбрать();
				
				Пока Выборка.Следующий() Цикл
					
					ДанныеЗапроса = Новый Структура(ИменаКолонокЗапроса);
					ЗаполнитьЗначенияСвойств(ДанныеЗапроса, Выборка);
					SUI_ИнтеграцияВКонфигурацию.ПривестиСсылкиКИдентификаторамSimple(ДанныеЗапроса, "ТипТаблицы");
					
					// Параметры алгоритма строки ТЧ Начало
					ПараметрыАлгоритма = Неопределено;
					Если РезультатВыборкиТЧ <> Неопределено Тогда
						РезультатВыборкиТЧ.Выборка.Сбросить();
						Если РезультатВыборкиТЧ.Выборка.НайтиСледующий(Новый Структура("НомерСтроки", Выборка.НомерСтроки)) Тогда
							ПараметрыАлгоритма = Новый Структура("ДанныеСтроки", Новый Структура(РезультатВыборкиТЧ.Колонки));
							ЗаполнитьЗначенияСвойств(ПараметрыАлгоритма.ДанныеСтроки, РезультатВыборкиТЧ.Выборка);
						КонецЕсли;
					КонецЕсли;
					// Параметры алгоритма строки ТЧ Конец
					
					// Признак использования маркировки Начало
					ДобавитьПризнакИспользованияМаркировкиВПриемник(ДанныеЗапроса, 
						АлгоритмПризнакаМаркировкиВСтроке, ПараметрыАлгоритма);
					// Признак использования маркировки Конец
					
					// Получение статуса указания серии Начало
					ДобавитьСтатусУказанияСерийВПриемник(ДанныеЗапроса, 
						АлгоритмСтатусУказанияСерийВСтроке, ПараметрыАлгоритма);
					// Получение статуса указания серии Конец
					
					// Дополнительные реквизиты Начало
					SUI_ДополнительныеРеквизитыТаблиц.ДобавитьДополнительныеРеквизитыВПриемник(ДанныеЗапроса, 
						ДополнительныеРеквизиты_Алгоритм, ПараметрыАлгоритма);
					// Дополнительные реквизиты Конец
					
					ЗаполнитьЗначенияСвойств(ТаблицаДанныхИзДокумента.Добавить(), ДанныеЗапроса);
					
				КонецЦикла;

				Запрос = Новый Запрос;
				Запрос.УстановитьПараметр("sid_doc", ДанныеДокумента.sid);
				Запрос.УстановитьПараметр("ТаблицаДанныхИзДокумента", ТаблицаДанныхИзДокумента);
				Запрос.Текст =
					"ВЫБРАТЬ
					|	ТаблицаДанныхИзДокумента.id_good,
					|	ТаблицаДанныхИзДокумента.id_properties,
					|	ТаблицаДанныхИзДокумента.id_series,
					|	ТаблицаДанныхИзДокумента.id_cell,
					|	ТаблицаДанныхИзДокумента.id_unit,
					|	ТаблицаДанныхИзДокумента.id_price,
					|	ТаблицаДанныхИзДокумента.price,
					|	ТаблицаДанныхИзДокумента.qtty_plan,
					|	ТаблицаДанныхИзДокумента.qtty,
					|	ТаблицаДанныхИзДокумента.use_series,
					|	ТаблицаДанныхИзДокумента.use_mark,
					|	ТаблицаДанныхИзДокумента.additional_details,
					|	ТаблицаДанныхИзДокумента.ТипТаблицы
					|ПОМЕСТИТЬ втТаблицаДанныхИзДокумента
					|ИЗ
					|	&ТаблицаДанныхИзДокумента КАК ТаблицаДанныхИзДокумента
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ
					|	ЕСТЬNULL(SUI_docs_tbl_goods.sid, """") КАК sid,
					|	&sid_doc,
					|	втТаблицаДанныхИзДокумента.id_good,
					|	втТаблицаДанныхИзДокумента.id_properties,
					|	втТаблицаДанныхИзДокумента.id_series,
					|	втТаблицаДанныхИзДокумента.id_cell,
					|	втТаблицаДанныхИзДокумента.id_unit,
					|	втТаблицаДанныхИзДокумента.id_price,
					|	втТаблицаДанныхИзДокумента.price,
					|	втТаблицаДанныхИзДокумента.qtty_plan,
					|	ЕСТЬNULL(SUI_docs_tbl_goods.qtty, 0) КАК qtty,
					|	втТаблицаДанныхИзДокумента.use_series,
					|	втТаблицаДанныхИзДокумента.use_mark,
					|	втТаблицаДанныхИзДокумента.additional_details,
					|	втТаблицаДанныхИзДокумента.ТипТаблицы
					|ИЗ
					|	втТаблицаДанныхИзДокумента КАК втТаблицаДанныхИзДокумента
					|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.SUI_docs_tbl_goods КАК SUI_docs_tbl_goods
					|		ПО SUI_docs_tbl_goods.sid_doc = &sid_doc
					|		И втТаблицаДанныхИзДокумента.id_good = SUI_docs_tbl_goods.id_good
					|		И втТаблицаДанныхИзДокумента.id_properties = SUI_docs_tbl_goods.id_properties
					|		И втТаблицаДанныхИзДокумента.id_series = SUI_docs_tbl_goods.id_series
					|		И втТаблицаДанныхИзДокумента.id_cell = SUI_docs_tbl_goods.id_cell
					|		И втТаблицаДанныхИзДокумента.id_unit = SUI_docs_tbl_goods.id_unit
					|		И втТаблицаДанныхИзДокумента.id_price = SUI_docs_tbl_goods.id_price
					|		И втТаблицаДанныхИзДокумента.ТипТаблицы = SUI_docs_tbl_goods.ТипТаблицы
					|ГДЕ
					|	втТаблицаДанныхИзДокумента.id_good <> """";
					|
					|////////////////////////////////////////////////////////////////////////////////
					|УНИЧТОЖИТЬ втТаблицаДанныхИзДокумента";
					
				//@skip-check query-in-loop
				РезультатЗапроса = Запрос.Выполнить();
				
				ТаблицаДанных = ТаблицаТоварыДокументаОбмена();
				
				Если Не РезультатЗапроса.Пустой() Тогда
					
					ИменаКолонокЗапроса = SUI_ОбщегоНазначения.ПолучитьИменаКолонокРезультатаЗапроса(РезультатЗапроса);
					
					Выборка = РезультатЗапроса.Выбрать();
					
					Пока Выборка.Следующий() Цикл
						
						ДанныеЗапроса = Новый Структура(ИменаКолонокЗапроса);
						ЗаполнитьЗначенияСвойств(ДанныеЗапроса, Выборка);
						
						Если Не ЗначениеЗаполнено(ДанныеЗапроса.sid) Тогда
							ДанныеЗапроса.sid = Строка(Новый УникальныйИдентификатор());
						КонецЕсли;
						
						ЗаполнитьЗначенияСвойств(ТаблицаДанных.Добавить(), ДанныеЗапроса);
						
					КонецЦикла;
				
				КонецЕсли;
				
				ДанныеДокумента.Таблицы.Вставить(НастройкаТЧ.Ключ, ТаблицаДанных);
			
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Перезаполнить таблицу серий по таблице товаров, отбора и размещения
	Если СерииИспользуются Тогда
	
		ТаблицаСерий = ДанныеДокумента.Таблицы.Получить(Перечисления.SUI_ТипыТаблицДокументовОбмена.Серии);
		Если ТаблицаСерий = Неопределено Тогда
			ТаблицаСерий = ТаблицаСерииДокументаОбмена();
		КонецЕсли;
		
		Для Каждого Таблица Из ДанныеДокумента.Таблицы Цикл
			
			Если Таблица.Ключ <> Перечисления.SUI_ТипыТаблицДокументовОбмена.Товары И
				Таблица.Ключ <> Перечисления.SUI_ТипыТаблицДокументовОбмена.Отбор И
				Таблица.Ключ <> Перечисления.SUI_ТипыТаблицДокументовОбмена.Размещение Тогда
				Продолжить;
			КонецЕсли;
			
			Запрос = Новый Запрос();
			Запрос.УстановитьПараметр("ШаблонИдентификатораSimple", SUI_ИнтеграцияВКонфигурациюКлиентСервер.ШаблонИдентификатораSimple());
			Запрос.УстановитьПараметр("ТаблицаСерий", ТаблицаСерий.Скопировать());
			Запрос.УстановитьПараметр("Таблица", Таблица.Значение);
			Запрос.Текст = "ВЫБРАТЬ
			|	ТаблицаСерий.sid,
			|	ТаблицаСерий.sid_doc,
			|	ТаблицаСерий.id_good,
			|	ТаблицаСерий.id_properties,
			|	ТаблицаСерий.id_series,
			|	ТаблицаСерий.id_warehouse,
			|	ТаблицаСерий.qtty,
			|	ТаблицаСерий.СтатусОбработки
			|ПОМЕСТИТЬ втТаблицаСерий
			|ИЗ
			|	&ТаблицаСерий КАК ТаблицаСерий
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	Таблица.sid_doc,
			|	Таблица.id_good,
			|	Таблица.id_properties,
			|	Таблица.id_series,
			|	Таблица.qtty_plan КАК qtty
			|ПОМЕСТИТЬ втТаблица
			|ИЗ
			|	&Таблица КАК Таблица
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	втТаблица.sid_doc,
			|	втТаблица.id_good,
			|	втТаблица.id_properties,
			|	втТаблица.id_series,
			|	СУММА(втТаблица.qtty) КАК qtty,
			|	ЗНАЧЕНИЕ(Перечисление.SUI_СтатусыОбработкиСтрок.ОбработкаНеТребуется) КАК СтатусОбработки
			|ПОМЕСТИТЬ втТаблицаФильтр
			|ИЗ
			|	втТаблица КАК втТаблица
			|ГДЕ
			|	втТаблица.id_good ПОДОБНО &ШаблонИдентификатораSimple
			|	И втТаблица.id_series ПОДОБНО &ШаблонИдентификатораSimple
			|СГРУППИРОВАТЬ ПО
			|	втТаблица.sid_doc,
			|	втТаблица.id_good,
			|	втТаблица.id_properties,
			|	втТаблица.id_series,
			|	ЗНАЧЕНИЕ(Перечисление.SUI_СтатусыОбработкиСтрок.ОбработкаНеТребуется)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ втТаблица
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ЕСТЬNULL(втТаблицаСерий.sid, """") КАК sid,
			|	ЕСТЬNULL(втТаблицаСерий.sid_doc, втТаблицаФильтр.sid_doc) КАК sid_doc,
			|	ЕСТЬNULL(втТаблицаСерий.id_good, втТаблицаФильтр.id_good) КАК id_good,
			|	ЕСТЬNULL(втТаблицаСерий.id_properties, втТаблицаФильтр.id_properties) КАК id_properties,
			|	ЕСТЬNULL(втТаблицаСерий.id_series, втТаблицаФильтр.id_series) КАК id_series,
			|	ЕСТЬNULL(втТаблицаСерий.id_warehouse, """") КАК id_warehouse,
			|	ЕСТЬNULL(втТаблицаСерий.qtty, втТаблицаФильтр.qtty) КАК qtty,
			|	ЕСТЬNULL(втТаблицаСерий.СтатусОбработки, втТаблицаФильтр.СтатусОбработки) КАК СтатусОбработки
			|ПОМЕСТИТЬ втСерииДокумента
			|ИЗ
			|	втТаблицаСерий КАК втТаблицаСерий
			|		ПОЛНОЕ СОЕДИНЕНИЕ втТаблицаФильтр КАК втТаблицаФильтр
			|		ПО втТаблицаСерий.sid_doc = втТаблицаФильтр.sid_doc
			|		И втТаблицаСерий.id_good = втТаблицаФильтр.id_good
			|		И втТаблицаСерий.id_properties = втТаблицаФильтр.id_properties
			|		И втТаблицаСерий.id_series = втТаблицаФильтр.id_series
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ втТаблицаСерий
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ втТаблицаФильтр
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ЕСТЬNULL(SUI_docs_tbl_series.sid, втСерииДокумента.sid) КАК sid,
			|	втСерииДокумента.sid_doc,
			|	втСерииДокумента.id_good,
			|	втСерииДокумента.id_properties,
			|	втСерииДокумента.id_series,
			|	втСерииДокумента.id_warehouse,
			|	втСерииДокумента.qtty,
			|	втСерииДокумента.СтатусОбработки
			|ПОМЕСТИТЬ втСерииДокументаФильтр
			|ИЗ
			|	втСерииДокумента КАК втСерииДокумента
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.SUI_docs_tbl_series КАК SUI_docs_tbl_series
			|		ПО втСерииДокумента.sid_doc = SUI_docs_tbl_series.sid_doc
			|		И втСерииДокумента.id_good = SUI_docs_tbl_series.id_good
			|		И втСерииДокумента.id_properties = SUI_docs_tbl_series.id_properties
			|		И втСерииДокумента.id_series = SUI_docs_tbl_series.id_series
			|		И ВЫБОР
			|			КОГДА втСерииДокумента.sid <> """"
			|				ТОГДА втСерииДокумента.sid = SUI_docs_tbl_series.sid
			|			ИНАЧЕ ИСТИНА
			|		КОНЕЦ
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ втСерииДокумента
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	втСерииДокумента.sid,
			|	втСерииДокумента.sid_doc,
			|	втСерииДокумента.id_good,
			|	втСерииДокумента.id_properties,
			|	втСерииДокумента.id_series,
			|	втСерииДокумента.id_warehouse,
			|	СУММА(втСерииДокумента.qtty) КАК qtty,
			|	втСерииДокумента.СтатусОбработки
			|ИЗ
			|	втСерииДокументаФильтр КАК втСерииДокумента
			|СГРУППИРОВАТЬ ПО
			|	втСерииДокумента.sid,
			|	втСерииДокумента.sid_doc,
			|	втСерииДокумента.id_good,
			|	втСерииДокумента.id_properties,
			|	втСерииДокумента.id_series,
			|	втСерииДокумента.id_warehouse,
			|	втСерииДокумента.СтатусОбработки
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ втСерииДокументаФильтр";
			
			//@skip-check query-in-loop
			РезультатЗапроса = Запрос.Выполнить();
			
			Если Не РезультатЗапроса.Пустой() Тогда
				
				ТаблицаСерий = ТаблицаСерииДокументаОбмена();
				
				Выборка = РезультатЗапроса.Выбрать();
				
				Пока Выборка.Следующий() Цикл
					
					СтрокаТаблицыСерий = ТаблицаСерий.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаТаблицыСерий, Выборка);
					
					Если Не ЗначениеЗаполнено(СтрокаТаблицыСерий.sid) Тогда
						СтрокаТаблицыСерий.sid = Строка(Новый УникальныйИдентификатор());
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если ЗначениеЗаполнено(ТаблицаСерий) Тогда
			ДанныеДокумента.Таблицы.Вставить(Перечисления.SUI_ТипыТаблицДокументовОбмена.Серии, ТаблицаСерий);
		КонецЕсли;
	
	КонецЕсли;
	
	// 20.09.2024 - artem - B120423 >>>
	Если НастройкиДокумента.ТабличныеЧасти.Получить(Перечисления.SUI_ТипыТаблицДокументовОбмена.Отбор) <> Неопределено Тогда
		ДанныеДокумента.Вставить("cells_process_type", "selection");
	ИначеЕсли НастройкиДокумента.ТабличныеЧасти.Получить(Перечисления.SUI_ТипыТаблицДокументовОбмена.Размещение) <> Неопределено Тогда
		ДанныеДокумента.Вставить("cells_process_type", "placement");
	Иначе
		ДанныеДокумента.Вставить("cells_process_type", "");
	КонецЕсли;
	
	Если ДанныеДокумента.cells_process_type = "selection" Или
		ДанныеДокумента.cells_process_type = "placement" Тогда
		ДанныеДокумента.Вставить("process_type", "cells");
	ИначеЕсли НастройкиДокумента.ComputerVision Тогда
		ДанныеДокумента.Вставить("process_type", "CV");
	ИначеЕсли НастройкиДокумента.ТабличныеЧасти.Получить(Перечисления.SUI_ТипыТаблицДокументовОбмена.Товары) <> Неопределено Тогда
		ДанныеДокумента.Вставить("process_type", "document");
	Иначе
		ДанныеДокумента.Вставить("process_type", "");
	КонецЕсли;
	// 20.09.2024 - artem - B120423 <<<
	
	Возврат ДанныеДокумента;
	
КонецФункции

//@skip-check query-in-loop
Процедура ЗаписатьДанныеДокументаОбмена(ДанныеДокументаОбмена, ПараметрыЗаписи, ДанныеЗаписаны = Ложь)
	
	ОбщегоНазначенияКлиентСервер.Проверить(
		СтроковыеФункцииКлиентСервер.ЭтоУникальныйИдентификатор(ДанныеДокументаОбмена.sid),
		НСтр("ru = 'Не заполнен служебный идентификатор документа.'"),
		КонтекстВызоваСтрокой("ЗаписатьДанныеДокументаОбмена"));
		
	ОбщегоНазначенияКлиентСервер.Проверить(
		SUI_ИнтеграцияВКонфигурациюКлиентСервер.ЭтоИдентификаторSimple(ДанныеДокументаОбмена.id_doc),
		НСтр("ru = 'Не заполнен идентификатор Simple документа обмена.'"),
		КонтекстВызоваСтрокой("ЗаписатьДанныеДокументаОбмена"));

	СостояниеЗагрузки = Новый Структура();
	СостояниеЗагрузки.Вставить("ДокументОбмена", 			Ложь);
	СостояниеЗагрузки.Вставить("ТаблицаШтрихкодыУпаковок", 	Ложь);
	СостояниеЗагрузки.Вставить("ТаблицаСерии", 				Ложь);
	СостояниеЗагрузки.Вставить("ТаблицаТовары", 			Ложь);
	СостояниеЗагрузки.Вставить("ТаблицаПересчетТоваров", 	Ложь);
	СостояниеЗагрузки.Вставить("ТаблицаПотокШтрихкодов", 	Ложь);
	СостояниеЗагрузки.Вставить("ЭтоЗагрузкаИзТСД", 			ПараметрыЗаписи.Свойство("ЭтоЗагрузка"));
	СостояниеЗагрузки.Вставить("ЗагрузитьПересчетВТовары", 	Ложь);

	НачатьТранзакцию();
	
	Попытка
		
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.SUI_docs");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Разделяемый;
		ЭлементБлокировки.УстановитьЗначение("sid", ДанныеДокументаОбмена.sid);
		ЭлементБлокировки.УстановитьЗначение("id_doc", ДанныеДокументаОбмена.id_doc);
		ЭлементБлокировки.УстановитьЗначение("НастройкаДокумента", ДанныеДокументаОбмена.НастройкаДокумента);
		Блокировка.Заблокировать();
		
		//@skip-check bsl-legacy-check-string-literal
		НастройкаГрупповогоСканирования = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
			ДанныеДокументаОбмена.НастройкаДокумента, "ГрупповоеСканирование");
		
		НаборЗаписей = РегистрыСведений.SUI_docs.СоздатьНаборЗаписей();
		
		НаборЗаписей.Отбор.sid.Установить(ДанныеДокументаОбмена.sid);
		НаборЗаписей.Отбор.id_doc.Установить(ДанныеДокументаОбмена.id_doc);
		НаборЗаписей.Отбор.НастройкаДокумента.Установить(ДанныеДокументаОбмена.НастройкаДокумента);
		
		НаборЗаписей.Прочитать();
		
		Если НаборЗаписей.Количество() = 0 Тогда
			
			Если ДанныеДокументаОбмена.Состояние = Перечисления.SUI_СостоянияДокументовОбмена.Отменен Или
				ДанныеДокументаОбмена.Состояние = Перечисления.SUI_СостоянияДокументовОбмена.Завершен Тогда
				ОтменитьТранзакцию();
				Возврат;
			Иначе
				НаборЗаписей.Добавить();
				СостояниеЗагрузки.ДокументОбмена = Истина;
			КонецЕсли;
			
		КонецЕсли;
		
		// Удалить записи, если записей более 2
		Для Индекс = 1 По НаборЗаписей.Количество() - 1 Цикл
			НаборЗаписей.Удалить(НаборЗаписей[Индекс]);
			СостояниеЗагрузки.ДокументОбмена = Истина;
		КонецЦикла;
		
		// Перезаписать документ обмена если есть различия
		Если СостояниеЗагрузки.ДокументОбмена Или 
			ТребуетсяОбновлениеЗаписиДокументаОбмена(НаборЗаписей[0], ДанныеДокументаОбмена) Тогда
			
			ЗаполнитьЗначенияСвойств(НаборЗаписей[0], ДанныеДокументаОбмена);
			
			НаборЗаписей.ДополнительныеСвойства.Вставить("ОтключитьМеханизмРегистрацииОбъектов");
			НаборЗаписей.Записать(Истина);
			НаборЗаписей.ДополнительныеСвойства.Удалить("ОтключитьМеханизмРегистрацииОбъектов");
			
			СостояниеЗагрузки.ДокументОбмена = Истина;
			
		КонецЕсли;
		
		// Таблицы
		Если ДанныеДокументаОбмена.Состояние <> Перечисления.SUI_СостоянияДокументовОбмена.Отменен И
			ДанныеДокументаОбмена.Состояние <> Перечисления.SUI_СостоянияДокументовОбмена.Завершен Тогда
			
			Для Каждого Таблица Из ДанныеДокументаОбмена.Таблицы Цикл
				
				// Таблица Штрихкоды упаковок
				Если Таблица.Ключ = Перечисления.SUI_ТипыТаблицДокументовОбмена.ШтрихкодыУпаковок Тогда
					
					ЗаписатьДанныеДокументаОбмена_ШтрихкодыУпаковок(Таблица.Значение, 
						СостояниеЗагрузки.ТаблицаШтрихкодыУпаковок, , 
						СостояниеЗагрузки.ЭтоЗагрузкаИзТСД);
				
				// Таблица Серии
				ИначеЕсли Таблица.Ключ = Перечисления.SUI_ТипыТаблицДокументовОбмена.Серии Тогда
					
					ЗаписатьДанныеДокументаОбмена_Серии(Таблица.Значение, 
						СостояниеЗагрузки.ТаблицаСерии, 
						ПараметрыЗаписи.Свойство("ПерезаписатьСерии"), , 
						СостояниеЗагрузки.ЭтоЗагрузкаИзТСД);
				
				// Таблица Товары, Отбор или Размещение
				ИначеЕсли Таблица.Ключ = Перечисления.SUI_ТипыТаблицДокументовОбмена.Товары Или 
					Таблица.Ключ = Перечисления.SUI_ТипыТаблицДокументовОбмена.Отбор Или 
					Таблица.Ключ = Перечисления.SUI_ТипыТаблицДокументовОбмена.Размещение Тогда

					ЗаписатьДанныеДокументаОбмена_Товары(Таблица.Значение, 
						СостояниеЗагрузки.ТаблицаТовары, 
						СостояниеЗагрузки.ЭтоЗагрузкаИзТСД);
				
				// Таблица Поток штрихкодов
				ИначеЕсли Таблица.Ключ = Перечисления.SUI_ТипыТаблицДокументовОбмена.ПотокШтрихкодов Тогда
					
					ЗаписатьДанныеДокументаОбмена_ПотокШтрихкодов(Таблица.Значение, 
						СостояниеЗагрузки.ТаблицаПотокШтрихкодов);
				
				// Таблица Пересчет товаров
				ИначеЕсли Таблица.Ключ = "ТаблицаПересчетТоваров" И НастройкаГрупповогоСканирования Тогда
					
					Таблица.Значение.ЗаполнитьЗначения(ДанныеДокументаОбмена.МобильноеУстройство, "МобильноеУстройство");
  					
					ЗаписатьДанныеДокументаОбмена_ПересчетТоваров(Таблица.Значение, 
						СостояниеЗагрузки.ТаблицаПересчетТоваров, 
						ПараметрыЗаписи.Свойство("ПерезаписьРезультатов"));
					
				КонецЕсли;

			КонецЦикла;
			
		КонецЕсли;
		
		// Завершение группового пересчета документа обмена
		Если СостояниеЗагрузки.ЭтоЗагрузкаИзТСД И 
			НастройкаГрупповогоСканирования И 
			ПараметрыЗаписи.Свойство("ЗавершитьГрупповойПересчетДокументаОбмена") Тогда
			СостояниеЗагрузки.ЗагрузитьПересчетВТовары = Истина;
		КонецЕсли;
		
		// Если это принудительная выгрузка или есть изменения по документу обмена
		Если ПараметрыЗаписи.Свойство("ПринудительнаяВыгрузка") Или
			СостояниеЗагрузки.ДокументОбмена Или
			СостояниеЗагрузки.ТаблицаТовары Или
			СостояниеЗагрузки.ТаблицаШтрихкодыУпаковок Или
			СостояниеЗагрузки.ТаблицаСерии Или
			СостояниеЗагрузки.ТаблицаПересчетТоваров Или
			СостояниеЗагрузки.ТаблицаПотокШтрихкодов Или
			СостояниеЗагрузки.ЗагрузитьПересчетВТовары Тогда

			Если ПараметрыЗаписи.Свойство("НеРегистрироватьИзменения") Тогда
				НаборЗаписей.ДополнительныеСвойства.Вставить("НеРегистрироватьИзменения");
			Иначе
				
				НаборЗаписей.ДополнительныеСвойства.Вставить("РегистрироватьИзменения");
				
				Если ПараметрыЗаписи.Свойство("МобильноеУстройство") Тогда
					НаборЗаписей.ДополнительныеСвойства.Вставить("МобильноеУстройство", ПараметрыЗаписи.МобильноеУстройство);	
				КонецЕсли; 
				
				Если ПараметрыЗаписи.Свойство("ИсключитьМобильноеУстройство") Тогда
					НаборЗаписей.ДополнительныеСвойства.Вставить("ИсключитьМобильноеУстройство", ПараметрыЗаписи.ИсключитьМобильноеУстройство);	
				КонецЕсли;
			
			КонецЕсли;

			НаборЗаписей.Записать(Истина);
			
			СостояниеЗагрузки.ДокументОбмена = Истина;
			
			// Постобработка документа обмена    
			Если Не ПараметрыЗаписи.Свойство("ОтключитьПостобработкуДокументаОбмена") Тогда
				ДанныеПостобработки = Новый Структура("sid, id_doc, НастройкаДокумента");
				ЗаполнитьЗначенияСвойств(ДанныеПостобработки, ДанныеДокументаОбмена);
				ЗаписатьДанныеДокументаОбмена_СоздатьЗаданиеПостобработки(ДанныеПостобработки, СостояниеЗагрузки);
			КонецЕсли;
			
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		SUI_ЖурналРегистрации.ЗаписьВЖурналРегистрации(ИмяСобытия(), , 
			Метаданные.ОбщиеМодули.SUI_ДокументыОбмена, , ИнформацияОбОшибке());
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Возникла исключительная ошибка при записи данных документа обмена
			|%1'"), ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	ДанныеЗаписаны = СостояниеЗагрузки.ДокументОбмена;
	
КонецПроцедуры

Процедура ЗаписатьДанныеДокументаОбмена_СоздатьЗаданиеПостобработки(ДанныеПостобработки, СостояниеЗагрузки)
	
	Если Не СостояниеЗагрузки.ЭтоЗагрузкаИзТСД Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	ДокументСсылка = SUI_ИнтеграцияВКонфигурацию.СсылкаПоИдентификаторуSimple(ДанныеПостобработки.id_doc, Истина);
	
	ПараметрыСозданияЗадания = SUI_ОчередьЗаданийКлиентСервер.ПараметрыСозданияЗадания();
	ПараметрыСозданияЗадания.Наименование = СтрШаблон(НСтр("ru = 'Постобработка документа обмена (%1)'"),
		?(ЗначениеЗаполнено(ДокументСсылка), ДокументСсылка, ДанныеПостобработки.НастройкаДокумента));
		
	ПараметрыСозданияЗадания.ИдентификаторДокумента = SUI_ИнтеграцияВКонфигурацию.ИдентификаторSimpleПоСсылке(ДокументСсылка);
	
	// Обработчик создания серий номенклатуры
	Если СостояниеЗагрузки.ТаблицаСерии Тогда
		ПараметрыПроцедуры = Новый Структура("sid_doc", ДанныеПостобработки.sid);
		SUI_ОчередьЗаданийКлиентСервер.ДобавитьОбработчикВПараметрыСозданияЗадания(
			ПараметрыСозданияЗадания, 
			"SUI_ДокументыОбмена.ЗаданиеСоздатьСерииНоменклатурыДокументаОбмена",
			SUI_ОбщегоНазначенияКлиентСервер.МассивЗначений(ПараметрыПроцедуры, Неопределено));
	КонецЕсли;
	
	// Обработчик создания штрихкодов упаковок
	Если СостояниеЗагрузки.ТаблицаШтрихкодыУпаковок Тогда
		ПараметрыПроцедуры = Новый Структура("sid_doc", ДанныеПостобработки.sid);
		SUI_ОчередьЗаданийКлиентСервер.ДобавитьОбработчикВПараметрыСозданияЗадания(
			ПараметрыСозданияЗадания, 
			"SUI_ДокументыОбмена.ЗаданиеСоздатьШтрихкодыУпаковокДокументаОбмена",
			SUI_ОбщегоНазначенияКлиентСервер.МассивЗначений(ПараметрыПроцедуры, Неопределено));
	КонецЕсли;
	
	// Обработчик загрузки итогов пересчета в документ обмена
	Если СостояниеЗагрузки.ЗагрузитьПересчетВТовары Тогда
		ПараметрыПроцедуры = Новый Структура("sid_doc", ДанныеПостобработки.sid);
		SUI_ОчередьЗаданийКлиентСервер.ДобавитьОбработчикВПараметрыСозданияЗадания(
			ПараметрыСозданияЗадания, 
			"SUI_ДокументыОбмена.ЗаданиеЗагрузитьИтогиПересчетаВДокументОбмена",
			SUI_ОбщегоНазначенияКлиентСервер.МассивЗначений(ПараметрыПроцедуры, Неопределено));
	КонецЕсли;
	
	// Если документ обмена был загружен
	Если СостояниеЗагрузки.ДокументОбмена Тогда
		
		ДанныеНастройкиДокументаОбмена = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
			ДанныеПостобработки.НастройкаДокумента, 
			"ЗагружатьВДокумент1СПослеПолученияИзТСД, ГрупповоеСканирование");

		// Обработчик загрузки в документ 1С
		Если ДанныеНастройкиДокументаОбмена.ЗагружатьВДокумент1СПослеПолученияИзТСД Тогда
			
			// Если не Групповое сканирование ИЛИ Групповое сканирование и Есть обработчик загрузки пересчета товаров
			Если Не ДанныеНастройкиДокументаОбмена.ГрупповоеСканирование Или
				(ДанныеНастройкиДокументаОбмена.ГрупповоеСканирование И СостояниеЗагрузки.ЗагрузитьПересчетВТовары) Тогда
				
				ПараметрыСозданияЗадания.Наименование = СтрШаблон(НСтр("ru = 'Загрузка в документ 1С (%1)'"),
				?(ЗначениеЗаполнено(ДокументСсылка), ДокументСсылка, ДанныеПостобработки.НастройкаДокумента));
			
				ПараметрыПроцедуры = Новый Структура();
				ПараметрыПроцедуры.Вставить("sid", ДанныеПостобработки.sid);
				ПараметрыПроцедуры.Вставить("id_doc", ДанныеПостобработки.id_doc);
				ПараметрыПроцедуры.Вставить("НастройкаДокумента", ДанныеПостобработки.НастройкаДокумента);
				
				SUI_ОчередьЗаданийКлиентСервер.ДобавитьОбработчикВПараметрыСозданияЗадания(
					ПараметрыСозданияЗадания, 
					"SUI_ДокументыОбмена.ЗаданиеЗагрузитьДокументОбменаВДокумент1СПослеЗагрузки",
					SUI_ОбщегоНазначенияКлиентСервер.МассивЗначений(ПараметрыПроцедуры, Неопределено));
				
			КонецЕсли;
			
		КонецЕсли;

	КонецЕсли;
	
	// Создать задание очереди
	Если ПараметрыСозданияЗадания.Обработчики.Количество() > 0 Тогда
		SUI_ОчередьЗаданий.СоздатьЗадание(ПараметрыСозданияЗадания);
	КонецЕсли;
		
КонецПроцедуры

Процедура ЗаписатьДанныеДокументаОбмена_Товары(Таблица, ЗаписьВыполнена = Ложь, ЭтоЗагрузка = Ложь)

	Если Таблица.Количество() = 0 Тогда
		Возврат;	
	КонецЕсли;
	
	Если Не SUI_НастройкиМетаданныхСервер.ТаблицаИспользуется(Перечисления.SUI_ТаблицыИнтеграции.Номенклатура) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Таблица", Таблица);
	Запрос.УстановитьПараметр("ЭтоЗагрузка", ЭтоЗагрузка);
	Запрос.УстановитьПараметр("ШаблонУникальногоИдентификатора", SUI_ОбщегоНазначенияКлиентСервер.ШаблонУникальногоИдентификатора());
	Запрос.УстановитьПараметр("ШаблонИдентификатораSimple", SUI_ИнтеграцияВКонфигурациюКлиентСервер.ШаблонИдентификатораSimple());
	Запрос.Текст = "ВЫБРАТЬ
	|	Таблица.sid КАК sid,
	|	Таблица.sid_doc КАК sid_doc,
	|	Таблица.id_good,
	|	Таблица.id_properties,
	|	Таблица.id_series,
	|	Таблица.id_cell,
	|	Таблица.id_unit,
	|	Таблица.id_price,
	|	Таблица.price,
	|	Таблица.qtty,
	|	Таблица.qtty_plan,
	|	ВЫБОР
	|		КОГДА Таблица.use_series > 1
	|			ТОГДА 1
	|		КОГДА Таблица.use_series < 0
	|			ТОГДА 0
	|		ИНАЧЕ Таблица.use_series
	|	КОНЕЦ КАК use_series,
	|	Таблица.additional_details,
	|	Таблица.use_mark,
	|	Таблица.ТипТаблицы
	|ПОМЕСТИТЬ втТаблица
	|ИЗ
	|	&Таблица КАК Таблица
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	sid,
	|	sid_doc
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втТаблица.sid,
	|	втТаблица.sid_doc,
	|	втТаблица.id_good,
	|	втТаблица.id_properties,
	|	втТаблица.id_series,
	|	втТаблица.id_cell,
	|	втТаблица.id_unit,
	|	втТаблица.id_price,
	|	втТаблица.price,
	|	втТаблица.qtty,
	|	втТаблица.qtty_plan,
	|	втТаблица.use_series,
	|	ВЫБОР
	|		КОГДА &ЭтоЗагрузка
	|			ТОГДА ЕСТЬNULL(SUI_docs_tbl_goods.additional_details, """")
	|		ИНАЧЕ втТаблица.additional_details
	|	КОНЕЦ КАК additional_details,
	|	ВЫБОР
	|		КОГДА &ЭтоЗагрузка
	|			ТОГДА ЕСТЬNULL(SUI_docs_tbl_goods.use_mark, ЛОЖЬ)
	|		ИНАЧЕ втТаблица.use_mark
	|	КОНЕЦ КАК use_mark,
	|	втТаблица.ТипТаблицы,
	|	ВЫБОР
	|		КОГДА SUI_docs_tbl_goods.sid ЕСТЬ NULL
	|		ИЛИ втТаблица.id_good <> SUI_docs_tbl_goods.id_good
	|		ИЛИ втТаблица.id_properties <> SUI_docs_tbl_goods.id_properties
	|		ИЛИ втТаблица.id_series <> SUI_docs_tbl_goods.id_series
	|		ИЛИ втТаблица.id_cell <> SUI_docs_tbl_goods.id_cell
	|		ИЛИ втТаблица.id_unit <> SUI_docs_tbl_goods.id_unit
	|		ИЛИ втТаблица.id_price <> SUI_docs_tbl_goods.id_price
	|		ИЛИ втТаблица.price <> SUI_docs_tbl_goods.price
	|		ИЛИ втТаблица.qtty <> SUI_docs_tbl_goods.qtty
	|		ИЛИ втТаблица.qtty_plan <> SUI_docs_tbl_goods.qtty_plan
	|		ИЛИ втТаблица.use_series <> SUI_docs_tbl_goods.use_series
	|		ИЛИ втТаблица.ТипТаблицы <> SUI_docs_tbl_goods.ТипТаблицы
	|		ИЛИ (НЕ &ЭтоЗагрузка И втТаблица.use_mark <> ЕСТЬNULL(SUI_docs_tbl_goods.use_mark, ЛОЖЬ))
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ Записывать
	|ПОМЕСТИТЬ втФильтр
	|ИЗ
	|	втТаблица КАК втТаблица
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.SUI_docs_tbl_goods КАК SUI_docs_tbl_goods
	|		ПО втТаблица.sid = SUI_docs_tbl_goods.sid
	|		И втТаблица.sid_doc = SUI_docs_tbl_goods.sid_doc
	|ГДЕ
