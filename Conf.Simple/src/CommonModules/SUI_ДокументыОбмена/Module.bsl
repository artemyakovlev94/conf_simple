#Область ТаблицыДокумента

// Таблица документа по настройке табличной части.
// 
// Параметры:
//  КоллекцияРеквизитовТабличнойЧасти - ФиксированноеСоответствие из Структура - Коллекция настроек реквизитов табличной части
// 
// Возвращаемое значение:
//  Неопределено, ТаблицаЗначений - Таблица документа по настройке табличной части
Функция ТаблицаДокументаПоНастройкеТабличнойЧасти(КоллекцияРеквизитовТабличнойЧасти) Экспорт
	
	Если ТипЗнч(КоллекцияРеквизитовТабличнойЧасти) <> Тип("ФиксированноеСоответствие") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Таблица = Новый ТаблицаЗначений;
	
	Для Каждого РеквизитТЧ Из КоллекцияРеквизитовТабличнойЧасти Цикл
		
		Если Не ЗначениеЗаполнено(РеквизитТЧ.Значение) Тогда
			Продолжить;
		КонецЕсли;
		
		Таблица.Колонки.Добавить(РеквизитТЧ.Ключ, РеквизитТЧ.Значение.Тип, ПредставлениеКолонкиТаблицы(РеквизитТЧ.Ключ));
		
	КонецЦикла;
	
	Таблица.Колонки.Добавить("ИндексКартинки", SUI_ОбщегоНазначения.ОписаниеТипаЧисло(1));
	Таблица.Колонки.Добавить("НомерСтроки", SUI_ОбщегоНазначения.ОписаниеТипаЧисло(10, 0, ДопустимыйЗнак.Неотрицательный), 
		НСтр("ru = 'Номер строки'"));
	Таблица.Колонки.Добавить("sid", SUI_ОбщегоНазначения.ОписаниеТипаСтрока(36), НСтр("ru = 'SID'"));
	Таблица.Колонки.Добавить("sid_doc", SUI_ОбщегоНазначения.ОписаниеТипаСтрока(36), НСтр("ru = 'SID документа'"));
	
	Возврат Таблица;
	
КонецФункции

