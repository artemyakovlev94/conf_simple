
#Область ПрограммныйИнтерфейс

#Область ОбработчикиПодписокНаСобытия

// SUI документы при записи (ДокументСсылка).
// 
// Параметры:
//  Источник - ДокументСсылка - Источник
//  Отказ - Булево - Отказ
Процедура SUI_ДокументыПриЗаписи(Источник, Отказ) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если Отказ Или Источник.ОбменДанными.Загрузка Или
		Источник.ДополнительныеСвойства.Свойство("ОтключитьМеханизмРегистрацииОбъектов") Тогда 
		Возврат;
	КонецЕсли;
	
	ПараметрыВыгрузки = Новый Структура();
	ПараметрыВыгрузки.Вставить("ДокументСсылка", Источник.Ссылка);
	ПараметрыВыгрузки.Вставить("ЭтоПодпискаНаСобытие");
	
	Если Источник.ДополнительныеСвойства.Свойство("SUI_НеРегистрироватьИзменения") Тогда
		ПараметрыВыгрузки.Вставить("НеРегистрироватьИзменения");
	КонецЕсли;
	
	Если Источник.ДополнительныеСвойства.Свойство("SUI_МобильноеУстройство") Тогда
		ПараметрыВыгрузки.Вставить("МобильноеУстройство", Источник.ДополнительныеСвойства.SUI_МобильноеУстройство);
	КонецЕсли;
	
	Если Источник.ДополнительныеСвойства.Свойство("SUI_ИсключитьМобильноеУстройство") Тогда
		ПараметрыВыгрузки.Вставить("ИсключитьМобильноеУстройство", Источник.ДополнительныеСвойства.SUI_ИсключитьМобильноеУстройство);
	КонецЕсли;
	
	Если Источник.ПометкаУдаления Тогда
		ПараметрыВыгрузки.Вставить("Состояние", Перечисления.SUI_СостоянияДокументовОбмена.Отменен);
	КонецЕсли;

	ВыгрузитьДокументОбмена(ПараметрыВыгрузки);
	
КонецПроцедуры

// SUI документы обмена перед записью (РегистрСведенийНаборЗаписей.SUI_docs).
// 
// Параметры:
//  Источник - РегистрСведенийНаборЗаписей.SUI_docs - Источник
//  Отказ - Булево - Отказ
//  Замещение - Булево - Замещение
Процедура SUI_ДокументыОбменаПередЗаписью(Источник, Отказ, Замещение) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если Отказ Или
		Источник.ОбменДанными.Загрузка Или
		ТипЗнч(Источник) <> Тип("РегистрСведенийНаборЗаписей.SUI_docs") Тогда
		Возврат;
	КонецЕсли;

	Если Источник.Количество() > 0 Тогда
		Возврат;
	КонецЕсли;

	Если Не Источник.ЗаписьИсторииДанных.ДополнительныеДанные.Свойство("НеУдалятьДанные") Тогда
		
		Если Не ЗначениеЗаполнено(Источник.Отбор.sid.Значение) И
			Не ЗначениеЗаполнено(Источник.Отбор.id_doc.Значение) И 
			Не ЗначениеЗаполнено(Источник.Отбор.НастройкаДокумента.Значение) Тогда
			Источник.ДополнительныеСвойства.Вставить("Удаление");
		Иначе
			
			Запрос = Новый Запрос;
			Запрос.Текст =
				"ВЫБРАТЬ
				|	SUI_docs.sid,
				|	SUI_docs.id_doc,
				|	SUI_docs.НастройкаДокумента
				|ИЗ
				|	РегистрСведений.SUI_docs КАК SUI_docs
				|ГДЕ
				|	ВЫБОР
				|		КОГДА &id_doc <> НЕОПРЕДЕЛЕНО
				|			ТОГДА SUI_docs.id_doc = &id_doc
				|		ИНАЧЕ ИСТИНА
				|	КОНЕЦ
				|	И ВЫБОР
				|		КОГДА &sid <> НЕОПРЕДЕЛЕНО
				|			ТОГДА SUI_docs.sid = &sid
				|		ИНАЧЕ ИСТИНА
				|	КОНЕЦ
				|	И ВЫБОР
				|		КОГДА &НастройкаДокумента <> НЕОПРЕДЕЛЕНО
				|			ТОГДА SUI_docs.НастройкаДокумента = &НастройкаДокумента
				|		ИНАЧЕ ИСТИНА
				|	КОНЕЦ
				|СГРУППИРОВАТЬ ПО
				|	SUI_docs.sid,
				|	SUI_docs.id_doc,
				|	SUI_docs.НастройкаДокумента";
			
			Если ЗначениеЗаполнено(Источник.Отбор.sid.Значение) Тогда
				Запрос.УстановитьПараметр("sid", Источник.Отбор.sid.Значение);
			Иначе
				Запрос.УстановитьПараметр("sid", Неопределено);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Источник.Отбор.id_doc.Значение) Тогда
				Запрос.УстановитьПараметр("id_doc", Источник.Отбор.id_doc.Значение);
			Иначе
				Запрос.УстановитьПараметр("id_doc", Неопределено);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Источник.Отбор.НастройкаДокумента.Значение) Тогда
				Запрос.УстановитьПараметр("НастройкаДокумента", Источник.Отбор.НастройкаДокумента.Значение);
			Иначе
				Запрос.УстановитьПараметр("НастройкаДокумента", Неопределено);
			КонецЕсли;
			
			РезультатЗапроса = Запрос.Выполнить();
			
			Если Не РезультатЗапроса.Пустой() Тогда
				
				Источник.ДополнительныеСвойства.Вставить("Удаление", Новый Массив());
				
				Выборка = РезультатЗапроса.Выбрать();
				
				Пока Выборка.Следующий() Цикл
					
					НаборЗаписей = РегистрыСведений.SUI_docs.СоздатьНаборЗаписей();
					НаборЗаписей.Отбор.sid.Установить(Выборка.sid);
					НаборЗаписей.Отбор.id_doc.Установить(Выборка.id_doc);
					НаборЗаписей.Отбор.НастройкаДокумента.Установить(Выборка.НастройкаДокумента);
					
					Источник.ДополнительныеСвойства.Удаление.Добавить(НаборЗаписей);
					
				КонецЦикла;
				
			КонецЕсли;
		
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

// SUI документы обмена при записи (РегистрСведенийНаборЗаписей.SUI_docs).
// 
// Параметры:
//  Источник - РегистрСведенийНаборЗаписей.SUI_docs - Источник
//  Отказ - Булево - Отказ
//  Замещение - Булево - Замещение
Процедура SUI_ДокументыОбменаПриЗаписи(Источник, Отказ, Замещение) Экспорт
	
	Если Отказ Или
		Источник.ОбменДанными.Загрузка Или
		ТипЗнч(Источник) <> Тип("РегистрСведенийНаборЗаписей.SUI_docs") Тогда
		Возврат;
	КонецЕсли;

	Если Источник.Количество() = 0 И Источник.ДополнительныеСвойства.Свойство("Удаление") Тогда
		УдалитьРегистрациюИзмененийДокументаОбмена(Источник.ДополнительныеСвойства.Удаление);
		УдалитьСвязанныеДанныеДокументаОбмена(Источник.ДополнительныеСвойства.Удаление);
		Возврат;
	КонецЕсли;
	
	Если Источник.ДополнительныеСвойства.Свойство("ОтключитьМеханизмРегистрацииОбъектов") Тогда
		Возврат;
	КонецЕсли;
	
	ЗарегистрироватьИзмененияДокументаОбмена(Источник);
	
КонецПроцедуры

#КонецОбласти

Функция ПараметрыВыгрузкиДокументаОбмена() Экспорт
	
	ПараметрыЗагрузки = Новый Структура();
	
	ПараметрыЗагрузки.Вставить("ДокументСсылка");
	ПараметрыЗагрузки.Вставить("МобильноеУстройство");
	ПараметрыЗагрузки.Вставить("НастройкаДокумента");
	
	Возврат ПараметрыЗагрузки;
	
КонецФункции

//@skip-check bsl-legacy-check-expression-type
//@skip-check doc-comment-parameter-section
Процедура ВыгрузитьДокументОбмена(ПараметрыВыгрузки, АдресРезультата = Неопределено) Экспорт
	
	ДанныеВыгружены = Ложь;
	
	ДокументСсылка = SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыВыгрузки, "ДокументСсылка");

	ОбщегоНазначенияКлиентСервер.Проверить(
		SUI_ОбщегоНазначения.ЭтоСсылкаДокумента(ДокументСсылка),
		СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Значение (%1) не является ссылкой документа'"), ДокументСсылка),
		КонтекстВызоваСтрокой("ВыгрузитьДокументОбмена"));
		
	ОбщегоНазначенияКлиентСервер.Проверить(
		ОбщегоНазначения.СсылкаСуществует(ДокументСсылка),
		СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Ссылка документа (%1) не существует'"), ДокументСсылка),
		КонтекстВызоваСтрокой("ВыгрузитьДокументОбмена"));
		
	Если ПараметрыВыгрузки.Свойство("НастройкаДокумента") И ЗначениеЗаполнено(ПараметрыВыгрузки.НастройкаДокумента) Тогда
		НастройкаДокумента = НастройкаДокументаПоПараметру(ПараметрыВыгрузки.НастройкаДокумента, , "ВыгрузитьДокументОбмена");
		Если SUI_НастройкиДокументовСервер.ДокументСоответствуетОтборуНастройки(НастройкаДокумента, ДокументСсылка) Тогда
			ПараметрыВыгрузки.Вставить("Настройки", ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(НастройкаДокумента));
		КонецЕсли;
		ПараметрыВыгрузки.Удалить("НастройкаДокумента");
	Иначе
		ПараметрыВыгрузки.Вставить("Настройки", SUI_НастройкиДокументовСервер.ПолучитьНастройкиДокумента(ДокументСсылка));
	КонецЕсли;
	
	Если ПараметрыВыгрузки.Настройки.Количество() = 0 Тогда
		Если Не ПараметрыВыгрузки.Свойство("ЭтоПодпискаНаСобытие") Тогда
			ОбщегоНазначения.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Для документа %1 отсутствуют настройки.'"), ДокументСсылка));
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	ПараметрыВыгрузки.Вставить("МобильноеУстройство", SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(
		ПараметрыВыгрузки, "МобильноеУстройство", ПланыОбмена.SUI_МобильныеУстройства.ПустаяСсылка(), Тип("ПланОбменаСсылка.SUI_МобильныеУстройства")));
	
	Если ПараметрыВыгрузки.МобильноеУстройство.Пустая() Тогда
		ПараметрыВыгрузки.Удалить("МобильноеУстройство");
	КонецЕсли;
		
	ПараметрыВыгрузки.Вставить("ИсключитьМобильноеУстройство", SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(
		ПараметрыВыгрузки, "ИсключитьМобильноеУстройство", ПланыОбмена.SUI_МобильныеУстройства.ПустаяСсылка(), Тип("ПланОбменаСсылка.SUI_МобильныеУстройства")));
	
	Если ПараметрыВыгрузки.ИсключитьМобильноеУстройство.Пустая() Тогда
		ПараметрыВыгрузки.Удалить("ИсключитьМобильноеУстройство");
	КонецЕсли;
	
	Если ПараметрыВыгрузки.Свойство("ЭтоПодпискаНаСобытие") Тогда
		Состояние = Неопределено;
	Иначе
		Состояние = Перечисления.SUI_СостоянияДокументовОбмена.КВыгрузке;
		ПараметрыВыгрузки.Вставить("ПринудительнаяВыгрузка");
	КонецЕсли;
	
	Для Каждого НастройкаДокумента Из ПараметрыВыгрузки.Настройки Цикл
		
		//@skip-check query-in-loop
		ДанныеДокументаОбмена = СформироватьДанныеДокументаОбменаИзДокумента(ДокументСсылка, НастройкаДокумента, Состояние);
		
		Если ДанныеДокументаОбмена = Неопределено Тогда
			Если ПараметрыВыгрузки.Свойство("ПринудительнаяВыгрузка") Тогда
				ОбщегоНазначения.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Не удалось сформировать данные документа по настройке %1'"), 
						НастройкаДокумента));
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		
		Если ПараметрыВыгрузки.Свойство("ЭтоПодпискаНаСобытие") И 
			ДанныеДокументаОбмена.ДокументОбменаСуществует Тогда
			ПараметрыВыгрузки.Вставить("НеРегистрироватьИзменения");
		КонецЕсли;
		
		ДанныеДокументаОбмена.Вставить("МобильноеУстройство", ПланыОбмена.SUI_МобильныеУстройства.ПустаяСсылка());
		
		//@skip-check query-in-loop
		ЗаписатьДанныеДокументаОбмена(ДанныеДокументаОбмена, ПараметрыВыгрузки, ДанныеВыгружены);
	
	КонецЦикла;
	
	Если ЗначениеЗаполнено(АдресРезультата) И ЭтоАдресВременногоХранилища(АдресРезультата) Тогда
		ПоместитьВоВременноеХранилище(ДанныеВыгружены, АдресРезультата);
	КонецЕсли;

КонецПроцедуры

Функция ВыгрузитьИПолучитьДокументОбмена(ПараметрыВыгрузки) Экспорт

	ДанныеДокументов = Новый Массив();

	ВыгрузитьДокументОбмена(ОбщегоНазначения.СкопироватьРекурсивно(ПараметрыВыгрузки, Ложь));
	
	Если ПараметрыВыгрузки.Свойство("SUI_АдресноеХранение") И ПараметрыВыгрузки.SUI_АдресноеХранение Тогда
		ТаблицаИнтеграции = Перечисления.SUI_ТаблицыИнтеграции.ДокументыАдресногоХранения;
	Иначе
		ТаблицаИнтеграции = Перечисления.SUI_ТаблицыИнтеграции.Документы;
	КонецЕсли;
		
	ТаблицаКоллекции = SUI_ПакетыДанных.ПолучитьСостояниеТаблиц(ПараметрыВыгрузки.МобильноеУстройство);
	ТаблицаКоллекции.Очистить();
	
	СтрокаТаблицы = ТаблицаКоллекции.Добавить();
	СтрокаТаблицы.МобильноеУстройство = ПараметрыВыгрузки.МобильноеУстройство;
	СтрокаТаблицы.Таблица = ТаблицаИнтеграции;
	СтрокаТаблицы.ИмяТаблицы = SUI_НастройкиМетаданныхСервер.ПолучитьИмяТаблицыВКонфигурации(СтрокаТаблицы.Таблица);
	СтрокаТаблицы.ИмяТаблицыМобильногоУстройства = SUI_НастройкиМетаданныхСервер.ПолучитьИмяТаблицыМобильногоУстройства(
		СтрокаТаблицы.Таблица);
	
	ПараметрыОтбора = Новый Структура();
	ПараметрыОтбора.Вставить("НастройкаДокумента", ПараметрыВыгрузки.НастройкаДокумента);
	ПараметрыОтбора.Вставить("id_doc", 
		SUI_ИнтеграцияВКонфигурацию.ИдентификаторSimpleПоСсылке(ПараметрыВыгрузки.ДокументСсылка));
		
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("Параметры", ПараметрыОтбора);
	ДополнительныеПараметры.Вставить("ВыборПервых", 1);
	ДополнительныеПараметры.Вставить("НеИзменения", Истина);
	
	СтрокаТаблицы.ДанныеЗапроса = SUI_ПакетыДанных.ПолучитьЗапросДанных(СтрокаТаблицы.Таблица, 
		ПараметрыВыгрузки.МобильноеУстройство, , ДополнительныеПараметры);
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("Записывать", Ложь);
	
	Результат = SUI_ПакетыДанных.СформироватьКоллекцииДанныхПакетаСообщений(ПараметрыВыгрузки.МобильноеУстройство, 
		ТаблицаКоллекции, , ДополнительныеПараметры);
	
	ДанныеДокумента = ?(Результат.Количество() = 1, 
		Результат[0].data.Получить(СтрокаТаблицы.ИмяТаблицыМобильногоУстройства), 
		Неопределено);
	
	Если ДанныеДокумента <> Неопределено Тогда
		
		Для индекс = 0 По ДанныеДокумента.ВГраница() Цикл
			
			Если ДанныеДокумента[индекс].id_doc = ПараметрыОтбора.id_doc Тогда
				ДанныеДокументов.Добавить(ДанныеДокумента[индекс]);
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ?(ДанныеДокументов.Количество() = 0, Неопределено, ДанныеДокументов[0]);
	
КонецФункции

// Параметры загрузки документа обмена. Используется в см. SUI_ДокументыОбмена.ЗагрузитьДокументОбмена
// 
// Возвращаемое значение:
//  Структура - Параметры загрузки документа обмена:
// * Данные - Структура - Данные документа:
// 	* sid - Строка - Служебный идентификатор документа (36 символов)
// 	* id_doc - Строка - Идентификатор Simple документа (69 символов)
// 	* Таблицы - Соответствие из ПеречислениеСсылка.SUI_ТипыТаблицДокументовОбмена - Таблицы документа обмена
// * МобильноеУстройство - ПланОбменаСсылка.SUI_МобильныеУстройства, Неопределено - Мобильное устройство
Функция ПараметрыЗагрузкиДокументаОбмена() Экспорт
	
	Данные = Новый Структура("sid, id_doc, Таблицы", "", "", Новый Соответствие());
	
	ПараметрыЗагрузки = Новый Структура();
	
	ПараметрыЗагрузки.Вставить("Данные", Данные);
	ПараметрыЗагрузки.Вставить("МобильноеУстройство");
	ПараметрыЗагрузки.Вставить("ОбработкаЗаданийВФоне", Не ОбщегоНазначения.ИнформационнаяБазаФайловая());
	
	//@skip-check constructor-function-return-section
	Возврат ПараметрыЗагрузки;
	
КонецФункции

// Загрузить документ обмена.
// 
// Параметры:
//  ПараметрыЗагрузки - Структура - Параметры загрузки см. SUI_ДокументыОбмена.ПараметрыЗагрузкиДокументаОбмена
//  АдресРезультата - Строка - Адрес временного хранилища для помещения результата загрузки
// Возвращаемое значение:
//	Булево - Результат загрузки
Функция ЗагрузитьДокументОбмена(ПараметрыЗагрузки, АдресРезультата = Неопределено) Экспорт
	
	ДанныеЗагружены = Ложь;
	
	ОбщегоНазначенияКлиентСервер.Проверить(SUI_ИнтеграцияВКонфигурациюКлиентСервер.ЭтоИдентификаторSimple(ПараметрыЗагрузки.Данные.id_doc),
		СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Идентификатор документа ""%1"" не является идентификатором Simple.'"), ПараметрыЗагрузки.Данные.id_doc));
	
	ИсключаемыеСостояния = SUI_ОбщегоНазначенияКлиентСервер.МассивЗначений(
		Перечисления.SUI_СостоянияДокументовОбмена.Новый, 
		Перечисления.SUI_СостоянияДокументовОбмена.Отменен, 
		Перечисления.SUI_СостоянияДокументовОбмена.Завершен);

	ОбщегоНазначенияКлиентСервер.Проверить(ДокументБылВыгружен(ПараметрыЗагрузки.Данные.id_doc, ИсключаемыеСостояния),
		СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Документ с идентификатором ""%1"" не был выгружен.'"), ПараметрыЗагрузки.Данные.id_doc));
	
	// Если операция завершения группового пересчета
	БезТаблиц = ПараметрыЗагрузки.Свойство("ЗавершитьГрупповойПересчетДокументаОбмена");
	
	ПараметрыЗагрузки.Данные = ДанныеДокументаКЗагрузкеВДокументОбмена(ПараметрыЗагрузки.Данные.id_doc, ПараметрыЗагрузки.Данные.Таблицы, БезТаблиц);
		
	Для Каждого ДанныеДокумента Из ПараметрыЗагрузки.Данные Цикл
		
		ДанныеДокумента.МобильноеУстройство = ПараметрыЗагрузки.МобильноеУстройство;
		
		Если ДанныеДокумента.Состояние <> Перечисления.SUI_СостоянияДокументовОбмена.ВРаботе Тогда
			ДанныеДокумента.Состояние = Перечисления.SUI_СостоянияДокументовОбмена.Загружен;
		КонецЕсли;

		ПараметрыЗаписи = Новый Структура();
		
		Если ПараметрыЗагрузки.Свойство("НеРегистрироватьИзменения") Тогда
			ПараметрыЗаписи.Вставить("НеРегистрироватьИзменения");
		Иначе
			
			Если Константы.SUI_РегистрироватьИзмененияПослеЗагрузкиДокументаИзМУ.Получить() Тогда
				ПараметрыЗаписи.Вставить("ИсключитьМобильноеУстройство", ПараметрыЗагрузки.МобильноеУстройство);
			Иначе
				ПараметрыЗаписи.Вставить("НеРегистрироватьИзменения");
			КонецЕсли;
			
		КонецЕсли;
		
		Если ПараметрыЗагрузки.Свойство("ПерезаписьРезультатов") Тогда
			ПараметрыЗаписи.Вставить("ПерезаписьРезультатов");
		КонецЕсли;
		
		Если ПараметрыЗагрузки.Свойство("ЗавершитьГрупповойПересчетДокументаОбмена") Тогда
			ПараметрыЗаписи.Вставить("ЗавершитьГрупповойПересчетДокументаОбмена");
		КонецЕсли;
		
		Если ПараметрыЗагрузки.Свойство("ОтключитьПостобработкуДокументаОбмена") Тогда
			ПараметрыЗаписи.Вставить("ОтключитьПостобработкуДокументаОбмена");
		КонецЕсли;
		
		ПараметрыЗаписи.Вставить("ЭтоЗагрузка");
		
		//@skip-check query-in-loop
		ЗаписатьДанныеДокументаОбмена(ДанныеДокумента, ПараметрыЗаписи, ДанныеЗагружены);
		
	КонецЦикла;
	
	Возврат ДанныеЗагружены;
	
КонецФункции

Функция ПолучитьДанныеПересчетаСтрок(МобильноеУстройство, ИдентификаторДокумента) Экспорт
	
	ОбщегоНазначенияКлиентСервер.Проверить(SUI_ИнтеграцияВКонфигурациюКлиентСервер.ЭтоИдентификаторSimple(ИдентификаторДокумента),
		СтрШаблон(НСтр("ru = 'Идентификатор документа ""%1"" не является идентификатором Simple.'"), ИдентификаторДокумента));
	
	ИсключаемыеСостояния = SUI_ОбщегоНазначенияКлиентСервер.МассивЗначений(
		Перечисления.SUI_СостоянияДокументовОбмена.Новый, 
		Перечисления.SUI_СостоянияДокументовОбмена.Отменен, 
		Перечисления.SUI_СостоянияДокументовОбмена.Завершен);

	ОбщегоНазначенияКлиентСервер.Проверить(ДокументБылВыгружен(ИдентификаторДокумента, ИсключаемыеСостояния),
		СтрШаблон(НСтр("ru = 'Документ с идентификатором ""%1"" не был выгружен.'"), ИдентификаторДокумента));
	
	ДанныеПересчета = Новый Массив();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("id_doc", ИдентификаторДокумента);
	Запрос.УстановитьПараметр("МобильноеУстройство", МобильноеУстройство);
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	SUI_docs.sid,
		|	SUI_docs.id_doc
		|ПОМЕСТИТЬ втДанныеДокумента
		|ИЗ
		|	РегистрСведений.SUI_docs КАК SUI_docs
		|ГДЕ
		|	SUI_docs.id_doc = &id_doc
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втДанныеДокумента.id_doc,
		|	SUI_docs_tbl_goods_delta.id_good,
		|	SUI_docs_tbl_goods_delta.id_properties,
		|	SUI_docs_tbl_goods_delta.id_series,
		|	SUI_docs_tbl_goods_delta.id_cell,
		|	SUI_docs_tbl_goods_delta.id_unit,
		|	SUI_docs_tbl_goods_delta.id_price,
		|	SUI_docs_tbl_goods_delta.price,
		|	СУММА(SUI_docs_tbl_goods_delta.d_qtty) КАК qtty,
		|	СУММА(ВЫБОР
		|		КОГДА НЕ SUI_МобильныеУстройства.Ссылка ЕСТЬ NULL
		|			ТОГДА SUI_docs_tbl_goods_delta.d_qtty
		|		ИНАЧЕ 0
		|	КОНЕЦ) КАК d_qtty,
		|	SUI_docs_tbl_goods_delta.use_series,
		|	ВЫБОР
		|		КОГДА SUI_docs_tbl_goods_delta.ТипТаблицы = ЗНАЧЕНИЕ(Перечисление.SUI_ТипыТаблицДокументовОбмена.Отбор)
		|			ТОГДА ""out""
		|		КОГДА SUI_docs_tbl_goods_delta.ТипТаблицы = ЗНАЧЕНИЕ(Перечисление.SUI_ТипыТаблицДокументовОбмена.Размещение)
		|			ТОГДА ""in""
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК table_type
		|ИЗ
		|	РегистрСведений.SUI_docs_tbl_goods_delta КАК SUI_docs_tbl_goods_delta
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втДанныеДокумента КАК втДанныеДокумента
		|		ПО втДанныеДокумента.sid = SUI_docs_tbl_goods_delta.sid_doc
		|		ЛЕВОЕ СОЕДИНЕНИЕ ПланОбмена.SUI_МобильныеУстройства КАК SUI_МобильныеУстройства
		|		ПО SUI_docs_tbl_goods_delta.МобильноеУстройство = SUI_МобильныеУстройства.Ссылка
		|		И SUI_МобильныеУстройства.Ссылка = &МобильноеУстройство
		|СГРУППИРОВАТЬ ПО
		|	втДанныеДокумента.id_doc,
		|	SUI_docs_tbl_goods_delta.id_good,
		|	SUI_docs_tbl_goods_delta.id_properties,
		|	SUI_docs_tbl_goods_delta.id_series,
		|	SUI_docs_tbl_goods_delta.id_cell,
		|	SUI_docs_tbl_goods_delta.id_unit,
		|	SUI_docs_tbl_goods_delta.id_price,
		|	SUI_docs_tbl_goods_delta.price,
		|	SUI_docs_tbl_goods_delta.use_series,
		|	ВЫБОР
		|		КОГДА SUI_docs_tbl_goods_delta.ТипТаблицы = ЗНАЧЕНИЕ(Перечисление.SUI_ТипыТаблицДокументовОбмена.Отбор)
		|			ТОГДА ""out""
		|		КОГДА SUI_docs_tbl_goods_delta.ТипТаблицы = ЗНАЧЕНИЕ(Перечисление.SUI_ТипыТаблицДокументовОбмена.Размещение)
		|			ТОГДА ""in""
		|		ИНАЧЕ """"
		|	КОНЕЦ";
	
	РезультатЗапроса = Запрос.Выполнить();

	Если Не РезультатЗапроса.Пустой() Тогда
		
		ИменаКолонок = SUI_ОбщегоНазначения.ПолучитьИменаКолонокРезультатаЗапроса(РезультатЗапроса);
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			ДанныеСтроки = Новый Структура(ИменаКолонок);
			ЗаполнитьЗначенияСвойств(ДанныеСтроки, Выборка);
			ДанныеПересчета.Добавить(ДанныеСтроки);
		КонецЦикла;
		
	КонецЕсли;

	Возврат ДанныеПересчета;
	
КонецФункции

Функция ДанныеДокументаОбменаКЗагрузкеВДокумент(Параметры, АдресРезультата = Неопределено) Экспорт
	
	ДокументСсылка = SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "ДокументСсылка");
	
	ОбщегоНазначенияКлиентСервер.Проверить(ЗначениеЗаполнено(ДокументСсылка),
		НСтр("ru = 'Не удалось получить ссылку документа для загрузки данных документа обмена в документ.'"));

	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ШаблонИдентификатораSimple", SUI_ИнтеграцияВКонфигурациюКлиентСервер.ШаблонИдентификатораSimple());
	Запрос.УстановитьПараметр("id_doc", SUI_ИнтеграцияВКонфигурацию.ИдентификаторSimpleПоСсылке(ДокументСсылка));
	
	//@skip-check bsl-variable-name-invalid
	sid = SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "sid", "", Тип("Строка"));
	Если ПустаяСтрока(sid) Тогда
		Идентификатор = ИдентификаторДокументаПоПараметру(ДокументСсылка, "ДанныеДокументаОбменаКЗагрузкеВДокумент");
		Запрос.УстановитьПараметр("sid", SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Идентификатор, "SID"));
	Иначе
		Запрос.УстановитьПараметр("sid", sid);
	КонецЕсли;
	
	НастройкаДокумента = SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "НастройкаДокумента", 
		Справочники.SUI_НастройкиДокументов.ПустаяСсылка(), Тип("СправочникСсылка.SUI_НастройкиДокументов"));
	
	Если ЗначениеЗаполнено(НастройкаДокумента) И Не НастройкаДокумента.Пустая() Тогда
		Запрос.УстановитьПараметр("НастройкаДокумента", НастройкаДокумента);
	Иначе
		Запрос.УстановитьПараметр("НастройкаДокумента", Неопределено);
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ЭтоДокументСборШтрихкодов", (ДокументСсылка.Метаданные() = Метаданные.Документы.SUI_СборШтрихкодов));
	
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	SUI_docs.sid КАК sid
		|ПОМЕСТИТЬ втSIDДокумента
		|ИЗ
		|	РегистрСведений.SUI_docs КАК SUI_docs
		|ГДЕ
		|	ВЫБОР
		|		КОГДА &id_doc <> НЕОПРЕДЕЛЕНО
		|			ТОГДА SUI_docs.id_doc = &id_doc
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ
		|	И ВЫБОР
		|		КОГДА &sid <> НЕОПРЕДЕЛЕНО
		|			ТОГДА SUI_docs.sid = &sid
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ
		|	И ВЫБОР
		|		КОГДА &НастройкаДокумента <> НЕОПРЕДЕЛЕНО
		|			ТОГДА SUI_docs.НастройкаДокумента = &НастройкаДокумента
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	SUI_docs.sid КАК sid,
		|	SUI_docs.НастройкаДокумента КАК НастройкаДокумента,
		|	SUI_docs.doc_date КАК Дата,
		|	SUI_docs.doc_n КАК Номер,
		|	SUI_docs.id_countragents КАК Контрагент,
		|	SUI_docs.id_warehouse КАК Склад,
		|	SUI_docs.КонтролироватьДокумент КАК КонтролироватьДокумент,
		|	SUI_docs.ЭтоДокументАдресногоХранения КАК ЭтоДокументАдресногоХранения,
		|	SUI_docs.Состояние КАК Состояние,
		|	SUI_docs.МобильноеУстройство КАК МобильноеУстройство,
		|	SUI_docs.ДатаОбновления КАК ДатаОбновления
		|ИЗ
		|	втSIDДокумента КАК втSIDДокумента
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.SUI_docs КАК SUI_docs
		|		ПО втSIDДокумента.sid = SUI_docs.sid
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА SUI_docs_tbl_goods.qtty > 0
		|		И SUI_docs_tbl_goods.qtty = SUI_docs_tbl_goods.qtty_plan
		|			ТОГДА 0
		|		КОГДА SUI_docs_tbl_goods.qtty > SUI_docs_tbl_goods.qtty_plan
		|			ТОГДА 1
		|		КОГДА SUI_docs_tbl_goods.qtty < SUI_docs_tbl_goods.qtty_plan
		|			ТОГДА 2
		|		ИНАЧЕ 3
		|	КОНЕЦ КАК ИндексКартинки,
		|	SUI_docs_tbl_goods.sid КАК sid,
		|	SUI_docs_tbl_goods.id_good КАК id_good,
		|	SUI_docs_tbl_goods.id_properties КАК id_properties,
		|	SUI_docs_tbl_goods.id_series КАК id_series,
		|	SUI_docs_tbl_goods.id_cell КАК id_cell,
		|	SUI_docs_tbl_goods.id_unit КАК id_unit,
		|	SUI_docs_tbl_goods.id_price КАК id_price,
		|	SUI_docs_tbl_goods.price КАК price,
		|	SUI_docs_tbl_goods.qtty КАК qtty,
		|	SUI_docs_tbl_goods.qtty_plan КАК qtty_plan,
		|	SUI_docs_tbl_goods.use_series КАК use_series,
		|	SUI_docs_tbl_goods.ТипТаблицы КАК ТипТаблицы
		|ИЗ
		|	втSIDДокумента КАК втSIDДокумента
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.SUI_docs_tbl_goods КАК SUI_docs_tbl_goods
		|		ПО втSIDДокумента.sid = SUI_docs_tbl_goods.sid_doc
		|ИТОГИ
		|ПО
		|	ТипТаблицы
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	МАКСИМУМ(SUI_docs_tbl_series.sid) КАК sid,
		|	SUI_docs_tbl_series.id_good КАК id_good,
		|	SUI_docs_tbl_series.id_properties КАК id_properties,
		|	SUI_docs_tbl_series.id_series КАК id_series,
		|	SUI_docs_tbl_series.id_warehouse КАК id_warehouse,
		|	СУММА(SUI_docs_tbl_series.qtty) КАК qtty
		|ИЗ
		|	втSIDДокумента КАК втSIDДокумента
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.SUI_docs_tbl_series КАК SUI_docs_tbl_series
		|		ПО втSIDДокумента.sid = SUI_docs_tbl_series.sid_doc
		|ГДЕ
		|	SUI_docs_tbl_series.СтатусОбработки <> ЗНАЧЕНИЕ(Перечисление.SUI_СтатусыОбработкиСтрок.Новая)
		|	И SUI_docs_tbl_series.id_series ПОДОБНО &ШаблонИдентификатораSimple
		|СГРУППИРОВАТЬ ПО
		|	SUI_docs_tbl_series.id_good,
		|	SUI_docs_tbl_series.id_properties,
		|	SUI_docs_tbl_series.id_series,
		|	SUI_docs_tbl_series.id_warehouse
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	SUI_docs_tbl_barcodes.sid КАК sid,
		|	SUI_docs_tbl_barcodes.id_marking_code КАК id_marking_code
		|ИЗ
		|	втSIDДокумента КАК втSIDДокумента
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.SUI_docs_tbl_barcodes КАК SUI_docs_tbl_barcodes
		|		ПО втSIDДокумента.sid = SUI_docs_tbl_barcodes.sid_doc
		|ГДЕ
		|	SUI_docs_tbl_barcodes.id_marking_code ПОДОБНО &ШаблонИдентификатораSimple
		|	И SUI_docs_tbl_barcodes.СтатусОбработки <> ЗНАЧЕНИЕ(Перечисление.SUI_СтатусыОбработкиСтрок.Новая)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	SUI_docs_tbl_barcode_flow.barcode КАК barcode,
		|	SUI_tbl_barcodes.id_good КАК id_good,
		|	SUI_tbl_barcodes.id_property КАК id_property,
		|	SUI_tbl_barcodes.id_series КАК id_series,
		|	SUI_tbl_barcodes.id_unit КАК id_unit,
		|	СУММА(1) КАК qtty
		|ИЗ
		|	втSIDДокумента КАК втSIDДокумента
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.SUI_docs_tbl_barcode_flow КАК SUI_docs_tbl_barcode_flow
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.SUI_tbl_barcodes КАК SUI_tbl_barcodes
		|			ПО SUI_docs_tbl_barcode_flow.barcode = SUI_tbl_barcodes.barcode
		|		ПО втSIDДокумента.sid = SUI_docs_tbl_barcode_flow.sid_doc
		|СГРУППИРОВАТЬ ПО
		|	SUI_docs_tbl_barcode_flow.barcode,
		|	SUI_tbl_barcodes.id_good,
		|	SUI_tbl_barcodes.id_property,
		|	SUI_tbl_barcodes.id_series,
		|	SUI_tbl_barcodes.id_unit
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	SUI_docs_tbl_barcode_flow.barcode КАК Штрихкод,
		|	СУММА(1) КАК Количество
		|ИЗ
		|	втSIDДокумента КАК втSIDДокумента
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.SUI_docs_tbl_barcode_flow КАК SUI_docs_tbl_barcode_flow
		|		ПО втSIDДокумента.sid = SUI_docs_tbl_barcode_flow.sid_doc
		|		И &ЭтоДокументСборШтрихкодов
		|СГРУППИРОВАТЬ ПО
		|	SUI_docs_tbl_barcode_flow.barcode
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ втSIDДокумента";
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	РезультатДанныеДокумент = РезультатыЗапроса[1];
	РезультатТовары = РезультатыЗапроса[2];
	РезультатСерии = РезультатыЗапроса[3];
	РезультатШтрихкодыУпаковок = РезультатыЗапроса[4];
	РезультатПотокШтрихкодов = РезультатыЗапроса[5];
	РезультатСборШтрихкодов = РезультатыЗапроса[6];

	Если РезультатДанныеДокумент.Пустой() Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Не удалось получить данные документа обмена'"));
		Возврат Неопределено;
	КонецЕсли;
	
	ДанныеДокументаОбмена = Новый Структура(SUI_ОбщегоНазначения.ПолучитьИменаКолонокРезультатаЗапроса(РезультатДанныеДокумент));
	
	ВыборкаДанныеДокумента = РезультатДанныеДокумент.Выбрать();
	ВыборкаДанныеДокумента.Следующий();
	
	ЗаполнитьЗначенияСвойств(ДанныеДокументаОбмена, ВыборкаДанныеДокумента);
	
	SUI_ИнтеграцияВКонфигурацию.ВосстановитьСсылкиИдентификаторовSimple(ДанныеДокументаОбмена);

	ДанныеДокументаОбмена.Вставить("ДокументСсылка", ДокументСсылка);
	ДанныеДокументаОбмена.Вставить("ЭтоДокументСборШтрихкодов", Запрос.Параметры.ЭтоДокументСборШтрихкодов);
	
	НастройкиДокумента = SUI_НастройкиДокументовСервер.СформироватьНастройкиДокумента(ДанныеДокументаОбмена.НастройкаДокумента);

	ДанныеДокументаОбмена.Вставить("Таблицы", Новый Соответствие());
	
	Если ДанныеДокументаОбмена.ЭтоДокументСборШтрихкодов Тогда
		
		ДанныеДокументаОбмена.Таблицы.Вставить(Перечисления.SUI_ТипыТаблицДокументовОбмена.ПотокШтрихкодов, 
			РезультатСборШтрихкодов.Выгрузить());
	Иначе
		
		Если РезультатПотокШтрихкодов.Пустой() Тогда
			
			Если Не РезультатТовары.Пустой() Тогда
				
				Выборка = РезультатТовары.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
				Пока Выборка.Следующий() Цикл
					
					НастройкаТЧ = НастройкиДокумента.ТабличныеЧасти.Получить(Выборка.ТипТаблицы);
				
					Если Не ЗначениеЗаполнено(НастройкаТЧ) Тогда
						Продолжить;
					КонецЕсли;
					
					ТаблицаДокумента = ТаблицаДокументаПоНастройкеТабличнойЧасти(НастройкаТЧ.Элементы);
					
					КолонкиВыборки = SUI_ОбщегоНазначения.ПолучитьИменаКолонокРезультатаЗапроса(РезультатТовары);
					
					ДетальныеЗаписи = Выборка.Выбрать();
					
					Пока ДетальныеЗаписи.Следующий() Цикл
						
						ДанныеСтроки = Новый Структура(КолонкиВыборки);
						ЗаполнитьЗначенияСвойств(ДанныеСтроки, ДетальныеЗаписи);
						SUI_ИнтеграцияВКонфигурацию.ВосстановитьСсылкиИдентификаторовSimple(ДанныеСтроки, , Ложь);
						ЗаполнитьЗначенияСвойств(ТаблицаДокумента.Добавить(), ДанныеСтроки);
						
					КонецЦикла;
					
					ТаблицаДокумента.ЗаполнитьЗначения(ДанныеДокументаОбмена.sid, "sid_doc");
						
					ДанныеДокументаОбмена.Таблицы.Вставить(Выборка.ТипТаблицы, ТаблицаДокумента);
					
				КонецЦикла;
			
			КонецЕсли;
			
			Если Не РезультатСерии.Пустой() Тогда
			
				НастройкаТЧ = НастройкиДокумента.ТабличныеЧасти.Получить(Перечисления.SUI_ТипыТаблицДокументовОбмена.Серии);
				
				Если ЗначениеЗаполнено(НастройкаТЧ) Тогда
					
					ТаблицаДокумента = ТаблицаДокументаПоНастройкеТабличнойЧасти(НастройкаТЧ.Элементы);
				
					КолонкиВыборки = SUI_ОбщегоНазначения.ПолучитьИменаКолонокРезультатаЗапроса(РезультатСерии);
					
					Выборка = РезультатСерии.Выбрать();
	
					Пока Выборка.Следующий() Цикл
						ДанныеСтроки = Новый Структура(КолонкиВыборки);
						ЗаполнитьЗначенияСвойств(ДанныеСтроки, Выборка);
						SUI_ИнтеграцияВКонфигурацию.ВосстановитьСсылкиИдентификаторовSimple(ДанныеСтроки, , Ложь);
						ЗаполнитьЗначенияСвойств(ТаблицаДокумента.Добавить(), ДанныеСтроки);
					КонецЦикла;
					
					ТаблицаДокумента.ЗаполнитьЗначения(ДанныеДокументаОбмена.sid, "sid_doc");
					ДанныеДокументаОбмена.Таблицы.Вставить(Перечисления.SUI_ТипыТаблицДокументовОбмена.Серии, ТаблицаДокумента);
					
				Иначе
					
					ТаблицаСерийБезНастройки = Новый ТаблицаЗначений();
					
					Для Каждого Колонка Из РезультатСерии.Колонки Цикл
						ТаблицаСерийБезНастройки.Колонки.Добавить(Колонка.Имя);
					КонецЦикла;
					
					ТаблицаСерийБезНастройки.Колонки.Добавить("НомерСтроки", 
						SUI_ОбщегоНазначения.ОписаниеТипаЧисло(10, 0, ДопустимыйЗнак.Неотрицательный), НСтр("ru = 'Номер строки'"));
					ТаблицаСерийБезНастройки.Колонки.Добавить("sid_doc", SUI_ОбщегоНазначения.ОписаниеТипаСтрока(36), НСтр("ru = 'SID документа'"));
					
					КолонкиВыборки = SUI_ОбщегоНазначения.ПолучитьИменаКолонокРезультатаЗапроса(РезультатСерии);
					
					Выборка = РезультатСерии.Выбрать();
	
					Пока Выборка.Следующий() Цикл
						ДанныеСтроки = Новый Структура(КолонкиВыборки);
						ЗаполнитьЗначенияСвойств(ДанныеСтроки, Выборка);
						SUI_ИнтеграцияВКонфигурацию.ВосстановитьСсылкиИдентификаторовSimple(ДанныеСтроки, , Ложь);
						ЗаполнитьЗначенияСвойств(ТаблицаСерийБезНастройки.Добавить(), ДанныеСтроки);
					КонецЦикла;
		
					ТаблицаСерийБезНастройки.ЗаполнитьЗначения(ДанныеДокументаОбмена.sid, "sid_doc");
					ДанныеДокументаОбмена.Вставить("ТаблицаСерийБезНастройки", ТаблицаСерийБезНастройки);
					
				КонецЕсли;
				
			КонецЕсли;
			
			Если Не РезультатШтрихкодыУпаковок.Пустой() Тогда
				
				НастройкаТЧ = НастройкиДокумента.ТабличныеЧасти.Получить(Перечисления.SUI_ТипыТаблицДокументовОбмена.ШтрихкодыУпаковок);
				
				Если ЗначениеЗаполнено(НастройкаТЧ) Тогда
					
					ТаблицаДокумента = ТаблицаДокументаПоНастройкеТабличнойЧасти(НастройкаТЧ.Элементы);
				
					КолонкиВыборки = SUI_ОбщегоНазначения.ПолучитьИменаКолонокРезультатаЗапроса(РезультатШтрихкодыУпаковок);
					
					Выборка = РезультатШтрихкодыУпаковок.Выбрать();
	
					Пока Выборка.Следующий() Цикл
						ДанныеСтроки = Новый Структура(КолонкиВыборки);
						ЗаполнитьЗначенияСвойств(ДанныеСтроки, Выборка);
						SUI_ИнтеграцияВКонфигурацию.ВосстановитьСсылкиИдентификаторовSimple(ДанныеСтроки, , Ложь);
						ЗаполнитьЗначенияСвойств(ТаблицаДокумента.Добавить(), ДанныеСтроки);
					КонецЦикла;
				
					ТаблицаДокумента.ЗаполнитьЗначения(ДанныеДокументаОбмена.sid, "sid_doc");
					ДанныеДокументаОбмена.Таблицы.Вставить(Перечисления.SUI_ТипыТаблицДокументовОбмена.ШтрихкодыУпаковок, ТаблицаДокумента);
					
				КонецЕсли;
				
			КонецЕсли;
			
		Иначе
			// : Обрабатываем только поток ШК  
			НастройкаТЧ = НастройкиДокумента.ТабличныеЧасти.Получить(Перечисления.SUI_ТипыТаблицДокументовОбмена.Товары);
			
			Если ЗначениеЗаполнено(НастройкаТЧ) Тогда
				
				ТаблицаДокумента = ТаблицаДокументаПоНастройкеТабличнойЧасти(НастройкаТЧ.Элементы);
				
				КолонкиВыборки = SUI_ОбщегоНазначения.ПолучитьИменаКолонокРезультатаЗапроса(РезультатПотокШтрихкодов);
				
				Выборка = РезультатПотокШтрихкодов.Выбрать();
				
				Пока Выборка.Следующий() Цикл
					ДанныеСтроки = Новый Структура(КолонкиВыборки);
					ЗаполнитьЗначенияСвойств(ДанныеСтроки, Выборка);
					SUI_ИнтеграцияВКонфигурацию.ВосстановитьСсылкиИдентификаторовSimple(ДанныеСтроки, , Ложь);
					ЗаполнитьЗначенияСвойств(ТаблицаДокумента.Добавить(), ДанныеСтроки);
				КонецЦикла;
				
				ТаблицаДокумента.ЗаполнитьЗначения(ДанныеДокументаОбмена.sid, "sid_doc");
				ДанныеДокументаОбмена.Таблицы.Вставить(Перечисления.SUI_ТипыТаблицДокументовОбмена.Товары, ТаблицаДокумента);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(АдресРезультата) И ЭтоАдресВременногоХранилища(АдресРезультата) Тогда
		ПоместитьВоВременноеХранилище(ДанныеДокументаОбмена, АдресРезультата);
	КонецЕсли;
	
	Возврат ДанныеДокументаОбмена;	
	
КонецФункции

Функция ДанныеДокументаДополнительные(Параметры, АдресРезультата = Неопределено) Экспорт
	
	ДанныеДокументаОбмена = Новый Структура();
	
	
	
	ДокументСсылка = SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "ДокументСсылка");
	
	ОбщегоНазначенияКлиентСервер.Проверить(ЗначениеЗаполнено(ДокументСсылка),
		НСтр("ru = 'Не удалось получить ссылку документа.'"));
	
	ИдентификаторДокумента = SUI_ИнтеграцияВКонфигурацию.ИдентификаторSimpleПоСсылке(ДокументСсылка);
	
	ОбщегоНазначенияКлиентСервер.Проверить(ЗначениеЗаполнено(ИдентификаторДокумента),
		НСтр("ru = 'Не удалось получить идентификатор документа.'"));
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ИдентификаторДокумента", ИдентификаторДокумента);
	Запрос.Текст = "ВЫБРАТЬ
	|	SUI_docs_tbl_series.id_good КАК Номенклатура,
	|	SUI_docs_tbl_series.number КАК Штрихкод
	|ИЗ
	|	РегистрСведений.SUI_docs_tbl_series КАК SUI_docs_tbl_series
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.SUI_docs КАК SUI_docs
	|		ПО (SUI_docs.sid = SUI_docs_tbl_series.sid_doc)
	|ГДЕ
	|	SUI_docs.id_doc = &ИдентификаторДокумента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	SUI_tbl_barcodes.id_good КАК Номенклатура,
	|	SUI_docs_tbl_barcode_flow.barcode КАК Штрихкод,
	|	ЕСТЬNULL(SUI_tbl_barcodes.id_property, НЕОПРЕДЕЛЕНО) КАК Характеристика,
	|	ЕСТЬNULL(SUI_tbl_barcodes.id_series, НЕОПРЕДЕЛЕНО) КАК Серия,
	|	ЕСТЬNULL(SUI_tbl_barcodes.id_unit, НЕОПРЕДЕЛЕНО) КАК Упаковка
	|ИЗ
	|	РегистрСведений.SUI_docs_tbl_barcode_flow КАК SUI_docs_tbl_barcode_flow
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.SUI_docs КАК SUI_docs
	|		ПО (SUI_docs.sid = SUI_docs_tbl_barcode_flow.sid_doc)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.SUI_tbl_barcodes КАК SUI_tbl_barcodes
	|		ПО SUI_docs_tbl_barcode_flow.barcode = SUI_tbl_barcodes.barcode
	|ГДЕ
	|	SUI_docs.id_doc = &ИдентификаторДокумента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	SUI_docs_tbl_barcodes.id_good КАК Номенклатура,
	|	SUI_docs_tbl_barcodes.mark_code КАК Штрихкод,
	|	SUI_docs_tbl_barcodes.id_property КАК Характеристика,
	|	SUI_docs_tbl_barcodes.id_series КАК Серия,
	|	SUI_docs_tbl_barcodes.id_unit КАК Упаковка
	|ИЗ
	|	РегистрСведений.SUI_docs_tbl_barcodes КАК SUI_docs_tbl_barcodes
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.SUI_docs КАК SUI_docs
	|		ПО SUI_docs_tbl_barcodes.sid_doc = SUI_docs.sid
	|ГДЕ
	|	SUI_docs.id_doc = &ИдентификаторДокумента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	SUI_docs_tbl_goods_deltaСрезПоследних.id_good КАК Номенклатура
	|ИЗ
	|	РегистрСведений.SUI_docs_tbl_goods_delta.СрезПоследних КАК SUI_docs_tbl_goods_deltaСрезПоследних
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.SUI_docs КАК SUI_docs
	|		ПО (SUI_docs_tbl_goods_deltaСрезПоследних.sid_doc = SUI_docs.id_doc)
	|ГДЕ
	|	SUI_docs.id_doc = &ИдентификаторДокумента";
	
	РезультатыЗапроса 	= Запрос.ВыполнитьПакет();
	
	РезультатСерии 		= РезультатыЗапроса[0];
	РезультатПоток 		= РезультатыЗапроса[1];
	РезультатШтрихкод 	= РезультатыЗапроса[2];
	РезультатПересчет 	= РезультатыЗапроса[3];
	
	// Серии
	Если Не РезультатСерии.Пустой() Тогда
		
		ДанныеДокументаОбмена.Вставить("ТабличныйДокументСерии", Новый ТабличныйДокумент());
		
		ИменаКолонок = SUI_ОбщегоНазначения.ПолучитьИменаКолонокРезультатаЗапроса(РезультатСерии);
		
		МакетДанных = Обработки.SUI_ФормаДополнительнаяИнформация.ПолучитьМакет("МакетДанные");
		
		ДанныеДокументаОбмена.ТабличныйДокументСерии.Вывести(МакетДанных.ПолучитьОбласть("ШапкаТаблицы|ОсновнаяИнформация"));

		ОбластьСтрокаОсновнаяИнформация = МакетДанных.ПолучитьОбласть("СтрокаТаблицы|ОсновнаяИнформация");

		Выборка = РезультатСерии.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			СтруктураДанных = Новый Структура(ИменаКолонок);
			ЗаполнитьЗначенияСвойств(СтруктураДанных, Выборка);
			
			SUI_ИнтеграцияВКонфигурацию.ВосстановитьСсылкиИдентификаторовSimple(СтруктураДанных, , Ложь);
			
			ОбластьСтрокаОсновнаяИнформация.Параметры.Заполнить(СтруктураДанных);       

			ДанныеДокументаОбмена.ТабличныйДокументСерии.Вывести(ОбластьСтрокаОсновнаяИнформация);
			
		КонецЦикла;
		
	КонецЕсли;
	
	// Поток
	Если Не РезультатПоток.Пустой() Тогда
		
		ДанныеДокументаОбмена.Вставить("ТабличныйДокументПоток", Новый ТабличныйДокумент());
	
		ИменаКолонок = SUI_ОбщегоНазначения.ПолучитьИменаКолонокРезультатаЗапроса(РезультатПоток);
		
		МакетДанных = Обработки.SUI_ФормаДополнительнаяИнформация.ПолучитьМакет("МакетДанные");
		
		ДанныеДокументаОбмена.ТабличныйДокументПоток.Вывести(МакетДанных.ПолучитьОбласть("ШапкаТаблицы|ОсновнаяИнформация"));
		ДанныеДокументаОбмена.ТабличныйДокументПоток.Присоединить(МакетДанных.ПолучитьОбласть("ШапкаТаблицы|ДополнительнаяИнформация"));
		
		ОбластьСтрокаОсновнаяИнформация = МакетДанных.ПолучитьОбласть("СтрокаТаблицы|ОсновнаяИнформация");
		ОбластьСтрокаДополнительнаяИнформация = МакетДанных.ПолучитьОбласть("СтрокаТаблицы|ДополнительнаяИнформация");
		
		Выборка = РезультатПоток.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			СтруктураДанных = Новый Структура(ИменаКолонок);
			ЗаполнитьЗначенияСвойств(СтруктураДанных, Выборка);
			
			SUI_ИнтеграцияВКонфигурацию.ВосстановитьСсылкиИдентификаторовSimple(СтруктураДанных, , Ложь);
			
			ОбластьСтрокаОсновнаяИнформация.Параметры.Заполнить(СтруктураДанных);
			ОбластьСтрокаДополнительнаяИнформация.Параметры.Заполнить(СтруктураДанных);

			ДанныеДокументаОбмена.ТабличныйДокументПоток.Вывести(ОбластьСтрокаОсновнаяИнформация);
			ДанныеДокументаОбмена.ТабличныйДокументПоток.Присоединить(ОбластьСтрокаДополнительнаяИнформация);
			
		КонецЦикла;
		
	КонецЕсли;
	
	// Штрихкод
	Если Не РезультатШтрихкод.Пустой() Тогда
		
		ДанныеДокументаОбмена.Вставить("ТабличныйДокументШтрихкоды", Новый ТабличныйДокумент());
	
		ИменаКолонок = SUI_ОбщегоНазначения.ПолучитьИменаКолонокРезультатаЗапроса(РезультатШтрихкод);
		
		МакетДанных = Обработки.SUI_ФормаДополнительнаяИнформация.ПолучитьМакет("МакетДанные");
		
		ДанныеДокументаОбмена.ТабличныйДокументШтрихкоды.Вывести(МакетДанных.ПолучитьОбласть("ШапкаТаблицы|ОсновнаяИнформация"));
		ДанныеДокументаОбмена.ТабличныйДокументШтрихкоды.Присоединить(МакетДанных.ПолучитьОбласть("ШапкаТаблицы|ДополнительнаяИнформация"));
		
		ОбластьСтрокаОсновнаяИнформация = МакетДанных.ПолучитьОбласть("СтрокаТаблицы|ОсновнаяИнформация");
		ОбластьСтрокаДополнительнаяИнформация = МакетДанных.ПолучитьОбласть("СтрокаТаблицы|ДополнительнаяИнформация");
		
		Выборка = РезультатШтрихкод.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			СтруктураДанных = Новый Структура(ИменаКолонок);
			ЗаполнитьЗначенияСвойств(СтруктураДанных, Выборка);
			
			SUI_ИнтеграцияВКонфигурацию.ВосстановитьСсылкиИдентификаторовSimple(СтруктураДанных, , Ложь);
			
			ОбластьСтрокаОсновнаяИнформация.Параметры.Заполнить(СтруктураДанных);
			ОбластьСтрокаДополнительнаяИнформация.Параметры.Заполнить(СтруктураДанных);

			ДанныеДокументаОбмена.ТабличныйДокументШтрихкоды.Вывести(ОбластьСтрокаОсновнаяИнформация);
			ДанныеДокументаОбмена.ТабличныйДокументШтрихкоды.Присоединить(ОбластьСтрокаДополнительнаяИнформация);
			
		КонецЦикла;
		
	КонецЕсли;
	
	// Пересчет
	Если Не РезультатПересчет.Пустой() Тогда
		
		ДанныеДокументаОбмена.Вставить("ТабличныйДокументПересчет", Новый ТабличныйДокумент());
		
		ИменаКолонок = SUI_ОбщегоНазначения.ПолучитьИменаКолонокРезультатаЗапроса(РезультатПересчет);
		
		МакетДанных = Обработки.SUI_ФормаДополнительнаяИнформация.ПолучитьМакет("МакетДанные");
		
		ДанныеДокументаОбмена.ТабличныйДокументПересчет.Вывести(МакетДанных.ПолучитьОбласть("ШапкаТаблицы|ОсновнаяИнформация"));

		ОбластьСтрокаОсновнаяИнформация = МакетДанных.ПолучитьОбласть("СтрокаТаблицы|ОсновнаяИнформация");
		
		Выборка = РезультатПересчет.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			СтруктураДанных = Новый Структура(ИменаКолонок);
			ЗаполнитьЗначенияСвойств(СтруктураДанных, Выборка);
			
			SUI_ИнтеграцияВКонфигурацию.ВосстановитьСсылкиИдентификаторовSimple(СтруктураДанных, , Ложь);
			
			ОбластьСтрокаОсновнаяИнформация.Параметры.Заполнить(СтруктураДанных);
			ОбластьСтрокаДополнительнаяИнформация.Параметры.Заполнить(СтруктураДанных);

			ДанныеДокументаОбмена.ТабличныйДокументПересчет.Вывести(ОбластьСтрокаОсновнаяИнформация);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(АдресРезультата) И ЭтоАдресВременногоХранилища(АдресРезультата) Тогда
		ПоместитьВоВременноеХранилище(ДанныеДокументаОбмена, АдресРезультата);
	КонецЕсли;
	
	Возврат ДанныеДокументаОбмена;	
	
КонецФункции

Процедура ЗаписатьДокументОбъект(ДокументОбъект, НастройкаДокумента, ТаблицыДокументаОбмена, СтрокиКОбработкеАлгоритмом) Экспорт
	
	НастройкиДокумента = SUI_НастройкиДокументовСервер.СформироватьНастройкиДокумента(НастройкаДокумента);
	
	
	ИмяМетаданныхДокумент = SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(НастройкиДокумента, "ИмяМетаданных", "", Тип("Строка"));
	
	Если ЗначениеЗаполнено(ИмяМетаданныхДокумент) Тогда	
		
		ТаблицыДокумента = SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(НастройкиДокумента, "ТабличныеЧасти", Новый Соответствие, Тип("Соответствие"));
		
		НастрокиТаблицПропускатьПриЗаписи = SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(НастройкиДокумента,
			"ДополнительныеНастройки.ПропускатьПриЗаписи", Новый Соответствие, Тип("Соответствие"));
		
		Для Каждого ТаблицаНаФорме Из ТаблицыДокументаОбмена Цикл
			
			Если ЗначениеЗаполнено(НастрокиТаблицПропускатьПриЗаписи.Получить(ТаблицаНаФорме.Ключ)) И НастрокиТаблицПропускатьПриЗаписи.Получить(ТаблицаНаФорме.Ключ) Тогда
				
				ИмяТЧ = SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ТаблицыДокумента.Получить(ТаблицаНаФорме.Ключ),"ИмяТабличнойЧасти", "", Тип("Строка"));
				
				Если Не ПустаяСтрока(ИмяТЧ) Тогда 					
					Запрос1 = Новый Запрос("
					|ВЫБРАТЬ
					|	*
					|ИЗ
					|	Документ." + ИмяМетаданныхДокумент+"."+ИмяТЧ+" КАК Документ
					|ГДЕ
					|	Документ.Ссылка = &Ссылка");
					Запрос1.УстановитьПараметр("Ссылка", ДокументОбъект.Ссылка); 
					ДокументОбъект[ИмяТЧ].Очистить();
					ДокументОбъект[ИмяТЧ].Загрузить(Запрос1.Выполнить().Выгрузить());
				КонецЕсли;
								
			КонецЕсли;  
			
		КонецЦикла; 
		
	КонецЕсли; 
	
	АлгоритмПослеЗаписи = SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(НастройкиДокумента, 
		"ДополнительныеНастройки.ОбработчикиСобытий.ПослеЗаписи", "", Тип("Строка"));
	
	ЗапуститьЗадание = Ложь;
	//ВыполнитьАлгоритмПередЗаписью = Ложь;
	
	НачатьТранзакцию();
	
	Попытка
		
		УстановитьПривилегированныйРежим(Истина);
		
		Если СтрокиКОбработкеАлгоритмом <> Неопределено И СтрокиКОбработкеАлгоритмом.Количество() > 0 Тогда
					
			АлгоритмыОбработкиСтрок = SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(НастройкиДокумента, 
				"ДополнительныеНастройки.АлгоритмыОбработкиСтрокТабличныхЧастей", Новый Соответствие(), Тип("Соответствие"));
			
			СтрокиКОбработкеАлгоритмом.Свернуть("ТипТаблицы, НомерСтроки");
			
			Построитель = Новый ПостроительЗапроса;
			Построитель.ИсточникДанных = Новый ОписаниеИсточникаДанных(СтрокиКОбработкеАлгоритмом);
			
			ТипыТаблицКОбработкеАлгоритмом = СтрокиКОбработкеАлгоритмом.Скопировать();
			ТипыТаблицКОбработкеАлгоритмом.Свернуть("ТипТаблицы");
			
			Для Каждого СтрокаТипыТаблицКобработкеАлгоритмом Из ТипыТаблицКОбработкеАлгоритмом Цикл

				НастройкаТЧ = НастройкиДокумента.ТабличныеЧасти.Получить(СтрокаТипыТаблицКобработкеАлгоритмом.ТипТаблицы);
					
				Если Не ЗначениеЗаполнено(НастройкаТЧ) Тогда
					Продолжить;
				КонецЕсли;
				
				АлгоритмОбработкиСтроки = АлгоритмыОбработкиСтрок.Получить(СтрокаТипыТаблицКобработкеАлгоритмом.ТипТаблицы);
				
				Если Не ЗначениеЗаполнено(АлгоритмОбработкиСтроки) Тогда
					Продолжить;
				КонецЕсли;
				
				Построитель.Отбор.Сбросить();
				
				СтрокаОтбора = Построитель.Отбор.Добавить("ТипТаблицы");
				СтрокаОтбора.ВидСравнения = ВидСравнения.Равно;
				СтрокаОтбора.Значение = СтрокаТипыТаблицКобработкеАлгоритмом.ТипТаблицы;
				СтрокаОтбора.Использование = Истина;
				
				Построитель.Выполнить();
				НомераСтрок = Построитель.Результат.Выгрузить().ВыгрузитьКолонку("НомерСтроки");
				
				Для Каждого СтрокаТЧДокумента Из ДокументОбъект[НастройкаТЧ.ИмяТабличнойЧасти] Цикл
					
					Если НомераСтрок.Найти(СтрокаТЧДокумента.НомерСтроки) = Неопределено Тогда
						Продолжить;
					КонецЕсли;
					
					ВыполнитьПроизвольныйАлгоритм_ОбработкаСтрокиТабличнойЧасти(АлгоритмОбработкиСтроки, ДокументОбъект, СтрокаТЧДокумента);
					
				КонецЦикла;
				
			КонецЦикла;
			
		КонецЕсли;

		ВыполнитьПроизвольныйАлгоритм_ПередЗаписью(SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(НастройкиДокумента, 
			"ДополнительныеНастройки.ОбработчикиСобытий.ПередЗаписью", "", Тип("Строка")), ДокументОбъект);
			
		ВыполнитьУстановкуЗначений(НастройкиДокумента.ТаблицаУстановкиРеквизитов, ДокументОбъект, ТаблицыДокументаОбмена); 
		
		УдалитьПустыеСтроки(НастройкиДокумента.ТабличныеЧасти, ДокументОбъект, ТаблицыДокументаОбмена);
		
		ДокументОбъект.ДополнительныеСвойства.Вставить("ОтключитьМеханизмРегистрацииОбъектов");
		
		ДокументОбъект.Записать(?(НастройкиДокумента.ПроводитьДокумент, ?(ДокументОбъект.ПометкаУдаления, РежимЗаписиДокумента.Запись, РежимЗаписиДокумента.Проведение), РежимЗаписиДокумента.Запись));
		
		ВыполнитьПроизвольныйАлгоритм_ПослеЗаписи(АлгоритмПослеЗаписи, ДокументОбъект.Ссылка);
		
		Если НастройкиДокумента.ДополнительныеНастройки.Свойство("АлгоритмыОбработкиСозданияДокументаНаОсновании") Тогда
			
			СоздатьДокументыНаОсновании(ДокументОбъект.Ссылка, 
				НастройкиДокумента.ДополнительныеНастройки.АлгоритмыОбработкиСозданияДокументаНаОсновании, 
				ТаблицыДокументаОбмена, НастройкиДокумента.ТаблицаСозданияДокументов);
							               
		КонецЕсли;
			
		ЗапуститьЗадание = Истина;
		
		УстановитьПривилегированныйРежим(Ложь);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		SUI_ЖурналРегистрации.ЗаписьВЖурналРегистрации(ИмяСобытия(), , 
			Метаданные.ОбщиеМодули.SUI_ДокументыОбмена, ДокументОбъект.Ссылка, ИнформацияОбОшибке());
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Возникла исключительная ошибка при записи документа %1.
			|%2'"), ДокументОбъект.Ссылка, ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	// Обновить строки таблиц документа обмена после записи документа в фоне
	Если ЗапуститьЗадание Тогда
		
		ПараметрыЗадания = Новый Структура();
		ПараметрыЗадания.Вставить("ТаблицыДокументаОбмена", ТаблицыДокументаОбмена);
		ПараметрыЗадания.Вставить("ДокументСсылка", ДокументОбъект.Ссылка);
		
		ПараметрыВыполненияПроцедуры = SUI_ДлительныеОперации.ПараметрыВыполненияПроцедуры();
		SUI_ДлительныеОперации.ВыполнитьПроцедуру(ПараметрыВыполненияПроцедуры,
			"SUI_ДокументыОбмена.ЗаданиеОбновитьТаблицыДокументаОбменаПослеЗаписиВДокумент", ПараметрыЗадания);
			
	КонецЕсли;
					
КонецПроцедуры

// Получить состояние документа обмена.
// 
// Параметры:
//  Документ - ДокументСсылка, Строка - Документ ссылка, идентификатор Simple документа или SID документа обмена.
//  НастройкаДокумента - СправочникСсылка.SUI_НастройкиДокументов - Настройка документа
// 
// Возвращаемое значение:
//  ПеречислениеСсылка.SUI_СостоянияДокументовОбмена, Неопределено - Состояние документа обмена или Неопределено,
//	если документ обмена не найден
Функция СостояниеДокументаОбмена(Документ, НастройкаДокумента = Неопределено) Экспорт
	
	Идентификатор = ИдентификаторДокументаПоПараметру(Документ, "СостояниеДокументаОбмена");
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("id_doc", ?(Идентификатор.Свойство("ID"), Идентификатор.ID, Неопределено));
	Запрос.УстановитьПараметр("sid", ?(Идентификатор.Свойство("SID"), Идентификатор.SID, Неопределено));
	Запрос.УстановитьПараметр("НастройкаДокумента", НастройкаДокумента);
	
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	SUI_docs.Состояние
		|ИЗ
		|	РегистрСведений.SUI_docs КАК SUI_docs
		|ГДЕ
		|	ВЫБОР
		|		КОГДА &id_doc <> НЕОПРЕДЕЛЕНО
		|			ТОГДА SUI_docs.id_doc = &id_doc
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ
		|	И ВЫБОР
		|		КОГДА &НастройкаДокумента <> НЕОПРЕДЕЛЕНО
		|			ТОГДА SUI_docs.НастройкаДокумента = &НастройкаДокумента
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ
		|	И ВЫБОР
		|		КОГДА &sid <> НЕОПРЕДЕЛЕНО
		|			ТОГДА SUI_docs.sid = &sid
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ";
		
	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = Запрос.Выполнить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.Состояние;

КонецФункции

// Документ был выгружен.
// 
// Параметры:
//  Документ - ДокументСсылка, Строка - Документ ссылка, идентификатор Simple документа или SID документа обмена.
//  ИсключаемыеСостояния - Массив из ПеречислениеСсылка.SUI_СостоянияДокументовОбмена - Исключаемые состояния документа обмена
//  НастройкаДокумента - СправочникСсылка.SUI_НастройкиДокументов - Настройка документа
// 
// Возвращаемое значение:
//  Булево - Документ был выгружен
Функция ДокументБылВыгружен(Документ, Знач ИсключаемыеСостояния = Неопределено, НастройкаДокумента = Неопределено) Экспорт
	
	Если ИсключаемыеСостояния = Неопределено Тогда
		ИсключаемыеСостояния = Новый Массив();
	КонецЕсли;
	
	СостояниеДокумента = СостояниеДокументаОбмена(Документ, НастройкаДокумента);
	
	Если Не ЗначениеЗаполнено(СостояниеДокумента) Тогда
		Возврат Ложь;
	Иначе
		Возврат (ИсключаемыеСостояния.Найти(СостояниеДокумента) = Неопределено);
	КонецЕсли;
	
КонецФункции

// Сменить состояние документа обмена.
// 
// Параметры:
//  НовоеСостояние - ПеречислениеСсылка.SUI_СостоянияДокументовОбмена - Новое состояние
//  Документ - ДокументСсылка, Строка - Документ ссылка, идентификатор Simple документа или SID документа обмена.
//  НастройкаДокумента - СправочникСсылка.SUI_НастройкиДокументов - Настройка документа
//  ОтключитьРегистрациюИзменений - Булево - Отключить регистрацию изменений
//  НеОбновлятьМеткуВремени - Булево - Не обновлять метку времени
Процедура СменитьСостояниеДокументаОбмена(НовоеСостояние, Документ, НастройкаДокумента = Неопределено,
	ОтключитьРегистрациюИзменений = Ложь, НеОбновлятьМеткуВремени = Ложь) Экспорт
	
	Запрос = Новый Запрос;
	
	Если SUI_ОбщегоНазначения.ЭтоСсылкаДокумента(Документ) Тогда
		Запрос.УстановитьПараметр("id_doc", 
			SUI_ИнтеграцияВКонфигурацию.ИдентификаторSimpleПоСсылке(Документ, Истина));
		Запрос.УстановитьПараметр("sid", Неопределено);
	ИначеЕсли SUI_СтроковыеФункцииКлиентСервер.ЭтоУникальныйИдентификатор(Документ) Тогда
		Запрос.УстановитьПараметр("sid", Документ);
		Запрос.УстановитьПараметр("id_doc", Неопределено);
	ИначеЕсли SUI_ИнтеграцияВКонфигурациюКлиентСервер.ЭтоИдентификаторSimple(Документ) Тогда
		Запрос.УстановитьПараметр("id_doc", Документ);
		Запрос.УстановитьПараметр("sid", Неопределено);
	Иначе
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Не передано значение параметра ""Документ"".'"));
		Возврат;
	КонецЕсли;
	
	Запрос.УстановитьПараметр("НастройкаДокумента", НастройкаДокумента);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	SUI_docs.sid КАК sid,
		|	SUI_docs.id_doc КАК id_doc,
		|	SUI_docs.НастройкаДокумента КАК НастройкаДокумента
		|ИЗ
		|	РегистрСведений.SUI_docs КАК SUI_docs
		|ГДЕ
		|	ВЫБОР
		|			КОГДА &sid <> НЕОПРЕДЕЛЕНО
		|				ТОГДА SUI_docs.sid = &sid
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|	И ВЫБОР
		|			КОГДА &id_doc <> НЕОПРЕДЕЛЕНО
		|				ТОГДА SUI_docs.id_doc = &id_doc
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|	И ВЫБОР
		|			КОГДА &НастройкаДокумента <> НЕОПРЕДЕЛЕНО
		|				ТОГДА SUI_docs.НастройкаДокумента = &НастройкаДокумента
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Отсутствуют выгруженные документы обмена для смены состояния.'"));
		Возврат;
	КонецЕсли;
	
	НачатьТранзакцию();
		
	Попытка

		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.SUI_docs");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Разделяемый;
		ЭлементБлокировки.ИсточникДанных = РезультатЗапроса;
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("sid", "sid");
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("id_doc", "id_doc");
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("НастройкаДокумента", "НастройкаДокумента");
		Блокировка.Заблокировать();
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			НаборЗаписей = РегистрыСведений.SUI_docs.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.sid.Установить(Выборка.sid);
			НаборЗаписей.Отбор.id_doc.Установить(Выборка.id_doc);
			НаборЗаписей.Отбор.НастройкаДокумента.Установить(Выборка.НастройкаДокумента);
			
			НаборЗаписей.Прочитать();
			
			Если НаборЗаписей.Количество() = 1 Тогда
				
				НаборЗаписей[0].Состояние = НовоеСостояние;
			
				Если ОтключитьРегистрациюИзменений Тогда
					НаборЗаписей.ДополнительныеСвойства.Вставить("ОтключитьМеханизмРегистрацииОбъектов");
				КонецЕсли;
				
				// Регистрировать изменения для завершенных документов
				Если НовоеСостояние = Перечисления.SUI_СостоянияДокументовОбмена.Завершен Тогда
					
					НаборЗаписей.ДополнительныеСвойства.Вставить("РегистрироватьИзменения");
					
					Если НаборЗаписей.ДополнительныеСвойства.Свойство("ОтключитьМеханизмРегистрацииОбъектов") Тогда
						НаборЗаписей.ДополнительныеСвойства.Удалить("ОтключитьМеханизмРегистрацииОбъектов");
					КонецЕсли;
					
				КонецЕсли;
				
				Если НеОбновлятьМеткуВремени Тогда
					НаборЗаписей.ДополнительныеСвойства.Вставить("НеОбновлятьМеткуВремени");
				КонецЕсли;

				НаборЗаписей.Записать();
			
			КонецЕсли;
			
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		SUI_ЖурналРегистрации.ЗаписьВЖурналРегистрации(ИмяСобытия(), , 
			Метаданные.ОбщиеМодули.SUI_ДокументыОбмена, Документ, ИнформацияОбОшибке());
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Возникла исключительная ошибка при смене состояния документов обмена
			|%1'"), ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

Процедура УдалитьДокументыОбмена(Знач ДокументыОбмена) Экспорт
	
	Если SUI_ОбщегоНазначения.ЭтоСсылкаДокумента(ДокументыОбмена) Тогда
		ДокументыОбмена = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДокументыОбмена);
	КонецЕсли;
	
	ОписаниеТипаМассив = Новый ОписаниеТипов(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Тип("Массив")));
	ДокументыОбмена = ОписаниеТипаМассив.ПривестиЗначение(ДокументыОбмена);
	
	Идентификаторы = Новый Массив();
	Для Индекс = 0 По ДокументыОбмена.ВГраница() Цикл
		
		Если SUI_ИнтеграцияВКонфигурациюКлиентСервер.ЭтоИдентификаторSimple(ДокументыОбмена[Индекс]) Тогда
			Идентификаторы.Добавить(ДокументыОбмена[Индекс]);
		ИначеЕсли SUI_ОбщегоНазначения.ЭтоСсылкаДокумента(ДокументыОбмена[Индекс]) Тогда
			Идентификаторы.Добавить(SUI_ИнтеграцияВКонфигурацию.ИдентификаторSimpleПоСсылке(ДокументыОбмена[Индекс], Истина));
		КонецЕсли;
		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	SUI_docs.sid КАК sid,
		|	SUI_docs.id_doc КАК id_doc,
		|	SUI_docs.НастройкаДокумента КАК НастройкаДокумента
		|ИЗ
		|	РегистрСведений.SUI_docs КАК SUI_docs
		|ГДЕ
		|	SUI_docs.id_doc В(&id_doc)";
	
	Запрос.УстановитьПараметр("id_doc", Идентификаторы);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	НачатьТранзакцию();
	
	Попытка
		
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.SUI_docs");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Разделяемый;
		ЭлементБлокировки.ИсточникДанных = РезультатЗапроса;
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("sid", "sid");
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("id_doc", "id_doc");
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("НастройкаДокумента", "НастройкаДокумента");
		Блокировка.Заблокировать();
		
		Выборка = РезультатЗапроса.Выбрать();
	
		Пока Выборка.Следующий() Цикл
			
			НаборЗаписей = РегистрыСведений.SUI_docs.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.sid.Установить(Выборка.sid);
			НаборЗаписей.Отбор.id_doc.Установить(Выборка.id_doc);
			НаборЗаписей.Отбор.НастройкаДокумента.Установить(Выборка.НастройкаДокумента);
			
			НаборЗаписей.Записать(Истина);
			
		КонецЦикла;
		
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Данные документов были удалены'"));
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		SUI_ЖурналРегистрации.ЗаписьВЖурналРегистрации(ИмяСобытия(НСтр("ru = 'Удаление'")), , 
			Метаданные.ОбщиеМодули.SUI_ДокументыОбмена, , ИнформацияОбОшибке());
		ВызватьИсключение ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
КонецПроцедуры

Функция ЭтоДокументГрупповогоПересчета(Знач Документ) Экспорт
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	SUI_НастройкиДокументов.ГрупповоеСканирование КАК ГрупповоеСканирование
		|ИЗ
		|	РегистрСведений.SUI_docs КАК SUI_docs
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.SUI_НастройкиДокументов КАК SUI_НастройкиДокументов
		|		ПО SUI_docs.НастройкаДокумента = SUI_НастройкиДокументов.Ссылка
		|ГДЕ
		|	SUI_docs.id_doc = &id_doc";
	
	Если SUI_ИнтеграцияВКонфигурациюКлиентСервер.ЭтоИдентификаторSimple(Документ) Тогда
		Запрос.УстановитьПараметр("id_doc", Документ);
	Иначе
		Запрос.УстановитьПараметр("id_doc", SUI_ИнтеграцияВКонфигурацию.ИдентификаторSimpleПоСсылке(Документ));
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Ложь;
	Иначе
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.ГрупповоеСканирование;
	КонецЕсли;
	
КонецФункции

Функция ДокументНуждаетсяВОбработке(Знач Документ) Экспорт
		
	Запрос = Новый Запрос;

	Запрос.Текст =
	"ВЫБРАТЬ
	|	SUI_ОчередьЗаданий.Идентификатор КАК Идентификатор,
	|	SUI_ОчередьЗаданий.Статус КАК Статус
	|ИЗ
	|	РегистрСведений.SUI_ОчередьЗаданий КАК SUI_ОчередьЗаданий
	|ГДЕ
	|	SUI_ОчередьЗаданий.Статус В(&Статус)
	|	И SUI_ОчередьЗаданий.ИдентификаторДокумента = &id_doc
	|
	|УПОРЯДОЧИТЬ ПО
	|	SUI_ОчередьЗаданий.Обновлено УБЫВ";
	
	Если SUI_ИнтеграцияВКонфигурациюКлиентСервер.ЭтоИдентификаторSimple(Документ) Тогда
		Запрос.УстановитьПараметр("id_doc", Документ);
	Иначе
		Запрос.УстановитьПараметр("id_doc", SUI_ИнтеграцияВКонфигурацию.ИдентификаторSimpleПоСсылке(Документ));
	КонецЕсли;
	
	Статусы = Новый СписокЗначений;
	Статусы.Добавить(Перечисления.SUI_СтатусыОбработкиОчередиЗаданий.Открыто);
	Статусы.Добавить(Перечисления.SUI_СтатусыОбработкиОчередиЗаданий.Выполняется);
	Статусы.Добавить(Перечисления.SUI_СтатусыОбработкиОчередиЗаданий.ОшибкаОбработки);
	
	Запрос.УстановитьПараметр("Статус", Статусы);
	
	РезультатыЗапроса = Запрос.Выполнить().Выбрать();
	
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("ЕстьАктивныеЗадания", Истина);
	СтруктураВозврата.Вставить("ЕстьОшибкаОбработки", Ложь);

	Если РезультатыЗапроса.Следующий() Тогда 			
		СтруктураВозврата.ЕстьОшибкаОбработки = (РезультатыЗапроса.Статус = Перечисления.SUI_СтатусыОбработкиОчередиЗаданий.ОшибкаОбработки);
	Иначе 
		СтруктураВозврата.ЕстьАктивныеЗадания = Ложь;
	КонецЕсли;
	
	Возврат СтруктураВозврата;
	
КонецФункции
    
