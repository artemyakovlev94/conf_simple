Процедура ВыполнитьПроизвольныйАлгоритм_ПередЗаписью(Алгоритм, ДокументОбъект) Экспорт
	
	Если Не ЗначениеЗаполнено(Алгоритм) Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		УстановитьБезопасныйРежим(Истина);
		Выполнить(Алгоритм);
	Исключение
		SUI_ЖурналРегистрации.ЗаписьВЖурналРегистрации(
			ИмяСобытия(НСтр("ru = 'Выполнение алгоритма. Перед записью'")), , 
			Метаданные.ОбщиеМодули.SUI_ДокументыОбмена, 
			ДокументОбъект.Ссылка, 
			ИнформацияОбОшибке());
		ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'При выполнении алгоритма ""Перед записью документа"" возникла исключительная ошибка:
			|%1.
			|Проверьте произвольный алгоритм в настройках документа обмена.'"), 
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

Процедура ВыполнитьУстановкуЗначений(ТаблицаУстановкиРеквизитов, ДокументОбъект, ТаблицыДокументаОбмена) Экспорт
	
	Если Не ЗначениеЗаполнено(ТаблицаУстановкиРеквизитов) Тогда
		Возврат;	
	КонецЕсли;
	
	Попытка

		ЕстьРасхождения = Ложь;
		
		Для Каждого ТаблицаДокументаОбмена Из ТаблицыДокументаОбмена Цикл
			
			Если ТаблицаДокументаОбмена.Значение.Колонки.Найти("qtty_plan") <> Неопределено 
				И ТаблицаДокументаОбмена.Значение.Колонки.Найти("qtty")  <> Неопределено Тогда 
				
				ЕстьРасхождения = Не ОбщегоНазначения.КоллекцииИдентичны(
				ТаблицаДокументаОбмена.Значение.ВыгрузитьКолонку("qtty_plan"), 
				ТаблицаДокументаОбмена.Значение.ВыгрузитьКолонку("qtty"), , , Истина);
				
				Если ЕстьРасхождения Тогда
					Прервать;
				КонецЕсли;
				
			КонецЕсли; 
			
		КонецЦикла;
        
		Для Каждого РеквизитДокументЗначение Из ТаблицаУстановкиРеквизитов Цикл
			
			Если (Не РеквизитДокументЗначение.ПриРасхождении И Не ЕстьРасхождения) Или
				(РеквизитДокументЗначение.ПриРасхождении И ЕстьРасхождения) Тогда
				ДокументОбъект[РеквизитДокументЗначение.Ключ] = РеквизитДокументЗначение.Значение.Получить();
			КонецЕсли;
			
		КонецЦикла; 
		
	Исключение 
		ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'При заполнении реквизитов из настроек возникла исключительная ошибка:
			|%1.
			|Проверьте заполнение реквизитов в настройках документа обмена.'"), 
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

Процедура УдалитьПустыеСтроки(НастройкиТабличныеЧасти, ДокументОбъект, ТаблицыДокументаОбмена) Экспорт
	
	Если Не ЗначениеЗаполнено(НастройкиТабличныеЧасти) Тогда
		Возврат;	
	КонецЕсли;
	
	Попытка
		
		Для Каждого ТаблицаДокументаОбмена Из НастройкиТабличныеЧасти Цикл
			
			Если ТаблицаДокументаОбмена.Значение.УдалятьПустыеСтроки Тогда
				ТаблицаДокумента = ДокументОбъект[ТаблицаДокументаОбмена.Значение.ИмяТабличнойЧасти]; 
				Таблица = ТаблицаДокументаОбмена.Значение.Элементы.Получить("qtty"); 
				Если Таблица <> Неопределено Тогда 
					УдалитьСтроки = ТаблицаДокумента.НайтиСтроки(Новый Структура(Таблица.Имя, 0));
					Для каждого Стр Из УдалитьСтроки Цикл
						ТаблицаДокумента.Удалить(Стр);
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
	Исключение 
		SUI_ЖурналРегистрации.ЗаписьВЖурналРегистрации(ИмяСобытия(НСтр("ru = 'Заполнение реквизитов.'")), , 
		Метаданные.ОбщиеМодули.SUI_ДокументыОбмена, ДокументОбъект.Ссылка, ИнформацияОбОшибке());
		ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'При удалении пустых строк возникла исключительная ошибка:
		|%1.
		|Проверьте настройки документа обмена.'"), 
		ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры 

