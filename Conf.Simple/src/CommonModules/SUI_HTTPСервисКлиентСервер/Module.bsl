
#Область ПрограммныйИнтерфейс

// Параметры обработки входящего запроса.
// 
// Возвращаемое значение:
//  Структура - Параметры обработки входящего запроса:
// * ВосстанавливатьСсылкиИдентификаторов - Булево - 
// * ПроверятьСсылкиПриВосстановлении - Булево - 
// * ПрочитатьПараметрыИзТела - Булево - 
// * ИменаПараметровДатыВТеле - Произвольный -
Функция ПараметрыОбработкиВходящегоЗапроса() Экспорт
	
	ПараметрыОбработки = Новый Структура();
	
	ПараметрыОбработки.Вставить("ВосстанавливатьСсылкиИдентификаторов", Истина);
	ПараметрыОбработки.Вставить("ПроверятьСсылкиПриВосстановлении", Истина);
	ПараметрыОбработки.Вставить("ПрочитатьПараметрыИзТела", Ложь);
	ПараметрыОбработки.Вставить("ИменаПараметровДатыВТеле");
	
	//@skip-check constructor-function-return-section
	Возврат ПараметрыОбработки;
	
КонецФункции

Функция ПолучитьТелоИзHTTPСервисЗапросОтвет(HTTPСервисЗапросОтвет) Экспорт
	
	Тело = HTTPСервисЗапросОтвет.ПолучитьТелоКакДвоичныеДанные();
	
	Если ЗначениеЗаполнено(Тело) И ИспользуетсяСжатие(HTTPСервисЗапросОтвет.Заголовки) Тогда
		
		#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
			Тело = SUI_HTTPСервис.ПрочитатьКакGZip(Тело, Истина);
		#Иначе
			Тело = SUI_HTTPСервисВызовСервера.ПрочитатьКакGZip(Тело, Истина);
		#КонецЕсли
		
	КонецЕсли;
	
	ОписаниеТипаСтрока = Новый ОписаниеТипов("Строка");
	ТипКонтента = ПолучитьЗначениеЗаголовка(HTTPСервисЗапросОтвет.Заголовки, "Content-Type");
	ТипКонтента = ОписаниеТипаСтрока.ПривестиЗначение(ТипКонтента);
	
	Если СтрНайти(ТипКонтента, "application/json") > 0 Тогда
		Возврат ПолучитьСтрокуИзДвоичныхДанных(Тело, КодировкаТекста.UTF8);
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

Функция ПолучитьЗначениеЗаголовка(Заголовки, Знач ИмяЗаголовка, ТипЗначения = Неопределено) Экспорт
	
	ЗначениеЗаголовка = Неопределено;
	
	ИмяЗаголовка = НРег(ИмяЗаголовка);
	
	Для Каждого Заголовок Из Заголовки Цикл
		
		Если ИмяЗаголовка = НРег(Заголовок.Ключ) Тогда
			ЗначениеЗаголовка = Заголовок.Значение;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЗначениеЗаголовка <> Неопределено И ТипЗначения <> Неопределено Тогда
		
		Если ТипЗнч(ТипЗначения) = Тип("ОписаниеТипов") Тогда
			ОписаниеТипаЗначения = ТипЗначения;
		Иначе
			ОписаниеТипаЗначения = Новый ОписаниеТипов(SUI_ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ТипЗначения));
		КонецЕсли;
		
		ЗначениеЗаголовка = ОписаниеТипаЗначения.ПривестиЗначение(ЗначениеЗаголовка);
		
	КонецЕсли;
	
	Возврат ЗначениеЗаголовка;
	
КонецФункции

Функция ИспользуетсяСжатие(Заголовки) Экспорт
	
	ЗначениеЗаголовка = ПолучитьЗначениеЗаголовка(Заголовки, "Content-Encoding", Тип("Строка"));
	
	Если ЗначениеЗаголовка <> Неопределено И СтрНайти(ЗначениеЗаголовка, "gzip") > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	ЗначениеЗаголовка = ПолучитьЗначениеЗаголовка(Заголовки, "Simple-Content-Encoding", Тип("Строка"));
	
	Если ЗначениеЗаголовка <> Неопределено И СтрНайти(ЗначениеЗаголовка, "gzip") > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция ПолучитьИдентификаторУстройства(Заголовки) Экспорт
	
	ОписаниеТипаСтрока = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(30));
	
	ЗначениеЗаголовка = ПолучитьЗначениеЗаголовка(Заголовки, "device-id", ОписаниеТипаСтрока);
	
	Возврат ?(ЗначениеЗаголовка = Неопределено, "", ЗначениеЗаголовка);
	
КонецФункции

Функция ПолучитьВерсиюПриложения(Заголовки) Экспорт
	
	ОписаниеТипаСтрока = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(30));
	
	Версия = ПолучитьЗначениеЗаголовка(Заголовки, "app-version", ОписаниеТипаСтрока);
	
	Если Версия = Неопределено Тогда
		Версия = "";
	КонецЕсли;
	
	Возврат SUI_СтроковыеФункцииКлиентСервер.ОбработатьСтрокуВерсии(Версия);
	
КонецФункции

Функция ПолучитьТипКонтента(Заголовки) Экспорт
	
	ЗначениеЗаголовка = ПолучитьЗначениеЗаголовка(Заголовки, "Content-Type", Тип("Строка"));
	
	Возврат ?(ЗначениеЗаголовка = Неопределено, "", ЗначениеЗаголовка);
	
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Имя события.
// 
// Параметры:
//  ВложенноеСобытие - Строка - Вложенное событие
// 
// Возвращаемое значение:
//  Строка - Имя события
Функция ИмяСобытия(ВложенноеСобытие = "") Экспорт
	Возврат НСтр("ru = 'HTTP сервис'") + ?(ЗначениеЗаполнено(ВложенноеСобытие), ". " + ВложенноеСобытие, "");
КонецФункции

#КонецОбласти
