
#Область ПрограммныйИнтерфейс

Функция ПустойПакет(ФорматПакета, ДанныеПакета = Неопределено) Экспорт
	
	Пакет = Новый Структура();
	
	Пакет.Вставить("format", 				ФорматПакета);
	Пакет.Вставить("data", 					ДанныеПакета);
	Пакет.Вставить("messages", 				Новый Массив());
	
	Возврат Пакет;

КонецФункции

