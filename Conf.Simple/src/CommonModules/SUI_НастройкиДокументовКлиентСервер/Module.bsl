Функция ПолучитьИменаОсновныхРеквизитовТаблиц(РеквизитыДокумента = Истина, ТипТаблицы = Неопределено) Экспорт
	
	ОсновныеРеквизиты = Новый СписокЗначений();
	
	Если РеквизитыДокумента Тогда
		
		ОсновныеРеквизиты.Добавить("НомерДокументаОснования", 	НСтр("ru = 'Номер'"), Истина);
		ОсновныеРеквизиты.Добавить("ДатаДокументаОснования", 	НСтр("ru = 'Дата'"), Истина);
		ОсновныеРеквизиты.Добавить("Контрагент", 				НСтр("ru = 'Контрагент'"));
		ОсновныеРеквизиты.Добавить("Склад", 					НСтр("ru = 'Склад'"));
		ОсновныеРеквизиты.Добавить("ПризнакМаркировки", 		НСтр("ru = 'Признак маркировки'"));
		
	Иначе
		
		Если ТипТаблицы = ПредопределенноеЗначение("Перечисление.SUI_ТипыТаблицДокументовОбмена.Товары") Или
			ТипТаблицы = ПредопределенноеЗначение("Перечисление.SUI_ТипыТаблицДокументовОбмена.Отбор") Или
			ТипТаблицы = ПредопределенноеЗначение("Перечисление.SUI_ТипыТаблицДокументовОбмена.Размещение") Или
			ТипТаблицы = ПредопределенноеЗначение("Перечисление.SUI_ТипыТаблицДокументовОбмена.Серии") Или
			ТипТаблицы = ПредопределенноеЗначение("Перечисление.SUI_ТипыТаблицДокументовОбмена.ШтрихкодыУпаковок") Тогда
			
			// Номенклатура
			ОсновныеРеквизиты.Добавить("Номенклатура", 	НСтр("ru = 'Номенклатура'"), 
				(ТипТаблицы <> ПредопределенноеЗначение("Перечисление.SUI_ТипыТаблицДокументовОбмена.ШтрихкодыУпаковок") И
				ТипТаблицы <> ПредопределенноеЗначение("Перечисление.SUI_ТипыТаблицДокументовОбмена.Серии")));
			
			// Характеристика
			ОсновныеРеквизиты.Добавить("Характеристика", НСтр("ru = 'Характеристика'"));
			
			// Упаковка
			Если ТипТаблицы <> ПредопределенноеЗначение("Перечисление.SUI_ТипыТаблицДокументовОбмена.Серии") Тогда
				ОсновныеРеквизиты.Добавить("Упаковка", НСтр("ru = 'Упаковка'"));
			КонецЕсли;
			
			Если ТипТаблицы = ПредопределенноеЗначение("Перечисление.SUI_ТипыТаблицДокументовОбмена.ШтрихкодыУпаковок") Тогда
				// ШтрихкодУпаковки
				ОсновныеРеквизиты.Добавить("ШтрихкодУпаковки", НСтр("ru = 'Штрихкод упаковки'"), Истина);
				// ЗначениеШтрихкода
				ОсновныеРеквизиты.Добавить("ЗначениеШтрихкода", НСтр("ru = 'Значение штрихкода'"));
			ИначеЕсли ТипТаблицы = ПредопределенноеЗначение("Перечисление.SUI_ТипыТаблицДокументовОбмена.Серии") Тогда
				
				// Серия
				ОсновныеРеквизиты.Добавить("Серия", НСтр("ru = 'Серия'"), Истина);
				// Наименование
				ОсновныеРеквизиты.Добавить("Наименование", НСтр("ru = 'Наименование'"));
				// Номер
				ОсновныеРеквизиты.Добавить("Номер", НСтр("ru = 'Номер'"));
				// Дата производства
				ОсновныеРеквизиты.Добавить("ДатаПроизводства", НСтр("ru = 'Дата производства'"));
				// Годен до
				ОсновныеРеквизиты.Добавить("ГоденДо", НСтр("ru = 'Годен до'"));
				
			КонецЕсли;
			
			Если ТипТаблицы = ПредопределенноеЗначение("Перечисление.SUI_ТипыТаблицДокументовОбмена.Товары") Или
				ТипТаблицы = ПредопределенноеЗначение("Перечисление.SUI_ТипыТаблицДокументовОбмена.Отбор") Или
				ТипТаблицы = ПредопределенноеЗначение("Перечисление.SUI_ТипыТаблицДокументовОбмена.Размещение") Тогда
				
				// СтатусУказанияСерии
				ОсновныеРеквизиты.Добавить("СтатусУказанияСерии", НСтр("ru = 'Статус указания серии'"));
				
				Если ТипТаблицы = ПредопределенноеЗначение("Перечисление.SUI_ТипыТаблицДокументовОбмена.Отбор") Или
					ТипТаблицы = ПредопределенноеЗначение("Перечисление.SUI_ТипыТаблицДокументовОбмена.Размещение") Тогда
					// Ячейка
					ОсновныеРеквизиты.Добавить("Ячейка", НСтр("ru = 'Ячейка'"), Истина);
				Иначе
					// ПризнакМаркировки
					ОсновныеРеквизиты.Добавить("ПризнакМаркировки", НСтр("ru = 'Признак маркировки'"));
					// ВидЦены
					ОсновныеРеквизиты.Добавить("ВидЦены", НСтр("ru = 'Вид цены'"));
					// Цена
					ОсновныеРеквизиты.Добавить("Цена", НСтр("ru = 'Цена'"));
				КонецЕсли;
				
				// КоличествоПлан
				ОсновныеРеквизиты.Добавить("КоличествоПлан", НСтр("ru = 'Количество (план)'"), Истина);
				
			КонецЕсли;
			
			Если ТипТаблицы <> ПредопределенноеЗначение("Перечисление.SUI_ТипыТаблицДокументовОбмена.ШтрихкодыУпаковок") Тогда
				// КоличествоФакт
				ОсновныеРеквизиты.Добавить("КоличествоФакт", НСтр("ru = 'Количество (факт)'"), 
					ТипТаблицы <> ПредопределенноеЗначение("Перечисление.SUI_ТипыТаблицДокументовОбмена.Серии"));
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ОсновныеРеквизиты;
	
КонецФункции

