#Область ОбработчикиПодписокНаСобытия

Процедура SUI_ИнтеграцияВКонфигурациюСправочникиПриЗаписи(Источник, Отказ) Экспорт
	
	Если Отказ Или Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);
	
	// Пользователи ТСД
	Если Источник.Метаданные() = Метаданные.Справочники.SUI_ПользователиТСД Тогда
		РегистрацияИзмененийПользователейТСД(Источник, Не Источник.ПометкаУдаления);
	Иначе
		
		ПараметрыЗаписи = ПараметрыЗаписиВТаблицу(, Источник);
		ПараметрыЗаписи.РегистрацияИзменений = Не Источник.ДополнительныеСвойства.Свойство("ОтключитьМеханизмРегистрацииОбъектов");
		
		ЗаписатьДанныеВТаблицу(ПараметрыЗаписи);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура SUI_ИнтеграцияВКонфигурациюСправочникиПередУдалением(Источник, Отказ) Экспорт
	
	Если Отказ Или Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);

	// Пользователи ТСД
	Если Источник.Метаданные() = Метаданные.Справочники.SUI_ПользователиТСД Тогда
		РегистрацияИзмененийПользователейТСД(Источник, Ложь);
	Иначе
		
		ПараметрыЗаписи = ПараметрыЗаписиВТаблицу(, Источник);
		ПараметрыЗаписи.УдалениеДанных = Истина;
		
		ЗаписатьДанныеВТаблицу(ПараметрыЗаписи);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура SUI_ИнтеграцияВКонфигурациюРегистрыСведенийПередЗаписью(Источник, Отказ, Замещение) Экспорт
	
	Если Отказ Или Источник.ОбменДанными.Загрузка Или Источник.Количество() > 0 Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если SUI_НастройкиМетаданныхСервер.ЭтоТаблицаИнтеграции(Источник.Метаданные().ПолноеИмя()) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыЗаписи = ПараметрыЗаписиВТаблицу(, Источник);
	ПараметрыЗаписи.УдалениеДанных = Истина;
	
	ЗаписатьДанныеВТаблицу(ПараметрыЗаписи);
	
КонецПроцедуры

Процедура SUI_ИнтеграцияВКонфигурациюРегистрыСведенийПриЗаписи(Источник, Отказ, Замещение) Экспорт
	
	Если Отказ Или Источник.ОбменДанными.Загрузка Или
		Источник.ДополнительныеСвойства.Свойство("SUI_ОтключитьПодписку") Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);

	Если SUI_НастройкиМетаданныхСервер.ЭтоТаблицаИнтеграции(Источник.Метаданные().ПолноеИмя()) Тогда
		РегистрацияИзмененийЗаписейТаблиц(Источник, (Источник.Количество() > 0));
	Иначе
		
		Если Источник.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		
		ПараметрыЗаписи = ПараметрыЗаписиВТаблицу(, Источник);
		
		Если Источник.ДополнительныеСвойства.Свойство("ОтключитьМеханизмРегистрацииОбъектов") Тогда
			ПараметрыЗаписи.РегистрацияИзменений = Ложь;
		Иначе
			ПараметрыЗаписи.РегистрацияИзменений = Истина;
		КонецЕсли;
		
		ЗаписатьДанныеВТаблицу(ПараметрыЗаписи);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура SUI_КонстантыИспользоватьТаблицуПриЗаписи(Источник, Отказ) Экспорт

	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если Не Источник.ДополнительныеСвойства.Свойство("SUI_НеОчищатьТаблицу") Тогда
		
		ЭтаКонстанта = Константы[Метаданные.НайтиПоТипу(ТипЗнч(Источник)).Имя];
		
		ТаблицаИнтеграции = SUI_НастройкиМетаданныхСервер.ПолучитьТаблицуИнтеграцииПоКонстанте(ЭтаКонстанта);
		
		Если ТаблицаИнтеграции <> Неопределено Тогда
			ОчиститьТаблицы(Новый Структура("СписокТаблиц", ТаблицаИнтеграции));
		КонецЕсли;

	КонецЕсли;

КонецПроцедуры

