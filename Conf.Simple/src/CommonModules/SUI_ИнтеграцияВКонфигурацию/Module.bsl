
#Область ПрограммныйИнтерфейс

// Записать в таблицы.
// 
// Параметры:
//  Параметры - Структура - Параметры:
// * СписокТаблиц - СписокЗначений, Массив, ФиксированныйМассив, ПеречислениеСсылка.SUI_ТаблицыИнтеграции, Произвольный - Список таблиц интеграции
//  АдресРезультата - Неопределено - Адрес результата
//@skip-check doc-comment-collection-item-type
Процедура ЗаписатьВТаблицы(Параметры, АдресРезультата = Неопределено) Экспорт
	
	ТаблицыИнтеграции = Новый СписокЗначений();
	
	ТипЗначенияСписокТаблиц = ТипЗнч(Параметры.СписокТаблиц);
	
	Если ТипЗначенияСписокТаблиц = Тип("СписокЗначений") Тогда

		Если Параметры.Свойство("ТолькоОтмеченные") И Параметры.ТолькоОтмеченные Тогда
				
			Для Каждого ТаблицаИнтеграции Из Параметры.СписокТаблиц Цикл
				Если ТаблицаИнтеграции.Пометка Тогда
					ТаблицыИнтеграции.Добавить(ТаблицаИнтеграции.Значение);
				КонецЕсли;	
			КонецЦикла;
		
		Иначе
			ТаблицыИнтеграции = Параметры.СписокТаблиц;
		КонецЕсли;

	ИначеЕсли ТипЗначенияСписокТаблиц = Тип("Массив") Или ТипЗначенияСписокТаблиц = Тип("ФиксированныйМассив") Тогда
		ТаблицыИнтеграции.ЗагрузитьЗначения(Параметры.СписокТаблиц);
	ИначеЕсли ТипЗначенияСписокТаблиц = Тип("ПеречислениеСсылка.SUI_ТаблицыИнтеграции") Тогда
		ТаблицыИнтеграции.Добавить(Параметры.СписокТаблиц);
	КонецЕсли;
	
	// Пользователи ТСД
	НайденаяТаблицаПользователейТСД = ТаблицыИнтеграции.НайтиПоЗначению(Перечисления.SUI_ТаблицыИнтеграции.ПользователиТСД);
	Если НайденаяТаблицаПользователейТСД <> Неопределено Тогда
		РегистрацияИзмененийПользователейТСД();
		ТаблицыИнтеграции.Удалить(НайденаяТаблицаПользователейТСД);
	КонецЕсли;
	
	Если ТаблицыИнтеграции.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если Параметры.Свойство("ОчиститьТаблицу") И Параметры.ОчиститьТаблицу Тогда
		ОчиститьТаблицы(Параметры);
	КонецЕсли;
	
	ПараметрыЗаписи = ПараметрыЗаписиВТаблицу();

	Попытка
		
		Для Каждого ТаблицаИнтеграции Из ТаблицыИнтеграции Цикл
			
			ПараметрыЗаписи.ТаблицаИнтеграции = ТаблицаИнтеграции.Значение;
			
			ДлительныеОперации.СообщитьПрогресс(, СтрШаблон(НСтр("ru = 'Запись в таблицу ""%1""'"), ПараметрыЗаписи.ТаблицаИнтеграции));
			
			ЗаписатьДанныеВТаблицу(ПараметрыЗаписи);
			
		КонецЦикла;

	Исключение
		SUI_ЖурналРегистрации.ЗаписьВЖурналРегистрации(НСтр("ru = 'Запись в таблицы'"), , 
			Метаданные.ОбщиеМодули.SUI_ИнтеграцияВКонфигурацию, , ИнформацияОбОшибке());
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

// Очистить таблицы.
// 
// Параметры:
//  Параметры - Структура - Параметры:
// * СписокТаблиц - СписокЗначений, Массив, ФиксированныйМассив, ПеречислениеСсылка.SUI_ТаблицыИнтеграции, Произвольный - Список таблиц интеграции
//  АдресРезультата - Неопределено - Адрес результата
//@skip-check doc-comment-collection-item-type
Процедура ОчиститьТаблицы(Параметры, АдресРезультата = Неопределено) Экспорт

	ТаблицыИнтеграции = Новый СписокЗначений();
	
	ТипЗначенияСписокТаблиц = ТипЗнч(Параметры.СписокТаблиц);
	
	Если ТипЗначенияСписокТаблиц = Тип("СписокЗначений") Тогда
		
		Если Параметры.Свойство("ТолькоОтмеченные") И Параметры.ТолькоОтмеченные Тогда
				
			Для Каждого ТаблицаИнтеграции Из Параметры.СписокТаблиц Цикл
				Если ТаблицаИнтеграции.Пометка Тогда
					ТаблицыИнтеграции.Добавить(ТаблицаИнтеграции.Значение);
				КонецЕсли;	
			КонецЦикла;
		
		Иначе
			ТаблицыИнтеграции = Параметры.СписокТаблиц;
		КонецЕсли;

	ИначеЕсли ТипЗначенияСписокТаблиц = Тип("Массив") Или ТипЗначенияСписокТаблиц = Тип("ФиксированныйМассив") Тогда
		ТаблицыИнтеграции.ЗагрузитьЗначения(Параметры.СписокТаблиц);
	ИначеЕсли ТипЗначенияСписокТаблиц = Тип("ПеречислениеСсылка.SUI_ТаблицыИнтеграции") Тогда
		ТаблицыИнтеграции.Добавить(Параметры.СписокТаблиц);
	КонецЕсли;

	// Пользователи ТСД
	НайденаяТаблицаПользователейТСД = ТаблицыИнтеграции.НайтиПоЗначению(Перечисления.SUI_ТаблицыИнтеграции.ПользователиТСД);
	Если НайденаяТаблицаПользователейТСД <> Неопределено Тогда
		РегистрацияИзмененийПользователейТСД(, Ложь);
		ТаблицыИнтеграции.Удалить(НайденаяТаблицаПользователейТСД);
	КонецЕсли;
	
	Если ТаблицыИнтеграции.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	МобильныеУстройства = SUI_МобильныеУстройстваСервер.ВсеМобильныеУстройства(Истина, Ложь);
	
	Попытка
		
		Для Каждого ТаблицаИнтеграции Из ТаблицыИнтеграции Цикл
			
			ИмяТаблицыВКонфигурации = SUI_НастройкиМетаданныхСервер.ПолучитьИмяТаблицыВКонфигурации(ТаблицаИнтеграции.Значение);
			
			Если Не ЗначениеЗаполнено(ИмяТаблицыВКонфигурации) Тогда
				Продолжить;
			КонецЕсли;
			
			ДлительныеОперации.СообщитьПрогресс(, СтрШаблон(НСтр("ru = 'Очистка таблицы ""%1""'"), ТаблицаИнтеграции.Значение));

			МетаданныеТаблицыКонфигурации = Метаданные.НайтиПоПолномуИмени(ИмяТаблицыВКонфигурации);
			
			Если Метаданные.ПланыОбмена.SUI_МобильныеУстройства.Состав.Содержит(МетаданныеТаблицыКонфигурации) И
				МобильныеУстройства.Количество() > 0 Тогда

				Для Каждого МобильноеУстройство Из МобильныеУстройства Цикл
					ПланыОбмена.УдалитьРегистрациюИзменений(МобильноеУстройство, МетаданныеТаблицыКонфигурации);
				КонецЦикла;
				
			КонецЕсли;
			
			МенеджерОбъектаТаблицы = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(МетаданныеТаблицыКонфигурации.ПолноеИмя());
			
			НаборЗаписей = МенеджерОбъектаТаблицы.СоздатьНаборЗаписей();
			НаборЗаписей.ДополнительныеСвойства.Вставить("SUI_ОтключитьПодписку");
			НаборЗаписей.Записать(Истина);

		КонецЦикла;
	
	Исключение
		SUI_ЖурналРегистрации.ЗаписьВЖурналРегистрации(НСтр("ru = 'Очистка таблиц'"), , 
			Метаданные.ОбщиеМодули.SUI_ИнтеграцияВКонфигурацию, , ИнформацияОбОшибке());
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Проверить БСП.
// 
// Возвращаемое значение:
//  Булево - Проверить БСП
Функция ПроверитьБСП() Экспорт
	
	Если Метаданные.ОбщиеМодули.Найти("СтандартныеПодсистемыСервер") = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ПоддерживаемыеВерсии = Новый Массив();
	ПоддерживаемыеВерсии.Добавить("3.0");
	ПоддерживаемыеВерсии.Добавить("3.1");
	
	ВерсияБСП = СтандартныеПодсистемыСервер.ВерсияБиблиотеки();
	
	РазрядыВерсииБСП = СтрРазделить(ВерсияБСП, ".", Ложь);
	
	Если РазрядыВерсииБСП.Количество() < 2 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ЧастьВерсииКПроверке = РазрядыВерсииБСП[0] + "." + РазрядыВерсииБСП[1];
	
	Возврат (ПоддерживаемыеВерсии.Найти(ЧастьВерсииКПроверке) <> Неопределено);
	
КонецФункции

Функция НайтиВТаблицеПоЗначению(Таблица, ИмяКолонки, Значение) Экспорт
	
	Перем Результат, ТекстСообщения;
	
	Если SUI_НастройкиМетаданныхСервер.ТаблицаИспользуется(Таблица) Тогда
		
		ИмяТаблицыВКонфигурации = SUI_НастройкиМетаданныхСервер.ПолучитьИмяТаблицыВКонфигурации(Таблица);
		
		Если ЗначениеЗаполнено(ИмяТаблицыВКонфигурации) Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст =
				"ВЫБРАТЬ
				|	*
				|ИЗ
				|	" + ИмяТаблицыВКонфигурации + " КАК Таблица
				|ГДЕ
				|	Таблица." + ИмяКолонки + " = &" + ИмяКолонки;
			
			Запрос.УстановитьПараметр(ИмяКолонки, Значение);
			
			Результат = Запрос.Выполнить();
		
		Иначе
			ТекстСообщения = СтрШаблон(НСтр("ru = 'Для таблицы ""%1"" не определена таблица конфигурации'"), Таблица);
		КонецЕсли;
		
	Иначе
		ТекстСообщения = СтрШаблон(НСтр("ru = 'Таблица ""%1"" не используется'"), Таблица);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекстСообщения) Тогда
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#Область ИдентификаторыSimple

// Получить идентификатор Simple по ссылке.
// 
// Параметры:
//  Ссылка - ЛюбаяСсылка - Ссылка объекта для получения идентификатора Simple
//  ОтключитьПроверку - Булево - Отключить проверку на тип ссылки и пустую ссылку.
// 
// Возвращаемое значение:
//  Неопределено, Строка - Идентификатор Simple по ссылке или Неопределено, если переменная Ссылка не является ссылкой объекта 
//	или не существует.
Функция ИдентификаторSimpleПоСсылке(Ссылка, ОтключитьПроверку = Ложь) Экспорт
	
	Идентификатор = "";
	
	Если Не ОтключитьПроверку Тогда
		
		Если Не SUI_ОбщегоНазначенияПереопределяемый.ЭтоСсылка(ТипЗнч(Ссылка)) Или 
			Не ОбщегоНазначения.СсылкаСуществует(Ссылка) Тогда
			Возврат Идентификатор;
		КонецЕсли;
		
	КонецЕсли;
	
	Идентификатор = ЗначениеВСтрокуВнутр(Ссылка);
	
	Если СтрНачинаетсяС(Идентификатор, "{""#"",") И Прав(Идентификатор, 1) = "}" Тогда
		
		Идентификатор = Сред(Идентификатор, 6);  
		Идентификатор = Сред(Идентификатор, 1, СтрНайти(Идентификатор, ",") - 1) + "-" + Сред(Идентификатор, СтрНайти(Идентификатор, ":") + 1);
		Идентификатор = Лев(Идентификатор, СтрДлина(Идентификатор) - 1);
		
		Если СтрДлина(Идентификатор) <> 69 Тогда
			Идентификатор = "";	
		КонецЕсли;
	
	Иначе
		Идентификатор = "";
	КонецЕсли;
	
	Возврат Идентификатор;
	
КонецФункции

// Получить ссылку объекта по идентификатору Simple.
// 
// Параметры:
//  Идентификатор - Строка - Идентификатор Simple
//  ОтключитьПроверку - Булево - Отключить проверку на тип ссылки и пустую ссылку.
// 
// Возвращаемое значение:
//  Неопределено, ЛюбаяСсылка - Ссылка объекта полученная по идентификатору Simple или Неопределено, если идентификатор
//	не является идентификатором Simple или полученный объект по идентификатору не является ссылочным типом или не существует.
Функция СсылкаПоИдентификаторуSimple(Знач Идентификатор, ОтключитьПроверку = Ложь) Экспорт
	
	Перем Ссылка;
	
	Если SUI_ИнтеграцияВКонфигурациюКлиентСервер.ЭтоИдентификаторSimple(Идентификатор) Тогда
		
		Идентификатор = НРег(Идентификатор);
		
		Попытка
			Ссылка = ЗначениеИзСтрокиВнутр("{""#""," + Лев(Идентификатор, 36) + ",1:" + Прав(Идентификатор, 32) + "}");
		Исключение
			Ссылка = Неопределено;
		КонецПопытки;
		
		Если Не ОтключитьПроверку Тогда
			
			Если Не SUI_ОбщегоНазначенияПереопределяемый.ЭтоСсылка(ТипЗнч(Ссылка)) Или 
				Не ОбщегоНазначения.СсылкаСуществует(Ссылка) Тогда
				Ссылка = Неопределено;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Ссылка;
	
КонецФункции

// Привести ссылки к идентификаторам simple.
// 
// Параметры:
//  Данные - ЛюбаяСсылка, Структура, Соответствие, СписокЗначений, Массив из Структура - Данные
//  ИсключитьСвойства - Строка - Исключить свойства структуры или соответствия
//	ИсключитьПустыеИдентификаторы - Булево - Пустой идентификатор Simple как пустая строка
// 
// Возвращаемое значение:
//  Строка, Структура, Соответствие, СписокЗначений, Массив из Структура - Данные
//@skip-check doc-comment-collection-item-type
Функция ПривестиСсылкиКИдентификаторамSimple(Данные, ИсключитьСвойства = "", ИсключитьПустыеИдентификаторы = Истина) Экспорт 
	
	ТипДанных = ТипЗнч(Данные);
	ТипДанныхСтрокой = Строка(ТипДанных); // RS. Кучик
	
	Если ТипДанных = Тип("Массив") Тогда
		
		Для Индекс = 0 По Данные.ВГраница() Цикл
			ПривестиСсылкиКИдентификаторамSimple(Данные[Индекс], ИсключитьСвойства, ИсключитьПустыеИдентификаторы);
		КонецЦикла;
		
	ИначеЕсли ТипДанных = Тип("СписокЗначений") Тогда
		Данные.ЗагрузитьЗначения(ПривестиСсылкиКИдентификаторамSimple(
			Данные.ВыгрузитьЗначения(), ИсключитьСвойства, ИсключитьПустыеИдентификаторы));	
	ИначеЕсли ТипДанных = Тип("Структура") Или ТипДанных = Тип("Соответствие") Тогда
		
		ИсключаемыеСвойства = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ИсключитьСвойства, ",", , Истина);
		
		Для Каждого КлючЗначение Из Данные Цикл
			
			Если ИсключаемыеСвойства.Найти(КлючЗначение.Ключ) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Значение = КлючЗначение.Значение;
			Данные.Вставить(КлючЗначение.Ключ, ПривестиСсылкиКИдентификаторамSimple(
				Значение, ИсключитьСвойства, ИсключитьПустыеИдентификаторы));
			
		КонецЦикла;
		
	ИначеЕсли ОбщегоНазначения.ЭтоСсылка(ТипДанных) Тогда
		
		Если ОбщегоНазначения.СсылкаСуществует(Данные) Или Не ИсключитьПустыеИдентификаторы Тогда
			Данные = ИдентификаторSimpleПоСсылке(Данные, Истина);
		Иначе
			Данные = "";
		КонецЕсли;
		
	// RS. Кучик
	ИначеЕсли ТипДанныхСтрокой = "Ячейка (Simple)" Тогда
		
		Если ОбщегоНазначения.СсылкаСуществует(Данные) Или Не ИсключитьПустыеИдентификаторы Тогда
			Данные = ИдентификаторSimpleПоСсылке(Данные, Истина);
		Иначе
			Данные = "";
		КонецЕсли;
		
	//~RS
	КонецЕсли;
	
	//@skip-check constructor-function-return-section
	Возврат Данные;
	
КонецФункции

// Восстановить ссылки идентификаторов simple.
// 
// Параметры:
//  Данные - Строка, Структура, Соответствие, СписокЗначений, Массив из Структура - Данные
//  ИсключитьСвойства - Строка - Исключить свойства
//  ПроверятьНаСсылку - Булево - Проверять на ссылочный тип и существование ссылки после восстановления
//	ЗначенияТолькоИдентификаторов - Булево - Оставить в структуре значения только идентификаторов
// 
// Возвращаемое значение:
//  Строка, Структура, Соответствие, СписокЗначений, Массив из Структура - Данные
//@skip-check doc-comment-collection-item-type
Функция ВосстановитьСсылкиИдентификаторовSimple(Данные, ИсключитьСвойства = "", ПроверятьНаСсылку = Истина,
	ЗначенияТолькоИдентификаторов = Ложь) Экспорт 
	
	ТипДанных = ТипЗнч(Данные);
	
	Если ТипДанных = Тип("Массив") Тогда
		
		Для Индекс = 0 По Данные.ВГраница() Цикл
			ВосстановитьСсылкиИдентификаторовSimple(Данные[Индекс], ИсключитьСвойства, ПроверятьНаСсылку, ЗначенияТолькоИдентификаторов);
		КонецЦикла;
		
	ИначеЕсли ТипДанных = Тип("СписокЗначений") Тогда
		Данные.ЗагрузитьЗначения(ВосстановитьСсылкиИдентификаторовSimple(
			Данные.ВыгрузитьЗначения(), ИсключитьСвойства, ПроверятьНаСсылку, ЗначенияТолькоИдентификаторов));
	ИначеЕсли ТипДанных = Тип("Структура") Или ТипДанных = Тип("Соответствие") Тогда
		
		ИсключаемыеСвойства = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ИсключитьСвойства, ",", , Истина);
		
		Для Каждого КлючЗначение Из Данные Цикл
			
			Если ИсключаемыеСвойства.Найти(КлючЗначение.Ключ) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
		
			Значение = КлючЗначение.Значение;
			Данные.Вставить(КлючЗначение.Ключ, ВосстановитьСсылкиИдентификаторовSimple(
				Значение, ИсключитьСвойства, ПроверятьНаСсылку, ЗначенияТолькоИдентификаторов));
		
		КонецЦикла;
		
	ИначеЕсли ТипДанных = Тип("Строка") И SUI_ИнтеграцияВКонфигурациюКлиентСервер.ЭтоИдентификаторSimple(Данные) Тогда
		Данные = СсылкаПоИдентификаторуSimple(Данные, Не ПроверятьНаСсылку);
	КонецЕсли;
	
	//@skip-check constructor-function-return-section
	Возврат Данные;
	
КонецФункции

// Установить действие открытия идентификаторов.
// 
// Параметры:
//  Форма - Форма - Форма
//  ПрефиксЭлемента - Строка - Префикс элемента
//  Действие - Строка - Действие
Процедура УстановитьДействиеОткрытияИдентификаторов(Форма, ПрефиксЭлемента = "", Действие = "") Экспорт 
	
	Если ПустаяСтрока(Действие) Тогда
		Действие = "SUI_Переопределяемый_ОткрытиеИдентификатора";
	КонецЕсли;
	
	Для Каждого ЭлементФормы Из Форма.Элементы Цикл
		
		Если ТипЗнч(ЭлементФормы) <> Тип("ПолеФормы") Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЭлементФормы.Вид <> ВидПоляФормы.ПолеВвода Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЭлементФормы.КнопкаОткрытия <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если ПустаяСтрока(ЭлементФормы.ПутьКДанным) Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ПустаяСтрока(ПрефиксЭлемента) Тогда
			
			Если Не СтрНачинаетсяС(ЭлементФормы.Имя, ПрефиксЭлемента) Тогда
				Продолжить;
			КонецЕсли;
			
		КонецЕсли;
		
		мсвПутьКДанным = СтрРазделить(ЭлементФормы.ПутьКДанным, ".", Ложь);
		
		ДанныеЭлемента = Неопределено;
		Для Индекс = 0 По мсвПутьКДанным.ВГраница() Цикл
			
			Если Индекс = 0 Тогда
				ДанныеЭлемента = Форма[мсвПутьКДанным[Индекс]];
			Иначе 
				ДанныеЭлемента = ДанныеЭлемента[мсвПутьКДанным[Индекс]];
			КонецЕсли;
			
		КонецЦикла;

		Если ТипЗнч(ДанныеЭлемента) <> Тип("Строка") Тогда
			Продолжить;
		КонецЕсли;
		
		ЭлементФормы.КнопкаОткрытия = Истина;
		ЭлементФормы.УстановитьДействие("Открытие", Действие);
		
	КонецЦикла;
	
КонецПроцедуры

