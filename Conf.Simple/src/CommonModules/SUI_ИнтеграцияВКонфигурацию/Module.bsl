#Область СлужебныеПроцедурыИФункции

Процедура РегистрацияИзмененийЗаписейТаблиц(Источник, ЗарегистрироватьИзменения = Истина)
	
	Если ЗарегистрироватьИзменения И Источник.ДополнительныеСвойства.Свойство("SUI_НеРегистрироватьИзменения") Тогда
		Возврат;
	КонецЕсли;
	
	Если SUI_МобильныеУстройстваПовтИсп.СоставПланаОбмена().Найти(Источник.Метаданные()) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВсеМобильныеУстройства = SUI_МобильныеУстройстваСервер.ВсеМобильныеУстройства();
	
	Если ВсеМобильныеУстройства.Количество() > 0 Тогда
		
		ОтборУстановлен = Ложь;
			
		Для Каждого ЭлементОтбора Из Источник.Отбор Цикл
			Если ЗначениеЗаполнено(ЭлементОтбора.Значение) Тогда
				ОтборУстановлен = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
			
		Если ЗарегистрироватьИзменения И ОтборУстановлен Тогда 
			ПланыОбмена.ЗарегистрироватьИзменения(ВсеМобильныеУстройства, Источник);
		ИначеЕсли ОтборУстановлен Тогда
			ПланыОбмена.УдалитьРегистрациюИзменений(ВсеМобильныеУстройства, Источник);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура РегистрацияИзмененийПользователейТСД(ПользовательТСДОбъект = Неопределено, Зарегистрировать = Истина)
	
	Если ПользовательТСДОбъект = Неопределено Тогда
		
		Для Каждого МобильноеУстройство Из SUI_МобильныеУстройстваСервер.ВсеМобильныеУстройства(Истина, Ложь) Цикл
			ПланыОбмена.УдалитьРегистрациюИзменений(МобильноеУстройство, Метаданные.Справочники.SUI_ПользователиТСД);
		КонецЦикла;
		
		Если Зарегистрировать Тогда
			Для Каждого МобильноеУстройство Из SUI_МобильныеУстройстваСервер.ВсеМобильныеУстройства() Цикл
				ПланыОбмена.ЗарегистрироватьИзменения(МобильноеУстройство, Метаданные.Справочники.SUI_ПользователиТСД);
			КонецЦикла;
		КонецЕсли;
		
	Иначе

		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	SUI_ПользователиТСДИзменения.Узел КАК Ссылка
			|ИЗ
			|	Справочник.SUI_ПользователиТСД.Изменения КАК SUI_ПользователиТСДИзменения
			|ГДЕ
			|	НЕ &ЗарегистрироватьИзменения
			|	И SUI_ПользователиТСДИзменения.Ссылка = &Ссылка
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	SUI_МобильныеУстройства.Ссылка
			|ИЗ
			|	ПланОбмена.SUI_МобильныеУстройства КАК SUI_МобильныеУстройства
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.SUI_ПользователиТСД.Изменения КАК SUI_ПользователиТСДИзменения
			|		ПО SUI_ПользователиТСДИзменения.Узел = SUI_МобильныеУстройства.Ссылка
			|		И SUI_ПользователиТСДИзменения.Ссылка = &Ссылка
			|ГДЕ
			|	&ЗарегистрироватьИзменения
			|	И SUI_ПользователиТСДИзменения.Ссылка ЕСТЬ NULL
			|	И НЕ SUI_МобильныеУстройства.ЭтотУзел
			|	И НЕ SUI_МобильныеУстройства.ПометкаУдаления";
		
		Запрос.УстановитьПараметр("ЗарегистрироватьИзменения", Зарегистрировать);
		Запрос.УстановитьПараметр("Ссылка", ПользовательТСДОбъект.Ссылка);
		
		РезультатыЗапроса = Запрос.ВыполнитьПакет();
		
		Если Не РезультатыЗапроса[0].Пустой() Тогда
			ПланыОбмена.УдалитьРегистрациюИзменений(
				РезультатыЗапроса[0].Выгрузить().ВыгрузитьКолонку("Ссылка"), ПользовательТСДОбъект);
		КонецЕсли;
		
		Если Не РезультатыЗапроса[1].Пустой() Тогда
			ПланыОбмена.ЗарегистрироватьИзменения(
				РезультатыЗапроса[1].Выгрузить().ВыгрузитьКолонку("Ссылка"), ПользовательТСДОбъект);
		КонецЕсли;

	КонецЕсли;
		
КонецПроцедуры

