Функция СформироватьИдентификатор(Значение1, Значение2 = Неопределено, Значение3 = Неопределено, Значение4 = Неопределено,
	Значение5 = Неопределено, Значение6 = Неопределено, Значение7 = Неопределено, Значение8 = Неопределено, Значение9 = Неопределено) Экспорт
	
	ПереданныеЗначения = Новый Массив;
	ПереданныеЗначения.Добавить(Значение9);
	ПереданныеЗначения.Добавить(Значение8);
	ПереданныеЗначения.Добавить(Значение7);
	ПереданныеЗначения.Добавить(Значение6);
	ПереданныеЗначения.Добавить(Значение5);
	ПереданныеЗначения.Добавить(Значение4);
	ПереданныеЗначения.Добавить(Значение3);
	ПереданныеЗначения.Добавить(Значение2);
	ПереданныеЗначения.Добавить(Значение1);
	
	МассивЗначений = Новый Массив;
	
	Для индекс = 0 По ПереданныеЗначения.ВГраница() Цикл
		Если МассивЗначений.Количество() = 0 И ПереданныеЗначения[индекс] = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		МассивЗначений.Вставить(0, ПереданныеЗначения[индекс]);
	КонецЦикла;
	
	Если МассивЗначений.Количество() = 0 Тогда
		ВызватьИсключение НСтр("ru = 'Недопустимая операция'");
	ИначеЕсли МассивЗначений.Количество() = 1 И 
		SUI_ОбщегоНазначенияПереопределяемый.ЭтоСсылка(ТипЗнч(МассивЗначений[0])) Тогда
		Возврат ИдентификаторSimpleПоСсылке(МассивЗначений[0], Истина);
	Иначе
		Возврат НРег(ОбщегоНазначения.КонтрольнаяСуммаСтрокой(МассивЗначений, ХешФункция.SHA256));
	КонецЕсли;

КонецФункции

Функция МенеджерНастроекТаблиц()
	Возврат РегистрыСведений.SUI_НастройкиТаблицИнтеграции;
КонецФункции

Функция ИмяТаблицыИсточникаДанных(ИсточникДанных)
	
	Если ИсточникДанных = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ИсточникДанных.Метаданные().ПолноеИмя();
	
КонецФункции

Функция ПараметрыЗаписиВТаблицу(ТаблицаИнтеграции = Неопределено, ИсточникДанных = Неопределено)
	
	ПараметрыЗаписи = Новый Структура();
	
	ПараметрыЗаписи.Вставить("ТаблицаИнтеграции", 		ТаблицаИнтеграции);
	ПараметрыЗаписи.Вставить("ИсточникДанных", 			ИсточникДанных);
	ПараметрыЗаписи.Вставить("РегистрацияИзменений", 	Ложь);
	ПараметрыЗаписи.Вставить("УдалениеДанных", 			Ложь);
	ПараметрыЗаписи.Вставить("ПерезаписатьТаблицу", 	Ложь);
	
	Возврат ПараметрыЗаписи;
	
КонецФункции

Процедура ЗаписатьДанныеВТаблицу(ПараметрыЗаписи)
	
	Если ПараметрыЗаписи.ТаблицаИнтеграции = Неопределено И ПараметрыЗаписи.ИсточникДанных = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	ИмяТаблицыИсточника = ИмяТаблицыИсточникаДанных(ПараметрыЗаписи.ИсточникДанных);

	ПараметрыНастроек = МенеджерНастроекТаблиц().ПараметрыПолученияНастроек(ПараметрыЗаписи.ТаблицаИнтеграции, ИмяТаблицыИсточника);
	
	Настройки = МенеджерНастроекТаблиц().ПолучитьНастройки(ПараметрыНастроек);
	
	Если Настройки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаНастройки Из Настройки Цикл
		ЗаписатьДанныеВТаблицуПоНастройке(ПараметрыЗаписи, СтрокаНастройки);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаписатьДанныеВТаблицуПоНастройке(Знач ПараметрыЗаписи, СтрокаНастройки)

	Если ПараметрыЗаписи.ПерезаписатьТаблицу Тогда
		ОчиститьТаблицуИнтеграции(СтрокаНастройки.ТаблицаИнтеграции);
	КонецЕсли;
	
	ПараметрыВыгрузки = МенеджерНастроекТаблиц().ПараметрыВыгрузкиРезультата(СтрокаНастройки.СхемаКомпоновкиДанных, 
		СтрокаНастройки.НастройкиКомпоновкиДанных, ПараметрыЗаписи.ИсточникДанных);
	//@skip-check wrong-type-expression
	ПараметрыВыгрузки.СлужебныеПоля = МенеджерНастроекТаблиц().ПараметрыСКДПоОбъектуКонфигурации(СтрокаНастройки.ИмяОбъекта);
	
	ТаблицаРезультат = МенеджерНастроекТаблиц().ВыгрузитьРезультатПоНастройке(ПараметрыВыгрузки);
	
	Если ТаблицаРезультат.Количество() = 0 Тогда
		
		ТаблицаРезультат = ДанныеКУдалениюВТаблицеПоИсточнику(ПараметрыЗаписи, ПараметрыВыгрузки);
		
		Если ТаблицаРезультат <> Неопределено И ТаблицаРезультат.Количество() > 0 Тогда
			ПараметрыЗаписи.УдалениеДанных = Истина;
		Иначе
			Возврат;
		КонецЕсли;
		
	КонецЕсли;

	КолонкиТаблицы = Новый Массив();
	СлужебныеКолонкиТаблицы = Новый Массив();
	Для Каждого Колонка Из ТаблицаРезультат.Колонки Цикл
		Если СтрНачинаетсяС(Колонка.Имя, ПараметрыВыгрузки.ПрефиксСлужебногоПоля) Тогда
			СлужебныеКолонкиТаблицы.Добавить(Колонка.Имя);
		Иначе
			КолонкиТаблицы.Добавить(Колонка.Имя);
		КонецЕсли;
	КонецЦикла;
	КолонкиТаблицы = СтрСоединить(КолонкиТаблицы, ",");
	
	Если ПустаяСтрока(КолонкиТаблицы) Тогда
		//TODO: ВызватьИсключение;
		Возврат;
	КонецЕсли;
	
	МенеджерТаблицы = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(СтрокаНастройки.ИмяТаблицы);
	
	КлючиАвтоГенерацииID = Неопределено;
	
	Для Каждого СтрокаТаблицыРезультат Из ТаблицаРезультат Цикл
		
		СтруктураРезультат = Новый Структура(КолонкиТаблицы);
		ЗаполнитьЗначенияСвойств(СтруктураРезультат, СтрокаТаблицыРезультат);
		ПривестиСсылкиКИдентификаторамSimple(СтруктураРезультат);
		
		// Автогенерация идентификатора "id" записи
		Если СтруктураРезультат.Свойство("id") И 
			Не SUI_ИнтеграцияВКонфигурациюКлиентСервер.ЭтоИдентификаторSimple(СтруктураРезультат.id) Тогда
			
			Если КлючиАвтоГенерацииID = Неопределено Тогда
				КлючиАвтоГенерацииID = КлючиАвтоГенерацииИдентификатора(СтруктураРезультат.id, СлужебныеКолонкиТаблицы, 
					ПараметрыВыгрузки.ПрефиксСлужебногоПоля);
			КонецЕсли;
			
			Если КлючиАвтоГенерацииID <> Неопределено И Не ПустаяСтрока(КлючиАвтоГенерацииID) Тогда
				
				РеквизитыГенерацииИдентификатора = Новый Структура(КлючиАвтоГенерацииID);
				ЗаполнитьЗначенияСвойств(РеквизитыГенерацииИдентификатора, СтрокаТаблицыРезультат);
				
				СтруктураРезультат.id = СформироватьИдентификаторПоСлужебнымРеквизитам(РеквизитыГенерацииИдентификатора);
			
			Иначе
				СтруктураРезультат.id = "";
			КонецЕсли;

		КонецЕсли;
		
		Если Не ПараметрыЗаписи.УдалениеДанных Тогда
			
			// Если таблица интеграции ШаблоныЭтикеток, то переопределить шаблон "layout"
			Если СтрокаНастройки.ТаблицаИнтеграции = Перечисления.SUI_ТаблицыИнтеграции.ШаблоныЭтикеток Тогда
				
				Если Не ПереопределитьШаблонЭтикеткиПередЗаписьюВТаблицу(СтруктураРезультат) Тогда
					Продолжить;
				КонецЕсли;
			
			КонецЕсли;
			
		КонецЕсли;

		НаборЗаписей = МенеджерТаблицы.СоздатьНаборЗаписей();

		Для Каждого ЭлементОтбора Из НаборЗаписей.Отбор Цикл
			
			Если СтруктураРезультат.Свойство(ЭлементОтбора.Имя) Тогда
				ЭлементОтбора.Установить(СтруктураРезультат[ЭлементОтбора.Имя]);
			КонецЕсли;

		КонецЦикла;
		
		Если Не ПараметрыЗаписи.УдалениеДанных Тогда
			ЗаполнитьЗначенияСвойств(НаборЗаписей.Добавить(), СтруктураРезультат);
		КонецЕсли;
		
		Если Не ПараметрыЗаписи.РегистрацияИзменений И Не ПараметрыЗаписи.УдалениеДанных Тогда
			НаборЗаписей.ДополнительныеСвойства.Вставить("SUI_НеРегистрироватьИзменения");
		КонецЕсли;

		НаборЗаписей.Записать(Истина);
		
	КонецЦикла;
	
КонецПроцедуры

Функция ЭтоКлючГенерацииИдентификатора(Знач Значение)
	Значение = СокрЛП(ОбщегоНазначения.ОписаниеТипаСтрока(0).ПривестиЗначение(Значение));
	Возврат СтрНачинаетсяС(Значение, "SUI_AUTO_ID[") И СтрЗаканчиваетсяНа(Значение, "]");
КонецФункции

Функция КлючиАвтоГенерацииИдентификатора(Знач КлючиИзРезультата, СлужебныеКлючи, ПрефиксСлужебныхКлючей)
	
	Поля = Неопределено;
	ИсключаемыеПоля = Неопределено;
	
	КлючиИзРезультата = СокрЛП(ОбщегоНазначения.ОписаниеТипаСтрока(0).ПривестиЗначение(КлючиИзРезультата));
	
	Если ЭтоКлючГенерацииИдентификатора(КлючиИзРезультата) Тогда
		
		РазрешенныеСимволы = "_," 
			+ SUI_СтроковыеФункцииКлиентСервер.АлфавитБуквыЛатинские() 
			+ SUI_СтроковыеФункцииКлиентСервер.АлфавитБуквыРусские()
			+ SUI_СтроковыеФункцииКлиентСервер.АлфавитЦифры();
			
		КлючиИзРезультата = СтрЗаменить(КлючиИзРезультата, "SUI_AUTO_ID[", "");
		КлючиИзРезультата = СтрЗаменить(КлючиИзРезультата, "]", "");
		КлючиИзРезультата = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(КлючиИзРезультата, ";", Истина, Истина);
		
		Для индекс = 0 По КлючиИзРезультата.ВГраница() Цикл
			
			Если Поля <> Неопределено И ИсключаемыеПоля <> Неопределено Тогда
				Прервать;
			КонецЕсли;
			
			Если СтрНачинаетсяС(КлючиИзРезультата[индекс], "fields=") Тогда
				
				ПоляСтрокой = SUI_СтроковыеФункцииКлиентСервер.ПривестиСтрокуКРазрешеннымСимволам(
					СтрЗаменить(КлючиИзРезультата[индекс], "fields=", ""), РазрешенныеСимволы);
					
				Поля = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ПоляСтрокой, , Истина, Истина);
			
			ИначеЕсли СтрНачинаетсяС(КлючиИзРезультата[индекс], "exclude=") Тогда
				
				ИсключаемыеПоляСтрокой = SUI_СтроковыеФункцииКлиентСервер.ПривестиСтрокуКРазрешеннымСимволам(
					СтрЗаменить(КлючиИзРезультата[индекс], "exclude=", ""), РазрешенныеСимволы);
				
				ИсключаемыеПоля = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ИсключаемыеПоляСтрокой, , Истина, Истина);
				
				Если Не ПустаяСтрока(ПрефиксСлужебныхКлючей) Тогда
		
					Для Счетчик = 0 По ИсключаемыеПоля.ВГраница() Цикл
						ИсключаемыеПоля[Счетчик] = ПрефиксСлужебныхКлючей + ИсключаемыеПоля[Счетчик];
					КонецЦикла;
		
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;

	КонецЕсли;
	
	Если Поля = Неопределено Тогда
		Поля = Новый Массив();
	КонецЕсли;
	
	Если ИсключаемыеПоля = Неопределено Тогда
		ИсключаемыеПоля = Новый Массив();
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Поля, СлужебныеКлючи, Истина);
	
	Поля = ОбщегоНазначенияКлиентСервер.РазностьМассивов(Поля, ИсключаемыеПоля);
	
	Возврат СтрСоединить(Поля, ",");
	
КонецФункции

Функция СформироватьИдентификаторПоСлужебнымРеквизитам(СлужебныеРеквизиты)
	
	ПараметрыФункции = Новый Массив();
	Для Каждого СлужебныйРеквизит Из СлужебныеРеквизиты Цикл
		ПараметрыФункции.Добавить("Параметры." + СлужебныйРеквизит.Ключ);
	КонецЦикла;
	
	Выражение = "SUI_ИнтеграцияВКонфигурацию.СформироватьИдентификатор(" + СтрСоединить(ПараметрыФункции, ",") + ")";
	
	Возврат ОбщегоНазначения.ВычислитьВБезопасномРежиме(Выражение, СлужебныеРеквизиты);

КонецФункции

Процедура ОчиститьТаблицуИнтеграции(ТаблицаИнтеграции)
	
	ИмяТаблицы = SUI_НастройкиМетаданныхСервер.ПолучитьИмяТаблицыВКонфигурации(ТаблицаИнтеграции);
	
	Если ИмяТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НачатьТранзакцию();
		
	Попытка
		
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить(ИмяТаблицы);
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Разделяемый;
		Блокировка.Заблокировать();
		
		НаборЗаписей = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ИмяТаблицы).СоздатьНаборЗаписей();
		НаборЗаписей.Записать(Истина);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
		
КонецПроцедуры

Функция ДанныеКУдалениюВТаблицеПоИсточнику(ПараметрыЗаписи, Знач ПараметрыВыгрузки)
	
	Если ПараметрыЗаписи.ИсточникДанных = Неопределено Или 
		ПараметрыВыгрузки.НастройкиКомпоновкиДанных.Отбор.Элементы.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПараметрыВыгрузки.НастройкиКомпоновкиДанных.Отбор.Элементы.Очистить();
	
	Возврат МенеджерНастроекТаблиц().ВыгрузитьРезультатПоНастройке(ПараметрыВыгрузки);

КонецФункции

Функция ПереопределитьШаблонЭтикеткиПередЗаписьюВТаблицу(Данные)
	
	ЭтоZPL = SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Данные, "isZPL", Ложь, Тип("Булево"));
			
	Данные.layout = SUI_ШаблоныЭтикеток.МакетВBase64(Данные.layout, ЭтоZPL);
	
	Если Не ЗначениеЗаполнено(Данные.layout) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Данные.layout = Новый ХранилищеЗначения(Данные.layout, Новый СжатиеДанных(9));
	
	Возврат Истина;
			
КонецФункции

#КонецОбласти
