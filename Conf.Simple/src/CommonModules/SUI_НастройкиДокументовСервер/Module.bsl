Процедура ПриДобавленииОбработчиковОбновления(Обработчики) Экспорт
	
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия 				= "1.0.1.7";
	Обработчик.Процедура 			= "SUI_НастройкиДокументовСервер.КонвертироватьНастройкиДокументовПриОбновлении_1_0_1_7";
	Обработчик.РежимВыполнения 		= "Оперативно";
	Обработчик.Комментарий 			= НСтр("ru = 'Конвертация настроек документов'");
	
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия 				= "1.0.5.6";
	Обработчик.Процедура 			= "SUI_НастройкиДокументовСервер.СброситьПризнакАгрегацииПриОбновлении_1_0_5_6";
	Обработчик.РежимВыполнения 		= "Оперативно";
	Обработчик.Комментарий 			= НСтр("ru = 'Конвертация настроек документов'");
	
КонецПроцедуры

Процедура КонвертироватьНастройкиДокументовПриОбновлении_1_0_1_7() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	SUI_НастройкиДокументов.Ссылка КАК Ссылка,
		|	SUI_НастройкиДокументов.ПометкаУдаления КАК ПометкаУдаления
		|ИЗ
		|	Справочник.SUI_НастройкиДокументов КАК SUI_НастройкиДокументов
		|ГДЕ
		|	SUI_НастройкиДокументов.Используется = SUI_НастройкиДокументов.ПометкаУдаления";
			
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	НачатьТранзакцию();
	
	Попытка
		
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("Справочник.SUI_НастройкиДокументов");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Разделяемый;
		ЭлементБлокировки.ИсточникДанных = РезультатЗапроса;
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Ссылка", "Ссылка");
		Блокировка.Заблокировать();
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			НастройкиОбъект = Выборка.Ссылка.ПолучитьОбъект();;
			НастройкиОбъект.Используется = Не Выборка.ПометкаУдаления;
			НастройкиОбъект.Записать();
			
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура СброситьПризнакАгрегацииПриОбновлении_1_0_5_6() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Ссылка
		|ИЗ
		|	Справочник.SUI_НастройкиДокументов
		|ГДЕ
		|	ГрупповоеСканирование
		|	И Агрегация";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		
		НачатьТранзакцию();
		
		Попытка
			
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить("Справочник.SUI_НастройкиДокументов");
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			ЭлементБлокировки.ИсточникДанных = РезультатЗапроса;
			ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Ссылка", "Ссылка");
			Блокировка.Заблокировать();
			
			Выборка = РезультатЗапроса.Выбрать();
			
			Пока Выборка.Следующий() Цикл
				
				НастройкаОбъект = Выборка.Ссылка.ПолучитьОбъект();
				НастройкаОбъект.Агрегация = Ложь;
				НастройкаОбъект.ОбменДанными.Загрузка = Истина;
				
				Если НастройкаОбъект.ПроверитьЗаполнение() Тогда
					НастройкаОбъект.Записать();
				КонецЕсли;
				
			КонецЦикла;
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗагрузитьПолученныеНастройкиИзФайла(КоллекцияНастроек, ПерезаписыватьСуществующие = Истина)
	
	Результат = Новый Структура("Всего, Загруженно, Пропущено", КоллекцияНастроек.Количество(), 0, 0);
	
	Для Каждого ЭлементКоллекцииНастроек Из КоллекцияНастроек Цикл
		
		Если Не SUI_ОбщегоНазначения.СсылкаСуществует(ЭлементКоллекцииНастроек.Ссылка) Тогда
			НастройкаОбъект = Справочники.SUI_НастройкиДокументов.СоздатьЭлемент();
			//ЭлементКоллекцииНастроек.Ссылка = НастройкаОбъект.Ссылка;
			НастройкаОбъект.УстановитьСсылкуНового(ЭлементКоллекцииНастроек.Ссылка);
		Иначе
			
			Если ПерезаписыватьСуществующие Тогда
				НастройкаОбъект = ЭлементКоллекцииНастроек.Ссылка.ПолучитьОбъект();
			Иначе
				Продолжить;
			КонецЕсли;
			
		КонецЕсли;

		Если ТипЗнч(НастройкаОбъект) <> Тип("СправочникОбъект.SUI_НастройкиДокументов") Тогда
			Продолжить;
		КонецЕсли;
		
		Если Метаданные.Документы.Найти(ЭлементКоллекцииНастроек.ИмяОбъектаМетаданных) = Неопределено Тогда
			SUI_ОбщегоНазначения.СообщитьПользователю(
				СтрШаблон(НСтр("ru = 'Документ с именем %1 не существует в текущей конфигурации.'"), ЭлементКоллекцииНастроек.ИмяОбъектаМетаданных));
			Продолжить;
		КонецЕсли;

		Попытка
			
			НастройкаОбъект.Заполнить(ЭлементКоллекцииНастроек);
			
			Если НастройкаОбъект.ПроверитьЗаполнение() Тогда
				
				НастройкаОбъект.Записать();
				
				НаборЗаписей = РегистрыСведений.SUI_НастройкиДокументовМобильныхУстройств.СоздатьНаборЗаписей();
				НаборЗаписей.Отбор.НастройкаДокумента.Установить(НастройкаОбъект.Ссылка);
				НаборЗаписей.Заполнить(Новый Структура());
				НаборЗаписей.Записать(Истина);
				
				Результат.Загруженно = Результат.Загруженно + 1;
				
			КонецЕсли;
			
		Исключение
			ВызватьИсключение;
		КонецПопытки;

	КонецЦикла;
	
	Результат.Пропущено = Результат.Всего - Результат.Загруженно;
	
	Возврат Результат;
	
КонецФункции

// Получить внешнее имя реквизита.
// 
// Параметры:
//  ИмяРеквизита - Строка - Имя реквизита
// 
// Возвращаемое значение:
//  Строка - Внешнее имя реквизита
Функция ПолучитьВнешнееИмяРеквизита(ИмяРеквизита)
	
	Если НРег(ИмяРеквизита) = "контрагент" Тогда
		Возврат "id_countragents";
	ИначеЕсли НРег(ИмяРеквизита) = "склад" Тогда
		Возврат "id_warehouse";
	ИначеЕсли НРег(ИмяРеквизита) = "номенклатура" Тогда
		Возврат "id_good";
	ИначеЕсли НРег(ИмяРеквизита) = "характеристика" Тогда
		Возврат "id_properties";
	ИначеЕсли НРег(ИмяРеквизита) = "серия" Тогда
		Возврат "id_series";
	ИначеЕсли НРег(ИмяРеквизита) = "статусуказаниясерий" Тогда
		Возврат "use_series";
	ИначеЕсли НРег(ИмяРеквизита) = "упаковка" Тогда
		Возврат "id_unit";
	ИначеЕсли НРег(ИмяРеквизита) = "ячейка" Тогда
		Возврат "id_cell";
	ИначеЕсли НРег(ИмяРеквизита) = "видцены" Тогда
		Возврат "id_price";
	ИначеЕсли НРег(ИмяРеквизита) = "цена" Тогда
		Возврат "price";
	ИначеЕсли НРег(ИмяРеквизита) = "штрихкодупаковки" Тогда
		Возврат "id_marking_code";
	ИначеЕсли НРег(ИмяРеквизита) = "значениештрихкода" Тогда
		Возврат "mark_code";
	ИначеЕсли НРег(ИмяРеквизита) = "количествоплан" Тогда
		Возврат "qtty_plan";
	ИначеЕсли НРег(ИмяРеквизита) = "количествофакт" Тогда
		Возврат "qtty";
	ИначеЕсли НРег(ИмяРеквизита) = "номер" Тогда
		Возврат "doc_n";
	ИначеЕсли НРег(ИмяРеквизита) = "дата" Тогда
		Возврат "doc_date";
	Иначе
		Возврат ИмяРеквизита;
	КонецЕсли;
	
КонецФункции

Функция СоответствиеРеквизитов(ОписаниеМетаданных, СоответствияРеквизитов, ТипТаблицы = Неопределено)
	
	Если ТипТаблицы = Перечисления.SUI_ТипыТаблицДокументовОбмена.Товары Тогда
		ОбязательныеРеквизиты = ОбязательноеСопоставлениеРеквизитовТаблицыТовары();
	ИначеЕсли ТипТаблицы = Перечисления.SUI_ТипыТаблицДокументовОбмена.ШтрихкодыУпаковок Тогда
		ОбязательныеРеквизиты = ОбязательноеСопоставлениеРеквизитовТаблицыШтрихкодыУпаковок();
	ИначеЕсли ТипТаблицы = Перечисления.SUI_ТипыТаблицДокументовОбмена.Отбор Или
		ТипТаблицы = Перечисления.SUI_ТипыТаблицДокументовОбмена.Размещение Тогда
		ОбязательныеРеквизиты = ОбязательноеСопоставлениеРеквизитовТаблицыОтборРазмещение();
	ИначеЕсли ТипТаблицы = Перечисления.SUI_ТипыТаблицДокументовОбмена.Серии Тогда
		ОбязательныеРеквизиты = ОбязательноеСопоставлениеРеквизитовТаблицыСерии();
	Иначе
		ОбязательныеРеквизиты = Новый Соответствие();
	КонецЕсли;
	
	СоответствияРеквизитовКопия = Новый Соответствие();
	
	Для Каждого СоответствиеРеквизита Из СоответствияРеквизитов Цикл
		
		ВнешнееИмяРеквизита = ПолучитьВнешнееИмяРеквизита(СоответствиеРеквизита.Ключ);
		
		сткСоответствиеРеквизита = Новый Структура("Тип, Имя, ПостоянноеЗначение");
		
		Если СоответствиеРеквизита.Значение.ИмяРеквизита = Неопределено И
			СоответствиеРеквизита.Значение.ПостоянноеЗначение <> Неопределено Тогда
			
			сткСоответствиеРеквизита.ПостоянноеЗначение = СоответствиеРеквизита.Значение.ПостоянноеЗначение;
			сткСоответствиеРеквизита.Тип = Новый ОписаниеТипов(SUI_ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(
				ТипЗнч(СоответствиеРеквизита.Значение.ПостоянноеЗначение)));

		ИначеЕсли СоответствиеРеквизита.Значение.ИмяРеквизита <> Неопределено И
			СоответствиеРеквизита.Значение.ПостоянноеЗначение = Неопределено Тогда 
			
			МетаданныеРеквизита = ОписаниеМетаданных.Реквизиты.Найти(СоответствиеРеквизита.Значение.ИмяРеквизита);
			
			Если МетаданныеРеквизита = Неопределено Тогда
			
				Если SUI_ОбщегоНазначения.ЭтоСтандартныйРеквизит(ОписаниеМетаданных.СтандартныеРеквизиты, СоответствиеРеквизита.Значение.ИмяРеквизита) Тогда
					МетаданныеРеквизита = ОписаниеМетаданных.СтандартныеРеквизиты[СоответствиеРеквизита.Значение.ИмяРеквизита];
				КонецЕсли;
				
			КонецЕсли;
			
			Если МетаданныеРеквизита <> Неопределено Тогда
				сткСоответствиеРеквизита.Имя = МетаданныеРеквизита.Имя;
				сткСоответствиеРеквизита.Тип = МетаданныеРеквизита.Тип;
			КонецЕсли;
			
		КонецЕсли;
		
		Если сткСоответствиеРеквизита.Тип = Неопределено Тогда
			
			Если ЗначениеЗаполнено(ОбязательныеРеквизиты) Тогда
				
				ОбязательныйРеквизит = ОбязательныеРеквизиты.Получить(СоответствиеРеквизита.Ключ);
				
				Если ОбязательныйРеквизит <> Неопределено И ОбязательныйРеквизит Тогда
					СоответствияРеквизитовКопия = Новый Соответствие();
					Прервать;
				КонецЕсли;
				
			КонецЕсли;
			
			СоответствияРеквизитовКопия.Вставить(ВнешнееИмяРеквизита, Неопределено);
			
		Иначе
			СоответствияРеквизитовКопия.Вставить(ВнешнееИмяРеквизита, сткСоответствиеРеквизита);
		КонецЕсли;
				
	КонецЦикла;
	
	Возврат Новый ФиксированноеСоответствие(СоответствияРеквизитовКопия);
	
КонецФункции

Функция СформироватьНастройкиРеквизитовДокумента(НастройкиРеквизитовСтроки, МетаданныеДокумента)
	
	НастройкиРеквизитов = Новый Соответствие();
	
	НастройкиРеквизитов.Вставить(ПолучитьВнешнееИмяРеквизита("Номер"), Новый Структура("ИмяРеквизита, ПостоянноеЗначение", "Номер"));
	НастройкиРеквизитов.Вставить(ПолучитьВнешнееИмяРеквизита("Дата"), Новый Структура("ИмяРеквизита, ПостоянноеЗначение", "Дата"));
	
	Для Каждого СтрокаНастройкиРеквизитов Из НастройкиРеквизитовСтроки Цикл
		НастройкиРеквизитов.Вставить(ПолучитьВнешнееИмяРеквизита(СтрокаНастройкиРеквизитов.Ключ), 
			Новый Структура("ИмяРеквизита, ПостоянноеЗначение", СтрокаНастройкиРеквизитов.Значение));
	КонецЦикла;

	Возврат СоответствиеРеквизитов(МетаданныеДокумента, НастройкиРеквизитов);

КонецФункции

Функция СформироватьНастройкиТабличныхЧастейДокумента(ТаблицаНастройкиТабличныхЧастей, МетаданныеДокумента)
	
	НастройкиТабличныхЧастей = Новый Соответствие();
	
	ТаблицаВерхнегоУровня = ТаблицаНастройкиТабличныхЧастей.Скопировать();
	ТаблицаВерхнегоУровня.Свернуть("ТипТаблицы, ИмяТабличнойЧасти, УдалятьПустыеСтроки, ПропускатьПриЗаписи");

	Для Каждого СтрокаТаблицыВерхнегоУровня Из ТаблицаВерхнегоУровня Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаТаблицыВерхнегоУровня.ТипТаблицы) Тогда
			Продолжить;
		КонецЕсли;

		МетаданныеТабличнойЧасти = МетаданныеДокумента.ТабличныеЧасти.Найти(СтрокаТаблицыВерхнегоУровня.ИмяТабличнойЧасти);
		
		Если МетаданныеТабличнойЧасти = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		НастройкиРеквизитов = Новый Соответствие();

		СтрокиТаблицыНижнегоУровня = ТаблицаНастройкиТабличныхЧастей.НайтиСтроки(
			Новый Структура("ТипТаблицы, ИмяТабличнойЧасти", СтрокаТаблицыВерхнегоУровня.ТипТаблицы, СтрокаТаблицыВерхнегоУровня.ИмяТабличнойЧасти));

		Для Каждого СтрокаТаблицыНижнегоУровня Из СтрокиТаблицыНижнегоУровня Цикл
			
			Значение = Новый Структура("ИмяРеквизита, ПостоянноеЗначение");
			Если СтрокаТаблицыНижнегоУровня.ИспользуетсяПостоянноеЗначение Тогда
				Значение.ПостоянноеЗначение = СтрокаТаблицыНижнегоУровня.ПостоянноеЗначение;
			Иначе
				Значение.ИмяРеквизита = СтрокаТаблицыНижнегоУровня.ИмяРеквизита;
			КонецЕсли;
			
			НастройкиРеквизитов.Вставить(СтрокаТаблицыНижнегоУровня.Поле, Значение);
			
		КонецЦикла;

		НастройкаТабличнойЧасти = Новый Структура();
		НастройкаТабличнойЧасти.Вставить("ТипТаблицы", СтрокаТаблицыВерхнегоУровня.ТипТаблицы);
		НастройкаТабличнойЧасти.Вставить("ИмяТабличнойЧасти", СтрокаТаблицыВерхнегоУровня.ИмяТабличнойЧасти);
		НастройкаТабличнойЧасти.Вставить("УдалятьПустыеСтроки", СтрокаТаблицыВерхнегоУровня.УдалятьПустыеСтроки);
		НастройкаТабличнойЧасти.Вставить("ПропускатьПриЗаписи", СтрокаТаблицыВерхнегоУровня.ПропускатьПриЗаписи);
	
		НастройкаТабличнойЧасти.Вставить("Элементы", 
			СоответствиеРеквизитов(МетаданныеТабличнойЧасти, НастройкиРеквизитов, НастройкаТабличнойЧасти.ТипТаблицы));
		
		Если Не ЗначениеЗаполнено(НастройкаТабличнойЧасти.Элементы) Тогда
			Продолжить;
		КонецЕсли;
		
		НастройкиТабличныхЧастей.Вставить(СтрокаТаблицыВерхнегоУровня.ТипТаблицы, НастройкаТабличнойЧасти);
		
	КонецЦикла;

	Возврат НастройкиТабличныхЧастей;

КонецФункции

