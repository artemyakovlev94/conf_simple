
#Область ПрограммныйИнтерфейс

Функция ПолучитьДанныеНастроекДляВыгрузки(АдресХранения = Неопределено, ВыбранныеНастройки = Неопределено) Экспорт
	
	ТаблицаРезультат = Новый ТаблицаЗначений();
	ТаблицаРезультат.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("СправочникСсылка.SUI_НастройкиДокументов"));
	
	ОписаниеТипаМассив = Новый ОписаниеТипов("Массив");
	Для Каждого ВыбраннаяНастройка Из ОписаниеТипаМассив.ПривестиЗначение(ВыбранныеНастройки) Цикл
		
		НоваяСтрока = ТаблицаРезультат.Добавить();
		НоваяСтрока.Ссылка = ВыбраннаяНастройка;
		
		Если НоваяСтрока.Ссылка.Пустая() Тогда
			ТаблицаРезультат.Удалить(НоваяСтрока);
		КонецЕсли;
		
	КонецЦикла;
	
	Справочники.SUI_НастройкиДокументов.СформироватьДанныеДляВыгрузки(ТаблицаРезультат);
	
	НастройкиДокументов = Новый Структура();
	НастройкиДокументов.Вставить("ЭтоНастройкиДокументов", Истина);
	НастройкиДокументов.Вставить("Количество", 0);
	НастройкиДокументов.Вставить("Состав", ТаблицаРезультат.ВыгрузитьКолонку("Данные"));
	
	НастройкиДокументов.Количество = НастройкиДокументов.Состав.Количество();
	
	НастройкиДокументов = SUI_ОбщегоНазначения.ЗначениеВСтрокуXML(НастройкиДокументов);
	
	Если ТипЗнч(АдресХранения) = Тип("Строка") И ЗначениеЗаполнено(АдресХранения) Тогда
		
		Если ЭтоАдресВременногоХранилища(АдресХранения) Тогда
			Возврат ПоместитьВоВременноеХранилище(НастройкиДокументов, АдресХранения);
		ИначеЕсли СтроковыеФункцииКлиентСервер.ЭтоУникальныйИдентификатор(АдресХранения) Тогда
			Возврат ПоместитьВоВременноеХранилище(НастройкиДокументов, Новый УникальныйИдентификатор(АдресХранения));
		Иначе
			Возврат Неопределено;
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(АдресХранения) = Тип("УникальныйИдентификатор") Тогда
		Возврат ПоместитьВоВременноеХранилище(НастройкиДокументов, АдресХранения);
	Иначе
		Возврат НастройкиДокументов;
	КонецЕсли;

КонецФункции

Функция ПолучитьНастройкиИзФайла(АдресХранения, ПерезаписыватьСуществующие = Истина) Экспорт

	РезультатПолучения = Новый Структура();
	
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресХранения);

	Если ТипЗнч(ДвоичныеДанные) <> Тип("ДвоичныеДанные") И  ТипЗнч(ДвоичныеДанные) <> Тип("Строка") Тогда
		РезультатПолучения.Вставить("Ошибка", СтрШаблон(НСтр("ru = 'Не удалось получить файл настроек документов %1'"), SUI_SimpleКлиентСервер.Представление()));
	Иначе
	
		Попытка
			
			Если ТипЗнч(ДвоичныеДанные) =  Тип("ДвоичныеДанные") Тогда
				НастройкаXML = ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанные);
			Иначе
				НастройкаXML = ДвоичныеДанные;	
			КонецЕсли;
			
			Настройка = SUI_ОбщегоНазначения.ЗначениеИзСтрокиXML(НастройкаXML);
			
			Если ТипЗнч(Настройка) = Тип("Структура") И 
				Настройка.Свойство("ЭтоНастройкиДокументов") И 
				ТипЗнч(Настройка.ЭтоНастройкиДокументов) = Тип("Булево") И
				Настройка.ЭтоНастройкиДокументов И
				Настройка.Свойство("Количество") И
				ТипЗнч(Настройка.Количество) = Тип("Число") И
				Настройка.Свойство("Состав") И 
				ТипЗнч(Настройка.Состав) = Тип("Массив") Тогда
				
				Если Настройка.Состав.Количество() > 0 Тогда  
					РезультатПолучения.Вставить("АдресНастроек", ПоместитьВоВременноеХранилище(Настройка.Состав, АдресХранения));
					РезультатПолучения.Вставить("ПерезаписыватьСуществующие", ПерезаписыватьСуществующие);
				Иначе
					РезультатПолучения.Вставить("Ошибка", СтрШаблон(НСтр("ru = 'В загружаемом файле отсутствуют настройки документов %1'"), 
						SUI_SimpleКлиентСервер.Представление()));
				КонецЕсли;

			Иначе
				РезультатПолучения.Вставить("Ошибка", СтрШаблон(НСтр("ru = 'Загружаемый файл не является настройками документов %1'"), 
					SUI_SimpleКлиентСервер.Представление()));
			КонецЕсли;
			
		Исключение
			РезультатПолучения.Вставить("Ошибка", СтрШаблон(НСтр("ru = 'Не удалось загрузить файл настроек документов %1 по причине:
			|%2'"), SUI_SimpleКлиентСервер.Представление(), КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
			SUI_ЖурналРегистрации.ЗаписьВЖурналРегистрации(SUI_НастройкиДокументовКлиентСервер.ИмяСобытия(НСтр("ru = 'Загрузка из файла'")), , 
				Метаданные.ОбщиеМодули.SUI_НастройкиДокументовСервер, , ИнформацияОбОшибке());
		КонецПопытки;
		
	КонецЕсли;

	Возврат РезультатПолучения;
	
КонецФункции

Функция ЗагрузитьВыбранныеНастройки(СтруктураЗагруженныхНастроек) Экспорт
	
	ПерезаписыватьСуществующие = СтруктураЗагруженныхНастроек.ПерезаписыватьСуществующие;
	
	МассивНастроек = ПолучитьИзВременногоХранилища(СтруктураЗагруженныхНастроек.АдресНастроек);
			
	РезультатЗагрузки = Новый Структура("Загружена", Ложь);
	
	Если МассивНастроек.Количество() = 0 Тогда
		РезультатЗагрузки.Вставить("Ошибка", СтрШаблон(НСтр("ru = 'Не переданы настройки для загрузки %1'"), 
		SUI_SimpleКлиентСервер.Представление()));		
		
	Иначе
		
		Попытка	
				
			РезультатЗагрузкиВБД = ЗагрузитьПолученныеНастройкиИзФайла(МассивНастроек, ПерезаписыватьСуществующие);
			ТекстСообщения = СтрШаблон(НСтр("ru = 'Загруженно %1 из %2 настроек документов %3.'"),
			РезультатЗагрузкиВБД.Загруженно, РезультатЗагрузкиВБД.Всего, SUI_SimpleКлиентСервер.Представление());
			
			РезультатЗагрузки.Вставить("Сообщение", ТекстСообщения);
			РезультатЗагрузки.Загружена = Истина;
			
		Исключение
			РезультатЗагрузки.Вставить("Ошибка", СтрШаблон(НСтр("ru = 'Не удалось загрузить настройки документов %1 по причине:
			|%2'"), SUI_SimpleКлиентСервер.Представление(), КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
			SUI_ЖурналРегистрации.ЗаписьВЖурналРегистрации(SUI_НастройкиДокументовКлиентСервер.ИмяСобытия(НСтр("ru = 'Загрузка из файла'")), , 
			Метаданные.ОбщиеМодули.SUI_НастройкиДокументовСервер, , ИнформацияОбОшибке());
		КонецПопытки;
		
	КонецЕсли;

	Возврат РезультатЗагрузки;
	
КонецФункции

Функция ПолучитьРеквизитыСоответствия() Экспорт
	
	РеквизитыСоответствия = Новый Соответствие();
	
	РеквизитыСоответствия.Вставить("id_countragents", Ложь);
	РеквизитыСоответствия.Вставить("id_warehouse", Ложь);
	
	Возврат РеквизитыСоответствия;
	
КонецФункции

Функция ПолучитьРеквизитыСоответствияТабличныхЧастей(Знач ТипТаблицы = Неопределено, ФиксированноеЗначение = Ложь) Экспорт
	
	Если ТипЗнч(ТипТаблицы) <> Тип("ПеречислениеСсылка.SUI_ТипыТаблицДокументовОбмена") Тогда
		ТипТаблицы = ПредопределенноеЗначение("Перечисление.SUI_ТипыТаблицДокументовОбмена.ПустаяСсылка");
	КонецЕсли;
	
	РеквизитыСоответствия = Новый Соответствие();
	
	Если ТипТаблицы.Пустая() Или ТипТаблицы = ПредопределенноеЗначение("Перечисление.SUI_ТипыТаблицДокументовОбмена.Товары") Тогда
		РеквизитыСоответствия.Вставить(ПредопределенноеЗначение("Перечисление.SUI_ТипыТаблицДокументовОбмена.Товары"), 
			РеквизитыСоответствияТаблицыТовары(ФиксированноеЗначение));
	КонецЕсли;
	
	Если ТипТаблицы.Пустая() Или ТипТаблицы = ПредопределенноеЗначение("Перечисление.SUI_ТипыТаблицДокументовОбмена.ШтрихкодыУпаковок") Тогда
		РеквизитыСоответствия.Вставить(ПредопределенноеЗначение("Перечисление.SUI_ТипыТаблицДокументовОбмена.ШтрихкодыУпаковок"), 
			РеквизитыСоответствияТаблицыШтрихкодыУпаковок(ФиксированноеЗначение));
	КонецЕсли;
	
	Если ТипТаблицы.Пустая() Или ТипТаблицы = ПредопределенноеЗначение("Перечисление.SUI_ТипыТаблицДокументовОбмена.Отбор") Тогда
		РеквизитыСоответствия.Вставить(ПредопределенноеЗначение("Перечисление.SUI_ТипыТаблицДокументовОбмена.Отбор"), 
			РеквизитыСоответствияТаблицыОтборРазмещение(ФиксированноеЗначение));
	КонецЕсли;
	
	Если ТипТаблицы.Пустая() Или ТипТаблицы = ПредопределенноеЗначение("Перечисление.SUI_ТипыТаблицДокументовОбмена.Размещение") Тогда
		РеквизитыСоответствия.Вставить(ПредопределенноеЗначение("Перечисление.SUI_ТипыТаблицДокументовОбмена.Размещение"), 
			РеквизитыСоответствияТаблицыОтборРазмещение(ФиксированноеЗначение));
	КонецЕсли;
	
	Если ТипТаблицы.Пустая() Или ТипТаблицы = ПредопределенноеЗначение("Перечисление.SUI_ТипыТаблицДокументовОбмена.Серии") Тогда
		РеквизитыСоответствия.Вставить(ПредопределенноеЗначение("Перечисление.SUI_ТипыТаблицДокументовОбмена.Серии"), 
			РеквизитыСоответствияТаблицыСерии(ФиксированноеЗначение));
	КонецЕсли;
	
	Если ТипТаблицы.Пустая() Тогда
		Возврат РеквизитыСоответствия;
	Иначе
		Возврат РеквизитыСоответствия.Получить(ТипТаблицы);
	КонецЕсли;
	
КонецФункции

Функция ИмяТипаТаблицыДокументаОбмена(ТипТаблицы) Экспорт
	
	ИндексТаблицы = Перечисления.SUI_ТипыТаблицДокументовОбмена.Индекс(ТипТаблицы);
	Возврат Метаданные.Перечисления.SUI_ТипыТаблицДокументовОбмена.ЗначенияПеречисления[ИндексТаблицы].Имя;
	
КонецФункции

Функция ПолучитьНастройкиДокумента(Знач ДокументСсылка, ПоВыгрузкеДокумента = Ложь, Неиспользуемые = Ложь) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	НастройкиДокумента = Новый Массив();
	
	ИдентификаторДокумента = Неопределено;

	Если SUI_ИнтеграцияВКонфигурациюКлиентСервер.ЭтоИдентификаторSimple(ДокументСсылка) Тогда
		ИдентификаторДокумента = ДокументСсылка;
		ДокументСсылка = SUI_ИнтеграцияВКонфигурацию.СсылкаПоИдентификаторуSimple(ИдентификаторДокумента);
	КонецЕсли;
	
	Если Не SUI_ОбщегоНазначения.ЭтоСсылкаДокумента(ДокументСсылка) Или
		Не SUI_ОбщегоНазначения.СсылкаСуществует(ДокументСсылка) Тогда
		ВызватьИсключение НСтр("ru = 'Ссылка объекта не существует или не является ссылкой документа.'");
	ИначеЕсли Не ЗначениеЗаполнено(ИдентификаторДокумента) Тогда
		ИдентификаторДокумента = SUI_ИнтеграцияВКонфигурацию.ИдентификаторSimpleПоСсылке(ДокументСсылка, Истина);
	КонецЕсли;

	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("ИмяОбъектаМетаданных", 	ДокументСсылка.Метаданные().Имя);
	Запрос.УстановитьПараметр("id_doc", 				ИдентификаторДокумента);
	Запрос.УстановитьПараметр("Неиспользуемые", 		Неиспользуемые);

	Если ПоВыгрузкеДокумента Тогда
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	SUI_docs_beta.НастройкаДокумента
			|ИЗ
			|	РегистрСведений.SUI_docs КАК SUI_docs_beta
			|ГДЕ
			|	SUI_docs_beta.id_doc = &id_doc";
	Иначе
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	SUI_НастройкиДокументов.Ссылка КАК НастройкаДокумента
			|ИЗ
			|	Справочник.SUI_НастройкиДокументов КАК SUI_НастройкиДокументов
			|ГДЕ
			|	SUI_НастройкиДокументов.ИмяОбъектаМетаданных = &ИмяОбъектаМетаданных
			|	И ВЫБОР
			|		КОГДА НЕ &Неиспользуемые
			|			ТОГДА НЕ SUI_НастройкиДокументов.ПометкаУдаления
			|			И SUI_НастройкиДокументов.Используется
			|		ИНАЧЕ ИСТИНА
			|	КОНЕЦ";
	КонецЕсли;
    
	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = Запрос.Выполнить();
	УстановитьПривилегированныйРежим(Ложь);

	Если РезультатЗапроса.Пустой() Тогда
		Возврат НастройкиДокумента;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если ПоВыгрузкеДокумента Тогда
			
			Если SUI_ОбщегоНазначения.СсылкаСуществует(Выборка.НастройкаДокумента) Тогда
				НастройкиДокумента.Добавить(Выборка.НастройкаДокумента);
			КонецЕсли;
			
		Иначе
			
			//@skip-check query-in-loop
			Если ДокументСоответствуетОтборуНастройки(Выборка.НастройкаДокумента.НастройкиСхемыКомпоновкиДанных.Получить(), ДокументСсылка) Тогда
				НастройкиДокумента.Добавить(Выборка.НастройкаДокумента);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;

	Возврат НастройкиДокумента;
	
КонецФункции

Функция СформироватьНастройкиДокумента(НастройкаДокументаСсылка) Экспорт

	НастройкаДокумента = Новый Структура();
	
	Если ТипЗнч(НастройкаДокументаСсылка) <> Тип("СправочникСсылка.SUI_НастройкиДокументов") Тогда
		Возврат НастройкаДокумента;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	SUI_НастройкиДокументов.Ссылка КАК Ссылка,
		|	SUI_НастройкиДокументов.Наименование КАК ИмяДокументаМП,
		|	SUI_НастройкиДокументов.ИмяОбъектаМетаданных КАК ИмяМетаданных,
		|	SUI_НастройкиДокументов.СостояниеДокументаПоУмолчанию КАК СостояниеДокументаПоУмолчанию,
		|	SUI_НастройкиДокументов.КонтролироватьДокумент КАК КонтролироватьДокумент,
		|	SUI_НастройкиДокументов.ИспользуетсяМаркировка КАК ИспользуетсяМаркировка,
		|	SUI_НастройкиДокументов.ПроводитьДокумент КАК ПроводитьДокумент,
		|	SUI_НастройкиДокументов.НастройкиСхемыКомпоновкиДанных КАК НастройкиКомпоновкиДанных,
		|	SUI_НастройкиДокументов.ДополнительныеНастройки КАК ДополнительныеНастройки,
		// artem - 29.08.24 - B119267 -
		|	SUI_НастройкиДокументов.Агрегация КАК Агрегация,
		|	// 20.09.2024 - artem - B119267 >>>
		|	SUI_НастройкиДокументов.ComputerVision,
		|	SUI_НастройкиДокументов.СоздаватьДокументыНаТСД,
		|	SUI_НастройкиДокументов.АлгоритмСозданияНовогоДокумента,
		|	SUI_НастройкиДокументов.СборШтрихкодов,
		|	ВЫБОР
		|		КОГДА SUI_НастройкиДокументов.Используется И НЕ SUI_НастройкиДокументов.ПометкаУдаления
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Используется,
		// nikita - 29.08.24 - B134721 -
		|	SUI_НастройкиДокументов.ПроверятьCтатусКИ КАК ПроверятьCтатусКИ,
		|	SUI_НастройкиДокументов.ПроверятьВладельца КАК ПроверятьВладельца
		// nikita - 29.08.24 - B134721 - >>>
		|ИЗ
		|	Справочник.SUI_НастройкиДокументов КАК SUI_НастройкиДокументов
		|ГДЕ
		|	SUI_НастройкиДокументов.Ссылка = &НастройкаДокумента
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СоответствияРеквизитов.Ключ КАК Ключ,
		|	СоответствияРеквизитов.Значение КАК Значение
		|ИЗ
		|	Справочник.SUI_НастройкиДокументов.СоответствияРеквизитов КАК СоответствияРеквизитов
		|ГДЕ
		|	СоответствияРеквизитов.Ссылка = &НастройкаДокумента
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	SUI_НастройкиДокументовНастройкиТабличныхЧастей.ТипТаблицы КАК ТипТаблицы,
		|	SUI_НастройкиДокументовНастройкиТабличныхЧастей.ИмяТабличнойЧасти КАК ИмяТабличнойЧасти, 
		|	SUI_НастройкиДокументовНастройкиТабличныхЧастей.ПропускатьПриЗаписи КАК ПропускатьПриЗаписи,
		|	SUI_НастройкиДокументовНастройкиТабличныхЧастей.УдалятьПустыеСтроки КАК УдалятьПустыеСтроки,
		|	SUI_НастройкиДокументовСопоставлениеРеквизитовТабличныхЧастей.Поле КАК Поле,
		|	SUI_НастройкиДокументовСопоставлениеРеквизитовТабличныхЧастей.ИмяРеквизита КАК ИмяРеквизита,
		|	SUI_НастройкиДокументовСопоставлениеРеквизитовТабличныхЧастей.ИспользуетсяПостоянноеЗначение КАК ИспользуетсяПостоянноеЗначение,
		|	SUI_НастройкиДокументовСопоставлениеРеквизитовТабличныхЧастей.ПостоянноеЗначение КАК ПостоянноеЗначение
		|ИЗ
		|	Справочник.SUI_НастройкиДокументов.НастройкиТабличныхЧастей КАК SUI_НастройкиДокументовНастройкиТабличныхЧастей
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.SUI_НастройкиДокументов.СопоставлениеРеквизитовТабличныхЧастей КАК SUI_НастройкиДокументовСопоставлениеРеквизитовТабличныхЧастей
		|		ПО SUI_НастройкиДокументовНастройкиТабличныхЧастей.КлючСвязи = SUI_НастройкиДокументовСопоставлениеРеквизитовТабличныхЧастей.КлючСвязи
		|ГДЕ
		|	SUI_НастройкиДокументовНастройкиТабличныхЧастей.Ссылка = &НастройкаДокумента
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	SUI_НастройкиДокументовНастройкиЗаполненияРеквизитовПередЗаписью.Ключ КАК Ключ,
		|	SUI_НастройкиДокументовНастройкиЗаполненияРеквизитовПередЗаписью.Значение КАК Значение,
		|	SUI_НастройкиДокументовНастройкиЗаполненияРеквизитовПередЗаписью.ПриРасхождении КАК ПриРасхождении
		|ИЗ
		|	Справочник.SUI_НастройкиДокументов.НастройкиЗаполненияРеквизитовПередЗаписью КАК SUI_НастройкиДокументовНастройкиЗаполненияРеквизитовПередЗаписью
		|ГДЕ
		|	SUI_НастройкиДокументовНастройкиЗаполненияРеквизитовПередЗаписью.Ссылка = &НастройкаДокумента
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	SUI_НастройкиДокументовНастройкиСозданияДокументовНаОснованииПослеЗаписи.Ключ КАК Ключ,
		|	SUI_НастройкиДокументовНастройкиСозданияДокументовНаОснованииПослеЗаписи.Значение КАК Значение,
		|	SUI_НастройкиДокументовНастройкиСозданияДокументовНаОснованииПослеЗаписи.Проводить КАК Проводить,
		|	SUI_НастройкиДокументовНастройкиСозданияДокументовНаОснованииПослеЗаписи.ПриРасхождении КАК ПриРасхождении
		|ИЗ
		|	Справочник.SUI_НастройкиДокументов.НастройкиСозданияДокументовНаОснованииПослеЗаписи КАК SUI_НастройкиДокументовНастройкиСозданияДокументовНаОснованииПослеЗаписи
		|ГДЕ
		|	SUI_НастройкиДокументовНастройкиСозданияДокументовНаОснованииПослеЗаписи.Ссылка = &НастройкаДокумента
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	SUI_НастройкиДокументовНастройкиВыводаДополнительныхПолей.РеквизитДокумента КАК РеквизитДокумента,
		|	SUI_НастройкиДокументовНастройкиВыводаДополнительныхПолей.ИмяНаУстройстве КАК ИмяНаУстройстве
		|ИЗ
		|	Справочник.SUI_НастройкиДокументов.НастройкиВыводаДополнительныхПолей КАК SUI_НастройкиДокументовНастройкиВыводаДополнительныхПолей
		|ГДЕ
		|	SUI_НастройкиДокументовНастройкиВыводаДополнительныхПолей.Ссылка = &НастройкаДокумента";
	
	Запрос.УстановитьПараметр("НастройкаДокумента", НастройкаДокументаСсылка);
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	УстановитьПривилегированныйРежим(Ложь);
	
	Если РезультатыЗапроса[0].Пустой() Тогда
		Возврат НастройкаДокумента;
	КонецЕсли;
	
	ОсновныеНастройки = РезультатыЗапроса[0].Выбрать();
	ОсновныеНастройки.Следующий();
	
	МетаданныеДокумента = Метаданные.Документы.Найти(ОсновныеНастройки.ИмяМетаданных);
	
	Если МетаданныеДокумента = Неопределено Тогда
		Возврат НастройкаДокумента;
	КонецЕсли;
	
	ТаблицаНастройкиРеквизитов 		= РезультатыЗапроса[1].Выгрузить();
	ТаблицаНастройкиТабличныхЧастей = РезультатыЗапроса[2].Выгрузить();
	ТаблицаУстановкиРеквизитов = РезультатыЗапроса[3].Выгрузить();
    ТаблицаСозданияДокументов = РезультатыЗапроса[4].Выгрузить();
    ТаблицаВыводаДополнительныхПолей = РезультатыЗапроса[5].Выгрузить();



	// Основные настройки
	НастройкаДокумента = Новый Структура(SUI_ОбщегоНазначения.ПолучитьИменаКолонокРезультатаЗапроса(РезультатыЗапроса[0]));
	ЗаполнитьЗначенияСвойств(НастройкаДокумента, ОсновныеНастройки);

	// Настройки компоновки данных
	Если ТипЗнч(НастройкаДокумента.НастройкиКомпоновкиДанных) <> Тип("НастройкиКомпоновкиДанных") Тогда
		НастройкаДокумента.НастройкиКомпоновкиДанных = НастройкаКомпоновкиПоПараметру(НастройкаДокумента.НастройкиКомпоновкиДанных);
	КонецЕсли;
	
	// Дополнительные настройки
	НастройкаДокумента.ДополнительныеНастройки = НастройкаДокумента.ДополнительныеНастройки.Получить();
	Если ТипЗнч(НастройкаДокумента.ДополнительныеНастройки) <> Тип("Структура") Тогда
		НастройкаДокумента.ДополнительныеНастройки = Новый Структура();
	КонецЕсли;
	
	// Реквизиты документа
	НастройкаДокумента.Вставить("Реквизиты", СформироватьНастройкиРеквизитовДокумента(ТаблицаНастройкиРеквизитов, МетаданныеДокумента));
	
	// Табличные части
	НастройкаДокумента.Вставить("ТабличныеЧасти", СформироватьНастройкиТабличныхЧастейДокумента(ТаблицаНастройкиТабличныхЧастей, МетаданныеДокумента));
	
	// Установка реквизитов
	НастройкаДокумента.Вставить("ТаблицаУстановкиРеквизитов", ТаблицаУстановкиРеквизитов);
	
	НастройкаДокумента.Вставить("ТаблицаСозданияДокументов", ТаблицаСозданияДокументов);
	
	НастройкаДокумента.Вставить("ТаблицаВыводаДополнительныхПолей", ТаблицаВыводаДополнительныхПолей);
	
	НастройкаДокумента.Вставить("ЭтоДокументАдресногоХранения", Ложь);
	
	Если НастройкаДокумента.ИмяМетаданных <> "SUI_СборШтрихкодов" Тогда
		
		Если НастройкаДокумента.ТабличныеЧасти.Количество() > 0 Тогда
			
			// Настройка документа адресного хранения
			Если НастройкаДокумента.ТабличныеЧасти.Получить(Перечисления.SUI_ТипыТаблицДокументовОбмена.Отбор) <> Неопределено Или 
				НастройкаДокумента.ТабличныеЧасти.Получить(Перечисления.SUI_ТипыТаблицДокументовОбмена.Размещение) <> Неопределено Тогда
				НастройкаДокумента.Вставить("ЭтоДокументАдресногоХранения", Истина);
			КонецЕсли;
			
		Иначе
			НастройкаДокумента = Новый Структура();
		КонецЕсли; 
		
	КонецЕсли;

	Возврат НастройкаДокумента;
	
КонецФункции

Функция ДокументСоответствуетОтборуНастройки(Знач НастройкаКомпоновкиДанных, ДокументСсылка) Экспорт
	
	Если ДокументСсылка = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	
	НастройкаКомпоновкиДанных = НастройкаКомпоновкиПоПараметру(НастройкаКомпоновкиДанных);
	
	Схема = SUI_КомпоновкаДанныхСервер.ПустаяСхема();
	
	НаборДанных = SUI_КомпоновкаДанныхСервер.ДобавитьПустойНаборДанных(Схема);
	НаборДанных.Запрос = "ВЫБРАТЬ * ИЗ " + ДокументСсылка.Метаданные().ПолноеИмя() + "
	|ГДЕ
	|	Ссылка = &ДокументСсылка";
	
	SUI_КомпоновкаДанныхКлиентСервер.ДобавитьВыбранноеПоле(НастройкаКомпоновкиДанных, "Ссылка");
	SUI_КомпоновкаДанныхСервер.ДобавитьПараметр(Схема, "ДокументСсылка", , ДокументСсылка);
	SUI_КомпоновкаДанныхКлиентСервер.ДобавитьГруппировку(НастройкаКомпоновкиДанных);
	
	ПараметрыРезультата = SUI_КомпоновкаДанныхСервер.ПараметрыРезультатСхемыКомпоновкиДанных(Схема, НастройкаКомпоновкиДанных);
	ПараметрыРезультата.ВыполнятьВПривилегированномРежиме = Истина;
	
	Результат = SUI_КомпоновкаДанныхСервер.ВыгрузитьРезультатСхемыКомпоновкиДанных(ПараметрыРезультата);
	
	Возврат (Результат.Количество() > 0);
	
КонецФункции

Функция НастройкаДокументаПринадлежитМобильномуКлиенту(НастройкаДокумента, МобильноеУстройство) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	SUI_НастройкиДокументовМобильныхКлиентов.НастройкаДокумента
		|ИЗ
		|	РегистрСведений.SUI_НастройкиДокументовМобильныхУстройств КАК SUI_НастройкиДокументовМобильныхКлиентов
		|ГДЕ
		|	SUI_НастройкиДокументовМобильныхКлиентов.НастройкаДокумента = &НастройкаДокумента
		|	И SUI_НастройкиДокументовМобильныхКлиентов.МобильноеУстройство = &МобильноеУстройство";
	
	Запрос.УстановитьПараметр("НастройкаДокумента", НастройкаДокумента);
	Запрос.УстановитьПараметр("МобильноеУстройство", МобильноеУстройство);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат Не РезультатЗапроса.Пустой();
	
КонецФункции

#КонецОбласти

