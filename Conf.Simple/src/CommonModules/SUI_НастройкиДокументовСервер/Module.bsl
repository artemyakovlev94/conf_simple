Функция НастройкаКомпоновкиПоПараметру(Знач НастройкаКомпоновки)
	
	Если ТипЗнч(НастройкаКомпоновки) = Тип("СправочникСсылка.SUI_НастройкиДокументов") Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	SUI_НастройкиДокументов.НастройкиСхемыКомпоновкиДанных
			|ИЗ
			|	Справочник.SUI_НастройкиДокументов КАК SUI_НастройкиДокументов
			|ГДЕ
			|	SUI_НастройкиДокументов.Ссылка = &Ссылка";
		Запрос.УстановитьПараметр("Ссылка", НастройкаКомпоновки);
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		НастройкаКомпоновки = Выборка.НастройкиСхемыКомпоновкиДанных.Получить();
	ИначеЕсли ТипЗнч(НастройкаКомпоновки) = Тип("ХранилищеЗначения") Тогда
		НастройкаКомпоновки = НастройкаКомпоновки.Получить();
	КонецЕсли;
	
	Если ТипЗнч(НастройкаКомпоновки) = Тип("НастройкиКомпоновкиДанных") Тогда
		Возврат НастройкаКомпоновки;
	Иначе
		Возврат Новый НастройкиКомпоновкиДанных();
	КонецЕсли;
	
КонецФункции

#КонецОбласти
