#Область СлужебныеПроцедурыИФункции

Функция НовоеОписаниеКолонкиПоМетаданным(МетаданныеЭлемента)
	
	ОписаниеКолонки = Новый Структура();
	ОписаниеКолонки.Вставить("Имя", МетаданныеЭлемента.Имя);
	ОписаниеКолонки.Вставить("Заголовок", ?(ЗначениеЗаполнено(МетаданныеЭлемента.Комментарий), МетаданныеЭлемента.Комментарий, МетаданныеЭлемента.Синоним));
	ОписаниеКолонки.Вставить("Тип", МетаданныеЭлемента.Тип);
	
	Возврат Новый ФиксированнаяСтруктура(ОписаниеКолонки);
	
КонецФункции

