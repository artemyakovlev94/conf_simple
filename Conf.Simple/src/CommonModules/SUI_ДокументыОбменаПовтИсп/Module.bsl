Функция КолонкиТаблицыДокументыОбмена() Экспорт
	
	Колонки = Новый Массив();
	
	МетаданныеРегистра = Метаданные.РегистрыСведений.SUI_docs;
	
	Для Каждого Измерение Из МетаданныеРегистра.Измерения Цикл
		
		Если Измерение.Имя = "ИмяОбъектаОписанияМетаданного" Тогда
			Продолжить;
		КонецЕсли;
		
		Колонки.Добавить(Новый ФиксированнаяСтруктура(Новый Структура("Имя, Тип, Заголовок", 
			Измерение.Имя, Измерение.Тип, Измерение.Синоним)));
			
	КонецЦикла;
	
	Для Каждого Ресурс Из МетаданныеРегистра.Ресурсы Цикл
		
		Если Ресурс.Имя = "ИмяОбъектаОписанияМетаданного" Тогда
			Продолжить;
		КонецЕсли;
		
		Колонки.Добавить(Новый ФиксированнаяСтруктура(Новый Структура("Имя, Тип, Заголовок", 
			Ресурс.Имя, Ресурс.Тип, Ресурс.Синоним)));
			
	КонецЦикла;
	
	Для Каждого Реквизит Из МетаданныеРегистра.Реквизиты Цикл
		
		Если Реквизит.Имя = "ИмяОбъектаОписанияМетаданного" Или Реквизит.Имя = "ДатаОбновления" Тогда
			Продолжить;
		КонецЕсли;
		
		Колонки.Добавить(Новый ФиксированнаяСтруктура(Новый Структура("Имя, Тип, Заголовок", 
			Реквизит.Имя, Реквизит.Тип, Реквизит.Синоним)));
		
	КонецЦикла;
	
	Возврат Новый ФиксированныйМассив(Колонки);
	
КонецФункции

