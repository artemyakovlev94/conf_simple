Процедура ПриДобавленииОбработчиковОбновления(Обработчики) Экспорт
	
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия 				= "24.9.10.1";
	Обработчик.Процедура 			= "SUI_НастройкиМетаданныхСервер.ОтключениеТаблиц_24_9_10_1";
	Обработчик.РежимВыполнения 		= "Оперативно";
	Обработчик.Комментарий 			= НСтр("ru = 'Отключение неиспользуемых таблиц интеграций'");
	
КонецПроцедуры

Процедура ОтключениеТаблиц_24_9_10_1() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	НастройкиТаблицИнтеграции.ТаблицаИнтеграции,
		|	НастройкиТаблицИнтеграции.ИмяОбъектаКонфигурации
		|ИЗ
		|	РегистрСведений.SUI_НастройкиТаблицИнтеграции КАК НастройкиТаблицИнтеграции
		|ГДЕ
		|	НастройкиТаблицИнтеграции.ТаблицаИнтеграции В (&ОтключаемыеТаблицы)
		|ДЛЯ ИЗМЕНЕНИЯ
		|	РегистрСведений.SUI_НастройкиТаблицИнтеграции";
	
	Запрос.УстановитьПараметр("ОтключаемыеТаблицы", SUI_ОбщегоНазначенияКлиентСерверПереопределяемый.МассивЗначений(
		Перечисления.SUI_ТаблицыИнтеграции.СерииНоменклатуры,
		Перечисления.SUI_ТаблицыИнтеграции.ШтрихкодыУпаковок));
	
	НачатьТранзакцию();
	
	Попытка
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			НаборЗаписей = РегистрыСведений.SUI_НастройкиТаблицИнтеграции.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.ТаблицаИнтеграции.Установить(Выборка.ТаблицаИнтеграции);
			НаборЗаписей.Отбор.ИмяОбъектаКонфигурации.Установить(Выборка.ИмяОбъектаКонфигурации);
			НаборЗаписей.Записать(Истина);
			
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

