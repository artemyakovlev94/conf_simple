// Параметры записи настройки.
// 
// Возвращаемое значение:
//  Структура - Структура параметров записи настройки:
Функция ПараметрыЗаписиНастройки() Экспорт
	
	ПараметрыЗаписи = Новый Структура();
	
	ПараметрыЗаписи.Вставить("ТаблицаИнтеграции");
	ПараметрыЗаписи.Вставить("ПолноеИмяОбъекта");
	ПараметрыЗаписи.Вставить("ТаблицаОбъекта");
	ПараметрыЗаписи.Вставить("НастройкиКомпоновкиДанных", Новый НастройкиКомпоновкиДанных());
	ПараметрыЗаписи.Вставить("ДополнительныеНастройки", Новый Структура());
	ПараметрыЗаписи.Вставить("Используется");
	
	//@skip-check constructor-function-return-section
	Возврат ПараметрыЗаписи;
	
КонецФункции

// Записать настройку.
// 
// Параметры:
//  ПараметрыЗаписи - Структура - см. SUI_НастройкиМетаданныхСервер.ПараметрыЗаписиНастройки.
//@skip-check doc-comment-complex-type-with-link
Процедура ЗаписатьНастройку(ПараметрыЗаписи) Экспорт
	
	МенеджерЗаписи = РегистрыСведений.Удалить_SUI_НастройкиТаблицИнтеграции.СоздатьМенеджерЗаписи();
	
	ЗаполнитьЗначенияСвойств(МенеджерЗаписи, ПараметрыЗаписи, "ТаблицаИнтеграции, ПолноеИмяОбъекта, ТаблицаОбъекта");
	
	МенеджерЗаписи.НастройкиКомпоновкиДанных = Новый ХранилищеЗначения(ПараметрыЗаписи.НастройкиКомпоновкиДанных, Новый СжатиеДанных(9));
	МенеджерЗаписи.ДополнительныеНастройки = Новый ХранилищеЗначения(ПараметрыЗаписи.ДополнительныеНастройки, Новый СжатиеДанных(9));
	
	МенеджерЗаписи.Записать(Истина);
	
	Если ТипЗнч(ПараметрыЗаписи.Используется) = Тип("Булево") Тогда
		ОчиститьТаблицу = SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыЗаписи, "ОчиститьТаблицу", Истина, Тип("Булево"));
		УстановитьПризнакИспользованияТаблицы(ПараметрыЗаписи.ТаблицаИнтеграции, ПараметрыЗаписи.Используется, ОчиститьТаблицу);
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьРеквизитыВыбораИзНастройки(ТаблицаИнтеграции, ТаблицаИспользуется = Истина, ПоОсновномуОбъекту = Истина) Экспорт
	
	ПараметрыПолученияНастроек =  РегистрыСведений.SUI_НастройкиТаблицИнтеграции.ПараметрыПолученияНастроек(ТаблицаИнтеграции);
	ПараметрыПолученияНастроек.Используется = ТаблицаИспользуется;
	ПараметрыПолученияНастроек.ОсновнойОбъект = ПоОсновномуОбъекту;
	
	НастройкиТаблицы = РегистрыСведений.SUI_НастройкиТаблицИнтеграции.ПолучитьНастройки(ПараметрыПолученияНастроек);
	Если НастройкиТаблицы.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	НастройкиТаблицы = НастройкиТаблицы[0];
	
	РеквизитыВыбора = Новый Структура();
	
	РеквизитыВыбора.Вставить("ПолноеИмяОбъекта", НастройкиТаблицы[0].ИмяОбъекта);
	РеквизитыВыбора.Вставить("ТаблицаОбъекта", НастройкиТаблицы[0].ИмяТаблицы);
	РеквизитыВыбора.Вставить("Элементы", Новый Структура());
	
	ВыбранныеРеквизиты = РегистрыСведений.SUI_НастройкиТаблицИнтеграции.ПолучитьВыбранныеРеквизитыИзНастройки(НастройкиТаблицы[0]);
	
	РазрешенныеСимволыЗаголовка = SUI_СтроковыеФункцииКлиентСервер.АлфавитБуквыЛатинские()
		+ SUI_СтроковыеФункцииКлиентСервер.АлфавитБуквыРусские()
		+ SUI_СтроковыеФункцииКлиентСервер.АлфавитЦифры() + "_";
	
	Для Каждого ВыбранныйРеквизит Из ВыбранныеРеквизиты Цикл
		
		ЗаголовокПоля = SUI_СтроковыеФункцииКлиентСервер.ПривестиСтрокуКРазрешеннымСимволам(
			ВыбранныйРеквизит.Ключ, РазрешенныеСимволыЗаголовка);
		
		Если ЗначениеЗаполнено(ЗаголовокПоля) Тогда
			РеквизитыВыбора.Элементы.Вставить(ЗаголовокПоля, ВыбранныйРеквизит.Значение.Имя);
		КонецЕсли;
		
	КонецЦикла;
	
	Если РеквизитыВыбора.Элементы.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат РеквизитыВыбора;

КонецФункции

Функция ПолучитьПользовательскийЗапрос() Экспорт
	
	сткДанныеКонструктора = SUI_КонструкторЗапросаКлиентСервер.ДанныеКонструктора();

	УстановитьПривилегированныйРежим(Истина);
	ДанныеКонструктора = Константы.SUI_ПользовательскийЗапрос.Получить().Получить();
	УстановитьПривилегированныйРежим(Ложь);
	
	сткДанныеКонструктора.ТекстЗапроса = SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеКонструктора, 
		"ТекстЗапроса", "", Тип("Строка"));
	сткДанныеКонструктора.ВыполнятьВПакетномРежиме = SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеКонструктора, 
		"ВыполнятьВПакетномРежиме", Ложь, Тип("Булево"));
	сткДанныеКонструктора.ПакетыРезультата = SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеКонструктора, 
		"ПакетыРезультата", Новый Массив(), Тип("Массив"));
	
	Если Не ЗначениеЗаполнено(сткДанныеКонструктора.ТекстЗапроса) Тогда
		сткДанныеКонструктора.ВыполнятьВПакетномРежиме = Ложь;
	КонецЕсли;
	
	Если Не сткДанныеКонструктора.ВыполнятьВПакетномРежиме Тогда
		сткДанныеКонструктора.ПакетыРезультата = Новый Массив();
	КонецЕсли;
	
	сткДанныеКонструктора.ПакетыРезультата = ОбщегоНазначенияКлиентСервер.СвернутьМассив(сткДанныеКонструктора.ПакетыРезультата);
	
	Возврат Новый ФиксированнаяСтруктура(сткДанныеКонструктора);
	
КонецФункции

