
#Область ПрограммныйИнтерфейс

#Область ПодпискиНаСобытия

Процедура SUI_ИдентификаторыРегламентныхЗаданийПередЗаписью(Источник, Отказ) Экспорт

	Если Отказ Или Источник.ДополнительныеСвойства.Свойство("ЗаменаИдентификаторов") Тогда
		Возврат;
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.Проверить(Пользователи.ЭтоПолноправныйПользователь(),
		НСтр("ru = 'Недостаточно прав'"),
		"ИдентификаторыРегламентныхЗаданийПередЗаписью");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Таблица.Значение
		|ИЗ
		|	" + Источник.Метаданные().ПолноеИмя() + " КАК Таблица";
	
	УстановитьПривилегированныйРежим(Истина);
	Выборка = Запрос.Выполнить().Выбрать();
	УстановитьПривилегированныйРежим(Ложь);

	Выборка.Следующий();
	
	Если Выборка.Значение <> Источник.Значение Тогда

		ИсторияРЗ = Новый Структура();
		ИсторияРЗ.Вставить("Предыдущее", РегламентныеЗадания.НайтиПоУникальномуИдентификатору(Выборка.Значение));
		ИсторияРЗ.Вставить("Текущее", РегламентныеЗадания.НайтиПоУникальномуИдентификатору(Источник.Значение));
		
		Источник.ДополнительныеСвойства.Вставить("РегламентныеЗадания", ИсторияРЗ);
		
	КонецЕсли;

КонецПроцедуры

Процедура SUI_ИдентификаторыРегламентныхЗаданийПриЗаписи(Источник, Отказ) Экспорт
	
	Если Отказ Или Источник.ДополнительныеСвойства.Свойство("ЗаменаИдентификаторов") Тогда
		Возврат;
	КонецЕсли;

	ПредыдущееЗадание = SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Источник.ДополнительныеСвойства, 
		"РегламентныеЗадания.Предыдущее", Неопределено, Тип("РегламентноеЗадание"));
	ТекущееЗадание = SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Источник.ДополнительныеСвойства, 
		"РегламентныеЗадания.Текущее", Неопределено, Тип("РегламентноеЗадание"));

	Если РегламентноеЗаданиеЗаполнено(ПредыдущееЗадание) Тогда
		УдалитьРегламентноеЗадание(ПредыдущееЗадание);
	КонецЕсли;
	
	Если Источник.Значение <> ОбщегоНазначенияКлиентСервер.ПустойУникальныйИдентификатор() Тогда
		
		ОбщегоНазначенияКлиентСервер.Проверить(РегламентноеЗаданиеЗаполнено(ТекущееЗадание),
			СтрШаблон(НСтр("ru = 'По идентификатору %1 не найдено регламентное задание.'"), Источник.Значение), 
			"ИдентификаторыРегламентныхЗаданийПриЗаписи");
		
		ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Регламентное задание ""%1"" не является регламентным заданием %2'"), 
			ТекущееЗадание.Наименование, SUI_SimpleКлиентСервер.Представление());
		
		ОбщегоНазначенияКлиентСервер.Проверить(ЭтоРегламентноеЗаданиеSimple(ТекущееЗадание), 
			ТекстОшибки, "ИдентификаторыРегламентныхЗаданийПриЗаписи");

		ИдентификаторыЗаданий = ПолучитьИдентификаторыРегламентныхЗаданий(Истина);
		ЗаданияПоИдентификатору = ИдентификаторыЗаданий.НайтиСтроки(Новый Структура("Идентификатор", Источник.Значение));
		
		Для индекс = 0 По ЗаданияПоИдентификатору.ВГраница() Цикл
			
			МенеджерКонстанты = МенеджерКонстантыРегламентногоЗадания(ЗаданияПоИдентификатору[индекс].Ключ);
			Если МенеджерКонстанты <> Неопределено Тогда

				МенеджерЗначения = МенеджерКонстанты.СоздатьМенеджерЗначения();
				
				Если Источник.Метаданные() = МенеджерЗначения.Метаданные() Тогда
					Продолжить;
				КонецЕсли;
				
				МенеджерЗначения.Значение = ОбщегоНазначенияКлиентСервер.ПустойУникальныйИдентификатор();
				МенеджерЗначения.ДополнительныеСвойства.Вставить("ЗаменаИдентификаторов");
				МенеджерЗначения.Записать();
				
			КонецЕсли;

		КонецЦикла;

	КонецЕсли;

КонецПроцедуры

#КонецОбласти

Процедура ЗапуститьРегламентноеЗаданиеВручную(Параметры, АдресРезультата) Экспорт
	
	Результат = Новый Структура();
	Результат.Вставить("Запущено", Ложь);
	Результат.Вставить("Состояние", "Выполняется");
	Результат.Вставить("ОписаниеИнформацииОбОшибке", "");
	Результат.Вставить("ИдентификаторФоновогоЗадания");
	
	КлючРегламентногоЗадания = SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "КлючРегламентногоЗадания");
	ИгнорироватьОшибкиВыполнения = SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "ИгнорироватьОшибкиВыполнения", Ложь, Тип("Булево"));
	ИгнорироватьИспользование = SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "ИгнорироватьИспользование", Ложь, Тип("Булево"));
	
	ОбщегоНазначенияКлиентСервер.Проверить(Не КлючРегламентногоЗаданияПоПараметру(КлючРегламентногоЗадания).Пустая(),
		НСтр("ru = 'Не передан ключ для запуска регламентного задания.'"),
		"SUI_РегламентныеЗадания.ЗапуститьРегламентноеЗаданиеВручную");
	
	Если ТипЗнч(АдресРезультата) <> Тип("Строка") Или Не ЭтоАдресВременногоХранилища(АдресРезультата) Тогда
		АдресРезультата = Неопределено;
	КонецЕсли;
	
	#Если ВнешнееСоединение Тогда
		Если ОбщегоНазначения.ИнформационнаяБазаФайловая() Тогда
			ОбщегоНазначенияКлиентСервер.Проверить(ИгнорироватьОшибкиВыполнения,
				НСтр("ru = 'Во внешнем соединении файловой информационной базы данных невозможно запустить регламентное задание вручную'"),
				"SUI_РегламентныеЗадания.ЗапуститьРегламентноеЗаданиеВручную");
			Если АдресРезультата <> Неопределено Тогда
				ПоместитьВоВременноеХранилище(Результат, АдресРезультата);
			КонецЕсли;
			Возврат;
		КонецЕсли;
	#КонецЕсли
	
	УстановитьПривилегированныйРежим(Истина);
	
	Задание = РегламентноеЗаданиеПоКлючу(КлючРегламентногоЗадания);
	
	Если Задание = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.Проверить(ИгнорироватьОшибкиВыполнения,
			СтрШаблон(НСтр("ru = 'По ключу ""%1"" не найдено регламентное задание подсистемы %2.'"), КлючРегламентногоЗадания, SUI_SimpleКлиентСервер.Представление()));
		Если АдресРезультата <> Неопределено Тогда
			ПоместитьВоВременноеХранилище(Результат, АдресРезультата);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если Не Задание.Использование И Не ИгнорироватьИспользование Тогда
		ОбщегоНазначенияКлиентСервер.Проверить(ИгнорироватьОшибкиВыполнения,
			СтрШаблон(НСтр("ru = 'Регламентное задание %1 не используется.'"), КлючРегламентногоЗадания));
		Если АдресРезультата <> Неопределено Тогда
			ПоместитьВоВременноеХранилище(Результат, АдресРезультата);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	РезультатЗапуска = РегламентныеЗаданияСлужебный.ВыполнитьРегламентноеЗаданиеВручную(Задание);
	Если РезультатЗапуска.ЗапускВыполнен И ЗначениеЗаполнено(РезультатЗапуска.ИдентификаторФоновогоЗадания) Тогда
		СвойстваПоследнего = СвойстваПоследнегоФоновогоЗаданияПоОтбору(Новый Структура("Идентификатор", РезультатЗапуска.ИдентификаторФоновогоЗадания));
	Иначе
		СвойстваПоследнего = СвойстваПоследнегоФоновогоЗаданияВыполненияРегламентногоЗадания(Задание);
	КонецЕсли;
	
	Если СвойстваПоследнего <> Неопределено Тогда
		
		Результат.Запущено = Истина;
		Результат.ИдентификаторФоновогоЗадания = Новый УникальныйИдентификатор(СвойстваПоследнего.Идентификатор);
		
		Если СвойстваПоследнего.Состояние = СостояниеФоновогоЗадания.Завершено Тогда
			Результат.Состояние = "Выполнено";
		ИначеЕсли СвойстваПоследнего.Состояние = СостояниеФоновогоЗадания.ЗавершеноАварийно Тогда
			Результат.Состояние = "Ошибка";
		ИначеЕсли СвойстваПоследнего.Состояние = СостояниеФоновогоЗадания.Отменено Тогда
			Результат.Состояние = "Отменено";
		КонецЕсли;
		
		Результат.ОписаниеИнформацииОбОшибке = СвойстваПоследнего.ОписаниеИнформацииОбОшибке;
		
	КонецЕсли;
	
	Если АдресРезультата <> Неопределено Тогда
		ПоместитьВоВременноеХранилище(Результат, АдресРезультата);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПолучитьРезультатВыполненияФоновогоЗаданияРегламентногоЗадания(Параметры, АдресРезультата) Экспорт
	
	Результат = Новый Структура();
	Результат.Вставить("Состояние");
	Результат.Вставить("ОписаниеИнформацииОбОшибке", "");
	Результат.Вставить("ИдентификаторФоновогоЗадания");
	
	КлючРегламентногоЗадания = SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "КлючРегламентногоЗадания");
	ИгнорироватьОшибкиВыполнения = SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "ИгнорироватьОшибкиВыполнения", Ложь, Тип("Булево"));
	ИдентификаторФоновогоЗадания = SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "ИдентификаторФоновогоЗадания");
	
	Если ТипЗнч(ИдентификаторФоновогоЗадания) <> Тип("УникальныйИдентификатор") Тогда
		
		ИдентификаторФоновогоЗадания = ОбщегоНазначения.ОписаниеТипаСтрока(36).ПривестиЗначение(ИдентификаторФоновогоЗадания);
		Если СтроковыеФункцииКлиентСервер.ЭтоУникальныйИдентификатор(ИдентификаторФоновогоЗадания) Тогда
			ИдентификаторФоновогоЗадания = Новый УникальныйИдентификатор(ИдентификаторФоновогоЗадания);
		Иначе
			ИдентификаторФоновогоЗадания = ОбщегоНазначенияКлиентСервер.ПустойУникальныйИдентификатор();
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТипЗнч(АдресРезультата) <> Тип("Строка") Или Не ЭтоАдресВременногоХранилища(АдресРезультата) Тогда
		АдресРезультата = Неопределено;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если Параметры.Свойство("Таймаут") Тогда
		Таймаут = ОбщегоНазначения.ОписаниеТипаЧисло(2, , ДопустимыйЗнак.Неотрицательный).ПривестиЗначение(Параметры.Таймаут);
		Таймаут = ?(Таймаут > 30, 30, Таймаут);
	Иначе
		Таймаут = ?(ПолучитьСкоростьКлиентскогоСоединения() = СкоростьКлиентскогоСоединения.Низкая, 4, 2);
	КонецЕсли;
	
	SUI_ОбщегоНазначения.Пауза(Таймаут);
	
	Если ЗначениеЗаполнено(ИдентификаторФоновогоЗадания) Тогда
		СвойстваПоследнего = СвойстваПоследнегоФоновогоЗаданияПоОтбору(Новый Структура("Идентификатор", Строка(ИдентификаторФоновогоЗадания)));
	Иначе
		
		Задание = РегламентноеЗаданиеПоКлючу(КлючРегламентногоЗадания);
		
		Если Задание = Неопределено Тогда
			ОбщегоНазначенияКлиентСервер.Проверить(ИгнорироватьОшибкиВыполнения,
				СтрШаблон(НСтр("ru = 'По ключу ""%1"" не найдено регламентное задание подсистемы %2.'"), КлючРегламентногоЗадания, SUI_SimpleКлиентСервер.Представление()));
			Если АдресРезультата <> Неопределено Тогда
				ПоместитьВоВременноеХранилище(Результат, АдресРезультата);
			КонецЕсли;
			Возврат;
		КонецЕсли;
		
		СвойстваПоследнего = СвойстваПоследнегоФоновогоЗаданияВыполненияРегламентногоЗадания(Задание);
		
	КонецЕсли;
	
	Если СвойстваПоследнего <> Неопределено Тогда
		
		Результат.ИдентификаторФоновогоЗадания = Новый УникальныйИдентификатор(СвойстваПоследнего.Идентификатор);
		
		Если СвойстваПоследнего.Состояние = СостояниеФоновогоЗадания.Завершено Тогда
			Результат.Состояние = "Выполнено";
		ИначеЕсли СвойстваПоследнего.Состояние = СостояниеФоновогоЗадания.Активно Тогда
			Результат.Состояние = "Выполняется";
		ИначеЕсли СвойстваПоследнего.Состояние = СостояниеФоновогоЗадания.ЗавершеноАварийно Тогда
			Результат.Состояние = "Ошибка";
		ИначеЕсли СвойстваПоследнего.Состояние = СостояниеФоновогоЗадания.Отменено Тогда
			Результат.Состояние = "Отменено";
		КонецЕсли;
		
		Результат.ОписаниеИнформацииОбОшибке = СвойстваПоследнего.ОписаниеИнформацииОбОшибке;
		
	КонецЕсли;
	
	Если АдресРезультата <> Неопределено Тогда
		ПоместитьВоВременноеХранилище(Результат, АдресРезультата);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОстановитьРегламентноеЗадание(Параметры, АдресРезультата) Экспорт
	
	КлючРегламентногоЗадания = КлючРегламентногоЗаданияПоПараметру(SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "КлючРегламентногоЗадания"));
	ИгнорироватьОшибкиВыполнения = SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "ИгнорироватьОшибкиВыполнения", Ложь, Тип("Булево"));
	ИдентификаторФоновогоЗадания = SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "ИдентификаторФоновогоЗадания");
	
	Если ТипЗнч(ИдентификаторФоновогоЗадания) <> Тип("УникальныйИдентификатор") Тогда
		
		ИдентификаторФоновогоЗадания = ОбщегоНазначения.ОписаниеТипаСтрока(36).ПривестиЗначение(ИдентификаторФоновогоЗадания);
		Если СтроковыеФункцииКлиентСервер.ЭтоУникальныйИдентификатор(ИдентификаторФоновогоЗадания) Тогда
			ИдентификаторФоновогоЗадания = Новый УникальныйИдентификатор(ИдентификаторФоновогоЗадания);
		Иначе
			ИдентификаторФоновогоЗадания = ОбщегоНазначенияКлиентСервер.ПустойУникальныйИдентификатор();
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТипЗнч(АдресРезультата) <> Тип("Строка") Или Не ЭтоАдресВременногоХранилища(АдресРезультата) Тогда
		АдресРезультата = Неопределено;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если Не ЗначениеЗаполнено(ИдентификаторФоновогоЗадания) Тогда
		
		Если КлючРегламентногоЗадания.Пустая() Тогда
			ОбщегоНазначенияКлиентСервер.Проверить(ИгнорироватьОшибкиВыполнения,
				НСтр("ru = 'Ошибка остановки регламентного задания.
				|Не передан ключ для остановки регламентного задания.'"));
		Иначе
			
			Задание = РегламентноеЗаданиеПоКлючу(КлючРегламентногоЗадания);
		
			Если Задание = Неопределено Тогда
				ОбщегоНазначенияКлиентСервер.Проверить(ИгнорироватьОшибкиВыполнения,
					СтрШаблон(НСтр("ru = 'Ошибка остановки регламентного задания.
					|По ключу ""%1"" не найдено регламентное задание подсистемы %2.'"), 
					КлючРегламентногоЗадания, SUI_SimpleКлиентСервер.Представление()));
			Иначе
				СвойстваПоследнего = СвойстваПоследнегоФоновогоЗаданияВыполненияРегламентногоЗадания(Задание);
				Если СвойстваПоследнего <> Неопределено Тогда
					ИдентификаторФоновогоЗадания = СвойстваПоследнего.Идентификатор;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИдентификаторФоновогоЗадания) Тогда
		ДлительныеОперации.ОтменитьВыполнениеЗадания(ИдентификаторФоновогоЗадания);
	КонецЕсли;
	
	Если АдресРезультата <> Неопределено Тогда
		ПоместитьВоВременноеХранилище(Истина, АдресРезультата);
	КонецЕсли;
	
КонецПроцедуры

Процедура ИспользованиеРегламентногоЗадания(КлючРегламентногоЗадания, Значение) Экспорт
	
	Если Не Пользователи.ЭтоПолноправныйПользователь() Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	РегламентноеЗадание = РегламентноеЗаданиеПоКлючу(КлючРегламентногоЗадания);
	
	Если РегламентноеЗадание <> Неопределено Тогда

			РегламентноеЗадание.Использование = Значение;
			РегламентноеЗадание.Записать();
			
			СообщениеЖурнала = СтрШаблон(НСтр("ru = 'Регламентное задание ""%1"": %2'"), 
				КлючРегламентногоЗадания, Формат(РегламентноеЗадание.Использование, "БЛ=Выключено; БИ=Включено;"));
			ЗаписатьПримечание(КлючРегламентногоЗадания, СообщениеЖурнала);
		
	Иначе
		
		ТекстСообщения = СтрШаблон(НСтр("ru = 'По ключу ""%1"" не найдено регламентное задание подсистемы %2.'"), 
			КлючРегламентногоЗадания, SUI_SimpleКлиентСервер.Представление());
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);

	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьИнформациюОРегламентныхЗаданиях(КлючРегламентногоЗадания = Неопределено, АдресРезультата = Неопределено) Экспорт
	
	ОбщегоНазначенияКлиентСервер.Проверить(Пользователи.ЭтоПолноправныйПользователь(),
		НСтр("ru = 'Недостаточно прав для получения информации о регламентных заданиях'"));
	
	УстановитьПривилегированныйРежим(Истина);
	
	Таблица = ПолучитьИдентификаторыРегламентныхЗаданий();
	
	Таблица.Колонки.Добавить("Использование", Новый ОписаниеТипов("Булево"));
	Таблица.Колонки.Добавить("Наименование", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Начало", ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.ДатаВремя));
	Таблица.Колонки.Добавить("Конец", ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.ДатаВремя));
	Таблица.Колонки.Добавить("Состояние", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Расписание", Новый ОписаниеТипов("РасписаниеРегламентногоЗадания"));
	Таблица.Колонки.Добавить("Пользователь", Новый ОписаниеТипов("СправочникСсылка.Пользователи"));
	Таблица.Колонки.Добавить("ОписаниеИнформацииОбОшибке", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Существует", Новый ОписаниеТипов("Булево"));

	Если Не КлючРегламентногоЗаданияПоПараметру(КлючРегламентногоЗадания).Пустая() Тогда
		
		Построитель = Новый ПостроительЗапроса();
		Построитель.ИсточникДанных = Новый ОписаниеИсточникаДанных(Таблица);
		
		Отбор = Построитель.Отбор.Добавить("Ключ");
		Отбор.ВидСравнения = ВидСравнения.Равно;
		Отбор.Значение = КлючРегламентногоЗадания;
		Отбор.Использование = Истина;
		
		Построитель.Выполнить();
		Таблица = Построитель.Результат.Выгрузить();
		
	КонецЕсли;

	Для Каждого СтрокаТаблицы Из Таблица Цикл
		
		РегламентноеЗадание = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(СтрокаТаблицы.Идентификатор);
		
		Если Не РегламентноеЗаданиеЗаполнено(РегламентноеЗадание) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаТаблицы.Использование = РегламентноеЗадание.Использование;
		СтрокаТаблицы.Наименование = РегламентноеЗадание.Наименование;
		СтрокаТаблицы.Расписание = РегламентноеЗадание.Расписание;
		СтрокаТаблицы.Пользователь = Пользователи.НайтиПоИмени(РегламентноеЗадание.ИмяПользователя);
		СтрокаТаблицы.Существует = Истина;
		
		СвойстваПоследнего = СвойстваПоследнегоФоновогоЗаданияВыполненияРегламентногоЗадания(РегламентноеЗадание);
		Если СвойстваПоследнего <> Неопределено Тогда
			
			СтрокаТаблицы.Начало = СвойстваПоследнего.Начало;
			СтрокаТаблицы.Конец = СвойстваПоследнего.Конец;
			СтрокаТаблицы.ОписаниеИнформацииОбОшибке = СвойстваПоследнего.ОписаниеИнформацииОбОшибке;
			
			Если СвойстваПоследнего.Состояние = СостояниеФоновогоЗадания.Активно Тогда
				СтрокаТаблицы.Состояние = НСтр("ru = 'Выполняется'");
			ИначеЕсли СвойстваПоследнего.Состояние = СостояниеФоновогоЗадания.Завершено Тогда
				СтрокаТаблицы.Состояние = НСтр("ru = 'Выполнено'");
			ИначеЕсли СвойстваПоследнего.Состояние = СостояниеФоновогоЗадания.ЗавершеноАварийно Тогда
				СтрокаТаблицы.Состояние = НСтр("ru = 'Ошибка выполнения'");
			ИначеЕсли СвойстваПоследнего.Состояние = СостояниеФоновогоЗадания.Отменено Тогда
				СтрокаТаблицы.Состояние = НСтр("ru = 'Отменено'");
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;

	Если АдресРезультата <> Неопределено И ЭтоАдресВременногоХранилища(АдресРезультата) Тогда
		ПоместитьВоВременноеХранилище(Таблица, АдресРезультата);
	КонецЕсли;
	
	Возврат Таблица;
	
КонецФункции

// Создать регламентное задание по ключу.
// 
// Параметры:
//  КлючРегламентногоЗадания - ПеречислениеСсылка.SUI_КлючиРегламентыхЗаданий - Ключ регламентного задания
//  Использование - Булево - Признак использования регламентного задания
// 
// Возвращаемое значение:
//  УникальныйИдентификатор - Уникальный идентификатор регламентного задания
Функция СоздатьРегламентноеЗаданиеПоКлючу(КлючРегламентногоЗадания, Использование = Истина) Экспорт
	
	ИдентификаторЗадания = ОбщегоНазначенияКлиентСервер.ПустойУникальныйИдентификатор();
	
	Если КлючРегламентногоЗадания = Перечисления.SUI_КлючиРегламентыхЗаданий.ОбработкаОчередиЗаданий Тогда
		ИдентификаторЗадания = СоздатьРегламентноеЗадание_ОбработкаОчередиЗаданий(Использование);
	ИначеЕсли КлючРегламентногоЗадания = Перечисления.SUI_КлючиРегламентыхЗаданий.ОчисткаОчередиЗаданий Тогда
		ИдентификаторЗадания = СоздатьРегламентноеЗадание_ОчисткаОчередиЗаданий(Использование);
	ИначеЕсли КлючРегламентногоЗадания = Перечисления.SUI_КлючиРегламентыхЗаданий.ОчисткаЛогированияHTTPЗапросов Тогда
		ИдентификаторЗадания = СоздатьРегламентноеЗадание_ОчисткаЛогированияHTTPЗапросов(Использование);
	ИначеЕсли КлючРегламентногоЗадания = Перечисления.SUI_КлючиРегламентыхЗаданий.ОчисткаОбработанныхДокументов Тогда
		ИдентификаторЗадания = СоздатьРегламентноеЗадание_ОчисткаОбработанныхДокументов(Использование);
	ИначеЕсли КлючРегламентногоЗадания = Перечисления.SUI_КлючиРегламентыхЗаданий.ОчисткаСообщенийМобильныхУстройств Тогда
		ИдентификаторЗадания = СоздатьРегламентноеЗадание_ОчисткаСообщенийМобильныхУстройств(Использование);
	ИначеЕсли КлючРегламентногоЗадания = Перечисления.SUI_КлючиРегламентыхЗаданий.ОбработкаСообщенийОбменаДанными Тогда
		ИдентификаторЗадания = СоздатьРегламентноеЗадание_ОбработкаСообщенийОбменаДанными(Использование);
	ИначеЕсли КлючРегламентногоЗадания = Перечисления.SUI_КлючиРегламентыхЗаданий.СверткаСообщенийОбменаДанными Тогда
		ИдентификаторЗадания = СоздатьРегламентноеЗадание_СверткаСообщенийОбменаДанными(Использование);
	КонецЕсли;
	
	Если ИдентификаторЗадания <> ОбщегоНазначенияКлиентСервер.ПустойУникальныйИдентификатор() Тогда
		СообщениеЖурнала = СтрШаблон(НСтр("ru = 'Регламентное задание ""%1"": Создано'"), КлючРегламентногоЗадания);
		ЗаписатьИнформацию(КлючРегламентногоЗадания, СообщениеЖурнала);
	КонецЕсли;
	
	Возврат ИдентификаторЗадания;
	
КонецФункции

// Обновить регламентное задание по ключу.
// 
// Параметры:
//  КлючРегламентногоЗадания - ПеречислениеСсылка.SUI_КлючиРегламентыхЗаданий - Ключ регламентного задания
//  ИзмененныеДанные - Структура:
//  	* Использование 	- Булево - Признак использования регламентного задания
//  	* Наименование 		- Строка - Наименование регламентного задания
//  	* Расписание 		- РасписаниеРегламентногоЗадания - Расписание регламентного задания
//  	* ИмяПользователя 	- Строка - Имя пользователя БД под которым следует выполнять РЗ
//  	* Пользователь 		- СправочникСсылка.Пользователи - Пользователь под которым следует выполнять РЗ
// 
// Возвращаемое значение:
//  УникальныйИдентификатор - Уникальный идентификатор регламентного задания
Функция ОбновитьРегламентноеЗаданиеПоКлючу(КлючРегламентногоЗадания, ИзмененныеДанные) Экспорт
	
	ОбщегоНазначенияКлиентСервер.Проверить(Пользователи.ЭтоПолноправныйПользователь(), 
		НСтр("ru = 'Операция обновления не выполнена по причине:
		|Недостаточно прав'"), 
		"SUI_РегламентныеЗадания.ОбновитьРегламентноеЗаданиеПоКлючу");
		
	ОбщегоНазначенияКлиентСервер.Проверить(Не КлючРегламентногоЗаданияПоПараметру(КлючРегламентногоЗадания).Пустая(), 
		НСтр("ru = 'Операция обновления не выполнена по причине:
		|Не удалось определить ключ регламентного задания'"), 
		"SUI_РегламентныеЗадания.ОбновитьРегламентноеЗаданиеПоКлючу");

	РегламентноеЗадание = РегламентноеЗаданиеПоКлючу(КлючРегламентногоЗадания);
	
	ОбщегоНазначенияКлиентСервер.Проверить(РегламентноеЗаданиеЗаполнено(РегламентноеЗадание), 
		СтрШаблон(НСтр("ru = 'Операция обновления не выполнена по причине:
		|Не найдено регламентное задание подсистемы %1.'"), SUI_SimpleКлиентСервер.Представление()), 
		"SUI_РегламентныеЗадания.ОбновитьРегламентноеЗаданиеПоКлючу");
	
	ДанныеИзменены = Ложь;
	
	Если ИзмененныеДанные.Свойство("Использование") Тогда
		РегламентноеЗадание.Использование = ИзмененныеДанные.Использование;
		ДанныеИзменены = Истина;
	КонецЕсли;
	
	Если ИзмененныеДанные.Свойство("Наименование") Тогда
		РегламентноеЗадание.Наименование = ИзмененныеДанные.Наименование;
		ДанныеИзменены = Истина;
	КонецЕсли;
	
	Если ИзмененныеДанные.Свойство("Расписание") Тогда
		РегламентноеЗадание.Расписание = ИзмененныеДанные.Расписание;
		ДанныеИзменены = Истина;
	КонецЕсли;
	
	Если ИзмененныеДанные.Свойство("ИмяПользователя") Тогда
		РегламентноеЗадание.ИмяПользователя = ИзмененныеДанные.ИмяПользователя;
		ДанныеИзменены = Истина;
	КонецЕсли;
	
	Если ИзмененныеДанные.Свойство("Пользователь") Тогда
		
		ПользовательИБ = SUI_ПользователиПереопределяемый.НайтиПоСсылке(ИзмененныеДанные.Пользователь);
		Если ПользовательИБ <> Неопределено Тогда
			РегламентноеЗадание.ИмяПользователя = ПользовательИБ.Имя;
			ДанныеИзменены = Истина;
		КонецЕсли;

	КонецЕсли;
	
	Если ДанныеИзменены Тогда
		РегламентноеЗадание.Записать();
	КонецЕсли;
	
	Возврат РегламентноеЗадание.УникальныйИдентификатор;
	
КонецФункции

// Удалить регламентное задание.
// 
// Параметры:
//  РегламентноеЗадание - РегламентноеЗадание, ПеречислениеСсылка.SUI_КлючиРегламентыхЗаданий - Регламентное задание или ПеречислениеСсылка Ключ регламентного задания
Процедура УдалитьРегламентноеЗадание(Знач РегламентноеЗадание) Экспорт
	
	ОбщегоНазначенияКлиентСервер.Проверить(Пользователи.ЭтоПолноправныйПользователь(), 
		НСтр("ru = 'Недостаточно прав'"), 
		"SUI_РегламентныеЗадания.УдалитьРегламентноеЗадание");

	НаименованиеДляЖурнала = "";

	Если ТипЗнч(РегламентноеЗадание) = Тип("РегламентноеЗадание") Тогда
		
		Если ЭтоРегламентноеЗаданиеSimple(РегламентноеЗадание) Тогда
			НаименованиеДляЖурнала = РегламентноеЗадание.Наименование;
		Иначе
			РегламентноеЗадание = Неопределено;
		КонецЕсли;
		
	Иначе
		
		РегламентноеЗадание = КлючРегламентногоЗаданияПоПараметру(РегламентноеЗадание);
		
		Если РегламентноеЗадание.Пустая() Тогда
			РегламентноеЗадание = Неопределено;
		Иначе
			НаименованиеДляЖурнала = Строка(РегламентноеЗадание);
			РегламентноеЗадание = РегламентноеЗаданиеПоКлючу(РегламентноеЗадание);
		КонецЕсли;
		
	
	КонецЕсли;
	
	Если РегламентноеЗаданиеЗаполнено(РегламентноеЗадание) Тогда
		
		РегламентноеЗадание.Удалить();
		
		Если Не ПустаяСтрока(НаименованиеДляЖурнала) Тогда
			СообщениеЖурнала = СтрШаблон(НСтр("ru = 'Регламентное задание ""%1"": Удалено'"), НаименованиеДляЖурнала);
			ЗаписатьИнформацию(Неопределено, СообщениеЖурнала);
		КонецЕсли;
		
	Иначе
		ТекстСообщения = СтрШаблон(НСтр("ru = 'Операция удаления не выполнена по причине:
		|Не найдено регламентное задание подсистемы %1.'"), SUI_SimpleКлиентСервер.Представление());
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Выполнить регламентное задание.
// 
// Параметры:
//  КлючРегламентногоЗадания - ПеречислениеСсылка.SUI_КлючиРегламентыхЗаданий - Ключ регламентного задания
//  ИмяМетода - Строка - Имя метода
Процедура ВыполнитьРегламентноеЗадание(КлючРегламентногоЗадания, ИмяМетода) Экспорт
	
	Если КлючРегламентногоЗаданияПоПараметру(КлючРегламентногоЗадания).Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	ТекущееФоновоеЗадание = ПолучитьТекущийСеансИнформационнойБазы().ПолучитьФоновоеЗадание();
	
	ОбщегоНазначенияКлиентСервер.Проверить(
		ТекущееФоновоеЗадание <> Неопределено,
		НСтр("ru = 'Метод предназначен только для выполнения из фонового задания'"),
		"SUI_РегламентныеЗадания.ВыполнитьРегламентноеЗадание");
	
	Если ТекущееФоновоеЗадание.РегламентноеЗадание = Неопределено Тогда
		
		ТекущееЗадание = РегламентноеЗаданиеПоКлючу(КлючРегламентногоЗадания);
		
		ОбщегоНазначенияКлиентСервер.Проверить(
			ТекущееЗадание <> Неопределено И Строка(ТекущееЗадание.УникальныйИдентификатор) = ТекущееФоновоеЗадание.Ключ,
			НСтр("ru = 'Метод предназначен только для выполнения из фонового задания регламентного задания'"),
			"SUI_РегламентныеЗадания.ВыполнитьРегламентноеЗадание");
	
	Иначе
		
		Отбор = Новый Структура();
		Отбор.Вставить("Ключ", Строка(ТекущееФоновоеЗадание.РегламентноеЗадание.УникальныйИдентификатор));
		Отбор.Вставить("Состояние", СостояниеФоновогоЗадания.Активно);
		Если СвойстваФоновыхЗаданий(Отбор).Количество() > 0 Тогда
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	ЗаписатьИнформацию(КлючРегламентногоЗадания, СтрШаблон(НСтр("ru = 'Регламентное задание %1: Запуск'"), КлючРегламентногоЗадания));
	
	ОбщегоНазначения.ВыполнитьМетодКонфигурации(ИмяМетода);

	ЗаписатьИнформацию(КлючРегламентногоЗадания, СтрШаблон(НСтр("ru = 'Регламентное задание %1: Завершение'"), КлючРегламентногоЗадания));
	
КонецПроцедуры

Процедура ПриДобавленииОбработчиковОбновления(Обработчики) Экспорт
	
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия 				= "1.0.0.3";
