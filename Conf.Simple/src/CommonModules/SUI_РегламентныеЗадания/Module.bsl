Процедура ИнициализироватьПредопределенныеРегламентныеЗадания_Переход_1_0_0_3() Экспорт
	
	Если Не Пользователи.ЭтоПолноправныйПользователь() Тогда
		Возврат;
	КонецЕсли;
	
	МетаданныеОбъекта = Метаданные.Справочники.Найти("SUI_РегламентныеЗадания");
	Если МетаданныеОбъекта = Неопределено Тогда
		МетаданныеОбъекта = Метаданные.Справочники.Найти("Удалить_SUI_РегламентныеЗадания");
	КонецЕсли;
	
	Если МетаданныеОбъекта = Неопределено Тогда
		Возврат;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ТаблицаСправочника.Ссылка,
		|	ТаблицаСправочника.ИдентификаторРегламентногоЗадания,
		|	ТаблицаСправочника.Вид
		|ИЗ
		|	" + МетаданныеОбъекта.ПолноеИмя() + " КАК ТаблицаСправочника";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	ВсегоЗаписей = Выборка.Количество();
	СчетчикПрогресса = 0;
	ТекущийСчетчик = 1;
	
	ТекущийКлюч = Перечисления.SUI_КлючиРегламентыхЗаданий.ПустаяСсылка();
	
	НачатьТранзакцию();
		
	Попытка
		
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить(МетаданныеОбъекта.ПолноеИмя());
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.ИсточникДанных = РезультатЗапроса;
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Ссылка", "Ссылка");
		Блокировка.Заблокировать();
			
		Пока Выборка.Следующий() Цикл

			ТекущийКлюч = Выборка.Вид;
			
			Если Выборка.ИдентификаторРегламентногоЗадания <> ОбщегоНазначенияКлиентСервер.ПустойУникальныйИдентификатор() Тогда
				
				РегламентноеЗадание = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(Выборка.ИдентификаторРегламентногоЗадания);
				Если РегламентноеЗаданиеЗаполнено(РегламентноеЗадание) И ЭтоРегламентноеЗаданиеSimple(РегламентноеЗадание) Тогда
					РегламентноеЗадание.Удалить();
				КонецЕсли;
				
			КонецЕсли;
			
			Если ОбщегоНазначения.СсылкаСуществует(Выборка.Ссылка) Тогда
				
				ОбъектСправочникаРЗ = Выборка.Ссылка.ПолучитьОбъект();
				ОбъектСправочникаРЗ.Удалить();
				
			КонецЕсли;

			SUI_ОбновлениеSimple.СообщениеПрогессаВыполненияОбработчика(ВсегоЗаписей, СчетчикПрогресса, ТекущийСчетчик);
			ТекущийСчетчик = ТекущийСчетчик+1;
			
		КонецЦикла;
	
		ЗафиксироватьТранзакцию();
			
	Исключение
		ОтменитьТранзакцию();
		ЗаписатьОшибку(ТекущийКлюч, ИнформацияОбОшибке());
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура ИнициализироватьПредопределенныеРегламентныеЗадания_1_0_0_3() Экспорт
	
	Если Не Пользователи.ЭтоПолноправныйПользователь() Тогда
		Возврат;
	КонецЕсли;
	
	ТекущийКлюч = Перечисления.SUI_КлючиРегламентыхЗаданий.ПустаяСсылка();
	
	Попытка
		
		УстановитьПривилегированныйРежим(Истина);
		
		ИдентификаторыРегламентныхЗаданий = ПолучитьИдентификаторыРегламентныхЗаданий();
		ЗаполнитьРегламентныеЗаданияВТаблицеИдентификаторов(ИдентификаторыРегламентныхЗаданий);
		
		ВсегоЗаписей = ИдентификаторыРегламентныхЗаданий.Количество();
		СчетчикПрогресса = 0;
		ТекущийСчетчик = 1;
		
		Для Каждого СтрокаТаблицы Из ИдентификаторыРегламентныхЗаданий Цикл
			
			ТекущийКлюч = СтрокаТаблицы.Ключ;
			
			Если РегламентноеЗаданиеЗаполнено(СтрокаТаблицы.РегламентноеЗадание) И
				ЭтоРегламентноеЗаданиеSimple(СтрокаТаблицы.РегламентноеЗадание) Тогда
				Продолжить;
			КонецЕсли;

			Если ТекущийКлюч = Перечисления.SUI_КлючиРегламентыхЗаданий.ОчисткаЛогированияHTTPЗапросов Тогда
				Использование = ПолучитьФункциональнуюОпцию("SUI_ЛогированиеHTTPЗапросов");
			Иначе
				Использование = Истина;
			КонецЕсли;
			
			СоздатьРегламентноеЗаданиеПоКлючу(ТекущийКлюч, Использование);
			
			SUI_ОбновлениеSimple.СообщениеПрогессаВыполненияОбработчика(ВсегоЗаписей, СчетчикПрогресса, ТекущийСчетчик);
			ТекущийСчетчик = ТекущийСчетчик+1;
			
		КонецЦикла;
		
	Исключение
		ЗаписатьОшибку(ТекущийКлюч, ИнформацияОбОшибке());
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура ИнициализироватьПредопределенныеРегламентныеЗадания_1_0_1_4() Экспорт
	
	Если Не Пользователи.ЭтоПолноправныйПользователь() Тогда
		Возврат;
	КонецЕсли;
	
	ТекущийКлюч = Перечисления.SUI_КлючиРегламентыхЗаданий.ОчисткаОбработанныхДокументов;
	
	Попытка
		
		УстановитьПривилегированныйРежим(Истина);
		
		ИдентификаторыРегламентныхЗаданий = ПолучитьИдентификаторыРегламентныхЗаданий();
		ЗаполнитьРегламентныеЗаданияВТаблицеИдентификаторов(ИдентификаторыРегламентныхЗаданий);
		
		СтрокаТаблицы = ИдентификаторыРегламентныхЗаданий.Найти(ТекущийКлюч, "Ключ");
		
		Если СтрокаТаблицы = Неопределено Или
			Не РегламентноеЗаданиеЗаполнено(СтрокаТаблицы.РегламентноеЗадание) Или
			Не ЭтоРегламентноеЗаданиеSimple(СтрокаТаблицы.РегламентноеЗадание) Тогда
			СоздатьРегламентноеЗаданиеПоКлючу(ТекущийКлюч, Истина);
		КонецЕсли;

	Исключение
		ЗаписатьОшибку(ТекущийКлюч, ИнформацияОбОшибке());
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура ИнициализироватьПредопределенныеРегламентныеЗадания_1_0_2_1() Экспорт
	
	Если Не Пользователи.ЭтоПолноправныйПользователь() Тогда
		Возврат;
	КонецЕсли;
	
	НовыеРегламентныеЗадания = SUI_ОбщегоНазначенияКлиентСерверПереопределяемый.МассивЗначений(
		Перечисления.SUI_КлючиРегламентыхЗаданий.ОбработкаСообщенийОбменаДанными,
		Перечисления.SUI_КлючиРегламентыхЗаданий.СверткаСообщенийОбменаДанными);
	
	УстановитьПривилегированныйРежим(Истина);
	
	ИдентификаторыРегламентныхЗаданий = ПолучитьИдентификаторыРегламентныхЗаданий();
	ЗаполнитьРегламентныеЗаданияВТаблицеИдентификаторов(ИдентификаторыРегламентныхЗаданий);
	
	Для индекс = 0 По НовыеРегламентныеЗадания.ВГраница() Цикл
		
		Попытка
			
			СтрокаТаблицы = ИдентификаторыРегламентныхЗаданий.Найти(НовыеРегламентныеЗадания[индекс], "Ключ");
			
			Если СтрокаТаблицы = Неопределено Или
				Не РегламентноеЗаданиеЗаполнено(СтрокаТаблицы.РегламентноеЗадание) Или
				Не ЭтоРегламентноеЗаданиеSimple(СтрокаТаблицы.РегламентноеЗадание) Тогда
				СоздатьРегламентноеЗаданиеПоКлючу(НовыеРегламентныеЗадания[индекс], Истина);
			КонецЕсли;
			
		Исключение
			ЗаписатьОшибку(НовыеРегламентныеЗадания[индекс], ИнформацияОбОшибке());
			ВызватьИсключение;
		КонецПопытки;
		
	КонецЦикла;
	
	// Удалить РЗ ФормированиеСлужебныхДанных
	Если Метаданные.Константы.Найти("Удалить_SUI_РЗ_ФормированиеСлужебныхПакетов") <> Неопределено Тогда
		
		ИдентификаторРЗ = Константы.Удалить_SUI_РЗ_ФормированиеСлужебныхПакетов.Получить();
		Если ЗначениеЗаполнено(ИдентификаторРЗ) Тогда
			УдалитьРегламентноеЗадание(РегламентныеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторРЗ));
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

