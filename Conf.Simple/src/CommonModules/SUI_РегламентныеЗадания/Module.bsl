#Область СозданиеРегламентныхЗаданий

// Параметры создания регламентного задания.
// 
// Параметры:
//  КлючРегламентногоЗадания - ПеречислениеСсылка.SUI_КлючиРегламентыхЗаданий - Ключ регламентного задания
//  Параметры - Неопределено, Массив - Параметры регламентного задания
//  Расписание - Неопределено, РасписаниеРегламентногоЗадания - Расписание регламетного задания
// 
// Возвращаемое значение:
//  Структура - Параметры создания регламентного задания:
// * Метаданные - ОбъектМетаданныхРегламентноеЗадание - Метаданные регламетного задания
// * Наименование - Строка - Наименование регламентного задания
// * Параметры - Массив - Параметры регламентного задания
// * Использование - Булево - Признак использования регламентного задания
// * Расписание - РасписаниеРегламентногоЗадания - Расписание регламетного задания
// * ИмяПользователя - Строка - Имя пользователя от которого будет выполнятся запуск регламетного задания
// * КоличествоПовторовПриАварийномЗавершении - Число -
// * ИнтервалПовтораПриАварийномЗавершении - Число -
Функция ПараметрыСозданияРегламентногоЗадания(КлючРегламентногоЗадания, Параметры = Неопределено, Расписание = Неопределено)
	
	ПараметрыСоздания = Новый Структура();
	
	ОписаниеТипаМассив = Новый ОписаниеТипов("Массив");
	ОписаниеТипаРасписание = Новый ОписаниеТипов("РасписаниеРегламентногоЗадания");
	
	ПараметрыСоздания.Вставить("Метаданные", 		Метаданные.РегламентныеЗадания.ЗапускДополнительныхОбработок);
	ПараметрыСоздания.Вставить("Ключ", 				НРег(ОбщегоНазначения.КонтрольнаяСуммаСтрокой(КлючРегламентногоЗадания, ХешФункция.SHA1)));
	ПараметрыСоздания.Вставить("Наименование", 		СтрШаблон(НСтр("ru = '%1: %2'"), SUI_SimpleКлиентСервер.Представление(), КлючРегламентногоЗадания));
	ПараметрыСоздания.Вставить("Параметры", 		ОписаниеТипаМассив.ПривестиЗначение(Параметры));
	ПараметрыСоздания.Вставить("Использование", 	Истина);
	ПараметрыСоздания.Вставить("Расписание", 		ОписаниеТипаРасписание.ПривестиЗначение(Расписание));
	ПараметрыСоздания.Вставить("ИмяПользователя", 	"");
	ПараметрыСоздания.Вставить("КоличествоПовторовПриАварийномЗавершении", 	1);
	ПараметрыСоздания.Вставить("ИнтервалПовтораПриАварийномЗавершении", 	30);
	
	Возврат ПараметрыСоздания;
	
КонецФункции

// Создать регламентное задание.
// 
// Параметры:
//  ПараметрыСоздания - Структура - см. SUI_РегламентныеЗадания.ПараметрыСозданияРегламентногоЗадания
// 
// Возвращаемое значение:
//  УникальныйИдентификатор - Уникальный идентификатор регламентного задания
Функция СоздатьРегламентноеЗадание(ПараметрыСоздания)
	
	РегламентноеЗадание = РегламентныеЗадания.СоздатьРегламентноеЗадание(ПараметрыСоздания.Метаданные);
	ЗаполнитьЗначенияСвойств(РегламентноеЗадание, ПараметрыСоздания);
	РегламентноеЗадание.Записать();
	
	Возврат РегламентноеЗадание.УникальныйИдентификатор;
	
КонецФункции

Функция СоздатьРегламентноеЗадание_ОбработкаОчередиЗаданий(Использование = Истина)
	
	Ключ = Перечисления.SUI_КлючиРегламентыхЗаданий.ОбработкаОчередиЗаданий;

	МенеджерКонстанты = МенеджерКонстантыРегламентногоЗадания(Ключ);
	
	Если МенеджерКонстанты <> Неопределено Тогда
		
		НачатьТранзакцию();
		
		Попытка
			
			ПараметрыЗадания = Новый Массив();
			ПараметрыЗадания.Добавить(Ключ);
			ПараметрыЗадания.Добавить("SUI_ОчередьЗаданий.ОбработатьОчередь");
			
			Расписание = Новый РасписаниеРегламентногоЗадания();
			Расписание.ПериодПовтораДней = 1;
			Расписание.ПериодПовтораВТечениеДня	= 60;
			
			ПараметрыСоздания = ПараметрыСозданияРегламентногоЗадания(Ключ, ПараметрыЗадания, Расписание);
			ПараметрыСоздания.Использование = Использование;
			
			ИдентификаторЗадания = СоздатьРегламентноеЗадание(ПараметрыСоздания);
		
			МенеджерКонстанты.Установить(ИдентификаторЗадания);
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;

	КонецЕсли;

	Возврат ИдентификаторЗадания;
	
КонецФункции

Функция СоздатьРегламентноеЗадание_ОчисткаОчередиЗаданий(Использование = Истина)
	
	Ключ = Перечисления.SUI_КлючиРегламентыхЗаданий.ОчисткаОчередиЗаданий;
	
	МенеджерКонстанты = МенеджерКонстантыРегламентногоЗадания(Ключ);
	
	Если МенеджерКонстанты <> Неопределено Тогда
		
		НачатьТранзакцию();
		
