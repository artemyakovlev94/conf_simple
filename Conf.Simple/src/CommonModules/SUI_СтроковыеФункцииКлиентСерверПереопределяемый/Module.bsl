
#Область ПрограммныйИнтерфейс

// см. СтроковыеФункцииКлиентСервер.ЭтоУникальныйИдентификатор
//
Функция ЭтоУникальныйИдентификатор(Значение) Экспорт
	ОписаниеТипаСтрока = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(36, ДопустимаяДлина.Фиксированная));
	Возврат СтроковыеФункцииКлиентСервер.ЭтоУникальныйИдентификатор(ОписаниеТипаСтрока.ПривестиЗначение(Значение));
КонецФункции

#КонецОбласти
