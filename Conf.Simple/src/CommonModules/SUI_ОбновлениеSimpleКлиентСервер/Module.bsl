
#Область ПрограммныйИнтерфейс

// Возвращает числовой вес версии для сравнения версий между собой.
//
// Параметры:
//  Версия - Строка - версия в строковом формате.
//
// Возвращаемое значение:
//  Число - вес версии
//
Функция ВесВерсии(Знач Версия) Экспорт
	
	Если Версия = "" Тогда
		Возврат 0;
	КонецЕсли;
	
	Если СтрНачинаетсяС(Версия, "ОтладкаОбработчика") Тогда
		Возврат 99000000000;
	КонецЕсли;
	
	РазрядыВерсииСтроками = СтрРазделить(Версия, ".");
	Если РазрядыВерсииСтроками.Количество() = 3 Тогда
		РазрядыВерсииСтроками.Добавить("0");
	КонецЕсли;
	
	Возврат ВесВерсииИзМассиваСтрок(РазрядыВерсииСтроками);
	
КонецФункции

Функция ПолучитьСписокОбновленийИзРепозитория(ПредварительныеВерсии = Ложь, Таймаут = 15) Экспорт
	
	#Если ВебКлиент Тогда
		Возврат SUI_ОбновлениеSimpleВызовСервера.ПолучитьСписокОбновленийИзРепозитория(Таймаут);
	#Иначе
		
		Результат = Новый Структура();
		Результат.Вставить("Ошибка", "");
		Результат.Вставить("СписокВерсий", Новый Массив());
		
		Попытка
			
			РезультатЗапроса = ВыполнитьЗапросКРепозиторию("/releases", Таймаут);
			СписокВерсий = ДанныеJSON(РезультатЗапроса.ПолучитьТелоКакСтроку());
			Если СписокВерсий.Количество() > 0 Тогда
				Результат.СписокВерсий = ПолучитьДоступныеВерсииКОбновлению(СписокВерсий, ПредварительныеВерсии);
			КонецЕсли;
			
		Исключение
			Ошибка = ИнформацияОбОшибке();
			ЗаписатьОшибкуОбращенияКРепозиторию(Ошибка);
			Результат.Ошибка = НСтр("ru = 'Возникла ошибка получения списка обновлений.
			|Обратитесь к поставщику обновлений.'");
		КонецПопытки;
		
		Возврат Результат;
		
	#КонецЕсли
	
КонецФункции

Функция ЗагрузитьФайлОбновленияИзРепозитория(ОписаниеОбновления, АдресХранения, Таймаут = 15) Экспорт
	
	#Если ВебКлиент Тогда
		Результат = SUI_ОбновлениеSimpleВызовСервера.ЗагрузитьФайлОбновленияИзРепозитория(ОписаниеОбновления, Таймаут);
	#Иначе
		
		Результат = Новый Структура();
		Результат.Вставить("Ошибка", "");
		Результат.Вставить("АдресХранения", "");
		
		Попытка
			
			ПутьКФайлуЗагрузки = "";
			
			Если ПустаяСтрока(ОписаниеОбновления.file_url) Тогда
				
				ПутьКВложению = "/releases/assets/" + Формат(ОписаниеОбновления.file_id, "ЧГ=0;");
				РезультатЗапроса = ВыполнитьЗапросКРепозиторию(ПутьКВложению, Таймаут);
				
				Вложение = ДанныеJSON(РезультатЗапроса.ПолучитьТелоКакСтроку());
				ПутьКФайлуЗагрузки = SUI_ОбщегоНазначенияКлиентСервер.ЗначениеСоответствия(
					Вложение, "browser_download_url", "", Тип("Строка"));
				
				ОбщегоНазначенияКлиентСервер.Проверить(Не ПустаяСтрока(ПутьКФайлуЗагрузки),
					СтрШаблон(НСтр("ru = 'Не удалось определить ссылку для скачивания файла обновления по идентификатору %1.'"), 
					Формат(ОписаниеОбновления.file_id, "ЧГ=0;")),
					"SUI_ОбновлениеSimpleКлиентСервер.ЗагрузитьФайлОбновленияИзРепозитория");
				
			Иначе
				
				ПутьКФайлуЗагрузки = ОписаниеОбновления.file_url;
				
				ОбщегоНазначенияКлиентСервер.Проверить(Не ПустаяСтрока(ПутьКФайлуЗагрузки),
					НСтр("ru = 'Пустая ссылка для скачивания файла обновления'"),
					"SUI_ОбновлениеSimpleКлиентСервер.ЗагрузитьФайлОбновленияИзРепозитория");
				
			КонецЕсли;
			
			РезультатЗапроса = ВыполнитьЗапросКРепозиторию(ПутьКФайлуЗагрузки, Таймаут);
			ФайлОбновления = РезультатЗапроса.ПолучитьТелоКакДвоичныеДанные();
			Результат.АдресХранения = ПоместитьВоВременноеХранилище(ФайлОбновления, АдресХранения);
			
		Исключение
			Ошибка = ИнформацияОбОшибке();
			ЗаписатьОшибкуОбращенияКРепозиторию(Ошибка);
			Результат.Ошибка = НСтр("ru = 'Возникла ошибка получения файла обновления.
			|Обратитесь к поставщику обновлений.'");
		КонецПопытки;
		
	#КонецЕсли
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

