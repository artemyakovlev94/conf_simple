Функция СкрываемыеЗначенияЗаголовков()
	
	Возврат SUI_ОбщегоНазначенияКлиентСервер.МассивЗначений(
		"Authorization",
		"authorization");
		
КонецФункции

Функция ПолучитьЗаголовки(HTTPЗапрос, HTTPОтвет)
	
	Результат = Новый Структура("Запрос, Ответ", Новый Соответствие(), Новый Соответствие());
	
	#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
		Результат.Запрос = SUI_ОбщегоНазначения.СкопироватьРекурсивно(HTTPЗапрос.Заголовки, Ложь);
		Результат.Ответ = SUI_ОбщегоНазначения.СкопироватьРекурсивно(HTTPОтвет.Заголовки, Ложь);
	#Иначе
		Результат.Запрос = ОбщегоНазначенияКлиент.СкопироватьРекурсивно(HTTPЗапрос.Заголовки, Ложь);
		Результат.Ответ = ОбщегоНазначенияКлиент.СкопироватьРекурсивно(HTTPОтвет.Заголовки, Ложь);
	#КонецЕсли
	
	Для Каждого СкрываемыйЗаголовок Из СкрываемыеЗначенияЗаголовков() Цикл
		
		Если Результат.Запрос.Получить(СкрываемыйЗаголовок) <> Неопределено Тогда
			Результат.Запрос.Вставить(СкрываемыйЗаголовок, "hidden");
		КонецЕсли;
		
		Если Результат.Ответ.Получить(СкрываемыйЗаголовок) <> Неопределено Тогда
			Результат.Ответ.Вставить(СкрываемыйЗаголовок, "hidden");
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция АдресИПараметрыHTTPЗапросаИСоединения(HTTPЗапрос, Соединение)
	
	Результат = Новый Структура();
	Результат.Вставить("БазовыйURL", "");
	Результат.Вставить("ОтносительныйURL", "");
	Результат.Вставить("ПараметрыURL", Новый Соответствие());
	
	Если Соединение.ЗащищенноеСоединение = Неопределено Тогда
		Результат.БазовыйURL = "http://";
	Иначе
		Результат.БазовыйURL = "https://";
	КонецЕсли;
	
	Результат.БазовыйURL = Результат.БазовыйURL + Соединение.Сервер + Формат(Соединение.Порт, "ЧДЦ=0; ЧН='""""'; ЧГ=0;");
	
	ПозицияНачалаПараметров = СтрНайти(HTTPЗапрос.АдресРесурса, "?");
	Если ПозицияНачалаПараметров > 0 Тогда
		
		Результат.ОтносительныйURL = Лев(HTTPЗапрос.АдресРесурса, ПозицияНачалаПараметров - 1);
		
		СтрокаПараметровURL = Сред(HTTPЗапрос.АдресРесурса, ПозицияНачалаПараметров + 1);
		
		Для Каждого ПараметрURL Из СтроковыеФункцииКлиентСервер.ПараметрыИзСтроки(СтрокаПараметровURL, "&") Цикл
			Результат.ПараметрыURL.Вставить(ПараметрURL.Ключ, ПараметрURL.Значение);
		КонецЦикла;
		
	Иначе
		Результат.ОтносительныйURL = HTTPЗапрос.АдресРесурса;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти
