	ОткрытьФорму("Документ.SUI_ДокументОбмена.Форма.ФормаВыборИзДерева", ПараметрыОткрытия, 
		ПараметрыВыполнения.Форма, ПараметрыВыполнения.Форма.УникальныйИдентификатор, , , Оповещение);
	
КонецПроцедуры

