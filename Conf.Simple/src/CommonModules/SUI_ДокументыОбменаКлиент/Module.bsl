Процедура ВыгрузитьВДокументОбмена(ДокументСсылка, ПараметрыВыполнения) Экспорт
	
	Контекст = Новый Структура();
	Контекст.Вставить("ДокументСсылка", ДокументСсылка);
	Контекст.Вставить("ПараметрыВыполнения", ПараметрыВыполнения);
	
	ПараметрыОткрытия = Новый Структура();
	ПараметрыОткрытия.Вставить("ДокументОснование", ДокументСсылка);
	ПараметрыОткрытия.Вставить("ВыборМобильныхУстройств", Истина);
	ПараметрыОткрытия.Вставить("Заголовок", НСтр("ru = 'Выгрузка в документ обмена'"));
	
	Оповещение = Новый ОписаниеОповещения("ВыгрузитьВДокументОбменаЗавершениеВыбораНастроек", ЭтотОбъект, Контекст);
	
	ОткрытьФорму("Документ.SUI_ДокументОбмена.Форма.ФормаВыборИзДерева", ПараметрыОткрытия, 
		ПараметрыВыполнения.Форма, ПараметрыВыполнения.Форма.УникальныйИдентификатор, , , Оповещение);
	
КонецПроцедуры

Процедура ОткрытьДокументОбмена(ДокументСсылка, ПараметрыВыполнения) Экспорт
	
	ВыполнитьОткрытиеДокументаОбмена(ДокументСсылка, ПараметрыВыполнения, "ОткрытиеДокументаОбмена");
	
КонецПроцедуры

Процедура ОткрытьПросмотрРезультата(ДокументСсылка, ПараметрыВыполнения) Экспорт
	
	ВыполнитьОткрытиеДокументаОбмена(ДокументСсылка, ПараметрыВыполнения, "ПросмотрРезультатаДокументаОбмена");
	
КонецПроцедуры

Процедура ЗагрузитьДокументОбмена(ДокументСсылка, ПараметрыВыполнения) Экспорт
	
	Контекст = Новый Структура();
	Контекст.Вставить("ДокументСсылка", ДокументСсылка);
	Контекст.Вставить("ПараметрыВыполнения", ПараметрыВыполнения);
	
	ВыполнитьОткрытиеДокументаОбмена(ДокументСсылка, ПараметрыВыполнения, "ЗагрузкаДокументаОбмена");
	
КонецПроцедуры

Процедура УдалитьДокументОбмена(ДокументСсылка, ПараметрыВыполнения) Экспорт
	
	Контекст = Новый Структура();
	Контекст.Вставить("ДокументСсылка", ДокументСсылка);
	Контекст.Вставить("ПараметрыВыполнения", ПараметрыВыполнения);
	
	ПараметрыОткрытия = Новый Структура();
