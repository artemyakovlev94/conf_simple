	|	СтруктураСоздания.Характеристика = Характеристика;
	|	СтруктураСоздания.Серия = Серия;
	|	СтруктураСоздания.Упаковка = Упаковка;
	|	СтруктураСоздания.Штрихкод = РезультатРазбора.НормализованныйКодМаркировки;
	|	СтруктураСоздания.ТипШтрихкода = РезультатРазбора.ТипШтрихкода;
	|	СтруктураСоздания.ТипУпаковки = Перечисления.ТипыУпаковок.МаркированныйТовар;
	|	
	|	Если РезультатРазбора.ВидУпаковки = Перечисления.ВидыУпаковокИС.Логистическая Или
	|		РезультатРазбора.ВидУпаковки = Перечисления.ВидыУпаковокИС.Групповая Тогда
	|		СтруктураСоздания.ТипУпаковки = Перечисления.ТипыУпаковок.МонотоварнаяУпаковка;
	|	КонецЕсли;
	|	
	|	Если ВложенныеШтрихкодыУпаковок.Количество() > 0 Тогда
	|		
	|		ТаблицаВложенныхШтрихкодов = Новый ТаблицаЗначений();
	|		ТаблицаВложенныхШтрихкодов.Колонки.Добавить(""Штрихкод"");
	|		
	|		СтруктураОбъекта = Новый Структура(""ТипУпаковки,Номенклатура,Характеристика,Упаковка,Серия"");
	|		ЗаполнитьЗначенияСвойств(СтруктураОбъекта, СтруктураСоздания);
	|		СтруктураОбъекта.Вставить(""ВложенныеШтрихкоды"", ТаблицаВложенныхШтрихкодов);
	|		
	|		Для индекс = 0 По ВложенныеШтрихкодыУпаковок.ВГраница() Цикл
	|			
	|			СтрокаВложенныхОбъекта = ТаблицаВложенныхШтрихкодов.Добавить();
	|			СтрокаВложенныхОбъекта.Штрихкод = ВложенныеШтрихкодыУпаковок[индекс];
	|			
	|		КонецЦикла;
	|		
	|		ПараметрыНоменклатуры = Справочники.ШтрихкодыУпаковокТоваров.ПараметрыНоменклатурыВложенныхШтрихкодов(СтруктураОбъекта);
	|		
	|		ЗаполнитьЗначенияСвойств(СтруктураСоздания, ПараметрыНоменклатуры);
	|		
	|	КонецЕсли;
	|	
	|	ДополнительныеПараметрыСоздания = Справочники.ШтрихкодыУпаковокТоваров
	|		.ДополнительныеПараметрыСозданияШтрихкодовУпаковок();
