	|			
	|			ПараметрыОтбора = Новый Структура();
	|			ПараметрыОтбора.Вставить(""Штрихкод"", ВложенныеШтрихкодыУпаковок[индекс]);
	|			
	|			ВыборкаВложенных.Сбросить();
	|			ОбновитьВложенныеШтрихкоды = Не ВыборкаВложенных.НайтиСледующий(ПараметрыОтбора);
