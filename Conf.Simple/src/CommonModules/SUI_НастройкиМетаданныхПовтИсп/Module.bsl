	Возврат Новый ФиксированноеСоответствие(СоответствиеТаблиц);
	
КонецФункции

Функция СоответсвиеКонстантТаблицИнтеграции() Экспорт

	СоответсвиеКонстант = Новый Соответствие();
	
	СоответсвиеКонстант.Вставить(Перечисления.SUI_ТаблицыИнтеграции.Контрагенты, 
		Константы.SUI_ИспользоватьТаблицу_Контрагенты);
	СоответсвиеКонстант.Вставить(Перечисления.SUI_ТаблицыИнтеграции.Склады, 
		Константы.SUI_ИспользоватьТаблицу_Склады);
	СоответсвиеКонстант.Вставить(Перечисления.SUI_ТаблицыИнтеграции.Ячейки, 
		Константы.SUI_ИспользоватьТаблицу_Ячейки);
	СоответсвиеКонстант.Вставить(Перечисления.SUI_ТаблицыИнтеграции.Номенклатура, 
		Константы.SUI_ИспользоватьТаблицу_Номенклатура);
	СоответсвиеКонстант.Вставить(Перечисления.SUI_ТаблицыИнтеграции.ХарактеристикиНоменклатуры, 
		Константы.SUI_ИспользоватьТаблицу_ХарактеристикиНоменклатуры);
	СоответсвиеКонстант.Вставить(Перечисления.SUI_ТаблицыИнтеграции.СерииНоменклатуры, 
		Константы.SUI_ИспользоватьТаблицу_СерииНоменклатуры);
	СоответсвиеКонстант.Вставить(Перечисления.SUI_ТаблицыИнтеграции.УпаковкиНоменклатуры, 
		Константы.SUI_ИспользоватьТаблицу_УпаковкиНоменклатуры);
	СоответсвиеКонстант.Вставить(Перечисления.SUI_ТаблицыИнтеграции.ШтрихкодыНоменклатуры, 
		Константы.SUI_ИспользоватьТаблицу_ШтрихкодыНоменклатуры);
	СоответсвиеКонстант.Вставить(Перечисления.SUI_ТаблицыИнтеграции.ШтрихкодыУпаковок, 
		Константы.SUI_ИспользоватьТаблицу_ШтрихкодыУпаковок);
	СоответсвиеКонстант.Вставить(Перечисления.SUI_ТаблицыИнтеграции.ШаблоныЭтикеток, 
		Константы.SUI_ИспользоватьТаблицу_ШаблоныЭтикеток);
	СоответсвиеКонстант.Вставить(Перечисления.SUI_ТаблицыИнтеграции.ПользователиТСД, 
		Константы.SUI_ИспользоватьТаблицу_ПользователиТСД);
	
	Возврат Новый ФиксированноеСоответствие(СоответсвиеКонстант);
	
КонецФункции

Функция СоответсвиеФункциональныхОпцийТаблицИнтеграции() Экспорт
	
	СоответсвиеФункциональныхОпций = Новый Соответствие();
	
	СоответсвиеФункциональныхОпций.Вставить(Перечисления.SUI_ТаблицыИнтеграции.Контрагенты, 
		"SUI_ИспользоватьТаблицу_Контрагенты");
	СоответсвиеФункциональныхОпций.Вставить(Перечисления.SUI_ТаблицыИнтеграции.Склады, 
		"SUI_ИспользоватьТаблицу_Склады");
	СоответсвиеФункциональныхОпций.Вставить(Перечисления.SUI_ТаблицыИнтеграции.Ячейки, 
		"SUI_ИспользоватьТаблицу_Ячейки");
	СоответсвиеФункциональныхОпций.Вставить(Перечисления.SUI_ТаблицыИнтеграции.Номенклатура, 
		"SUI_ИспользоватьТаблицу_Номенклатура");
	СоответсвиеФункциональныхОпций.Вставить(Перечисления.SUI_ТаблицыИнтеграции.ХарактеристикиНоменклатуры, 
		"SUI_ИспользоватьТаблицу_ХарактеристикиНоменклатуры");
	СоответсвиеФункциональныхОпций.Вставить(Перечисления.SUI_ТаблицыИнтеграции.СерииНоменклатуры, 
		"SUI_ИспользоватьТаблицу_СерииНоменклатуры");
	СоответсвиеФункциональныхОпций.Вставить(Перечисления.SUI_ТаблицыИнтеграции.УпаковкиНоменклатуры, 
		"SUI_ИспользоватьТаблицу_УпаковкиНоменклатуры");
	СоответсвиеФункциональныхОпций.Вставить(Перечисления.SUI_ТаблицыИнтеграции.ШтрихкодыНоменклатуры, 
		"SUI_ИспользоватьТаблицу_ШтрихкодыНоменклатуры");
	СоответсвиеФункциональныхОпций.Вставить(Перечисления.SUI_ТаблицыИнтеграции.ШтрихкодыУпаковок, 
		"SUI_ИспользоватьТаблицу_ШтрихкодыУпаковок");
	СоответсвиеФункциональныхОпций.Вставить(Перечисления.SUI_ТаблицыИнтеграции.ШаблоныЭтикеток, 
		"SUI_ИспользоватьТаблицу_ШаблоныЭтикеток");
	СоответсвиеФункциональныхОпций.Вставить(Перечисления.SUI_ТаблицыИнтеграции.ПользователиТСД, 
		"SUI_ИспользоватьТаблицу_ПользователиТСД");
	
	Возврат Новый ФиксированноеСоответствие(СоответсвиеФункциональныхОпций);
	
КонецФункции

Функция ТаблицыИнтеграции() Экспорт
	
	ТаблицыИнтеграции = Новый СписокЗначений();

	ТаблицыИнтеграции.Добавить(Перечисления.SUI_ТаблицыИнтеграции.Контрагенты, 
		Перечисления.SUI_ТаблицыИнтеграции.Контрагенты);
	ТаблицыИнтеграции.Добавить(Перечисления.SUI_ТаблицыИнтеграции.Склады, 
		Перечисления.SUI_ТаблицыИнтеграции.Склады);
	ТаблицыИнтеграции.Добавить(Перечисления.SUI_ТаблицыИнтеграции.Ячейки, 
		Перечисления.SUI_ТаблицыИнтеграции.Ячейки);
	ТаблицыИнтеграции.Добавить(Перечисления.SUI_ТаблицыИнтеграции.Номенклатура, 
		Перечисления.SUI_ТаблицыИнтеграции.Номенклатура);
	ТаблицыИнтеграции.Добавить(Перечисления.SUI_ТаблицыИнтеграции.ХарактеристикиНоменклатуры, 
		Перечисления.SUI_ТаблицыИнтеграции.ХарактеристикиНоменклатуры);
	ТаблицыИнтеграции.Добавить(Перечисления.SUI_ТаблицыИнтеграции.СерииНоменклатуры, 
		Перечисления.SUI_ТаблицыИнтеграции.СерииНоменклатуры);
	ТаблицыИнтеграции.Добавить(Перечисления.SUI_ТаблицыИнтеграции.УпаковкиНоменклатуры, 
		Перечисления.SUI_ТаблицыИнтеграции.УпаковкиНоменклатуры);
	ТаблицыИнтеграции.Добавить(Перечисления.SUI_ТаблицыИнтеграции.ШтрихкодыНоменклатуры, 
		Перечисления.SUI_ТаблицыИнтеграции.ШтрихкодыНоменклатуры);
	ТаблицыИнтеграции.Добавить(Перечисления.SUI_ТаблицыИнтеграции.ШтрихкодыУпаковок, 
		Перечисления.SUI_ТаблицыИнтеграции.ШтрихкодыУпаковок);
	ТаблицыИнтеграции.Добавить(Перечисления.SUI_ТаблицыИнтеграции.ШаблоныЭтикеток, 
		Перечисления.SUI_ТаблицыИнтеграции.ШаблоныЭтикеток);
	// TODO: Сандалов: Временное отключениеВременно убрать до реализации авторизации на ТСД	
	//ТаблицыИнтеграции.Добавить(Перечисления.SUI_ТаблицыИнтеграции.ПользователиТСД, 
	//	Перечисления.SUI_ТаблицыИнтеграции.ПользователиТСД);
		
	Возврат ТаблицыИнтеграции;

КонецФункции

