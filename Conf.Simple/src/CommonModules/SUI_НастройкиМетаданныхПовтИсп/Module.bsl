Функция СоответствиеТаблицИнтеграцииВКонфигурации() Экспорт
	
	СоответствиеТаблиц = Новый Соответствие();
	
	СоответствиеТаблиц.Вставить(Перечисления.SUI_ТаблицыИнтеграции.Контрагенты, 
		Метаданные.РегистрыСведений.SUI_tbl_countragents.ПолноеИмя());
	СоответствиеТаблиц.Вставить(Перечисления.SUI_ТаблицыИнтеграции.Склады, 
		Метаданные.РегистрыСведений.SUI_tbl_warehouses.ПолноеИмя());
	СоответствиеТаблиц.Вставить(Перечисления.SUI_ТаблицыИнтеграции.Ячейки, 
		Метаданные.РегистрыСведений.SUI_tbl_cells.ПолноеИмя());
	СоответствиеТаблиц.Вставить(Перечисления.SUI_ТаблицыИнтеграции.Номенклатура, 
		Метаданные.РегистрыСведений.SUI_tbl_goods.ПолноеИмя());
	СоответствиеТаблиц.Вставить(Перечисления.SUI_ТаблицыИнтеграции.ХарактеристикиНоменклатуры, 
		Метаданные.РегистрыСведений.SUI_tbl_properties.ПолноеИмя());
	СоответствиеТаблиц.Вставить(Перечисления.SUI_ТаблицыИнтеграции.СерииНоменклатуры, 
		Метаданные.РегистрыСведений.SUI_tbl_series.ПолноеИмя());
	СоответствиеТаблиц.Вставить(Перечисления.SUI_ТаблицыИнтеграции.УпаковкиНоменклатуры, 
		Метаданные.РегистрыСведений.SUI_tbl_units.ПолноеИмя());
	СоответствиеТаблиц.Вставить(Перечисления.SUI_ТаблицыИнтеграции.ШтрихкодыНоменклатуры, 
		Метаданные.РегистрыСведений.SUI_tbl_barcodes.ПолноеИмя());
	СоответствиеТаблиц.Вставить(Перечисления.SUI_ТаблицыИнтеграции.ШтрихкодыУпаковок, 
		Метаданные.РегистрыСведений.SUI_tbl_marking_codes.ПолноеИмя());
	СоответствиеТаблиц.Вставить(Перечисления.SUI_ТаблицыИнтеграции.Документы, 
		Метаданные.РегистрыСведений.SUI_docs.ПолноеИмя());
	СоответствиеТаблиц.Вставить(Перечисления.SUI_ТаблицыИнтеграции.ТоварыДокументов, 
		Метаданные.РегистрыСведений.SUI_docs_tbl_goods.ПолноеИмя());
	СоответствиеТаблиц.Вставить(Перечисления.SUI_ТаблицыИнтеграции.ШтрихкодыУпаковокДокументов, 
		Метаданные.РегистрыСведений.SUI_ШтрихкодыУпаковокДокументовОбмена.ПолноеИмя());
	СоответствиеТаблиц.Вставить(Перечисления.SUI_ТаблицыИнтеграции.СерииДокументов, 
		Метаданные.РегистрыСведений.SUI_docs_tbl_series.ПолноеИмя());
	СоответствиеТаблиц.Вставить(Перечисления.SUI_ТаблицыИнтеграции.ДокументыАдресногоХранения, 
		Метаданные.РегистрыСведений.SUI_docs.ПолноеИмя());
	СоответствиеТаблиц.Вставить(Перечисления.SUI_ТаблицыИнтеграции.ТоварыДокументовАдресногоХранения, 
		Метаданные.РегистрыСведений.SUI_docs_tbl_goods.ПолноеИмя());
	СоответствиеТаблиц.Вставить(Перечисления.SUI_ТаблицыИнтеграции.НастройкиДокументов, 
		Метаданные.Справочники.SUI_НастройкиДокументов.ПолноеИмя());
	СоответствиеТаблиц.Вставить(Перечисления.SUI_ТаблицыИнтеграции.ШаблоныЭтикеток,
		Метаданные.РегистрыСведений.SUI_tbl_label_templates.ПолноеИмя());
