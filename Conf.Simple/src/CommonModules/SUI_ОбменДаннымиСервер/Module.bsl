КонецФункции

Функция ВосстановлениеДанныхJSON_ДанныеДокумента_ШтрихкодыДокумента(мсвДанные, АдресХранения = Неопределено)
	
	Таблица = РегистрыСведений.SUI_ОтсканированныеШтрихкодыУпаковокДокументовОбмена.ПолучитьТаблицуЭталон();
	
	Если SUI_НастройкиМетаданныхСервер.ТаблицаИспользуется(Перечисления.SUI_ТаблицыИнтеграции.ШтрихкодыУпаковок) И
		ТипЗнч(мсвДанные) = Тип("Массив") Тогда
		
		АлгоритмНормализации = РегистрыСведений.SUI_ОтсканированныеШтрихкодыУпаковокДокументовОбмена
			.ПолучитьАлгоритмНормализацииШтрихкода();
		
		ОписаниеТипаШтрихкод = SUI_ОбщегоНазначения.ОписаниеТипаСтрока(200);
		
		ПроверяемыеКлючи = Новый Соответствие();
		ПроверяемыеКлючи.Вставить("id_good", 		Ложь);
		ПроверяемыеКлючи.Вставить("id_property", 	Ложь);
		ПроверяемыеКлючи.Вставить("id_unit", 		Ложь);
		ПроверяемыеКлючи.Вставить("id_series", 		Ложь);
		ПроверяемыеКлючи.Вставить("id_cell", 		Ложь);
		
		Для индекс = 0 По мсвДанные.ВГраница() Цикл
			
			ШтрихкодПолный = СокрЛП(ОписаниеТипаШтрихкод.ПривестиЗначение(мсвДанные[индекс].barcode));
			
			Если ПустаяСтрока(ШтрихкодПолный) Тогда
				Продолжить;
			КонецЕсли;
			
			СтрокаТаблицы = Таблица.Добавить();
			СтрокаТаблицы.barcode_base64 = SUI_ШтрихкодированиеКлиентСервер.ШтрихкодВBase64(ШтрихкодПолный);
			СтрокаТаблицы.barcode_full = SUI_ОбщегоНазначенияКлиентСервер.УдалитьНедопустимыеСимволыВXML(ШтрихкодПолный);
			
			//@skip-check structure-consructor-too-many-keys
			ДополнительныеДанные = Новый Структура("id_good,id_property,id_unit,id_cell,id_series,series_number");
			ЗаполнитьЗначенияСвойств(ДополнительныеДанные, мсвДанные[индекс]);
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ДополнительныеДанные);
			
			Номенклатура = SUI_ИнтеграцияВКонфигурацию.СсылкаПоИдентификаторуSimple(СтрокаТаблицы.id_good, Истина);
			
			Если Не ЗначениеЗаполнено(Номенклатура) И Не ПустаяСтрока(СтрокаТаблицы.id_good) Тогда
				Номенклатура = СтрокаТаблицы.id_good;
			КонецЕсли;
			
			СтрокаТаблицы.barcode = SUI_ШтрихкодыУпаковок.НормализоватьЗначениеШтрихкода(
				АлгоритмНормализации, СтрокаТаблицы.barcode_full, Номенклатура);
			СтрокаТаблицы.hash = SUI_Штрихкодирование.РасчитатьХешШтрихкода(СтрокаТаблицы.barcode);
			
			Если ПустаяСтрока(СтрокаТаблицы.hash) Тогда
				ТекстОшибки = НСтр("ru = '[%1] Не удалось вычислить хеш сумму штрихкода %2 (%3)!'");
				ТекстОшибки = СтрШаблон(ТекстОшибки, индекс, СтрокаТаблицы.barcode, СтрокаТаблицы.barcode_full);
				ВызватьИсключение ТекстОшибки;
			КонецЕсли;
			
			ШтрихкодВладельцаПолный = СокрЛП(ОписаниеТипаШтрихкод.ПривестиЗначение(мсвДанные[индекс].barcode_owner));
			
			Если Не ПустаяСтрока(ШтрихкодВладельцаПолный) Тогда
				
				ШтрихкодВладельцаПолный = SUI_ОбщегоНазначенияКлиентСервер.УдалитьНедопустимыеСимволыВXML(ШтрихкодВладельцаПолный);
				
				СтрокаТаблицы.barcode_owner = SUI_ШтрихкодыУпаковок.НормализоватьЗначениеШтрихкода(
					АлгоритмНормализации, ШтрихкодВладельцаПолный, Номенклатура);
				СтрокаТаблицы.hash_owner = SUI_Штрихкодирование.РасчитатьХешШтрихкода(СтрокаТаблицы.barcode_owner);
				
			КонецЕсли;
			
			СтрокаТаблицы.series_number = SUI_ОбщегоНазначенияКлиентСервер.УдалитьНедопустимыеСимволыВXML(СтрокаТаблицы.series_number);
			
			Попытка
				ПроверитьЗаполнениеИдентификаторовПриВосстановленииДанныхJSON(СтрокаТаблицы, ПроверяемыеКлючи);
			Исключение
				ТекстОшибки = СтрШаблон("[%1] %2", индекс, ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
				ВызватьИсключение ТекстОшибки;
			КонецПопытки;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если ЭтоАдресВременногоХранилища(АдресХранения) Тогда
		Возврат ПоместитьВоВременноеХранилище(Таблица, АдресХранения);	
	Иначе 
		Возврат Таблица;	
	КонецЕсли;

КонецФункции

Функция ВосстановлениеДанныхJSON_ДанныеДокумента_ПотокШтрихкодов(мсвДанные, АдресХранения = Неопределено)
	
	Таблица = SUI_ДокументыОбмена.ТаблицаПотокШтрихкодовОбмена();
	
	Если ТипЗнч(мсвДанные) = Тип("Массив") Тогда

		Для Каждого Элемент Из мсвДанные Цикл
			
			Если ТипЗнч(Элемент) <> Тип("Структура") Тогда
				Продолжить;	
			КонецЕсли;
			
			НоваяСтрока = Таблица.Добавить();
			НоваяСтрока.ШтрихкодBase64 = SUI_ШтрихкодированиеКлиентСервер.ШтрихкодВBase64(Элемент.barcode);
			НоваяСтрока.ЭтоШтрихкодКМ = SUI_ШтрихкодированиеКлиентСервер.ЭтоШтрихкодКМ(Элемент.barcode);
			
			Если Не НоваяСтрока.ЭтоШтрихкодКМ Тогда
				НоваяСтрока.ЭтоШтрихкодSSCC = SUI_ШтрихкодированиеКлиентСервер.ЭтоШтрихкодSSCC(Элемент.barcode);
			КонецЕсли;
			
			НоваяСтрока.barcode = SUI_ОбщегоНазначенияКлиентСервер.УдалитьНедопустимыеСимволыВXML(Элемент.barcode);
			
		КонецЦикла;

	КонецЕсли;
	
	Если ЭтоАдресВременногоХранилища(АдресХранения) Тогда
		Возврат ПоместитьВоВременноеХранилище(Таблица, АдресХранения);	
	Иначе 
		Возврат Таблица;
	КонецЕсли;

КонецФункции

Функция ВосстановлениеДанныхJSON_ДанныеШтрихкодов_СоздатьШтрихкодыНоменклатуры(мсвДанные) 
	
	Таблица = Новый ТаблицаЗначений();
	Таблица.Колонки.Добавить("barcode", SUI_ОбщегоНазначения.ОписаниеТипаСтрока(200));
	Таблица.Колонки.Добавить("id_good", SUI_ОбщегоНазначения.ОписаниеТипаСтрока(69));
	Таблица.Колонки.Добавить("id_property", SUI_ОбщегоНазначения.ОписаниеТипаСтрока(69));
	Таблица.Колонки.Добавить("id_unit", SUI_ОбщегоНазначения.ОписаниеТипаСтрока(69));

	Для Каждого Элемент Из мсвДанные Цикл
		
		НоваяСтрока = Таблица.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Элемент);
		
		НоваяСтрока.barcode = SUI_ОбщегоНазначенияКлиентСервер.УдалитьНедопустимыеСимволыВXML(НоваяСтрока.barcode);

		SUI_ОбщегоНазначенияКлиентСервер.Проверить(ЗначениеЗаполнено(НоваяСтрока.barcode),
			НСтр("ru = 'Передано пустое значение штрихкода номенклатуры.'"));
			
		SUI_ОбщегоНазначенияКлиентСервер.Проверить(ЗначениеЗаполнено(НоваяСтрока.id_good),
			НСтр("ru = 'Не заполнен идентификатор номенклатуры.'"));
		
	КонецЦикла;
	
	Таблица.Свернуть("barcode,id_good,id_property,id_unit");

	Возврат Таблица;
	
КонецФункции

Процедура ПроверитьЗаполнениеИдентификаторовПриВосстановленииДанныхJSON(СтрокаТаблицы, ПроверяемыеКлючи)
	
	Для Каждого КлючЗначение Из ПроверяемыеКлючи Цикл
		
		Если ЗначениеЗаполнено(СтрокаТаблицы[КлючЗначение.Ключ]) Тогда
			
			Если Не SUI_ИнтеграцияВКонфигурациюКлиентСервер.ЭтоИдентификаторSimple(СтрокаТаблицы[КлючЗначение.Ключ]) Тогда
				ТекстОшибки = НСтр("ru = 'Значение ""%1"" ключа ""%2"" не является идентификатором Simple!'");
				ТекстОшибки = СтрШаблон(ТекстОшибки, СтрокаТаблицы[КлючЗначение.Ключ], КлючЗначение.Ключ);
				ВызватьИсключение ТекстОшибки;
			КонецЕсли;
			
		Иначе
			
			Если КлючЗначение.Значение Тогда
				
				ТекстОшибки = НСтр("ru = 'Не заполнен идентификатор в ключе ""%1""!'");
				ТекстОшибки = СтрШаблон(ТекстОшибки, КлючЗначение.Ключ);
				ВызватьИсключение ТекстОшибки;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверкаИННВладельцаИСтатуса(ИдентификаторДокумента, ИдентификаторНастройки, СоставКодовМаркировки)
	
	ОбрабатываемыйДокумент = SUI_ИнтеграцияВКонфигурацию.СсылкаПоИдентификаторуSimple(ИдентификаторДокумента, Истина);
	НастройкаДокумента = SUI_ИнтеграцияВКонфигурацию.СсылкаПоИдентификаторуSimple(ИдентификаторНастройки, Истина);
	ЗапрещенныеСтатусы = НастройкаДокумента.СписокСтатусовКодовМаркировок.Выгрузить().ВыгрузитьКолонку("КодСтатуса");
	
	Для Каждого СоставКодаМаркировки Из СоставКодовМаркировки Цикл
		
		Если НастройкаДокумента.ПроверятьCтатусКИ И ЗапрещенныеСтатусы.Найти(СоставКодаМаркировки.status) <> Неопределено Тогда
			ВызватьИсключение "Код маркировки " + СоставКодаМаркировки.cis + " находится в запрещенном статусе " + СоставКодаМаркировки.status;
		КонецЕсли;
		
		Если НастройкаДокумента.ПроверятьВладельца И СоставКодаМаркировки.ownerInn <> ОбрабатываемыйДокумент[НастройкаДокумента.ИННВладельца] Тогда
			ВызватьИсключение "У кода маркировки " + СоставКодаМаркировки.cis + " не совпадает ИНН с данными из ""Чистого знака""";
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ВыполнитьПроверкиПередЗапускомВнешнейОбработки(КодыМаркировкиКЗапросу, ПодключеннаяИнтеграционнаяОбработка)
	
	SUI_ОбщегоНазначенияКлиентСервер.ПроверитьПараметр("SUI_ОбменДаннымиСервер.ПолучитьСоставКодовМаркировок",
		"КодыМаркировкиКЗапросу", КодыМаркировкиКЗапросу, Тип("Массив"));
	
	SUI_ОбщегоНазначенияКлиентСервер.Проверить(
		SUI_ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.ДополнительныеОтчетыИОбработки"),
		НСтр("ru = 'Отсутствует подсистема ""СтандартныеПодсистемы.ДополнительныеОтчетыИОбработки"".'"));
	
	SUI_ОбщегоНазначенияКлиентСервер.Проверить(Не ПодключеннаяИнтеграционнаяОбработка.Пустая(),
		НСтр("ru = 'Не подключена внешняя обработка ""SimpleИнтеграцияГИСМТ"".'"));
		
КонецПроцедуры

