Функция ДанныеПоЗапросуСоставаКМ(ИдентификаторЗапроса, МобильноеУстройство)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	SUI_ДанныеКодовМаркировки.Результат,
	|	SUI_ДанныеКодовМаркировки.Выполнено,
	|	SUI_ДанныеКодовМаркировки.ИдентификаторФоновогоЗадания,
	|	SUI_ДанныеКодовМаркировки.ТекстОшибки
	|ИЗ
	|	РегистрСведений.SUI_ДанныеКодовМаркировки КАК SUI_ДанныеКодовМаркировки
	|ГДЕ
	|	SUI_ДанныеКодовМаркировки.МобильноеУстройство = &МобильноеУстройство
	|	И SUI_ДанныеКодовМаркировки.УникальныйИдентификатор = &УникальныйИдентификатор";

	Запрос.УстановитьПараметр("МобильноеУстройство", МобильноеУстройство);
	Запрос.УстановитьПараметр("УникальныйИдентификатор", ИдентификаторЗапроса);

	РезультатЗапроса = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();

	Если ВыборкаДетальныеЗаписи.Следующий() Тогда

		Результат = Новый Структура;

		Результат.Вставить("Результат", ВыборкаДетальныеЗаписи.Результат);
		Результат.Вставить("Выполнено", ВыборкаДетальныеЗаписи.Выполнено);
		Результат.Вставить("ИдентификаторФоновогоЗадания", ВыборкаДетальныеЗаписи.ИдентификаторФоновогоЗадания);
		Результат.Вставить("ТекстОшибки", ВыборкаДетальныеЗаписи.ТекстОшибки);
		
		Возврат ВыборкаДетальныеЗаписи;

	Иначе

		Возврат Неопределено;

	КонецЕсли;

КонецФункции

Процедура ВыполнитьОбработкуСоставовКодовМаркировокВФоне(МобильноеУстройство, КодыМаркировкиКЗапросу,
	ИдентификаторЗапроса, ИдентификаторФоновогоЗадания)

	ПараметрыВыполнения = Новый Массив;

	ПараметрыВыполнения.Добавить(МобильноеУстройство);
	ПараметрыВыполнения.Добавить(КодыМаркировкиКЗапросу);
	ПараметрыВыполнения.Добавить(ИдентификаторЗапроса);

	ФоновыеЗадания.Выполнить("ОбработатьСоставКодовМаркировокВФоне", ПараметрыВыполнения,
		ИдентификаторФоновогоЗадания);

КонецПроцедуры

