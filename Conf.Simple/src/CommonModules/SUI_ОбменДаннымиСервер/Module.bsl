Функция ДокументОбменаОбновитьДанными(МобильноеУстройство, Данные)
	
	Загружено = Ложь;
	
	SUI_ОбщегоНазначенияКлиентСервер.ПроверитьПараметр("SUI_ОбменДаннымиСервер.ДокументОбменаОбновитьДанными", 
		"Данные", Данные, Тип("Структура"));
	
	ИдентификаторДокумента = SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Данные, "id_doc", "", Тип("Строка"));
	
	Если Не SUI_ИнтеграцияВКонфигурациюКлиентСервер.ЭтоИдентификаторSimple(ИдентификаторДокумента) Тогда
		
		ТекстОшибки = СтрШаблон(НСтр("ru = 'Передан неизвестный идентификатор документа ""%1""'"), ИдентификаторДокумента);
		ОбщегоНазначенияКлиентСервер.Проверить(Ложь, ТекстОшибки,
			"SUI_ОбменДаннымиСерверПереопределяемый.ЗагрузитьДанныеДокументов");
		
	КонецЕсли;
	
	ДанныеДляЗагрузки = РегистрыСведений.SUI_docs.ДанныеДляЗагрузкиИзМобильногоУстройства(
		ИдентификаторДокумента, МобильноеУстройство);
	
	Если Данные.Свойство("RS_docs_table") Тогда
		ДанныеДляЗагрузки.Таблицы.Товары = Данные.RS_docs_table;
	ИначеЕсли Данные.Свойство("RS_adr_docs_table") Тогда
		ДанныеДляЗагрузки.Таблицы.Товары = Данные.RS_adr_docs_table;
	КонецЕсли;
	
	Если Данные.Свойство("RS_docs_series") Тогда
		ДанныеДляЗагрузки.Таблицы.Серии = Данные.RS_docs_series;
	КонецЕсли;
	
	Если Данные.Свойство("RS_docs_barcodes") Тогда
		ДанныеДляЗагрузки.Таблицы.ШтрихкодыУпаковок = Данные.RS_docs_barcodes;
	КонецЕсли;
	
	Если Данные.Свойство("RS_barc_flow") Тогда
		ДанныеДляЗагрузки.Таблицы.ПотокШтрихкодов = Данные.RS_barc_flow;
	КонецЕсли;
	
	Если ДанныеДляЗагрузки.Таблицы.Количество() > 0 Тогда
		
		Результат = РегистрыСведений.SUI_docs.ЗагрузитьИзМобильногоУстройства(ДанныеДляЗагрузки);
		
		Если Результат Тогда
			Загружено = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Загружено;
	
КонецФункции

#Область ВосстановлениеДанныхJSON_ДанныеДокументов

Функция ВосстановлениеДанныхJSON_ДанныеДокумента_ТоварыДокумента(мсвДанные, АдресХранения = Неопределено)
	
	Таблица = SUI_ДокументыОбмена.ТаблицаТоварыДокументаОбмена();
	
	Если ТипЗнч(мсвДанные) = Тип("Массив") Тогда
		
		ПроверяемыеКлючи = Новый Соответствие();
		ПроверяемыеКлючи.Вставить("id_good", 		Истина);
		ПроверяемыеКлючи.Вставить("id_properties", 	Ложь);
		ПроверяемыеКлючи.Вставить("id_unit", 		Ложь);
		ПроверяемыеКлючи.Вставить("id_series", 		Ложь);
		ПроверяемыеКлючи.Вставить("id_cell", 		Ложь);
		ПроверяемыеКлючи.Вставить("id_price", 		Ложь);
		
		Для индекс = 0 По мсвДанные.ВГраница() Цикл
			
			Если Не мсвДанные[индекс].Свойство("table_type") Тогда
				ТипТаблицы = Перечисления.SUI_ТипыТаблицДокументовОбмена.Товары;
			Иначе
				
				Если мсвДанные[индекс].table_type = "in" Тогда
					ТипТаблицы = Перечисления.SUI_ТипыТаблицДокументовОбмена.Размещение;
				ИначеЕсли мсвДанные[индекс].table_type = "out" Тогда
					ТипТаблицы = Перечисления.SUI_ТипыТаблицДокументовОбмена.Отбор;
				Иначе
					ТекстОшибки = НСтр("ru = '[%1] Не удалось определить тип таблицы %2!'");
					ТекстОшибки = СтрШаблон(ТекстОшибки, индекс, мсвДанные[индекс].table_type);
					ВызватьИсключение ТекстОшибки;
				КонецЕсли;
			
			КонецЕсли;
			
			СтрокаТаблицы = Таблица.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, мсвДанные[индекс]);
			СтрокаТаблицы.ТипТаблицы = ТипТаблицы;
			
			Попытка
				ПроверитьЗаполнениеИдентификаторовПриВосстановленииДанныхJSON(СтрокаТаблицы, ПроверяемыеКлючи);
			Исключение
				ТекстОшибки = СтрШаблон("[%1] %2", индекс, ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
				ВызватьИсключение ТекстОшибки;
			КонецПопытки;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если ЭтоАдресВременногоХранилища(АдресХранения) Тогда
		Возврат ПоместитьВоВременноеХранилище(Таблица, АдресХранения);	
	Иначе 
		Возврат Таблица;	
	КонецЕсли;

КонецФункции

