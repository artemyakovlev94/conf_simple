Функция ВосстановлениеДанныхJSON_ДанныеДокумента_ТоварыДокумента(мсвДанные, АдресХранения = Неопределено)
	
	Таблица = SUI_ДокументыОбмена.ТаблицаТоварыДокументаОбмена();
	
	Если ТипЗнч(мсвДанные) = Тип("Массив") Тогда

		Для Каждого Элемент Из мсвДанные Цикл 
			
			Если ТипЗнч(Элемент) <> Тип("Структура") Тогда
				Продолжить;	
			КонецЕсли; 
			
			Если Не Элемент.Свойство("table_type") Тогда
				ТипТаблицы = Перечисления.SUI_ТипыТаблицДокументовОбмена.Товары;
			Иначе
				
				Если Элемент.table_type = "in" Тогда
					ТипТаблицы = Перечисления.SUI_ТипыТаблицДокументовОбмена.Размещение;
				ИначеЕсли Элемент.table_type = "out" Тогда
					ТипТаблицы = Перечисления.SUI_ТипыТаблицДокументовОбмена.Отбор;
				Иначе
					Продолжить;
				КонецЕсли;
			
			КонецЕсли;
			
			СтрокаТаблицы = Таблица.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, Элемент);
			
			СтрокаТаблицы.ТипТаблицы = ТипТаблицы;

		КонецЦикла;
	
	КонецЕсли;
	
	Если ЭтоАдресВременногоХранилища(АдресХранения) Тогда
		Возврат ПоместитьВоВременноеХранилище(Таблица, АдресХранения);	
	Иначе 
		Возврат Таблица;	
	КонецЕсли;

КонецФункции

Функция ВосстановлениеДанныхJSON_ДанныеДокумента_СерииДокумента(мсвДанные, АдресХранения = Неопределено)
	
	Таблица = SUI_ДокументыОбмена.ТаблицаСерииДокументаОбмена();
	
	Если ТипЗнч(мсвДанные) = Тип("Массив") Тогда

		Для Каждого Элемент Из мсвДанные Цикл 
			
			Если ТипЗнч(Элемент) <> Тип("Структура") Тогда
				Продолжить;	
			КонецЕсли;
			
			НоваяСтрока = Таблица.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Элемент);
			
			НоваяСтрока.name = ОбщегоНазначенияКлиентСервер.УдалитьНедопустимыеСимволыXML(НоваяСтрока.name);
			НоваяСтрока.number = ОбщегоНазначенияКлиентСервер.УдалитьНедопустимыеСимволыXML(НоваяСтрока.number);
			
		КонецЦикла;
	
	КонецЕсли;

	Если ЭтоАдресВременногоХранилища(АдресХранения) Тогда
		Возврат ПоместитьВоВременноеХранилище(Таблица, АдресХранения);
	Иначе 
		Возврат Таблица;	
	КонецЕсли;

КонецФункции

Функция ВосстановлениеДанныхJSON_ДанныеДокумента_ШтрихкодыДокумента(мсвДанные, АдресХранения = Неопределено)
	
	Таблица = SUI_ДокументыОбмена.ТаблицаШтрихкодыДокументаОбмена();
	
	Если SUI_НастройкиМетаданныхСервер.ТаблицаИспользуется(Перечисления.SUI_ТаблицыИнтеграции.ШтрихкодыУпаковок) И
		ТипЗнч(мсвДанные) = Тип("Массив") Тогда
		
		НастройкаШтрихкодовУпаковок = SUI_НастройкиМетаданныхСервер.ПолучитьДополнительныеНастройки(
			Перечисления.SUI_ТаблицыИнтеграции.ШтрихкодыУпаковок);
		АлгоритмНормализации = SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(НастройкаШтрихкодовУпаковок,
			"АлгоритмНормализацииЗначенияШтрихкода.Алгоритм", "", Тип("Строка"));
		
		ОписаниеТипаШтрихкод = SUI_ОбщегоНазначения.ОписаниеТипаСтрока(200);
		
		Для Каждого Элемент Из мсвДанные Цикл
			
			ШтрихкодBase64 = SUI_ШтрихкодированиеКлиентСервер.ШтрихкодВBase64(
				ОписаниеТипаШтрихкод.ПривестиЗначение(Элемент.barcode_from_scanner));
			SSCCBase64 = SUI_ШтрихкодированиеКлиентСервер.ШтрихкодВBase64(
				ОписаниеТипаШтрихкод.ПривестиЗначение(Элемент.SSCC));
			
			Элемент.Вставить("barcode_from_scanner", ОбщегоНазначенияКлиентСервер.УдалитьНедопустимыеСимволыXML(
				ОписаниеТипаШтрихкод.ПривестиЗначение(Элемент.barcode_from_scanner)));
			
			Если ПустаяСтрока(Элемент.barcode_from_scanner) Тогда
				Продолжить;
			КонецЕсли;
			
			Номенклатура = SUI_ИнтеграцияВКонфигурацию.СсылкаПоИдентификаторуSimple(Элемент.id_good, Истина);
			
			Элемент.Вставить("mark_code", SUI_ШтрихкодыУпаковок.НормализоватьЗначениеШтрихкода(
				АлгоритмНормализации, Элемент.barcode_from_scanner, Номенклатура));
			
			Если ПустаяСтрока(Элемент.mark_code) Тогда
				Продолжить;
			КонецЕсли;
			
			Элемент.Вставить("SSCC", SUI_ШтрихкодыУпаковок.НормализоватьЗначениеШтрихкода(
				АлгоритмНормализации, Элемент.SSCC, Номенклатура));
			
			НоваяСтрока = Таблица.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Элемент);
			
			НоваяСтрока.ШтрихкодBase64 = ШтрихкодBase64;
			НоваяСтрока.SSCCBase64 = SSCCBase64;
			
		КонецЦикла;
		
	КонецЕсли;

	Если ЭтоАдресВременногоХранилища(АдресХранения) Тогда
		Возврат ПоместитьВоВременноеХранилище(Таблица, АдресХранения);	
	Иначе 
		Возврат Таблица;	
	КонецЕсли;

КонецФункции

Функция ВосстановлениеДанныхJSON_ДанныеДокумента_ПотокШтрихкодов(мсвДанные, АдресХранения = Неопределено)
	
	Таблица = SUI_ДокументыОбмена.ТаблицаПотокШтрихкодовОбмена();
	
	Если ТипЗнч(мсвДанные) = Тип("Массив") Тогда

		Для Каждого Элемент Из мсвДанные Цикл
			
			Если ТипЗнч(Элемент) <> Тип("Структура") Тогда
				Продолжить;	
			КонецЕсли;
			
			НоваяСтрока = Таблица.Добавить();
			НоваяСтрока.ШтрихкодBase64 = SUI_ШтрихкодированиеКлиентСервер.ШтрихкодВBase64(Элемент.barcode);
			НоваяСтрока.ЭтоШтрихкодКМ = SUI_ШтрихкодированиеКлиентСервер.ЭтоШтрихкодКМ(Элемент.barcode);
			
			Если Не НоваяСтрока.ЭтоШтрихкодКМ Тогда
				НоваяСтрока.ЭтоШтрихкодSSCC = SUI_ШтрихкодированиеКлиентСервер.ЭтоШтрихкодSSCC(Элемент.barcode);
			КонецЕсли;
			
			НоваяСтрока.barcode = ОбщегоНазначенияКлиентСервер.УдалитьНедопустимыеСимволыXML(Элемент.barcode);
			
		КонецЦикла;

	КонецЕсли;
	
	Если ЭтоАдресВременногоХранилища(АдресХранения) Тогда
		Возврат ПоместитьВоВременноеХранилище(Таблица, АдресХранения);	
	Иначе 
		Возврат Таблица;
	КонецЕсли;

КонецФункции

Функция ВосстановлениеДанныхJSON_ДанныеДокумента_ПересчетТоваровДокумента(мсвДанные) 
	
	Таблица = SUI_ДокументыОбмена.ТаблицаПересчетТоваровДокументаОбмена();
	
	Если мсвДанные.Количество() > 0 Тогда 
		
		Если мсвДанные[0].Свойство("id_doc") И Таблица.Колонки.Найти("id_doc") = Неопределено Тогда 
			Таблица.Колонки.Добавить("id_doc", SUI_ОбщегоНазначения.ОписаниеТипаСтрока(69));		
		КонецЕсли;
		
	КонецЕсли;
	
	Для Каждого Элемент Из мсвДанные Цикл
		
		Если Не Элемент.Свойство("table_type") Тогда
			ТипТаблицы = Перечисления.SUI_ТипыТаблицДокументовОбмена.Товары;
		Иначе
			
			Если Элемент.table_type = "in" Тогда
				ТипТаблицы = Перечисления.SUI_ТипыТаблицДокументовОбмена.Размещение;
			ИначеЕсли Элемент.table_type = "out" Тогда
				ТипТаблицы = Перечисления.SUI_ТипыТаблицДокументовОбмена.Отбор;
			Иначе
				Продолжить;
			КонецЕсли;
		
		КонецЕсли;
		
		
		СтрокаТаблицы = Таблица.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, Элемент);
		
		СтрокаТаблицы.ТипТаблицы = ТипТаблицы;
		
	КонецЦикла;

	Возврат Таблица;
	
КонецФункции

Функция ВосстановлениеДанныхJSON_ДанныеШтрихкодов_СоздатьШтрихкодыНоменклатуры(мсвДанные) 
	
	Таблица = Новый ТаблицаЗначений();
	Таблица.Колонки.Добавить("barcode", SUI_ОбщегоНазначения.ОписаниеТипаСтрока(200));
	Таблица.Колонки.Добавить("id_good", SUI_ОбщегоНазначения.ОписаниеТипаСтрока(69));
	Таблица.Колонки.Добавить("id_property", SUI_ОбщегоНазначения.ОписаниеТипаСтрока(69));
	Таблица.Колонки.Добавить("id_unit", SUI_ОбщегоНазначения.ОписаниеТипаСтрока(69));

	Для Каждого Элемент Из мсвДанные Цикл
		
		НоваяСтрока = Таблица.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Элемент);
		
		НоваяСтрока.barcode = ОбщегоНазначенияКлиентСервер.УдалитьНедопустимыеСимволыXML(НоваяСтрока.barcode);

		ОбщегоНазначенияКлиентСервер.Проверить(ЗначениеЗаполнено(НоваяСтрока.barcode),
			НСтр("ru = 'Передано пустое значение штрихкода номенклатуры.'"));
			
		ОбщегоНазначенияКлиентСервер.Проверить(ЗначениеЗаполнено(НоваяСтрока.id_good),
			НСтр("ru = 'Не заполнен идентификатор номенклатуры.'"));
		
	КонецЦикла;
	
	Таблица.Свернуть("barcode,id_good,id_property,id_unit");

	Возврат Таблица;
	
КонецФункции

