
#Область ПрограммныйИнтерфейс

// Получить данные для ответа HTTP
//
// Параметры:
//  МобильноеУстройство	- СправочникСсылка.Удалить_SUI_МобильныеКлиенты, ПланОбменаСсылка.SUI_МобильныеУстройства - Ссылка на мобильное устройство
//  НСИ		 			- Булево - Признак получения данных НСИ
//  Документы 			- Булево - Признак получения данных документов обмена
// 
// Возвращаемое значение:
//  Структура - см. SUI_HTTPСервис.РезультатУспех
//
Функция ПолучитьДанные(МобильноеУстройство, НСИ = Истина, Документы = Истина, ОфлайнОбмен = Ложь) Экспорт
	
	Данные = SUI_СообщенияОбменаДанными.ПолучитьСообщениеДляМобильногоУстройства(МобильноеУстройство, Истина);
	
	Если ОфлайнОбмен Тогда
		Возврат Данные;		
	Иначе
		Результат = SUI_HTTPСервис.РезультатУспех(Данные.Данные);
		SUI_HTTPСервис.ДобавитьЗаголовокВРезультат(Результат, "Remaining-Batches", Данные.ОстатокПакетов);
		Возврат Результат;
	КонецЕсли;

КонецФункции

Функция СоздатьДокумент(МобильноеУстройство, НастройкаДокумента) Экспорт
	
	НастройкиДокумента = SUI_НастройкиДокументовСервер.СформироватьНастройкиДокумента(НастройкаДокумента);
	
	ОбщегоНазначенияКлиентСервер.Проверить(НастройкиДокумента.Используется,
		СтрШаблон(НСтр("ru = 'Настройка %1 не используется'"), НастройкаДокумента));
	
	ОбщегоНазначенияКлиентСервер.Проверить(НастройкиДокумента.СоздаватьДокументыНаТСД,
		СтрШаблон(НСтр("ru = 'Для настройки %1 режим создания документов выключен'"), НастройкаДокумента));
	
	ОбщегоНазначенияКлиентСервер.Проверить(
		SUI_НастройкиДокументовСервер.НастройкаДокументаПринадлежитМобильномуКлиенту(НастройкаДокумента, МобильноеУстройство),
		СтрШаблон(НСтр("ru = 'Настройка %1 не принадлежит мобильному устройству %2'"), НастройкаДокумента, МобильноеУстройство));
	
	НачатьТранзакцию();
	
	Попытка
		
		УстановитьПривилегированныйРежим(Истина);
		
		НовыйДокумент = Документы[НастройкиДокумента.ИмяМетаданных].СоздатьДокумент();
		НовыйДокумент.Дата = ТекущаяДатаСеанса();
		НовыйДокумент.УстановитьНовыйНомер();
		
		Результат = Обработки.SUI_РедакторКода.ВыполнитьКодЧерезМетодКонфигурации(
			"SUI_ОбменДаннымиСервер.ВыполнитьАлгоритмСозданияДокумента",
			НастройкиДокумента.АлгоритмСозданияНовогоДокумента,
			SUI_ОбщегоНазначенияКлиентСервер.МассивЗначений(МобильноеУстройство, НовыйДокумент),
			Истина);
		
		НовыйДокумент = Результат[Результат.ВГраница()];
		
		Если НовыйДокумент.Ссылка.Пустая() Тогда
			НовыйДокумент.ОбменДанными.Загрузка = Истина;
			НовыйДокумент.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;
		
		ОбщегоНазначенияКлиентСервер.Проверить(
			SUI_НастройкиДокументовСервер.ДокументСоответствуетОтборуНастройки(НастройкаДокумента, НовыйДокумент.Ссылка), 
			СтрШаблон(НСтр("ru = 'Сформированный документ не соответствует критериям отбора настройки документа ""%1"".'"), 
			НастройкаДокумента));
		
		// Выгрузить документ на ТСД
		ПараметрыВыгрузкиДокументаОбмена = SUI_ДокументыОбмена.ПараметрыВыгрузкиДокументаОбмена();
		ПараметрыВыгрузкиДокументаОбмена.МобильноеУстройство 	= МобильноеУстройство;
		ПараметрыВыгрузкиДокументаОбмена.НастройкаДокумента 	= НастройкаДокумента.Ссылка;
		ПараметрыВыгрузкиДокументаОбмена.ДокументСсылка 		= НовыйДокумент.Ссылка;
		ПараметрыВыгрузкиДокументаОбмена.Вставить("SUI_АдресноеХранение", НастройкиДокумента.ЭтоДокументАдресногоХранения);
		ПараметрыВыгрузкиДокументаОбмена.Вставить("НеРегистрироватьИзменения");
		
		ДанныеДокументаОбмена = SUI_ДокументыОбмена.ВыгрузитьИПолучитьДокументОбмена(ПараметрыВыгрузкиДокументаОбмена);
		
		ОбщегоНазначенияКлиентСервер.Проверить(ДанныеДокументаОбмена <> Неопределено, 
			НСтр("ru = 'Не удалось получить данные созданного документа.'"));
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат SUI_HTTPСервис.РезультатУспех(ДанныеДокументаОбмена);
	
КонецФункции

// Загрузить данные.
// 
// Параметры:
//  МобильноеУстройство - СправочникСсылка.Удалить_SUI_МобильныеКлиенты, ПланОбменаСсылка.SUI_МобильныеУстройства - Мобильное устройство
//  ДанныеДокументов - Массив - Данные документов
// 
// Возвращаемое значение:
//  Структура - Загрузить данные:
// * КодСостояния - Число - Код HTTP состояния
// * ТекстОшибки - Строка - Текст ошибки
// * Данные - Произвольный, Структура, Массив, Неопределено -:
// ** result - Булево -
// * Заголовки - Соответствие, Неопределено -
//@skip-check doc-comment-collection-item-type
Функция ЗагрузитьДанныеДокументов(МобильноеУстройство, ДанныеДокументов, ОфлайнОбмен = Ложь) Экспорт
	
	ТипЗначенияДанныеДокументов = ТипЗнч(ДанныеДокументов);
	
	Если ПолучитьФункциональнуюОпцию("SUI_ОнлайнОбмен") И ТипЗначенияДанныеДокументов = Тип("Строка") Тогда
		
		ДанныеДокументов = SUI_СообщенияОбменаДанными.ВосстановитьСжатуюСтроку(ДанныеДокументов);
		Если Не ПустаяСтрока(ДанныеДокументов) Тогда
			ДанныеДокументов = SUI_ОбщегоНазначенияКлиентСервер.ДанныеИзСтрокиJSON(ДанныеДокументов, Ложь, , ,
				"ВосстановлениеДанныхJSON_ДанныеДокумента", SUI_ОбменДаннымиСервер);
			ТипЗначенияДанныеДокументов = ТипЗнч(ДанныеДокументов);
		КонецЕсли;
		
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.Проверить(ТипЗначенияДанныеДокументов = Тип("Массив"),
		СтрШаблон(НСтр("ru = 'Тип данных документов должен быть типом ""Массив"". Полученный тип: ""%1""'"), ТипЗначенияДанныеДокументов));
	
	РезультатЗагрузки = Новый Структура();
	РезультатЗагрузки.Вставить("total", ДанныеДокументов.Количество());
	РезультатЗагрузки.Вставить("quantity_uploaded", 0);
	
	Для Индекс = 0 По ДанныеДокументов.ВГраница() Цикл
		
		ПараметрыЗагрузки = SUI_ДокументыОбмена.ПараметрыЗагрузкиДокументаОбмена();
		ПараметрыЗагрузки.МобильноеУстройство = МобильноеУстройство;
		ПараметрыЗагрузки.Данные.id_doc = SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(
			ДанныеДокументов[Индекс], "id_doc", "", Тип("Строка"));

		Если ДанныеДокументов[Индекс].Свойство("RS_docs_table") Тогда
			ПараметрыЗагрузки.Данные.Таблицы.Вставить(Перечисления.SUI_ТипыТаблицДокументовОбмена.Товары,
				SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеДокументов[Индекс], "RS_docs_table",
				SUI_ДокументыОбмена.ТаблицаТоварыДокументаОбмена()));
		ИначеЕсли ДанныеДокументов[Индекс].Свойство("RS_adr_docs_table") Тогда
			ПараметрыЗагрузки.Данные.Таблицы.Вставить(Перечисления.SUI_ТипыТаблицДокументовОбмена.Товары,
				SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеДокументов[Индекс], "RS_adr_docs_table",
				SUI_ДокументыОбмена.ТаблицаТоварыДокументаОбмена()));
		КонецЕсли;
		
		ПараметрыЗагрузки.Данные.Таблицы.Вставить(Перечисления.SUI_ТипыТаблицДокументовОбмена.Серии,
			SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(
				ДанныеДокументов[Индекс], "RS_docs_series", SUI_ДокументыОбмена.ТаблицаСерииДокументаОбмена()));
			
		ПараметрыЗагрузки.Данные.Таблицы.Вставить(Перечисления.SUI_ТипыТаблицДокументовОбмена.ШтрихкодыУпаковок,
			SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(
				ДанныеДокументов[Индекс], "RS_docs_barcodes", SUI_ДокументыОбмена.ТаблицаШтрихкодыДокументаОбмена()));
			
		ПараметрыЗагрузки.Данные.Таблицы.Вставить(Перечисления.SUI_ТипыТаблицДокументовОбмена.ПотокШтрихкодов,
			SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(
				ДанныеДокументов[Индекс], "RS_barc_flow", SUI_ДокументыОбмена.ТаблицаПотокШтрихкодовОбмена()));
		
		ДанныеЗагружены = SUI_ДокументыОбмена.ЗагрузитьДокументОбмена(ПараметрыЗагрузки);
		
		Если ДанныеЗагружены Тогда
			РезультатЗагрузки.quantity_uploaded = РезультатЗагрузки.quantity_uploaded + 1;
		КонецЕсли;

	КонецЦикла;
	
	РезультатЗагрузки.Вставить("result", (РезультатЗагрузки.total > 0 И РезультатЗагрузки.quantity_uploaded > 0));
	
	Возврат РезультатЗагрузки;
	
КонецФункции

#Область ГрупповойПересчетДокумента

Функция ПолучитьДанныеГрупповогоПересчетаДокумента(МобильноеУстройство, ИдентификаторДокумента) Экспорт
	Возврат SUI_HTTPСервис.РезультатУспех(
		SUI_ДокументыОбмена.ПолучитьДанныеПересчетаСтрок(МобильноеУстройство, ИдентификаторДокумента));
КонецФункции

Функция ЗагрузитьДанныеГрупповогоПересчетаДокумента(МобильноеУстройство, ИдентификаторДокумента, ТаблицаПересчета, Перезапись = Ложь) Экспорт

	Если ТаблицаПересчета.Колонки.Найти("id_doc") = Неопределено Тогда
		
		ПараметрыЗагрузки = SUI_ДокументыОбмена.ПараметрыЗагрузкиДокументаОбмена();
		ПараметрыЗагрузки.Вставить("НеРегистрироватьИзменения");
		ПараметрыЗагрузки.МобильноеУстройство = МобильноеУстройство;
		
		Если Перезапись Тогда
			ПараметрыЗагрузки.Вставить("ПерезаписьРезультатов");
		КонецЕсли; 
		
		ПараметрыЗагрузки.Данные.id_doc = ИдентификаторДокумента; 
		ПараметрыЗагрузки.Данные.Таблицы.Вставить("ТаблицаПересчетТоваров", ТаблицаПересчета);	
		ДанныеЗагружены = SUI_ДокументыОбмена.ЗагрузитьДокументОбмена(ПараметрыЗагрузки);
			
	Иначе 
		
		ТаблицаПересчетаКопия = ТаблицаПересчета.Скопировать();
		ТаблицаПересчетаКопия.Свернуть("id_doc"); 
		
		РезультатЗагрузки = Новый Структура("Количество, КоличествоЗагружено", ТаблицаПересчетаКопия.Количество(),0);
		
		Для каждого СтрокаТаблицыКопии Из ТаблицаПересчетаКопия Цикл
			
			ПараметрыЗагрузки = SUI_ДокументыОбмена.ПараметрыЗагрузкиДокументаОбмена();
			ПараметрыЗагрузки.Вставить("НеРегистрироватьИзменения");
			ПараметрыЗагрузки.МобильноеУстройство = МобильноеУстройство;
			
			Если Перезапись Тогда
				ПараметрыЗагрузки.Вставить("ПерезаписьРезультатов");
			КонецЕсли;
			
			ПараметрыЗагрузки.Данные.id_doc = СтрокаТаблицыКопии.id_doc;
			
			МассивСтрокПоДокументу = ТаблицаПересчета.НайтиСтроки(Новый Структура("id_doc", СтрокаТаблицыКопии.id_doc)); 
			
			ПараметрыЗагрузки.Данные.Таблицы.Вставить("ТаблицаПересчетТоваров", ТаблицаПересчета.Скопировать(МассивСтрокПоДокументу));
			
			ДанныеЗагружены = SUI_ДокументыОбмена.ЗагрузитьДокументОбмена(ПараметрыЗагрузки);
			
		КонецЦикла;	
		
	КонецЕсли;

	Если SUI_ИнтеграцияВКонфигурациюВызовСервера.ИспользуетсяВариантОбменаОнлайн() Тогда
		РезультатЗагрузки = Новый Структура("result", ДанныеЗагружены);
		РезультатЗагрузки.Вставить("data", SUI_ДокументыОбмена.ПолучитьДанныеПересчетаСтрок(МобильноеУстройство, ИдентификаторДокумента));		
		Возврат SUI_HTTPСервис.РезультатУспех(РезультатЗагрузки); 
	Иначе
		Возврат ДанныеЗагружены;
	КонецЕсли;
	
КонецФункции

Функция ЗавершитьГрупповойПересчетДокумента(МобильноеУстройство, ИдентификаторДокумента, Знач ДополнительныеПараметры = Неопределено) Экспорт
	
	ОписаниеТипаСтруктура = Новый ОписаниеТипов("Структура");
	ДополнительныеПараметры = ОписаниеТипаСтруктура.ПривестиЗначение(ДополнительныеПараметры);
		
	ПараметрыЗагрузки = SUI_ДокументыОбмена.ПараметрыЗагрузкиДокументаОбмена();
	ПараметрыЗагрузки.МобильноеУстройство = МобильноеУстройство;
	ПараметрыЗагрузки.Данные.id_doc = ИдентификаторДокумента;
	
	ПараметрыЗагрузки.Вставить("НеРегистрироватьИзменения");
	ПараметрыЗагрузки.Вставить("ЗавершитьГрупповойПересчетДокументаОбмена");
	
	Если ДополнительныеПараметры.Свойство("ИнтерактивноеЗавершение") Тогда
		ПараметрыЗагрузки.Вставить("ОтключитьПостобработкуДокументаОбмена");
	КонецЕсли;

	ДанныеЗагружены = SUI_ДокументыОбмена.ЗагрузитьДокументОбмена(ПараметрыЗагрузки);

	Если ДополнительныеПараметры.Свойство("ИнтерактивноеЗавершение") Тогда
		
		ПараметрыЗадания = Новый Структура();
		ПараметрыЗадания.Вставить("sid_doc", SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(
			ДополнительныеПараметры, "sid", "", Тип("Строка")));

		Если ДанныеЗагружены И Не ПустаяСтрока(ПараметрыЗадания.sid_doc) Тогда
			SUI_ДокументыОбмена.ЗаданиеЗагрузитьИтогиПересчетаВДокументОбмена(ПараметрыЗадания);
		КонецЕсли;
		
		Возврат ДанныеЗагружены;
				
	Иначе
		Возврат SUI_HTTPСервис.РезультатУспех(Новый Структура("result", ДанныеЗагружены));
	КонецЕсли;
	
КонецФункции

#КонецОбласти

Функция ПолучитьЦеныНоменклатуры(ПараметрыПолучения) Экспорт

	мсвДанныеЦенНоменклатуры = Новый Массив();

	Запрос = Новый Запрос;

	Запрос.УстановитьПараметр("Номенклатура", SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыПолучения, 
		"Номенклатура", Справочники.Номенклатура.ПустаяСсылка(), Тип("СправочникСсылка.Номенклатура")));
	Запрос.УстановитьПараметр("Характеристика", SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыПолучения, 
		"Характеристика", Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка(), Тип("СправочникСсылка.ХарактеристикиНоменклатуры")));
	Запрос.УстановитьПараметр("Упаковка", SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыПолучения, 
		"Упаковка", Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка(), Тип("СправочникСсылка.УпаковкиЕдиницыИзмерения")));
	Запрос.УстановитьПараметр("ВидЦены", SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыПолучения, 
		"ВидЦены", Справочники.ВидыЦен.ПустаяСсылка(), Тип("СправочникСсылка.ВидыЦен")));
	
	ОбщегоНазначенияКлиентСервер.Проверить(ЗначениеЗаполнено(Запрос.Параметры.Номенклатура), 
		НСтр("ru = 'Передано пустое значение параметра номенклатуры'"), 
		КонтекстВызова("ПолучитьЦеныНоменклатуры"));

	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЦеныНоменклатуры.Номенклатура КАК id_good,
		|	ЕСТЬNULL(ЦеныНоменклатуры.Номенклатура.Представление, """") КАК name_good,
		|	ЦеныНоменклатуры.Характеристика КАК id_property,
		|	ЕСТЬNULL(ЦеныНоменклатуры.Характеристика.Представление, """") КАК name_property,
		|	ЦеныНоменклатуры.ВидЦены КАК id_price_type,
		|	ЕСТЬNULL(ЦеныНоменклатуры.ВидЦены.Представление, """") КАК name_price_type,
		|	ЦеныНоменклатуры.Упаковка КАК id_unit,
		|	ЕСТЬNULL(ЦеныНоменклатуры.Упаковка.Представление, """") КАК name_unit,
		|	ЦеныНоменклатуры.Цена КАК price
		|ИЗ
		|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
		|			,
		|			Номенклатура = &Номенклатура
		|				И ВЫБОР
		|					КОГДА &Характеристика <> ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
		|						ТОГДА Характеристика = &Характеристика
		|					ИНАЧЕ ИСТИНА
		|				КОНЕЦ
		|				И ВЫБОР
		|					КОГДА &ВидЦены <> ЗНАЧЕНИЕ(Справочник.ВидыЦен.ПустаяСсылка)
		|						ТОГДА ВидЦены = &ВидЦены
		|					ИНАЧЕ ИСТИНА
		|				КОНЕЦ
		|				И ВЫБОР
		|					КОГДА &Упаковка <> ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
		|						ТОГДА Упаковка = &Упаковка
		|					ИНАЧЕ ИСТИНА
		|				КОНЕЦ) КАК ЦеныНоменклатуры";

	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = Запрос.Выполнить();

	Если Не РезультатЗапроса.Пустой() Тогда
		
		ИменаКолонок = SUI_ОбщегоНазначения.ПолучитьИменаКолонокРезультатаЗапроса(РезультатЗапроса);

		Выборка = РезультатЗапроса.Выбрать();

		Пока Выборка.Следующий() Цикл
			
			сткДанныеЦеныНоменклатуры = Новый Структура(ИменаКолонок);
			ЗаполнитьЗначенияСвойств(сткДанныеЦеныНоменклатуры, Выборка);
			мсвДанныеЦенНоменклатуры.Добавить(сткДанныеЦеныНоменклатуры);
	
		КонецЦикла;
	
	КонецЕсли;

	Возврат SUI_HTTPСервис.РезультатУспех(мсвДанныеЦенНоменклатуры);

КонецФункции

Функция ПолучитьОстаткиНоменклатурыВЯчейке(ПараметрыПолучения) Экспорт

