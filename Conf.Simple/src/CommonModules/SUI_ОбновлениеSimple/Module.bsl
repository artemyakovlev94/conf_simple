
#Область ПрограммныйИнтерфейс

Функция СведенияОРасширении(ВызыватьИсключение = Истина) Экспорт
	
	Сведения = Новый Структура();
	Сведения.Вставить("Ошибка");
	Сведения.Вставить("УникальныйИдентификатор");
	Сведения.Вставить("Имя");
	Сведения.Вставить("Синоним");
	Сведения.Вставить("Версия");
	Сведения.Вставить("Активно");
	
	Расширение = SUI_Simple.ЭтоРасширение();
	
	Если Расширение = Неопределено Тогда
		Сведения.Ошибка = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Не удалось получить расширение информационной базы по имени %1'"), SUI_SimpleКлиентСервер.ИмяРасширения());
	Иначе
		ЗаполнитьЗначенияСвойств(Сведения, Расширение);
	КонецЕсли;

	Если ВызыватьИсключение И Сведения.Ошибка <> Неопределено Тогда
		ВызватьИсключение Сведения.Ошибка;
	КонецЕсли;

	Возврат Сведения;
	
КонецФункции

Функция ТекущаяВерсияКонфигурации(ВызыватьИсключение = Истина) Экспорт
	
	Сведения = СведенияОРасширении(ВызыватьИсключение);
	
	Если Сведения.Ошибка <> Неопределено Тогда
		Возврат "";
	Иначе
		Возврат Сведения.Версия;
	КонецЕсли;
	
КонецФункции

// Добавляет в список процедуры-обработчики обновления данных ИБ.
// Вызывается перед началом обновления данных ИБ для построения плана обновления.
//
// Параметры:
//  Обработчики - см. SUI_ОбновлениеSimple.ТаблицаОбработчиковОбновления
//
// Пример:
//  Для добавления своей процедуры-обработчика в список:
//  Обработчик = Обработчики.Добавить();
//  Обработчик.Версия              = "1.0.2";
//  Обработчик.Процедура           = "ОбновлениеИБ.ПерейтиНаВерсию_1_0_2";
//  Обработчик.РежимВыполнения     = "Оперативно";
//
Процедура ПриДобавленииОбработчиковОбновления(Обработчики) Экспорт
	
	// Обработчики, выполняемые при каждом обновлении ИБ.
	
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия = "*";
	Обработчик.Процедура = "SUI_ОбновлениеSimple.ВыполнятьВсегдаПриСменеВерсии";
	Обработчик.РежимВыполнения = "Оперативно";
	
	// Обработчики, выполняемые при заполнении пустой ИБ.
	
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия 				= "1.0.0.0";
	Обработчик.Процедура 			= "SUI_ОбновлениеSimple.ПервыйЗапуск";
	Обработчик.НачальноеЗаполнение 	= Истина;
	Обработчик.РежимВыполнения 		= "Оперативно";
	
	// Мобильные устройства
	SUI_МобильныеУстройстваСервер.ПриДобавленииОбработчиковОбновления(Обработчики);
	
	// Регламентные задания
	SUI_РегламентныеЗадания.ПриДобавленииОбработчиковОбновления(Обработчики);
	
	// Логирование HTTP запросов
	SUI_ЛогированиеHTTPЗапросов.ПриДобавленииОбработчиковОбновления(Обработчики);
	
	// Настройки метаданных
	SUI_НастройкиМетаданныхСервер.ПриДобавленииОбработчиковОбновления(Обработчики);
	
	// Настройки документов
	SUI_НастройкиДокументовСервер.ПриДобавленииОбработчиковОбновления(Обработчики);
	
	// Пакеты данных
	SUI_ПакетыДанных.ПриДобавленииОбработчиковОбновления(Обработчики);
	
	// Справочник Настройки мобильных устройств
	Справочники.SUI_НастройкиМобильныхУстройств.ПриДобавленииОбработчиковОбновления(Обработчики);
	
КонецПроцедуры

