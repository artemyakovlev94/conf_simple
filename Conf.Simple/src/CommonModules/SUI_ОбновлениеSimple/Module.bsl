	Константы.SUI_ВерсияДанных.Установить(НомерВерсии);
КонецПроцедуры

Процедура СообщениеПрогессаВыполненияОбработчика(Вес, СчетчикСообщения, ТекущийСчетчик, ДополнительныйТекст = "") Экспорт
	
	ПроцентВыполнения = Окр(ТекущийСчетчик*100/Вес);
	
	Если ПроцентВыполнения > СчетчикСообщения Тогда
		СчетчикСообщения = Окр(ПроцентВыполнения, -1);
	КонецЕсли;
	
	Если ПроцентВыполнения > 0 И ПроцентВыполнения = СчетчикСообщения Тогда
		СообщитьПрогрессВыполненияОбработчика(ПроцентВыполнения, ДополнительныйТекст);
		СчетчикСообщения = СчетчикСообщения+10;
	КонецЕсли;
	
КонецПроцедуры

Процедура СообщитьПрогрессВыполненияОбработчика(ЗначениеВПроцентах, ДополнительныйТекст = "") Экспорт
	
	ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = '%1 Выполнено: %2%'"), 
		SUI_ОбновлениеSimpleКлиентСервер.КлючСообщенияПрогрессаВыполненияОбработчикаОбновления(), ЗначениеВПроцентах);
		
	Если Не ПустаяСтрока(ДополнительныйТекст) Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = '%1 (%2)'"), ТекстСообщения, ДополнительныйТекст);
	КонецЕсли;
	
	ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	
КонецПроцедуры

