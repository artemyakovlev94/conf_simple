
#Область ПрограммныйИнтерфейс

Процедура ВыгрузитьНастройки(Оповещение = Неопределено) Экспорт
	
	АдресНастройки = ПоместитьВоВременноеХранилище(Неопределено, Новый УникальныйИдентификатор());
	
	SUI_НастройкиМетаданныхВызовСервера.ПолучитьНастройкиДляВыгрузки(АдресНастройки);

	ОповещениеОЗавершении = Новый ОписаниеОповещения("ВыгрузитьНастройкуЗавершение", ЭтотОбъект, Новый Структура("Оповещение", Оповещение));

	ПараметрыСохранения = ФайловаяСистемаКлиент.ПараметрыСохраненияФайла();
	
	ПараметрыСохранения.Диалог.Заголовок = СтрШаблон(НСтр("ru = 'Сохранение настройки %1'"), SUI_SimpleКлиентСервер.Представление());
	ПараметрыСохранения.Диалог.Фильтр = СтрШаблон(НСтр("ru = 'Настройка %1'"), SUI_SimpleКлиентСервер.Представление()) + " (*.xml)|*.xml";
	ПараметрыСохранения.Диалог.МножественныйВыбор = Ложь;
	
	ФайловаяСистемаКлиент.СохранитьФайл(ОповещениеОЗавершении, АдресНастройки,
		СтрШаблон(НСтр("ru = 'Настройка%1.xml'"), SUI_SimpleКлиентСервер.ИмяРасширения()), ПараметрыСохранения);
	
КонецПроцедуры

Процедура ЗагрузитьНастройки(Форма, Оповещение) Экспорт
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ЗагрузитьНастройкуПослеВыбораФайла", ЭтотОбъект, 
		Новый Структура("Форма, Оповещение", Форма, Оповещение));
	
	ПараметрыЗагрузки = ФайловаяСистемаКлиент.ПараметрыЗагрузкиФайла();
	
	ПараметрыЗагрузки.Диалог.Заголовок = СтрШаблон(НСтр("ru = 'Загрузка настройки %1'"), SUI_SimpleКлиентСервер.Представление());
	ПараметрыЗагрузки.Диалог.Фильтр = СтрШаблон(НСтр("ru = 'Настройка %1'"), SUI_SimpleКлиентСервер.Представление()) + " (*.xml)|*.xml";
	ПараметрыЗагрузки.Диалог.МножественныйВыбор = Ложь;
	
	ФайловаяСистемаКлиент.ЗагрузитьФайл(ОповещениеОЗавершении, ПараметрыЗагрузки);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Процедура ВыгрузитьНастройкуЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если ТипЗнч(Результат) <> Тип("Массив") Или Результат.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	SUI_ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон(НСтр("ru = 'Настройка %1 выгружена по пути %2'"), 
		SUI_SimpleКлиентСервер.Представление(), Результат[0].ПолноеИмя));
	
	Если ЭтоАдресВременногоХранилища(Результат[0].Хранение) Тогда
		УдалитьИзВременногоХранилища(Результат[0].Хранение);
	КонецЕсли;
	
	Если ТипЗнч(ДополнительныеПараметры.Оповещение) = Тип("ОписаниеОповещения") Тогда
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.Оповещение, Новый Структура("ПолноеИмя", Результат[0].ПолноеИмя));
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗагрузитьНастройкуПослеВыбораФайла(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Если ТипЗнч(ДополнительныеПараметры.Оповещение) = Тип("ОписаниеОповещения") Тогда
			ВыполнитьОбработкуОповещения(ДополнительныеПараметры.Оповещение, Неопределено);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры.Вставить("ИмяФайла", Результат.Имя);
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ЗагрузитьНастройкуЗавершение", 
		ЭтотОбъект, ДополнительныеПараметры);
		
	ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(Результат.Хранение);
	
	ДлительнаяОперация = SUI_НастройкиМетаданныхВызовСервера.ЗагрузитьНастройкиИзФайла(
		ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанныеФайла), ДополнительныеПараметры.Форма.УникальныйИдентификатор);
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ДополнительныеПараметры.Форма);
	
	ПараметрыОжидания.Заголовок 					= НСтр("ru = 'Загрузка настройки из файла'");
	ПараметрыОжидания.ВыводитьПрогрессВыполнения 	= Истина;
	ПараметрыОжидания.ВыводитьСообщения 			= Истина;
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания);
	
КонецПроцедуры

Процедура ЗагрузитьНастройкуЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Если ТипЗнч(ДополнительныеПараметры.Оповещение) = Тип("ОписаниеОповещения") Тогда
			ВыполнитьОбработкуОповещения(ДополнительныеПараметры.Оповещение);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если Результат.Свойство("АдресРезультата") И ЭтоАдресВременногоХранилища(Результат.АдресРезультата) Тогда
		РезультатОперации = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);
		УдалитьИзВременногоХранилища(Результат.АдресРезультата);
	Иначе
		РезультатОперации = Неопределено;
	КонецЕсли;
	
	Если Результат.Статус = "Выполнено" Тогда
		SUI_ОбщегоНазначенияКлиент.СообщитьПользователю(
			СтрШаблон(НСтр("ru = 'Настройка загружена из файла ""%1"".'"), 
				ДополнительныеПараметры.ИмяФайла));
	ИначеЕсли Результат.Статус = "Ошибка" Тогда
		ПоказатьПредупреждение(, СтрШаблон(НСтр("ru = 'Возникла ошибка при загрузке настройки из файла ""%1"".
		|%2'"), ДополнительныеПараметры.ИмяФайла, Результат.КраткоеПредставлениеОшибки));
	Иначе
		ПоказатьПредупреждение(, НСтр("ru = 'Не удалось получить результат загрузки настройки из файла.'"));
	КонецЕсли;

	ОбновитьИнтерфейс();
	
	Если ТипЗнч(ДополнительныеПараметры.Оповещение) = Тип("ОписаниеОповещения") Тогда
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.Оповещение, РезультатОперации);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
