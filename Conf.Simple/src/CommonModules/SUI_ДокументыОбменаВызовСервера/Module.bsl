КонецФункции

Функция ДокументОбменаСодержитДанныеПотокаШтрихкодов(ДокументСсылка, НастройкаДокумента) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Результат = Новый Структура("ЭтоДокументСборШК,ЕстьПотокШК", Ложь, Истина);
	
	Если ДокументСсылка.Метаданные() = Метаданные.Документы.SUI_СборШтрихкодов Тогда
		Результат.ЭтоДокументСборШК = Истина;
	Иначе
		
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	КОЛИЧЕСТВО(SUI_docs_tbl_barcode_flow.sid) > 0 КАК ЕстьПотокШК
			|ИЗ
			|	РегистрСведений.SUI_docs КАК SUI_docs
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.SUI_docs_tbl_barcode_flow КАК SUI_docs_tbl_barcode_flow
			|		ПО SUI_docs.sid = SUI_docs_tbl_barcode_flow.sid_doc
			|ГДЕ
			|	SUI_docs.id_doc = &id_doc
			|	И SUI_docs.НастройкаДокумента = &НастройкаДокумента";
		
		Запрос.УстановитьПараметр("id_doc", SUI_ИнтеграцияВКонфигурацию.ИдентификаторSimpleПоСсылке(ДокументСсылка));
		Запрос.УстановитьПараметр("НастройкаДокумента", НастройкаДокумента);
		
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		
		Результат.ЕстьПотокШК = Выборка.ЕстьПотокШК;
	
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

Функция ПолучитьSIDДокументаОбменаПоСсылкеДокумента(ДокументСсылка, НастройкаДокумента = Неопределено) Экспорт
	Возврат SUI_ДокументыОбмена.ПолучитьSIDДокументовОбмена(ДокументСсылка, НастройкаДокумента);
