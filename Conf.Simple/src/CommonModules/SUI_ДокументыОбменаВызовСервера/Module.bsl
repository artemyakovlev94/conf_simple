Функция ЗавершитьГрупповойПересчетДокумента(Документ, ИнтерактивноеЗавершение = Истина) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ДокументыОбмена.sid КАК sid,
		|	ДокументыОбмена.id_doc КАК id_doc,
		|	ДокументыОбмена.МобильноеУстройство КАК МобильноеУстройство
		|ИЗ
		|	РегистрСведений.SUI_docs КАК ДокументыОбмена
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.SUI_НастройкиДокументов КАК НастройкиДокументов
		|		ПО ДокументыОбмена.НастройкаДокумента = НастройкиДокументов.Ссылка
		|ГДЕ
		|	ДокументыОбмена.id_doc = &id_doc
		|	И НастройкиДокументов.ГрупповоеСканирование";
	
	Если SUI_ИнтеграцияВКонфигурациюКлиентСервер.ЭтоИдентификаторSimple(Документ) Тогда
		Запрос.УстановитьПараметр("id_doc", Документ);
	Иначе
		Запрос.УстановитьПараметр("id_doc", SUI_ИнтеграцияВКонфигурацию.ИдентификаторSimpleПоСсылке(Документ));
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
		
	ДополнительныеПараметры = Новый Структура();
	
	ДополнительныеПараметры.Вставить("sid", Выборка.sid);
	
	Если ИнтерактивноеЗавершение Тогда
		ДополнительныеПараметры.Вставить("ИнтерактивноеЗавершение");
	КонецЕсли;
	
	Возврат SUI_ОбменДаннымиСервер.ЗавершитьГрупповойПересчетДокумента(Выборка.МобильноеУстройство, Выборка.id_doc, 
		ДополнительныеПараметры);
		
КонецФункции

Функция ДокументБылВыгружен(Документ, ИсключаемыеСостояния = Неопределено, НастройкаДокумента = Неопределено) Экспорт
	Возврат SUI_ДокументыОбмена.ДокументБылВыгружен(Документ, ИсключаемыеСостояния, НастройкаДокумента);
КонецФункции

Функция ПолучитьШтрихкодыМаркировкиДокументаОбмена(ДокументСсылка, НастройкаДокумента = Неопределено, ИдентификаторФормы = Неопределено) Экспорт
	
	ПараметрыПроцедуры = Новый Структура();
	ПараметрыПроцедуры.Вставить("ДокументСсылка", ДокументСсылка);
	ПараметрыПроцедуры.Вставить("НастройкаДокумента", НастройкаДокумента);
	
	Возврат ДлительныеОперации.ВыполнитьВФоне(
		"SUI_ДокументыОбмена.ПолучитьШтрихкодыМаркировкиДокументаОбмена", 
		ПараметрыПроцедуры, 
		ДлительныеОперации.ПараметрыВыполненияВФоне(ИдентификаторФормы));
	
КонецФункции

