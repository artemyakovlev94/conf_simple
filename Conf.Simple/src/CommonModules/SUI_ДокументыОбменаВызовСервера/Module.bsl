Функция ДокументОбменаСодержитДанныеПотокаШтрихкодов(ДокументСсылка, НастройкаДокумента) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Результат = Новый Структура();
	Результат.Вставить("ЕстьПотокШК", Ложь);
	
	Если ДокументСсылка.Метаданные() = Метаданные.Документы.SUI_СборШтрихкодов Или
		ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НастройкаДокумента, "СборШтрихкодов") Тогда
		Результат.Вставить("ЭтоДокументСборШК", Истина);
	Иначе
		Результат.Вставить("ЭтоДокументСборШК", Ложь);
	КонецЕсли;
	
	Если Результат.ЭтоДокументСборШК Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	SUI_docs_tbl_barcode_flow.sid
			|ИЗ
			|	РегистрСведений.SUI_docs КАК SUI_docs
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.SUI_docs_tbl_barcode_flow КАК SUI_docs_tbl_barcode_flow
			|		ПО SUI_docs.sid = SUI_docs_tbl_barcode_flow.sid_doc
			|		И НЕ SUI_docs_tbl_barcode_flow.ЭтоШтрихкодКМ
			|		И НЕ SUI_docs_tbl_barcode_flow.ЭтоШтрихкодSSCC
			|ГДЕ
			|	SUI_docs.id_doc = &id_doc
			|	И SUI_docs.НастройкаДокумента = &НастройкаДокумента";
		
		Запрос.УстановитьПараметр("id_doc", SUI_ИнтеграцияВКонфигурацию.ИдентификаторSimpleПоСсылке(ДокументСсылка));
		Запрос.УстановитьПараметр("НастройкаДокумента", НастройкаДокумента);
		
		Результат.ЕстьПотокШК = Не Запрос.Выполнить().Пустой();
		
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

