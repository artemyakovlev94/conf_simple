Функция ВнешнееИмяРеквизита_Номенклатура(ИмяРеквизита)
	
	Если ВРег(ИмяРеквизита) = ВРег("Ссылка") Тогда
		Возврат "id";
	ИначеЕсли ВРег(ИмяРеквизита) = ВРег("Код") Тогда
		Возврат "code";
	ИначеЕсли ВРег(ИмяРеквизита) = ВРег("Наименование") Тогда
		Возврат "name";
	ИначеЕсли ВРег(ИмяРеквизита) = ВРег("Артикул") Тогда
		Возврат "art";
	ИначеЕсли ВРег(ИмяРеквизита) = ВРег("Единицаизмерения") Тогда
		Возврат "unit";
	ИначеЕсли ВРег(ИмяРеквизита) = ВРег("ВидНоменклатуры") Тогда
		Возврат "type_good";
	Иначе
		Возврат ИмяРеквизита;
	КонецЕсли;
	
