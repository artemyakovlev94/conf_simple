Функция ВнешнееИмяРеквизита(ИмяОбъекта, ИмяРеквизита) Экспорт
	
	Если ВРег(ИмяОбъекта) = ВРег("Номенклатура") Тогда
		Возврат ВнешнееИмяРеквизита_Номенклатура(ИмяРеквизита);
	ИначеЕсли ВРег(ИмяОбъекта) = ВРег("ВидыЦен") Тогда
		Возврат ВнешнееИмяРеквизита_ВидыЦен(ИмяРеквизита);
	ИначеЕсли ВРег(ИмяОбъекта) = ВРег("ЕдиницыИзмерения") Тогда
		Возврат ВнешнееИмяРеквизита_ЕдиницыИзмерения(ИмяРеквизита);
	ИначеЕсли ВРег(ИмяОбъекта) = ВРег("УпаковкиНоменклатуры") Тогда
		Возврат ВнешнееИмяРеквизита_УпаковкиНоменклатуры(ИмяРеквизита);
	ИначеЕсли ВРег(ИмяОбъекта) = ВРег("Контрагенты") Тогда
		Возврат ВнешнееИмяРеквизита_Контрагенты(ИмяРеквизита);
	ИначеЕсли ВРег(ИмяОбъекта) = ВРег("СерииНоменклатуры") Тогда
		Возврат ВнешнееИмяРеквизита_СерииНоменклатуры(ИмяРеквизита);
	ИначеЕсли ВРег(ИмяОбъекта) = ВРег("ХарактеристикиНоменклатуры") Тогда
		Возврат ВнешнееИмяРеквизита_ХарактеристикиНоменклатуры(ИмяРеквизита);
	ИначеЕсли ВРег(ИмяОбъекта) = ВРег("ЦеныНоменклатуры") Тогда
		Возврат ВнешнееИмяРеквизита_ЦеныНоменклатуры(ИмяРеквизита);
	ИначеЕсли ВРег(ИмяОбъекта) = ВРег("ШтрихкодыНоменклатуры") Тогда
		Возврат ВнешнееИмяРеквизита_ШтрихкодыНоменклатуры(ИмяРеквизита);
	ИначеЕсли ВРег(ИмяОбъекта) = ВРег("ШтрихкодыУпаковокТоваров") Тогда
		Возврат ВнешнееИмяРеквизита_ШтрихкодыУпаковокТоваров(ИмяРеквизита);
	ИначеЕсли ВРег(ИмяОбъекта) = ВРег("Склады") Тогда
		Возврат ВнешнееИмяРеквизита_Склады(ИмяРеквизита);
	ИначеЕсли ВРег(ИмяОбъекта) = ВРег("СкладскиеЯчейки") Тогда
		Возврат ВнешнееИмяРеквизита_СкладскиеЯчейки(ИмяРеквизита);
	Иначе
		Возврат ИмяРеквизита;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьОписаниеНастройки(ИмяНастройки) Экспорт
	
	Если ВРег(ИмяНастройки) = ВРег("Номенклатура") Тогда
		Возврат СформироватьОписаниеНастройки_Номенклатура();
	ИначеЕсли ВРег(ИмяНастройки) = ВРег("ВидыЦен") Тогда
		Возврат СформироватьОписаниеНастройки_ВидыЦен();
	ИначеЕсли ВРег(ИмяНастройки) = ВРег("ЕдиницыИзмерения") Тогда
		Возврат СформироватьОписаниеНастройки_ЕдиницыИзмерения();
	ИначеЕсли ВРег(ИмяНастройки) = ВРег("УпаковкиНоменклатуры") Тогда
		Возврат СформироватьОписаниеНастройки_УпаковкиНоменклатуры();
	ИначеЕсли ВРег(ИмяНастройки) = ВРег("Контрагенты") Тогда
		Возврат СформироватьОписаниеНастройки_Контрагенты();
	ИначеЕсли ВРег(ИмяНастройки) = ВРег("СерииНоменклатуры") Тогда
		Возврат СформироватьОписаниеНастройки_СерииНоменклатуры();
	ИначеЕсли ВРег(ИмяНастройки) = ВРег("ХарактеристикиНоменклатуры") Тогда
		Возврат СформироватьОписаниеНастройки_ХарактеристикиНоменклатуры();
	ИначеЕсли ВРег(ИмяНастройки) = ВРег("ЦеныНоменклатуры") Тогда
		Возврат СформироватьОписаниеНастройки_ЦеныНоменклатуры();
	ИначеЕсли ВРег(ИмяНастройки) = ВРег("ШтрихкодыНоменклатуры") Тогда
		Возврат СформироватьОписаниеНастройки_ШтрихкодыНоменклатуры();
	ИначеЕсли ВРег(ИмяНастройки) = ВРег("ШтрихкодыУпаковокТоваров") Тогда
		Возврат СформироватьОписаниеНастройки_ШтрихкодыУпаковокТоваров();
	ИначеЕсли ВРег(ИмяНастройки) = ВРег("Склады") Тогда
		Возврат СформироватьОписаниеНастройки_Склады();
	ИначеЕсли ВРег(ИмяНастройки) = ВРег("СкладскиеЯчейки") Тогда
		Возврат СформироватьОписаниеНастройки_СкладскиеЯчейки();
	КонецЕсли;
	
КонецФункции

Функция ПолучитьОбязательныеРеквизиты(ИмяНастройки, ПолучитьСОписанием = Ложь) Экспорт
	
	Если ВРег(ИмяНастройки) = ВРег("Номенклатура") Тогда
		Возврат СформироватьОбязательныеРеквизиты_Номенклатура(ПолучитьСОписанием);
	ИначеЕсли ВРег(ИмяНастройки) = ВРег("ВидыЦен") Тогда
		Возврат СформироватьОбязательныеРеквизиты_ВидыЦен(ПолучитьСОписанием);
	ИначеЕсли ВРег(ИмяНастройки) = ВРег("ЕдиницыИзмерения") Тогда
		Возврат СформироватьОбязательныеРеквизиты_ЕдиницыИзмерения(ПолучитьСОписанием);
	ИначеЕсли ВРег(ИмяНастройки) = ВРег("УпаковкиНоменклатуры") Тогда
		Возврат СформироватьОбязательныеРеквизиты_УпаковкиНоменклатуры(ПолучитьСОписанием);
	ИначеЕсли ВРег(ИмяНастройки) = ВРег("Контрагенты") Тогда
		Возврат СформироватьОбязательныеРеквизиты_Контрагенты(ПолучитьСОписанием);
	ИначеЕсли ВРег(ИмяНастройки) = ВРег("СерииНоменклатуры") Тогда
		Возврат СформироватьОбязательныеРеквизиты_СерииНоменклатуры(ПолучитьСОписанием);
	ИначеЕсли ВРег(ИмяНастройки) = ВРег("ХарактеристикиНоменклатуры") Тогда
		Возврат СформироватьОбязательныеРеквизиты_ХарактеристикиНоменклатуры(ПолучитьСОписанием);
	ИначеЕсли ВРег(ИмяНастройки) = ВРег("ЦеныНоменклатуры") Тогда
		Возврат СформироватьОбязательныеРеквизиты_ЦеныНоменклатуры(ПолучитьСОписанием);
	ИначеЕсли ВРег(ИмяНастройки) = ВРег("ШтрихкодыНоменклатуры") Тогда
		Возврат СформироватьОбязательныеРеквизиты_ШтрихкодыНоменклатуры(ПолучитьСОписанием);
	ИначеЕсли ВРег(ИмяНастройки) = ВРег("ШтрихкодыУпаковокТоваров") Тогда
		Возврат СформироватьОбязательныеРеквизиты_ШтрихкодыУпаковокТоваров(ПолучитьСОписанием);
	ИначеЕсли ВРег(ИмяНастройки) = ВРег("Склады") Тогда
		Возврат СформироватьОбязательныеРеквизиты_Склады(ПолучитьСОписанием);
	ИначеЕсли ВРег(ИмяНастройки) = ВРег("СкладскиеЯчейки") Тогда
		Возврат СформироватьОбязательныеРеквизиты_СкладскиеЯчейки(ПолучитьСОписанием);
	КонецЕсли;
	
КонецФункции

Процедура ВставитьПользовательскоеПолеВыборкиЗапроса(СтруктураПолей, Заголовок, Поле = "", Выражение = "", Параметры = Неопределено) Экспорт
	
	СтруктураПоля = Новый Структура("Поле, Выражение");
	
	Если ЗначениеЗаполнено(Поле) Тогда
		СтруктураПоля.Поле = Поле;
	ИначеЕсли ЗначениеЗаполнено(Выражение) Тогда
		
		Если СтрНайти(Выражение, "&") > 0 Тогда
			
			Если ТипЗнч(Параметры) = Тип("Структура") И Параметры.Количество() > 0 Тогда
				СтруктураПоля.Выражение = Выражение;
				СтруктураПоля.Вставить("Параметры", Параметры);
			КонецЕсли;
			
		Иначе
			СтруктураПоля.Выражение = Выражение;
		КонецЕсли;

	КонецЕсли;

	Если Не ЗначениеЗаполнено(СтруктураПоля.Поле) И Не ЗначениеЗаполнено(СтруктураПоля.Выражение) Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураПолей.Вставить(Заголовок, СтруктураПоля);
	
КонецПроцедуры

#КонецОбласти

