#Область ХранилищеОбщихНастроек

// Сохранить настройку по ключу в общих настройках Simple.
// 
// Параметры:
//  КлючНастройки - Строка - Ключ
//  Настройка - Произвольный - Настройка
//  ИмяПользователя - Строка, Неопределено - Имя пользователя настройки
Процедура ХранилищеОбщихНастроекСохранить(КлючНастройки, Настройка, ИмяПользователя = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ХранилищеОбщихНастроек.Сохранить(
		ПолучитьКлючОбъектаОбщихНастроек(), 
		СократитьКлючОбщихНастроек(КлючНастройки), 
		Настройка,
		,
		ИмяПользователя);
	
КонецПроцедуры

// Сохранить коллекцию настроек в общих настройках Simple.
// 
// Параметры:
//  КоллекцияНастроек - Соответствие из Произвольный - Коллекция настроек:
//  	* Ключ - Строка - Ключ
//  	* Значение - Произвольный - Настройка
//  ИмяПользователя - Неопределено - Имя пользователя
Процедура ХранилищеОбщихНастроекСохранитьНастройки(КоллекцияНастроек, ИмяПользователя = Неопределено) Экспорт
	
	Для Каждого ЭлементКоллекцииНастроек Из КоллекцияНастроек Цикл
		ХранилищеОбщихНастроекСохранить(ЭлементКоллекцииНастроек.Ключ, ЭлементКоллекцииНастроек.Значение, ИмяПользователя);
	КонецЦикла;
	
КонецПроцедуры

// Загрузить настройку по ключу из общих настроек Simple.
// 
// Параметры:
//  КлючНастройки - Строка - Ключ
//  ЗначениеПоУмолчанию - Произвольный - Значение по умолчанию
//  ИмяПользователя - Строка, Неопределено - Имя пользователя настройки
//	ПривестиКТипуПоУмолчанию - Булево - Привести результат к типу по умолчанию, 
//										если найдено и значение по умолчанию не равно Неопределено
// 
// Возвращаемое значение:
//  Произвольный, Неопределено - Значение настройки из общих настроек Simple по ключу.
Функция ХранилищеОбщихНастроекЗагрузить(КлючНастройки, ЗначениеПоУмолчанию = Неопределено, ИмяПользователя = Неопределено,
	ПривестиКТипуПоУмолчанию = Истина) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Результат = Неопределено;
	
	Результат = ХранилищеОбщихНастроек.Загрузить(
		ПолучитьКлючОбъектаОбщихНастроек(),
		СократитьКлючОбщихНастроек(КлючНастройки), 
		, 
		ИмяПользователя);
	
	Если Результат = Неопределено Или ОчиститьНесуществующиеСсылки(Результат) Тогда
		Результат = ЗначениеПоУмолчанию;
	ИначеЕсли ЗначениеПоУмолчанию <> Неопределено И ПривестиКТипуПоУмолчанию Тогда
		
		МассивТипов = Новый Массив();
		МассивТипов.Добавить(ТипЗнч(ЗначениеПоУмолчанию));
		ОписаниеТипа = Новый ОписаниеТипов(МассивТипов);
		
		Результат = ОписаниеТипа.ПривестиЗначение(Результат);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Загрузить значения настроек из общих настроек Simple в коллекцию настроек.
// 
// Параметры:
//  КоллекцияНастроек - Соответствие из Произвольный - Коллекция настроек:
//  	* Ключ - Строка - Ключ
//  	* Значение - Произвольный - Значение по умолчанию, если настройка по ключу не найдена.
//  ИмяПользователя - Строка, Неопределено - Имя пользователя настройки
//	ПривестиКТипуПоУмолчанию - Булево - Привести результат к типу по умолчанию, 
//										если найдено и значение по умолчанию не равно Неопределено
Процедура ХранилищеОбщихНастроекЗагрузитьНастройки(КоллекцияНастроек, ИмяПользователя = Неопределено,
	ПривестиКТипуПоУмолчанию = Истина) Экспорт
	
	Для Каждого ЭлементКоллекцииНастроек Из КоллекцияНастроек Цикл
		
		Результат = ХранилищеОбщихНастроекЗагрузить(
			ЭлементКоллекцииНастроек.Ключ, ЭлементКоллекцииНастроек.Значение, ИмяПользователя, ПривестиКТипуПоУмолчанию);
		
		КоллекцияНастроек.Вставить(ЭлементКоллекцииНастроек.Ключ, Результат);
		
	КонецЦикла;
	
КонецПроцедуры

// Удалить настройку по ключу в общих настройках Simple.
// 
// Параметры:
//  КлючНастройки - Строка - Ключ
//  ИмяПользователя - Строка, Неопределено - Имя пользователя настройки
Процедура ХранилищеОбщихНастроекУдалить(КлючНастройки, ИмяПользователя = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ХранилищеОбщихНастроек.Удалить(
		ПолучитьКлючОбъектаОбщихНастроек(), 
		СократитьКлючОбщихНастроек(КлючНастройки), 
		ИмяПользователя);
	
КонецПроцедуры

// Хранилище общих настроек удалить настройки.
// 
// Параметры:
//  КоллекцияНастроек - Соответствие из Произвольный - Коллекция настроек:
//  	* Ключ - Строка - Ключ
//  	* Значение - Произвольный - 
//  ИмяПользователя - Неопределено - Имя пользователя
Процедура ХранилищеОбщихНастроекУдалитьНастройки(КоллекцияНастроек, ИмяПользователя = Неопределено) Экспорт
	
	Для Каждого ЭлементКоллекцииНастроек Из КоллекцияНастроек Цикл
		ХранилищеОбщихНастроекУдалить(ЭлементКоллекцииНастроек.Ключ, ИмяПользователя);
