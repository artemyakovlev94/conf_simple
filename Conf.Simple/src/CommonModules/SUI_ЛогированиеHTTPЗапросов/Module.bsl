
#Область ПрограммныйИнтерфейс

// Записать лог.
// 
// Параметры:
//  HTTPЗапрос - HTTPСервисЗапрос - HTTPЗапрос
//  HTTPОтвет - HTTPСервисОтвет - HTTPОтвет
//	МобильноеУстройство - ПланОбменаСсылка.SUI_МобильныеУстройства - Мобильное устройство
Процедура Записать(HTTPЗапрос, HTTPОтвет, ДанныеЗапроса = Неопределено) Экспорт
	
	Если Не ПолучитьФункциональнуюОпцию("SUI_ЛогированиеHTTPЗапросов") Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(HTTPЗапрос) <> Тип("HTTPСервисЗапрос") Тогда
		SUI_ЖурналРегистрации.ЗаписьВЖурналРегистрации(ИмяСобытия(НСтр("ru = 'Запись'")), 
			УровеньЖурналаРегистрации.Ошибка, Метаданные.ОбщиеМодули.SUI_ЛогированиеHTTPЗапросов, ,
			НСтр("ru = 'Не передан HTTP запрос.'"));
	КонецЕсли;
	
	Если ТипЗнч(HTTPОтвет) <> Тип("HTTPСервисОтвет") Тогда
		SUI_ЖурналРегистрации.ЗаписьВЖурналРегистрации(ИмяСобытия(НСтр("ru = 'Запись'")), 
			УровеньЖурналаРегистрации.Ошибка, Метаданные.ОбщиеМодули.SUI_ЛогированиеHTTPЗапросов, ,
			НСтр("ru = 'Не передан HTTP ответ.'"));
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	МобильноеУстройство = SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеЗапроса, "МобильноеУстройство",
		ПланыОбмена.SUI_МобильныеУстройства.ПустаяСсылка(), Тип("ПланОбменаСсылка.SUI_МобильныеУстройства"));
	
	ДополнительныеДанные = Новый Структура();
	ДополнительныеДанные.Вставить("ВерсияПриложения", SUI_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(
		ДанныеЗапроса, "ВерсияПриложения"));
	ДополнительныеДанные.Вставить("ИдентификаторУстройства", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(МобильноеУстройство, "Код"));
	
	УстановитьПривилегированныйРежим(Ложь);

	ДанныеДляЗаписиЛогирования = SUI_ЛогированиеHTTPЗапросовКлиентСервер.ПодготовитьДанныеЗаписиЛогирования(
		HTTPЗапрос, HTTPОтвет, МобильноеУстройство, ДополнительныеДанные);
	
	ЗаписатьЛог(ДанныеДляЗаписиЛогирования);
	
КонецПроцедуры

// Записать лог.
// 
// Параметры:
//  ДанныеДляЗаписиЛогирования - Структура - см. SUI_ЛогированиеHTTPЗапросовКлиентСервер.ПодготовитьДанныеЗаписиЛогирования
Процедура ЗаписатьЛог(ДанныеДляЗаписиЛогирования, ВызыватьИсключения = Ложь) Экспорт
	
	Попытка

		ЛогЗапись = РегистрыСведений.SUI_ЛогированиеHTTPЗапросов.СоздатьМенеджерЗаписи();
		
		ЛогЗапись.Период = ТекущаяДатаСеанса();
		ЛогЗапись.SID = Строка(Новый УникальныйИдентификатор());
		ЗаполнитьЗначенияСвойств(ЛогЗапись, ДанныеДляЗаписиЛогирования);
		ЗаполнитьЗначенияСвойств(ЛогЗапись, ДанныеДляЗаписиЛогирования.Данные);
		ЗаполнитьЗначенияСвойств(ЛогЗапись, ДанныеДляЗаписиЛогирования.Данные.ТипСтруктурыОтвета);
		
		УстановитьПривилегированныйРежим(Истина);
		
		ЛогЗапись.МеткаВремени = ТекущаяУниверсальнаяДатаВМиллисекундах();
		ЛогЗапись.НомерСеанса = НомерСеансаИнформационнойБазы();
		ЛогЗапись.ИмяПользователя = ИмяПользователя();
		
		ТекущийПользователь = Пользователи.ТекущийПользователь();
		Если ЗначениеЗаполнено(ТекущийПользователь) Тогда
			ЛогЗапись.ИдентификаторПользователя = Строка(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
				ТекущийПользователь, "ИдентификаторПользователяИБ"));
		КонецЕсли;
		
		УстановитьПривилегированныйРежим(Ложь);
		
		ЛогЗапись.Записать(Истина);
		
	Исключение
		SUI_ЖурналРегистрации.ЗаписьВЖурналРегистрации(ИмяСобытия(НСтр("ru = 'Запись'")), , 
			Метаданные.ОбщиеМодули.SUI_ЛогированиеHTTPЗапросов, , ИнформацияОбОшибке()); 
		Если ВызыватьИсключения Тогда
			ВызватьИсключение;	
		КонецЕсли;
	КонецПопытки;
	
КонецПроцедуры

Функция КоличествоДнейХранения() Экспорт
	Возврат Константы.SUI_ХранениеЛоговHTTPЗапросовВДнях.Получить();
КонецФункции

Процедура ВыполнитьОчисткуЛогов() Экспорт
	
	Если Не ПолучитьФункциональнуюОпцию("SUI_ЛогированиеHTTPЗапросов") Тогда
		Возврат;
	КонецЕсли;
	
	ДниХранения = Константы.SUI_ХранениеЛоговHTTPЗапросовВДнях.Получить();
	
	Если Не ЗначениеЗаполнено(ДниХранения) Тогда
		Возврат;
	КонецЕсли;

	SUI_ЖурналРегистрации.ЗаписьВЖурналРегистрации(ИмяСобытия(НСтр("ru = 'Удаление'")), УровеньЖурналаРегистрации.Примечание, 
		Метаданные.ОбщиеМодули.SUI_ЛогированиеHTTPЗапросов, , НСтр("ru = 'Начало удаления логов HTTP запросов'"));
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1000
		|	SUI_ЛогиHTTPЗапросов.Период,
		|	SUI_ЛогиHTTPЗапросов.SID,
		|	SUI_ЛогиHTTPЗапросов.Метод
		|ИЗ
		|	РегистрСведений.SUI_ЛогированиеHTTPЗапросов КАК SUI_ЛогиHTTPЗапросов
		|ГДЕ
		|	SUI_ЛогиHTTPЗапросов.Период < &ДатаНачалаЗаписей
		|
		|УПОРЯДОЧИТЬ ПО
		|	SUI_ЛогиHTTPЗапросов.Период";
	
	Запрос.УстановитьПараметр("ДатаНачалаЗаписей", ТекущаяДатаСеанса() - 86400 * ДниХранения);
	
	Пока Истина Цикл
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если РезультатЗапроса.Пустой() Тогда
			Прервать;
		КонецЕсли;
		
		Выборка = РезультатЗапроса.Выбрать();

		НачатьТранзакцию();
		
		Попытка
			
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.SUI_ЛогированиеHTTPЗапросов");
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			ЭлементБлокировки.ИсточникДанных = РезультатЗапроса;
			ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Период", "Период");
			ЭлементБлокировки.ИспользоватьИзИсточникаДанных("SID", "SID");
			ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Метод", "Метод");
			Блокировка.Заблокировать();
		
			Пока Выборка.Следующий() Цикл
			
				НаборЗаписей = РегистрыСведений.SUI_ЛогированиеHTTPЗапросов.СоздатьНаборЗаписей();
				
				НаборЗаписей.Отбор.Период.Установить(Выборка.Период);
				НаборЗаписей.Отбор.SID.Установить(Выборка.SID);
				НаборЗаписей.Отбор.Метод.Установить(Выборка.Метод);
				
				НаборЗаписей.Записать(Истина);
			
			КонецЦикла;
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			Если ТранзакцияАктивна() Тогда
				ОтменитьТранзакцию();
			КонецЕсли;
			SUI_ЖурналРегистрации.ЗаписьВЖурналРегистрации(ИмяСобытия(НСтр("ru = 'Удаление'")), ,
				Метаданные.ОбщиеМодули.SUI_ЛогированиеHTTPЗапросов, , ИнформацияОбОшибке());
			ВызватьИсключение;
		КонецПопытки;
		
	КонецЦикла;

	SUI_ЖурналРегистрации.ЗаписьВЖурналРегистрации(ИмяСобытия(НСтр("ru = 'Удаление'")), УровеньЖурналаРегистрации.Примечание, 
		Метаданные.ОбщиеМодули.SUI_ЛогированиеHTTPЗапросов, , НСтр("ru = 'Завершение удаления логов HTTP запросов'"));
	
КонецПроцедуры

#Область УстаревшиеПроцедурыИФункции

// Устарела. см. SUI_ЛогированиеHTTPЗапросов.Записать
Процедура ЛогироватьHTTPЗапрос(Запрос, Ответ, ДвоичныеДанные = Ложь, ОбъектМетаданных = Неопределено) Экспорт
	
	Если Не Константы.SUI_ЛогированиеHTTPЗапросов.Получить() Тогда
		Возврат;		
	КонецЕсли;
	
	Если ОбъектМетаданных = Неопределено Тогда
		ОбъектМетаданных = Метаданные.HTTPСервисы.SUI_Exchange;		
	КонецЕсли;
	
    Описание = ОписаниеЗапроса(Запрос, ДвоичныеДанные) + Символы.ПС + "---" + Символы.ПС + ОписаниеОтвета(Ответ, ДвоичныеДанные);
	                                                                
	SUI_ЖурналРегистрации.ЗаписьВЖурналРегистрации(НСтр("ru = 'Логирование'"), 
		УровеньЖурналаРегистрации.Информация, ОбъектМетаданных,, Описание);
	
КонецПроцедуры

// Устарела.
Функция БазовыйURL(HTTPСервисЗапрос) Экспорт 
	
	БазовыйURL = HTTPСервисЗапрос.Заголовки.Получить("X-Forwarded-Path");
	Если БазовыйURL = Неопределено Тогда
		Возврат НормализоватьАдрес(HTTPСервисЗапрос.БазовыйURL);
	Иначе
		ЧастиАдреса = СтрРазделить(НормализоватьАдрес(HTTPСервисЗапрос.БазовыйURL), "/", Ложь);
		Возврат ЧастиАдреса[0] + "//" + ЧастиАдреса[1] + БазовыйURL;
	КонецЕсли;
	
КонецФункции

// Устарела.
Функция НормализоватьАдрес(Адрес) Экспорт 
	
	ЧастиАдреса = СтрРазделить(Адрес, "/", Ложь);
	
	Протокол = СокрЛП(ЧастиАдреса[0]) + "//";
	ЧастиАдреса.Удалить(0);
	
	ЧастиИмени = СтрРазделить(СокрЛП(ЧастиАдреса[0]), ":");
	ЧастиАдреса.Удалить(0);
	ИмяСервера = ЧастиИмени[0];
	ПортСервера = ?(ЧастиИмени.Количество() = 1, "", СокрЛП(ЧастиИмени[1]));
	Если Протокол = "http://" Тогда
		ПортСервера = ?(ПустаяСтрока(ПортСервера) Или ПортСервера = "80", "", ":" + ПортСервера);
	ИначеЕсли Протокол = "https://" Тогда
		ПортСервера = ?(ПустаяСтрока(ПортСервера) Или ПортСервера = "443", "", ":" + ПортСервера);
	Иначе                                                 
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Неизвестный протокол: %1'", ОбщегоНазначения.КодОсновногоЯзыка()), Протокол);
	КонецЕсли;
	
	Путь = "/" + СтрСоединить(ЧастиАдреса, "/");
	
	Возврат Протокол + ИмяСервера + ПортСервера + Путь;
    
КонецФункции

#КонецОбласти

