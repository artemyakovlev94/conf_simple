Процедура ЗаписатьСообщениеЛогирования(СообщениеЛогирования) Экспорт
	
	Запись = РегистрыСведений.SUI_ЛогированиеHTTPЗапросов.СоздатьМенеджерЗаписи();
		
	Запись.Период = ТекущаяДатаСеанса();
	Запись.SID = Строка(Новый УникальныйИдентификатор());
	ЗаполнитьЗначенияСвойств(Запись, СообщениеЛогирования);
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запись.МеткаВремени = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Запись.НомерСеанса = НомерСеансаИнформационнойБазы();
	Запись.ИмяПользователя = ИмяПользователя();
	
	ТекущийПользователь = Пользователи.ТекущийПользователь();
	Если ЗначениеЗаполнено(ТекущийПользователь) Тогда
		Запись.ИдентификаторПользователя = Строка(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
			ТекущийПользователь, "ИдентификаторПользователяИБ"));
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Запись.Записать(Истина);
	
КонецПроцедуры

